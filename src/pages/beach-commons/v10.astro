---
import {
  BEACH_COMMONS_V10,
  TIDE_SCORE_VOICES,
  TIDE_CABINET_PLATES,
  TIDE_CABINET_ECOLOGY,
  TIDE_CABINET_CYCLE,
  TIDE_CABINET_ZONES,
  TIDE_CABINET_REALITY_PATHS,
  TIDE_CABINET_ROLES,
  TIDE_CABINET_RULES,
} from '../../lib/beach-commons-v10';

const title = `${BEACH_COMMONS_V10.title} — ${BEACH_COMMONS_V10.subtitle}`;
const description = BEACH_COMMONS_V10.dek;
const canonical = BEACH_COMMONS_V10.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0528.png';
const hero = TIDE_CABINET_PLATES[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  '@id': `${canonical}#field-study`,
  url: canonical,
  name: title,
  description,
  datePublished: BEACH_COMMONS_V10.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Field Study',
    url: 'https://pointcast.xyz',
  },
  isBasedOn: BEACH_COMMONS_V10.previousEdition.url,
  mainEntityOfPage: BEACH_COMMONS_V10.jsonUrl,
  image: TIDE_CABINET_PLATES.map((bench) => new URL(bench.image, canonical).href),
  creator: BEACH_COMMONS_V10.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
  about: [
    'Shell and stone observation',
    'Beach wrack',
    'California grunion',
    'Eelgrass restoration',
    'Olympia oyster restoration',
    'Western snowy plover',
    'Community science',
    'Dockweiler State Beach',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f1ead7" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V10.jsonUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,800&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --ink: #13201e;
        --paper: #ebe9e0;
        --paper-2: #fffaf0;
        --orange: #de7043;
        --amber: #f1b24a;
        --green: #24796f;
        --blue: #315f9d;
        --pink: #a64d67;
        --pcb: #244d48;
        --cream: #f4e5c3;
        --line: rgba(19, 32, 30, .26);
        --sans: 'DM Sans', system-ui, sans-serif;
        --serif: 'DM Serif Display', Georgia, serif;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
      }
      a { color: inherit; }
      img { display: block; width: 100%; }
      button { color: inherit; font: inherit; }
      [hidden] { display: none !important; }
      .skip {
        position: fixed;
        z-index: 1000;
        top: 8px;
        left: 8px;
        transform: translateY(-180%);
        padding: 12px 15px;
        background: white;
        font: 700 10px/1 var(--mono);
      }
      .skip:focus { transform: none; }
      .head {
        position: sticky;
        z-index: 100;
        top: 0;
        display: grid;
        grid-template-columns: minmax(180px, 1fr) auto auto auto auto;
        min-height: 55px;
        background: rgba(20, 23, 20, .95);
        color: white;
        border-bottom: 1px solid rgba(255,255,255,.24);
        backdrop-filter: blur(16px);
      }
      .head > * {
        display: flex;
        align-items: center;
        min-width: 0;
        padding: 0 20px;
        border-left: 1px solid rgba(255,255,255,.22);
        font: 700 9px/1 var(--mono);
        letter-spacing: .12em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .head .brand {
        border-left: 0;
        font: 800 14px/1 var(--sans);
        letter-spacing: .18em;
      }
      .head a:hover, .head a:focus-visible { background: var(--amber); color: var(--ink); outline: 0; }

      .hero {
        position: relative;
        min-height: min(940px, calc(100svh - 55px));
        display: flex;
        align-items: flex-end;
        isolation: isolate;
        overflow: hidden;
        background: var(--ink);
        color: white;
      }
      .hero__image, .hero__wash, .hero__grid { position: absolute; inset: 0; }
      .hero__image { z-index: -3; height: 100%; object-fit: cover; }
      .hero__wash {
        z-index: -2;
        background:
          linear-gradient(90deg, rgba(10, 13, 11, .92) 0%, rgba(10,13,11,.34) 56%, rgba(10,13,11,.08) 78%),
          linear-gradient(0deg, rgba(10,13,11,.92) 0%, transparent 66%);
      }
      .hero__grid {
        z-index: -1;
        opacity: .22;
        background-image:
          linear-gradient(rgba(255,255,255,.22) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.22) 1px, transparent 1px);
        background-size: 62px 62px;
        mask-image: linear-gradient(90deg, black, transparent 68%);
      }
      .hero__copy {
        width: min(1540px, 100%);
        margin: 0 auto;
        padding: clamp(100px, 14vw, 190px) clamp(22px, 5vw, 78px) clamp(38px, 6vw, 82px);
      }
      .kicker, .eyebrow, .micro {
        margin: 0;
        font: 700 10px/1.45 var(--mono);
        letter-spacing: .14em;
        text-transform: uppercase;
      }
      .kicker { color: var(--amber); }
      .hero h1 {
        max-width: 1120px;
        margin: 19px 0 0;
        font: 400 clamp(76px, 14vw, 205px)/.68 var(--serif);
        letter-spacing: -.065em;
      }
      .hero h1 span { display: block; color: var(--amber); font-style: italic; }
      .hero__dek {
        max-width: 800px;
        margin: 32px 0 0;
        font-size: clamp(20px, 2.15vw, 33px);
        font-weight: 600;
        line-height: 1.08;
      }
      .hero__rail {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 34px;
      }
      .hero__rail span, .button {
        display: inline-flex;
        min-height: 43px;
        align-items: center;
        padding: 0 14px;
        border: 1px solid currentColor;
        font: 700 9px/1 var(--mono);
        letter-spacing: .1em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .hero__rail span:first-child { background: var(--amber); border-color: var(--amber); color: var(--ink); }

      .signal-marquee {
        display: flex;
        gap: 0;
        overflow: hidden;
        border-block: 1px solid var(--ink);
        background: var(--orange);
      }
      .signal-marquee div {
        flex: 1 0 auto;
        min-width: max-content;
        padding: 13px 25px;
        border-right: 1px solid var(--ink);
        font: 700 10px/1 var(--mono);
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      .manifesto {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
        gap: clamp(45px, 8vw, 130px);
        padding: clamp(85px, 11vw, 160px) max(5vw, calc((100vw - 1500px) / 2));
        background: var(--paper-2);
        border-bottom: 1px solid var(--ink);
      }
      .manifesto h2, .section-head h2, .rack h2, .reality h2 {
        max-width: 1000px;
        margin: 0;
        font: 400 clamp(60px, 9vw, 136px)/.76 var(--serif);
        letter-spacing: -.055em;
      }
      .manifesto h2 em { color: var(--orange); font-weight: 400; }
      .manifesto__copy {
        align-self: end;
        font-size: clamp(18px, 1.55vw, 24px);
        line-height: 1.5;
      }
      .manifesto__copy p { margin: 0 0 22px; }
      .manifesto__copy p:last-child { margin-bottom: 0; }
      .non-affiliation {
        padding: 23px max(5vw, calc((100vw - 1500px) / 2));
        background: var(--amber);
        border-bottom: 1px solid var(--ink);
        font-size: 14px;
        font-weight: 700;
        line-height: 1.55;
      }

      .lanes {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        background: var(--ink);
        color: white;
        border-bottom: 1px solid var(--ink);
      }
      .lane {
        min-height: 390px;
        display: flex;
        flex-direction: column;
        padding: clamp(22px, 3vw, 48px);
        border-right: 1px solid rgba(255,255,255,.26);
      }
      .lane:last-child { border-right: 0; }
      .lane__dot { width: 18px; height: 18px; border-radius: 50%; background: var(--lane); box-shadow: 0 0 28px var(--lane); }
      .lane h3 { margin: auto 0 10px; color: var(--lane); font: 400 clamp(42px, 5vw, 76px)/.84 var(--serif); }
      .lane p { max-width: 280px; margin: 0 0 20px; font-size: 16px; font-weight: 700; }
      .lane ul { margin: 0; padding: 0; list-style: none; color: rgba(255,255,255,.68); font: 700 9px/1.8 var(--mono); text-transform: uppercase; }

      .benches, .roles, .tech, .rules {
        padding: clamp(85px, 10vw, 155px) max(5vw, calc((100vw - 1500px) / 2));
        border-bottom: 1px solid var(--ink);
      }
      .benches { background: var(--paper); }
      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(290px, 430px);
        gap: 45px;
        align-items: end;
        margin-bottom: 54px;
      }
      .section-head p {
        margin: 0;
        font-size: 18px;
        line-height: 1.5;
      }
      .bench-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
      }
      .bench {
        min-width: 0;
        display: flex;
        flex-direction: column;
        background: var(--paper-2);
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
      }
      .bench__image-button {
        position: relative;
        width: 100%;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-bottom: 1px solid var(--ink);
        background: var(--ink);
        cursor: zoom-in;
      }
      .bench__image-button img {
        aspect-ratio: 3 / 2;
        object-fit: cover;
        transition: transform .45s ease, opacity .25s ease;
      }
      .bench__image-button:hover img, .bench__image-button:focus-visible img { transform: scale(1.025); opacity: .88; }
      .bench__image-button:focus-visible { outline: 5px solid var(--amber); outline-offset: -5px; }
      .bench__number, .bench__lane {
        position: absolute;
        top: 15px;
        padding: 9px 10px;
        background: var(--ink);
        color: white;
        font: 700 9px/1 var(--mono);
        letter-spacing: .1em;
      }
      .bench__number { left: 15px; }
      .bench__lane { right: 15px; background: var(--amber); color: var(--ink); }
      .bench__zoom {
        position: absolute;
        right: 15px;
        bottom: 15px;
        padding: 9px 10px;
        background: rgba(20,23,20,.86);
        color: white;
        font: 700 8px/1 var(--mono);
        text-transform: uppercase;
      }
      .bench__body { flex: 1; display: flex; flex-direction: column; padding: clamp(24px, 4vw, 54px); }
      .bench h3 {
        max-width: 580px;
        margin: 0 0 20px;
        font: 400 clamp(44px, 5vw, 76px)/.82 var(--serif);
        letter-spacing: -.04em;
      }
      .bench__promise { margin: 0 0 26px; color: var(--orange); font-size: 18px; font-weight: 800; line-height: 1.3; }
      .bench__detail {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: auto;
        padding-top: 24px;
        border-top: 1px solid var(--line);
      }
      .bench__detail p { margin: 8px 0 0; font-size: 13px; line-height: 1.52; }
      .parts {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin: 24px 0 0;
        padding: 0;
        list-style: none;
      }
      .parts li {
        padding: 8px 9px;
        background: var(--cream);
        border: 1px solid var(--line);
        font: 700 8px/1 var(--mono);
        text-transform: uppercase;
      }
      .bench__boundary { margin: 22px 0 0; color: #6f3328; font-size: 12px; line-height: 1.5; }

      .cycle {
        display: grid;
        grid-template-columns: 330px 1fr;
        background: var(--pcb);
        color: white;
        border-bottom: 1px solid var(--ink);
      }
      .cycle__head { padding: clamp(38px, 5vw, 76px); border-right: 1px solid rgba(255,255,255,.24); }
      .cycle__head strong { display: block; color: var(--amber); font: 400 92px/.8 var(--serif); }
      .cycle__head p { margin: 20px 0 0; font-size: 17px; line-height: 1.5; }
      .cycle__steps { display: grid; grid-template-columns: repeat(5, 1fr); }
      .cycle__step {
        min-height: 330px;
        display: flex;
        flex-direction: column;
        padding: clamp(22px, 3vw, 42px);
        border-right: 1px solid rgba(255,255,255,.24);
      }
      .cycle__step:last-child { border-right: 0; }
      .cycle__step b { color: var(--amber); font: 400 52px/1 var(--serif); }
      .cycle__step h3 { margin: auto 0 13px; font: 400 28px/.95 var(--serif); }
      .cycle__step p { margin: 0; color: rgba(255,255,255,.7); font-size: 12px; line-height: 1.5; }

      .rack {
        display: grid;
        grid-template-columns: minmax(0, .86fr) minmax(440px, 1.14fr);
        gap: clamp(50px, 8vw, 130px);
        padding: clamp(90px, 11vw, 165px) max(5vw, calc((100vw - 1500px) / 2));
        background: #d3a77d;
        border-bottom: 1px solid var(--ink);
      }
      .rack__copy { display: flex; flex-direction: column; }
      .rack__copy > p { max-width: 680px; margin: 28px 0 0; font-size: 19px; line-height: 1.5; }
      .rack__status {
        margin-top: auto;
        padding-top: 35px;
        border-top: 1px solid var(--ink);
        font: 700 10px/1.5 var(--mono);
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .rack__console {
        align-self: end;
        padding: clamp(22px, 4vw, 52px);
        background: #20241f;
        color: white;
        border: 3px solid var(--ink);
        border-radius: 20px;
        box-shadow: 18px 18px 0 rgba(20,23,20,.2);
      }
      .rack__meter {
        position: relative;
        height: 110px;
        margin-bottom: 26px;
        overflow: hidden;
        background: #f4e4bb;
        border: 2px solid #090a09;
        border-radius: 70px 70px 10px 10px;
      }
      .rack__meter::before {
        content: '';
        position: absolute;
        inset: 16px;
        background: repeating-linear-gradient(90deg, transparent 0 9%, rgba(20,23,20,.35) 9% 10%);
        border-bottom: 2px solid var(--ink);
      }
      .rack__needle {
        position: absolute;
        bottom: -8px;
        left: 50%;
        width: 3px;
        height: 92px;
        transform: rotate(-42deg);
        transform-origin: 50% 100%;
        background: var(--orange);
        transition: transform .18s ease;
      }
      .rack__console.is-playing .rack__needle { animation: needle .75s ease-in-out; }
      @keyframes needle { 0% { transform: rotate(-42deg); } 42% { transform: rotate(37deg); } 100% { transform: rotate(-18deg); } }
      .voice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .voice {
        min-height: 110px;
        padding: 15px;
        background: var(--voice);
        color: var(--ink);
        border: 2px solid #090a09;
        border-radius: 8px;
        text-align: left;
        cursor: pointer;
        box-shadow: inset 0 -8px 0 rgba(0,0,0,.12);
        transition: transform .12s ease, box-shadow .12s ease;
      }
      .voice:hover, .voice:focus-visible { transform: translateY(-3px); outline: 3px solid white; outline-offset: 2px; }
      .voice:active { transform: translateY(3px); box-shadow: inset 0 -2px 0 rgba(0,0,0,.12); }
      .voice strong { display: block; font: 800 16px/1.2 var(--sans); }
      .voice span { display: block; margin-top: 22px; font: 700 8px/1 var(--mono); text-transform: uppercase; }
      .rack__note { margin: 18px 0 0; color: rgba(255,255,255,.58); font: 700 8px/1.5 var(--mono); text-transform: uppercase; }

      .roles { background: var(--paper-2); }
      .role-machine {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(320px, 1.1fr);
        margin-top: 48px;
        border: 1px solid var(--ink);
      }
      .role-machine__draw {
        min-height: 440px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(30px, 6vw, 86px);
        background: var(--amber);
        border-right: 1px solid var(--ink);
      }
      .role-machine__draw h3 { margin: 12px 0; font: 400 clamp(62px, 9vw, 130px)/.75 var(--serif); letter-spacing: -.05em; }
      .role-machine__draw p { max-width: 600px; margin: 0; font-size: 18px; font-weight: 700; line-height: 1.4; }
      .role-button {
        width: max-content;
        min-height: 49px;
        margin-top: 34px;
        padding: 0 18px;
        background: var(--ink);
        color: white;
        border: 1px solid var(--ink);
        font: 700 9px/1 var(--mono);
        letter-spacing: .12em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .role-button:hover, .role-button:focus-visible { background: white; color: var(--ink); outline: 0; }
      .role-list { display: grid; grid-template-columns: 1fr 1fr; }
      .role {
        min-height: 180px;
        padding: 22px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
      }
      .role:nth-child(even) { border-right: 0; }
      .role:nth-last-child(-n+2) { border-bottom: 0; }
      .role h4 { margin: 12px 0; font: 400 31px/1 var(--serif); }
      .role p { margin: 0; color: #5d5f58; font-size: 13px; line-height: 1.45; }

      .tech { background: #c9dbd4; }
      .tech-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 52px;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
      }
      .tech-card {
        min-height: 410px;
        display: flex;
        flex-direction: column;
        padding: 26px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
      }
      .tech-card h3 { margin: 15px 0 24px; font: 400 35px/.95 var(--serif); }
      .tech-card p { margin: 0 0 18px; font-size: 13px; line-height: 1.5; }
      .tech-card p + p { color: #30463d; font-weight: 700; }
      .tech-card a { margin-top: auto; font: 700 9px/1.5 var(--mono); text-transform: uppercase; }
      .tech-card a:hover, .tech-card a:focus-visible { color: var(--blue); outline: 0; }

      .reality {
        padding: clamp(90px, 11vw, 165px) max(5vw, calc((100vw - 1500px) / 2));
        background: var(--ink);
        color: white;
        border-bottom: 1px solid var(--ink);
      }
      .reality h2 em { color: var(--amber); font-weight: 400; }
      .path-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 52px;
        border-top: 1px solid rgba(255,255,255,.32);
        border-left: 1px solid rgba(255,255,255,.32);
      }
      .path {
        min-height: 360px;
        display: flex;
        flex-direction: column;
        padding: clamp(25px, 4vw, 50px);
        border-right: 1px solid rgba(255,255,255,.32);
        border-bottom: 1px solid rgba(255,255,255,.32);
      }
      .path h3 { margin: auto 0 18px; color: var(--amber); font: 400 clamp(38px, 4vw, 58px)/.88 var(--serif); }
      .path p { margin: 0; color: rgba(255,255,255,.7); font-size: 14px; line-height: 1.55; }

      .rules { background: var(--paper); }
      .rule-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 52px;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
      }
      .rule {
        min-height: 300px;
        display: flex;
        flex-direction: column;
        padding: 24px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
      }
      .rule h3 { margin: 15px 0 20px; font: 400 33px/.95 var(--serif); }
      .rule p { margin: 0 0 22px; color: #5e5e57; font-size: 13px; line-height: 1.55; }
      .rule a { margin-top: auto; font: 700 8px/1.5 var(--mono); text-transform: uppercase; }

      .boundary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 45px;
        align-items: end;
        padding: clamp(48px, 7vw, 100px) max(5vw, calc((100vw - 1500px) / 2));
        background: var(--orange);
        border-bottom: 1px solid var(--ink);
      }
      .boundary h2 { margin: 0 0 18px; font: 400 clamp(44px, 6vw, 82px)/.82 var(--serif); letter-spacing: -.04em; }
      .boundary p { max-width: 1000px; margin: 0; font-size: 15px; font-weight: 700; line-height: 1.55; }
      .boundary__links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 9px; }
      .boundary .button:hover, .boundary .button:focus-visible { background: var(--ink); color: white; outline: 0; }

      .footer {
        display: grid;
        grid-template-columns: 1fr auto auto auto;
        min-height: 82px;
        background: var(--ink);
        color: white;
      }
      .footer > * {
        display: flex;
        align-items: center;
        padding: 0 20px;
        border-left: 1px solid rgba(255,255,255,.24);
        font: 700 9px/1.4 var(--mono);
        letter-spacing: .09em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .footer .footer__brand { border-left: 0; font-size: 13px; }
      .footer a:hover, .footer a:focus-visible { background: var(--amber); color: var(--ink); outline: 0; }

      .viewer {
        width: min(1500px, calc(100vw - 30px));
        max-width: none;
        margin: auto;
        padding: 0;
        overflow: hidden;
        background: var(--ink);
        color: white;
        border: 1px solid rgba(255,255,255,.35);
      }
      .viewer::backdrop { background: rgba(3, 5, 4, .91); backdrop-filter: blur(10px); }
      .viewer__top { display: grid; grid-template-columns: 1fr auto; align-items: center; min-height: 56px; border-bottom: 1px solid rgba(255,255,255,.25); }
      .viewer__title { margin: 0; padding: 0 17px; font: 700 10px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
      .viewer__close {
        align-self: stretch;
        min-width: 62px;
        background: transparent;
        color: white;
        border: 0;
        border-left: 1px solid rgba(255,255,255,.25);
        cursor: pointer;
      }
      .viewer__close:hover, .viewer__close:focus-visible { background: var(--amber); color: var(--ink); outline: 0; }
      .viewer__image { max-height: calc(100svh - 100px); object-fit: contain; background: #090b09; }

      @media (max-width: 1100px) {
        .lanes, .tech-grid { grid-template-columns: repeat(2, 1fr); }
        .lane:nth-child(2) { border-right: 0; }
        .lane:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,.26); }
        .cycle { grid-template-columns: 1fr; }
        .cycle__head { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.24); }
        .cycle__steps { grid-template-columns: repeat(5, minmax(210px, 1fr)); overflow-x: auto; }
        .rack { grid-template-columns: 1fr; }
        .rack__status { margin-top: 45px; }
      }
      @media (max-width: 780px) {
        .head { grid-template-columns: 1fr auto; }
        .head .optional { display: none; }
        .head > * { padding: 0 13px; }
        .hero__copy { padding-right: 20px; padding-left: 20px; }
        .hero h1 { font-size: clamp(72px, 25vw, 124px); }
        .signal-marquee { overflow-x: auto; }
        .manifesto, .section-head, .role-machine, .boundary { grid-template-columns: 1fr; }
        .manifesto, .benches, .roles, .tech, .rules, .rack, .reality, .boundary { padding-right: 20px; padding-left: 20px; }
        .lanes { grid-template-columns: 1fr; }
        .lane { min-height: 270px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.26); }
        .lane:last-child { border-bottom: 0; }
        .bench-grid, .tech-grid, .path-grid, .rule-grid { grid-template-columns: 1fr; }
        .bench__detail { grid-template-columns: 1fr; }
        .rack__console { padding: 20px; }
        .role-machine__draw { min-height: 360px; border-right: 0; border-bottom: 1px solid var(--ink); }
        .role-list { grid-template-columns: 1fr; }
        .role, .role:nth-child(even), .role:nth-last-child(-n+2) { border-right: 0; border-bottom: 1px solid var(--ink); }
        .role:last-child { border-bottom: 0; }
        .boundary__links { justify-content: flex-start; }
        .footer { grid-template-columns: 1fr 1fr; }
        .footer > * { min-height: 60px; border-bottom: 1px solid rgba(255,255,255,.24); }
        .footer .footer__brand { grid-column: span 2; }
      }
      @media (max-width: 460px) {
        .voice-grid { grid-template-columns: 1fr; }
        .rack__meter { height: 90px; }
        .rack__needle { height: 75px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to Tide Cabinet</a>

    <header class="head">
      <a class="brand" href="/">POINTCAST</a>
      <a class="optional" href="#benches">Eight plates</a>
      <a class="optional" href="#signal-rack">Shoreline score</a>
      <a class="optional" href="#real">Make it actual</a>
      <a href="/beach-commons/v10.json">JSON ↗</a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="title">
        <img class="hero__image" src={hero.image} alt={hero.alt} width="1536" height="1024" fetchpriority="high" />
        <div class="hero__wash"></div>
        <div class="hero__grid"></div>
        <div class="hero__copy">
          <p class="kicker">PointCast Field Study 010 · unofficial concept · El Segundo coast</p>
          <h1 id="title">Tide <span>Cabinet</span></h1>
          <p class="hero__dek">{BEACH_COMMONS_V10.dek}</p>
          <div class="hero__rail" aria-label="Tide Cabinet facts">
            <span>8 field plates</span>
            <span>Look, then return</span>
            <span>Frame, never catch</span>
            <span>Life before spectacle</span>
          </div>
        </div>
      </section>

      <div class="signal-marquee" aria-label="Tide Cabinet activities">
        <div>Borrow one view</div>
        <div>Return the shell</div>
        <div>Frame the horizon</div>
        <div>Read the wrack</div>
        <div>Wait for grunion</div>
        <div>Map eelgrass</div>
        <div>Relay to the estuary</div>
        <div>Lift only litter</div>
      </div>

      <section class="manifesto">
        <h2>A museum that ends<br /><em>with nothing.</em></h2>
        <div class="manifesto__copy">
          <p>
            Shells and stones are almost irresistible because they seem to hold
            the whole coast in one hand. Tide Cabinet keeps that intimacy, then
            turns possession into a short-term loan from an exact place.
          </p>
          <p>
            <strong>The permanent collection is made of attention.</strong>
            Compare curves. Draw weathering. Photograph color. Tell a plausible
            story and mark it as uncertain. Then return the object before the
            next one enters the cabinet.
          </p>
          <p>
            The larger project follows life outward: wrack to dune, moon to
            grunion, eelgrass to fish, and Dockweiler curiosity to native-oyster
            partners in the sheltered estuaries where that work belongs.
          </p>
        </div>
      </section>

      <aside class="non-affiliation">
        {BEACH_COMMONS_V10.nonAffiliation}
      </aside>

      <section class="lanes" aria-label="Four zones of Tide Cabinet">
        {TIDE_CABINET_ZONES.map((lane) => (
          <article class="lane" style={`--lane:${lane.color}`}>
            <span class="lane__dot" aria-hidden="true"></span>
            <h3>{lane.title}</h3>
            <p>{lane.thesis}</p>
            <ul>
              {lane.benchIds.map((id) => {
                const bench = TIDE_CABINET_PLATES.find((item) => item.id === id);
                return <li>{bench?.title}</li>;
              })}
            </ul>
          </article>
        ))}
      </section>

      <section class="benches" id="benches" aria-labelledby="benches-title">
        <div class="section-head">
          <h2 id="benches-title">Eight plates.<br />One living coast.</h2>
          <p>
            Each plate offers a build, a social move, and a firm ecological
            boundary. The sequence begins with looking and ends by transferring
            community energy to restoration partners.
          </p>
        </div>

        <div class="bench-grid">
          {TIDE_CABINET_PLATES.map((bench) => (
            <article class="bench" id={bench.id}>
              <button
                class="bench__image-button"
                type="button"
                data-view-image={bench.image}
                data-view-alt={bench.alt}
                data-view-title={`${bench.number} · ${bench.title}`}
                aria-label={`Open full image for ${bench.title}`}
              >
                <img src={bench.image} alt="" width="1536" height="1024" loading={bench.number === '01' ? 'eager' : 'lazy'} />
                <span class="bench__number">{bench.number}</span>
                <span class="bench__lane">{bench.lane}</span>
                <span class="bench__zoom">Open plate ↗</span>
              </button>
              <div class="bench__body">
                <h3>{bench.title}</h3>
                <p class="bench__promise">{bench.promise}</p>
                <div class="bench__detail">
                  <div>
                    <p class="eyebrow">The build</p>
                    <p>{bench.build}</p>
                  </div>
                  <div>
                    <p class="eyebrow">The group move</p>
                    <p>{bench.groupMove}</p>
                  </div>
                </div>
                <ul class="parts" aria-label={`${bench.title} key parts`}>
                  {bench.parts.map((part) => <li>{part}</li>)}
                </ul>
                <p class="bench__boundary"><strong>Boundary:</strong> {bench.boundary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="cycle" aria-labelledby="cycle-title">
        <div class="cycle__head">
          <p class="eyebrow">The borrowing loop</p>
          <strong>30</strong>
          <p id="cycle-title">minutes from first attention to exact return and a completely empty cabinet.</p>
        </div>
        <div class="cycle__steps">
          {TIDE_CABINET_CYCLE.map((step) => (
            <article class="cycle__step">
              <b>{step.minute}</b>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="rack" id="signal-rack" aria-labelledby="rack-title">
        <div class="rack__copy">
          <div>
            <p class="eyebrow">Original browser instrument · sound on by gesture only</p>
            <h2 id="rack-title">Play the<br />Shoreline Score.</h2>
            <p>
              Six tiny synthesized voices connect shell, stone, wrack, moon,
              eelgrass, and oyster. Every sound is generated live by your
              browser—no samples, recording, account, or auto-play.
            </p>
          </div>
          <p class="rack__status" aria-live="polite" data-rack-status>Score idle · choose a voice</p>
        </div>
        <div class="rack__console" data-rack>
          <div class="rack__meter" aria-hidden="true"><span class="rack__needle"></span></div>
          <div class="voice-grid">
            {TIDE_SCORE_VOICES.map((voice) => (
              <button class="voice" type="button" data-voice={voice.id} data-label={voice.label} style={`--voice:${voice.color}`}>
                <strong>{voice.label}</strong>
                <span>{voice.hint}</span>
              </button>
            ))}
          </div>
          <p class="rack__note">Keep headphone volume comfortable. Each voice ends automatically.</p>
        </div>
      </section>

      <section class="roles" aria-labelledby="roles-title">
        <div class="section-head">
          <h2 id="roles-title">Everyone contributes.</h2>
          <p>
            A commons is stronger when the jobs are visible. Draw one role on
            arrival; trade only after you have made the walk more attentive.
          </p>
        </div>
        <div class="role-machine">
          <div class="role-machine__draw">
            <div>
              <p class="eyebrow">Your first assignment</p>
              <h3 data-role-title>Returner</h3>
              <p data-role-move>Remember the exact find spot and close every borrowing loop.</p>
            </div>
            <button class="role-button" type="button" data-role-button>Draw another role ↻</button>
          </div>
          <div class="role-list">
            {TIDE_CABINET_ROLES.map((role, index) => (
              <article class="role">
                <p class="micro">{String(index + 1).padStart(2, '0')}</p>
                <h4>{role.title}</h4>
                <p>{role.move}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="tech" aria-labelledby="tech-title">
        <div class="section-head">
          <h2 id="tech-title">What is alive here now.</h2>
          <p>
            The useful technology is an accurate relationship: know what the
            wrack does, where the living shoreline already is, when grunion may
            arrive, and why oysters require another habitat.
          </p>
        </div>
        <div class="tech-grid">
          {TIDE_CABINET_ECOLOGY.map((item, index) => (
            <article class="tech-card">
              <p class="micro">Living system / {String(index + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p>{item.now}</p>
              <p>{item.use}</p>
              <a href={item.source} target="_blank" rel="noreferrer">{item.sourceLabel} ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="reality" id="real" aria-labelledby="reality-title">
        <p class="eyebrow">From image to honest experiment</p>
        <h2 id="reality-title">Three paths.<br /><em>Start with the walk.</em></h2>
        <div class="path-grid">
          {TIDE_CABINET_REALITY_PATHS.map((path) => (
            <article class="path">
              <p class="micro">{path.status}</p>
              <h3>{path.title}</h3>
              <p>{path.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <div class="section-head">
          <h2 id="rules-title">The useful limits.</h2>
          <p>
            A generous encounter depends on restraint: leave the natural
            collection, keep the net empty, give wildlife an exit, and move
            restoration ambitions into expert hands.
          </p>
        </div>
        <div class="rule-grid">
          {TIDE_CABINET_RULES.map((rule, index) => (
            <article class="rule">
              <p class="micro">Rule {String(index + 1).padStart(2, '0')}</p>
              <h3>{rule.title}</h3>
              <p>{rule.detail}</p>
              <a href={rule.source} target="_blank" rel="noreferrer">{rule.sourceLabel} ↗</a>
            </article>
          ))}
        </div>
      </section>

      <aside class="boundary">
        <div>
          <h2>Concept, not event.</h2>
          <p>{BEACH_COMMONS_V10.boundary}</p>
        </div>
        <div class="boundary__links">
          <a class="button" href="/beach-commons/v9">V9 ↙</a>
          <a class="button" href="/beach-commons/v10.json">Machine edition ↗</a>
          <a class="button" href="/b/0528">Block 0528 ↗</a>
        </div>
      </aside>
    </main>

    <footer class="footer">
      <span class="footer__brand">POINTCAST · TIDE CABINET</span>
      <a href="/beach-commons/v10.json">JSON</a>
      <a href="/c/garden.rss">Garden RSS</a>
      <a href="/">Front door</a>
    </footer>

    <dialog class="viewer" aria-label="Tide Cabinet full image viewer" data-viewer>
      <div class="viewer__top">
        <p class="viewer__title" data-viewer-title>Tide Cabinet</p>
        <button class="viewer__close" type="button" aria-label="Close image viewer" data-viewer-close>×</button>
      </div>
      <img class="viewer__image" src={hero.image} alt={hero.alt} width="1536" height="1024" data-viewer-image />
    </dialog>

    <script is:inline define:vars={{ roles: TIDE_CABINET_ROLES }}>
      const viewer = document.querySelector('[data-viewer]');
      const viewerImage = document.querySelector('[data-viewer-image]');
      const viewerTitle = document.querySelector('[data-viewer-title]');
      const viewerClose = document.querySelector('[data-viewer-close]');
      let returnFocus = null;

      document.querySelectorAll('[data-view-image]').forEach((button) => {
        button.addEventListener('click', () => {
          returnFocus = button;
          viewerImage.src = button.dataset.viewImage;
          viewerImage.alt = button.dataset.viewAlt;
          viewerTitle.textContent = button.dataset.viewTitle;
          viewer.showModal();
        });
      });

      const closeViewer = () => {
        if (!viewer.open) return;
        viewer.close();
        returnFocus?.focus();
      };
      viewerClose.addEventListener('click', closeViewer);
      viewer.addEventListener('click', (event) => {
        if (event.target === viewer) closeViewer();
      });
      viewer.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeViewer();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && viewer.open) closeViewer();
      });

      const roleTitle = document.querySelector('[data-role-title]');
      const roleMove = document.querySelector('[data-role-move]');
      const roleButton = document.querySelector('[data-role-button]');
      let roleIndex = 0;
      roleButton.addEventListener('click', () => {
        let next = roleIndex;
        while (next === roleIndex) next = Math.floor(Math.random() * roles.length);
        roleIndex = next;
        roleTitle.textContent = roles[roleIndex].title;
        roleMove.textContent = roles[roleIndex].move;
      });

      const rack = document.querySelector('[data-rack]');
      const rackStatus = document.querySelector('[data-rack-status]');
      let audioContext;

      const context = () => {
        audioContext ||= new (window.AudioContext || window.webkitAudioContext)();
        if (audioContext.state === 'suspended') audioContext.resume();
        return audioContext;
      };

      const output = (ctx, duration = 1) => {
        const gain = ctx.createGain();
        const compressor = ctx.createDynamicsCompressor();
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.15, ctx.currentTime + 0.025);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        gain.connect(compressor).connect(ctx.destination);
        return gain;
      };

      const tone = (ctx, frequency, start, duration, type = 'sine', destination) => {
        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();
        oscillator.type = type;
        oscillator.frequency.setValueAtTime(frequency, start);
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.exponentialRampToValueAtTime(0.45, start + 0.012);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
        oscillator.connect(gain).connect(destination);
        oscillator.start(start);
        oscillator.stop(start + duration + .02);
        return oscillator;
      };

      const playVoice = (voice) => {
        const ctx = context();
        const now = ctx.currentTime + .015;

        if (voice === 'shell') {
          const out = output(ctx, 1.2);
          tone(ctx, 880, now, .7, 'sine', out);
          tone(ctx, 1320, now + .08, .85, 'sine', out);
        }

        if (voice === 'stone') {
          const out = output(ctx, 1.8);
          const oscillator = tone(ctx, 110, now, 1.65, 'triangle', out);
          const lfo = ctx.createOscillator();
          const amount = ctx.createGain();
          lfo.frequency.value = 4.8;
          amount.gain.value = 8;
          lfo.connect(amount).connect(oscillator.detune);
          lfo.start(now);
          lfo.stop(now + 1.7);
          tone(ctx, 165, now + .15, 1.35, 'sine', out);
        }

        if (voice === 'wrack') {
          const out = output(ctx, 1.35);
          [330, 440, 550].forEach((frequency, index) => {
            tone(ctx, frequency, now + index * .26, .22, 'square', out);
          });
        }

        if (voice === 'moon') {
          const out = output(ctx, 1.8);
          const buffer = ctx.createBuffer(1, ctx.sampleRate * 1.8, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < data.length; i += 1) data[i] = Math.random() * 2 - 1;
          const source = ctx.createBufferSource();
          const filter = ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(500, now);
          filter.frequency.exponentialRampToValueAtTime(2200, now + 1.6);
          filter.Q.value = 1.4;
          source.buffer = buffer;
          source.connect(filter).connect(out);
          source.start(now);
        }

        if (voice === 'grass') {
          const out = output(ctx, 1.9);
          const oscillator = tone(ctx, 180, now, 1.75, 'sawtooth', out);
          oscillator.frequency.exponentialRampToValueAtTime(720, now + 1.25);
          oscillator.frequency.exponentialRampToValueAtTime(240, now + 1.7);
        }

        if (voice === 'oyster') {
          const out = output(ctx, 2.4);
          [220, 277.18, 329.63, 440].forEach((frequency, index) => {
            tone(ctx, frequency, now + index * .055, 2.1 - index * .06, index % 2 ? 'triangle' : 'sine', out);
          });
        }

        rack.classList.remove('is-playing');
        void rack.offsetWidth;
        rack.classList.add('is-playing');
        window.setTimeout(() => rack.classList.remove('is-playing'), 1900);
      };

      document.querySelectorAll('[data-voice]').forEach((button) => {
        button.addEventListener('click', () => {
          playVoice(button.dataset.voice);
          rackStatus.textContent = `Playing · ${button.dataset.label}`;
          window.setTimeout(() => {
            rackStatus.textContent = 'Score ready · choose another voice';
          }, 2400);
        });
      });
    </script>
  </body>
</html>
