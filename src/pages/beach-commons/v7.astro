---
import {
  BEACH_COMMONS_V7,
  BEACH_UTILITY_CARTS,
  BEACH_UTILITY_OFFICIAL_CONTEXT,
  BEACH_UTILITY_PICKS,
  beachUtilityCartTotal,
  getBeachUtilityPick,
} from '../../lib/beach-commons-v7';

const title = `${BEACH_COMMONS_V7.title} — ${BEACH_COMMONS_V7.subtitle}`;
const description = BEACH_COMMONS_V7.dek;
const canonical = BEACH_COMMONS_V7.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0518.png';
const categoryLabels = {
  carry: 'Carry',
  coffee: 'Coffee + cups',
  fire: 'Fire-ring safety',
  ground: 'Tarps + ground',
  light: 'Low light',
  seat: 'Seats',
  shade: 'Shade',
  table: 'Tables',
};

const cartPayload = BEACH_UTILITY_CARTS.map((cart) => ({
  ...cart,
  total: beachUtilityCartTotal(cart),
  lines: cart.productIds.map((line) => {
    const product = getBeachUtilityPick(line.id);
    return {
      ...line,
      name: product?.name ?? line.id,
      maker: product?.maker ?? '',
      unitPrice: product?.priceUsd ?? 0,
      url: product?.url ?? '#',
    };
  }),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  url: canonical,
  headline: BEACH_COMMONS_V7.title,
  alternativeHeadline: BEACH_COMMONS_V7.subtitle,
  description,
  datePublished: BEACH_COMMONS_V7.publishedAt,
  dateModified: BEACH_COMMONS_V7.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Beach Commons',
    url: 'https://pointcast.xyz/beach-commons',
  },
  isBasedOn: BEACH_COMMONS_V7.previousEdition.url,
  image: socialImage,
  author: BEACH_COMMONS_V7.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
  about: ['Beach equipment', 'Reusable products', 'Dockweiler State Beach', 'Community field study'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f5efe3" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V7.jsonUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,800&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        --ink: #171b19;
        --muted: #62655e;
        --paper: #f5efe3;
        --cream: #fffaf0;
        --red: #e1482f;
        --blue: #14677a;
        --yellow: #efc84b;
        --green: #326a50;
        --line: rgba(23, 27, 25, .24);
        --serif: 'DM Serif Display', Georgia, serif;
        --sans: 'DM Sans', system-ui, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
      }
      a { color: inherit; }
      button { font: inherit; }
      img { max-width: 100%; }
      a, button { -webkit-tap-highlight-color: transparent; }
      [hidden] { display: none !important; }
      .skip {
        position: fixed;
        z-index: 400;
        top: 8px;
        left: 8px;
        transform: translateY(-160%);
        padding: 11px 14px;
        background: white;
        font: 700 10px/1 var(--mono);
      }
      .skip:focus { transform: translateY(0); }
      .mast {
        position: sticky;
        z-index: 100;
        top: 0;
        display: grid;
        grid-template-columns: 1fr auto auto auto;
        min-height: 54px;
        background: rgba(245, 239, 227, .95);
        border-bottom: 1px solid var(--ink);
        backdrop-filter: blur(14px);
      }
      .mast > * {
        display: flex;
        align-items: center;
        min-width: 0;
        padding: 0 20px;
        border-left: 1px solid var(--ink);
        font: 700 9px/1 var(--mono);
        letter-spacing: .12em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .mast .brand {
        border-left: 0;
        font: 800 14px/1 var(--sans);
        letter-spacing: .18em;
      }
      .mast a:hover, .mast a:focus-visible { background: var(--yellow); outline: 0; }
      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
        min-height: calc(100svh - 54px);
        border-bottom: 1px solid var(--ink);
      }
      .hero__copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 80px;
        padding: clamp(34px, 5vw, 78px);
      }
      .stamp, .eyebrow, .micro {
        margin: 0;
        font: 700 10px/1.5 var(--mono);
        letter-spacing: .13em;
        text-transform: uppercase;
      }
      .stamp { color: var(--red); }
      .hero h1 {
        max-width: 920px;
        margin: 20px 0 28px;
        font: 400 clamp(66px, 10.8vw, 166px)/.73 var(--serif);
        letter-spacing: -.06em;
      }
      .hero h1 em { display: block; color: var(--blue); font-weight: 400; }
      .hero__dek {
        max-width: 750px;
        margin: 0;
        font-size: clamp(19px, 2vw, 29px);
        font-weight: 600;
        line-height: 1.15;
      }
      .hero__meta {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding-top: 22px;
        border-top: 1px solid var(--ink);
      }
      .hero__meta strong { display: block; margin-top: 6px; font: 400 31px/1 var(--serif); }
      .hero__photo {
        position: relative;
        min-height: 560px;
        overflow: hidden;
        background: #13252c;
      }
      .hero__photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero__photo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, rgba(10,20,24,.75), transparent 55%);
        pointer-events: none;
      }
      .hero__caption {
        position: absolute;
        z-index: 2;
        right: 28px;
        bottom: 26px;
        left: 28px;
        color: white;
        font: 700 10px/1.5 var(--mono);
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .disclosure {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: clamp(28px, 6vw, 90px);
        padding: 30px max(5vw, calc((100vw - 1480px) / 2));
        background: var(--yellow);
        border-bottom: 1px solid var(--ink);
      }
      .disclosure p {
        max-width: 1080px;
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
      }
      .intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(360px, .7fr);
        gap: clamp(50px, 8vw, 130px);
        padding: clamp(90px, 11vw, 160px) max(5vw, calc((100vw - 1480px) / 2));
        background: var(--cream);
        border-bottom: 1px solid var(--ink);
      }
      .intro h2, .section-head h2, .verdict h2 {
        margin: 0;
        font: 400 clamp(58px, 8.5vw, 126px)/.8 var(--serif);
        letter-spacing: -.055em;
      }
      .intro__text { align-self: end; }
      .intro__text p {
        margin: 0 0 22px;
        font-size: clamp(17px, 1.4vw, 22px);
        line-height: 1.55;
      }
      .intro__text p:last-child { margin-bottom: 0; }
      .carts {
        padding: clamp(82px, 10vw, 150px) max(5vw, calc((100vw - 1480px) / 2));
        border-bottom: 1px solid var(--ink);
      }
      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 380px;
        gap: 40px;
        align-items: end;
        margin-bottom: 52px;
      }
      .section-head p {
        margin: 0;
        font-size: 18px;
        line-height: 1.45;
      }
      .cart-console {
        display: grid;
        grid-template-columns: minmax(250px, .68fr) minmax(0, 1.32fr);
        border: 1px solid var(--ink);
        background: var(--cream);
      }
      .cart-tabs { border-right: 1px solid var(--ink); }
      .cart-tab {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 18px;
        padding: 22px;
        border: 0;
        border-bottom: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        text-align: left;
        cursor: pointer;
      }
      .cart-tab:last-child { border-bottom: 0; }
      .cart-tab[aria-selected="true"] { background: var(--blue); color: white; }
      .cart-tab:hover, .cart-tab:focus-visible { background: var(--yellow); color: var(--ink); outline: 0; }
      .cart-tab strong { font-size: 15px; }
      .cart-tab span { font: 700 10px/1.3 var(--mono); }
      .cart-panel { padding: clamp(28px, 5vw, 72px); }
      .cart-panel__top {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 30px;
        align-items: start;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--ink);
      }
      .cart-panel h3 {
        max-width: 760px;
        margin: 8px 0 14px;
        font: 400 clamp(38px, 5.2vw, 76px)/.86 var(--serif);
        letter-spacing: -.045em;
      }
      .cart-panel__dek {
        max-width: 660px;
        margin: 0;
        font-size: 17px;
        line-height: 1.45;
      }
      .cart-total {
        min-width: 150px;
        text-align: right;
      }
      .cart-total strong { display: block; font: 400 clamp(48px, 5vw, 75px)/.8 var(--serif); }
      .cart-total span { font: 700 9px/1.4 var(--mono); text-transform: uppercase; }
      .cart-lines { list-style: none; margin: 0; padding: 18px 0 0; }
      .cart-lines li {
        display: grid;
        grid-template-columns: 45px 1fr auto;
        gap: 18px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
        align-items: baseline;
      }
      .cart-lines li:last-child { border-bottom: 0; }
      .cart-lines b { font: 700 10px/1 var(--mono); }
      .cart-lines a { font-size: 15px; font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .cart-lines span { font: 700 11px/1 var(--mono); }
      .cart-note { margin: 18px 0 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
      .copy-button, .filter {
        min-height: 43px;
        padding: 0 14px;
        border: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        font: 700 9px/1 var(--mono);
        letter-spacing: .08em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .copy-button { margin-top: 22px; }
      .copy-button:hover, .copy-button:focus-visible,
      .filter:hover, .filter:focus-visible,
      .filter[aria-pressed="true"] { background: var(--ink); color: white; outline: 0; }
      .desk {
        padding: clamp(85px, 10vw, 150px) max(5vw, calc((100vw - 1480px) / 2));
        background: var(--cream);
        border-bottom: 1px solid var(--ink);
      }
      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 30px;
      }
      .product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
      }
      .product {
        min-height: 510px;
        display: flex;
        flex-direction: column;
        padding: 24px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        background: var(--paper);
      }
      .product[data-availability="last-chance"] { background: #efe7d7; }
      .product__top {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 18px;
        margin-bottom: 42px;
      }
      .product__number { font: 700 10px/1 var(--mono); }
      .product__price {
        padding: 7px 9px;
        background: var(--yellow);
        font: 700 10px/1 var(--mono);
      }
      .product__maker { margin: 0 0 5px; font: 700 9px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
      .product h3 {
        margin: 0 0 12px;
        font: 400 clamp(31px, 2.5vw, 44px)/.92 var(--serif);
        letter-spacing: -.035em;
      }
      .product__badge {
        display: inline;
        margin: 0 0 25px;
        color: var(--red);
        font: 700 10px/1.3 var(--mono);
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .product__verdict {
        margin: 0 0 15px;
        font-size: 16px;
        font-weight: 800;
        line-height: 1.3;
      }
      .product__note, .product__boundary, .affiliate-note {
        margin: 0 0 14px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.5;
      }
      .product__boundary { color: #8a3427; }
      .affiliate-note { color: var(--green); }
      .product__link {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid var(--ink);
        font: 700 10px/1 var(--mono);
        letter-spacing: .07em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .product__link:hover, .product__link:focus-visible { color: var(--red); outline: 0; }
      .verdict {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(380px, 1.15fr);
        gap: clamp(55px, 9vw, 150px);
        padding: clamp(90px, 11vw, 165px) max(5vw, calc((100vw - 1480px) / 2));
        background: var(--blue);
        color: white;
        border-bottom: 1px solid var(--ink);
      }
      .verdict__lists { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-self: end; }
      .verdict h3 { margin: 0 0 20px; font: 400 32px/1 var(--serif); }
      .verdict ul { margin: 0; padding-left: 20px; }
      .verdict li { margin: 0 0 12px; font-size: 15px; line-height: 1.45; }
      .access {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(360px, 1.15fr);
        gap: clamp(50px, 8vw, 120px);
        padding: clamp(80px, 10vw, 140px) max(5vw, calc((100vw - 1480px) / 2));
        background: var(--yellow);
        border-bottom: 1px solid var(--ink);
      }
      .access h2 { margin: 0; font: 400 clamp(50px, 7vw, 104px)/.82 var(--serif); letter-spacing: -.05em; }
      .access__copy p { margin: 0 0 20px; font-size: 18px; line-height: 1.5; }
      .access__copy a { font-weight: 800; }
      .rules {
        padding: clamp(82px, 10vw, 145px) max(5vw, calc((100vw - 1480px) / 2));
        background: var(--paper);
        border-bottom: 1px solid var(--ink);
      }
      .rule-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        margin-top: 50px;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
      }
      .rule {
        min-height: 310px;
        display: flex;
        flex-direction: column;
        padding: 22px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
      }
      .rule h3 { margin: 0 0 16px; font: 400 26px/1 var(--serif); }
      .rule p { margin: auto 0 22px; color: var(--muted); font-size: 13px; line-height: 1.5; }
      .rule a { font: 700 9px/1.3 var(--mono); text-transform: uppercase; }
      .footer {
        display: grid;
        grid-template-columns: 1fr auto auto auto;
        min-height: 82px;
        background: var(--ink);
        color: white;
      }
      .footer > * {
        display: flex;
        align-items: center;
        padding: 0 20px;
        border-left: 1px solid rgba(255,255,255,.25);
        font: 700 9px/1.3 var(--mono);
        letter-spacing: .09em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .footer .footer__brand { border-left: 0; font-size: 13px; }
      .footer a:hover, .footer a:focus-visible { background: var(--red); outline: 0; }
      @media (max-width: 1100px) {
        .hero { grid-template-columns: 1fr; }
        .hero__photo { min-height: 68vw; }
        .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .rule-grid { grid-template-columns: repeat(2, 1fr); }
        .rule:last-child { grid-column: span 2; }
        .verdict { grid-template-columns: 1fr; }
      }
      @media (max-width: 760px) {
        .mast { grid-template-columns: 1fr auto; }
        .mast .optional { display: none; }
        .mast > * { padding: 0 13px; }
        .hero__copy { padding: 34px 20px 48px; gap: 68px; }
        .hero h1 { font-size: clamp(66px, 23vw, 108px); }
        .hero__meta { grid-template-columns: 1fr 1fr; }
        .hero__meta > :last-child { grid-column: span 2; }
        .hero__photo { min-height: 105vw; }
        .disclosure, .intro, .access { grid-template-columns: 1fr; padding-right: 20px; padding-left: 20px; }
        .section-head { grid-template-columns: 1fr; }
        .carts, .desk, .rules { padding-right: 20px; padding-left: 20px; }
        .cart-console { grid-template-columns: 1fr; }
        .cart-tabs {
          display: flex;
          overflow-x: auto;
          border-right: 0;
          border-bottom: 1px solid var(--ink);
          scrollbar-width: thin;
        }
        .cart-tab { min-width: 210px; border-right: 1px solid var(--ink); border-bottom: 0; }
        .cart-panel { padding: 28px 20px; }
        .cart-panel__top { grid-template-columns: 1fr; }
        .cart-total { text-align: left; }
        .product-grid { grid-template-columns: 1fr; }
        .product { min-height: 470px; }
        .verdict { padding-right: 20px; padding-left: 20px; }
        .verdict__lists { grid-template-columns: 1fr; }
        .rule-grid { grid-template-columns: 1fr; }
        .rule:last-child { grid-column: auto; }
        .footer { grid-template-columns: 1fr 1fr; }
        .footer > * { min-height: 60px; border-bottom: 1px solid rgba(255,255,255,.25); }
        .footer .footer__brand { grid-column: span 2; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the shopping desk</a>
    <header class="mast">
      <a class="brand" href="/">POINTCAST</a>
      <a class="optional" href="#carts">8 carts</a>
      <a class="optional" href="#desk">25 picks</a>
      <a href="/beach-commons/v6">V6 ↙</a>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero__copy">
          <div>
            <p class="stamp">PointCast Shopping Desk · Field Study 007 · Price check 07.27.26</p>
            <h1>The Beach <em>Utility Index</em></h1>
            <p class="hero__dek">{BEACH_COMMONS_V7.subtitle}</p>
          </div>
          <div class="hero__meta" aria-label="Edition summary">
            <div><span class="micro">Products</span><strong>25</strong></div>
            <div><span class="micro">Carts</span><strong>8</strong></div>
            <div><span class="micro">Affiliate earned</span><strong>$0</strong></div>
          </div>
        </div>
        <div class="hero__photo">
          <img
            src="/beach-commons/v6/assets/02-forty-five-minute-commons.png"
            alt="A conceptual low beach commons with people, stools, ground cloths, lanterns, wagons, and an official fire ring at golden hour"
            width="1536"
            height="1024"
          />
          <p class="hero__caption">Concept image from Beach Commons V6 · Products shown are illustrative, not the merchant picks below</p>
        </div>
      </section>

      <aside class="disclosure" aria-label="Affiliate disclosure">
        <p class="eyebrow">The honest link policy</p>
        <p>{BEACH_COMMONS_V7.affiliateBoundary} BioLite currently publishes an affiliate application; that is noted on its card, but this edition does not pretend an available program is an enrolled PointCast account.</p>
      </aside>

      <section class="intro">
        <div>
          <p class="eyebrow">The assignment</p>
          <h2>Buy a beach day that can put itself away.</h2>
        </div>
        <div class="intro__text">
          <p>The shopping problem is not “what is the best beach chair?” It is: what does a group of ten to twenty people need so coffee appears, shade behaves, cups come home, the fire ring has a real steward, and teardown is as satisfying as setup?</p>
          <p>The answer is less tent, more system. One low table is a station. Four stools are a contribution. Ten blue bags are an inventory. A wagon is governance with wheels. The expensive item should create something collective: shade, transport, access, or a genuinely good surface.</p>
          <p>{BEACH_COMMONS_V7.priceBoundary}</p>
        </div>
      </section>

      <section class="carts" id="carts">
        <div class="section-head">
          <div>
            <p class="eyebrow">Eight ways to spend</p>
            <h2>The carts</h2>
          </div>
          <p>Choose a cart to see the exact mix. Totals are computed from the price ledger below, before tax and shipping. Copying creates a plain-text handoff—no tracking and no checkout.</p>
        </div>

        <div class="cart-console" data-cart-console>
          <div class="cart-tabs" role="tablist" aria-label="Shopping cart options">
            {cartPayload.map((cart, index) => (
              <button
                class="cart-tab"
                type="button"
                role="tab"
                id={`cart-tab-${cart.id}`}
                aria-controls="cart-panel"
                aria-selected={index === 0 ? 'true' : 'false'}
                data-cart-id={cart.id}
              >
                <strong>{cart.eyebrow}</strong>
                <span>${cart.total.toFixed(2)}</span>
              </button>
            ))}
          </div>
          <div class="cart-panel" id="cart-panel" role="tabpanel" aria-live="polite" aria-labelledby={`cart-tab-${cartPayload[0].id}`}>
            <div class="cart-panel__top">
              <div>
                <p class="eyebrow" data-cart-eyebrow>{cartPayload[0].eyebrow}</p>
                <h3 data-cart-name>{cartPayload[0].name}</h3>
                <p class="cart-panel__dek" data-cart-dek>{cartPayload[0].dek}</p>
              </div>
              <div class="cart-total">
                <strong data-cart-total>${cartPayload[0].total.toFixed(2)}</strong>
                <span data-cart-people>{cartPayload[0].people}</span>
              </div>
            </div>
            <ul class="cart-lines" data-cart-lines>
              {cartPayload[0].lines.map((line) => (
                <li>
                  <b>{line.quantity}×</b>
                  <a href={line.url} rel="nofollow noopener" target="_blank">{line.name}</a>
                  <span>${(line.unitPrice * line.quantity).toFixed(2)}</span>
                </li>
              ))}
            </ul>
            <p class="cart-note" data-cart-note>{cartPayload[0].note}</p>
            <button class="copy-button" type="button" data-copy-cart>Copy this list</button>
          </div>
        </div>
      </section>

      <section class="desk" id="desk">
        <div class="section-head">
          <div>
            <p class="eyebrow">Twenty-five current picks</p>
            <h2>The desk</h2>
          </div>
          <p>These are researched recommendations and tradeoffs, not claims of hands-on testing. “Last chance” is the merchant’s label and may mean the item disappears quickly.</p>
        </div>
        <div class="filters" aria-label="Filter products">
          <button class="filter" type="button" aria-pressed="true" data-filter="all">All 25</button>
          {Object.entries(categoryLabels).map(([key, label]) => (
            <button class="filter" type="button" aria-pressed="false" data-filter={key}>{label}</button>
          ))}
        </div>
        <div class="product-grid" data-product-grid>
          {BEACH_UTILITY_PICKS.map((pick, index) => (
            <article class="product" data-category={pick.category} data-availability={pick.availability}>
              <div class="product__top">
                <span class="product__number">{String(index + 1).padStart(2, '0')} / 25</span>
                <span class="product__price">{pick.priceLabel}</span>
              </div>
              <p class="product__maker">{pick.maker} · {categoryLabels[pick.category]}</p>
              <h3>{pick.name}</h3>
              <p class="product__badge">{pick.badge}</p>
              <p class="product__verdict">{pick.verdict}</p>
              <p class="product__note">{pick.fieldNote}</p>
              {pick.boundary && <p class="product__boundary">Field boundary: {pick.boundary}</p>}
              {pick.affiliateProgram && (
                <p class="affiliate-note">
                  {pick.affiliateProgram.label}
                  {' '}
                  <a href={pick.affiliateProgram.url} rel="nofollow noopener" target="_blank">Program page ↗</a>
                </p>
              )}
              <a class="product__link" href={pick.url} rel="nofollow noopener" target="_blank">
                <span>Open plain merchant link</span><span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="verdict">
        <div>
          <p class="eyebrow">The useful judgment</p>
          <h2>Spend on the thing everybody touches.</h2>
        </div>
        <div class="verdict__lists">
          <div>
            <h3>Buy, borrow, or pool</h3>
            <ul>
              <li>A wagon before ten boutique totes.</li>
              <li>Shared shade before private tent walls.</li>
              <li>Good ground surfaces before decorative pillows.</li>
              <li>Flasks and steel cups before a sand-side appliance.</li>
              <li>Fire stewardship before fire accessories.</li>
              <li>Low dimmable light before a speaker-light spectacle.</li>
            </ul>
          </div>
          <div>
            <h3>Leave on the shelf</h3>
            <ul>
              <li>Overnight tents: beach camping is prohibited outside the RV park arrangement.</li>
              <li>Portable fire pits: Dockweiler’s official rings are the only fire center.</li>
              <li>Large enclosed canopies: ordinary shelters must stay under the posted dimensional and open-side rules.</li>
              <li>Glass coffee servers, generators, amplified PA systems, and disposable cup towers.</li>
              <li>Anything too difficult, fragile, or precious to assign to teardown.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="access">
        <div>
          <p class="eyebrow">The best $0 item in this guide</p>
          <h2>Use the access that already exists.</h2>
        </div>
        <div class="access__copy">
          <p>Dockweiler already has a beach access mat, and LA County lists six beach wheelchairs at the Dockweiler Youth Center, free during the posted service hours. The current page says they can be reserved 24 hours to seven days ahead by calling the Youth Center.</p>
          <p>That is better than tossing a picnic blanket on sand and calling the project accessible. Build the gathering near the official route, keep it open, ask participants what they need, and do not make one person’s arrival depend on an improvised product hack.</p>
          <p><a href="https://beaches.lacounty.gov/la-county-beach-ada-access/" target="_blank" rel="noopener">Read the current LA County access page ↗</a></p>
        </div>
      </section>

      <section class="rules">
        <div class="section-head">
          <div>
            <p class="eyebrow">Before one cart becomes an event</p>
            <h2>Read the site</h2>
          </div>
          <p>{BEACH_COMMONS_V7.fieldBoundary} Re-check conditions, water quality, closures, fire direction, and availability on the actual day.</p>
        </div>
        <div class="rule-grid">
          {BEACH_UTILITY_OFFICIAL_CONTEXT.map((item, index) => (
            <article class="rule">
              <p class="micro">Official source {String(index + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p>{item.note}</p>
              <a href={item.url} target="_blank" rel="noopener">Open official page ↗</a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="footer">
      <span class="footer__brand">POINTCAST · BEACH COMMONS V7</span>
      <a href="/beach-commons/v7.json">Machine edition</a>
      <a href="/b/0518">Block 0518</a>
      <a href="/beach-commons/v6">Previous edition</a>
    </footer>

    <script id="cart-data" type="application/json" set:html={JSON.stringify(cartPayload)} />
    <script is:inline>
      const cartData = JSON.parse(document.getElementById('cart-data')?.textContent || '[]');
      const cartById = new Map(cartData.map((cart) => [cart.id, cart]));
      const consoleEl = document.querySelector('[data-cart-console]');
      const panel = document.getElementById('cart-panel');
      let currentCart = cartData[0];

      function money(value) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
      }

      function renderCart(cart, tab) {
        if (!cart || !panel) return;
        currentCart = cart;
        document.querySelectorAll('[data-cart-id]').forEach((button) => {
          button.setAttribute('aria-selected', String(button === tab));
        });
        panel.setAttribute('aria-labelledby', tab.id);
        panel.querySelector('[data-cart-eyebrow]').textContent = cart.eyebrow;
        panel.querySelector('[data-cart-name]').textContent = cart.name;
        panel.querySelector('[data-cart-dek]').textContent = cart.dek;
        panel.querySelector('[data-cart-total]').textContent = money(cart.total);
        panel.querySelector('[data-cart-people]').textContent = cart.people;
        panel.querySelector('[data-cart-note]').textContent = cart.note;
        const list = panel.querySelector('[data-cart-lines]');
        list.replaceChildren(...cart.lines.map((line) => {
          const li = document.createElement('li');
          const quantity = document.createElement('b');
          quantity.textContent = `${line.quantity}×`;
          const link = document.createElement('a');
          link.href = line.url;
          link.target = '_blank';
          link.rel = 'nofollow noopener';
          link.textContent = line.name;
          const subtotal = document.createElement('span');
          subtotal.textContent = money(line.unitPrice * line.quantity);
          li.append(quantity, link, subtotal);
          return li;
        }));
      }

      consoleEl?.addEventListener('click', (event) => {
        const tab = event.target.closest('[data-cart-id]');
        if (!tab) return;
        renderCart(cartById.get(tab.dataset.cartId), tab);
      });

      document.querySelector('[data-copy-cart]')?.addEventListener('click', async (event) => {
        if (!currentCart) return;
        const lines = [
          currentCart.name,
          `${money(currentCart.total)} before tax and shipping`,
          '',
          ...currentCart.lines.map((line) => `${line.quantity} × ${line.maker} ${line.name} — ${money(line.unitPrice * line.quantity)} — ${line.url}`),
          '',
          currentCart.note,
          'PointCast Beach Utility Index — prices checked 2026-07-27 — plain merchant links, no affiliate tracking.',
        ];
        const button = event.currentTarget;
        try {
          await navigator.clipboard.writeText(lines.join('\n'));
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Copy unavailable';
        }
        window.setTimeout(() => { button.textContent = 'Copy this list'; }, 1800);
      });

      document.querySelector('.filters')?.addEventListener('click', (event) => {
        const filter = event.target.closest('[data-filter]');
        if (!filter) return;
        const category = filter.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button === filter));
        });
        document.querySelectorAll('[data-category]').forEach((product) => {
          product.hidden = category !== 'all' && product.dataset.category !== category;
        });
      });
    </script>
  </body>
</html>
