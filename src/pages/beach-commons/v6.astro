---
import {
  BEACH_COMMONS_V6,
  FIRE_RING_MODULES,
  FIRE_RING_PLATES,
} from '../../lib/beach-commons-v6';

const title = `${BEACH_COMMONS_V6.title} — ${BEACH_COMMONS_V6.subtitle}`;
const description = BEACH_COMMONS_V6.dek;
const canonical = BEACH_COMMONS_V6.url;
const socialImage = 'https://pointcast.xyz/images/og/beach-commons-v6.png';
const hero = FIRE_RING_PLATES[2];
const checkoutUrl = BEACH_COMMONS_V6.checkout.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${canonical}#field-study`,
  url: canonical,
  name: title,
  description,
  datePublished: BEACH_COMMONS_V6.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Field Study',
    url: 'https://pointcast.xyz',
  },
  isBasedOn: BEACH_COMMONS_V6.previousEdition.url,
  mainEntityOfPage: BEACH_COMMONS_V6.jsonUrl,
  image: FIRE_RING_PLATES.map((plate) => new URL(plate.image, canonical).href),
  creator: BEACH_COMMONS_V6.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#10191f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V6.jsonUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,800&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --ink: #15201f;
        --paper: #eee7d9;
        --salt: #fff8e9;
        --fire: #ef5a32;
        --amber: #f2b446;
        --ocean: #255e70;
        --night: #10191f;
        --fog: #c9d2cf;
        --line: rgba(21, 32, 31, .25);
        --sans: 'DM Sans', sans-serif;
        --serif: 'DM Serif Display', serif;
        --mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
      }
      a { color: inherit; }
      button { font: inherit; }
      img { max-width: 100%; }
      a, button { -webkit-tap-highlight-color: transparent; }

      .skip {
        position: fixed;
        z-index: 300;
        top: 8px;
        left: 8px;
        transform: translateY(-150%);
        padding: 10px 14px;
        background: white;
        font: 700 10px/1 var(--mono);
      }
      .skip:focus { transform: translateY(0); }

      .head {
        position: sticky;
        z-index: 90;
        top: 0;
        display: grid;
        grid-template-columns: minmax(160px, 1fr) auto auto auto auto;
        min-height: 54px;
        background: rgba(16, 25, 31, .96);
        color: white;
        border-bottom: 1px solid rgba(255,255,255,.22);
        backdrop-filter: blur(14px);
      }
      .head > * {
        min-width: 0;
        display: flex;
        align-items: center;
        padding: 0 20px;
        border-left: 1px solid rgba(255,255,255,.2);
        font: 700 9px/1 var(--mono);
        letter-spacing: .11em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .head .brand {
        border-left: 0;
        font: 800 14px/1 var(--sans);
        letter-spacing: .17em;
      }
      .head a:hover, .head a:focus-visible {
        background: var(--fire);
        outline: 0;
      }

      .hero {
        position: relative;
        min-height: min(940px, calc(100svh - 54px));
        display: flex;
        align-items: flex-end;
        isolation: isolate;
        overflow: hidden;
        background: var(--night);
        color: white;
      }
      .hero__image, .hero__wash {
        position: absolute;
        inset: 0;
      }
      .hero__image {
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero__wash {
        z-index: -1;
        background:
          linear-gradient(90deg, rgba(7, 13, 17, .86), rgba(7, 13, 17, .1) 74%),
          linear-gradient(0deg, rgba(7, 13, 17, .92), transparent 64%);
      }
      .hero__copy {
        width: min(1460px, 100%);
        margin: 0 auto;
        padding: clamp(110px, 15vw, 210px) clamp(22px, 5vw, 80px) clamp(46px, 7vw, 98px);
      }
      .kicker, .eyebrow {
        margin: 0 0 18px;
        font: 700 10px/1.45 var(--mono);
        letter-spacing: .15em;
        text-transform: uppercase;
      }
      .hero h1 {
        max-width: 1300px;
        margin: 0;
        font: 400 clamp(64px, 12.5vw, 184px)/.72 var(--serif);
        letter-spacing: -.058em;
      }
      .hero h1 span {
        display: block;
        color: var(--amber);
        font-style: italic;
      }
      .hero__dek {
        max-width: 780px;
        margin: 30px 0 0;
        font-size: clamp(19px, 2.15vw, 33px);
        font-weight: 600;
        line-height: 1.1;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 17px;
        border: 1px solid currentColor;
        background: transparent;
        color: inherit;
        font: 700 10px/1 var(--mono);
        letter-spacing: .095em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .button--hot { background: var(--fire); border-color: var(--fire); color: white; }
      .button--stripe { background: var(--night); border-color: var(--night); color: white; }
      .button--disabled { opacity: .68; cursor: wait; }
      .button:hover, .button:focus-visible { background: white; color: var(--night); outline: 0; }

      .contribution {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(330px, .9fr);
        gap: clamp(42px, 8vw, 130px);
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
        background: var(--salt);
      }
      .contribution h2, .section-title {
        margin: 0;
        font: 400 clamp(58px, 9vw, 132px)/.8 var(--serif);
        letter-spacing: -.05em;
      }
      .contribution h2 em { color: var(--fire); font-weight: 400; }
      .contribution__side { align-self: end; }
      .contribution__side > p {
        margin: 0 0 26px;
        font-size: clamp(18px, 1.65vw, 25px);
        line-height: 1.45;
      }
      .checkout-card {
        padding: 26px;
        border: 1px solid var(--ink);
        background: var(--amber);
      }
      .checkout-card__price {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 22px;
        border-bottom: 1px solid var(--ink);
      }
      .checkout-card__price strong { font: 400 82px/.75 var(--serif); letter-spacing: -.055em; }
      .checkout-card__price span { font: 700 9px/1.4 var(--mono); text-align: right; text-transform: uppercase; }
      .checkout-card p { margin: 22px 0; font-size: 14px; line-height: 1.5; }
      .checkout-card .button { width: 100%; }
      .checkout-card small {
        display: block;
        margin-top: 14px;
        font: 500 9px/1.45 var(--mono);
      }

      .paths {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        background: var(--night);
        color: white;
      }
      .path {
        min-height: 420px;
        display: flex;
        flex-direction: column;
        padding: clamp(28px, 4.5vw, 70px);
        border-right: 1px solid rgba(255,255,255,.22);
      }
      .path:last-child { border-right: 0; }
      .path b { color: var(--amber); font: 700 10px/1 var(--mono); }
      .path h3 {
        margin: auto 0 18px;
        font: 400 clamp(40px, 4.8vw, 70px)/.86 var(--serif);
        letter-spacing: -.04em;
      }
      .path p { margin: 0; font-size: 16px; line-height: 1.48; }

      .modules {
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
      }
      .modules__intro {
        display: grid;
        grid-template-columns: 1fr .65fr;
        gap: 40px;
        align-items: end;
        margin-bottom: 58px;
      }
      .modules__intro p:last-child {
        margin: 0;
        font-size: 18px;
        line-height: 1.5;
      }
      .module-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        border: 1px solid var(--ink);
      }
      .module {
        min-height: 310px;
        display: flex;
        flex-direction: column;
        padding: 24px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
      }
      .module:nth-child(5n) { border-right: 0; }
      .module:nth-last-child(-n+5) { border-bottom: 0; }
      .module__id { font: 700 9px/1 var(--mono); }
      .module h3 {
        margin: auto 0 8px;
        font: 400 35px/.92 var(--serif);
        letter-spacing: -.025em;
      }
      .module b {
        color: var(--fire);
        font: 700 9px/1.35 var(--mono);
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .module p { margin: 16px 0 0; font-size: 13px; line-height: 1.45; }

      .clock {
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
        background: var(--ocean);
        color: white;
      }
      .clock-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 58px;
        border: 1px solid rgba(255,255,255,.45);
      }
      .clock-step {
        min-height: 270px;
        display: flex;
        flex-direction: column;
        padding: 26px;
        border-right: 1px solid rgba(255,255,255,.45);
      }
      .clock-step:last-child { border-right: 0; }
      .clock-step span { font: 700 10px/1 var(--mono); }
      .clock-step strong {
        margin: auto 0 10px;
        color: var(--amber);
        font: 400 58px/.8 var(--serif);
      }
      .clock-step p { margin: 0; font-size: 15px; line-height: 1.45; }

      .sound-lab {
        display: grid;
        grid-template-columns: minmax(300px, .68fr) minmax(0, 1.32fr);
        min-height: 780px;
        background: var(--night);
        color: white;
      }
      .sound-copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(42px, 6vw, 90px);
        border-right: 1px solid rgba(255,255,255,.22);
      }
      .sound-copy h2 {
        margin: 0;
        font: 400 clamp(58px, 7.5vw, 112px)/.78 var(--serif);
        letter-spacing: -.05em;
      }
      .sound-copy h2 em { color: var(--amber); font-weight: 400; }
      .sound-copy p { max-width: 460px; margin: 30px 0 0; font-size: 17px; line-height: 1.5; }
      .sound-copy small { color: rgba(255,255,255,.62); font: 500 9px/1.5 var(--mono); }
      .sound-board { display: grid; grid-template-columns: repeat(2, 1fr); }
      .sound-key {
        position: relative;
        min-height: 390px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        padding: clamp(28px, 4vw, 64px);
        border: 0;
        border-right: 1px solid rgba(255,255,255,.22);
        border-bottom: 1px solid rgba(255,255,255,.22);
        background: transparent;
        color: white;
        cursor: pointer;
        text-align: left;
      }
      .sound-key:nth-child(even) { border-right: 0; }
      .sound-key:nth-last-child(-n+2) { border-bottom: 0; }
      .sound-key span { font: 700 10px/1 var(--mono); letter-spacing: .1em; }
      .sound-key strong { font: 400 clamp(50px, 7vw, 104px)/.75 var(--serif); letter-spacing: -.05em; }
      .sound-key p { max-width: 380px; margin: 0; font-size: 15px; line-height: 1.45; }
      .sound-key:hover, .sound-key:focus-visible, .sound-key[data-active="true"] {
        background: var(--fire);
        outline: 0;
      }

      .plates { background: var(--paper); }
      .plates__intro {
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
      }
      .plates__intro p:last-child {
        max-width: 620px;
        margin: 30px 0 0 auto;
        font-size: 18px;
        line-height: 1.5;
      }
      .plate {
        min-height: 760px;
        display: grid;
        grid-template-columns: minmax(300px, .36fr) minmax(0, .64fr);
        border-top: 1px solid var(--line);
      }
      .plate:nth-child(odd) { grid-template-columns: minmax(0, .64fr) minmax(300px, .36fr); }
      .plate:nth-child(odd) .plate__copy { order: 2; }
      .plate__copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(34px, 5vw, 76px);
      }
      .plate__copy span { font: 700 10px/1 var(--mono); }
      .plate h3 {
        margin: 22px 0 0;
        font: 400 clamp(48px, 6vw, 88px)/.82 var(--serif);
        letter-spacing: -.045em;
      }
      .plate p { margin: 36px 0 0; font-size: 18px; line-height: 1.5; }
      .plate__image {
        position: relative;
        min-width: 0;
        min-height: 600px;
        padding: 0;
        overflow: hidden;
        border: 0;
        background: var(--night);
        cursor: zoom-in;
      }
      .plate__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .7s ease;
      }
      .plate__image b {
        position: absolute;
        right: 18px;
        bottom: 18px;
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--amber);
        color: var(--night);
        font-size: 26px;
      }
      .plate__image:hover img, .plate__image:focus-visible img { transform: scale(1.025); }
      .plate__image:focus-visible { outline: 4px solid var(--amber); outline-offset: -4px; }

      .clearance {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(42px, 8vw, 120px);
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
        background: var(--amber);
      }
      .clearance h2 {
        margin: 0;
        font: 400 clamp(58px, 9vw, 132px)/.8 var(--serif);
        letter-spacing: -.05em;
      }
      .clearance__copy { align-self: end; }
      .clearance__copy > p { margin: 0 0 24px; font-size: clamp(18px, 2vw, 28px); line-height: 1.42; }
      .rules {
        margin: 34px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--ink);
      }
      .rules li {
        display: grid;
        grid-template-columns: 42px 1fr;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid var(--ink);
        font-size: 13px;
        line-height: 1.45;
      }
      .rules li::before {
        content: counter(list-item, decimal-leading-zero);
        font: 700 9px/1.5 var(--mono);
      }

      .terms {
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
        background: var(--salt);
      }
      .terms-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        margin-top: 56px;
        border: 1px solid var(--ink);
      }
      .term {
        min-height: 260px;
        display: flex;
        flex-direction: column;
        padding: 24px;
        border-right: 1px solid var(--ink);
      }
      .term:last-child { border-right: 0; }
      .term span { color: var(--fire); font: 700 9px/1 var(--mono); }
      .term p { margin: auto 0 0; font-size: 14px; line-height: 1.5; }
      .terms__close {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 24px;
        align-items: center;
        margin-top: 36px;
        padding-top: 28px;
        border-top: 1px solid var(--ink);
      }
      .terms__close p { max-width: 760px; margin: 0; font: 500 10px/1.55 var(--mono); }

      .boundary {
        padding: clamp(80px, 11vw, 165px) max(5vw, calc((100vw - 1460px) / 2));
        background: var(--fire);
        color: white;
      }
      .boundary p {
        max-width: 1200px;
        margin: 0;
        font: 400 clamp(34px, 5.2vw, 78px)/1 var(--serif);
        letter-spacing: -.035em;
      }
      .boundary .actions { margin-top: 44px; }

      .foot {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        padding: 28px 5vw;
        background: var(--night);
        color: white;
        font: 700 9px/1.5 var(--mono);
        letter-spacing: .09em;
        text-transform: uppercase;
      }
      .foot nav { display: flex; flex-wrap: wrap; gap: 18px; }

      dialog {
        width: 100vw;
        max-width: none;
        height: 100vh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: var(--night);
        color: white;
      }
      dialog::backdrop { background: rgba(16,25,31,.96); }
      .viewer {
        min-height: 100%;
        display: grid;
        grid-template-rows: 56px minmax(0, 1fr) auto;
      }
      .viewer__top {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,.25);
        font: 700 9px/1 var(--mono);
        letter-spacing: .1em;
      }
      .viewer__top span, .viewer__close { display: flex; align-items: center; padding: 0 18px; }
      .viewer__close {
        border: 0;
        border-left: 1px solid rgba(255,255,255,.25);
        background: transparent;
        color: white;
        font: inherit;
        cursor: pointer;
        text-transform: uppercase;
      }
      .viewer__stage { min-height: 0; display: grid; place-items: center; padding: 18px; }
      .viewer__stage img { width: 100%; height: 100%; max-height: calc(100vh - 190px); object-fit: contain; }
      .viewer__caption {
        display: grid;
        grid-template-columns: .35fr 1fr;
        gap: 24px;
        padding: 18px;
        border-top: 1px solid rgba(255,255,255,.25);
      }
      .viewer__caption strong { color: var(--amber); font: 700 10px/1.4 var(--mono); text-transform: uppercase; }
      .viewer__caption span { font-size: 14px; line-height: 1.45; }

      @media (max-width: 1120px) {
        .module-grid { grid-template-columns: repeat(2, 1fr); }
        .module:nth-child(5n) { border-right: 1px solid var(--ink); }
        .module:nth-child(even) { border-right: 0; }
        .module:nth-last-child(-n+5) { border-bottom: 1px solid var(--ink); }
        .module:nth-last-child(-n+2) { border-bottom: 0; }
        .terms-grid { grid-template-columns: repeat(2, 1fr); }
        .term { border-bottom: 1px solid var(--ink); }
        .term:nth-child(even) { border-right: 0; }
        .term:last-child { grid-column: 1 / -1; min-height: 200px; border-bottom: 0; }
      }

      @media (max-width: 820px) {
        .contribution, .modules__intro, .clearance, .sound-lab { grid-template-columns: 1fr; }
        .paths { grid-template-columns: 1fr; }
        .path { min-height: 300px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.22); }
        .path:last-child { border-bottom: 0; }
        .clock-grid { grid-template-columns: repeat(2, 1fr); }
        .clock-step:nth-child(even) { border-right: 0; }
        .clock-step:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,.45); }
        .sound-copy { min-height: 560px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.22); }
        .plate, .plate:nth-child(odd) { grid-template-columns: 1fr; min-height: 0; }
        .plate:nth-child(odd) .plate__copy { order: 0; }
        .plate__copy { min-height: 400px; }
        .plate__image { min-height: 68vw; }
        .terms__close { grid-template-columns: 1fr; }
      }

      @media (max-width: 560px) {
        .head { grid-template-columns: minmax(0, 1fr) auto auto; }
        .head .issue, .head .back { display: none; }
        .head > * { padding-inline: 12px; }
        .hero__image { object-position: 52% center; }
        .hero h1 { font-size: clamp(62px, 20vw, 94px); }
        .hero__dek { font-size: 18px; }
        .checkout-card__price strong { font-size: 68px; }
        .module-grid, .clock-grid, .sound-board, .terms-grid { grid-template-columns: 1fr; }
        .module, .module:nth-child(5n), .module:nth-child(even),
        .clock-step, .sound-key, .sound-key:nth-child(even), .term, .term:nth-child(even) {
          border-right: 0;
        }
        .module, .module:nth-last-child(-n+5), .module:nth-last-child(-n+2),
        .clock-step, .clock-step:nth-child(-n+2), .sound-key, .sound-key:nth-last-child(-n+2),
        .term {
          border-bottom: 1px solid currentColor;
        }
        .module:last-child, .clock-step:last-child, .sound-key:last-child, .term:last-child { border-bottom: 0; }
        .module { min-height: 255px; }
        .sound-key { min-height: 320px; }
        .term:last-child { grid-column: auto; }
        .plate__image { min-height: 78vw; }
        .foot { flex-direction: column; }
        .viewer__caption { grid-template-columns: 1fr; gap: 8px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .plate__image img { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#study">Skip to field study</a>

    <header class="head">
      <a class="brand" href="/">PointCast</a>
      <span class="issue">Field Study 006 · El Segundo Coast</span>
      <a class="back" href="/beach-commons/v5">V5 ↙</a>
      <a href="#contribute">$100 ↘</a>
      <a href="/beach-commons/v6.json">JSON ↗</a>
    </header>

    <main id="study">
      <section class="hero" aria-labelledby="page-title">
        <img class="hero__image" src={hero.image} width="1536" height="1024" alt={hero.alt} fetchpriority="high" />
        <div class="hero__wash"></div>
        <div class="hero__copy">
          <p class="kicker">PointCast Field Study 006 · Fundable prototype · July 2026</p>
          <h1 id="page-title">The $100 <span>Fire-Ring Commons</span></h1>
          <p class="hero__dek">{BEACH_COMMONS_V6.dek}</p>
          <div class="actions">
            <a class="button button--hot" href="#contribute">Choose a contribution path ↓</a>
            <a class="button" href="#score">Play the four-part score ↓</a>
          </div>
        </div>
      </section>

      <section class="contribution" id="contribute" aria-labelledby="contribution-title">
        <div>
          <p class="eyebrow">The experiment</p>
          <h2 id="contribution-title">Everyone brings <em>one complete thing.</em></h2>
        </div>
        <div class="contribution__side">
          <p>Ten people can make a useful commons without buying a “festival.” Bring a durable non-food module, lend one for the field test, or contribute one $100 unit to the shared kit.</p>
          <div class="checkout-card">
            <div class="checkout-card__price">
              <strong>$100</strong>
              <span>One-time<br />project support</span>
            </div>
            <p>Supports reusable prototype gear, safety, access, documentation, and clearance work. The first target is ten modules / $1,000.</p>
            {checkoutUrl ? (
              <a
                class="button button--stripe"
                href={checkoutUrl}
                target="_blank"
                rel="external nofollow noopener"
                data-checkout
              >
                Contribute $100 securely with Stripe ↗
              </a>
            ) : (
              <span class="button button--stripe button--disabled" aria-disabled="true">
                Connecting secure Stripe checkout
              </span>
            )}
            <small>Not a ticket, reservation, donation, tax-deductible gift, event date, promise of access, or fire-ring claim. Stripe hosts the card form and receipt.</small>
          </div>
        </div>
      </section>

      <section class="paths" aria-label="Three ways to contribute">
        <article class="path">
          <b>PATH A · GOODS</b>
          <h3>Bring the module.</h3>
          <p>Choose one useful category, spend up to $100, keep ownership, and take every object home after the field test.</p>
        </article>
        <article class="path">
          <b>PATH B · CARD</b>
          <h3>Back the pool.</h3>
          <p>One $100 Stripe contribution helps PointCast assemble shared gear, safety, access, documentation, and the compliance runway.</p>
        </article>
        <article class="path">
          <b>PATH C · PLAY</b>
          <h3>Score the night.</h3>
          <p>Use one $100 unit for bells, drawing tools, light, weather notation, or a cooperative game that remains quiet and reversible.</p>
        </article>
      </section>

      <section class="modules" aria-labelledby="modules-title">
        <header class="modules__intro">
          <div>
            <p class="eyebrow">The ten-module menu</p>
            <h2 class="section-title" id="modules-title">No food. No filler. No duplicate piles.</h2>
          </div>
          <p>Before anyone buys, the group claims categories. The point is complementarity: seating, warmth, light, sound, noticing, transport, access, care, safety, and a clean exit.</p>
        </header>
        <div class="module-grid">
          {FIRE_RING_MODULES.map((module) => (
            <article class="module">
              <span class="module__id">{module.id}</span>
              <div>
                <h3>{module.title}</h3>
                <b>{module.cue}</b>
                <p>{module.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="clock" aria-labelledby="clock-title">
        <p class="eyebrow">The honest clock</p>
        <h2 class="section-title" id="clock-title">The exit is part of the architecture.</h2>
        <div class="clock-grid">
          <article class="clock-step">
            <span>01 · ARRIVE</span>
            <strong>45 min</strong>
            <p>Inventory, safety check, find an available ring, mark the empty halo, roll the access gap, and build the low crescent.</p>
          </article>
          <article class="clock-step">
            <span>02 · LISTEN</span>
            <strong>75 min</strong>
            <p>Read wind and waves, sketch, talk, weave a small sample, and keep the first hour mostly unprogrammed.</p>
          </article>
          <article class="clock-step">
            <span>03 · PLAY</span>
            <strong>30 min</strong>
            <p>Run Jet / Wave / Fire / Us once. Acoustic answer, collective chord, then a full minute of beach quiet.</p>
          </article>
          <article class="clock-step">
            <span>04 · LEAVE</span>
            <strong>45 min</strong>
            <p>Cool and close under current rules, count every module, clean beyond the footprint, nest the crates, and roll out.</p>
          </article>
        </div>
      </section>

      <section class="sound-lab" id="score" aria-labelledby="score-title">
        <div class="sound-copy">
          <div>
            <p class="eyebrow">Interactive score · audio on tap</p>
            <h2 id="score-title">Jet. Wave. Fire. <em>Us.</em></h2>
            <p>Four synthetic sketches for the field score. Tap any panel. In the real circle, replace the screen with sky, surf, one acoustic object, and other people.</p>
          </div>
          <small>Sound starts only after a tap. Keep device volume low. No recording, tracking, microphone, autoplay, or external audio service.</small>
        </div>
        <div class="sound-board">
          {BEACH_COMMONS_V6.score.map((movement, index) => (
            <button class="sound-key" type="button" data-sound={movement.id} aria-label={`Play ${movement.title} sound sketch`}>
              <span>0{index + 1} · TAP TO SOUND</span>
              <strong>{movement.title}</strong>
              <p>{movement.cue}</p>
            </button>
          ))}
        </div>
      </section>

      <section class="plates" id="plates" aria-labelledby="plates-title">
        <header class="plates__intro">
          <p class="eyebrow">Three generated field plates</p>
          <h2 class="section-title" id="plates-title">Arrive. Assemble. Listen.</h2>
          <p>Original PointCast image studies show the kit as goods, as a low temporary room, and as a blue-hour collective score. They are prototypes, not site plans.</p>
        </header>
        {FIRE_RING_PLATES.map((plate, index) => (
          <article class="plate">
            <div class="plate__copy">
              <div>
                <span>{plate.id} / 03</span>
                <h3>{plate.title}</h3>
              </div>
              <p>{plate.description}</p>
            </div>
            <button class="plate__image" type="button" data-open={index} aria-label={`Open ${plate.title} full screen`}>
              <img src={plate.image} width="1536" height="1024" alt={plate.alt} loading={index === 0 ? 'eager' : 'lazy'} />
              <b aria-hidden="true">+</b>
            </button>
          </article>
        ))}
      </section>

      <section class="clearance" aria-labelledby="clearance-title">
        <div>
          <p class="eyebrow">Reality gate · verified July 27, 2026</p>
          <h2 id="clearance-title">Fund the prototype. Clear the gathering.</h2>
        </div>
        <div class="clearance__copy">
          <p>LA County’s current page says organized groups planning beach activities must obtain a Special Event Use Permit—and posts a deadline no later than three weeks before the requested date. So there is no public “next week” event announcement here.</p>
          <div class="actions">
            <a class="button" href="https://beaches.lacounty.gov/special-event-permit/" target="_blank" rel="external noopener">Official permit page ↗</a>
            <a class="button" href="https://beaches.lacounty.gov/dockweiler-beach-fire-pits/" target="_blank" rel="external noopener">Official fire-pit rules ↗</a>
          </div>
          <ol class="rules">
            {BEACH_COMMONS_V6.operatingRules.map((rule) => <li>{rule}</li>)}
          </ol>
        </div>
      </section>

      <section class="terms" aria-labelledby="terms-title">
        <p class="eyebrow">Before the card leaves your hand</p>
        <h2 class="section-title" id="terms-title">Project support, said plainly.</h2>
        <div class="terms-grid">
          {BEACH_COMMONS_V6.contributionTerms.map((term, index) => (
            <article class="term">
              <span>0{index + 1}</span>
              <p>{term}</p>
            </article>
          ))}
        </div>
        <div class="terms__close">
          <p>Checkout amount: $100 USD, one time. Card handling: Stripe-hosted Checkout. Publisher: PointCast / Michael Hoydich. Questions before contributing: use the PointCast contact route. Contribution status and Checkout URL are also disclosed in the machine edition.</p>
          {checkoutUrl ? (
            <a class="button button--stripe" href={checkoutUrl} target="_blank" rel="external nofollow noopener" data-checkout>
              Contribute $100 with Stripe ↗
            </a>
          ) : (
            <span class="button button--stripe button--disabled" aria-disabled="true">Stripe connection pending</span>
          )}
        </div>
      </section>

      <section class="boundary" aria-label="Project boundary">
        <p>{BEACH_COMMONS_V6.boundary}</p>
        <div class="actions">
          <a class="button" href="/beach-commons/v6.json">Machine edition ↗</a>
          <a class="button" href="/b/0516">Block 0516 ↗</a>
          <a class="button" href="/beach-commons/v5">Previous edition ↙</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Michael Hoydich + Codex · El Segundo · 2026</span>
      <nav aria-label="Field study links">
        <a href="/beach-commons/v5">V5 · Weather School</a>
        <a href="/beach-commons/v6.json">Machine edition</a>
        <a href="/">PointCast home</a>
      </nav>
    </footer>

    <dialog aria-label="Fire-Ring Commons image viewer" data-viewer>
      <div class="viewer">
        <header class="viewer__top">
          <span data-count>01 / 03</span>
          <button class="viewer__close" type="button" data-close>Close ×</button>
        </header>
        <div class="viewer__stage"><img data-viewer-image src={hero.image} alt="" /></div>
        <div class="viewer__caption">
          <strong data-caption-title></strong>
          <span data-caption-copy></span>
        </div>
      </div>
    </dialog>

    <script define:vars={{ plates: FIRE_RING_PLATES }}>
      const dialog = document.querySelector('[data-viewer]');
      const viewerImage = dialog?.querySelector('[data-viewer-image]');
      const viewerCount = dialog?.querySelector('[data-count]');
      const viewerTitle = dialog?.querySelector('[data-caption-title]');
      const viewerCopy = dialog?.querySelector('[data-caption-copy]');
      let returnFocus = null;

      document.querySelectorAll('[data-open]').forEach((button) => {
        button.addEventListener('click', () => {
          const index = Number(button.dataset.open);
          const plate = plates[index];
          if (!plate || !viewerImage || !viewerCount || !viewerTitle || !viewerCopy) return;
          viewerImage.src = plate.image;
          viewerImage.alt = plate.alt;
          viewerCount.textContent = `${plate.id} / 03`;
          viewerTitle.textContent = plate.title;
          viewerCopy.textContent = plate.description;
          returnFocus = button;
          dialog?.showModal();
        });
      });
      dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener('close', () => returnFocus?.focus());

      let audioContext;
      const getAudio = () => {
        if (!audioContext) {
          const Context = window.AudioContext || window.webkitAudioContext;
          audioContext = new Context();
        }
        if (audioContext.state === 'suspended') audioContext.resume();
        return audioContext;
      };

      const envelope = (context, start, duration, peak = 0.12) => {
        const gain = context.createGain();
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.exponentialRampToValueAtTime(peak, start + Math.min(.08, duration / 4));
        gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
        gain.connect(context.destination);
        return gain;
      };

      const playJet = (context) => {
        const now = context.currentTime;
        const oscillator = context.createOscillator();
        const filter = context.createBiquadFilter();
        oscillator.type = 'sawtooth';
        oscillator.frequency.setValueAtTime(170, now);
        oscillator.frequency.exponentialRampToValueAtTime(72, now + 2.5);
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(900, now);
        filter.frequency.exponentialRampToValueAtTime(180, now + 2.5);
        oscillator.connect(filter).connect(envelope(context, now, 2.6, .055));
        oscillator.start(now);
        oscillator.stop(now + 2.7);
      };

      const playWave = (context) => {
        const now = context.currentTime;
        const length = Math.floor(context.sampleRate * 3);
        const buffer = context.createBuffer(1, length, context.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < length; i += 1) data[i] = Math.random() * 2 - 1;
        const source = context.createBufferSource();
        const filter = context.createBiquadFilter();
        const gain = context.createGain();
        source.buffer = buffer;
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(360, now);
        filter.frequency.linearRampToValueAtTime(1400, now + 1.2);
        filter.frequency.linearRampToValueAtTime(260, now + 3);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(.16, now + 1.15);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 3);
        source.connect(filter).connect(gain).connect(context.destination);
        source.start(now);
      };

      const playFire = (context) => {
        const now = context.currentTime;
        [0, .13, .31, .48, .72, .78, 1.05, 1.34, 1.39, 1.7].forEach((offset, index) => {
          const oscillator = context.createOscillator();
          oscillator.type = index % 2 ? 'square' : 'triangle';
          oscillator.frequency.setValueAtTime(420 + Math.random() * 1600, now + offset);
          oscillator.frequency.exponentialRampToValueAtTime(120, now + offset + .07);
          oscillator.connect(envelope(context, now + offset, .08, .035 + Math.random() * .03));
          oscillator.start(now + offset);
          oscillator.stop(now + offset + .09);
        });
      };

      const playUs = (context) => {
        const now = context.currentTime;
        [196, 246.94, 293.66, 392].forEach((frequency, index) => {
          const oscillator = context.createOscillator();
          oscillator.type = index % 2 ? 'sine' : 'triangle';
          oscillator.frequency.value = frequency;
          oscillator.detune.value = index * 2 - 3;
          oscillator.connect(envelope(context, now + index * .07, 3.2, .045));
          oscillator.start(now + index * .07);
          oscillator.stop(now + 3.4);
        });
      };

      const players = { jet: playJet, wave: playWave, fire: playFire, us: playUs };
      document.querySelectorAll('[data-sound]').forEach((button) => {
        button.addEventListener('click', () => {
          const player = players[button.dataset.sound];
          if (!player) return;
          player(getAudio());
          button.dataset.active = 'true';
          window.setTimeout(() => { button.dataset.active = 'false'; }, 700);
        });
      });
    </script>
  </body>
</html>
