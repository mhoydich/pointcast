---
import BeachSeatCard from '../../components/BeachSeatCard.astro';
import { BEACH_COMMONS_V19 as edition, BEACH_SEATS, POCKET_SEATS, POCKET_SEATS_INTRO, POCKET_SEATS_SHORTLIST, POCKET_SEAT_TESTS, ROOM_LAYOUTS } from '../../lib/beach-commons-v19';
const description = 'Twelve portable seats, three ways to gather. Telescoping stools for pickleball, compact camping chairs, padded moon chairs, and a spare by the sea.';
const socialImage = 'https://pointcast.xyz/images/og/b/0591.png';
const structuredData = { '@context': 'https://schema.org', '@type': 'Article', headline: edition.title, description, datePublished: edition.publishedAt, dateModified: edition.publishedAt, url: edition.url, image: socialImage, author: { '@type': 'Organization', name: 'Codex / OpenAI' }, publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' }, isPartOf: { '@type': 'CreativeWorkSeries', name: 'Beach Commons', url: 'https://pointcast.xyz/beach-commons' } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Extra Chair — Beach Commons V19 · PointCast</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={edition.url} />
    <link rel="alternate" type="application/json" href={edition.jsonUrl} title="The Extra Chair — source data" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="The Extra Chair · Beach Commons V19" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={edition.url} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Extra Chair · Beach Commons V19" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the story</a>
    <header class="masthead"><a class="wordmark" href="/">POINTCAST<span>®</span></a><a href="/beach-commons">Beach Commons <span class="volume">/ 19</span></a><a class="series-link" href="/beach-commons#editions">The series ↗</a></header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <div class="hero-copy">
          <p class="eyebrow">Field study 019 · September 15, 2026</p>
          <h1 id="title">The extra<br/><em>chair.</em></h1>
          <p class="hero-dek">A place between games.<br/>A room for one more.</p>
          <p class="hero-note">Telescoping stools, little camp chairs, a padded moon. Twelve ways to bring a seat—and leave a place.</p>
          <div class="hero-actions"><a class="button" href="#pocket-seats">Explore Pocket Seats <span>↓</span></a><a href="#beach-seats">The beach shortlist ↗</a></div>
          <div class="issue-stats"><span><b>12</b> seats</span><span><b>03</b> ways to gather</span><span><b>01</b> place to leave open</span></div>
        </div>
        <figure class="cover"><img src="/beach-commons/v19/assets/the-extra-chair.webp" width="1122" height="1402" alt="Original coastal illustration: a gathering of chairs by the water, with an empty striped chair in the foreground. The Extra Chair. Bring a seat. Leave a place." fetchpriority="high" /><figcaption>An imagined afternoon · original editorial illustration</figcaption></figure>
      </section>

      <nav class="chapter-nav" aria-label="In this edition"><div class="wrap"><span>In this study</span><a href="#pocket-seats">01 / Pocket Seats</a><a href="#the-invitation">02 / The invitation</a><a href="#beach-seats">03 / By the sea</a><a href="#room-layouts">04 / Make a room</a><a href="#sources">Sources & method</a></div></nav>

      <section id="pocket-seats" class="pocket-section section" aria-labelledby="pocket-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">01 / For the sidelines & the small bag</p><h2 id="pocket-title">Pocket <em>Seats.</em></h2></div><p class="section-dek">Pickleball. Camping. A little project.<br/>Take a seat wherever the day pauses.</p></div>
          <p class="intro">{POCKET_SEATS_INTRO}</p>
          <div class="formats"><div><span>Quick perch</span><p>Backless, for the wait between games.</p></div><div><span>Compact backrest</span><p>A little more support for a longer stay.</p></div><div><span>Car-camp moon</span><p>A padded comparison when the car carries.</p></div></div>
          <div class="filter-row"><div class="filters" role="group" aria-label="Choose a seat style"><button type="button" data-pocket-filter="all" aria-pressed="true">All six</button><button type="button" data-pocket-filter="perch" aria-pressed="false">Quick perch</button><button type="button" data-pocket-filter="backrest" aria-pressed="false">Compact backrest</button><button type="button" data-pocket-filter="lounge" aria-pressed="false">Car-camp moon</button></div><p id="pocket-count" role="status" aria-live="polite">6 seats to consider</p></div>
          <p class="research-note">Source check: September 15, 2026 · USD · Specification research, no hands-on testing. Prices exclude tax, shipping and accessories.</p>
          <div class="seat-grid">{POCKET_SEATS.map((seat, index) => <BeachSeatCard seat={seat} number={index + 1} pocket />)}</div>
          <aside class="shortlist"><p class="eyebrow">First to try for pickleball</p><p>{POCKET_SEATS_SHORTLIST}</p></aside>
        </div>
      </section>

      <section class="field-tests section wrap" aria-labelledby="test-title"><div class="section-heading"><div><p class="eyebrow">A suggested field notebook</p><h2 id="test-title">Does it earn<br/><em>the bag?</em></h2></div><p class="section-dek">The dimensions start the conversation.<br/>Your next outing can finish it.</p></div><ol>{POCKET_SEAT_TESTS.map((item) => <li><h3>{item.title}</h3><p>{item.description}</p></li>)}</ol><p class="research-note">These are proposed tests to try, not tests conducted for this edition.</p></section>

      <section id="the-invitation" class="invitation section" aria-labelledby="invitation-title"><div class="wrap essay"><div class="essay-title"><p class="eyebrow">02 / The invitation</p><h2 id="invitation-title">You brought<br/>a chair.<br/><em>Who gets<br/>to stay?</em></h2><p class="margin-note">“The best seat is the one somebody brought for you.”</p></div><div class="prose">{edition.intro.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>

      <section id="beach-seats" class="section wrap" aria-labelledby="beach-title"><div class="section-heading"><div><p class="eyebrow">03 / Six seating jobs by the sea</p><h2 id="beach-title">A chair for<br/><em>the company.</em></h2></div><p class="section-dek">Choose the people first.<br/>Then the seat, the carry, the afternoon.</p></div><p class="research-note">Same September 15 source check. Carry weights retain the maker’s stated basis; an unspecified product weight is not a measured packed weight.</p><div class="seat-grid">{BEACH_SEATS.map((seat, index) => <BeachSeatCard seat={seat} number={index + 7} />)}</div></section>

      <section id="room-layouts" class="rooms section" aria-labelledby="rooms-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">04 / Three ways to say stay</p><h2 id="rooms-title">Make a <em>room.</em></h2></div><p class="section-dek">No walls. A few chairs.<br/>An easy way to join.</p></div><div class="room-grid">{ROOM_LAYOUTS.map((room) => <article><span class="room-number">{room.number}</span><h3>{room.title}</h3><p class="configuration">{room.configuration}</p><p>{room.description}</p></article>)}</div></div></section>

      <section class="receipt section wrap"><p class="eyebrow">The receipt that matters</p><p>{edition.receipt}</p><span>Bring a seat. Leave a place.</span></section>

      <section id="sources" class="sources-section wrap" aria-labelledby="sources-title"><h2 id="sources-title">Sources & method</h2><div class="method-grid"><div><h3>The research</h3><p>{edition.testingBoundary}</p><p>{edition.priceBoundary}</p><p>Each chair links to the source used. The NEMO packed-weight figure also links to Campman, and the Helinox entry includes its handling guide. Unverified dimensions stay unverified. All capacity figures are manufacturer claims or ratings.</p><p>{edition.linkBoundary}</p></div><div><h3>The place & the picture</h3><p>{edition.fieldBoundary}</p><p>{edition.illustrationBoundary}</p><p>Direction: Michael Hoydich / PointCast. Writing, research and illustration: Codex / OpenAI.</p><p class="data-links"><a href={edition.jsonUrl}>Read the source data ↗</a><a href="/b/0591">Block 0591 ↗</a></p></div></div></section>
    </main>
    <footer class="wrap"><a href="/beach-commons/v18">← V18 / Radius 25</a><a href="/beach-commons">All nineteen editions ↗</a><a href="/beach-commons/v8">The Beach Blanket Review ↗</a><p>PointCast · Beach Commons · Field study 019</p></footer>
    <script is:inline>
      (() => {
        const buttons = document.querySelectorAll('[data-pocket-filter]');
        const cards = document.querySelectorAll('[data-pocket-seat]');
        const count = document.getElementById('pocket-count');
        buttons.forEach((button) => button.addEventListener('click', () => {
          const filter = button.dataset.pocketFilter;
          let shown = 0;
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          cards.forEach((card) => {
            const matches = filter === 'all' || (card.dataset.tags || '').split(' ').includes(filter);
            card.hidden = !matches;
            if (matches) shown += 1;
          });
          if (count) count.textContent = `${shown} ${shown === 1 ? 'seat' : 'seats'} to consider`;
        }));
      })();
    </script>
  </body>
</html>
<style is:global>
  :root{--paper:#f7f4e9;--ink:#193b4a;--muted:#536671;--rust:#a6422f;--teal:#276660;--line:#ccd0c6;--tint:#ecebdc;scroll-behavior:smooth;color-scheme:light}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-underline-offset:4px}button{font:inherit}a:focus-visible,button:focus-visible{outline:3px solid var(--rust);outline-offset:5px}img{max-width:100%;height:auto;display:block}figure{margin:0}h1,h2,h3,p{overflow-wrap:break-word}h1,h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.065em;line-height:.99;margin:0}h2{font-size:clamp(48px,6.4vw,82px)}h1 em,h2 em{font-weight:400}section[id]{scroll-margin-top:24px}.wrap{width:min(1140px,calc(100% - 80px));margin-inline:auto}.section{padding-block:90px}.eyebrow{font-size:10px;line-height:1.6;font-weight:800;letter-spacing:.15em;text-transform:uppercase;margin:0 0 24px}.skip{position:absolute;left:12px;top:-80px;background:var(--paper);padding:16px;z-index:10}.skip:focus{top:10px}.masthead{padding:25px 40px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px}.masthead a{text-decoration:none}.wordmark{font-size:19px;font-weight:900;letter-spacing:-.07em}.wordmark span{font-size:10px;vertical-align:top;margin-left:3px}.volume{color:var(--rust);margin-left:8px}.series-link{font-size:11px}.hero{padding-block:60px 65px;display:grid;grid-template-columns:1.08fr 1fr;gap:64px;align-items:center}.hero h1{font-size:clamp(78px,9.1vw,120px)}.hero h1 em{color:var(--rust)}.hero-dek{font-size:25px;line-height:1.4;margin:32px 0 17px;letter-spacing:-.03em}.hero-note{font-size:15px;line-height:1.7;max-width:340px}.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:28px;font-size:11px;font-weight:700}.button{display:flex;justify-content:space-between;gap:28px;text-decoration:none;background:var(--ink);color:var(--paper);padding:18px 21px;font-size:12px}.issue-stats{display:flex;gap:27px;margin-top:42px;padding-top:20px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.issue-stats b{display:block;font-family:Georgia,serif;font-size:28px;line-height:1.5;color:var(--ink);font-weight:400}.cover img{box-shadow:0 8px 35px #193b4a16}.cover figcaption{font-size:9px;line-height:1.5;margin-top:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.chapter-nav{background:var(--ink);color:var(--paper);padding:22px 0}.chapter-nav .wrap{display:flex;flex-wrap:wrap;align-items:center;gap:22px}.chapter-nav span{font-size:9px;text-transform:uppercase;letter-spacing:.12em;opacity:.65;margin-right:auto}.chapter-nav a{font-size:10px;text-decoration:none}.chapter-nav a:hover{text-decoration:underline}.pocket-section{background:#eff1e7}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:40px}.section-dek{font-size:16px;line-height:1.6;max-width:350px;margin:0 0 5px}.intro{font-size:18px;line-height:1.75;max-width:790px;margin:0 0 34px}.formats{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line);padding:24px 0;gap:30px;margin-bottom:32px}.formats span{font-size:13px;font-weight:800}.formats p{font-size:12px;line-height:1.6;margin:8px 0 0;color:var(--muted)}.filter-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;margin-bottom:18px}.filters{display:flex;gap:8px;flex-wrap:wrap}.filters button{background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:30px;padding:10px 15px;font-size:11px;font-weight:700;cursor:pointer}.filters button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}#pocket-count{font-size:11px;color:var(--muted);margin:0}.research-note{font-size:11px;line-height:1.7;color:var(--muted);max-width:820px;margin:0 0 28px}.seat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:60px;row-gap:45px}.shortlist{margin-top:45px;padding:30px 35px;background:var(--ink);color:var(--paper);display:grid;grid-template-columns:210px 1fr;gap:25px}.shortlist .eyebrow{margin:3px 0 0;color:#c4d4c8}.shortlist>p:last-child{font-family:Georgia,serif;font-size:23px;line-height:1.5;margin:0;letter-spacing:-.02em}.field-tests ol{padding:0;margin:0 0 25px;list-style:none;counter-reset:tests;display:grid;grid-template-columns:repeat(5,1fr);gap:25px}.field-tests li{counter-increment:tests;border-top:1px solid var(--ink);padding-top:18px}.field-tests li:before{content:'0' counter(tests);font-size:11px;color:var(--rust)}.field-tests h3{font-size:14px;line-height:1.3;margin:18px 0 10px}.field-tests li p{font-size:12px;line-height:1.75;margin:0}.invitation{background:#e3e8dc}.essay{display:grid;grid-template-columns:1fr 1.1fr;gap:100px}.margin-note{font-family:Georgia,serif;font-style:italic;font-size:23px;line-height:1.45;color:var(--teal);max-width:260px;margin-top:45px}.prose p{font-family:Georgia,serif;font-size:18px;line-height:1.8;margin:0 0 22px}.prose p:first-child{font-size:25px;line-height:1.5}.rooms{background:var(--ink);color:var(--paper)}.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}.room-grid article{border-top:1px solid #ffffff55;padding-top:30px}.room-number{font-family:Georgia,serif;font-size:50px;color:#b5d2c6}.room-grid h3{font-family:Georgia,serif;font-size:29px;line-height:1.1;font-weight:400;margin:23px 0 15px;letter-spacing:-.04em}.room-grid p{font-size:13px;line-height:1.8}.room-grid .configuration{font-size:12px;font-weight:700;color:#c4d4c8}.receipt{text-align:center;max-width:830px}.receipt>p:not(.eyebrow){font-family:Georgia,serif;font-size:clamp(26px,3.5vw,40px);line-height:1.4;letter-spacing:-.04em}.receipt>span{display:block;text-transform:uppercase;font-size:10px;font-weight:800;letter-spacing:.15em;margin-top:35px;color:var(--rust)}.sources-section{border-top:1px solid var(--line);padding-block:45px 55px}.sources-section h2{font:400 30px Georgia,serif;letter-spacing:-.03em}.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:20px}.method-grid h3{font-size:12px}.method-grid p{font-size:11px;line-height:1.8;color:var(--muted)}.data-links{display:flex;gap:25px;flex-wrap:wrap}footer{border-top:1px solid var(--line);display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;padding-block:30px 110px;font-size:11px}footer p{flex-basis:100%;font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-top:15px}
  @media(min-width:1400px){.hero{padding-block:75px}.hero h1{font-size:126px}}
  @media(max-width:900px){.wrap{width:calc(100% - 48px)}.masthead{padding:23px 24px}.hero{gap:30px}.hero h1{font-size:83px}.hero-dek{font-size:21px}.hero-actions{gap:16px}.issue-stats{gap:19px}.section{padding-block:65px}.seat-grid{column-gap:32px}.section-heading{gap:20px}.section-dek{font-size:14px}.essay{gap:45px}.field-tests ol{grid-template-columns:repeat(3,1fr)}.shortlist{grid-template-columns:1fr}.shortlist .eyebrow{margin:0}.method-grid{gap:35px}.room-grid{gap:24px}}
  @media(max-width:620px){.wrap{width:calc(100% - 36px)}.masthead{padding:21px 18px}.masthead>a:nth-child(2){font-size:11px}.series-link{display:none}.hero{grid-template-columns:1fr;padding-block:42px;gap:35px}.hero h1{font-size:94px}.hero-dek{font-size:24px;margin-top:25px}.hero-note{max-width:100%;font-size:15px}.hero-actions{gap:23px}.issue-stats{gap:35px;margin-top:30px}.cover{max-width:440px;margin-inline:auto}.cover figcaption{font-size:8px}.chapter-nav .wrap{gap:17px 22px}.chapter-nav span{flex-basis:100%;margin-bottom:0}.chapter-nav a{font-size:10px}.section{padding-block:55px}.section-heading{display:block;margin-bottom:28px}.section-dek{margin-top:25px;font-size:16px}.intro{font-size:16px}.formats{grid-template-columns:1fr;gap:20px;padding:24px 0}.formats>div{display:grid;grid-template-columns:140px 1fr;gap:12px;align-items:start}.formats p{margin:0;font-size:12px}.formats span{font-size:12px}.filters{gap:7px}.filters button{font-size:10px;padding:10px 12px}.seat-grid{grid-template-columns:1fr;row-gap:30px}.shortlist{padding:25px;gap:13px;margin-top:25px}.shortlist>p:last-child{font-size:22px}.field-tests ol{grid-template-columns:1fr 1fr;gap:27px}.field-tests li:last-child{grid-column:1 / -1}.essay{grid-template-columns:1fr;gap:25px}.essay-title h2{font-size:61px}.essay-title h2 br:nth-of-type(3){display:none}.margin-note{margin:28px 0 0;max-width:300px}.prose p{font-size:17px}.prose p:first-child{font-size:23px}.room-grid{grid-template-columns:1fr;gap:30px}.room-grid article{padding-top:20px}.room-grid h3{font-size:31px;margin-top:15px}.room-grid p{font-size:14px}.method-grid{grid-template-columns:1fr;gap:15px}.method-grid p{font-size:12px}.sources-section{padding-block:35px}footer{font-size:10px;gap:20px}footer>a{flex-basis:100%}}
  @media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}}
</style>
