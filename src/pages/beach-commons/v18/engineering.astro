---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import {
  ENGINEERING_CAPABILITIES,
  ENGINEERING_CATALOG,
  ENGINEERING_LAYERS,
  ENGINEERING_MISSIONS,
  ENGINEERING_PROOF_PACKET,
  REGIONAL_ENGINEERING_DOORS,
  TERMINAL_COMMANDS,
} from '../../../lib/radius25-engineering';

const canonical = ENGINEERING_CATALOG.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0551.png';
const capabilityData = ENGINEERING_CAPABILITIES.map((capability) => ({
  id: capability.id,
  code: capability.code,
  layer: capability.layer,
  title: capability.title,
  summary: capability.summary,
  outputs: capability.outputs,
  proof: capability.proof,
  flags: capability.flags,
}));
const missionData = ENGINEERING_MISSIONS.map((mission) => ({
  ...mission,
  capabilities: mission.capabilities.map((id) => {
    const capability = ENGINEERING_CAPABILITIES.find((item) => item.id === id)!;
    return { id: capability.id, code: capability.code, title: capability.title };
  }),
}));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  name: 'ENG/25 — The Engineering Catalog',
  description: ENGINEERING_CATALOG.dek,
  url: canonical,
  image: socialImage,
  datePublished: ENGINEERING_CATALOG.publishedAt,
  dateModified: ENGINEERING_CATALOG.updatedAt,
  spatialCoverage: { '@type': 'Place', name: 'An approximate 25-mile editorial field centered on El Segundo, California' },
  creator: [
    { '@type': 'Person', name: 'Michael Hoydich' },
    { '@type': 'Organization', name: 'Codex / OpenAI' },
  ],
  isPartOf: { '@type': 'CreativeWorkSeries', name: 'Beach Commons · Radius 25', url: 'https://pointcast.xyz/beach-commons/v18' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="description" content="ENG/25 is a terminal-style catalog of eighteen engineering capabilities, six mission stacks, and official learning and qualification doors in the El Segundo-centered Radius 25." />
  <meta name="theme-color" content="#07100d" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/json" href="/beach-commons/v18/engineering.json" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PointCast" />
  <meta property="og:title" content="ENG/25 — The Engineering Catalog" />
  <meta property="og:description" content={ENGINEERING_CATALOG.dek} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="ENG/25 — The Engineering Catalog" />
  <meta name="twitter:description" content="Find a capability. Compile a stack. Publish the proof." />
  <meta name="twitter:image" content={socialImage} />
  <title>ENG/25 — The Engineering Catalog · PointCast</title>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <style>
    :root{--bg:#07100d;--panel:#0c1713;--panel2:#111f19;--ink:#e9f7eb;--muted:#8ba596;--green:#b8ff58;--cyan:#69e6df;--amber:#ffc857;--red:#ff7b6b;--line:#294438;--sans:"Inter Variable",Inter,Arial,sans-serif;--mono:"JetBrains Mono Variable","SFMono-Regular",Consolas,monospace;color-scheme:dark}*{box-sizing:border-box}html{min-width:320px;scroll-behavior:smooth;background:var(--bg)}body{min-width:320px;margin:0;overflow-x:hidden;background:radial-gradient(circle at 80% -10%,rgba(105,230,223,.12),transparent 35rem),var(--bg);color:var(--ink);font-family:var(--sans)}a{color:inherit}button,input{font:inherit}button{color:inherit}.skip{position:absolute;z-index:20;left:12px;top:-80px;padding:10px 14px;background:var(--green);color:#07100d}.skip:focus{top:12px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:13px clamp(18px,4vw,62px);border-bottom:1px solid var(--line);background:rgba(7,16,13,.94);font:650 11px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase}.topbar a{text-decoration:none}.topbar__brand{color:var(--green)}.topbar nav{display:flex;gap:18px;color:var(--muted)}.shell{width:min(1540px,100%);margin:0 auto}.hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);min-height:620px;border-inline:1px solid var(--line)}.hero__main{display:flex;flex-direction:column;justify-content:space-between;padding:clamp(28px,5vw,78px);border-right:1px solid var(--line)}.promptline{font:600 clamp(12px,1.4vw,16px)/1.5 var(--mono);color:var(--muted)}.promptline b{color:var(--cyan)}.cursor{display:inline-block;width:.65em;height:1.15em;margin-left:.2em;vertical-align:-.15em;background:var(--green);animation:blink 1.15s steps(1) infinite}.hero h1{margin:44px 0 22px;font:800 clamp(72px,13vw,188px)/.73 var(--mono);letter-spacing:-.095em;color:var(--green)}.hero h1 span{display:block;margin-top:24px;font:700 clamp(17px,2.1vw,30px)/1.1 var(--mono);letter-spacing:-.03em;color:var(--ink)}.hero__dek{max-width:850px;margin:0;font:550 clamp(20px,2.35vw,38px)/1.15 var(--sans);letter-spacing:-.035em}.hero__dek em{color:var(--cyan);font-style:normal}.boot{display:grid;align-content:start;background:linear-gradient(180deg,rgba(184,255,88,.045),transparent 45%);font:500 12px/1.5 var(--mono)}.boot__head{padding:15px 18px;border-bottom:1px solid var(--line);color:var(--muted)}.boot ul{list-style:none;margin:0;padding:24px}.boot li{display:grid;grid-template-columns:72px 1fr;gap:10px;padding:10px 0;border-bottom:1px dotted var(--line)}.boot b{color:var(--green)}.boot code{color:var(--cyan)}.boot__status{margin:24px;padding:18px;border:1px solid var(--green);color:var(--green)}.command-dock{position:sticky;z-index:10;top:0;border-block:1px solid var(--line);background:rgba(7,16,13,.96);backdrop-filter:blur(16px)}.command-form{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:15px clamp(18px,4vw,62px)}.command-form label{font:700 14px var(--mono);color:var(--green)}.command-form input{min-width:0;width:100%;border:0;border-bottom:1px solid var(--line);outline:0;padding:10px 4px;background:transparent;color:var(--ink);font:600 16px var(--mono);caret-color:var(--green)}.command-form input:focus{border-color:var(--green)}.command-form button,.mini-command,.layer-button,.mission-button,.copy-button{border:1px solid var(--line);background:var(--panel);padding:9px 12px;font:650 11px var(--mono);letter-spacing:.04em;text-transform:uppercase;cursor:pointer}.command-form button:hover,.command-form button:focus-visible,.mini-command:hover,.mini-command:focus-visible,.layer-button:hover,.layer-button:focus-visible,.mission-button:hover,.mission-button:focus-visible,.copy-button:hover,.copy-button:focus-visible{border-color:var(--green);color:var(--green)}.terminal-output{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:start;padding:12px clamp(18px,4vw,62px);border-top:1px solid rgba(41,68,56,.6);font:500 11px/1.5 var(--mono);color:var(--muted)}.terminal-output b{color:var(--cyan)}.terminal-output pre{min-width:0;margin:0;white-space:pre-wrap;color:var(--ink)}.terminal-output span{color:var(--green)}.overview{display:grid;grid-template-columns:repeat(4,1fr);border-inline:1px solid var(--line);border-bottom:1px solid var(--line)}.stat{padding:22px clamp(16px,2.5vw,34px);border-right:1px solid var(--line);font:600 11px var(--mono);color:var(--muted);text-transform:uppercase}.stat:last-child{border:0}.stat b{display:block;margin-bottom:5px;font:780 clamp(34px,4vw,62px)/1 var(--mono);color:var(--ink);letter-spacing:-.08em}.section{border-inline:1px solid var(--line);border-bottom:1px solid var(--line);padding:clamp(46px,7vw,100px) clamp(18px,4vw,62px)}.section-head{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:40px;margin-bottom:42px}.eyebrow{margin:0 0 14px;font:700 11px var(--mono);letter-spacing:.1em;color:var(--green);text-transform:uppercase}.section h2{max-width:900px;margin:0;font:780 clamp(40px,6vw,92px)/.92 var(--mono);letter-spacing:-.065em}.section h2 em{color:var(--cyan);font-style:normal}.section-head>p{align-self:end;max-width:640px;margin:0;color:var(--muted);font:500 17px/1.5 var(--sans)}.command-reference{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}.command-reference button{display:grid;grid-template-columns:minmax(120px,.7fr) 1.3fr;gap:16px;min-height:86px;padding:18px;border:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-align:left;background:var(--panel);cursor:pointer}.command-reference button:nth-child(3n){border-right:0}.command-reference code{font:700 13px var(--mono);color:var(--green)}.command-reference span{font:500 13px/1.35 var(--sans);color:var(--muted)}.filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}.layer-button[aria-pressed="true"]{border-color:var(--green);background:var(--green);color:#07100d}.result-line{display:flex;justify-content:space-between;gap:20px;margin:0 0 14px;font:600 11px var(--mono);color:var(--muted);text-transform:uppercase}.result-line b{color:var(--green)}.capability-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-left:1px solid var(--line);border-top:1px solid var(--line)}.capability{min-width:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel)}.capability[hidden]{display:none}.capability summary{list-style:none;min-height:280px;padding:22px;cursor:pointer}.capability summary::-webkit-details-marker{display:none}.capability__top{display:flex;justify-content:space-between;gap:12px;font:650 10px var(--mono);letter-spacing:.07em;color:var(--muted)}.capability__top b{color:var(--cyan)}.capability h3{margin:50px 0 18px;font:750 clamp(23px,2.2vw,34px)/1 var(--mono);letter-spacing:-.055em}.capability summary p{margin:0;color:var(--muted);font:500 14px/1.5 var(--sans)}.capability__open{display:block;margin-top:28px;font:650 10px var(--mono);color:var(--green);text-transform:uppercase}.capability[open]{grid-column:span 2;background:var(--panel2)}.capability[open] summary{min-height:0;border-bottom:1px solid var(--line)}.capability__detail{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;padding:24px}.man-section h4{margin:0 0 10px;font:700 10px var(--mono);color:var(--amber);letter-spacing:.08em;text-transform:uppercase}.man-section ul{margin:0;padding-left:18px;color:var(--muted);font:500 13px/1.5 var(--sans)}.man-section--wide{grid-column:1/-1;padding:13px 14px;border-left:3px solid var(--red);background:rgba(255,123,107,.06)}.man-section--wide p{margin:0;color:#f6b2aa;font:600 12px/1.5 var(--mono)}.mission-shell{display:grid;grid-template-columns:minmax(240px,.34fr) minmax(0,.66fr);border:1px solid var(--line);background:var(--panel)}.mission-list{border-right:1px solid var(--line)}.mission-button{display:block;width:100%;padding:16px 18px;border:0;border-bottom:1px solid var(--line);text-align:left;background:transparent;color:var(--muted)}.mission-button[aria-pressed="true"]{background:var(--green);color:#07100d}.stack{padding:clamp(22px,4vw,50px)}.stack__command{margin:0 0 28px;font:650 12px var(--mono);color:var(--green)}.stack h3{margin:0 0 14px;font:780 clamp(30px,4.4vw,66px)/.95 var(--mono);letter-spacing:-.06em}.stack__question{max-width:920px;margin:0 0 32px;color:var(--muted);font:550 18px/1.45 var(--sans)}.stack__grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.stack__panel{padding:18px;border:1px solid var(--line)}.stack__panel h4{margin:0 0 14px;font:700 10px var(--mono);color:var(--amber);text-transform:uppercase}.stack__panel ol,.stack__panel ul{margin:0;padding-left:20px;color:var(--muted);font:500 13px/1.55 var(--sans)}.stack__stop{grid-column:1/-1;padding:15px 16px;border-left:3px solid var(--red);background:rgba(255,123,107,.06);font:600 12px/1.55 var(--mono);color:#f6b2aa}.stack__actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.gateway-table{border:1px solid var(--line);font:500 12px/1.45 var(--mono)}.gateway-head,.gateway{display:grid;grid-template-columns:92px minmax(180px,.75fr) minmax(220px,1.35fr) 120px;gap:18px;padding:14px 16px;border-bottom:1px solid var(--line);align-items:start}.gateway-head{position:sticky;top:99px;z-index:2;background:var(--green);color:#07100d;font-weight:750;text-transform:uppercase}.gateway:last-child{border-bottom:0}.gateway__band{color:var(--cyan)}.gateway strong{display:block;margin-bottom:5px;color:var(--ink)}.gateway small{color:var(--muted)}.gateway__use{color:var(--muted)}.gateway__use span{display:block;margin-top:7px;color:#d2ad67}.gateway a{font-weight:700;color:var(--green);text-underline-offset:4px}.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line)}.proof{min-height:210px;padding:20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel)}.proof b{font:750 12px var(--mono);color:var(--green)}.proof h3{margin:42px 0 12px;font:750 19px var(--mono)}.proof p{margin:0;color:var(--muted);font:500 13px/1.5 var(--sans)}.boundary{display:grid;grid-template-columns:minmax(0,.85fr) minmax(320px,1.15fr);gap:40px;padding:clamp(38px,6vw,82px) clamp(18px,4vw,62px);border-inline:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--green);color:#07100d}.boundary h2{margin:0;font:800 clamp(40px,6vw,86px)/.9 var(--mono);letter-spacing:-.075em}.boundary p{margin:0 0 16px;font:650 18px/1.4 var(--sans)}.boundary small{font:600 11px/1.6 var(--mono)}.footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px;padding:28px clamp(18px,4vw,62px) 50px;border-inline:1px solid var(--line);font:600 11px var(--mono);color:var(--muted)}.footer nav{display:flex;flex-wrap:wrap;gap:18px}.footer a:hover{color:var(--green)}@keyframes blink{50%{opacity:0}}@media(max-width:980px){.hero{grid-template-columns:1fr}.hero__main{border-right:0;border-bottom:1px solid var(--line)}.command-reference,.capability-grid{grid-template-columns:repeat(2,1fr)}.command-reference button:nth-child(3n){border-right:1px solid var(--line)}.command-reference button:nth-child(2n){border-right:0}.overview{grid-template-columns:repeat(2,1fr)}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}.section-head{grid-template-columns:1fr}.section-head>p{align-self:auto}.mission-shell{grid-template-columns:1fr}.mission-list{border-right:0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(2,1fr)}.gateway-head,.gateway{grid-template-columns:76px 1fr 120px}.gateway__use{grid-column:2/-1}.proof-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.topbar nav a:first-child{display:none}.hero{min-height:0}.hero__main{padding:34px 18px 42px}.hero h1{margin-top:60px}.command-form{grid-template-columns:auto minmax(0,1fr)}.command-form button{display:none}.terminal-output{grid-template-columns:auto 1fr}.terminal-output span{display:none}.command-reference,.capability-grid{grid-template-columns:1fr}.command-reference button,.command-reference button:nth-child(3n){border-right:0}.capability[open]{grid-column:span 1}.capability__detail,.stack__grid{grid-template-columns:1fr}.overview{grid-template-columns:1fr}.stat,.stat:nth-child(2){border-right:0;border-bottom:1px solid var(--line)}.stat:last-child{border-bottom:0}.mission-list{grid-template-columns:1fr}.gateway-head{display:none}.gateway{grid-template-columns:70px 1fr}.gateway>a{grid-column:2}.gateway__use{grid-column:1/-1}.proof-grid{grid-template-columns:1fr}.boundary{grid-template-columns:1fr}.footer{display:block}.footer nav{margin-top:20px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.cursor{animation:none}}
  </style>
</head>
<body data-eng25 data-capabilities={JSON.stringify(capabilityData)} data-missions={JSON.stringify(missionData)}>
  <a class="skip" href="#catalog">Skip to engineering catalog</a>
  <header class="topbar"><a class="topbar__brand" href="/">PointCast :: ENG/25</a><span>Radius 25 · Field Companion 018.B</span><nav><a href="/beach-commons/v18/skills">Skill Line</a><a href="/beach-commons/v18">Radius 25</a></nav></header>
  <main class="shell">
    <section class="hero">
      <div class="hero__main">
        <p class="promptline"><b>eng25@el-segundo</b>:~$ catalog --radius=25mi --mode=proof<span class="cursor" aria-hidden="true"></span></p>
        <div><h1>ENG/25<span>The Engineering Catalog</span></h1><p class="hero__dek">Find a capability. Compile a stack. <em>Publish the proof.</em></p></div>
      </div>
      <aside class="boot" aria-label="Catalog status">
        <div class="boot__head">BOOT :: 2026.08.01 / BUILD 018.B</div>
        <ul>
          <li><b>[ OK ]</b><span><code>18</code> capability man pages mounted</span></li>
          <li><b>[ OK ]</b><span><code>06</code> Radius 25 mission stacks compiled</span></li>
          <li><b>[ OK ]</b><span><code>17</code> official doors linked</span></li>
          <li><b>[ OK ]</b><span><code>08</code> proof-packet fields required</span></li>
          <li><b>[LOCAL]</b><span>search, stack, and export stay in this page</span></li>
          <li><b>[SAFE]</b><span>qualification and authority gates remain visible</span></li>
        </ul>
        <p class="boot__status">CAPABILITY INDEX ONLINE<br />NO PRIVATE PEOPLE LOADED</p>
      </aside>
    </section>

    <section class="command-dock" aria-label="Engineering command line">
      <form class="command-form" data-command-form>
        <label for="eng25-command">$</label>
        <input id="eng25-command" data-command-input autocomplete="off" spellcheck="false" placeholder='try: find "salt air" · stack shade-return · help' aria-describedby="command-help" />
        <button type="submit">run ↵</button>
      </form>
      <div class="terminal-output" id="command-help"><b data-terminal-prompt>eng25:</b><pre data-terminal-output aria-live="polite">ready — type help or press / to focus</pre><span data-terminal-count>18 mounted</span></div>
    </section>

    <section class="overview" aria-label="Catalog facts">
      <div class="stat"><b>18</b> engineering capabilities</div><div class="stat"><b>06</b> mission stacks</div><div class="stat"><b>17</b> official doors</div><div class="stat"><b>00</b> people scraped</div>
    </section>

    <section class="section" id="commands">
      <div class="section-head"><div><p class="eyebrow">00 :: command reference</p><h2>A shell for <em>useful questions.</em></h2></div><p>This is a command-line metaphor, not an operating-system shell. It executes no arbitrary code. Commands only filter the checked-in catalog, choose a mission, scroll to a section, or copy a local work order.</p></div>
      <div class="command-reference">
        {TERMINAL_COMMANDS.map((item) => <button type="button" data-run-command={item.command}><code>$ {item.command}</code><span>{item.detail}</span></button>)}
      </div>
    </section>

    <section class="section" id="catalog">
      <div class="section-head"><div><p class="eyebrow">01 :: /usr/share/man/eng25</p><h2>Eighteen ways to make something <em>work.</em></h2></div><p>These are capability descriptions, not job titles or claims about named people. Open a man page to see inputs, outputs, proof, interfaces, common tools, and the qualification flag that should travel with the work.</p></div>
      <div class="filters" aria-label="Filter engineering layers">
        <button class="layer-button" type="button" data-layer="all" aria-pressed="true">all :: 18</button>
        {ENGINEERING_LAYERS.map((layer) => <button class="layer-button" type="button" data-layer={layer.id} aria-pressed="false">{layer.code} :: {layer.title}</button>)}
      </div>
      <p class="result-line"><span data-filter-description>showing all capability man pages</span><b data-result-count>18 / 18</b></p>
      <div class="capability-grid">
        {ENGINEERING_CAPABILITIES.map((capability, index) => {
          const layer = ENGINEERING_LAYERS.find((item) => item.id === capability.layer)!;
          const search = JSON.stringify(capability).toLowerCase();
          return <details class="capability" data-capability-card data-id={capability.id} data-layer={capability.layer} data-search={search}>
            <summary><span class="capability__top"><b>{capability.code}</b><span>{layer.code} / {String(index + 1).padStart(2, '0')}</span></span><h3>{capability.title}</h3><p>{capability.summary}</p><span class="capability__open">open man page +</span></summary>
            <div class="capability__detail">
              <div class="man-section"><h4>Useful when</h4><ul>{capability.usefulWhen.map((item) => <li>{item}</li>)}</ul></div>
              <div class="man-section"><h4>Inputs</h4><ul>{capability.inputs.map((item) => <li>{item}</li>)}</ul></div>
              <div class="man-section"><h4>Outputs</h4><ul>{capability.outputs.map((item) => <li>{item}</li>)}</ul></div>
              <div class="man-section"><h4>Proof</h4><ul>{capability.proof.map((item) => <li>{item}</li>)}</ul></div>
              <div class="man-section"><h4>Common tools</h4><ul>{capability.tools.map((item) => <li>{item}</li>)}</ul></div>
              <div class="man-section"><h4>Interfaces</h4><ul>{capability.interfaces.map((item) => <li>{item}</li>)}</ul></div>
              <div class="man-section man-section--wide"><h4>Qualification / authority flag</h4><p>{capability.flags.join(' ')}</p></div>
            </div>
          </details>;
        })}
      </div>
    </section>

    <section class="section" id="stack">
      <div class="section-head"><div><p class="eyebrow">02 :: stack compiler</p><h2>A mission is an <em>interface problem.</em></h2></div><p>Choose one Radius 25 brief. ENG/25 compiles the minimum capability stack, concrete deliverables, and the stop condition that prevents a speculative prompt from pretending to be authorized field work.</p></div>
      <div class="mission-shell">
        <div class="mission-list">{ENGINEERING_MISSIONS.map((mission, index) => <button class="mission-button" type="button" data-select-mission={mission.id} aria-pressed={index === 0 ? 'true' : 'false'}>{mission.command}</button>)}</div>
        <article class="stack" data-stack-panel>
          <p class="stack__command" data-stack-command>$ {ENGINEERING_MISSIONS[0].command}</p><h3 data-stack-title>{ENGINEERING_MISSIONS[0].title}</h3><p class="stack__question" data-stack-question>{ENGINEERING_MISSIONS[0].question}</p>
          <div class="stack__grid"><div class="stack__panel"><h4>Capability stack</h4><ol data-stack-capabilities>{ENGINEERING_MISSIONS[0].capabilities.map((id) => { const capability=ENGINEERING_CAPABILITIES.find((item)=>item.id===id)!; return <li>{capability.code} · {capability.title}</li>; })}</ol></div><div class="stack__panel"><h4>Required deliverables</h4><ul data-stack-deliverables>{ENGINEERING_MISSIONS[0].deliverables.map((item)=><li>{item}</li>)}</ul></div><div class="stack__stop"><b>STOP CONDITION :: </b><span data-stack-stop>{ENGINEERING_MISSIONS[0].stop}</span></div></div>
          <div class="stack__actions"><button class="copy-button" type="button" data-copy-work-order>copy work order</button><button class="copy-button" type="button" data-open-stack-skills>show these man pages</button><a class="copy-button" href="/beach-commons/v18/skills">declare one skill ↗</a></div><p class="result-line"><span data-copy-status aria-live="polite">Nothing has been sent or saved.</span><b>browser-local</b></p>
        </article>
      </div>
    </section>

    <section class="section" id="gateways">
      <div class="section-head"><div><p class="eyebrow">03 :: /etc/eng25/doors</p><h2>Public doors into the <em>regional stack.</em></h2></div><p>Official sources only: programs, workforce routes, current role taxonomies, public specifications, and qualification gates. “Door” means a useful public information route—not an invitation, endorsement, available lab, partnership, or promise of access.</p></div>
      <div class="gateway-table"><div class="gateway-head"><span>band</span><span>door</span><span>what the source can establish</span><span>official</span></div>{REGIONAL_ENGINEERING_DOORS.map((door)=><article class="gateway"><span class="gateway__band">[{door.band}]</span><div><strong>{door.name}</strong><small>{door.place} · {door.kind}</small></div><div class="gateway__use">{door.use}<span>ACCESS :: {door.access}</span></div><a href={door.url} target="_blank" rel="noreferrer">open ↗</a></article>)}</div>
    </section>

    <section class="section" id="proof">
      <div class="section-head"><div><p class="eyebrow">04 :: proof.tar</p><h2>Eight files travel with <em>the thing.</em></h2></div><p>The catalog becomes useful when every object, service, experiment, and handoff carries enough evidence to review, repair, repeat, or stop it. Popularity and engineering proof remain separate scores.</p></div>
      <div class="proof-grid">{ENGINEERING_PROOF_PACKET.map((item)=><article class="proof"><b>{item.code}</b><h3>{item.title}</h3><p>{item.detail}</p></article>)}</div>
    </section>

    <aside class="boundary"><div><p class="eyebrow">Reality boundary</p><h2>Catalog ≠ crew.</h2></div><div><p>No person, company, campus, agency, facility, site, job, contract, permit, credential, or piece of equipment is represented as available.</p><small>{ENGINEERING_CATALOG.status} The radius is a rough straight-line editorial field, not a legal, service, labor-market, commute, procurement, or geofenced boundary. Official sources were checked August 1, 2026; programs, rules, roles, access, and URLs can change. Physical work begins only after the responsible owner, operator, site steward, qualified professionals, labor, insurance, permit, access, security, environmental, and safety requirements are known.</small></div></aside>
    <footer class="footer"><span>ENG/25 :: PointCast Field Companion 018.B :: Block 0551</span><nav><a href="/beach-commons/v18/engineering.json">JSON</a><a href="/b/0551">Block</a><a href="/beach-commons/v18/skills">Skill Line</a><a href="/beach-commons/v18">Radius 25</a><a href="/beach-commons">Beach Commons</a></nav></footer>
  </main>
  <script>
    const root=document.querySelector('[data-eng25]');
    if(root){
      const capabilities=JSON.parse(root.dataset.capabilities||'[]');
      const missions=JSON.parse(root.dataset.missions||'[]');
      const cards=[...document.querySelectorAll('[data-capability-card]')];
      const input=document.querySelector('[data-command-input]');
      const output=document.querySelector('[data-terminal-output]');
      const prompt=document.querySelector('[data-terminal-prompt]');
      const terminalCount=document.querySelector('[data-terminal-count]');
      const resultCount=document.querySelector('[data-result-count]');
      const filterDescription=document.querySelector('[data-filter-description]');
      const layerButtons=[...document.querySelectorAll('[data-layer]')];
      const missionButtons=[...document.querySelectorAll('[data-select-mission]')];
      let layer='all',query='',selectedMission=missions[0],history=[],historyIndex=0;
      const put=(selector,value)=>{const element=document.querySelector(selector);if(element)element.textContent=value};
      const scroll=(selector)=>document.querySelector(selector)?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});
      const terminal=(message,label='eng25:')=>{if(prompt)prompt.textContent=label;if(output)output.textContent=message};
      const list=(element,items)=>{if(!element)return;element.replaceChildren(...items.map((text)=>{const li=document.createElement('li');li.textContent=text;return li}))};
      const applyFilter=()=>{
        const tokens=query.toLowerCase().split(/\s+/).filter(Boolean);
        let visible=0;
        cards.forEach((card)=>{const matchesLayer=layer==='all'||card.dataset.layer===layer;const haystack=card.dataset.search||'';const matchesQuery=tokens.every((token)=>haystack.includes(token));card.hidden=!(matchesLayer&&matchesQuery);if(!card.hidden)visible+=1});
        if(resultCount)resultCount.textContent=`${visible} / ${cards.length}`;
        if(terminalCount)terminalCount.textContent=`${visible} mounted`;
        if(filterDescription)filterDescription.textContent=query?`find “${query}”${layer==='all'?'':` in ${layer}`}`:layer==='all'?'showing all capability man pages':`layer ${layer}`;
        layerButtons.forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.layer===layer)));
        return visible;
      };
      const selectMission=(id)=>{
        selectedMission=missions.find((mission)=>mission.id===id)||missions[0];
        missionButtons.forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.selectMission===selectedMission.id)));
        put('[data-stack-command]',`$ ${selectedMission.command}`);put('[data-stack-title]',selectedMission.title);put('[data-stack-question]',selectedMission.question);put('[data-stack-stop]',selectedMission.stop);
        list(document.querySelector('[data-stack-capabilities]'),selectedMission.capabilities.map((item)=>`${item.code} · ${item.title}`));
        list(document.querySelector('[data-stack-deliverables]'),selectedMission.deliverables);
        put('[data-copy-status]','Nothing has been sent or saved.');
      };
      const workOrder=()=>[
        'ENG/25 :: WORK ORDER',
        selectedMission.title,
        selectedMission.question,
        '',
        'CAPABILITY STACK',
        ...selectedMission.capabilities.map((item,index)=>`${String(index+1).padStart(2,'0')} ${item.code} · ${item.title}`),
        '',
        'REQUIRED DELIVERABLES',
        ...selectedMission.deliverables.map((item,index)=>`${String(index+1).padStart(2,'0')} ${item}`),
        '',
        `STOP CONDITION :: ${selectedMission.stop}`,
        '',
        'CATALOG :: https://pointcast.xyz/beach-commons/v18/engineering',
        'STATUS :: planning artifact only; no crew, site, funding, permit, or work is promised',
      ].join('\n');
      const copyWorkOrder=async()=>{try{await navigator.clipboard.writeText(workOrder());put('[data-copy-status]','Work order copied. PointCast received nothing.');terminal(`copied ${selectedMission.capabilities.length} capabilities + ${selectedMission.deliverables.length} deliverables`,'export:')}catch{put('[data-copy-status]','Clipboard unavailable. Select and copy from the page.');terminal('clipboard unavailable — no data was sent','export:')}};
      const showStackSkills=()=>{const ids=new Set(selectedMission.capabilities.map((item)=>item.id));layer='all';query='';cards.forEach((card)=>{card.hidden=!ids.has(card.dataset.id)});const visible=ids.size;if(resultCount)resultCount.textContent=`${visible} / ${cards.length}`;if(terminalCount)terminalCount.textContent=`${visible} mounted`;if(filterDescription)filterDescription.textContent=`stack ${selectedMission.id}`;layerButtons.forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.layer==='all')));terminal(`${visible} capability man pages mounted for ${selectedMission.title}`,'stack:');scroll('#catalog')};
      const help=()=>terminal('help · ls skills · ls gateways · find <terms> · layer <name> · stack <mission> · proof · export · clear\nshortcut: / focuses the command line; ↑ and ↓ recall commands');
      const run=(raw)=>{
        const command=raw.trim();if(!command)return;
        history=[...history.filter((item)=>item!==command),command].slice(-20);historyIndex=history.length;
        const normalized=command.toLowerCase().replace(/^\$\s*/,'');
        if(normalized==='help'){help();return}
        if(normalized==='ls skills'||normalized==='ls'){layer='all';query='';const visible=applyFilter();terminal(`${visible} capability man pages mounted`,'ls:');scroll('#catalog');return}
        if(normalized==='ls gateways'){terminal(`${document.querySelectorAll('.gateway').length} official doors — capability signals, learning routes, open specifications, and rule gates`,'ls:');scroll('#gateways');return}
        if(normalized==='proof'){terminal('proof packet 00–07 mounted: mission, requirements, interfaces, assumptions, build, test, qualified gates, keep + close','proof:');scroll('#proof');return}
        if(normalized==='export'){copyWorkOrder();return}
        if(normalized==='clear'){layer='all';query='';applyFilter();if(input)input.value='';terminal('filters cleared — catalog state was never stored','clear:');return}
        if(normalized.startsWith('stack ')){const id=normalized.slice(6).trim();const mission=missions.find((item)=>item.id===id);if(!mission){terminal(`unknown mission “${id}”\navailable: ${missions.map((item)=>item.id).join(' · ')}`,'error:');return}selectMission(id);terminal(`${mission.capabilities.length} capabilities compiled for ${mission.title}`,'stack:');scroll('#stack');return}
        if(normalized.startsWith('layer ')){const next=normalized.slice(6).trim();const valid=['architecture','matter','signal','field','proof','operations','all'];if(!valid.includes(next)){terminal(`unknown layer “${next}”\navailable: ${valid.join(' · ')}`,'error:');return}layer=next;query='';const visible=applyFilter();terminal(`${visible} capability man pages in layer ${next}`,'layer:');scroll('#catalog');return}
        query=normalized.startsWith('find ')?normalized.slice(5).replace(/^['"]|['"]$/g,'').trim():normalized;
        const visible=applyFilter();terminal(visible?`${visible} match${visible===1?'':'es'} for “${query}”`:`no match for “${query}” — try a material, failure, tool, output, or mission word`,'find:');scroll('#catalog');
      };
      document.querySelector('[data-command-form]')?.addEventListener('submit',(event)=>{event.preventDefault();run(input?.value||'')});
      document.querySelectorAll('[data-run-command]').forEach((button)=>button.addEventListener('click',()=>{if(input)input.value=button.dataset.runCommand||'';run(button.dataset.runCommand||'')}));
      layerButtons.forEach((button)=>button.addEventListener('click',()=>{layer=button.dataset.layer||'all';query='';applyFilter();terminal(`${resultCount?.textContent||''} in layer ${layer}`,'layer:')}));
      missionButtons.forEach((button)=>button.addEventListener('click',()=>selectMission(button.dataset.selectMission||missions[0].id)));
      document.querySelector('[data-copy-work-order]')?.addEventListener('click',copyWorkOrder);
      document.querySelector('[data-open-stack-skills]')?.addEventListener('click',showStackSkills);
      input?.addEventListener('keydown',(event)=>{if(event.key==='ArrowUp'&&history.length){event.preventDefault();historyIndex=Math.max(0,historyIndex-1);input.value=history[historyIndex]||''}if(event.key==='ArrowDown'&&history.length){event.preventDefault();historyIndex=Math.min(history.length,historyIndex+1);input.value=history[historyIndex]||''}});
      document.addEventListener('keydown',(event)=>{if(event.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)){event.preventDefault();input?.focus()}if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==='k'){event.preventDefault();input?.focus()}});
      selectMission(missions[0].id);applyFilter();
    }
  </script>
</body>
</html>
