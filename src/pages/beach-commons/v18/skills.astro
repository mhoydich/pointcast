---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { BOARD_RULES, COMMUNICATION_MODES, OPEN_BRIEFS, SIGNAL_TEMPLATE, SKILL_LANES, SKILL_LINE } from '../../../lib/beach-commons-skill-line';
const canonical = SKILL_LINE.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0549.png';
const heroImage = '/beach-commons/v18/assets/poster-07.png';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: 'The Skill Line',
  description: SKILL_LINE.dek, url: canonical, image: socialImage,
  datePublished: SKILL_LINE.publishedAt, dateModified: SKILL_LINE.updatedAt,
  creator: [{ '@type': 'Person', name: 'Michael Hoydich' }, { '@type': 'Organization', name: 'Codex / OpenAI' }],
  isPartOf: { '@type': 'CreativeWork', name: 'Radius 25 — Beach Commons Field Study 018', url: 'https://pointcast.xyz/beach-commons/v18' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="description" content={SKILL_LINE.dek} /><meta name="theme-color" content="#f0b52e" />
  <link rel="canonical" href={canonical} /><link rel="alternate" type="application/json" href="/beach-commons/v18/skills.json" /><link rel="preload" as="image" href={heroImage} fetchpriority="high" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="article" /><meta property="og:site_name" content="PointCast" /><meta property="og:title" content="The Skill Line — Radius 25" /><meta property="og:description" content={SKILL_LINE.subtitle} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content="The Skill Line — Radius 25" /><meta name="twitter:description" content={SKILL_LINE.subtitle} /><meta name="twitter:image" content={socialImage} />
  <title>The Skill Line — Radius 25 · PointCast</title><script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <style>
    :root{--ink:#102d42;--deep:#061a29;--paper:#f4eedf;--paper2:#e5dcc7;--yellow:#f0b52e;--orange:#df6242;--blue:#247f9f;--green:#4d936c;--white:#fffdf5;--line:#102d4230;--gutter:clamp(18px,4vw,64px);--sans:"Inter Variable",Inter,Arial,sans-serif;--mono:"JetBrains Mono Variable",monospace;color-scheme:light}*{box-sizing:border-box}html{min-width:320px;scroll-behavior:smooth;background:var(--deep)}body{min-width:320px;margin:0;overflow-x:hidden;background:var(--paper);color:var(--ink);font-family:var(--sans)}a{color:inherit}button,input,select,textarea{color:inherit;font:inherit}button{cursor:pointer}img{display:block;max-width:100%}:focus-visible{outline:3px solid var(--yellow);outline-offset:4px}::selection{background:var(--yellow);color:var(--deep)}
    .skip{position:fixed;z-index:300;top:10px;left:10px;padding:12px 15px;background:var(--yellow);font:800 10px/1 var(--mono);text-decoration:none;text-transform:uppercase;transform:translateY(-180%)}.skip:focus{transform:none}.nav{position:sticky;z-index:100;top:0;display:grid;min-height:58px;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid #ffffff33;padding:0 var(--gutter);background:#061a29ef;color:var(--white);backdrop-filter:blur(16px)}.nav a{font:750 10px/1 var(--mono);letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.brand{font-family:var(--sans)!important;font-size:13px!important;font-weight:900!important;letter-spacing:.16em!important}.nav span{color:#fff9;font:650 10px/1 var(--mono);text-transform:uppercase}.nav div{display:flex;justify-self:end;gap:18px}
    .hero{display:grid;min-height:calc(100svh - 58px);grid-template-columns:minmax(0,.96fr) minmax(420px,1.04fr);background:var(--yellow)}.hero-copy{display:flex;min-width:0;flex-direction:column;justify-content:space-between;padding:clamp(48px,7vw,105px) var(--gutter) clamp(30px,5vw,68px)}.kicker{margin:0 0 18px;font:800 10px/1.4 var(--mono);letter-spacing:.11em;text-transform:uppercase}.hero h1{max-width:7.2ch;margin:0;font-size:clamp(72px,10.3vw,164px);font-weight:930;letter-spacing:-.09em;line-height:.76;text-transform:uppercase}.hero h1 span{display:block;color:var(--deep);font-family:Georgia,serif;font-size:.34em;font-style:italic;font-weight:400;letter-spacing:-.04em;line-height:1.1;text-transform:none}.dek{max-width:630px;margin:clamp(34px,5vw,70px) 0 0;font-size:clamp(23px,2.8vw,43px);font-weight:650;letter-spacing:-.05em;line-height:1.02}.facts{display:grid;margin-top:42px;border-top:1px solid #102d4255;grid-template-columns:repeat(4,1fr)}.facts span{padding:16px 12px 0 0;font:700 9px/1.35 var(--mono);text-transform:uppercase}.facts b{display:block;margin-bottom:5px;font:900 23px/1 var(--sans)}.hero-art{position:relative;min-height:620px;overflow:hidden;background:var(--deep)}.hero-art img{width:100%;height:100%;object-fit:cover}.hero-art:after{position:absolute;inset:0;background:linear-gradient(90deg,#061a2944,transparent 40%);content:""}.hero-art figcaption{position:absolute;z-index:2;right:24px;bottom:22px;left:24px;color:var(--white);font:700 9px/1.4 var(--mono);text-transform:uppercase;text-shadow:0 1px 8px #000}
    .premise{display:grid;grid-template-columns:.56fr 1.44fr;background:var(--deep);color:var(--white)}.premise b{padding:clamp(32px,5vw,70px) var(--gutter);border-right:1px solid #ffffff30;color:var(--yellow);font:800 11px/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.premise p{margin:0;padding:clamp(32px,5vw,70px) var(--gutter);font-size:clamp(35px,5.2vw,80px);font-weight:820;letter-spacing:-.065em;line-height:.94}.premise em,.section-head em,.ending em{color:var(--orange);font-family:Georgia,serif;font-weight:400}
    .section{padding:clamp(72px,10vw,145px) var(--gutter)}.dark{background:var(--ink);color:var(--white)}.deep{background:var(--deep);color:var(--white)}.soft{background:var(--paper2)}.section-head{display:grid;margin-bottom:clamp(40px,6vw,82px);grid-template-columns:minmax(220px,.68fr) minmax(0,1.32fr);gap:40px}.section-head h2{max-width:920px;margin:0;font-size:clamp(50px,7.3vw,110px);font-weight:900;letter-spacing:-.075em;line-height:.83}.section-head>p{align-self:end;max-width:720px;margin:0;font-size:clamp(19px,2vw,29px);letter-spacing:-.03em;line-height:1.2}
    .lanes{display:grid;border-top:1px solid;border-left:1px solid;grid-template-columns:repeat(4,1fr)}.lane{position:relative;min-height:300px;border-right:1px solid;border-bottom:1px solid;padding:23px}.lane:before{position:absolute;top:0;right:0;width:50px;height:8px;background:var(--c);content:""}.lane small{color:#fff9;font:700 9px/1 var(--mono)}.lane h3{margin:48px 0 8px;font-size:clamp(27px,2.8vw,43px);letter-spacing:-.055em;line-height:.95}.lane strong{color:var(--c);font:800 10px/1.2 var(--mono);text-transform:uppercase}.lane p{margin:20px 0 0;color:#fffc;font-size:14px;line-height:1.5}
    .board-status{display:grid;margin-bottom:28px;grid-template-columns:auto 1fr;align-items:center;border:1px solid var(--line);background:var(--white)}.board-status b{align-self:stretch;padding:18px;background:var(--green);color:var(--white);font:800 10px/1.3 var(--mono);text-transform:uppercase}.board-status p{margin:0;padding:18px;font-size:14px;line-height:1.45}.briefs{display:grid;border-top:1px solid var(--line);border-left:1px solid var(--line);grid-template-columns:repeat(3,1fr)}.brief{display:flex;min-height:430px;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:25px}.brief small{font:750 9px/1 var(--mono);text-transform:uppercase}.brief h3{margin:46px 0 16px;font-size:clamp(29px,3.2vw,49px);letter-spacing:-.06em;line-height:.92}.brief .question{margin:0;font:italic 19px/1.3 Georgia,serif}.needs{display:flex;flex-wrap:wrap;gap:6px;margin:22px 0}.needs span{border:1px solid var(--line);padding:7px 9px;font:750 8px/1 var(--mono);text-transform:uppercase}.finish{margin:auto 0 20px;padding-top:22px;border-top:1px solid var(--line);font-size:13px;line-height:1.45}.brief button{border:0;padding:13px 15px;background:var(--ink);color:var(--white);font:800 9px/1 var(--mono);text-transform:uppercase}.brief button:hover{background:var(--orange)}
    .instrument{display:grid;border:1px solid #ffffff45;grid-template-columns:minmax(0,1fr) minmax(340px,.72fr)}.composer{display:grid;grid-template-columns:repeat(2,1fr)}.field{display:flex;min-width:0;flex-direction:column;gap:8px;border-right:1px solid #ffffff35;border-bottom:1px solid #ffffff35;padding:20px}.field.wide{grid-column:1/-1}.field label,.mode legend{color:var(--yellow);font:800 9px/1.3 var(--mono);letter-spacing:.06em;text-transform:uppercase}.field input,.field select,.field textarea{width:100%;border:1px solid #ffffff55;border-radius:0;padding:12px;background:#ffffff0d;color:var(--white)}.field select option{color:var(--deep)}.field textarea{min-height:100px;resize:vertical}.field small{color:#fffa;font-size:11px;line-height:1.4}.mode{grid-column:1/-1;margin:0;border:0;border-bottom:1px solid #ffffff35;padding:20px}.mode legend{padding:0}.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.mode label{display:grid;grid-template-columns:auto 1fr;gap:9px;border:1px solid #ffffff45;padding:13px}.mode strong{font-size:13px}.mode small{display:block;margin-top:4px;color:#fff9;font-size:10px;line-height:1.35}.actions{display:flex;grid-column:1/-1;flex-wrap:wrap;gap:8px;padding:20px}.actions button{border:1px solid #ffffff65;padding:13px 16px;background:transparent;color:var(--white);font:800 9px/1 var(--mono);text-transform:uppercase}.actions .primary{border-color:var(--yellow);background:var(--yellow);color:var(--deep)}.actions button:hover{border-color:var(--orange);background:var(--orange);color:var(--deep)}.status{grid-column:1/-1;min-height:42px;margin:0;padding:0 20px 20px;color:#fffb;font:650 10px/1.5 var(--mono)}
    .signal-wrap{display:flex;flex-direction:column;justify-content:space-between;background:var(--paper);color:var(--ink);padding:clamp(24px,4vw,52px)}.signal-card{position:relative;min-height:510px;border:2px solid var(--ink);padding:28px;background:linear-gradient(160deg,var(--white),var(--paper2))}.signal-card:before{position:absolute;top:0;right:0;width:80px;height:12px;background:var(--yellow);content:""}.signal-card small{font:800 9px/1.3 var(--mono);text-transform:uppercase}.signal-card h3{margin:54px 0 10px;font-size:clamp(36px,4.5vw,68px);letter-spacing:-.065em;line-height:.87}.signal-card .verb{color:var(--orange);font:italic 23px/1.1 Georgia,serif}.signal-card dl{margin:38px 0 0}.signal-card dt{margin-top:18px;color:var(--blue);font:800 9px/1.2 var(--mono);text-transform:uppercase}.signal-card dd{margin:7px 0 0;font-size:15px;line-height:1.42}.signal-foot{display:flex;justify-content:space-between;margin-top:28px;border-top:1px solid var(--line);padding-top:15px;font:750 8px/1.3 var(--mono);text-transform:uppercase}.privacy{margin:24px 0 0;font:650 10px/1.5 var(--mono)}
    .rules{display:grid;border-top:1px solid #ffffff3b;grid-template-columns:repeat(2,1fr)}.rule{display:grid;min-height:120px;grid-template-columns:50px 1fr;border-right:1px solid #ffffff3b;border-bottom:1px solid #ffffff3b;padding:22px}.rule:nth-child(even){border-right:0}.rule b{color:var(--yellow);font:800 10px/1 var(--mono)}.rule p{margin:0;font-size:15px;line-height:1.45}.boundary{display:grid;grid-template-columns:.7fr 1.3fr;background:var(--orange);color:var(--deep)}.boundary>div{padding:clamp(38px,6vw,82px) var(--gutter)}.boundary>div:first-child{border-right:1px solid #102d4240}.boundary h2{max-width:8ch;margin:0;font-size:clamp(45px,6vw,90px);letter-spacing:-.07em;line-height:.86}.boundary p{margin:0 0 22px;font-size:clamp(21px,2.5vw,34px);font-weight:700;letter-spacing:-.03em;line-height:1.15}.boundary small{font:650 11px/1.55 var(--mono)}
    .ending{display:grid;min-height:650px;grid-template-columns:1fr 1fr;background:var(--yellow)}.ending img{width:100%;height:100%;object-fit:cover}.ending-copy{display:flex;flex-direction:column;justify-content:center;padding:var(--gutter)}.ending h2{max-width:8ch;margin:0;font-size:clamp(54px,7.5vw,110px);letter-spacing:-.08em;line-height:.82}.ending p{max-width:560px;font-size:20px;line-height:1.35}.links{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.links a{border:1px solid var(--deep);padding:13px 15px;font:800 9px/1 var(--mono);text-decoration:none;text-transform:uppercase}.links a:hover{background:var(--deep);color:var(--white)}
    @media(max-width:1040px){.lanes{grid-template-columns:repeat(2,1fr)}.briefs{grid-template-columns:repeat(2,1fr)}.instrument{grid-template-columns:1fr}.signal-wrap{min-height:650px}.ending{grid-template-columns:.9fr 1.1fr}}@media(max-width:760px){.nav span,.nav div a:first-child{display:none}.hero,.premise,.section-head,.boundary,.ending{grid-template-columns:1fr}.hero{min-height:0}.hero-copy{min-height:620px}.hero-art{min-height:78svh}.premise b,.boundary>div:first-child{border-right:0;border-bottom:1px solid #ffffff30}.lanes,.briefs,.composer,.rules{grid-template-columns:1fr}.lane,.brief,.field,.rule{border-right:0}.field.wide,.mode{grid-column:auto}.mode-grid{grid-template-columns:1fr}.actions{grid-column:auto}.signal-wrap{min-height:0}.ending img{height:70svh}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to skill board</a>
  <nav class="nav"><a class="brand" href="/">PointCast</a><span>Radius 25 · Field Companion 018.A</span><div><a href="#declare">Declare a skill</a><a href="/beach-commons/v18">Radius 25</a></div></nav>
  <main id="main">
    <header class="hero"><div class="hero-copy"><div><p class="kicker">A call for skill · not assigned roles</p><h1>The Skill<br />Line <span>Declare what you can bring.</span></h1><p class="dek">Bring one thing. Ask for one counterpart. <em>Open one line.</em></p></div><div class="facts"><span><b>8</b>skill lanes</span><span><b>6</b>open briefs</span><span><b>3</b>contact choices</span><span><b>0</b>automatic posts</span></div></div><figure class="hero-art"><img src={heroImage} alt="A long regional table links twelve small working pairs with tools, cases, diagrams, models, and people at blue hour." width="1024" height="1536" /><figcaption>Radius 25 Plate 07 · Twelve pairs become a communication line · concept image</figcaption></figure></header>
    <section class="premise"><b>The invitation</b><p>Do not join “the community.” <em>Help finish one useful thing.</em></p></section>

    <section class="section dark"><div class="section-head"><div><p class="kicker">01 · What can you bring?</p><h2>Eight ways to <em>enter.</em></h2></div><p>A skill lane is a declaration, not a permanent identity. Choose the useful action you want to offer now. You can change lanes, combine them, or stop.</p></div><div class="lanes">{SKILL_LANES.map(lane=><article class="lane" style={`--c:${lane.color}`}><small>{lane.number}</small><h3>{lane.title}</h3><strong>{lane.verb}</strong><p>{lane.prompt}</p></article>)}</div></section>

    <section class="section soft" id="board"><div class="section-head"><div><p class="kicker">02 · The open board</p><h2>Calls before <em>names.</em></h2></div><p>These six cards are editorial seed briefs from Radius 25. They are not scheduled events, funded jobs, permitted activities, or evidence that a team exists. They show the size of a useful invitation.</p></div><div class="board-status"><b>Board status · seed stage</b><p><strong>No participant names or declarations are published yet.</strong> The first release opens a safe way to make and pass a signal without creating a public personal-data directory.</p></div><div class="briefs">{OPEN_BRIEFS.map(brief=><article class="brief"><small>{brief.number} · {brief.window} · {brief.pair}</small><h3>{brief.title}</h3><p class="question">{brief.question}</p><div class="needs">{brief.needs.map(need=><span>{SKILL_LANES.find(l=>l.id===need)?.title}</span>)}</div><p class="finish"><strong>Finish line · </strong>{brief.finish}</p><button type="button" data-pick-brief={brief.id}>Build a signal for this brief →</button></article>)}</div></section>

    <section class="section deep" id="declare" data-signal-board data-lanes={JSON.stringify(SKILL_LANES)} data-briefs={JSON.stringify(OPEN_BRIEFS)}><div class="section-head"><div><p class="kicker">03 · Declaration instrument</p><h2>Make one <em>signal.</em></h2></div><p>Your card exists only in this page until you choose Copy, Share, or Email. PointCast does not store it, count it, identify you, or post it. Keep private contact details out of public shares.</p></div><div class="instrument"><form class="composer" data-composer><div class="field"><label for="signal-alias">Name or alias · optional</label><input id="signal-alias" data-alias autocomplete="name" placeholder="A neighbor in the 25-mile field" maxlength="80" /><small>An alias is welcome. This stays in your browser until you choose an action.</small></div><div class="field"><label for="signal-lane">Skill lane</label><select id="signal-lane" data-lane>{SKILL_LANES.map(lane=><option value={lane.id}>{lane.title}</option>)}</select></div><div class="field wide"><label for="signal-bring">What can you bring?</label><textarea id="signal-bring" data-bring maxlength="360" placeholder="One concrete capability, tool, method, room, or kind of attention."></textarea><small>Specific beats impressive: “I can sew and repair heavy canvas” is easier to pair than “creative leader.”</small></div><div class="field"><label for="signal-evidence">Small proof · optional</label><input id="signal-evidence" data-evidence maxlength="180" placeholder="Something you made, repaired, taught, tested, or hosted" /></div><div class="field"><label for="signal-brief">One brief</label><select id="signal-brief" data-brief>{OPEN_BRIEFS.map(brief=><option value={brief.id}>{brief.title}</option>)}</select></div><div class="field wide"><label for="signal-need">What counterpart would help?</label><textarea id="signal-need" data-need maxlength="300" placeholder="One skill, review, access perspective, or handoff you do not have."></textarea></div><div class="field"><label for="signal-window">Availability</label><select id="signal-window" data-window><option>One afternoon</option><option>One weekend</option><option>A 90-day proof</option><option>One season</option><option>Async advice only</option></select></div><div class="field"><label for="signal-contact">Contact line · optional</label><input id="signal-contact" data-contact maxlength="180" placeholder="Email, site, or handle—only if you want it in the card" /><small>Do not add this if the signal will be shared publicly and you prefer a private relay.</small></div><fieldset class="mode"><legend>Communication permission</legend><div class="mode-grid">{COMMUNICATION_MODES.map((mode,i)=><label><input type="radio" name="signal-mode" value={mode.id} checked={i===0} /><span><strong>{mode.title}</strong><small>{mode.detail}</small></span></label>)}</div></fieldset><div class="actions"><button class="primary" type="submit">Make my signal</button><button type="button" data-copy>Copy</button><button type="button" data-share>Share</button><button type="button" data-relay>Draft one-intro email</button><button type="button" data-clear>Clear</button></div><p class="status" data-status aria-live="polite">Nothing has been sent or saved.</p></form><div class="signal-wrap"><article class="signal-card" aria-live="polite"><small>{SIGNAL_TEMPLATE.title}</small><h3 data-card-alias>{SIGNAL_TEMPLATE.emptyAlias}</h3><div class="verb" data-card-lane>{SKILL_LANES[0].title} · {SKILL_LANES[0].verb}</div><dl><dt>I can bring</dt><dd data-card-bring>{SIGNAL_TEMPLATE.defaultBring}</dd><dt>For this brief</dt><dd data-card-brief>{OPEN_BRIEFS[0].title}</dd><dt>I need</dt><dd data-card-need>{SIGNAL_TEMPLATE.defaultNeed}</dd><dt>Availability</dt><dd data-card-window>One afternoon</dd><dt data-evidence-label hidden>Small proof</dt><dd data-card-evidence hidden></dd><dt data-contact-label hidden>Contact line</dt><dd data-card-contact hidden></dd></dl><div class="signal-foot"><span>One declared skill</span><span>One requested counterpart</span></div></article><p class="privacy">Browser-local composition · no database · no account · no analytics · no auto-post · no automatic match</p></div></div></section>

    <section class="section dark"><div class="section-head"><div><p class="kicker">04 · The agreement</p><h2>Permission before <em>connection.</em></h2></div><p>A useful skill board needs clean edges more than a giant member count. These are the release rules for declaring, relaying, declining, paying, and closing.</p></div><div class="rules">{BOARD_RULES.map((rule,i)=><div class="rule"><b>{String(i+1).padStart(2,'0')}</b><p>{rule}</p></div>)}</div></section>

    <aside class="boundary"><div><p class="kicker">Reality boundary</p><h2>A call, not a coalition.</h2></div><div><p>No real person is listed on this board until they choose to be, and no match, role, job, payment, event, place, or project is promised.</p><small>{SKILL_LINE.status} The email button opens a user-controlled draft to {SKILL_LINE.contact}; sending it is the visitor’s choice. PointCast may respond or make one consent-based introduction if a credible counterpart appears, but it does not promise a reply or match. Physical work begins only after the relevant owner, operator, agency, permit, insurance, labor, access, ecological, security, and safety requirements are known.</small></div></aside>

    <footer class="ending"><img src="/beach-commons/v18/assets/poster-08.png" alt="A blue-hour regional exchange gathers completed prototypes, proof cards, and neighbors around one long table." width="1024" height="1536" loading="lazy" /><div class="ending-copy"><p class="kicker">The Radius 25 next move</p><h2>Let the first connection be <em>small enough to finish.</em></h2><p>A capability becomes a regional strength when it finds the right counterpart and completes something useful.</p><div class="links"><a href="#declare">Make a signal</a><a href="/beach-commons/v18/skills.json">Open JSON</a><a href="/b/0549">Block 0549</a><a href="/beach-commons/v18">Return to Radius 25</a></div></div></footer>
  </main>
  <script>
    const root=document.querySelector('[data-signal-board]');
    if(root){
      const lanes=JSON.parse(root.dataset.lanes||'[]'),briefs=JSON.parse(root.dataset.briefs||'[]');
      const get=(q)=>root.querySelector(q),value=(q)=>get(q)?.value?.trim()||'';
      const put=(q,v)=>{const e=get(q);if(e)e.textContent=v};
      const toggle=(labelQ,valueQ,v)=>{const label=get(labelQ),el=get(valueQ),show=Boolean(v);if(label)label.hidden=!show;if(el){el.hidden=!show;el.textContent=v}};
      const selectedMode=()=>root.querySelector('input[name="signal-mode"]:checked')?.value||'copy';
      const card=()=>{
        const lane=lanes.find((item)=>item.id===value('[data-lane]'))||lanes[0],brief=briefs.find((item)=>item.id===value('[data-brief]'))||briefs[0];
        const data={alias:value('[data-alias]')||'A neighbor in the 25-mile field',lane,brief,bring:value('[data-bring]')||'I can bring one concrete, inspectable skill.',need:value('[data-need]')||'I am looking for one counterpart who can help finish the proof.',evidence:value('[data-evidence]'),window:value('[data-window]')||'One afternoon',contact:value('[data-contact]'),mode:selectedMode()};
        put('[data-card-alias]',data.alias);put('[data-card-lane]',`${lane.title} · ${lane.verb}`);put('[data-card-bring]',data.bring);put('[data-card-brief]',brief.title);put('[data-card-need]',data.need);put('[data-card-window]',data.window);toggle('[data-evidence-label]','[data-card-evidence]',data.evidence);toggle('[data-contact-label]','[data-card-contact]',data.contact);
        return data;
      };
      const signalText=()=>{const d=card();return [`RADIUS 25 · SKILL SIGNAL`,d.alias,`${d.lane.title} · ${d.lane.verb}`,`I can bring: ${d.bring}`,`Brief: ${d.brief.title}`,`I need: ${d.need}`,d.evidence?`Small proof: ${d.evidence}`:'',`Availability: ${d.window}`,d.contact?`Contact line: ${d.contact}`:'',`Permission: ${d.mode==='relay'?'one consent-based introduction':d.mode==='share'?'share with people I choose':'copy only'}`,`https://pointcast.xyz/beach-commons/v18/skills`].filter(Boolean).join('\n');};
      const status=(message)=>put('[data-status]',message);
      get('[data-composer]')?.addEventListener('submit',(event)=>{event.preventDefault();card();status('Signal made in this page. Nothing has been sent or saved.');});
      root.querySelectorAll('input,textarea,select').forEach((input)=>input.addEventListener('input',card));
      get('[data-copy]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(signalText());status('Copied. PointCast received nothing.')}catch{status('Copy was blocked by this browser. Select the card text or use the share button.')}});
      get('[data-share]')?.addEventListener('click',async()=>{const text=signalText();if(navigator.share){try{await navigator.share({title:'Radius 25 · Skill Signal',text});status('Share sheet closed. Nothing was posted automatically.')}catch(error){if(error?.name!=='AbortError')status('Share was unavailable. Try Copy instead.')}}else{try{await navigator.clipboard.writeText(text);status('Share sheets are unavailable here, so the signal was copied instead.')}catch{status('Share and clipboard are unavailable in this browser.')}}});
      get('[data-relay]')?.addEventListener('click',()=>{const d=card();const subject=`Radius 25 skill signal · ${d.brief.title}`;const body=`Hello PointCast,\n\nI am requesting at most one consent-based introduction around this signal. I understand a reply or match is not promised.\n\n${signalText()}\n\nPlease do not publish my declaration or contact line without asking me separately.`;window.location.href=`mailto:hello@pointcast.xyz?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;status('Email draft opened. Nothing is sent until you review and send it.');});
      get('[data-clear]')?.addEventListener('click',()=>{get('[data-composer]')?.reset();root.querySelectorAll('input:not([type="radio"]),textarea').forEach((input)=>input.value='');card();status('Cleared. Nothing was stored.');});
      document.querySelectorAll('[data-pick-brief]').forEach((button)=>button.addEventListener('click',()=>{const select=get('[data-brief]');if(select)select.value=button.dataset.pickBrief||briefs[0].id;card();root.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});status('Brief selected. Add one skill and one requested counterpart.');}));
      card();
    }
  </script>
</body>
</html>
