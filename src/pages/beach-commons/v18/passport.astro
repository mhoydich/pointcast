    .arc-map{display:grid;grid-template-columns:1.15fr .85fr;border:1px solid var(--line)}.map-visual{position:relative;min-height:660px;overflow:hidden;background:var(--fog)}.ring{position:absolute;left:50%;top:50%;border:2px solid var(--ink);border-radius:50%;transform:translate(-50%,-50%)}.ring.r1{width:560px;height:560px}.ring.r2{width:350px;height:350px;border-color:var(--ocean)}.ring.r3{width:150px;height:150px;border-color:var(--court)}.map-center{position:absolute;left:50%;top:50%;display:grid;width:86px;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--sun);font:900 10px/1.2 var(--mono);text-align:center;text-transform:uppercase;transform:translate(-50%,-50%)}.map-node{position:absolute;display:grid;width:98px;aspect-ratio:1;place-items:center;border:2px solid var(--ink);border-radius:50%;background:var(--paper2);font:800 9px/1.15 var(--mono);text-align:center;text-transform:uppercase}.map-node:nth-of-type(4){left:13%;top:17%}.map-node:nth-of-type(5){right:11%;top:19%}.map-node:nth-of-type(6){left:12%;bottom:16%}.map-node:nth-of-type(7){right:15%;bottom:12%}.map-node:nth-of-type(8){left:44%;top:8%}.map-node:nth-of-type(9){right:5%;top:48%}.map-notes{padding:clamp(25px,4vw,54px)}.map-notes h3{margin:0 0 24px;font-size:clamp(42px,5vw,75px);letter-spacing:-.065em;line-height:.88}.map-notes p{font-size:18px;line-height:1.45}.map-notes ol{margin:28px 0 0;padding:0;list-style:none;counter-reset:map}.map-notes li{border-top:1px solid var(--line);padding:15px 0 15px 44px;counter-increment:map;font-size:14px;line-height:1.4}.map-notes li:before{float:left;margin-left:-44px;color:var(--court);font:800 10px/1.5 var(--mono);content:counter(map,decimal-leading-zero)}
    .audio-grid{display:grid;border-top:1px solid #ffffff43;grid-template-columns:repeat(4,1fr)}.audio-card{position:relative;display:flex;min-height:390px;flex-direction:column;overflow:hidden;border-right:1px solid #ffffff3f;border-bottom:1px solid #ffffff3f;padding:24px}.audio-card:last-child{border-right:0}.audio-card:before{position:absolute;right:-45px;bottom:-45px;width:190px;aspect-ratio:1;border:26px solid var(--audio);border-radius:50%;content:"";opacity:.45}.audio-card>*{position:relative;z-index:2}.audio-card small{color:var(--sun);font:760 9px/1 var(--mono)}.audio-card h3{margin:65px 0 18px;font-size:clamp(28px,3vw,45px);letter-spacing:-.055em;line-height:.95}.audio-card p{color:#ffffffad;font-size:14px;line-height:1.47}.audio-card button{margin-top:auto;border:1px solid var(--audio);padding:13px;background:transparent;color:var(--white);font:800 10px/1 var(--mono);text-transform:uppercase}.audio-card button[data-playing="true"]{background:var(--audio);color:var(--deep)}.audio-boundary{margin:22px 0 0;color:#ffffff8f;font:610 9px/1.5 var(--mono);text-transform:uppercase}
    .playlist-grid{display:grid;border-top:1px solid var(--line);grid-template-columns:repeat(3,1fr)}.playlist{display:flex;min-height:330px;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px}.playlist:nth-child(3n){border-right:0}.playlist small{color:var(--ocean);font:800 9px/1 var(--mono);text-transform:uppercase}.playlist h3{margin:50px 0 16px;font-size:clamp(27px,3vw,43px);letter-spacing:-.055em;line-height:.94}.playlist p{margin:0;font-size:14px;line-height:1.48}.playlist footer{margin-top:auto;padding-top:28px}.playlist a,.playlist .pending{display:inline-block;border:1px solid var(--ink);padding:12px 14px;font:760 9px/1 var(--mono);text-decoration:none;text-transform:uppercase}.playlist .pending{border-style:dashed;color:#19323eaa}.provider-note{margin:25px 0 0;font:620 9px/1.55 var(--mono);text-transform:uppercase}
    .boards{display:grid;border-top:1px solid var(--line);grid-template-columns:repeat(4,1fr)}.board{min-height:420px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:23px;background:var(--board);text-decoration:none}.board:last-child{border-right:0}.board small{font:800 9px/1 var(--mono);text-transform:uppercase}.board h3{margin:50px 0 18px;font-size:clamp(28px,3vw,44px);letter-spacing:-.055em;line-height:.93}.board p{margin:0;font-size:14px;line-height:1.45}.board b{display:block;margin-top:35px;font-size:72px;letter-spacing:-.08em;line-height:.8}.board span{display:inline-block;margin-top:24px;border-bottom:1px solid;font:800 9px/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase}.board:hover span{border-bottom-color:transparent}.pin-wall{display:grid;margin-top:1px;grid-template-columns:repeat(10,1fr)}.pin-wall a{position:relative;overflow:hidden;aspect-ratio:2/3}.pin-wall img{width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.pin-wall a:hover img{transform:scale(1.06)}
