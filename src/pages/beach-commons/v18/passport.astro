  <a class="skip" href="#main">Skip to passport</a>
  <nav class="nav"><a class="brand" href="/">PointCast</a><span>Beach Commons · Field Study 018.D</span><div class="navlinks"><a href="/beach-commons/v18/outdoors">OPEN/25</a><a href="/beach-commons/v18">Radius 25</a><a href="#passport">Stamp book</a></div></nav>
  <main id="main">
    <header class="hero"><div class="hero-copy"><div><p class="kicker">A manual public-space passport · El Segundo center · no GPS</p><h1>PASS/<br />25 <span>Same park, many worlds</span></h1><p class="dek">The check-in is not proof you occupied a coordinate. It is proof you <em>noticed something.</em></p></div><div class="hero-facts"><span><b>25</b>public doors</span><span><b>6</b>viewpoints</span><span><b>24</b>stamps</span><span><b>12</b>hunts</span></div></div><div class="hero-field"><div class="cross"></div><div class="stamp-hero"><b>+</b><span>Local only</span></div><p>Choose the door yourself · choose the way of looking · earn the stamp honestly · leave no location trail</p></div></header>
    <section class="thesis"><b>The shared-place idea</b><p>Everyone sees it differently. <em>Everyone is still there together.</em></p></section>

    <section class="section deep" id="viewfinder"><div class="section-head"><div><p class="eyebrow">01 · Same door, six worlds</p><h2>Change the <em>view.</em></h2></div><p>A single public park can be a court, composition, habitat, neighborhood room, quiet interval, and sound field. Pick a door and a lens; the prompt changes without claiming the place belongs to any one use.</p></div><div class="viewfinder" data-viewfinder><div class="view-controls"><label class="label" for="view-door">Choose a public door</label><select class="door-select" id="view-door" data-view-door>{PASSPORT_DOORS.map((door)=><option value={door.id}>{door.number} · {door.name}</option>)}</select><div class="lens-buttons">{PASSPORT_LENSES.map((lens,index)=><button class="lens-btn" type="button" style={`--lens:${lens.color}`} data-lens={lens.id} aria-pressed={index===0?'true':'false'}><b>{lens.mark}</b><span>{lens.number} · {lens.title}</span></button>)}</div></div><div class="view-result" style={`--active:${PASSPORT_LENSES[0].color}`} data-view-result><div><div class="view-mark" data-view-mark>{PASSPORT_LENSES[0].mark}</div><h3 data-view-title>{PASSPORT_LENSES[0].title} view</h3><p class="premise" data-view-premise>{PASSPORT_LENSES[0].premise}</p></div><p class="view-prompt" data-view-prompt>{PASSPORT_LENSES[0].prompt}</p></div></div></section>

    <section class="section paper2" id="passport"><div class="section-head"><div><p class="eyebrow">02 · Check in by noticing</p><h2>Your local <em>stamp book.</em></h2></div><p>No location permission. No account. No upload. A check-in is a visitor choosing a public door, a way of looking, and the stamp they honestly completed.</p></div><div class="passport"><form class="check-form" data-check-form><label><span class="label">01 · Public door</span><select name="door">{PASSPORT_DOORS.map((door)=><option value={door.id}>{door.number} · {door.name}</option>)}</select></label><label><span class="label">02 · Way of looking</span><select name="lens">{PASSPORT_LENSES.map((lens)=><option value={lens.id}>{lens.number} · {lens.title}</option>)}</select></label><label><span class="label">03 · Stamp completed</span><select name="stamp">{PASSPORT_STAMPS.map((stamp)=><option value={stamp.id}>{stamp.mark} · {stamp.title} — {stamp.test}</option>)}</select></label><button type="submit">Stamp this visit</button><p class="micro">Manual honor system. Confirm the official source and current conditions. A PointCast stamp is not a permit, reservation, safety check, access guarantee, or agency record.</p></form><div class="book"><div class="book-top"><h3>Twenty-four ways to arrive.</h3><div class="counter"><b data-stamp-count>0</b>unique stamps</div></div><div class="stamp-book">{PASSPORT_STAMPS.map((stamp)=><div class="stamp-slot" data-stamp-slot={stamp.id} data-earned="false" title={stamp.test}><span>{stamp.mark}</span><small>{stamp.title}</small></div>)}</div><div class="receipt-list" data-receipts><p class="empty">Your session is blank. Pick one small, honest observation above.</p></div><div class="save-controls"><button type="button" data-primary data-save-device>Save on this device</button><button type="button" data-export>Export receipt</button><button type="button" data-erase>Erase local book</button></div><p class="save-note" data-save-note>Session only. Nothing has been written to device storage.</p></div></div></section>

    <section class="section deep" id="hunts"><div class="section-head"><div><p class="eyebrow">03 · Pocket adventures</p><h2>Twelve treasures. <em>Take none.</em></h2></div><p>The treasure is a pattern, courtesy, line, sound, depth, or clean ending—not a shell, rock, plant, animal, artifact, or object removed from the commons.</p></div><div class="routes">{TREASURE_ROUTES.map((route)=><article class="route"><small>{route.number} · {route.time} · {route.company}</small><h3>{route.title}</h3><p>{route.prompt}</p><footer><b>Proof without posting</b><p>{route.proof}</p></footer></article>)}</div></section>

    <section class="section fog" id="map"><div class="section-head"><div><p class="eyebrow">04 · The field, not directions</p><h2>A map of <em>possibilities.</em></h2></div><p>This diagram is an editorial orientation—not navigation, distance, live availability, access, or a geofence. Each door still returns to its official steward.</p></div><div class="arc-map"><div class="map-visual" aria-label="Abstract Radius 25 arc diagram"><div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div><div class="map-center">El<br/>Segundo</div><span class="map-node">South<br/>Bay</span><span class="map-node">Marina +<br/>Westside</span><span class="map-node">Torrance +<br/>Peninsula</span><span class="map-node">North<br/>coast</span><span class="map-node">Baldwin<br/>Hills</span><span class="map-node">Pacific<br/>edge</span></div><div class="map-notes"><h3>Six arcs, no center of gravity.</h3><p>Use the arcs to imagine a day, then use the official source to make a real decision.</p><ol><li>Choose one arc, not a mileage conquest.</li><li>Confirm hours, closures, permits, parking, tides, weather, and current rules.</li><li>Pick a lens that fits what is already happening.</li><li>Finish with time, energy, people, and equipment in reserve.</li></ol></div></div></section>

    <section class="section deep" id="audio"><div class="section-head"><div><p class="eyebrow">05 · Original audio companions</p><h2>A little sound. <em>More place.</em></h2></div><p>Four gesture-started Web Audio sketches create quiet tones in the browser. They use no microphone, recording, upload, samples, or autoplay—and they stop quickly so the real environment stays audible.</p></div><div class="audio-grid">{AUDIO_COMPANIONS.map((audio)=><article class="audio-card" style={`--audio:${audio.colors[0]}`}><small>{audio.number} · {audio.seconds} seconds</small><h3>{audio.title}</h3><p>{audio.note}</p><button type="button" data-audio={audio.id} aria-label={`Play ${audio.title}`}>Play tiny companion</button></article>)}</div><p class="audio-boundary">Keep device volume low. Stop audio where sound affects wildlife, neighbors, instruction, access, safety, or an existing public program.</p></section>

    <section class="section paper2" id="playlists"><div class="section-head"><div><p class="eyebrow">06 · OPEN/25 on Spotify</p><h2>Six longer <em>listening exits.</em></h2></div><p>Each mix is a separate Spotify handoff shaped for a kind of outdoor day. Spotify supplies the music and playback; PointCast does not proxy or restream it.</p></div><div class="playlist-grid">{SPOTIFY_SERIES.map((playlist)=><article class="playlist"><small>{playlist.number} · playlist series</small><h3>{playlist.title}</h3><p>{playlist.use}</p><footer>{playlist.status==='public' && 'url' in playlist ? <a href={(playlist as any).url} target="_blank" rel="noopener">Open in Spotify ↗</a> : <span class="pending">Playlist being filled</span>}</footer></article>)}</div><p class="provider-note">Publication truth: a playlist only becomes a live exit here after its public Spotify page and contents are independently checked.</p></section>

    <section class="section fog" id="pinterest"><div class="section-head"><div><p class="eyebrow">07 · Pinterest field atlas</p><h2>Fifty views. <em>Four weather systems.</em></h2></div><p>Four boards sort the same regional commons by season, area, mood, and use. The cards disagree productively: one place can invite a player and a quiet walker without becoming two places.</p></div><div class="boards">{PINTEREST_BOARDS.map((board)=><a class="board" href={board.url} rel="noreferrer" style={`--board:${board.color}`}><small>{board.number} · {board.season} · {board.area}</small><h3>{board.title}</h3><p>{board.count} authored vertical field cards, each tied to one public door, lens, and leave-it-there stamp.</p><b>{board.count}</b><span>Open public board ↗</span></a>)}</div><div class="pin-wall" aria-label="Fifty PASS/25 Pinterest card previews">{PINTEREST_PINS.map((pin)=><a href={pin.image} title={pin.title}><img src={pin.image} alt={`${pin.title}: ${pin.prompt}`} width="1000" height="1500" loading="lazy" /></a>)}</div></section>

    <section class="privacy"><div><p class="eyebrow">The privacy position</p><h2>Check in without checking over.</h2></div><div><p>The app does not need to know where you are. It needs you to choose what you noticed.</p><ul><li>No account, geolocation, map tracking, camera, microphone, analytics, cookies, or network write.</li><li>The working stamp book lives only in page memory until “Save on this device” is pressed.</li><li>Save uses browser local storage on that device. Export creates a user-controlled JSON receipt.</li><li>Erase removes the PASS/25 key. Nothing is posted or matched automatically.</li><li>A share is always an outbound, user-controlled act outside this app.</li></ul></div></section>
    <section class="end"><div><h2>The place is shared. <em>The view is yours.</em></h2><p>Pick one door, one lens, one small proof. Then leave the commons easier for the next person to see.</p><div class="end-links"><a href="#viewfinder">Change the view</a><a href="#passport">Open stamp book</a><a href="/beach-commons/v18/outdoors">Check the 25 public doors</a><a href="/beach-commons/v18/passport.json">JSON companion</a><a href="/b/0558">Block 0558</a></div></div></section>
  </main>
  <script is:inline define:vars={{ doors: PASSPORT_DOORS, lenses: PASSPORT_LENSES, stamps: PASSPORT_STAMPS, audioCompanions: AUDIO_COMPANIONS }}>
    const byId = (items, id) => items.find((item) => item.id === id);
    const viewDoor = document.querySelector('[data-view-door]');
    const lensButtons = [...document.querySelectorAll('[data-lens]')];
    const viewResult = document.querySelector('[data-view-result]');
    let activeLens = lenses[0].id;
    const renderView = () => {
      const lens = byId(lenses, activeLens);
      const door = byId(doors, viewDoor.value);
      viewResult.style.setProperty('--active', lens.color);
      viewResult.querySelector('[data-view-mark]').textContent = lens.mark;
      viewResult.querySelector('[data-view-title]').textContent = `${lens.title} view`;
      viewResult.querySelector('[data-view-premise]').textContent = `${door.name}: ${lens.premise}`;
      viewResult.querySelector('[data-view-prompt]').textContent = lens.prompt;
      lensButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.lens === activeLens)));
    };
    lensButtons.forEach((button) => button.addEventListener('click', () => { activeLens = button.dataset.lens; renderView(); }));
    viewDoor.addEventListener('change', renderView);

    const storageKey = 'pointcast.pass25.v1';
    let visits = [];
    let deviceSave = false;
    const receipts = document.querySelector('[data-receipts]');
    const stampCount = document.querySelector('[data-stamp-count]');
    const saveNote = document.querySelector('[data-save-note]');
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) { visits = JSON.parse(stored); deviceSave = true; }
    } catch {}
    const renderBook = () => {
      const earned = new Set(visits.map((visit) => visit.stampId));
      stampCount.textContent = String(earned.size);
      document.querySelectorAll('[data-stamp-slot]').forEach((slot) => slot.dataset.earned = String(earned.has(slot.dataset.stampSlot)));
      if (!visits.length) receipts.innerHTML = '<p class="empty">Your session is blank. Pick one small, honest observation above.</p>';
      else receipts.innerHTML = visits.slice().reverse().map((visit, index) => {
        const door = byId(doors, visit.doorId); const lens = byId(lenses, visit.lensId); const stamp = byId(stamps, visit.stampId);
        return `<div class="receipt"><b>${stamp.mark}</b><span><b>${stamp.title}</b> · ${door.name}</span><small>${lens.title} · ${String(visits.length-index).padStart(2,'0')}</small></div>`;
      }).join('');
      saveNote.textContent = deviceSave ? 'Saved only in this browser on this device. Nothing was uploaded.' : 'Session only. Nothing has been written to device storage.';
    };
    document.querySelector('[data-check-form]').addEventListener('submit', (event) => {
      event.preventDefault(); const data = new FormData(event.currentTarget);
      visits.push({ doorId:data.get('door'), lensId:data.get('lens'), stampId:data.get('stamp'), recordedAt:new Date().toISOString() });
      if (deviceSave) try { localStorage.setItem(storageKey, JSON.stringify(visits)); } catch {}
      renderBook();
    });
    document.querySelector('[data-save-device]').addEventListener('click', () => {
      try { localStorage.setItem(storageKey, JSON.stringify(visits)); deviceSave = true; renderBook(); } catch { saveNote.textContent = 'This browser did not allow local device storage.'; }
    });
    document.querySelector('[data-erase]').addEventListener('click', () => {
      visits = []; deviceSave = false; try { localStorage.removeItem(storageKey); } catch {} renderBook();
    });
    document.querySelector('[data-export]').addEventListener('click', () => {
      const payload = { schema:'pointcast-pass25-receipt/v1', exportedAt:new Date().toISOString(), visits };
      const blob = new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}); const link=document.createElement('a');
      link.href=URL.createObjectURL(blob); link.download='pointcast-pass25-receipt.json'; link.click(); setTimeout(()=>URL.revokeObjectURL(link.href),1000);
    });
    renderBook();

    let audioContext;
    let audioTimer;
    document.querySelectorAll('[data-audio]').forEach((button) => button.addEventListener('click', () => {
      clearTimeout(audioTimer); document.querySelectorAll('[data-audio]').forEach((item)=>{ item.dataset.playing='false'; item.textContent='Play tiny companion'; });
      const scene=byId(audioCompanions,button.dataset.audio); audioContext ||= new (window.AudioContext||window.webkitAudioContext)();
      const start=audioContext.currentTime+.04; const beats=Math.floor(scene.seconds*1000/scene.tempo);
      for(let i=0;i<beats;i++){ const osc=audioContext.createOscillator(); const gain=audioContext.createGain(); const at=start+i*scene.tempo/1000; osc.type=i%3===0?'sine':'triangle'; osc.frequency.value=scene.notes[i%scene.notes.length]; gain.gain.setValueAtTime(0.0001,at); gain.gain.exponentialRampToValueAtTime(i%4===0?.055:.025,at+.035); gain.gain.exponentialRampToValueAtTime(.0001,at+.62); osc.connect(gain).connect(audioContext.destination); osc.start(at); osc.stop(at+.7); }
      button.dataset.playing='true'; button.textContent='Playing quietly…'; audioTimer=setTimeout(()=>{button.dataset.playing='false';button.textContent='Play tiny companion';},scene.seconds*1000);
    }));
  </script>
</body>
</html>
