    *{box-sizing:border-box}html{min-width:320px;scroll-behavior:smooth;background:var(--deep)}body{min-width:320px;margin:0;overflow-x:hidden;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit}button,select{color:inherit;font:inherit}button{cursor:pointer}img{display:block;max-width:100%}[hidden]{display:none!important}:focus-visible{outline:3px solid var(--sun);outline-offset:4px}::selection{background:var(--sun);color:var(--deep)}
