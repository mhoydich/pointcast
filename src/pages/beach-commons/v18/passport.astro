    .hero{display:grid;min-height:calc(100svh - 58px);grid-template-columns:minmax(0,.92fr) minmax(430px,1.08fr);background:var(--fog)}.hero-copy{display:flex;min-width:0;flex-direction:column;justify-content:space-between;padding:clamp(48px,7vw,110px) var(--gutter) clamp(38px,5vw,72px)}.kicker,.eyebrow{margin:0 0 18px;font:800 10px/1.45 var(--mono);letter-spacing:.1em;text-transform:uppercase}.hero h1{max-width:6.4ch;margin:0;font-size:clamp(78px,11vw,176px);font-weight:930;letter-spacing:-.095em;line-height:.73;text-transform:uppercase}.hero h1 span{display:block;margin-top:.3em;color:var(--ocean);font-family:Georgia,serif;font-size:.28em;font-style:italic;font-weight:400;letter-spacing:-.03em;line-height:.95;text-transform:none}.dek{max-width:670px;margin:clamp(34px,5vw,74px) 0 0;font-size:clamp(23px,2.8vw,43px);font-weight:650;letter-spacing:-.047em;line-height:1.03}.hero-facts{display:grid;margin-top:42px;border-top:1px solid var(--line);grid-template-columns:repeat(4,1fr)}.hero-facts span{padding:16px 8px 0 0;font:700 9px/1.35 var(--mono);text-transform:uppercase}.hero-facts b{display:block;margin-bottom:5px;font:900 25px/1 var(--sans)}
