---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { SHRINE_25, SHRINE_BOUNDARIES, SHRINE_COMPANY, SHRINE_DOORS, SHRINE_LANES, SHRINE_PROTOCOLS, SHRINE_SOURCES, SHRINE_WATCHES } from '../../../lib/radius25-shrines';

const canonical = SHRINE_25.url;
const socialImage = 'https://pointcast.xyz/beach-commons/v18/shrines/og.png';
const initialProtocol = SHRINE_PROTOCOLS[0];
const initialDoor = SHRINE_DOORS[0];
const initialWatch = SHRINE_WATCHES[0];
const initialCompany = SHRINE_COMPANY[0];
const structuredData = {
  '@context':'https://schema.org', '@type':'CreativeWork', name:`${SHRINE_25.title} — ${SHRINE_25.subtitle}`,
  description:SHRINE_25.dek, url:canonical, image:socialImage, datePublished:SHRINE_25.publishedAt, dateModified:SHRINE_25.updatedAt,
  creator:[{'@type':'Person',name:'Michael Hoydich'},{'@type':'Organization',name:'Codex / OpenAI'}],
  isPartOf:{'@type':'CreativeWork',name:'Radius 25 — Beach Commons Field Study 018',url:'https://pointcast.xyz/beach-commons/v18'},
};
