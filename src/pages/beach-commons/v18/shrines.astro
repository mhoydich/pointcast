<body>
<a class="skip" href="#main">Skip to shrine builder</a>
<nav class="nav"><a class="brand" href="/">PointCast</a><span>Beach Commons · Field Companion 018.E</span><div class="navlinks"><a href="/beach-commons/v18/passport">PASS/25</a><a href="/beach-commons">Commons</a></div></nav>
<main id="main">
  <header class="hero"><div class="hero-copy"><div><p class="kicker">Radius 25 · local public shrines · independent editorial study</p><h1>SHRINE/<br />25 <em>Nothing left behind</em></h1><p class="dek">Twelve portable rituals for light, weather, memory, repair, play, and the clean close.</p></div><div class="hero-facts"><span><b>12</b>rituals</span><span><b>04</b>reality lanes</span><span><b>00</b>objects left</span></div></div><div class="halo-field"><div class="orbit" aria-hidden="true"><i></i></div><div class="halo" aria-hidden="true"></div><span class="halo-mark" aria-hidden="true">·</span><p class="field-note">A temporary place of attention · hosted · attended · carried home</p></div></header>
  <section class="thesis"><b>The definition</b><p>A public shrine is a hosted interval of attention—<em>not an unattended object or a claim on public land.</em></p></section>

  <section class="section deep" id="composer" data-protocols={JSON.stringify(SHRINE_PROTOCOLS)} data-doors={JSON.stringify(SHRINE_DOORS)} data-watches={JSON.stringify(SHRINE_WATCHES)} data-companies={JSON.stringify(SHRINE_COMPANY)}>
    <div class="section-head"><div><p class="kicker">01 · Portable score</p><h2>Build the <em>interval.</em></h2></div><p>Choose a public door manually, one ritual, a time of day, and company size. The composer keeps the plan in this page unless you explicitly save it to this browser.</p></div>
    <div class="composer"><form class="controls" onsubmit="return false"><label><span class="label">01 · Public door</span><select data-door-select>{SHRINE_DOORS.map(d=><option value={d.id}>{d.number} · {d.name} · {d.city}</option>)}</select></label><label><span class="label">02 · Ritual</span><select data-shrine-select>{SHRINE_PROTOCOLS.map(p=><option value={p.id}>{p.number} · {p.title}</option>)}</select></label><label><span class="label">03 · Watch</span><select data-watch-select>{SHRINE_WATCHES.map(w=><option value={w.id}>{w.label} · {w.time}</option>)}</select></label><label><span class="label">04 · Company</span><select data-company-select>{SHRINE_COMPANY.map(c=><option value={c.id}>{c.label} · {c.range}</option>)}</select></label><p class="status">Manual selection · no GPS · no account · check the linked steward before leaving</p></form>
      <article class="result" aria-live="polite"><div class="result-top"><span class="result-mark" data-result-mark>{initialProtocol.mark}</span><span class="route-badge" data-lane-badge>Pocket shrine</span></div><h3 data-result-title>{initialProtocol.title}</h3><p class="invitation" data-result-invitation>{initialProtocol.invitation}</p><div class="score"><div><b>Public door</b><p data-result-door>{initialDoor.name} · {initialDoor.city}</p></div><div><b>Watch</b><p data-result-watch>{initialWatch.label} · {initialWatch.time}</p></div><div><b>Bring</b><p data-result-bring>{initialProtocol.bring}</p></div><div><b>Do</b><p data-result-act>{initialProtocol.act}</p></div><div><b>Close</b><p data-result-close>{initialProtocol.close}</p></div><div><b>Never</b><p data-result-never>{initialProtocol.never}</p></div></div><div class="timer-panel"><div class="timer-copy"><b>Ninety seconds of attention</b><span>Gesture-started · one brief bell · no microphone</span></div><div class="clock"><strong data-clock>01:30</strong><button type="button" data-timer>Begin + bell</button></div></div><div class="score-actions"><button type="button" data-primary data-copy-score>Copy the score</button><button type="button" data-save-score>Keep this score</button><button type="button" data-erase-score>Erase saved score</button></div><p class="status" data-status>Page memory only. Nothing has been saved or posted.</p></article>
    </div>
  </section>

  <section class="section paper"><div class="section-head"><div><p class="kicker">02 · The twelve</p><h2>The object is not <em>the shrine.</em></h2></div><p>The shrine is the quality of attention between arrival and departure. Each score names one act, one close, and one boundary.</p></div><div class="protocols">{SHRINE_PROTOCOLS.map(p=><article class="protocol"><header><span>{p.number}</span><span>{p.family}</span></header><div class="mark" aria-hidden="true">{p.mark}</div><h3>{p.title}</h3><p>{p.invitation}</p><dl><dt>Bring</dt><dd>{p.bring}</dd><dt>Clean close</dt><dd>{p.close}</dd></dl><button type="button" data-use-protocol={p.id}>Use this score →</button></article>)}</div></section>

  <section class="section blue"><div class="section-head"><div><p class="kicker">03 · Reality lanes</p><h2>Attention is free. <em>Setup is not.</em></h2></div><p>A personal, attended interval is different from a public program. The more organized, built, promoted, or persistent the idea becomes, the earlier the operating steward belongs in the conversation.</p></div><div class="lanes">{SHRINE_LANES.map(l=><article class="lane"><small>{l.number}</small><h3>{l.title}</h3><p>{l.test}</p><b>Next move</b><strong>{l.move}</strong></article>)}</div></section>

  <section class="close-grid deep"><div class="close-title"><p class="kicker">04 · The operating vow</p><h2>The proof is the <em>clean close.</em></h2></div><div class="rules">{SHRINE_BOUNDARIES.map(r=><div class="rule">{r}</div>)}<button class="clean-button" type="button" data-clean-close aria-pressed="false">Count out · mark this score closed</button><p class="status" data-close-status>Honor system only. No attendance or completion is transmitted.</p></div></section>

  <section class="section paper"><div class="section-head"><div><p class="kicker">05 · Source desk</p><h2>Ritual language. <em>Official doors.</em></h2></div><p>The concept is editorial. These current official sources define the practical lanes; posted rules, closures, staff direction, permits, access conditions, and protected-area requirements control.</p></div><div class="sources">{SHRINE_SOURCES.map(s=><a class="source" href={s.url} rel="noreferrer"><strong>{s.label}</strong><span>{s.note}</span><small>Open official source ↗</small></a>)}</div><p class="boundary-note">Independent PointCast editorial · not a scheduled event, memorial, installation, reservation, permit, partnership, restoration, public-art approval, invitation to gather, or guarantee of access · sources checked August 3, 2026.</p></section>

  <footer class="end"><div><p class="kicker">Beach Commons · Field Companion 018.E · Block 0562</p><h2>The offering is <em>attention.</em></h2><p>Bring less. Notice more. Host the interval. Carry the whole construction home.</p><div class="end-links"><a href="#composer">Build another score</a><a href="/beach-commons/v18/passport">Choose a public door</a><a href="/beach-commons/v18/shrines.json">Open JSON</a><a href="/b/0562">Open Block 0562</a><a href="/beach-commons">All editions</a></div></div></footer>
</main>
<script>
  const root=document.querySelector('#composer');
  if(root){
    const protocols=JSON.parse(root.dataset.protocols||'[]'),doors=JSON.parse(root.dataset.doors||'[]'),watches=JSON.parse(root.dataset.watches||'[]'),companies=JSON.parse(root.dataset.companies||'[]');
    const pSel=root.querySelector('[data-shrine-select]'),dSel=root.querySelector('[data-door-select]'),wSel=root.querySelector('[data-watch-select]'),cSel=root.querySelector('[data-company-select]');
    const status=root.querySelector('[data-status]'),storageKey='pointcast.shrine25.v1';let timerId=null,remaining=90;
    const put=(q,v)=>{const e=root.querySelector(q);if(e)e.textContent=v};
    const current=()=>({protocol:protocols.find(x=>x.id===pSel.value)||protocols[0],door:doors.find(x=>x.id===dSel.value)||doors[0],watch:watches.find(x=>x.id===wSel.value)||watches[0],company:companies.find(x=>x.id===cSel.value)||companies[0]});
    const lane=(company)=>company.id==='circle'?'Hosted gathering':'Pocket shrine';
    const scoreText=()=>{const {protocol:p,door:d,watch:w,company:c}=current();return `SHRINE/25 — ${p.title}\nPublic door: ${d.name} · ${d.city}\nWatch: ${w.label} · ${w.time}\nCompany: ${c.label} · ${c.range}\nBring: ${p.bring}\nDo: ${p.act}\nClose: ${p.close}\nNever: ${p.never}\nLane: ${lane(c)}. ${c.instruction}\nCheck: ${d.check}\nOfficial source: ${d.source}\n\nThe offering is attention. The proof is the clean close. Nothing left behind.\nIndependent editorial score — not a permit, reservation, event, installation, or live-condition check.`};
    const update=()=>{const {protocol:p,door:d,watch:w,company:c}=current();put('[data-result-mark]',p.mark);put('[data-result-title]',p.title);put('[data-result-invitation]',p.invitation);put('[data-result-door]',`${d.name} · ${d.city}`);put('[data-result-watch]',`${w.label} · ${w.time}`);put('[data-result-bring]',p.bring);put('[data-result-act]',p.act);put('[data-result-close]',p.close);put('[data-result-never]',p.never);put('[data-lane-badge]',lane(c));status.textContent=`${c.instruction} Page memory only until you choose Keep this score.`;};
    [pSel,dSel,wSel,cSel].forEach(s=>s.addEventListener('change',update));
    document.querySelectorAll('[data-use-protocol]').forEach(b=>b.addEventListener('click',()=>{pSel.value=b.dataset.useProtocol;update();root.scrollIntoView({behavior:'smooth'});}));
    root.querySelector('[data-copy-score]').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(scoreText());status.textContent='Score copied by your request. Nothing posted.';}catch{status.textContent='Copy was unavailable in this browser. Nothing was transmitted.';}});
    root.querySelector('[data-save-score]').addEventListener('click',()=>{const {protocol,door,watch,company}=current();localStorage.setItem(storageKey,JSON.stringify({protocol:protocol.id,door:door.id,watch:watch.id,company:company.id,savedAt:new Date().toISOString()}));status.textContent='One score saved on this browser. Nothing posted.';});
    root.querySelector('[data-erase-score]').addEventListener('click',()=>{localStorage.removeItem(storageKey);status.textContent='Saved score erased from this browser.';});
    const drawClock=()=>put('[data-clock]',`${String(Math.floor(remaining/60)).padStart(2,'0')}:${String(remaining%60).padStart(2,'0')}`);
    const bell=()=>{const C=window.AudioContext||window.webkitAudioContext;if(!C)return;const ctx=new C(),gain=ctx.createGain(),osc=ctx.createOscillator();osc.type='sine';osc.frequency.setValueAtTime(523.25,ctx.currentTime);gain.gain.setValueAtTime(.0001,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(.11,ctx.currentTime+.025);gain.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+1.35);osc.connect(gain).connect(ctx.destination);osc.start();osc.stop(ctx.currentTime+1.4);setTimeout(()=>ctx.close(),1700);};
    root.querySelector('[data-timer]').addEventListener('click',e=>{if(timerId){clearInterval(timerId);timerId=null;remaining=90;drawClock();e.currentTarget.textContent='Begin + bell';return;}bell();remaining=90;drawClock();e.currentTarget.textContent='Stop + reset';timerId=setInterval(()=>{remaining-=1;drawClock();if(remaining<=0){clearInterval(timerId);timerId=null;e.currentTarget.textContent='Begin again + bell';status.textContent='The interval is complete. Close deliberately.';}},1000);});
    try{const saved=JSON.parse(localStorage.getItem(storageKey)||'null');if(saved){pSel.value=saved.protocol;dSel.value=saved.door;wSel.value=saved.watch;cSel.value=saved.company;update();status.textContent='Saved score restored from this browser. Nothing posted.';}}catch{}
  }
  const closeButton=document.querySelector('[data-clean-close]'),closeStatus=document.querySelector('[data-close-status]');
  closeButton?.addEventListener('click',()=>{const isClosed=closeButton.dataset.closed==='true';closeButton.dataset.closed=String(!isClosed);closeButton.setAttribute('aria-pressed',String(!isClosed));closeButton.textContent=isClosed?'Count out · mark this score closed':'✓ Score closed · nothing left behind';if(closeStatus)closeStatus.textContent=isClosed?'Honor system only. No attendance or completion is transmitted.':'Closed in this page only. No attendance, location, identity, or completion was transmitted.';});
</script>
</body></html>
