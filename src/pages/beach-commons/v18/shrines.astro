    .section{padding:clamp(76px,10vw,150px) var(--gutter)}.deep{background:var(--night);color:var(--cream)}.paper{background:var(--paper)}.blue{background:var(--blue);color:var(--cream)}.section-head{display:grid;margin-bottom:clamp(42px,6vw,86px);grid-template-columns:minmax(250px,.72fr) minmax(0,1.28fr);gap:48px}.section-head h2{max-width:860px;margin:0;font-size:clamp(50px,7.1vw,108px);font-weight:850;letter-spacing:-.075em;line-height:.83}.section-head>p{align-self:end;max-width:720px;margin:0;font-size:clamp(19px,2.1vw,30px);letter-spacing:-.03em;line-height:1.22}.section-head small{display:block;margin-top:18px;font:650 10px/1.55 var(--mono);text-transform:uppercase}
    .composer{display:grid;border:1px solid #ffffff55;grid-template-columns:.7fr 1.3fr}.controls{padding:clamp(24px,4vw,52px);border-right:1px solid #ffffff45}.controls label{display:block;margin:0 0 23px}.label{display:block;margin-bottom:9px;color:var(--sun);font:760 9px/1.35 var(--mono);letter-spacing:.08em;text-transform:uppercase}.controls select{width:100%;border:1px solid #ffffff5a;border-radius:0;padding:14px;background:transparent;color:var(--cream)}.controls option{color:var(--ink)}.result{position:relative;display:flex;min-height:690px;flex-direction:column;padding:clamp(30px,5vw,70px);overflow:hidden}.result:after{position:absolute;right:-150px;bottom:-210px;width:520px;aspect-ratio:1;border:2px solid var(--active,var(--copper));border-radius:50%;box-shadow:0 0 0 50px var(--night),0 0 0 52px var(--active,var(--copper));content:"";opacity:.55}.result>*{position:relative;z-index:2}.result-top{display:flex;justify-content:space-between;gap:20px}.result-mark{color:var(--active,var(--copper));font:400 clamp(84px,11vw,150px)/.72 Georgia,serif}.route-badge{align-self:start;border:1px solid var(--sun);padding:9px;color:var(--sun);font:780 9px/1 var(--mono);text-transform:uppercase}.result h3{max-width:9ch;margin:40px 0 15px;font-size:clamp(48px,7vw,105px);letter-spacing:-.075em;line-height:.82}.invitation{max-width:720px;margin:0;color:#ffffffa7;font:italic clamp(21px,2.6vw,36px)/1.2 Georgia,serif}.score{display:grid;max-width:800px;margin-top:45px;border-top:1px solid #ffffff48;grid-template-columns:repeat(2,1fr)}.score div{padding:18px 18px 18px 0;border-bottom:1px solid #ffffff36}.score div:nth-child(odd){border-right:1px solid #ffffff36}.score div:nth-child(even){padding-left:18px}.score b{display:block;margin-bottom:8px;color:var(--sun);font:760 9px/1 var(--mono);text-transform:uppercase}.score p{margin:0;color:#ffffffcf;font-size:14px;line-height:1.45}.score-actions{display:flex;flex-wrap:wrap;margin-top:auto;padding-top:32px;gap:8px}.score-actions button{border:1px solid #ffffff78;padding:13px 15px;background:transparent;color:var(--cream);font:760 9px/1 var(--mono);text-transform:uppercase}.score-actions button[data-primary]{border-color:var(--sun);background:var(--sun);color:var(--ink)}.status{min-height:1.5em;margin:13px 0 0;color:#ffffff82;font:620 9px/1.5 var(--mono);text-transform:uppercase}
    .timer-panel{display:grid;margin-top:28px;border:1px solid #ffffff45;grid-template-columns:1fr auto;align-items:center}.timer-copy{padding:20px}.timer-copy b{display:block;font-size:19px}.timer-copy span{color:#ffffff82;font:640 9px/1.5 var(--mono);text-transform:uppercase}.clock{min-width:152px;padding:20px;border-left:1px solid #ffffff45;text-align:center}.clock strong{display:block;font:800 42px/1 var(--mono)}.clock button{margin-top:11px;border:0;border-bottom:1px solid var(--sun);padding:0;background:transparent;color:var(--sun);font:740 9px/1.4 var(--mono);text-transform:uppercase}
    .protocols{display:grid;border-top:1px solid var(--line);border-left:1px solid var(--line);grid-template-columns:repeat(3,1fr)}.protocol{display:flex;min-height:460px;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:25px}.protocol header{display:flex;justify-content:space-between;color:var(--copper);font:780 10px/1 var(--mono)}.protocol .mark{margin:55px 0 26px;font:400 72px/1 Georgia,serif}.protocol h3{margin:0 0 16px;font-size:clamp(30px,3.2vw,47px);letter-spacing:-.058em;line-height:.93}.protocol>p{margin:0;font:italic 18px/1.3 Georgia,serif}.protocol dl{margin:auto 0 0;padding-top:26px}.protocol dt{margin-top:15px;color:var(--copper);font:780 8px/1 var(--mono);text-transform:uppercase}.protocol dd{margin:7px 0 0;font-size:12px;line-height:1.45}.protocol button{align-self:start;margin-top:20px;border:0;border-bottom:1px solid;padding:0;background:transparent;color:var(--ink);font:760 9px/1.4 var(--mono);text-transform:uppercase}
    .lanes{display:grid;border-top:1px solid #ffffff47;grid-template-columns:repeat(4,1fr)}.lane{min-height:430px;border-right:1px solid #ffffff3d;border-bottom:1px solid #ffffff3d;padding:24px}.lane:last-child{border-right:0}.lane small{color:var(--sun);font:760 9px/1 var(--mono)}.lane h3{margin:60px 0 20px;font-size:clamp(28px,3vw,44px);letter-spacing:-.055em;line-height:.95}.lane p{color:#ffffffb0;font-size:14px;line-height:1.5}.lane b{display:block;margin-top:27px;color:var(--sun);font:780 9px/1 var(--mono);text-transform:uppercase}.lane strong{display:block;margin-top:9px;font-size:13px;line-height:1.45}
    .close-grid{display:grid;grid-template-columns:.62fr 1.38fr}.close-title{padding:clamp(55px,8vw,110px) var(--gutter);border-right:1px solid #ffffff42}.close-title h2{max-width:7ch;margin:0;font-size:clamp(62px,9vw,138px);letter-spacing:-.085em;line-height:.75}.close-title h2 em{color:var(--sun);font-family:Georgia,serif;font-weight:400}.rules{padding:clamp(55px,8vw,110px) var(--gutter);counter-reset:rule}.rule{position:relative;border-top:1px solid #ffffff45;padding:19px 0 19px 55px;color:#ffffffca;font-size:clamp(16px,1.7vw,23px);line-height:1.35;counter-increment:rule}.rule:before{position:absolute;left:0;color:var(--sun);font:760 9px/1.6 var(--mono);content:counter(rule,decimal-leading-zero)}.clean-button{width:100%;margin-top:30px;border:1px solid var(--sun);padding:18px;background:transparent;color:var(--sun);font:800 10px/1 var(--mono);text-transform:uppercase}.clean-button[data-closed="true"]{background:var(--sun);color:var(--ink)}
    .sources{display:grid;border-top:1px solid var(--line);grid-template-columns:repeat(2,1fr)}.source{min-height:170px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:22px;text-decoration:none}.source:nth-child(even){border-right:0}.source span{display:block;margin-top:12px;font-size:13px;line-height:1.45}.source small{display:block;margin-top:18px;color:var(--copper);font:760 9px/1 var(--mono);text-transform:uppercase}.boundary-note{margin:30px 0 0;padding:20px;border:1px solid var(--line);font:630 10px/1.6 var(--mono);text-transform:uppercase}
    .end{display:grid;min-height:85svh;place-items:end start;background:radial-gradient(circle at 75% 35%,#6a3928 0 5%,#251815 20%,#090b0b 52%);color:var(--cream)}.end>div{padding:clamp(70px,10vw,150px) var(--gutter)}.end h2{max-width:1060px;margin:0;font-size:clamp(68px,10.5vw,158px);letter-spacing:-.09em;line-height:.76}.end h2 em{color:var(--copper);font-family:Georgia,serif;font-weight:400}.end p{max-width:700px;font-size:clamp(20px,2.4vw,34px);line-height:1.2}.end-links{display:flex;flex-wrap:wrap;gap:9px}.end-links a{border:1px solid #ffffff73;padding:13px 16px;font:760 9px/1 var(--mono);text-decoration:none;text-transform:uppercase}
    @keyframes breathe{50%{transform:scale(.965);box-shadow:0 0 120px #d5754255,inset 0 0 90px #d5754238}}@keyframes turn{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.halo,.orbit{animation:none}}
    @media(max-width:980px){.protocols{grid-template-columns:repeat(2,1fr)}.lanes{grid-template-columns:repeat(2,1fr)}.lane:nth-child(2){border-right:0}}
    @media(max-width:760px){.nav>span{display:none}.navlinks{gap:10px}.navlinks a:nth-child(2){display:none}.hero,.thesis,.section-head,.composer,.close-grid{grid-template-columns:1fr}.hero{min-height:0}.hero-copy{min-height:660px}.halo-field{min-height:75svh}.thesis b,.controls,.close-title{border-right:0;border-bottom:1px solid #ffffff35}.protocols,.lanes,.sources{grid-template-columns:1fr}.protocol,.lane,.source{border-right:0}.score{grid-template-columns:1fr}.score div:nth-child(odd){border-right:0}.score div:nth-child(even){padding-left:0}.timer-panel{grid-template-columns:1fr}.clock{border-top:1px solid #ffffff45;border-left:0}.result{min-height:800px}}
  </style>
