    .hero{display:grid;min-height:calc(100svh - 58px);grid-template-columns:minmax(0,.92fr) minmax(480px,1.08fr);background:var(--night);color:var(--cream)}.hero-copy{display:flex;min-width:0;flex-direction:column;justify-content:space-between;padding:clamp(56px,8vw,124px) var(--gutter) clamp(40px,6vw,84px)}.kicker,.eyebrow{margin:0 0 20px;font:780 10px/1.5 var(--mono);letter-spacing:.1em;text-transform:uppercase}.hero h1{max-width:6.7ch;margin:0;font-size:clamp(72px,10.4vw,164px);font-weight:900;letter-spacing:-.085em;line-height:.74;text-transform:uppercase}.hero h1 em{display:block;margin-top:.26em;color:var(--copper);font-family:Georgia,serif;font-size:.34em;font-weight:400;letter-spacing:-.03em;line-height:.95;text-transform:none}.dek{max-width:720px;margin:clamp(40px,5vw,72px) 0 0;color:#ffffffbb;font-size:clamp(22px,2.7vw,41px);font-weight:550;letter-spacing:-.043em;line-height:1.04}.hero-facts{display:grid;margin-top:44px;border-top:1px solid #ffffff38;grid-template-columns:repeat(3,1fr)}.hero-facts span{padding:16px 8px 0 0;color:#ffffff94;font:700 9px/1.35 var(--mono);text-transform:uppercase}.hero-facts b{display:block;margin-bottom:5px;color:var(--cream);font:900 25px/1 var(--sans)}
