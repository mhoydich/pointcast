---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import {
  DAY_RECIPES,
  FIELD_ETIQUETTE,
  OPEN_AIR_COMMONS,
  OUTDOOR_ARCS,
  OUTDOOR_GAMES,
  OUTDOOR_MODES,
  OUTDOOR_RESETS,
  OUTDOOR_RESOURCES,
  SOURCE_DESK,
} from '../../../lib/radius25-outdoors';

const canonical = OPEN_AIR_COMMONS.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0554.png';
const modeMap = new Map(OUTDOOR_MODES.map((mode) => [mode.id, mode]));
const arcMap = new Map(OUTDOOR_ARCS.map((arc) => [arc.id, arc]));
const arcCounts = OUTDOOR_ARCS.map((arc) => ({
  ...arc,
  count: OUTDOOR_RESOURCES.filter((resource) => resource.arc === arc.id).length,
}));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${OPEN_AIR_COMMONS.title} — ${OPEN_AIR_COMMONS.subtitle}`,
  description: OPEN_AIR_COMMONS.dek,
  url: canonical,
  image: socialImage,
  datePublished: OPEN_AIR_COMMONS.publishedAt,
  dateModified: OPEN_AIR_COMMONS.updatedAt,
  creator: [
    { '@type': 'Person', name: 'Michael Hoydich' },
    { '@type': 'Organization', name: 'Codex / OpenAI' },
  ],
  isPartOf: { '@type': 'CreativeWork', name: 'Radius 25 — Beach Commons Field Study 018', url: 'https://pointcast.xyz/beach-commons/v18' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: OUTDOOR_RESOURCES.length,
    itemListElement: OUTDOOR_RESOURCES.map((resource, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: resource.name,
      url: resource.source,
    })),
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={OPEN_AIR_COMMONS.dek} />
    <meta name="theme-color" content="#f3a83b" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/beach-commons/v18/outdoors.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="OPEN/25 — The Open-Air Commons" />
    <meta property="og:description" content={OPEN_AIR_COMMONS.dek} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OPEN/25 — The Open-Air Commons" />
    <meta name="twitter:description" content="25 public doors. 12 games. Make one good outside day." />
    <meta name="twitter:image" content={socialImage} />
    <title>OPEN/25 — The Open-Air Commons · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <style>
      :root {
        color-scheme: light;
        --paper: #f3ecda;
        --paper-light: #fffaf0;
        --paper-deep: #ded4bc;
        --ink: #25353a;
        --asphalt: #303a3c;
        --ocean: #287f9a;
        --pool: #8fc8cc;
        --eucalyptus: #5f8067;
        --court: #d86243;
        --sun: #f3a83b;
        --sand: #d8bf8d;
        --line: rgb(37 53 58 / 24%);
        --white: #fffdf7;
        --gutter: clamp(18px, 4vw, 66px);
        --sans: "Inter Variable", Inter, Arial, sans-serif;
        --mono: "JetBrains Mono Variable", monospace;
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; scroll-behavior: smooth; background: var(--asphalt); }
      body { min-width: 320px; margin: 0; overflow-x: hidden; background: var(--paper); color: var(--ink); font-family: var(--sans); }
      a { color: inherit; }
      button, input, select { color: inherit; font: inherit; }
      button { cursor: pointer; }
      :focus-visible { outline: 3px solid var(--sun); outline-offset: 4px; }
      ::selection { background: var(--sun); color: var(--asphalt); }

      .skip { position: fixed; z-index: 300; top: 10px; left: 10px; padding: 12px 15px; background: var(--sun); color: var(--asphalt); font: 800 10px/1 var(--mono); text-decoration: none; text-transform: uppercase; transform: translateY(-180%); }
      .skip:focus { transform: none; }
      .nav { position: sticky; z-index: 100; top: 0; display: grid; min-height: 58px; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid #ffffff32; padding: 0 var(--gutter); background: #303a3cf0; color: var(--white); backdrop-filter: blur(14px); }
      .nav a { font: 780 10px/1 var(--mono); letter-spacing: .07em; text-decoration: none; text-transform: uppercase; }
      .brand { font-family: var(--sans) !important; font-size: 13px !important; font-weight: 900 !important; letter-spacing: .16em !important; }
      .nav > span { color: #ffffff9e; font: 650 10px/1 var(--mono); text-transform: uppercase; }
      .nav-links { display: flex; justify-self: end; gap: 18px; }

      .hero { display: grid; min-height: calc(100svh - 58px); grid-template-columns: minmax(0, .9fr) minmax(440px, 1.1fr); background: var(--sun); }
      .hero-copy { display: flex; min-width: 0; flex-direction: column; justify-content: space-between; padding: clamp(50px, 7vw, 110px) var(--gutter) clamp(34px, 5vw, 70px); }
      .kicker { margin: 0 0 18px; font: 820 10px/1.45 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
      .hero h1 { max-width: 6.2ch; margin: 0; font-size: clamp(78px, 11vw, 176px); font-weight: 940; letter-spacing: -.095em; line-height: .73; text-transform: uppercase; }
      .hero h1 span { display: block; margin-top: .25em; font-family: Georgia, serif; font-size: .27em; font-style: italic; font-weight: 400; letter-spacing: -.035em; line-height: 1; text-transform: none; }
      .dek { max-width: 650px; margin: clamp(34px, 5vw, 74px) 0 0; font-size: clamp(23px, 2.8vw, 43px); font-weight: 650; letter-spacing: -.047em; line-height: 1.02; }
      .facts { display: grid; margin-top: 40px; border-top: 1px solid #25353a55; grid-template-columns: repeat(4, 1fr); }
      .facts span { padding: 16px 10px 0 0; font: 700 9px/1.35 var(--mono); text-transform: uppercase; }
      .facts b { display: block; margin-bottom: 5px; font: 900 23px/1 var(--sans); }

      .field-map { position: relative; display: flex; min-height: 650px; flex-direction: column; justify-content: space-between; overflow: hidden; padding: clamp(38px, 5vw, 70px); background: var(--asphalt); color: var(--white); }
      .field-map:before, .field-map:after { position: absolute; border: 1px solid #fff5; border-radius: 50%; content: ""; }
      .field-map:before { width: min(66vw, 740px); aspect-ratio: 1; top: 50%; left: 52%; transform: translate(-50%, -50%); }
      .field-map:after { width: min(38vw, 430px); aspect-ratio: 1; top: 50%; left: 52%; border-color: #f3a83b99; transform: translate(-50%, -50%); }
      .map-top, .map-bottom { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: start; gap: 30px; }
      .map-top strong { max-width: 9ch; font-size: clamp(44px, 6vw, 86px); letter-spacing: -.07em; line-height: .84; }
      .map-top p { max-width: 260px; margin: 0; color: #fff9; font: 650 10px/1.5 var(--mono); text-transform: uppercase; }
      .arcs { position: relative; z-index: 3; display: grid; border-top: 1px solid #ffffff45; border-left: 1px solid #ffffff45; grid-template-columns: repeat(2, 1fr); }
      .arc { min-height: 105px; border-right: 1px solid #ffffff45; border-bottom: 1px solid #ffffff45; padding: 15px; background: #303a3cda; }
      .arc b { color: var(--sun); font: 900 22px/1 var(--sans); }
      .arc strong { display: block; margin: 8px 0 4px; font-size: 13px; }
      .arc small { color: #fffa; font: 600 9px/1.4 var(--mono); }
      .map-bottom { align-items: end; }
      .map-bottom span { font: 750 9px/1.4 var(--mono); text-transform: uppercase; }
      .map-bottom b { color: var(--sun); }

      .premise { display: grid; grid-template-columns: .55fr 1.45fr; background: var(--pool); }
      .premise > b { padding: clamp(32px, 5vw, 70px) var(--gutter); border-right: 1px solid #25353a40; font: 820 11px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .premise p { margin: 0; padding: clamp(32px, 5vw, 70px) var(--gutter); font-size: clamp(34px, 5.3vw, 82px); font-weight: 850; letter-spacing: -.068em; line-height: .93; }
      .premise em, .section-head em, .closing em { color: var(--court); font-family: Georgia, serif; font-weight: 400; }

      .section { padding: clamp(74px, 10vw, 150px) var(--gutter); }
      .dark { background: var(--asphalt); color: var(--white); }
      .eucalyptus { background: var(--eucalyptus); color: var(--white); }
      .soft { background: var(--paper-deep); }
      .section-head { display: grid; margin-bottom: clamp(40px, 6vw, 82px); grid-template-columns: minmax(220px, .68fr) minmax(0, 1.32fr); gap: 42px; }
      .section-head h2 { max-width: 900px; margin: 0; font-size: clamp(50px, 7.3vw, 110px); font-weight: 900; letter-spacing: -.078em; line-height: .83; }
      .section-head > p { align-self: end; max-width: 720px; margin: 0; font-size: clamp(19px, 2vw, 29px); letter-spacing: -.03em; line-height: 1.2; }

      .modes { display: grid; border-top: 1px solid; border-left: 1px solid; grid-template-columns: repeat(4, 1fr); }
      .mode { position: relative; min-height: 285px; border-right: 1px solid; border-bottom: 1px solid; padding: 24px; }
      .mode:before { position: absolute; top: 0; right: 0; width: 56px; height: 9px; background: var(--c); content: ""; }
      .mode small { color: #ffffff9e; font: 750 9px/1 var(--mono); }
      .mode b { display: block; margin: 45px 0 10px; color: var(--c); font: 700 38px/1 var(--mono); }
      .mode h3 { margin: 0; font-size: clamp(28px, 3vw, 44px); letter-spacing: -.06em; }
      .mode p { margin: 18px 0 0; color: #fffc; font-size: 14px; line-height: 1.5; }

      .directory-tools { position: sticky; z-index: 20; top: 58px; display: grid; grid-template-columns: 1fr auto; gap: 14px; border: 1px solid var(--line); padding: 16px; background: #f3ecdaf2; backdrop-filter: blur(14px); }
      .directory-tools input, .directory-tools select { min-height: 45px; border: 1px solid var(--line); border-radius: 0; padding: 10px 12px; background: var(--paper-light); }
      .tool-main { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(180px, .45fr); gap: 10px; }
      .mode-filters { display: flex; grid-column: 1 / -1; flex-wrap: wrap; gap: 7px; }
      .filter { border: 1px solid var(--line); padding: 10px 12px; background: transparent; font: 780 9px/1 var(--mono); text-transform: uppercase; }
      .filter[aria-pressed="true"] { border-color: var(--asphalt); background: var(--asphalt); color: var(--white); }
      .result-count { display: flex; min-width: 100px; align-items: center; justify-content: center; background: var(--sun); font: 820 10px/1.4 var(--mono); text-align: center; text-transform: uppercase; }
      .resource-grid { display: grid; margin-top: 26px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); grid-template-columns: repeat(3, 1fr); }
      .resource { display: flex; min-height: 480px; flex-direction: column; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 24px; background: var(--paper-light); }
      .resource[hidden] { display: none; }
      .resource-top { display: flex; justify-content: space-between; gap: 16px; color: var(--court); font: 750 9px/1.35 var(--mono); text-transform: uppercase; }
      .resource h3 { margin: 50px 0 10px; font-size: clamp(29px, 3vw, 47px); letter-spacing: -.063em; line-height: .91; }
      .surface { margin: 0; color: var(--ocean); font: 780 10px/1.4 var(--mono); text-transform: uppercase; }
      .use { margin: 23px 0; font-size: 15px; line-height: 1.5; }
      .mode-tags { display: flex; flex-wrap: wrap; gap: 5px; }
      .mode-tags span { border: 1px solid var(--line); padding: 6px 7px; font: 740 8px/1 var(--mono); text-transform: uppercase; }
      .resource-bottom { margin-top: auto; padding-top: 23px; border-top: 1px solid var(--line); }
      .resource-bottom p { margin: 0 0 12px; font-size: 12px; line-height: 1.5; }
      .resource-bottom .check { color: #9b432e; }
      .resource-bottom a { display: inline-block; margin-top: 8px; font: 800 9px/1.3 var(--mono); text-decoration-thickness: 1px; text-underline-offset: 4px; text-transform: uppercase; }
      .empty { display: none; margin: 30px 0 0; padding: 30px; border: 1px dashed var(--line); font-size: 18px; }
      .empty[data-visible="true"] { display: block; }

      .maker { display: grid; border: 1px solid #ffffff48; grid-template-columns: minmax(0, .85fr) minmax(380px, 1.15fr); }
      .maker-form { display: grid; grid-template-columns: repeat(2, 1fr); }
      .field { display: flex; min-width: 0; flex-direction: column; gap: 9px; border-right: 1px solid #ffffff3c; border-bottom: 1px solid #ffffff3c; padding: 20px; }
      .field:nth-child(even) { border-right: 0; }
      .field label { color: #ffe08b; font: 800 9px/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
      .field select { width: 100%; min-height: 48px; border: 1px solid #ffffff58; border-radius: 0; padding: 11px; background: #ffffff0c; color: var(--white); }
      .field option { color: var(--asphalt); }
      .maker-actions { display: flex; grid-column: 1 / -1; flex-wrap: wrap; gap: 8px; padding: 20px; }
      .maker-actions button { border: 1px solid #ffffff65; padding: 14px 16px; background: transparent; color: var(--white); font: 800 9px/1 var(--mono); text-transform: uppercase; }
      .maker-actions .primary { border-color: var(--sun); background: var(--sun); color: var(--asphalt); }
      .maker-status { grid-column: 1 / -1; min-height: 38px; margin: 0; padding: 0 20px 20px; color: #fffb; font: 650 10px/1.45 var(--mono); }
      .day-card { position: relative; display: flex; min-height: 650px; flex-direction: column; justify-content: space-between; padding: clamp(28px, 4vw, 58px); background: var(--paper-light); color: var(--ink); }
      .day-card:before { position: absolute; top: 0; right: 0; width: 95px; height: 13px; background: var(--sun); content: ""; }
      .day-card small { color: var(--court); font: 800 9px/1.4 var(--mono); text-transform: uppercase; }
      .day-card h3 { max-width: 9ch; margin: 55px 0 12px; font-size: clamp(48px, 6vw, 92px); letter-spacing: -.08em; line-height: .82; }
      .day-card .place { margin: 0; color: var(--ocean); font: italic clamp(21px, 2.4vw, 34px)/1.2 Georgia, serif; }
      .day-sequence { margin: 42px 0; border-top: 1px solid var(--line); counter-reset: sequence; }
      .day-sequence li { display: grid; grid-template-columns: 38px 1fr; border-bottom: 1px solid var(--line); padding: 13px 0; counter-increment: sequence; }
      .day-sequence li:before { color: var(--court); font: 800 9px/1.5 var(--mono); content: counter(sequence, decimal-leading-zero); }
      .day-detail { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
      .day-detail b { display: block; margin-bottom: 6px; color: var(--eucalyptus); font: 800 9px/1.2 var(--mono); text-transform: uppercase; }
      .day-detail p { margin: 0; font-size: 13px; line-height: 1.45; }
      .day-source { margin-top: 28px; padding-top: 15px; border-top: 1px solid var(--line); font: 650 9px/1.5 var(--mono); }

      .games { display: grid; border-top: 1px solid var(--line); border-left: 1px solid var(--line); grid-template-columns: repeat(3, 1fr); }
      .game { display: flex; min-height: 405px; flex-direction: column; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 24px; }
      .game small { color: var(--court); font: 780 9px/1 var(--mono); }
      .game h3 { margin: 44px 0 12px; font-size: clamp(29px, 3vw, 45px); letter-spacing: -.06em; line-height: .92; }
      .game-meta { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 20px; }
      .game-meta span { border: 1px solid var(--line); padding: 6px 7px; font: 740 8px/1 var(--mono); text-transform: uppercase; }
      .game p { margin: 0; font-size: 14px; line-height: 1.5; }
      .game .close { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line); color: var(--eucalyptus); font-weight: 700; }

      .resets { display: grid; border-top: 1px solid #ffffff55; grid-template-columns: repeat(3, 1fr); }
      .reset { min-height: 300px; border-right: 1px solid #ffffff45; border-bottom: 1px solid #ffffff45; padding: 24px; }
      .reset:nth-child(3n) { border-right: 0; }
      .reset small { color: #ffe08b; font: 780 9px/1 var(--mono); text-transform: uppercase; }
      .reset h3 { margin: 42px 0 18px; font-size: clamp(27px, 2.8vw, 42px); letter-spacing: -.055em; line-height: .94; }
      .reset p { margin: 0 0 18px; color: #fffd; font-size: 14px; line-height: 1.5; }
      .reset .option { color: #ffffff9e; font: 650 10px/1.5 var(--mono); }
      .safety-note { margin: 30px 0 0; padding: 20px; border: 1px solid #ffffff55; font: 650 11px/1.55 var(--mono); }

      .rules { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(40px, 7vw, 120px); }
      .rules h2 { max-width: 8ch; margin: 0; font-size: clamp(52px, 7vw, 106px); letter-spacing: -.075em; line-height: .82; }
      .rule-list { border-top: 1px solid var(--line); counter-reset: rule; }
      .rule { position: relative; border-bottom: 1px solid var(--line); padding: 22px 0 22px 65px; font-size: clamp(17px, 1.8vw, 25px); line-height: 1.3; counter-increment: rule; }
      .rule:before { position: absolute; left: 0; color: var(--court); font: 800 10px/1.5 var(--mono); content: counter(rule, decimal-leading-zero); }

      .sources { display: grid; border-top: 1px solid #ffffff45; border-left: 1px solid #ffffff45; grid-template-columns: repeat(5, 1fr); }
      .source { min-height: 260px; border-right: 1px solid #ffffff45; border-bottom: 1px solid #ffffff45; padding: 22px; text-decoration: none; }
      .source b { display: block; margin: 45px 0 16px; color: var(--sun); font-size: 20px; letter-spacing: -.03em; }
      .source p { margin: 0; color: #fffb; font-size: 13px; line-height: 1.5; }
      .source span { display: block; margin-top: 28px; font: 750 9px/1.3 var(--mono); text-transform: uppercase; }

      .closing { display: grid; min-height: 78svh; grid-template-columns: .75fr 1.25fr; background: var(--sun); }
      .closing-art { position: relative; min-height: 550px; overflow: hidden; background: var(--pool); }
      .closing-art:before { position: absolute; width: 88%; aspect-ratio: 1; top: 50%; left: 50%; border: 2px solid var(--asphalt); border-radius: 50%; content: ""; transform: translate(-50%, -50%); }
      .closing-art:after { position: absolute; width: 55%; aspect-ratio: 1; top: 50%; left: 50%; border: 2px solid var(--court); border-radius: 50%; content: ""; transform: translate(-50%, -50%); }
      .closing-art span { position: absolute; z-index: 2; top: 50%; left: 50%; font: 900 clamp(62px, 10vw, 150px)/.75 var(--sans); letter-spacing: -.1em; text-align: center; transform: translate(-50%, -50%); }
      .closing-copy { display: flex; flex-direction: column; justify-content: center; padding: var(--gutter); }
      .closing h2 { max-width: 9ch; margin: 0; font-size: clamp(56px, 8vw, 120px); letter-spacing: -.083em; line-height: .8; }
      .closing p { max-width: 620px; font-size: clamp(19px, 2vw, 29px); line-height: 1.3; }
      .links { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; }
      .links a { border: 1px solid var(--asphalt); padding: 13px 15px; font: 800 9px/1 var(--mono); text-decoration: none; text-transform: uppercase; }
      .links a:hover { background: var(--asphalt); color: var(--white); }

      @media (max-width: 1100px) {
        .resource-grid, .games { grid-template-columns: repeat(2, 1fr); }
        .sources { grid-template-columns: repeat(3, 1fr); }
        .maker { grid-template-columns: 1fr; }
      }
      @media (max-width: 820px) {
        .nav > span, .nav-links a:first-child { display: none; }
        .hero, .premise, .section-head, .rules, .closing { grid-template-columns: 1fr; }
        .hero { min-height: 0; }
        .hero-copy { min-height: 620px; }
        .field-map { min-height: 80svh; }
        .premise > b { border-right: 0; border-bottom: 1px solid #25353a40; }
        .modes, .resets { grid-template-columns: repeat(2, 1fr); }
        .reset:nth-child(3n) { border-right: 1px solid #ffffff45; }
        .reset:nth-child(even) { border-right: 0; }
        .directory-tools { position: static; }
      }
      @media (max-width: 620px) {
        .facts, .modes, .resource-grid, .games, .resets, .sources, .maker-form, .day-detail { grid-template-columns: 1fr; }
        .tool-main { grid-template-columns: 1fr; }
        .directory-tools { grid-template-columns: 1fr; }
        .result-count { min-height: 45px; }
        .mode, .resource, .game, .reset, .source, .field { border-right: 0; }
        .maker-actions, .maker-status { grid-column: auto; }
        .day-card { min-height: 720px; }
        .arcs { grid-template-columns: 1fr; }
        .map-top { flex-direction: column; }
      }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to open-air guide</a>
    <nav class="nav">
      <a class="brand" href="/">PointCast</a>
      <span>Radius 25 · Field Companion 018.C</span>
      <div class="nav-links"><a href="#make-a-day">Make me a day</a><a href="/beach-commons/v18">Radius 25</a></div>
    </nav>

    <main id="main">
      <header class="hero">
        <div class="hero-copy">
          <div>
            <p class="kicker">El Segundo center · roughly 25 miles · official public doors</p>
            <h1>OPEN/<br />25 <span>The Open-Air Commons</span></h1>
            <p class="dek">Find a public room. Bring one small game. <em>Let the day stay open.</em></p>
          </div>
          <div class="facts">
            <span><b>25</b>public doors</span><span><b>8</b>ways outside</span><span><b>12</b>small games</span><span><b>0</b>accounts</span>
          </div>
        </div>
        <div class="field-map" aria-label="Six editorial arcs containing 25 outdoor resource doors">
          <div class="map-top"><strong>One ring. Many public rooms.</strong><p>Not a venue promise. Not a reservation. Every door returns to its official steward.</p></div>
          <div class="arcs">
            {arcCounts.map((arc) => <div class="arc"><b>{String(arc.count).padStart(2, '0')}</b><strong>{arc.label}</strong><small>{arc.note}</small></div>)}
          </div>
          <div class="map-bottom"><span><b>Pacific</b> ← coast / court / garden / canyon → <b>inland</b></span><span>Editorial orientation only</span></div>
        </div>
      </header>

      <section class="premise"><b>The common plain</b><p>Southern California already has the rooms. <em>The design move is choosing well.</em></p></section>

      <section class="section dark">
        <div class="section-head"><div><p class="kicker">01 · Start with a verb</p><h2>What kind of outside?</h2></div><p>Not every day wants a hike. Sometimes the useful unit is one court, one lawn, one garden path, one sketch, one stretch, or a bench with a horizon.</p></div>
        <div class="modes">{OUTDOOR_MODES.map((mode) => <article class="mode" style={`--c:${mode.color}`}><small>{mode.number}</small><b>{mode.mark}</b><h3>{mode.label}</h3><p>{mode.prompt}</p></article>)}</div>
      </section>

      <section class="section" id="directory" data-directory>
        <div class="section-head"><div><p class="kicker">02 · Public resource index</p><h2>Twenty-five doors. <em>Check first.</em></h2></div><p>Every card points to the agency or operating steward that describes the place. OPEN/25 makes no claim about real-time access, parking, reservations, programs, closures, court availability, or conditions.</p></div>
        <div class="directory-tools">
          <div class="tool-main">
            <label><span class="kicker">Search places or uses</span><input type="search" placeholder="Try court, marsh, shade, art…" data-resource-search /></label>
            <label><span class="kicker">Choose an arc</span><select data-arc-filter><option value="all">All six arcs</option>{OUTDOOR_ARCS.map((arc) => <option value={arc.id}>{arc.label}</option>)}</select></label>
            <div class="mode-filters" aria-label="Filter by outdoor mode"><button class="filter" type="button" data-mode-filter="all" aria-pressed="true">All modes</button>{OUTDOOR_MODES.map((mode) => <button class="filter" type="button" data-mode-filter={mode.id} aria-pressed="false">{mode.label}</button>)}</div>
          </div>
          <output class="result-count" data-result-count>25 doors</output>
        </div>
        <div class="resource-grid">
          {OUTDOOR_RESOURCES.map((resource) => (
            <article class="resource" data-resource-card data-search={`${resource.name} ${resource.city} ${resource.surface} ${resource.use} ${resource.modes.join(' ')}`.toLowerCase()} data-arc={resource.arc} data-modes={resource.modes.join(' ')}>
              <div class="resource-top"><span>{resource.number} · {arcMap.get(resource.arc)?.label}</span><span>{resource.band}</span></div>
              <h3>{resource.name}</h3><p class="surface">{resource.city} · {resource.surface}</p><p class="use">{resource.use}</p>
              <div class="mode-tags">{resource.modes.map((mode) => <span>{modeMap.get(mode)?.label}</span>)}</div>
              <div class="resource-bottom"><p>{resource.officialNote}</p><p class="check"><strong>Check before leaving · </strong>{resource.check}</p><p><strong>Cost note · </strong>{resource.cost}</p><a href={resource.source} rel="noreferrer">Official source · {resource.sourceLabel} ↗</a></div>
            </article>
          ))}
        </div>
        <p class="empty" data-empty>No door matches that combination. Clear a filter and let the radius open again.</p>
      </section>

      <section class="section eucalyptus" id="make-a-day" data-day-maker data-recipes={JSON.stringify(DAY_RECIPES)} data-resources={JSON.stringify(OUTDOOR_RESOURCES)} data-games={JSON.stringify(OUTDOOR_GAMES)} data-resets={JSON.stringify(OUTDOOR_RESETS)}>
        <div class="section-head"><div><p class="kicker">03 · Local day composer</p><h2>Make me a day.</h2></div><p>Choose company, energy, texture, and time. The instrument returns one checked-in recipe and an official public door. It stores nothing and does not check live availability.</p></div>
        <div class="maker">
          <form class="maker-form" data-maker-form>
            <div class="field"><label for="company">Company</label><select id="company" data-company><option value="solo">Just me</option><option value="pair">A pair</option><option value="group">A small group</option></select></div>
            <div class="field"><label for="energy">Energy</label><select id="energy" data-energy><option value="soft">Soft</option><option value="move">Moving</option><option value="full">Full day energy</option></select></div>
            <div class="field"><label for="texture">Texture</label><select id="texture" data-texture><option value="coast">Coast</option><option value="court">Court</option><option value="field">Field</option><option value="art">Art + garden</option><option value="nature">Nature</option></select></div>
            <div class="field"><label for="day-time">Time</label><select id="day-time" data-time><option value="45">45 minutes</option><option value="120">About two hours</option><option value="half">Half day</option></select></div>
            <div class="maker-actions"><button class="primary" type="submit">Make this day →</button><button type="button" data-copy-day>Copy day card</button></div>
            <p class="maker-status" data-maker-status aria-live="polite">Ready. This page has not requested location, identity, storage, or live access.</p>
          </form>
          <article class="day-card" aria-live="polite">
            <div><small>OPEN/25 · Browser-local day card</small><h3 data-day-title>Soft Coast</h3><p class="place" data-day-place>Dockweiler State Beach · Playa del Rey</p><ol class="day-sequence" data-day-sequence><li>Arrive without a target</li><li>Take one short out-and-back</li><li>Make a three-layer sound postcard</li><li>Close on the longest view</li></ol></div>
            <div><div class="day-detail"><div><b>Easy reset</b><p data-day-reset>Long-view exhale · 60 sec</p></div><div><b>Small game</b><p data-day-game>Sound Postcard · 10 min</p></div></div><p class="day-source" data-day-source>Check the official source again before leaving. No access or availability is promised.</p></div>
          </article>
        </div>
      </section>

      <section class="section soft" id="games">
        <div class="section-head"><div><p class="kicker">04 · Public playbook</p><h2>Twelve games that know when to end.</h2></div><p>Low equipment, no elimination, no claim on the whole park. Each one has a clean closing move so a pleasant public experiment does not become an occupation.</p></div>
        <div class="games">{OUTDOOR_GAMES.map((game) => <article class="game"><small>{game.number}</small><h3>{game.title}</h3><div class="game-meta"><span>{game.people}</span><span>{game.time}</span><span>{game.kit}</span></div><p>{game.rule}</p><p class="close">Close · {game.close}</p></article>)}</div>
      </section>

      <section class="section dark" id="resets">
        <div class="section-head"><div><p class="kicker">05 · Arrival deck</p><h2>Six easy resets.</h2></div><p>These are ordinary recreational movement prompts, not a workout prescription or medical advice. Use a stable option, keep range comfortable, and skip anything that does not suit your body or conditions.</p></div>
        <div class="resets">{OUTDOOR_RESETS.map((reset, index) => <article class="reset"><small>{String(index + 1).padStart(2, '0')} · {reset.duration}</small><h3>{reset.title}</h3><p>{reset.instruction}</p><p class="option"><strong>Smaller option · </strong>{reset.option}</p></article>)}</div>
        <p class="safety-note">Stop for pain, dizziness, numbness, unusual shortness of breath, or loss of balance. Weather, heat, air quality, surface, mobility needs, hydration, medication, pregnancy, illness, injury, disability, and individual medical guidance can all change what is appropriate.</p>
      </section>

      <section class="section">
        <div class="rules"><div><p class="kicker">06 · The field agreement</p><h2>Public is shared.</h2></div><div class="rule-list">{FIELD_ETIQUETTE.map((rule) => <div class="rule">{rule}</div>)}</div></div>
      </section>

      <section class="section dark">
        <div class="section-head"><div><p class="kicker">07 · Source desk</p><h2>Return to the steward.</h2></div><p>Research checked August 2, 2026. OPEN/25 uses official city, county, state, and operating-conservancy pages. Each resource card keeps its own direct official link because conditions change faster than an editorial page.</p></div>
        <div class="sources">{SOURCE_DESK.map((source, index) => <a class="source" href={source.url} rel="noreferrer"><small>{String(index + 1).padStart(2, '0')}</small><b>{source.label}</b><p>{source.note}</p><span>Open official desk ↗</span></a>)}</div>
      </section>

      <footer class="closing">
        <div class="closing-art" aria-hidden="true"><span>25<br />mi</span></div>
        <div class="closing-copy"><p class="kicker">The open-air commons</p><h2>Do less. Notice more. <em>Leave it good.</em></h2><p>A public day can be designed without turning the public place into a private production: one official door, one small invitation, one fair game, one clean return.</p><div class="links"><a href="#make-a-day">Make another day</a><a href="#directory">Browse all 25</a><a href="/beach-commons/v18/outdoors.json">Open JSON</a><a href="/beach-commons/v18/engineering">ENG/25</a><a href="/beach-commons/v18/skills">Skill Line</a><a href="/beach-commons/v18">Radius 25</a></div></div>
      </footer>
    </main>

    <script>
      const directory = document.querySelector('[data-directory]');
      if (directory) {
        const search = directory.querySelector('[data-resource-search]');
        const arc = directory.querySelector('[data-arc-filter]');
        const buttons = [...directory.querySelectorAll('[data-mode-filter]')];
        const cards = [...directory.querySelectorAll('[data-resource-card]')];
        const count = directory.querySelector('[data-result-count]');
        const empty = directory.querySelector('[data-empty]');
        let mode = 'all';
        const update = () => {
          const query = (search?.value || '').trim().toLowerCase();
          const selectedArc = arc?.value || 'all';
          let visible = 0;
          cards.forEach((card) => {
            const matchesSearch = !query || (card.dataset.search || '').includes(query);
            const matchesArc = selectedArc === 'all' || card.dataset.arc === selectedArc;
            const matchesMode = mode === 'all' || (card.dataset.modes || '').split(' ').includes(mode);
            card.hidden = !(matchesSearch && matchesArc && matchesMode);
            if (!card.hidden) visible += 1;
          });
          if (count) count.textContent = `${visible} ${visible === 1 ? 'door' : 'doors'}`;
          if (empty) empty.dataset.visible = String(visible === 0);
        };
        search?.addEventListener('input', update);
        arc?.addEventListener('change', update);
        buttons.forEach((button) => button.addEventListener('click', () => {
          mode = button.dataset.modeFilter || 'all';
          buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
          update();
        }));
      }

      const maker = document.querySelector('[data-day-maker]');
      if (maker) {
        const recipes = JSON.parse(maker.dataset.recipes || '[]');
        const resources = JSON.parse(maker.dataset.resources || '[]');
        const games = JSON.parse(maker.dataset.games || '[]');
        const resets = JSON.parse(maker.dataset.resets || '[]');
        const get = (selector) => maker.querySelector(selector);
        const value = (selector) => get(selector)?.value || '';
        const put = (selector, text) => { const node = get(selector); if (node) node.textContent = text; };
        let current = null;

        const selectRecipe = (company, energy, texture, time) => recipes.find((recipe) =>
          recipe.company.includes(company) && recipe.energy.includes(energy) && recipe.texture.includes(texture) && recipe.time.includes(time)
        ) || recipes.find((recipe) => recipe.texture.includes(texture) && recipe.company.includes(company))
          || recipes.find((recipe) => recipe.texture.includes(texture)) || recipes[0];

        const render = () => {
          const company = value('[data-company]');
          const energy = value('[data-energy]');
          const texture = value('[data-texture]');
          const time = value('[data-time]');
          const recipe = selectRecipe(company, energy, texture, time);
          const seed = [company, energy, texture, time].join('').split('').reduce((sum, character) => sum + character.charCodeAt(0), 0);
          const resourceId = recipe.resourceIds[seed % recipe.resourceIds.length];
          const resource = resources.find((item) => item.id === resourceId) || resources[0];
          const game = games.find((item) => item.id === recipe.gameId) || games[0];
          const reset = resets.find((item) => item.id === recipe.resetId) || resets[0];
          current = { recipe, resource, game, reset, company, energy, texture, time };
          put('[data-day-title]', recipe.title);
          put('[data-day-place]', `${resource.name} · ${resource.city}`);
          const list = get('[data-day-sequence]');
          if (list) list.innerHTML = recipe.sequence.map((step) => `<li>${step}</li>`).join('');
          put('[data-day-reset]', `${reset.title} · ${reset.duration}`);
          put('[data-day-game]', `${game.title} · ${game.time}`);
          put('[data-day-source]', `Check first: ${resource.check} Official source: ${resource.sourceLabel}.`);
          put('[data-maker-status]', 'Day made in this page. Nothing was saved, sent, reserved, or checked live.');
          return current;
        };

        const dayText = () => {
          const day = current || render();
          return [
            `OPEN/25 · ${day.recipe.title}`,
            `${day.resource.name} · ${day.resource.city}`,
            '',
            ...day.recipe.sequence.map((step, index) => `${index + 1}. ${step}`),
            '',
            `Easy reset: ${day.reset.title} · ${day.reset.duration}`,
            `Small game: ${day.game.title} · ${day.game.time}`,
            `Check first: ${day.resource.check}`,
            `Official source: ${day.resource.source}`,
            '',
            'No reservation or access is implied. Recheck official conditions before leaving.',
            'https://pointcast.xyz/beach-commons/v18/outdoors',
          ].join('\n');
        };

        get('[data-maker-form]')?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
        get('[data-copy-day]')?.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(dayText()); put('[data-maker-status]', 'Day card copied. PointCast received nothing.'); }
          catch { put('[data-maker-status]', 'Clipboard access was blocked. The day remains visible in the card.'); }
        });
        render();
      }
    </script>
  </body>
</html>
