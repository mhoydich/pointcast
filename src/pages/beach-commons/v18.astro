const structuredData = {'@context':'https://schema.org','@type':'Article','@id':`${canonical}#article`,headline:'Radius 25 — Build the Combinations',alternativeHeadline:BEACH_COMMONS_V18.dek,url:canonical,image:socialImage,datePublished:BEACH_COMMONS_V18.publishedAt,dateModified:BEACH_COMMONS_V18.updatedAt,creator:BEACH_COMMONS_V18.creators.map(creator=>({'@type':creator.name.includes('Codex')?'Organization':'Person',name:creator.name})),isPartOf:{'@type':'CreativeWorkSeries',name:'Beach Commons',url:'https://pointcast.xyz/beach-commons'}};
