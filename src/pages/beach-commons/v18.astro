    .section{padding:clamp(72px,10vw,150px) var(--gutter)}.navy{background:var(--navy);color:var(--white)}.deep{background:var(--deep);color:var(--white)}.soft{background:var(--paper2)}.section-head{display:grid;margin-bottom:clamp(40px,6vw,84px);grid-template-columns:minmax(210px,.65fr) minmax(0,1.35fr);gap:40px}.section-head h2{max-width:900px;margin:0;font-size:clamp(50px,7.5vw,112px);font-weight:880;letter-spacing:-.075em;line-height:.82}.section-head>p{align-self:end;max-width:700px;margin:0;font-size:clamp(19px,2vw,29px);letter-spacing:-.025em;line-height:1.2}
