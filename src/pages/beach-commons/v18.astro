    .hero{display:grid;min-height:calc(100svh - 58px);grid-template-columns:minmax(0,.88fr) minmax(420px,1.12fr);background:var(--navy);color:var(--white)}.hero-copy{display:flex;min-width:0;flex-direction:column;justify-content:space-between;padding:clamp(48px,7vw,110px) var(--gutter) clamp(34px,5vw,72px)}.kicker{margin:0 0 18px;color:var(--yellow);font:750 10px/1.4 var(--mono);letter-spacing:.1em;text-transform:uppercase}.hero h1{max-width:7ch;margin:0;font-size:clamp(74px,10.4vw,166px);font-weight:900;letter-spacing:-.09em;line-height:.76;text-transform:uppercase}.hero h1 span{display:block;color:var(--yellow);font-family:Georgia,serif;font-size:.39em;font-style:italic;font-weight:400;letter-spacing:-.04em;line-height:1.05;text-transform:none}.dek{max-width:660px;margin:clamp(34px,5vw,74px) 0 0;font-size:clamp(23px,2.8vw,44px);font-weight:590;letter-spacing:-.045em;line-height:1.02}.dek em,.section-head em,.end em{color:var(--yellow);font-family:Georgia,serif;font-weight:400}.facts{display:grid;margin-top:40px;border-top:1px solid #ffffff40;grid-template-columns:repeat(4,1fr)}.facts span{padding:16px 12px 0 0;color:#fff9;font:650 9px/1.35 var(--mono);text-transform:uppercase}.facts b{display:block;margin-bottom:5px;color:var(--white);font:800 23px/1 var(--sans)}.hero-image{position:relative;min-height:620px;overflow:hidden}.hero-image img{width:100%;height:100%;object-fit:cover}.caption{position:absolute;right:24px;bottom:22px;left:24px;color:var(--white);font:650 9px/1.4 var(--mono);text-transform:uppercase;text-shadow:0 1px 8px #000}
