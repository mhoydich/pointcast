    .doors{display:grid;border-top:1px solid var(--line);grid-template-columns:repeat(2,1fr)}.door{display:grid;min-height:200px;grid-template-columns:65px 1fr;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:25px}.door:nth-child(even){border-right:0}.door>span{color:var(--orange);font:800 11px/1 var(--mono)}.door h3{margin:0;font-size:clamp(25px,2.8vw,42px);letter-spacing:-.05em;line-height:.98}.door strong{display:block;margin:12px 0 8px;color:var(--blue);font:750 10px/1.3 var(--mono);text-transform:uppercase}.door p{margin:0;font-size:15px;line-height:1.5}.radius-note{max-width:920px;margin:38px 0 0;padding-left:20px;border-left:4px solid var(--orange);font:650 12px/1.55 var(--mono)}
    .builder{display:grid;border:1px solid #ffffff40;grid-template-columns:.75fr .75fr 1.5fr}.column{border-right:1px solid #ffffff3d;padding:clamp(22px,3vw,40px)}.column:last-child{border-right:0}.label{display:block;margin-bottom:22px;color:var(--yellow);font:750 9px/1.3 var(--mono);letter-spacing:.08em;text-transform:uppercase}.choices{display:grid;gap:7px}.choice{border:1px solid #ffffff40;padding:12px;background:transparent;color:#fffb;cursor:pointer;text-align:left}.choice small{display:block;margin-top:4px;font:570 9px/1.35 var(--mono)}.choice[aria-pressed="true"]{border-color:var(--yellow);background:var(--yellow);color:var(--deep);font-weight:780}.result{background:var(--paper);color:var(--ink)}.result .label{color:var(--orange)}.result h3{margin:0;font-size:clamp(38px,4.7vw,72px);letter-spacing:-.065em;line-height:.9}.question{font:italic clamp(20px,2vw,28px)/1.25 Georgia,serif}.step{margin-top:20px;padding-top:16px;border-top:1px solid var(--line)}.step b{display:block;margin-bottom:7px;color:var(--orange);font:750 9px/1 var(--mono);text-transform:uppercase}.step p{margin:0;font-size:14px;line-height:1.48}.privacy{margin:0;border:1px solid #ffffff40;border-top:0;padding:14px 20px;color:#fff8;font:620 9px/1.45 var(--mono);text-transform:uppercase}
    .pairs{display:grid;border-top:1px solid var(--line);grid-template-columns:repeat(3,1fr)}.pair{display:flex;min-height:410px;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px}.pair:nth-child(3n){border-right:0}.pair small{color:var(--orange);font:750 10px/1 var(--mono);text-transform:uppercase}.pair h3{margin:45px 0 17px;font-size:clamp(28px,3vw,46px);letter-spacing:-.055em;line-height:.95}.pair>p{margin:0;font:italic 18px/1.32 Georgia,serif}.pair div{margin-top:auto;padding-top:26px}.pair div b{display:block;margin-bottom:8px;color:var(--blue);font:750 9px/1 var(--mono);text-transform:uppercase}.pair div p{margin:0;font-size:13px;line-height:1.48}
    .timeline{display:grid;grid-template-columns:repeat(4,1fr)}.phase{min-height:480px;border-top:1px solid #ffffff50;border-right:1px solid #ffffff38;padding:27px}.phase:last-child{border-right:0}.phase small{color:var(--yellow);font:760 10px/1 var(--mono)}.phase h3{margin:52px 0 22px;font-size:clamp(31px,3.2vw,49px);letter-spacing:-.06em;line-height:.92}.phase p{color:#fffb;font-size:15px;line-height:1.48}.phase .outcome{margin-top:30px;padding-top:20px;border-top:1px solid #ffffff38;color:var(--white)}
    .score{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(40px,7vw,120px)}.big strong{display:block;color:var(--orange);font-size:clamp(110px,18vw,250px);font-weight:900;letter-spacing:-.1em;line-height:.7}.big p{max-width:430px;font-size:18px;line-height:1.48}.score-list{border-top:1px solid var(--line)}.score-row{display:grid;grid-template-columns:70px .7fr 1.3fr;gap:20px;border-bottom:1px solid var(--line);padding:24px 0}.score-row b{color:var(--blue);font:800 20px/1 var(--mono)}.score-row p{margin:0;font-size:14px;line-height:1.45}
    .plates{display:grid;grid-template-columns:repeat(4,1fr)}.plate{position:relative;margin:0;overflow:hidden;aspect-ratio:2/3}.plate img{width:100%;height:100%;object-fit:cover}.plate figcaption{position:absolute;right:0;bottom:0;left:0;padding:50px 16px 15px;background:linear-gradient(transparent,#061a29e8);color:var(--white);font:700 9px/1.3 var(--mono);text-transform:uppercase}.rules{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(40px,7vw,120px)}.rules h2{margin:0;font-size:clamp(50px,7vw,105px);letter-spacing:-.075em;line-height:.82}.rule-list{border-top:1px solid #ffffff50;counter-reset:rule}.rule{position:relative;border-bottom:1px solid #ffffff40;padding:22px 0 22px 65px;font-size:clamp(18px,2vw,27px);line-height:1.25;counter-increment:rule}.rule:before{position:absolute;left:0;color:var(--yellow);font:750 10px/1.5 var(--mono);content:counter(rule,decimal-leading-zero)}
    .boundary{display:grid;grid-template-columns:.7fr 1.3fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.boundary>div{padding:clamp(36px,5vw,76px) var(--gutter)}.boundary>div:first-child{border-right:1px solid var(--line)}.boundary h2{margin:0;font-size:clamp(40px,5.5vw,80px);letter-spacing:-.065em;line-height:.88}.boundary p{margin:0 0 22px;font-size:clamp(19px,2.1vw,30px);line-height:1.28}.boundary small{font:600 11px/1.6 var(--mono)}.sources{display:grid;border-top:1px solid var(--line);grid-template-columns:repeat(2,1fr)}.source{min-height:145px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:22px;text-decoration:none}.source:nth-child(even){border-right:0}.source span{display:block;margin-top:12px;font-size:13px;line-height:1.45}.source small{display:block;margin-top:16px;color:var(--orange);font:700 9px/1 var(--mono)}
    .end{position:relative;display:grid;min-height:88svh;place-items:end start;overflow:hidden;background:var(--deep);color:var(--white)}.end img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}.end:after{position:absolute;inset:0;background:linear-gradient(0deg,#061a29fa,#061a2910 70%);content:""}.end-copy{position:relative;z-index:2;padding:clamp(50px,8vw,120px) var(--gutter)}.end h2{max-width:1050px;margin:0;font-size:clamp(60px,10vw,150px);letter-spacing:-.085em;line-height:.76}.end p{max-width:720px;font-size:clamp(20px,2.5vw,35px)}.links{display:flex;flex-wrap:wrap;gap:10px}.links a{border:1px solid #ffffff80;padding:13px 16px;font:700 10px/1 var(--mono);text-decoration:none;text-transform:uppercase}
    @media(max-width:1000px){.strengths,.plates{grid-template-columns:repeat(2,1fr)}.builder{grid-template-columns:repeat(2,1fr)}.result{grid-column:1/-1}.pairs,.timeline{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.edition,.navlinks a:first-child{display:none}.hero,.thesis,.section-head,.score,.rules,.boundary{grid-template-columns:1fr}.hero{min-height:0}.hero-copy{min-height:630px}.hero-image{min-height:72svh}.thesis b{border-right:0;border-bottom:1px solid #172d3940}.strengths,.doors,.builder,.pairs,.timeline,.plates,.sources{grid-template-columns:1fr}.door,.pair,.phase,.source{border-right:0}.result{grid-column:auto}.score-row{grid-template-columns:55px 1fr}.score-row p{grid-column:2}.plate{aspect-ratio:4/5}}
  </style>
</head>
<body><a class="skip" href="#main">Skip to roadmap</a><nav class="nav"><a class="brand" href="/">PointCast</a><span class="edition">Beach Commons · Field Study 018</span><div class="navlinks"><a href="#builder">Build a pair</a><a href="/beach-commons">All editions</a></div></nav>
<main id="main">
  <header class="hero"><div class="hero-copy"><div><p class="kicker">El Segundo center · roughly 25 miles · unofficial editorial atlas</p><h1>Radius<br />25 <span>Build the combinations</span></h1><p class="dek">Eight local powers. Twelve working pairs. <em>One region that learns by making.</em></p></div><div class="facts"><span><b>8</b>strengths</span><span><b>12</b>working pairs</span><span><b>40</b>roadmap routes</span><span><b>4</b>horizons</span></div></div><div class="hero-image"><img src={VISUAL_PLATES[0].src} alt={VISUAL_PLATES[0].alt} width="1024" height="1536" /><div class="caption">Plate 01 · The twenty-five-mile table · concept image, not a site plan</div></div></header>
  <section class="thesis"><b>The strength test</b><p>Proximity is only a strength when <em>two capabilities can make something together.</em></p></section>
  <section class="section navy"><div class="section-head"><div><p class="kicker">01 · The regional stack</p><h2>Eight powers already <em>here.</em></h2></div><p>This is not a ranking of sectors or famous names. It is an inventory of useful capacities: what the area can bring to a shared proof before inventing an institution.</p></div><div class="strengths">{RADIUS_STRENGTHS.map(s=><article class="strength" style={`--c:${s.color}`}><small>{s.number} · {s.shortTitle}</small><h3>{s.title}</h3><p>{s.thesis}</p><dl><dt>Existing evidence</dt><dd>{s.proof}</dd><dt>First useful move</dt><dd>{s.move}</dd></dl></article>)}</div></section>
  <section class="section soft"><div class="section-head"><div><p class="kicker">02 · Geographic doors</p><h2>A ring, not a <em>capital.</em></h2></div><p>El Segundo is a useful center because different strengths crowd its horizon. The center does not own the circle; every district has its own knowledge, hosts, histories, and right to decline.</p></div><div class="doors">{RADIUS_DOORS.map((d,i)=><article class="door"><span>{String(i+1).padStart(2,'0')}</span><div><h3>{d.title}</h3><strong>{d.role}</strong><p>{d.detail}</p></div></article>)}</div><p class="radius-note"><strong>Radius note.</strong> {BEACH_COMMONS_V18.radiusDefinition} Pasadena and Long Beach are edge conversations; measure again for any real program.</p></section>
  <section class="section deep" id="builder" data-roadmap-options={JSON.stringify(ROADMAP_OPTIONS)}><div class="section-head"><div><p class="kicker">03 · Combination builder</p><h2>Start somewhere. <em>Pair outward.</em></h2></div><p>Choose the strength you can bring, then the public result you want. The instrument returns a bounded 90-day proof and one-year horizon—one of forty local routes.</p></div><div class="builder"><div class="column"><span class="label">01 · Start with</span><div class="choices">{RADIUS_STRENGTHS.map((s,i)=><button class="choice" type="button" data-strength={s.id} aria-pressed={i===0?'true':'false'}>{s.shortTitle}<small>{s.bring}</small></button>)}</div></div><div class="column"><span class="label">02 · Aim for</span><div class="choices">{RADIUS_GOALS.map((g,i)=><button class="choice" type="button" data-goal={g.id} aria-pressed={i===0?'true':'false'}>{g.label}<small>{g.question}</small></button>)}</div></div><div class="column result" aria-live="polite"><span class="label">Your working pair</span><h3 data-title>{initialPair.title}</h3><p class="question" data-question>{initialPair.question}</p><div class="step"><b>90-day proof</b><p data-now>{initialPair.ninetyDays}</p></div><div class="step"><b>One-year horizon</b><p data-year>{initialPair.oneYear}</p></div><div class="step"><b>What counts</b><p data-proof>{initialPair.proof}</p></div></div></div><p class="privacy">Browser-only · no cookies · no storage · no analytics · no geolocation · no network writes · no registration</p></section>
  <section class="section"><div class="section-head"><div><p class="kicker">04 · First season</p><h2>Twelve pairs. <em>Finish things.</em></h2></div><p>A league or open brief supplies invitation, deadlines, comparison, and voluntary teams without pretending a whole community shares one assigned job.</p></div><div class="pairs">{WORKING_PAIRS.map((p,i)=><article class="pair"><small>{String(i+1).padStart(2,'0')} · {p.strengths.join(' × ')}</small><h3>{p.title}</h3><p>{p.question}</p><div><b>90-day proof</b><p>{p.ninetyDays}</p></div></article>)}</div></section>
  <section class="section navy"><div class="section-head"><div><p class="kicker">05 · High-level roadmap</p><h2>Proof before <em>institution.</em></h2></div><p>Show the field, make real pairs, standardize only what earns reuse, then decide whether a durable institution deserves space, governance, and capital.</p></div><div class="timeline">{ROADMAP_PHASES.map(p=><article class="phase"><small>{p.window}</small><h3>{p.title}</h3><p>{p.instruction}</p><p class="outcome"><strong>Result · </strong>{p.result}</p></article>)}</div></section>
  <section class="section soft"><div class="score"><div class="big"><p class="kicker">06 · Strength score</p><strong>100</strong><p>A local asset is not automatically a regional strength. Score whether a combination is real, open, inspectable, and repeatable. Keep delight awards separate.</p></div><div class="score-list">{STRENGTH_SCORE.map(s=><div class="score-row"><b>{s.points}</b><strong>{s.label}</strong><p>{s.question}</p></div>)}</div></div></section>
  <section class="section deep"><div class="section-head"><div><p class="kicker">07 · Visual atlas</p><h2>The circle becomes a <em>worktable.</em></h2></div><p>Eight speculative plates move from inventory to productive pairings and a blue-hour exchange. They are provocations—not maps, proposed sites, operational diagrams, or evidence of approval.</p></div><div class="plates">{VISUAL_PLATES.map(p=><figure class="plate"><img src={p.src} alt={p.alt} width="1024" height="1536" loading={p.number==='01'?'eager':'lazy'} /><figcaption>{p.number} · {p.title}</figcaption></figure>)}</div></section>
  <section class="section navy"><div class="rules"><div><p class="kicker">08 · Operating agreement</p><h2>Open play. Hard proof.</h2><p>The commons is a reliable invitation to contribute, compete, host, make, repair, or visit—under rules clear enough to trust.</p></div><div class="rule-list">{GOVERNING_RULES.map(r=><div class="rule">{r}</div>)}</div></div></section>
  <aside class="boundary"><div><p class="kicker">Reality boundary</p><h2>This is the map before the coalition.</h2></div><div><p>No organization named or geographically referenced here has joined, funded, approved, endorsed, or committed to this framework.</p><small>{BEACH_COMMONS_V18.status} Any physical beach, airport, port, campus, street, park, venue, workshop, environmental, food, alcohol, transit, or public activity begins with the relevant owner, operator, agency, permit, insurance, labor, ecological, access, security, and safety requirements.</small></div></aside>
  <section class="section"><div class="section-head"><div><p class="kicker">09 · Source desk</p><h2>Evidence, not <em>affiliation.</em></h2></div><p>Current official and regional source doors checked July 31, 2026. They support the capability map—not the imagined collaborations.</p></div><div class="sources">{RADIUS_SOURCES.map(s=><a class="source" href={s.url} rel="noreferrer"><strong>{s.label}</strong><span>{s.note}</span><small>Open source ↗</small></a>)}</div></section>
  <footer class="end"><img src={VISUAL_PLATES[7].src} alt={VISUAL_PLATES[7].alt} width="1024" height="1536" loading="lazy" /><div class="end-copy"><p class="kicker">Beach Commons · next horizon</p><h2>Make one pair. <em>Let usefulness draw the map.</em></h2><p>The most interesting 25-mile institution may be the one that starts as twelve small finished things.</p><div class="links"><a href="#builder">Build another pair</a><a href="/beach-commons/v18.json">Open JSON</a><a href="/beach-commons">All editions</a><a href="/beach-commons/v17">Previous: Ask the Beach</a></div></div></footer>
</main>
<script>
  const box=document.querySelector('[data-roadmap-options]');if(box){const options=JSON.parse(box.dataset.roadmapOptions||'{}');const sb=[...box.querySelectorAll('[data-strength]')],gb=[...box.querySelectorAll('[data-goal]')];let s='coast',g='resilience';const put=(q,v)=>{const e=box.querySelector(q);if(e)e.textContent=v};const update=()=>{const p=options?.[s]?.[g];if(!p)return;put('[data-title]',p.title);put('[data-question]',p.question);put('[data-now]',p.ninetyDays);put('[data-year]',p.oneYear);put('[data-proof]',p.proof)};const choose=(all,b)=>all.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));sb.forEach(b=>b.addEventListener('click',()=>{s=b.dataset.strength||s;choose(sb,b);update()}));gb.forEach(b=>b.addEventListener('click',()=>{g=b.dataset.goal||g;choose(gb,b);update()}));}
</script></body></html>
