---
import {
  BEACH_COMMONS_V13,
  FERMENTATION_PLATES,
  FERMENTATION_RULES,
  FERMENTATION_SOURCES,
  FERMENTATION_TEAMS,
  FESTIVAL_PHASES,
  FESTIVAL_SCORE,
  LOCAL_GAMES,
} from '../../lib/beach-commons-v13';

const canonical = BEACH_COMMONS_V13.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0536.png';
const totalPoints = FESTIVAL_SCORE.reduce((sum, category) => sum + category.points, 0);
const roles = [
  'mill',
  'mash',
  'cellar',
  'lab',
  'bread',
  'honey',
  'water',
  'hospitality',
  'access',
  'score',
  'material return',
  'clean close',
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${canonical}#field-study`,
  name: 'The Fermentation League — Beach Commons V13',
  alternativeHeadline: BEACH_COMMONS_V13.dek,
  description:
    'A speculative collaborative brewery, bread-and-honey hall, regional style cup, two-site festival circuit, and alcohol-free coastal games field.',
  url: canonical,
  image: socialImage,
  datePublished: BEACH_COMMONS_V13.publishedAt,
  creator: BEACH_COMMONS_V13.creators.map((creator) => ({
    '@type': creator.name.includes('Codex') ? 'Organization' : 'Person',
    name: creator.name,
  })),
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'Beach Commons',
    url: 'https://pointcast.xyz/beach-commons',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content="Four regions share one lawful fermentation commons, then compete through beer, bread, honey, hospitality, and useful local games."
    />
    <meta name="theme-color" content="#241c16" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/beach-commons/v13.json" />
    <link rel="preload" as="image" href={FERMENTATION_PLATES[0].image} fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="The Fermentation League — Beach Commons V13" />
    <meta property="og:description" content={BEACH_COMMONS_V13.dek} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Fermentation League — Beach Commons V13" />
    <meta name="twitter:description" content={BEACH_COMMONS_V13.dek} />
    <meta name="twitter:image" content={socialImage} />
    <title>The Fermentation League — Beach Commons V13 · PointCast</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the field study</a>

    <nav class="nav" aria-label="Fermentation League navigation">
      <a class="brand" href="/">PointCast</a>
      <span>Beach Commons · V13</span>
      <div>
        <a href="/beach-commons">Series</a>
        <a href="#styles">Styles</a>
        <a href="#draft-board">Draft board</a>
        <a href="/beach-commons/v13.json">JSON ↗</a>
      </div>
    </nav>

    <main id="main">
      <header class="hero">
        <div class="hero__image">
          <img
            src={FERMENTATION_PLATES[0].image}
            alt={FERMENTATION_PLATES[0].alt}
            width="1536"
            height="1024"
            fetchpriority="high"
          />
          <div class="hero__stamp" aria-hidden="true">13</div>
        </div>
        <div class="hero__copy">
          <p class="eyebrow">PointCast Field Study 013 · Beach Commons</p>
          <h1><span>The</span> Fermentation <em>League</em></h1>
          <p class="hero__dek">Four regions. One brewhouse. Nothing wins alone.</p>
          <div class="hero__rule">
            <strong>Brew inland.</strong>
            <strong>Play at the coast.</strong>
          </div>
          <p class="hero__note">
            A speculative collaboration system for beer, bread, honey, public craft, regional style, and the games
            required to leave a gathering better than it began.
          </p>
          <a class="button" href="#styles">Meet the four teams ↓</a>
        </div>
      </header>

      <section class="opening">
        <p class="section-label">The premise</p>
        <div class="opening__grid">
          <h2>A brewery can be shared civic equipment.</h2>
          <div>
            <p>
              The interesting question is not whether twenty people can stand around a kettle. It is whether a
              community can distribute the real authorship: recipe, grain, hot work, cellar patience, laboratory
              checks, bread, honey, water, hospitality, accessibility, scorekeeping, cleanup, and return.
            </p>
            <p>
              So four fictional place-teams—Coast, Basin, Valley, and Foothill—enter the same lawful brewhouse with
              different arguments about style. Beer is only one lane. Bread and honey get equal billing. The final
              test is whether the rivals can build one table together.
            </p>
          </div>
        </div>
        <div class="facts" aria-label="Fermentation League facts">
          <div><strong>4</strong><span>Place-teams</span></div>
          <div><strong>3</strong><span>Festival lanes</span></div>
          <div><strong>{totalPoints}</strong><span>Possible points</span></div>
          <div><strong>0</strong><span>Alcohol at Dockweiler</span></div>
        </div>
      </section>

      <section class="plates" aria-labelledby="plates-title">
        <div class="section-head">
          <div>
            <p class="section-label">Eight visual plates</p>
            <h2 id="plates-title">The whole system, in order.</h2>
          </div>
          <p>Open any plate for the full field view.</p>
        </div>
        <div class="plate-grid">
          {
            FERMENTATION_PLATES.map((plate, index) => (
              <article class:list={['plate', { 'plate--wide': [0, 5, 7].includes(index) }]}>
                <button
                  class="plate__image"
                  type="button"
                  data-plate-index={index}
                  data-title={plate.title}
                  data-src={plate.image}
                  data-alt={plate.alt}
                  aria-label={`Open full image for ${plate.title}`}
                >
                  <img src={plate.image} alt={plate.alt} width="1536" height="1024" loading={index > 1 ? 'lazy' : 'eager'} />
                  <span>Open plate ↗</span>
                </button>
                <div class="plate__body">
                  <div class="plate__meta">
                    <span>{plate.number}</span>
                    <span>{plate.kicker}</span>
                  </div>
                  <h3>{plate.title}</h3>
                  <p class="plate__thesis">{plate.thesis}</p>
                  <p>{plate.program}</p>
                  <p class="plate__boundary"><strong>Edge:</strong> {plate.boundary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="styles" id="styles" aria-labelledby="styles-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">The regional style table</p>
            <h2 id="styles-title">Same building. Four arguments.</h2>
          </div>
          <p>
            Style is not destiny or costume. It is a public statement about what a team chooses to make legible.
          </p>
        </div>
        <div class="team-grid">
          {
            FERMENTATION_TEAMS.map((team) => (
              <article class="team" style={`--team:${team.color}`}>
                <div class="team__head">
                  <span>{team.mark}</span>
                  <h3>{team.title}</h3>
                </div>
                <p class="team__argument">{team.argument}</p>
                <dl>
                  <div><dt>Beer</dt><dd>{team.beer}</dd></div>
                  <div><dt>Bread</dt><dd>{team.bread}</dd></div>
                  <div><dt>Honey</dt><dd>{team.honey}</dd></div>
                  <div><dt>Game</dt><dd>{team.game}</dd></div>
                </dl>
              </article>
            ))
          }
        </div>
        <aside class="honey-note">
          <span>One useful style correction</span>
          <p>
            Honey beer is not automatically sweet. Honey is highly fermentable; its aroma and residual impression
            depend on the base beer, honey type, quantity, processing, and when it enters the process. “Valley”
            therefore competes on source, aroma, timing, and pairing—not syrup.
          </p>
        </aside>
      </section>

      <section class="relay" aria-labelledby="relay-title">
        <div class="relay__copy">
          <p class="section-label">The collaborative brewery</p>
          <h2 id="relay-title">Twelve jobs. One baton.</h2>
          <p>
            The baton is responsibility. Every handoff has a named lead, a stop rule, a record, and a clean next
            station. Brewing stays under the responsible operator; public participation is designed around lawful,
            useful work rather than pretending everyone is suddenly a brewer.
          </p>
          <div class="role-loop" aria-label="Twelve collaboration roles">
            {roles.map((role, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{role}</span>)}
          </div>
        </div>
        <img
          src={FERMENTATION_PLATES[3].image}
          alt={FERMENTATION_PLATES[3].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
      </section>

      <section class="score" aria-labelledby="score-title">
        <div class="section-head">
          <div>
            <p class="section-label">The complete-system cup</p>
            <h2 id="score-title">Flavor is 25 points. The commons is 75.</h2>
          </div>
          <p>No points for volume, strength, speed, exclusivity, spectacle, or drinking more.</p>
        </div>
        <div class="score__grid">
          {
            FESTIVAL_SCORE.map((category) => (
              <div class="score-row">
                <span>{category.label}</span>
                <div aria-hidden="true"><i style={`--score:${category.points}`}></i></div>
                <strong>{category.points}</strong>
              </div>
            ))
          }
        </div>
        <p class="score__verdict">
          A technically excellent beer can lose. A generous, traceable, accessible, low-waste team can win.
        </p>
      </section>

      <section class="draft" id="draft-board" aria-labelledby="draft-title">
        <div class="draft__intro">
          <p class="section-label">Local instrument · no account · no network write</p>
          <h2 id="draft-title">Festival Draft Board</h2>
          <p>
            Pick one place-team and rehearse its complete slate. This does not create a recipe, registration,
            reservation, product, team, or real event.
          </p>
          <div class="draft__buttons" role="group" aria-label="Choose a place-team">
            {
              FERMENTATION_TEAMS.map((team, index) => (
                <button
                  type="button"
                  data-team={team.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  style={`--team:${team.color}`}
                >
                  <span>{team.mark}</span>{team.title}
                </button>
              ))
            }
          </div>
        </div>
        <div class="draft__receipt" aria-live="polite">
          <p>Speculative team slate</p>
          <h3 id="draft-team">{FERMENTATION_TEAMS[0].title}</h3>
          <dl>
            <div><dt>Beer</dt><dd id="draft-beer">{FERMENTATION_TEAMS[0].beer}</dd></div>
            <div><dt>Bread</dt><dd id="draft-bread">{FERMENTATION_TEAMS[0].bread}</dd></div>
            <div><dt>Honey</dt><dd id="draft-honey">{FERMENTATION_TEAMS[0].honey}</dd></div>
            <div><dt>Game</dt><dd id="draft-game">{FERMENTATION_TEAMS[0].game}</dd></div>
          </dl>
          <p id="draft-argument">{FERMENTATION_TEAMS[0].argument}</p>
          <div>
            <button type="button" id="copy-draft">Copy rehearsal receipt</button>
            <button type="button" id="reset-draft">Reset</button>
          </div>
          <small id="draft-status">Nothing is stored or sent.</small>
        </div>
      </section>

      <section class="circuit" aria-labelledby="circuit-title">
        <div class="circuit__image">
          <img
            src={FERMENTATION_PLATES[5].image}
            alt={FERMENTATION_PLATES[5].alt}
            width="1536"
            height="1024"
            loading="lazy"
          />
        </div>
        <div class="circuit__copy">
          <p class="section-label">The elegant constraint</p>
          <h2 id="circuit-title">One festival, two sites.</h2>
          <article>
            <span>Inland / licensed</span>
            <h3>Make, cellar, judge, taste.</h3>
            <p>
              Production, adult beer judging, public alcohol service, bread ovens, honey archive, food, water, and
              the final long table stay with responsible operators at an authorized venue.
            </p>
          </article>
          <article>
            <span>Dockweiler / alcohol-free</span>
            <h3>Play, picnic, return.</h3>
            <p>
              Lightweight games, abstract flags, ceramic score tokens, water, shade, and properly permitted food
              service become the coast chapter. Scorecards travel; open beverages do not.
            </p>
          </article>
          <p class="circuit__rule">
            LA County’s beach event materials state that no alcohol permits are issued for Dockweiler State Beach.
            V13 treats that as a design fact, not fine print.
          </p>
        </div>
      </section>

      <section class="games" aria-labelledby="games-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">The local games</p>
            <h2 id="games-title">Compete at useful things.</h2>
          </div>
          <p>Every event uses dry, light, cleaned, purpose-built props and a bounded course.</p>
        </div>
        <ol class="game-grid">
          {LOCAL_GAMES.map((game, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{game}</li>)}
        </ol>
        <p class="games__ban">
          No full kegs · no drinking games · no hot liquid · no glass · no food throwing · no gambling · no unsafe
          lifting · no surf-edge course
        </p>
      </section>

      <section class="phases" aria-labelledby="phases-title">
        <div class="section-head">
          <div>
            <p class="section-label">Two workable paths</p>
            <h2 id="phases-title">Start as a cup, or grow into a season.</h2>
          </div>
          <p>
            The smallest credible version is one licensed partner, four invited teams, one all-ages hall, and one
            dry games day. A recurring league only follows after the close is audited.
          </p>
        </div>
        <div class="phase-list">
          {FESTIVAL_PHASES.map((phase) => <article><span>{phase.step}</span><h3>{phase.title}</h3><p>{phase.copy}</p></article>)}
        </div>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <div>
          <p class="section-label">The honest edge</p>
          <h2 id="boundary-title">Imagine fully. Announce nothing.</h2>
          <p>
            The Fermentation League is an unofficial PointCast field study. It is not an operating brewery,
            homebrew club, nonprofit, producer, public tasting, recipe, batch, team, festival, competition, permit,
            fundraiser, product, sale, contribution drive, or invitation to gather.
          </p>
        </div>
        <ul>
          {FERMENTATION_RULES.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <section class="sources" aria-labelledby="sources-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">Current source desk · checked July 28, 2026</p>
            <h2 id="sources-title">Rules before recipes.</h2>
          </div>
          <p>
            Sources establish boundaries and style context. They do not endorse this project or verify a future
            operator.
          </p>
        </div>
        <div class="source-grid">
          {
            FERMENTATION_SOURCES.map((source, index) => (
              <a href={source.url} target="_blank" rel="noreferrer">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{source.label}</strong>
                <p>{source.note}</p>
                <i>Open source ↗</i>
              </a>
            ))
          }
        </div>
      </section>

      <nav class="closing" aria-label="Beach Commons edition links">
        <a href="/beach-commons/v12"><span>Previous · V12</span><strong>Harbor Works ←</strong></a>
        <a href="/beach-commons"><span>Complete series</span><strong>All thirteen editions ↗</strong></a>
        <a href="/beach-commons/v13.json"><span>Machine edition</span><strong>Open V13 JSON ↗</strong></a>
      </nav>
    </main>

    <footer>
      <span>Michael Hoydich + Codex / OpenAI · PointCast · 2026</span>
      <span>Field Study 013 · The Fermentation League</span>
    </footer>

    <dialog class="viewer" id="plate-viewer" aria-label="Fermentation League full image viewer">
      <div class="viewer__bar">
        <p id="viewer-title">Fermentation League plate</p>
        <button type="button" id="viewer-close" aria-label="Close full image">Close ×</button>
      </div>
      <div class="viewer__image"><img id="viewer-image" alt="" /></div>
      <div class="viewer__controls">
        <button type="button" id="viewer-prev">← Previous</button>
        <span id="viewer-count">1 / 8</span>
        <button type="button" id="viewer-next">Next →</button>
      </div>
    </dialog>

    <script define:vars={{ teams: FERMENTATION_TEAMS }}>
      const teamButtons = [...document.querySelectorAll('[data-team]')];
      const fields = {
        team: document.querySelector('#draft-team'),
        beer: document.querySelector('#draft-beer'),
        bread: document.querySelector('#draft-bread'),
        honey: document.querySelector('#draft-honey'),
        game: document.querySelector('#draft-game'),
        argument: document.querySelector('#draft-argument'),
      };
      const status = document.querySelector('#draft-status');
      let activeTeam = teams[0];

      const selectTeam = (id) => {
        activeTeam = teams.find((team) => team.id === id) || teams[0];
        teamButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.team === activeTeam.id)));
        if (fields.team) fields.team.textContent = activeTeam.title;
        if (fields.beer) fields.beer.textContent = activeTeam.beer;
        if (fields.bread) fields.bread.textContent = activeTeam.bread;
        if (fields.honey) fields.honey.textContent = activeTeam.honey;
        if (fields.game) fields.game.textContent = activeTeam.game;
        if (fields.argument) fields.argument.textContent = activeTeam.argument;
        if (status) status.textContent = `${activeTeam.title} drafted locally. Nothing was stored or sent.`;
      };

      teamButtons.forEach((button) => button.addEventListener('click', () => selectTeam(button.dataset.team)));
      document.querySelector('#reset-draft')?.addEventListener('click', () => selectTeam(teams[0].id));
      document.querySelector('#copy-draft')?.addEventListener('click', async () => {
        const receipt = [
          'THE FERMENTATION LEAGUE / LOCAL REHEARSAL',
          `TEAM: ${activeTeam.title}`,
          `BEER: ${activeTeam.beer}`,
          `BREAD: ${activeTeam.bread}`,
          `HONEY: ${activeTeam.honey}`,
          `GAME: ${activeTeam.game}`,
          '',
          'Speculative PointCast draft only. No recipe, batch, registration, product, permit, or event.',
          'https://pointcast.xyz/beach-commons/v13',
        ].join('\n');
        try {
          await navigator.clipboard.writeText(receipt);
          if (status) status.textContent = 'Rehearsal receipt copied.';
        } catch {
          if (status) status.textContent = 'Copy was unavailable; the slate remains visible above.';
        }
      });

      const viewer = document.querySelector('#plate-viewer');
      const viewerImage = document.querySelector('#viewer-image');
      const viewerTitle = document.querySelector('#viewer-title');
      const viewerCount = document.querySelector('#viewer-count');
      const plateButtons = [...document.querySelectorAll('[data-plate-index]')];
      let currentPlate = 0;
      let lastOpener = null;

      const showPlate = (index) => {
        currentPlate = (index + plateButtons.length) % plateButtons.length;
        const button = plateButtons[currentPlate];
        if (viewerImage) {
          viewerImage.src = button.dataset.src || '';
          viewerImage.alt = button.dataset.alt || '';
        }
        if (viewerTitle) viewerTitle.textContent = button.dataset.title || 'Fermentation League plate';
        if (viewerCount) viewerCount.textContent = `${currentPlate + 1} / ${plateButtons.length}`;
      };

      plateButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          lastOpener = button;
          showPlate(index);
          viewer?.showModal();
        });
      });
      document.querySelector('#viewer-close')?.addEventListener('click', () => viewer?.close());
      document.querySelector('#viewer-prev')?.addEventListener('click', () => showPlate(currentPlate - 1));
      document.querySelector('#viewer-next')?.addEventListener('click', () => showPlate(currentPlate + 1));
      viewer?.addEventListener('click', (event) => {
        if (event.target === viewer) viewer.close();
      });
      viewer?.addEventListener('close', () => lastOpener?.focus());
      viewer?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') showPlate(currentPlate - 1);
        if (event.key === 'ArrowRight') showPlate(currentPlate + 1);
      });
    </script>
  </body>
</html>

<style>
  :root {
    --ink: #241c16;
    --cream: #f3ead7;
    --paper: #fbf7ed;
    --gold: #e6af3d;
    --orange: #d85f32;
    --blue: #245fa8;
    --green: #637b45;
    --line: rgba(36, 28, 22, 0.2);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--cream);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--cream); }
  button, a { font: inherit; }
  img { display: block; width: 100%; }
  a { color: inherit; }
  .skip {
    position: fixed; top: 8px; left: 8px; z-index: 100;
    padding: 10px 14px; background: white; transform: translateY(-160%);
  }
  .skip:focus { transform: none; }

  .nav {
    position: sticky; top: 0; z-index: 20; min-height: 58px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch;
    color: #fff; background: rgba(36, 28, 22, 0.96); border-bottom: 1px solid rgba(255,255,255,0.18);
    text-transform: uppercase; letter-spacing: 0.14em; font-size: 11px; font-weight: 800;
  }
  .nav > * { display: flex; align-items: center; padding: 0 24px; }
  .nav .brand { text-decoration: none; letter-spacing: 0.2em; }
  .nav > span { border-inline: 1px solid rgba(255,255,255,0.18); }
  .nav > div { justify-content: flex-end; padding: 0; }
  .nav > div a { align-items: center; align-self: stretch; display: flex; padding: 0 18px; text-decoration: none; border-left: 1px solid rgba(255,255,255,0.18); }
  .nav a:hover, .nav a:focus-visible { background: var(--orange); }

  .hero { min-height: calc(100vh - 58px); display: grid; grid-template-columns: 1.15fr 0.85fr; background: var(--ink); color: white; }
  .hero__image { position: relative; min-height: 680px; overflow: hidden; }
  .hero__image img { width: 100%; height: 100%; object-fit: cover; }
  .hero__image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 65%, rgba(36,28,22,0.5)); pointer-events: none; }
  .hero__stamp {
    position: absolute; left: 22px; bottom: 18px; z-index: 1;
    width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center;
    color: var(--ink); background: var(--gold); font: 900 38px/1 Georgia, serif; border: 8px solid var(--ink);
  }
  .hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(36px, 6vw, 96px); }
  .eyebrow, .section-label { margin: 0 0 18px; text-transform: uppercase; letter-spacing: 0.18em; font: 800 11px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .hero h1 { margin: 0; max-width: 8ch; text-transform: uppercase; letter-spacing: -0.07em; font-size: clamp(58px, 5.8vw, 110px); line-height: 0.78; }
  .hero h1 span { display: block; font-size: 0.32em; letter-spacing: 0.04em; color: var(--gold); }
