---
import {
  BEACH_COMMONS_V15,
  GEAR_CARTS,
  GEAR_PICKS,
  GEAR_PLATES,
  GEAR_PLAYLIST,
  GEAR_RULES,
  GEAR_SCORE_WEIGHTS,
} from '../../lib/beach-commons-v15';

const canonical = BEACH_COMMONS_V15.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0542.png';
const roleLabels = {
  carry: 'Carry',
  sit: 'Sit',
  serve: 'Serve',
  shade: 'Shade',
  light: 'Light',
  store: 'Store',
} as const;
const pickById = Object.fromEntries(GEAR_PICKS.map((pick) => [pick.id, pick]));
const composerData = {
  'first-light': {
    label: 'First light',
    note: 'Arrive quietly, sit, share coffee, and leave before the heat.',
    tiers: {
      '100': ['frakta', 'gear-tie', 'z-seat', 'matador'],
      '300': ['frakta', 'gear-tie', 'matador', 'klean-cups', 'stanley-jug', 'aeropress-go-plus'],
      '700': ['frakta', 'gear-tie', 'matador', 'klean-cups', 'stanley-jug', 'aeropress-go-plus', 'neso-1', 'helinox-one'],
    },
  },
  'all-day': {
    label: 'All day',
    note: 'Prioritize water, shade, seat choice, and the clean-return cart.',
    tiers: {
      '100': ['frakta', 'gear-tie', 'z-seat', 'matador'],
      '300': ['frakta', 'gear-tie', 'matador', 'klean-cups', 'stanley-jug', 'neso-1'],
      '700': ['frakta', 'gear-tie', 'matador', 'klean-cups', 'stanley-jug', 'neso-1', 'helinox-one', 'range-500', 'moonlander'],
    },
  },
  'blue-hour': {
    label: 'Blue hour',
    note: 'Build the smallest warm listening circle and keep the moon dominant.',
    tiers: {
      '100': ['frakta', 'gear-tie', 'alpenglow'],
      '300': ['frakta', 'gear-tie', 'matador', 'klean-cups', 'stanley-jug', 'alpenglow', 'z-seat'],
      '700': ['frakta', 'gear-tie', 'matador', 'klean-cups', 'stanley-jug', 'alpenglow', 'helinox-one', 'moonlander'],
    },
  },
  repair: {
    label: 'Repair day',
    note: 'Make maintenance visible: light, surface, water, soft storage, and return.',
    tiers: {
      '100': ['frakta', 'gear-tie', 'range-500'],
      '300': ['frakta', 'gear-tie', 'range-500', 'stanley-jug', 'moonlander'],
      '700': ['frakta', 'gear-tie', 'range-500', 'stanley-jug', 'moonlander', 'rux-70'],
    },
  },
};
const pickData = GEAR_PICKS.map(({ id, maker, name, priceUsd, priceLabel, role, verdict }) => ({
  id,
  maker,
  name,
  priceUsd,
  priceLabel,
  role,
  verdict,
}));
const pinterestUrl = (plate: (typeof GEAR_PLATES)[number]) => {
  const params = new URLSearchParams({
    url: `${canonical}#${plate.id}`,
    media: `https://pointcast.xyz${plate.image}`,
    description: `${plate.title} — ${plate.caption} Beach Commons V15 / PointCast.`,
  });
  return `https://www.pinterest.com/pin/create/button/?${params.toString()}`;
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: 'The Good Gear — Beach Commons V15',
  alternativeHeadline: BEACH_COMMONS_V15.dek,
  description:
    'A specification-led review of fifteen functional, durable, pleasant, mixed-price objects for a compact public-life field kit.',
  url: canonical,
  image: socialImage,
  datePublished: BEACH_COMMONS_V15.publishedAt,
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'Beach Commons',
    url: 'https://pointcast.xyz/beach-commons',
  },
  itemListElement: GEAR_PICKS.map((pick) => ({
    '@type': 'ListItem',
    position: pick.rank,
    name: `${pick.maker} ${pick.name}`,
    url: `${canonical}#${pick.id}`,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content="Fifteen functional, durable, pleasant, mixed-price objects that earn a place in the Beach Commons cart—plus three kits, a local Cart Composer, a field playlist, and eight original Pinterest plates."
    />
    <meta name="theme-color" content="#153b47" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/beach-commons/v15.json" />
    <link rel="preload" as="image" href={GEAR_PLATES[0].image} fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="The Good Gear — Beach Commons V15" />
    <meta property="og:description" content={BEACH_COMMONS_V15.dek} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Good Gear — Beach Commons V15" />
    <meta name="twitter:description" content={BEACH_COMMONS_V15.dek} />
    <meta name="twitter:image" content={socialImage} />
    <title>The Good Gear — Beach Commons V15 · PointCast</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the review</a>
    <nav class="nav" aria-label="The Good Gear navigation">
      <a class="brand" href="/">PointCast</a>
      <span>Beach Commons · V15</span>
      <div>
        <a href="/beach-commons">Series</a>
        <a href="#review">Review</a>
        <a href="#composer">Composer</a>
        <a href="#playlist">Playlist</a>
        <a href="/beach-commons/v15.json">JSON ↗</a>
      </div>
    </nav>

    <main id="main">
      <header class="hero">
        <div class="hero__visual">
          <img
            src={GEAR_PLATES[0].image}
            alt={GEAR_PLATES[0].alt}
            width="1024"
            height="1536"
            fetchpriority="high"
          />
          <span class="hero__stamp">15</span>
        </div>
        <div class="hero__copy">
          <p class="eyebrow">PointCast Field Study 015 · Utility review</p>
          <h1>The <em>Good</em> Gear</h1>
          <p class="hero__dek">Fifteen objects that earn the cart.</p>
          <p class="hero__intro">
            Functional. Durable. Pleasant to touch. Mixed in price. Designed well enough that packing,
            maintaining, lending, and returning them can become part of the day.
          </p>
          <div class="hero__facts" aria-label="Review facts">
            <span><strong>15</strong> scored objects</span>
            <span><strong>3</strong> complete carts</span>
            <span><strong>8</strong> original pins</span>
            <span><strong>12</strong> field tracks</span>
          </div>
          <a class="button" href="#review">Open the review ↓</a>
        </div>
      </header>

      <section class="thesis">
        <p class="section-label">The standard</p>
        <div>
          <h2>A useful thing should make the whole group lighter.</h2>
          <div class="thesis__copy">
            <p>
              The last Beach Commons edition put six temporary rooms on one durable foundation. This edition asks
              what deserves to travel between them. Not a maximal shopping list: a compact public-life kit whose
              objects carry, shade, seat, serve, illuminate, protect, and disappear.
            </p>
            <p>
              The inexpensive bag can outrank the heroic hard case. One higher chair can be more generous than ten
              matching low ones. A headlamp that makes repair calm can matter more than a lantern that photographs
              beautifully. The review rewards the capability a thing gives other people.
            </p>
          </div>
        </div>
        <aside>
          <strong>No samples. No affiliate money. No invented field test.</strong>
          <p>
            Scores are editorial judgments from current official specifications, warranties and service signals,
            packability, public-use logic, value, and design. Prices were checked July 29, 2026 and can move.
          </p>
        </aside>
      </section>

      <section class="score" aria-labelledby="score-title">
        <div class="section-head">
          <div>
            <p class="section-label">The 100-point utility score</p>
            <h2 id="score-title">Use wins. Pleasure still counts.</h2>
          </div>
          <p>A beautiful object can lose. A cheap object can win. Every score is a transparent editorial model, not laboratory data.</p>
        </div>
        <div class="score__grid">
          {GEAR_SCORE_WEIGHTS.map((weight) => (
            <div>
              <span>{weight.label}</span>
              <i style={`--points:${weight.points}`}></i>
              <strong>{weight.points}</strong>
            </div>
          ))}
        </div>
      </section>

      <section class="review" id="review" aria-labelledby="review-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">The ranked review</p>
            <h2 id="review-title">Fifteen things worth explaining.</h2>
          </div>
          <p>
            Filter the desk by job or price. Every link goes directly to the maker; PointCast earns $0.
          </p>
        </div>
        <div class="filters" aria-label="Filter gear review">
          <div role="group" aria-label="Filter by role">
            <button type="button" data-filter-role="all" aria-pressed="true">All jobs</button>
            {Object.entries(roleLabels).map(([id, label]) => (
              <button type="button" data-filter-role={id} aria-pressed="false">{label}</button>
            ))}
          </div>
          <div role="group" aria-label="Filter by price">
            <button type="button" data-filter-price="all" aria-pressed="true">All prices</button>
            <button type="button" data-filter-price="50" aria-pressed="false">Under $50</button>
            <button type="button" data-filter-price="150" aria-pressed="false">Under $150</button>
            <button type="button" data-filter-price="over" aria-pressed="false">$150+</button>
          </div>
          <p id="review-status" aria-live="polite">Showing all fifteen objects.</p>
        </div>
        <div class="gear-list">
          {GEAR_PICKS.map((pick) => (
            <article
              class="gear"
              id={pick.id}
              data-gear-card
              data-role={pick.role}
              data-price={pick.priceUsd}
            >
              <div class="gear__rank">
                <span>{String(pick.rank).padStart(2, '0')}</span>
                <small>{roleLabels[pick.role]}</small>
              </div>
              <div class="gear__main">
                <p>{pick.maker}</p>
                <h3>{pick.name}</h3>
                <strong class="gear__badge">{pick.badge}</strong>
                <blockquote>{pick.verdict}</blockquote>
              </div>
              <div class="gear__evidence">
                <dl>
                  <div><dt>Useful</dt><dd>{pick.useful}</dd></div>
                  <div><dt>Pleasant</dt><dd>{pick.pleasant}</dd></div>
                  <div><dt>Durable</dt><dd>{pick.durable}</dd></div>
                  <div><dt>Watch</dt><dd>{pick.caveat}</dd></div>
                </dl>
                <div class="gear__specs">{pick.specs.map((spec) => <span>{spec}</span>)}</div>
              </div>
              <div class="gear__score">
                <strong>{pick.scores.total}</strong><span>/100</span>
                <div aria-label={`Utility ${pick.scores.utility}, carry ${pick.scores.carry}, durability ${pick.scores.durability}, pleasure ${pick.scores.pleasure}, commons ${pick.scores.commons}, value ${pick.scores.value}`}>
                  {GEAR_SCORE_WEIGHTS.map((weight) => (
                    <i style={`--fraction:${pick.scores[weight.id] / weight.points}`} title={`${weight.label}: ${pick.scores[weight.id]} / ${weight.points}`}></i>
                  ))}
                </div>
                <p>{pick.priceLabel}</p>
                <a href={pick.url} target="_blank" rel="noreferrer">Official page ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="carts" aria-labelledby="carts-title">
        <div class="section-head">
          <div>
            <p class="section-label">Three complete answers</p>
            <h2 id="carts-title">Stop shopping when the room works.</h2>
          </div>
          <p>Totals use the July 29 snapshots. Each cart states what it deliberately leaves out.</p>
        </div>
        <div class="cart-grid">
          {GEAR_CARTS.map((cart) => (
            <article>
              <div class="cart__top"><span>{cart.budget}</span><strong>${cart.total.toFixed(2)}</strong></div>
              <h3>{cart.title}</h3>
              <p>{cart.thesis}</p>
              <ol>
                {cart.itemIds.map((id) => {
                  const pick = pickById[id];
                  return <li><a href={`#${pick.id}`}>{pick.maker} {pick.name}</a><span>{pick.priceLabel}</span></li>;
                })}
              </ol>
              <aside><strong>Honest omission</strong>{cart.omission}</aside>
            </article>
          ))}
        </div>
      </section>

      <section class="composer" id="composer" aria-labelledby="composer-title">
        <div class="composer__controls">
          <p class="section-label">Local instrument · no account · no network write</p>
          <h2 id="composer-title">Cart Composer</h2>
          <p>Choose a kind of day and a ceiling. The composer returns a compact capability stack—not a checkout.</p>
          <fieldset>
            <legend>Kind of day</legend>
            {Object.entries(composerData).map(([id, mission], index) => (
              <button type="button" data-mission={id} aria-pressed={index === 0 ? 'true' : 'false'}>{mission.label}</button>
            ))}
          </fieldset>
          <fieldset>
            <legend>Budget ceiling</legend>
            {['100', '300', '700'].map((budget, index) => (
              <button type="button" data-budget={budget} aria-pressed={index === 0 ? 'true' : 'false'}>${budget}</button>
            ))}
          </fieldset>
        </div>
        <div class="composer__receipt" aria-live="polite">
          <p>Composed field cart</p>
          <h3 id="composer-name">First light · $100</h3>
          <p id="composer-note">{composerData['first-light'].note}</p>
          <ol id="composer-items">
            {composerData['first-light'].tiers['100'].map((id) => {
              const pick = pickById[id];
              return <li><span>{pick.maker} {pick.name}</span><strong>{pick.priceLabel}</strong></li>;
            })}
          </ol>
          <div><span>Snapshot total</span><strong id="composer-total">$79.93</strong></div>
          <p id="composer-omission">Add no more until this exact day reveals the missing capability.</p>
          <button id="copy-cart" type="button">Copy this cart</button>
          <small id="composer-status">Nothing is stored, purchased, or sent.</small>
        </div>
      </section>

      <section class="plates" aria-labelledby="plates-title">
        <div class="section-head">
          <div>
            <p class="section-label">Pinterest companion · eight original plates</p>
            <h2 id="plates-title">The field kit, vertically.</h2>
          </div>
          <p>
            Brand-neutral concept photography about systems and use. Open a plate here or hand it to Pinterest’s save flow.
          </p>
        </div>
        <div class="plate-grid">
          {GEAR_PLATES.map((plate, index) => (
            <article id={plate.id}>
              <button
                class="plate__open"
                type="button"
                data-plate-index={index}
                data-src={plate.image}
                data-title={plate.title}
                data-alt={plate.alt}
                aria-label={`Open full image for ${plate.title}`}
              >
                <img src={plate.image} alt={plate.alt} width="1024" height="1536" loading={index > 1 ? 'lazy' : 'eager'} />
              </button>
              <div>
                <span>{plate.number}</span>
                <h3>{plate.title}</h3>
                <p>{plate.caption}</p>
                <a href={pinterestUrl(plate)} target="_blank" rel="noreferrer">Save on Pinterest ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="playlist" id="playlist" aria-labelledby="playlist-title">
        <div class="playlist__intro">
          <p class="section-label">Listening companion</p>
          <h2 id="playlist-title">{GEAR_PLAYLIST.title}</h2>
          <p>{GEAR_PLAYLIST.subtitle}</p>
          <a href="/listening-room">Take a Spotify link to the PointCast Listening Room ↗</a>
          <small>{GEAR_PLAYLIST.status}</small>
        </div>
        <ol>
          {GEAR_PLAYLIST.tracks.map((track) => (
            <li>
              <span>{track.number}</span>
              <div><strong>{track.title}</strong><small>{track.artist}</small></div>
              <em>{track.phase}</em>
              <a href={track.url} target="_blank" rel="noreferrer">Spotify ↗</a>
            </li>
          ))}
        </ol>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <div>
          <p class="section-label">The honest edge</p>
          <h2 id="rules-title">Good gear behaves well in public.</h2>
          <p>
            A product page cannot authorize an event, forecast wind at the site, create access, or protect habitat.
            These six rules outrank every score.
          </p>
        </div>
        <ol>{GEAR_RULES.map((rule, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{rule}</li>)}</ol>
      </section>

      <section class="desk-note">
        <p class="section-label">Review desk · checked July 29, 2026</p>
        <div>
          <h2>Direct links. Current specs. The caveat stays attached.</h2>
          <p>{BEACH_COMMONS_V15.priceBoundary}</p>
          <p>{BEACH_COMMONS_V15.affiliateBoundary}</p>
          <p>{BEACH_COMMONS_V15.testingBoundary}</p>
          <p>{BEACH_COMMONS_V15.fieldBoundary}</p>
        </div>
      </section>

      <nav class="closing" aria-label="Beach Commons edition links">
        <a href="/beach-commons/v14"><span>Previous · V14</span><strong>The Hardpoint League ←</strong></a>
        <a href="/beach-commons"><span>Complete series</span><strong>All fifteen editions ↗</strong></a>
        <a href="/beach-commons/v15.json"><span>Machine edition</span><strong>Open V15 JSON ↗</strong></a>
      </nav>
    </main>

    <footer>
      <span>Michael Hoydich + Codex / OpenAI · PointCast · 2026</span>
      <span>Field Study 015 · The Good Gear</span>
    </footer>

    <dialog class="viewer" id="plate-viewer" aria-label="The Good Gear full image viewer">
      <div class="viewer__bar">
        <p id="viewer-title">The Good Gear plate</p>
        <button type="button" id="viewer-close" aria-label="Close image viewer">Close ×</button>
      </div>
      <div class="viewer__image"><img id="viewer-image" src={GEAR_PLATES[0].image} alt={GEAR_PLATES[0].alt} /></div>
      <div class="viewer__controls">
        <button type="button" id="viewer-prev">← Previous</button>
        <span id="viewer-count">1 / {GEAR_PLATES.length}</span>
        <button type="button" id="viewer-next">Next →</button>
      </div>
    </dialog>

    <script define:vars={{ pickData, composerData }}>
      const roleButtons = [...document.querySelectorAll('[data-filter-role]')];
      const priceButtons = [...document.querySelectorAll('[data-filter-price]')];
      const cards = [...document.querySelectorAll('[data-gear-card]')];
      const reviewStatus = document.querySelector('#review-status');
      let activeRole = 'all';
      let activePrice = 'all';
      const applyFilters = () => {
        let visible = 0;
        cards.forEach((card) => {
          const price = Number(card.dataset.price);
          const roleMatch = activeRole === 'all' || card.dataset.role === activeRole;
          const priceMatch =
            activePrice === 'all' ||
            (activePrice === '50' && price < 50) ||
            (activePrice === '150' && price < 150) ||
            (activePrice === 'over' && price >= 150);
          card.hidden = !(roleMatch && priceMatch);
          if (!card.hidden) visible += 1;
        });
        if (reviewStatus) reviewStatus.textContent = `Showing ${visible} ${visible === 1 ? 'object' : 'objects'}.`;
      };
      roleButtons.forEach((button) => button.addEventListener('click', () => {
        activeRole = button.dataset.filterRole;
        roleButtons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        applyFilters();
      }));
      priceButtons.forEach((button) => button.addEventListener('click', () => {
        activePrice = button.dataset.filterPrice;
        priceButtons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        applyFilters();
      }));

      const missionButtons = [...document.querySelectorAll('[data-mission]')];
      const budgetButtons = [...document.querySelectorAll('[data-budget]')];
      const pickMap = Object.fromEntries(pickData.map((pick) => [pick.id, pick]));
      let mission = 'first-light';
      let budget = '100';
      const renderCart = () => {
        const config = composerData[mission];
        const items = config.tiers[budget].map((id) => pickMap[id]);
        const total = items.reduce((sum, item) => sum + item.priceUsd, 0);
        document.querySelector('#composer-name').textContent = `${config.label} · $${budget}`;
        document.querySelector('#composer-note').textContent = config.note;
        document.querySelector('#composer-total').textContent = `$${total.toFixed(2)}`;
        document.querySelector('#composer-items').innerHTML = items
          .map((item) => `<li><span>${item.maker} ${item.name}</span><strong>${item.priceLabel}</strong></li>`)
          .join('');
        document.querySelector('#composer-status').textContent = 'Nothing is stored, purchased, or sent.';
      };
      missionButtons.forEach((button) => button.addEventListener('click', () => {
        mission = button.dataset.mission;
        missionButtons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        renderCart();
      }));
      budgetButtons.forEach((button) => button.addEventListener('click', () => {
        budget = button.dataset.budget;
        budgetButtons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        renderCart();
      }));
      document.querySelector('#copy-cart')?.addEventListener('click', async () => {
        const config = composerData[mission];
        const items = config.tiers[budget].map((id) => pickMap[id]);
        const total = items.reduce((sum, item) => sum + item.priceUsd, 0);
        const text = [
          `BEACH COMMONS V15 — ${config.label.toUpperCase()} / $${budget}`,
          ...items.map((item) => `• ${item.maker} ${item.name} — ${item.priceLabel}`),
          `Snapshot total: $${total.toFixed(2)}`,
          'Prices can move. Re-check official pages. PointCast earns $0.',
          'https://pointcast.xyz/beach-commons/v15',
        ].join('\n');
        try {
          await navigator.clipboard.writeText(text);
          document.querySelector('#composer-status').textContent = 'Cart copied. Nothing was purchased or sent.';
        } catch {
          document.querySelector('#composer-status').textContent = 'Copy was unavailable. Select the receipt text manually.';
        }
      });

      const viewer = document.querySelector('#plate-viewer');
      const viewerImage = document.querySelector('#viewer-image');
      const viewerTitle = document.querySelector('#viewer-title');
      const viewerCount = document.querySelector('#viewer-count');
      const plateButtons = [...document.querySelectorAll('[data-plate-index]')];
      let currentPlate = 0;
      let lastOpener = null;
      const showPlate = (index) => {
        currentPlate = (index + plateButtons.length) % plateButtons.length;
        const button = plateButtons[currentPlate];
        viewerImage.src = button.dataset.src;
        viewerImage.alt = button.dataset.alt;
        viewerTitle.textContent = button.dataset.title;
        viewerCount.textContent = `${currentPlate + 1} / ${plateButtons.length}`;
      };
      plateButtons.forEach((button, index) => button.addEventListener('click', () => {
        lastOpener = button;
        showPlate(index);
        viewer?.showModal();
      }));
      document.querySelector('#viewer-close')?.addEventListener('click', () => viewer?.close());
      document.querySelector('#viewer-prev')?.addEventListener('click', () => showPlate(currentPlate - 1));
      document.querySelector('#viewer-next')?.addEventListener('click', () => showPlate(currentPlate + 1));
      viewer?.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); });
      viewer?.addEventListener('close', () => lastOpener?.focus());
      viewer?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') showPlate(currentPlate - 1);
        if (event.key === 'ArrowRight') showPlate(currentPlate + 1);
      });
    </script>
