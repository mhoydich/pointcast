---
import {
  AFFILIATE_PATHS,
  BEACH_COMMONS_V8,
  BLANKET_OFFICIAL_CONTEXT,
  BLANKET_PICKS,
  BLANKET_SYSTEMS,
  MERCHANT_OFFERS,
  blanketSystemTotal,
  getBlanketPick,
} from '../../lib/beach-commons-v8';

const title = `${BEACH_COMMONS_V8.title} — ${BEACH_COMMONS_V8.subtitle}`;
const description = BEACH_COMMONS_V8.dek;
const canonical = BEACH_COMMONS_V8.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0521.png';
const tagLabels = {
  budget: 'Under $55',
  cotton: 'Cotton',
  dry: 'Damp ground',
  group: 'Group scale',
  pack: 'Tiny pack',
  sand: 'Sand behavior',
  warmth: 'Warmth',
};

const systems = BLANKET_SYSTEMS.map((system) => ({
  ...system,
  total: blanketSystemTotal(system),
  products: system.lines.map((line) => {
    const pick = getBlanketPick(line.id);
    return {
      ...line,
      name: pick?.name ?? line.id,
      maker: pick?.maker ?? '',
      unitPrice: pick?.priceUsd ?? 0,
      image: pick?.image ?? '',
      url: pick?.url ?? '#',
    };
  }),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  url: canonical,
  headline: BEACH_COMMONS_V8.title,
  alternativeHeadline: BEACH_COMMONS_V8.subtitle,
  description,
  datePublished: BEACH_COMMONS_V8.publishedAt,
  dateModified: BEACH_COMMONS_V8.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Beach Commons',
    url: 'https://pointcast.xyz/beach-commons',
  },
  isBasedOn: BEACH_COMMONS_V8.previousEdition.url,
  image: socialImage,
  author: BEACH_COMMONS_V8.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
  about: ['Beach blankets', 'Picnic blankets', 'Dockweiler State Beach', 'Affiliate disclosure'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f4efe4" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V8.jsonUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,800&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        --ink: #151817;
        --muted: #686861;
        --paper: #f4efe4;
        --white: #fffaf1;
        --red: #df472f;
        --blue: #0e6576;
        --yellow: #f0c94d;
        --green: #34664d;
        --lavender: #b9abd7;
        --line: rgba(21, 24, 23, .23);
        --serif: 'DM Serif Display', Georgia, serif;
        --sans: 'DM Sans', system-ui, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; overflow-x: hidden; background: var(--paper); color: var(--ink); font-family: var(--sans); }
      a { color: inherit; }
      img { display: block; max-width: 100%; }
      button { font: inherit; }
      [hidden] { display: none !important; }
      .skip {
        position: fixed; z-index: 500; top: 8px; left: 8px; transform: translateY(-160%);
        padding: 11px 14px; background: white; font: 700 10px/1 var(--mono);
      }
      .skip:focus { transform: translateY(0); }
      .mast {
        position: sticky; z-index: 100; top: 0; display: grid; grid-template-columns: 1fr auto auto auto;
        min-height: 54px; background: rgba(244, 239, 228, .95); border-bottom: 1px solid var(--ink);
        backdrop-filter: blur(14px);
      }
      .mast > * {
        display: flex; align-items: center; min-width: 0; padding: 0 20px; border-left: 1px solid var(--ink);
        font: 700 9px/1 var(--mono); letter-spacing: .12em; text-decoration: none; text-transform: uppercase; white-space: nowrap;
      }
      .mast .brand { border-left: 0; font: 800 14px/1 var(--sans); letter-spacing: .18em; }
      .mast a:hover, .mast a:focus-visible { background: var(--yellow); outline: 0; }
      .hero { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(460px, .98fr); min-height: calc(100svh - 54px); border-bottom: 1px solid var(--ink); }
      .hero__copy {
        display: flex; flex-direction: column; justify-content: space-between; gap: 70px;
        padding: clamp(34px, 5.2vw, 82px);
      }
      .stamp, .eyebrow, .micro { margin: 0; font: 700 10px/1.5 var(--mono); letter-spacing: .13em; text-transform: uppercase; }
      .stamp { color: var(--red); }
      .hero h1 { max-width: 950px; margin: 21px 0 28px; font: 400 clamp(68px, 10.2vw, 158px)/.72 var(--serif); letter-spacing: -.065em; }
      .hero h1 em { display: block; color: var(--blue); font-weight: 400; }
      .hero__dek { max-width: 720px; margin: 0; font-size: clamp(19px, 2vw, 28px); font-weight: 600; line-height: 1.15; }
      .hero__meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding-top: 22px; border-top: 1px solid var(--ink); }
      .hero__meta strong { display: block; margin-top: 6px; font: 400 31px/1 var(--serif); }
      .collage {
        display: grid; grid-template-columns: 1.05fr .95fr; grid-template-rows: 1fr .76fr 1.08fr;
        min-height: 650px; background: var(--ink);
      }
      .collage figure { position: relative; min-width: 0; margin: 0; overflow: hidden; border-left: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .collage figure:first-child { grid-row: span 2; }
      .collage figure:nth-child(4) { grid-column: span 2; }
      .collage img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
      .collage figure:hover img { transform: scale(1.025); }
      .collage figcaption {
        position: absolute; right: 10px; bottom: 10px; left: 10px; padding: 8px 9px;
        background: rgba(21,24,23,.82); color: white; font: 700 8px/1.35 var(--mono);
        letter-spacing: .08em; text-transform: uppercase;
      }
      .disclosure {
        display: grid; grid-template-columns: 240px 1fr; gap: clamp(28px, 6vw, 90px);
        padding: 30px max(5vw, calc((100vw - 1480px) / 2)); background: var(--yellow); border-bottom: 1px solid var(--ink);
      }
      .disclosure p { max-width: 1100px; margin: 0; font-size: 15px; font-weight: 600; line-height: 1.5; }
      .intro, .codes, .field {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(380px, .75fr); gap: clamp(50px, 8vw, 130px);
        padding: clamp(85px, 10vw, 150px) max(5vw, calc((100vw - 1480px) / 2)); border-bottom: 1px solid var(--ink);
      }
      .intro { background: var(--white); }
      .intro h2, .section-head h2, .codes h2, .field h2 {
        margin: 0; font: 400 clamp(54px, 8.3vw, 124px)/.8 var(--serif); letter-spacing: -.055em;
      }
      .intro__copy { align-self: end; }
      .intro__copy p { margin: 0 0 20px; font-size: clamp(17px, 1.45vw, 22px); line-height: 1.55; }
      .intro__copy p:last-child { margin-bottom: 0; }
      .systems, .desk, .compare, .affiliate, .rules {
        padding: clamp(82px, 10vw, 150px) max(5vw, calc((100vw - 1480px) / 2)); border-bottom: 1px solid var(--ink);
      }
      .systems { background: var(--paper); }
      .section-head { display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 40px; align-items: end; margin-bottom: 48px; }
      .section-head p { margin: 0; font-size: 18px; line-height: 1.45; }
      .system-console { display: grid; grid-template-columns: minmax(260px, .68fr) minmax(0, 1.32fr); border: 1px solid var(--ink); background: var(--white); }
      .system-tabs { border-right: 1px solid var(--ink); }
      .system-tab {
        width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 18px; padding: 21px;
        border: 0; border-bottom: 1px solid var(--ink); background: transparent; color: var(--ink); text-align: left; cursor: pointer;
      }
      .system-tab:last-child { border-bottom: 0; }
      .system-tab[aria-selected="true"] { background: var(--blue); color: white; }
      .system-tab:hover, .system-tab:focus-visible { background: var(--yellow); color: var(--ink); outline: 0; }
      .system-tab strong { font-size: 14px; }
      .system-tab span { font: 700 10px/1.3 var(--mono); }
      .system-panel { padding: clamp(28px, 5vw, 70px); }
      .system-panel__top { display: grid; grid-template-columns: 1fr auto; gap: 30px; padding-bottom: 26px; border-bottom: 1px solid var(--ink); }
      .system-panel h3 { max-width: 720px; margin: 8px 0 14px; font: 400 clamp(40px, 5vw, 76px)/.86 var(--serif); letter-spacing: -.045em; }
      .system-panel__dek { max-width: 670px; margin: 0; font-size: 17px; line-height: 1.45; }
      .system-total { min-width: 160px; text-align: right; }
      .system-total strong { display: block; font: 400 clamp(48px, 5vw, 74px)/.8 var(--serif); }
      .system-total span { font: 700 9px/1.4 var(--mono); text-transform: uppercase; }
      .system-products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding-top: 18px; }
      .system-line { display: grid; grid-template-columns: 64px 1fr auto; gap: 13px; align-items: center; min-width: 0; padding: 10px; background: var(--paper); border: 1px solid var(--line); }
      .system-line img { width: 64px; height: 64px; object-fit: cover; }
      .system-line a { font-size: 13px; font-weight: 800; line-height: 1.25; }
      .system-line b { font: 700 10px/1 var(--mono); }
      .system-assignment { margin: 22px 0 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
      .copy-button, .filter {
        min-height: 43px; padding: 0 14px; border: 1px solid var(--ink); background: transparent; color: var(--ink);
        font: 700 9px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
      }
      .copy-button { margin-top: 20px; }
      .copy-button:hover, .copy-button:focus-visible, .filter:hover, .filter:focus-visible, .filter[aria-pressed="true"] { background: var(--ink); color: white; outline: 0; }
      .desk { background: var(--white); }
      .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 30px; }
      .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .product {
        min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
        background: var(--paper);
      }
      .product__image { position: relative; aspect-ratio: 1.16; overflow: hidden; border-bottom: 1px solid var(--ink); background: #ddd5c6; }
      .product__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
      .product:hover .product__image img { transform: scale(1.025); }
      .product__price {
        position: absolute; top: 14px; right: 14px; padding: 8px 10px; background: var(--yellow); border: 1px solid var(--ink);
        font: 700 10px/1 var(--mono);
      }
      .product__credit {
        position: absolute; right: 8px; bottom: 8px; left: 8px; margin: 0; padding: 7px 8px;
        background: rgba(21,24,23,.8); color: white; font: 700 7px/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase;
      }
      .product__body { display: flex; flex: 1; flex-direction: column; padding: 24px; }
      .product__maker { margin: 0 0 7px; font: 700 9px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
      .product h3 { margin: 0 0 10px; font: 400 clamp(30px, 2.5vw, 44px)/.92 var(--serif); letter-spacing: -.035em; }
      .product__badge { margin: 0 0 22px; color: var(--red); font: 700 10px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .product__verdict { margin: 0 0 12px; font-size: 16px; font-weight: 800; line-height: 1.3; }
      .product__note, .product__caveat { margin: 0 0 14px; color: var(--muted); font-size: 13px; line-height: 1.5; }
      .product__caveat { color: #8a3427; }
      .specs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: 8px 0 22px; background: var(--line); border: 1px solid var(--line); }
      .specs div { min-width: 0; padding: 10px; background: var(--white); }
      .specs span { display: block; margin-bottom: 4px; color: var(--muted); font: 700 7px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .specs b { display: block; font-size: 11px; line-height: 1.25; }
      .product__link {
        display: inline-flex; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 18px;
        border-top: 1px solid var(--ink); font: 700 10px/1 var(--mono); letter-spacing: .07em; text-decoration: none; text-transform: uppercase;
      }
      .product__link:hover, .product__link:focus-visible { color: var(--red); outline: 0; }
      .compare { background: var(--blue); color: white; overflow: hidden; }
      .compare .section-head { margin-bottom: 34px; }
      .table-wrap { overflow-x: auto; border: 1px solid rgba(255,255,255,.55); }
      table { width: 100%; min-width: 1040px; border-collapse: collapse; }
      th, td { padding: 15px 13px; border-right: 1px solid rgba(255,255,255,.3); border-bottom: 1px solid rgba(255,255,255,.3); text-align: left; vertical-align: top; }
      th { background: rgba(0,0,0,.14); font: 700 9px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      td { font-size: 12px; line-height: 1.35; }
      td:first-child { font-weight: 800; }
      .codes { background: var(--lavender); }
      .codes__copy { align-self: end; }
      .codes__copy p { margin: 0 0 20px; font-size: 18px; line-height: 1.5; }
      .offer-list { display: grid; gap: 10px; margin-top: 26px; }
      .offer { padding: 16px; background: var(--white); border: 1px solid var(--ink); }
      .offer p { margin: 4px 0 0; font-size: 13px; }
      .offer a { font-weight: 800; }
      .affiliate { background: var(--paper); }
      .affiliate-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .affiliate-card { min-height: 270px; display: flex; flex-direction: column; padding: 22px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .affiliate-card h3 { margin: 10px 0 15px; font: 400 31px/1 var(--serif); }
      .affiliate-card p { margin: 0 0 18px; color: var(--muted); font-size: 13px; line-height: 1.5; }
      .affiliate-card a { margin-top: auto; font: 700 9px/1.3 var(--mono); text-transform: uppercase; }
      .field { background: var(--yellow); }
      .field__copy p { margin: 0 0 18px; font-size: 18px; line-height: 1.5; }
      .rules { background: var(--paper); }
      .rule-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 44px; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .rule { min-height: 260px; display: flex; flex-direction: column; padding: 22px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .rule h3 { margin: 12px 0 16px; font: 400 29px/1 var(--serif); }
      .rule p { margin: 0 0 22px; color: var(--muted); font-size: 13px; line-height: 1.5; }
      .rule a { margin-top: auto; font: 700 9px/1.3 var(--mono); text-transform: uppercase; }
      .footer { display: grid; grid-template-columns: 1fr auto auto auto; min-height: 82px; background: var(--ink); color: white; }
      .footer > * {
        display: flex; align-items: center; padding: 0 20px; border-left: 1px solid rgba(255,255,255,.25);
        font: 700 9px/1.3 var(--mono); letter-spacing: .09em; text-decoration: none; text-transform: uppercase;
      }
      .footer .footer__brand { border-left: 0; font-size: 13px; }
      .footer a:hover, .footer a:focus-visible { background: var(--red); outline: 0; }
      @media (max-width: 1120px) {
        .hero { grid-template-columns: 1fr; }
        .collage { min-height: 82vw; }
        .product-grid, .affiliate-grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 760px) {
        .mast { grid-template-columns: 1fr auto; }
        .mast .optional { display: none; }
        .mast > * { padding: 0 13px; }
        .hero__copy { padding: 34px 20px 48px; gap: 64px; }
        .hero h1 { font-size: clamp(68px, 23vw, 110px); }
        .hero__meta { grid-template-columns: 1fr 1fr; }
        .hero__meta > :last-child { grid-column: span 2; }
        .collage { min-height: 132vw; }
        .disclosure, .intro, .codes, .field { grid-template-columns: 1fr; padding-right: 20px; padding-left: 20px; }
        .section-head { grid-template-columns: 1fr; }
        .systems, .desk, .compare, .affiliate, .rules { padding-right: 20px; padding-left: 20px; }
        .system-console { grid-template-columns: 1fr; }
        .system-tabs { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--ink); }
        .system-tab { min-width: 210px; border-right: 1px solid var(--ink); border-bottom: 0; }
        .system-panel { padding: 28px 20px; }
        .system-panel__top { grid-template-columns: 1fr; }
        .system-total { text-align: left; }
        .system-products { grid-template-columns: 1fr; }
        .product-grid, .affiliate-grid, .rule-grid { grid-template-columns: 1fr; }
        .product__image { aspect-ratio: 1.1; }
        .footer { grid-template-columns: 1fr 1fr; }
        .footer > * { min-height: 60px; border-bottom: 1px solid rgba(255,255,255,.25); }
        .footer .footer__brand { grid-column: span 2; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the blanket review</a>
    <header class="mast">
      <a class="brand" href="/">POINTCAST</a>
      <a class="optional" href="#systems">7 systems</a>
      <a class="optional" href="#reviews">12 blankets</a>
      <a href="/beach-commons/v7">V7 ↙</a>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero__copy">
          <div>
            <p class="stamp">PointCast Shopping Desk · Field Study 008 · Price check 07.27.26</p>
            <h1>The Beach <em>Blanket Review</em></h1>
            <p class="hero__dek">{BEACH_COMMONS_V8.subtitle}</p>
          </div>
          <div class="hero__meta" aria-label="Edition summary">
            <div><span class="micro">Products</span><strong>12</strong></div>
            <div><span class="micro">Actual photos</span><strong>12</strong></div>
            <div><span class="micro">Affiliate earned</span><strong>$0</strong></div>
          </div>
        </div>
        <div class="collage" aria-label="Reviewed blanket product photographs">
          {[BLANKET_PICKS[4], BLANKET_PICKS[8], BLANKET_PICKS[7], BLANKET_PICKS[5]].map((pick) => (
            <figure>
              <img src={pick.image} alt={`${pick.maker} ${pick.name}`} width="960" height="960" />
              <figcaption>{pick.imageCredit} · editorial reference</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <aside class="disclosure" aria-label="Affiliate and photography disclosure">
        <p class="eyebrow">The clean link policy</p>
        <p>{BEACH_COMMONS_V8.affiliateBoundary} {BEACH_COMMONS_V8.photographyBoundary}</p>
      </aside>

      <section class="intro">
        <div>
          <p class="eyebrow">The verdict first</p>
          <h2>A blanket is either the floor, the softness, or a very expensive attempt at both.</h2>
        </div>
        <div class="intro__copy">
          <p>“Beach blanket” hides three jobs. A floor keeps damp and sand from moving upward. A top layer gives elbows, babies, dogs, cotton, color, and warmth somewhere to land. A social marker tells a scattered group: this is us.</p>
          <p>The best $100 experiment is therefore not one heroic blanket. It is a pair with different physics and two named owners. CGear plus Matador lands at exactly $99.99. An IKEA picnic base plus three washable throws lands at $99.96.</p>
          <p>Nothing here was hands-on tested by PointCast. The judgments come from current specifications, dimensions, weights, care instructions, materials, and beach use logic. {BEACH_COMMONS_V8.priceBoundary}</p>
        </div>
      </section>

      <section class="systems" id="systems">
        <div class="section-head">
          <div>
            <p class="eyebrow">Seven collective purchases</p>
            <h2>The systems</h2>
          </div>
          <p>Choose a path to see the stack and the human assignment. Every total is computed from the review ledger before tax and shipping.</p>
        </div>
        <div class="system-console" data-system-console>
          <div class="system-tabs" role="tablist" aria-label="Blanket systems">
            {systems.map((system, index) => (
              <button
                class="system-tab"
                type="button"
                role="tab"
                id={`system-tab-${system.id}`}
                aria-controls="system-panel"
                aria-selected={index === 0 ? 'true' : 'false'}
                data-system-id={system.id}
              >
                <strong>{system.eyebrow}</strong>
                <span>${system.total.toFixed(2)}</span>
              </button>
            ))}
          </div>
          <div class="system-panel" id="system-panel" role="tabpanel" aria-live="polite" aria-labelledby={`system-tab-${systems[0].id}`}>
            <div class="system-panel__top">
              <div>
                <p class="eyebrow" data-system-eyebrow>{systems[0].eyebrow}</p>
                <h3 data-system-name>{systems[0].name}</h3>
                <p class="system-panel__dek" data-system-dek>{systems[0].dek}</p>
              </div>
              <div class="system-total">
                <strong data-system-total>${systems[0].total.toFixed(2)}</strong>
                <span data-system-people>{systems[0].people}</span>
              </div>
            </div>
            <div class="system-products" data-system-products>
              {systems[0].products.map((product) => (
                <div class="system-line">
                  <img src={product.image} alt="" width="64" height="64" />
                  <a href={product.url} target="_blank" rel="nofollow noopener">{product.quantity}× {product.maker} {product.name}</a>
                  <b>${(product.unitPrice * product.quantity).toFixed(2)}</b>
                </div>
              ))}
            </div>
            <p class="system-assignment" data-system-assignment>{systems[0].assignment}</p>
            <button class="copy-button" type="button" data-copy-system>Copy this system</button>
          </div>
        </div>
      </section>

      <section class="desk" id="reviews">
        <div class="section-head">
          <div>
            <p class="eyebrow">Twelve current products · twelve credited photographs</p>
            <h2>The reviews</h2>
          </div>
          <p>Use the problem buttons—not a vibe—to narrow the field. Every card says what the blanket cannot do as plainly as what it can.</p>
        </div>
        <div class="filters" aria-label="Filter blanket reviews">
          <button class="filter" type="button" aria-pressed="true" data-filter="all">All 12</button>
          {Object.entries(tagLabels).map(([key, label]) => (
            <button class="filter" type="button" aria-pressed="false" data-filter={key}>{label}</button>
          ))}
        </div>
        <div class="product-grid">
          {BLANKET_PICKS.map((pick, index) => (
            <article class="product" data-tags={pick.tags.join(' ')}>
              <div class="product__image">
                <img src={pick.image} alt={`${pick.maker} ${pick.name}`} width="960" height="960" loading={index < 3 ? 'eager' : 'lazy'} />
                <span class="product__price">{pick.priceLabel}</span>
                <p class="product__credit">{pick.imageCredit} · editorial reference</p>
              </div>
              <div class="product__body">
                <p class="product__maker">{String(index + 1).padStart(2, '0')} / 12 · {pick.maker} · {pick.availability.replace('-', ' ')}</p>
                <h3>{pick.name}</h3>
                <p class="product__badge">{pick.badge}</p>
                <p class="product__verdict">{pick.verdict}</p>
                <p class="product__note">{pick.fieldNote}</p>
                <div class="specs" aria-label={`${pick.name} specifications`}>
                  <div><span>Size</span><b>{pick.dimensions}</b></div>
                  <div><span>Weight</span><b>{pick.weight}</b></div>
                  <div><span>Ground</span><b>{pick.waterproof}</b></div>
                  <div><span>Care</span><b>{pick.wash}</b></div>
                  <div><span>Anchor</span><b>{pick.anchors}</b></div>
                  <div><span>Price</span><b>{pick.priceLabel}</b></div>
                </div>
                <p class="product__caveat">Tradeoff: {pick.caveat}</p>
                <a class="product__link" href={pick.url} target="_blank" rel="nofollow noopener">
                  <span>Open plain merchant link</span><span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="compare">
        <div class="section-head">
          <div>
            <p class="eyebrow">The honest wall chart</p>
            <h2>Compare the physics</h2>
          </div>
          <p>Scroll sideways on a phone. “Water-resistant” remains different from “waterproof,” and no maker gets upgraded by editorial enthusiasm.</p>
        </div>
        <div class="table-wrap" tabindex="0" aria-label="Scrollable blanket comparison table">
          <table>
            <thead>
              <tr><th>Blanket</th><th>Price</th><th>Size</th><th>Weight</th><th>Ground behavior</th><th>Care</th><th>Anchoring</th></tr>
            </thead>
            <tbody>
              {BLANKET_PICKS.map((pick) => (
                <tr>
                  <td>{pick.maker} {pick.name}</td><td>{pick.priceLabel}</td><td>{pick.dimensions}</td><td>{pick.weight}</td>
                  <td>{pick.waterproof}</td><td>{pick.wash}</td><td>{pick.anchors}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="codes">
        <div>
          <p class="eyebrow">Codes, without theater</p>
          <h2>No PointCast code yet.</h2>
        </div>
        <div class="codes__copy">
          <p>There is no verified PointCast affiliate ID, creator code, or referral parameter to publish. Two makers currently advertise first-order signup offers. These are merchant offers—not PointCast codes—and may require email or SMS consent or change without notice.</p>
          <p>That means the honest move today is a normal product link. If PointCast later enrolls, the page should add a conspicuous “PointCast may earn” disclosure before changing a single URL.</p>
          <div class="offer-list">
            {MERCHANT_OFFERS.map((offer) => (
              <div class="offer">
                <p class="micro">{offer.maker} · checked {offer.checkedAt}</p>
                <p><strong>{offer.offer}</strong> {offer.code}. <a href={offer.url} target="_blank" rel="nofollow noopener">Current merchant terms ↗</a></p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="affiliate">
        <div class="section-head">
          <div>
            <p class="eyebrow">Application-ready, not enrolled</p>
            <h2>The affiliate ledger</h2>
          </div>
          <p>These are official public paths that could support future editorial revenue. They are not permission to add tracking today.</p>
        </div>
        <div class="affiliate-grid">
          {AFFILIATE_PATHS.map((program) => (
            <article class="affiliate-card">
              <p class="micro">{program.status}</p>
              <h3>{program.maker}</h3>
              <p>{program.terms}</p>
              <a href={program.url} target="_blank" rel="nofollow noopener">Open official program path ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="field">
        <div>
          <p class="eyebrow">A useful beach arrangement</p>
          <h2>Make an archipelago, not a carpet.</h2>
        </div>
        <div class="field__copy">
          <p>Put down two or three small rooms with visible sand lanes between them. One is the dry home base, one is the quiet edge, and one can move toward moon, coffee, music, or conversation. The open lanes keep circulation legible and make teardown countable.</p>
          <p>Near a fire ring, every textile stays outside the ember and steward zone. Cotton can scorch; synthetics can melt. No blanket is fire protection, and no pretty layout changes the current beach rules.</p>
          <p>{BEACH_COMMONS_V8.fieldBoundary}</p>
        </div>
      </section>

      <section class="rules">
        <div class="section-head">
          <div>
            <p class="eyebrow">Before product becomes place</p>
            <h2>Read the beach</h2>
          </div>
          <p>Plan around the access already present, leave habitat alone, and re-check current conditions on the day. A shopping list is not an event permit.</p>
        </div>
        <div class="rule-grid">
          {BLANKET_OFFICIAL_CONTEXT.map((item, index) => (
            <article class="rule">
              <p class="micro">Official source {String(index + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p>{item.note}</p>
              <a href={item.url} target="_blank" rel="noopener">Open official page ↗</a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="footer">
      <span class="footer__brand">POINTCAST · BEACH COMMONS V8</span>
      <a href="/beach-commons/v8.json">Machine edition</a>
      <a href="/b/0521">Block 0521</a>
      <a href="/beach-commons/v7">Previous edition</a>
    </footer>

    <script id="system-data" type="application/json" set:html={JSON.stringify(systems)} />
    <script is:inline>
      const systems = JSON.parse(document.getElementById('system-data')?.textContent || '[]');
      const systemById = new Map(systems.map((system) => [system.id, system]));
      const panel = document.getElementById('system-panel');
      let currentSystem = systems[0];

      function money(value) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
      }

      function systemLine(product) {
        const line = document.createElement('div');
        line.className = 'system-line';
        const image = document.createElement('img');
        image.src = product.image;
        image.alt = '';
        image.width = 64;
        image.height = 64;
        const link = document.createElement('a');
        link.href = product.url;
        link.target = '_blank';
        link.rel = 'nofollow noopener';
        link.textContent = `${product.quantity}× ${product.maker} ${product.name}`;
        const subtotal = document.createElement('b');
        subtotal.textContent = money(product.unitPrice * product.quantity);
        line.append(image, link, subtotal);
        return line;
      }

      function renderSystem(system, tab) {
        if (!system || !panel) return;
        currentSystem = system;
        document.querySelectorAll('[data-system-id]').forEach((button) => {
          button.setAttribute('aria-selected', String(button === tab));
        });
        panel.setAttribute('aria-labelledby', tab.id);
        panel.querySelector('[data-system-eyebrow]').textContent = system.eyebrow;
        panel.querySelector('[data-system-name]').textContent = system.name;
        panel.querySelector('[data-system-dek]').textContent = system.dek;
        panel.querySelector('[data-system-total]').textContent = money(system.total);
        panel.querySelector('[data-system-people]').textContent = system.people;
        panel.querySelector('[data-system-assignment]').textContent = system.assignment;
        panel.querySelector('[data-system-products]').replaceChildren(...system.products.map(systemLine));
      }

      document.querySelector('[data-system-console]')?.addEventListener('click', (event) => {
        const tab = event.target.closest('[data-system-id]');
        if (!tab) return;
        renderSystem(systemById.get(tab.dataset.systemId), tab);
      });

      document.querySelector('[data-copy-system]')?.addEventListener('click', async (event) => {
        if (!currentSystem) return;
        const lines = [
          currentSystem.name,
          `${money(currentSystem.total)} before tax and shipping`,
          '',
          ...currentSystem.products.map((product) => `${product.quantity} × ${product.maker} ${product.name} — ${money(product.unitPrice * product.quantity)} — ${product.url}`),
          '',
          currentSystem.assignment,
          'PointCast Beach Blanket Review — prices checked 2026-07-27 — plain merchant links, no affiliate tracking.',
        ];
        const button = event.currentTarget;
        try {
          await navigator.clipboard.writeText(lines.join('\n'));
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Copy unavailable';
        }
        window.setTimeout(() => { button.textContent = 'Copy this system'; }, 1800);
      });

      document.querySelector('.filters')?.addEventListener('click', (event) => {
        const filter = event.target.closest('[data-filter]');
        if (!filter) return;
        const tag = filter.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button === filter));
        });
        document.querySelectorAll('[data-tags]').forEach((product) => {
          product.hidden = tag !== 'all' && !product.dataset.tags.split(' ').includes(tag);
        });
      });
    </script>
  </body>
</html>
