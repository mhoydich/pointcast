---
import {
  BEACH_COMMONS_V11,
  REACH_DIMENSIONS,
  REACH_LINE_PLATES,
  REACH_LINE_ROLES,
  REACH_LINE_RULES,
  REACH_LINE_SOURCES,
  REACH_PATHS,
} from '../../lib/beach-commons-v11';

const title = `${BEACH_COMMONS_V11.title} — ${BEACH_COMMONS_V11.subtitle}`;
const description = BEACH_COMMONS_V11.dek;
const canonical = BEACH_COMMONS_V11.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0531.png';
const hero = REACH_LINE_PLATES[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  '@id': `${canonical}#field-study`,
  url: canonical,
  name: title,
  description,
  datePublished: BEACH_COMMONS_V11.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Field Study',
    url: 'https://pointcast.xyz',
  },
  isBasedOn: BEACH_COMMONS_V11.previousEdition.url,
  mainEntityOfPage: BEACH_COMMONS_V11.jsonUrl,
  image: REACH_LINE_PLATES.map((plate) => new URL(plate.image, canonical).href),
  creator: BEACH_COMMONS_V11.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
  about: [
    'Community relay',
    'Analog measurement',
    'Continuous custody',
    'Inclusive play',
    'Dockweiler State Beach',
    'Marvin Braude Bike Trail',
    'Temporary coastal gathering',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ff633f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V11.jsonUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>{title}</title>
    <style>
      :root {
        --navy: #08233f;
        --navy-2: #12395e;
        --orange: #ff633f;
        --pink: #ff9db5;
        --blue: #155de9;
        --sand: #f3e7cc;
        --paper: #fffaf0;
        --mist: #d9e4e5;
        --ink: #121716;
        --line: rgba(18, 23, 22, .24);
        --sans: "Helvetica Neue", Helvetica, Arial, sans-serif;
        --serif: Georgia, "Times New Roman", serif;
        --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--paper); color: var(--ink); }
      body { margin: 0; font-family: var(--sans); }
      img { display: block; width: 100%; height: auto; }
      button, input { font: inherit; }
      a { color: inherit; }
      .skip {
        position: fixed;
        z-index: 1000;
        top: 10px;
        left: 10px;
        padding: 12px 16px;
        transform: translateY(-150%);
        background: white;
        color: var(--ink);
        border: 2px solid var(--ink);
      }
      .skip:focus { transform: none; }
      .head {
        position: sticky;
        z-index: 20;
        top: 0;
        display: grid;
        grid-template-columns: 1fr auto auto auto auto;
        min-height: 58px;
        background: rgba(8, 35, 63, .96);
        color: white;
        border-bottom: 1px solid rgba(255,255,255,.35);
        backdrop-filter: blur(16px);
      }
      .head a {
        display: flex;
        align-items: center;
        padding: 0 18px;
        border-left: 1px solid rgba(255,255,255,.25);
        font: 800 10px/1 var(--mono);
        letter-spacing: .1em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .head a:first-child { border-left: 0; }
      .head a:hover, .head a:focus-visible { background: var(--orange); color: var(--ink); outline: 0; }
      .head .brand { font-size: 14px; }
      .hero {
        position: relative;
        min-height: min(900px, calc(100svh - 58px));
        display: flex;
        align-items: end;
        overflow: hidden;
        background: var(--navy);
        color: white;
      }
      .hero__image, .hero__wash, .hero__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
      .hero__image { object-fit: cover; }
      .hero__wash {
        background:
          linear-gradient(180deg, rgba(8,35,63,.08) 15%, rgba(8,35,63,.15) 42%, rgba(8,35,63,.96) 100%),
          linear-gradient(90deg, rgba(8,35,63,.72), transparent 66%);
      }
      .hero__lines {
        opacity: .32;
        background-image:
          linear-gradient(90deg, transparent calc(25% - .5px), white 25%, transparent calc(25% + .5px)),
          linear-gradient(90deg, transparent calc(50% - .5px), white 50%, transparent calc(50% + .5px)),
          linear-gradient(90deg, transparent calc(75% - .5px), white 75%, transparent calc(75% + .5px));
      }
      .hero__copy {
        position: relative;
        z-index: 2;
        width: 100%;
        padding: clamp(36px, 6vw, 94px) max(5vw, calc((100vw - 1500px) / 2));
      }
      .kicker {
        margin: 0 0 22px;
        font: 800 10px/1.3 var(--mono);
        letter-spacing: .16em;
        text-transform: uppercase;
      }
      .hero h1 {
        max-width: 1200px;
        margin: 0;
        font: 800 clamp(72px, 13vw, 206px)/.69 var(--sans);
        letter-spacing: -.09em;
        text-transform: uppercase;
      }
      .hero h1 span { color: var(--orange); }
      .hero__bottom {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 30px;
        align-items: end;
        margin-top: 42px;
      }
      .hero__dek { max-width: 820px; margin: 0; font: 400 clamp(21px, 2.4vw, 38px)/1.08 var(--serif); }
      .hero__button {
        min-height: 55px;
        display: inline-flex;
        align-items: center;
        padding: 0 20px;
        background: var(--orange);
        color: var(--ink);
        border: 1px solid var(--orange);
        font: 800 10px/1 var(--mono);
        text-decoration: none;
        text-transform: uppercase;
      }
      .hero__button:hover, .hero__button:focus-visible { background: white; border-color: white; outline: 0; }
      .ticker {
        display: flex;
        overflow: hidden;
        background: var(--orange);
        border-bottom: 1px solid var(--ink);
        white-space: nowrap;
      }
      .ticker span {
        padding: 17px 22px;
        border-right: 1px solid var(--ink);
        font: 800 10px/1 var(--mono);
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      .manifesto, .plates, .game, .paths, .roles, .sources {
        padding: clamp(80px, 11vw, 170px) max(5vw, calc((100vw - 1500px) / 2));
      }
      .manifesto {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr);
        gap: clamp(45px, 9vw, 150px);
        background: var(--sand);
        border-bottom: 1px solid var(--ink);
      }
      .display-title { margin: 0; font: 400 clamp(58px, 8.4vw, 132px)/.79 var(--serif); letter-spacing: -.06em; }
      .display-title em { color: var(--orange); font-weight: 400; }
      .manifesto__copy { align-self: end; }
      .manifesto__copy p { margin: 0 0 23px; font-size: clamp(17px, 1.5vw, 23px); line-height: 1.42; }
      .manifesto__copy strong { color: var(--blue); }
      .score-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        background: var(--navy);
        color: white;
        border-bottom: 1px solid var(--ink);
      }
      .dimension { min-height: 270px; padding: 27px; border-right: 1px solid rgba(255,255,255,.32); }
      .dimension:last-child { border-right: 0; }
      .dimension__no { font: 800 9px/1 var(--mono); color: var(--pink); }
      .dimension h2 { margin: 40px 0 7px; font: 800 clamp(37px, 4vw, 58px)/.9 var(--sans); letter-spacing: -.05em; }
      .dimension small { font: 800 9px/1.4 var(--mono); text-transform: uppercase; color: var(--orange); }
      .dimension p { margin: 25px 0 0; color: rgba(255,255,255,.68); font-size: 13px; line-height: 1.5; }
      .plates { background: var(--paper); }
      .section-head { display: grid; grid-template-columns: 1fr minmax(260px, 440px); gap: 40px; align-items: end; margin-bottom: 55px; }
      .section-head h2 { margin: 0; font: 400 clamp(54px, 8vw, 118px)/.78 var(--serif); letter-spacing: -.05em; }
      .section-head p { margin: 0; font-size: 15px; line-height: 1.5; }
      .plate-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .plate { min-width: 0; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .plate__image-button {
        position: relative;
        width: 100%;
        display: block;
        padding: 0;
        overflow: hidden;
        background: var(--navy);
        border: 0;
        border-bottom: 1px solid var(--ink);
        cursor: zoom-in;
      }
      .plate__image-button img { aspect-ratio: 3 / 2; object-fit: cover; transition: transform .35s ease; }
      .plate__image-button:hover img, .plate__image-button:focus-visible img { transform: scale(1.018); }
      .plate__image-button:focus-visible { outline: 5px solid var(--blue); outline-offset: -5px; }
      .plate__zoom {
        position: absolute;
        right: 13px;
        bottom: 13px;
        padding: 9px 11px;
        background: var(--paper);
        border: 1px solid var(--ink);
        font: 800 8px/1 var(--mono);
        text-transform: uppercase;
      }
      .plate__copy { min-height: 340px; display: flex; flex-direction: column; padding: clamp(24px, 4vw, 48px); }
      .plate__top { display: flex; justify-content: space-between; gap: 20px; font: 800 9px/1 var(--mono); text-transform: uppercase; }
      .plate h3 { margin: 46px 0 14px; font: 400 clamp(37px, 4vw, 61px)/.85 var(--serif); letter-spacing: -.04em; }
      .plate__thesis { margin: 0 0 34px; color: var(--blue); font-size: 16px; font-weight: 800; }
      .plate dl { display: grid; grid-template-columns: 90px 1fr; gap: 12px 18px; margin: auto 0 0; font-size: 12px; line-height: 1.5; }
      .plate dt { font: 800 8px/1.5 var(--mono); text-transform: uppercase; }
      .plate dd { margin: 0; color: #565b57; }
      .game {
        background: var(--orange);
        border-bottom: 1px solid var(--ink);
      }
      .game__intro { display: grid; grid-template-columns: 1fr minmax(300px, 500px); gap: 50px; align-items: end; }
      .game__intro h2 { margin: 0; font: 800 clamp(67px, 10vw, 155px)/.7 var(--sans); letter-spacing: -.08em; text-transform: uppercase; }
      .game__intro p { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.45; }
      .meter {
        display: grid;
        grid-template-columns: minmax(300px, .75fr) minmax(0, 1.25fr);
        margin-top: 55px;
        background: var(--navy);
        color: white;
        border: 1px solid var(--ink);
        box-shadow: 14px 14px 0 var(--pink);
      }
      .meter__controls { padding: clamp(25px, 5vw, 64px); border-right: 1px solid rgba(255,255,255,.32); }
      .meter__label { display: block; margin: 0 0 10px; font: 800 9px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
      .mode-row { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 30px; }
      .mode-button, .meter__button {
        min-height: 50px;
        padding: 0 15px;
        background: transparent;
        color: white;
        border: 1px solid rgba(255,255,255,.42);
        font: 800 9px/1.25 var(--mono);
        letter-spacing: .08em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .mode-button + .mode-button { border-left: 0; }
      .mode-button[aria-pressed="true"] { background: var(--pink); color: var(--ink); border-color: var(--pink); }
      .mode-button:hover, .mode-button:focus-visible, .meter__button:hover, .meter__button:focus-visible { background: white; color: var(--ink); outline: 0; }
      .distance-wrap { display: grid; grid-template-columns: 1fr auto; margin-bottom: 25px; }
      .distance-wrap input {
        min-width: 0;
        height: 62px;
        padding: 0 18px;
        background: var(--paper);
        color: var(--ink);
        border: 0;
        font: 800 24px/1 var(--mono);
      }
      .distance-wrap span { display: flex; align-items: center; padding: 0 17px; background: var(--mist); color: var(--ink); font: 800 9px/1 var(--mono); text-transform: uppercase; }
      .pass-button {
        width: 100%;
        min-height: 96px;
        background: var(--orange);
        color: var(--ink);
        border: 0;
        font: 800 clamp(31px, 4vw, 58px)/1 var(--sans);
        letter-spacing: -.05em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .pass-button:hover, .pass-button:focus-visible { background: white; outline: 4px solid var(--pink); }
      .meter__secondary { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 12px; }
      .meter__secondary .meter__button + .meter__button { border-left: 0; }
      .meter__secondary--two { grid-template-columns: 1fr 1fr; margin-top: 0; }
      .meter__secondary--two .meter__button { border-top: 0; }
      .meter__note { margin: 24px 0 0; color: rgba(255,255,255,.63); font-size: 12px; line-height: 1.5; }
      .meter__readout { display: flex; flex-direction: column; min-width: 0; padding: clamp(25px, 5vw, 64px); }
      .readout-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(255,255,255,.35); border-left: 1px solid rgba(255,255,255,.35); }
      .readout { min-height: 170px; padding: 22px; border-right: 1px solid rgba(255,255,255,.35); border-bottom: 1px solid rgba(255,255,255,.35); }
      .readout span { font: 800 9px/1 var(--mono); color: var(--pink); text-transform: uppercase; }
      .readout strong { display: block; margin-top: 31px; font: 800 clamp(40px, 5vw, 76px)/.8 var(--sans); letter-spacing: -.07em; }
      .readout small { display: block; margin-top: 10px; color: rgba(255,255,255,.55); font: 800 8px/1 var(--mono); text-transform: uppercase; }
      .custody {
        margin-top: 18px;
        padding: 22px;
        background: var(--pink);
        color: var(--ink);
        border: 1px solid var(--pink);
      }
      .custody span { font: 800 8px/1 var(--mono); text-transform: uppercase; }
      .custody strong { display: block; margin-top: 8px; font: 800 clamp(30px, 4vw, 56px)/.9 var(--sans); letter-spacing: -.05em; }
      .meter__status { min-height: 50px; margin: auto 0 0; padding-top: 30px; color: rgba(255,255,255,.72); font: 700 11px/1.5 var(--mono); }
      .paths { background: var(--sand); border-bottom: 1px solid var(--ink); }
      .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 55px; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .path { min-height: 430px; display: flex; flex-direction: column; padding: clamp(25px, 4vw, 50px); border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .path small { font: 800 9px/1 var(--mono); color: var(--blue); text-transform: uppercase; }
      .path h3 { margin: auto 0 20px; font: 400 clamp(41px, 4vw, 62px)/.82 var(--serif); letter-spacing: -.05em; }
      .path p { margin: 0; color: #555b57; font-size: 14px; line-height: 1.55; }
      .roles { background: var(--mist); border-bottom: 1px solid var(--ink); }
      .role-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 55px; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .role { min-height: 270px; padding: 24px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .role span { font: 800 9px/1 var(--mono); color: var(--blue); }
      .role h3 { margin: 65px 0 18px; font: 400 35px/.9 var(--serif); }
      .role p { margin: 0; color: #4d5756; font-size: 13px; line-height: 1.5; }
      .rules {
        padding: clamp(80px, 11vw, 170px) max(5vw, calc((100vw - 1500px) / 2));
        background: var(--navy);
        color: white;
        border-bottom: 1px solid rgba(255,255,255,.35);
      }
      .rule-list { margin: 55px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,.34); }
      .rule-list li { display: grid; grid-template-columns: 70px 1fr; gap: 22px; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.34); font: 700 clamp(17px, 1.7vw, 25px)/1.3 var(--sans); }
      .rule-list b { color: var(--orange); font: 800 11px/1.4 var(--mono); }
      .sources { background: var(--paper); border-bottom: 1px solid var(--ink); }
      .source-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 55px; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
      .source { min-height: 260px; display: flex; flex-direction: column; padding: 24px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .source h3 { margin: 28px 0 15px; font: 400 30px/.95 var(--serif); }
      .source p { margin: 0; color: #5c625f; font-size: 13px; line-height: 1.5; }
      .source a { margin-top: auto; font: 800 9px/1 var(--mono); text-transform: uppercase; }
      .source a:hover, .source a:focus-visible { color: var(--blue); outline: 0; }
      .boundary {
        padding: clamp(70px, 10vw, 145px) max(5vw, calc((100vw - 1500px) / 2));
        background: var(--orange);
        border-bottom: 1px solid var(--ink);
      }
      .boundary h2 { max-width: 1100px; margin: 0 0 35px; font: 400 clamp(56px, 8vw, 125px)/.78 var(--serif); letter-spacing: -.06em; }
      .boundary p { max-width: 1050px; margin: 0; font-size: clamp(17px, 1.6vw, 23px); font-weight: 700; line-height: 1.5; }
      .boundary__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 38px; }
      .boundary__links a { padding: 14px 16px; background: var(--paper); border: 1px solid var(--ink); font: 800 9px/1 var(--mono); text-decoration: none; text-transform: uppercase; }
      .boundary__links a:hover, .boundary__links a:focus-visible { background: var(--navy); color: white; outline: 0; }
      .footer { display: grid; grid-template-columns: 1fr auto auto auto; min-height: 80px; background: var(--ink); color: white; }
      .footer > * { display: flex; align-items: center; padding: 0 20px; border-left: 1px solid rgba(255,255,255,.25); font: 800 9px/1.3 var(--mono); text-decoration: none; text-transform: uppercase; }
      .footer > *:first-child { border-left: 0; }
      .footer a:hover, .footer a:focus-visible { background: var(--pink); color: var(--ink); outline: 0; }
      .viewer {
        width: min(1500px, calc(100vw - 28px));
        max-width: none;
        margin: auto;
        padding: 0;
        overflow: hidden;
        background: var(--navy);
        color: white;
        border: 1px solid rgba(255,255,255,.4);
      }
      .viewer::backdrop { background: rgba(3, 12, 23, .94); backdrop-filter: blur(9px); }
      .viewer__top { display: grid; grid-template-columns: 1fr auto; align-items: center; min-height: 58px; border-bottom: 1px solid rgba(255,255,255,.3); }
      .viewer__title { margin: 0; padding: 0 18px; font: 800 10px/1.4 var(--mono); text-transform: uppercase; }
      .viewer__close { align-self: stretch; min-width: 66px; background: transparent; color: white; border: 0; border-left: 1px solid rgba(255,255,255,.3); cursor: pointer; }
      .viewer__close:hover, .viewer__close:focus-visible { background: var(--orange); color: var(--ink); outline: 0; }
      .viewer__image { max-height: calc(100svh - 90px); object-fit: contain; background: #03101d; }
      @media (max-width: 1050px) {
        .score-strip, .role-grid { grid-template-columns: 1fr 1fr; }
        .dimension:nth-child(2) { border-right: 0; }
        .dimension:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,.32); }
        .meter { grid-template-columns: 1fr; }
        .meter__controls { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.32); }
      }
      @media (max-width: 780px) {
        .head { grid-template-columns: 1fr auto; }
        .head .optional { display: none; }
        .hero { min-height: 760px; }
        .hero__copy { padding-right: 20px; padding-left: 20px; }
        .hero h1 { font-size: clamp(70px, 26vw, 125px); }
        .hero__bottom, .manifesto, .section-head, .game__intro { grid-template-columns: 1fr; }
        .hero__button { width: max-content; }
        .manifesto, .plates, .game, .paths, .roles, .rules, .sources, .boundary { padding-right: 20px; padding-left: 20px; }
        .plate-grid, .path-grid, .source-grid { grid-template-columns: 1fr; }
        .plate__copy { min-height: 0; }
        .path { min-height: 340px; }
        .footer { grid-template-columns: 1fr 1fr; }
        .footer > * { min-height: 58px; border-bottom: 1px solid rgba(255,255,255,.25); }
        .footer > *:first-child { grid-column: span 2; }
      }
      @media (max-width: 520px) {
        .score-strip, .role-grid, .readout-grid { grid-template-columns: 1fr; }
        .dimension { min-height: 220px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.32); }
        .dimension:last-child { border-bottom: 0; }
        .readout { min-height: 145px; }
        .meter__secondary { grid-template-columns: 1fr; }
        .meter__secondary .meter__button + .meter__button { border-left: 1px solid rgba(255,255,255,.42); border-top: 0; }
        .meter__secondary--two { grid-template-columns: 1fr 1fr; }
        .meter__secondary--two .meter__button + .meter__button { border-left: 0; }
        .plate dl { grid-template-columns: 1fr; }
        .plate dt { margin-top: 10px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to The Reach Line</a>
    <header class="head">
      <a class="brand" href="/">PointCast</a>
      <a class="optional" href="#plates">Eight plates</a>
      <a class="optional" href="#meter">Reach Meter</a>
      <a class="optional" href="#paths">Three paths</a>
      <a href="/beach-commons/v11.json">JSON ↗</a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="title">
        <img class="hero__image" src={hero.image} alt={hero.alt} width="1536" height="1024" fetchpriority="high" />
        <div class="hero__wash"></div>
        <div class="hero__lines"></div>
        <div class="hero__copy">
          <p class="kicker">PointCast Field Study 011 · unofficial concept · the Pacific is zero</p>
          <h1 id="title">The <span>Reach</span> Line</h1>
          <div class="hero__bottom">
            <p class="hero__dek">{BEACH_COMMONS_V11.dek}</p>
            <a class="hero__button" href="#meter">Start a local rehearsal ↓</a>
          </div>
        </div>
      </section>

      <div class="ticker" aria-label="The Reach Line principles">
        <span>Two hands → two hands</span>
        <span>One soft baton</span>
        <span>Four honest measures</span>
        <span>Pause is part of the game</span>
        <span>No live tracking</span>
        <span>Return to the Pacific</span>
      </div>

      <section class="manifesto">
        <h2 class="display-title">The distance is not speed.<br /><em>It is trust.</em></h2>
        <div class="manifesto__copy">
          <p>
            Start at the beach with one oversized padded baton. Pass it from
            two people to two people. Let the line move by armspan, by hosted
            station, perhaps someday by coastline.
          </p>
          <p>
            <strong>{BEACH_COMMONS_V11.custodyRule}</strong>
          </p>
          <p>
            The score asks something gentler than who won:
            <em>{BEACH_COMMONS_V11.question}</em>
          </p>
        </div>
      </section>

      <section class="score-strip" aria-label="Four honest relay measures">
        {REACH_DIMENSIONS.map((dimension, index) => (
          <article class="dimension">
            <span class="dimension__no">{String(index + 1).padStart(2, '0')}</span>
            <h2>{dimension.title}</h2>
            <small>{dimension.unit}</small>
            <p>{dimension.method}</p>
          </article>
        ))}
      </section>

      <section class="plates" id="plates" aria-labelledby="plates-title">
        <header class="section-head">
          <h2 id="plates-title">Eight ways<br />to carry it.</h2>
          <p>
            From one armspan to a coast-length dream, each plate makes one
            piece of the game visible—and gives the safest pause equal status
            with the most beautiful handoff.
          </p>
        </header>
        <div class="plate-grid">
          {REACH_LINE_PLATES.map((plate) => (
            <article class="plate">
              <button
                class="plate__image-button"
                type="button"
                data-view-image={plate.image}
                data-view-title={`${plate.number} · ${plate.title}`}
                aria-label={`Open full image: ${plate.title}`}
              >
                <img src={plate.image} alt={plate.alt} width="1536" height="1024" loading="lazy" />
                <span class="plate__zoom">Full plate ↗</span>
              </button>
              <div class="plate__copy">
                <div class="plate__top">
                  <span>{plate.number}</span>
                  <span>{plate.id}</span>
                </div>
                <h3>{plate.title}</h3>
                <p class="plate__thesis">{plate.thesis}</p>
                <dl>
                  <dt>Measure</dt>
                  <dd>{plate.measure}</dd>
                  <dt>Boundary</dt>
                  <dd>{plate.safety}</dd>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="game" id="meter" aria-labelledby="meter-title">
        <div class="game__intro">
          <h2 id="meter-title">Reach<br />Meter</h2>
          <p>
            A browser-local rehearsal, not a live event counter. Enter one
            measured handoff or safe station leg, pass the baton, turn it home,
            and see whether one continuous chain can return to zero.
          </p>
        </div>
        <div class="meter">
          <div class="meter__controls">
            <span class="meter__label">01 · Choose the pass</span>
            <div class="mode-row">
              <button class="mode-button" type="button" data-mode="armspan" aria-pressed="true">One armspan</button>
              <button class="mode-button" type="button" data-mode="station" aria-pressed="false">Station leg</button>
            </div>
            <label class="meter__label" for="reach-distance" id="distance-label">02 · Measured handoff gap</label>
            <div class="distance-wrap">
              <input id="reach-distance" type="number" min="0.1" max="100000" step="0.1" inputmode="decimal" value="1.5" />
              <span>meters</span>
            </div>
            <button class="pass-button" id="pass-button" type="button">Pass →</button>
            <div class="meter__secondary">
              <button class="meter__button" id="pause-button" type="button">Pause in cradle</button>
              <button class="meter__button" id="turn-button" type="button">Turn toward home</button>
              <button class="meter__button" id="undo-button" type="button">Undo</button>
            </div>
            <div class="meter__secondary meter__secondary--two">
              <button class="meter__button" id="copy-button" type="button">Copy receipt</button>
              <button class="meter__button" id="reset-button" type="button">Reset local game</button>
            </div>
            <p class="meter__note">
              PASS sounds one original three-tone Handoff Bell after your
              gesture. No samples, autoplay, account, location, upload,
              analytics event, or public score is used.
            </p>
          </div>
          <div class="meter__readout" aria-live="polite">
            <div class="readout-grid">
              <div class="readout"><span>Hands</span><strong id="hands-value">2</strong><small>people in custody</small></div>
              <div class="readout"><span>Chain</span><strong id="chain-value">0.0</strong><small>armspan meters</small></div>
              <div class="readout"><span>Route</span><strong id="route-value">0.0</strong><small>total meters carried</small></div>
              <div class="readout"><span>Farthest</span><strong id="farthest-value">0.0</strong><small>meters from Pacific zero</small></div>
            </div>
            <div class="custody">
              <span>Custody</span>
              <strong id="custody-value">UNBROKEN · OUTBOUND</strong>
            </div>
            <p class="meter__status" id="meter-status">The first pair holds the baton at Pacific zero. Choose a pass.</p>
          </div>
        </div>
      </section>

      <section class="paths" id="paths" aria-labelledby="paths-title">
        <header class="section-head">
          <h2 id="paths-title">Three<br />scales.</h2>
          <p>
            The concept gets more real by getting more specific. The small
            version is a bounded hand-to-hand game. The long version is
            partner and agency work—not spontaneous route occupation.
          </p>
        </header>
        <div class="path-grid">
          {REACH_PATHS.map((path) => (
            <article class="path">
              <small>{path.scale}</small>
              <h3>{path.title}</h3>
              <p>{path.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="roles" aria-labelledby="roles-title">
        <header class="section-head">
          <h2 id="roles-title">Everyone<br />holds a job.</h2>
          <p>
            The baton moves because hospitality, access, measurement, route
            judgment, and pack-out move with it. Nobody is a disposable extra.
          </p>
        </header>
        <div class="role-grid">
          {REACH_LINE_ROLES.map((role, index) => (
            <article class="role">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{role.title}</h3>
              <p>{role.move}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <header class="section-head">
          <h2 id="rules-title">The game<br />protects the pause.</h2>
          <p>
            A beautiful relay can be slow, short, interrupted, seated,
            rerouted, or called off. Continuity is responsibility—not pressure
            to keep moving.
          </p>
        </header>
        <ol class="rule-list">
          {REACH_LINE_RULES.map((rule, index) => (
            <li><b>{String(index + 1).padStart(2, '0')}</b><span>{rule}</span></li>
          ))}
        </ol>
      </section>

      <section class="sources" aria-labelledby="sources-title">
        <header class="section-head">
          <h2 id="sources-title">Check the<br />actual coast.</h2>
          <p>
            These current official pages shaped the boundary. Recheck every
            source, site condition, jurisdiction, and permit path before any
            physical prototype.
          </p>
        </header>
        <div class="source-grid">
          {REACH_LINE_SOURCES.map((source, index) => (
            <article class="source">
              <span class="kicker">{String(index + 1).padStart(2, '0')} · current source</span>
              <h3>{source.title}</h3>
              <p>{source.note}</p>
              <a href={source.url} target="_blank" rel="noreferrer">Open official guidance ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="boundary">
        <h2>One baton comes home.</h2>
        <p>
          {BEACH_COMMONS_V11.finish} {BEACH_COMMONS_V11.boundary}
        </p>
        <div class="boundary__links">
          <a href="/beach-commons/v11.json">Inspect the machine edition ↗</a>
          <a href="/b/0531">Open Block 0531 ↗</a>
          <a href="/beach-commons/v10">Previous: Tide Cabinet ↗</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>PointCast · Field Study 011</span>
      <a href="/beach-commons">Beach Commons</a>
      <a href="/beach-commons/v11.json">JSON</a>
      <a href="/">Home</a>
    </footer>

    <dialog class="viewer" id="plate-viewer" aria-label="The Reach Line full image viewer">
      <div class="viewer__top">
        <p class="viewer__title" id="viewer-title">The Reach Line plate</p>
        <button class="viewer__close" id="viewer-close" type="button" aria-label="Close full image">Close</button>
      </div>
      <img class="viewer__image" id="viewer-image" src={hero.image} alt="" width="1536" height="1024" />
    </dialog>

    <script is:inline>
      (() => {
        const viewer = document.querySelector('#plate-viewer');
        const viewerImage = document.querySelector('#viewer-image');
        const viewerTitle = document.querySelector('#viewer-title');
        const viewerClose = document.querySelector('#viewer-close');
        let returnFocus = null;
        document.querySelectorAll('[data-view-image]').forEach((button) => {
          button.addEventListener('click', () => {
            returnFocus = button;
            viewerImage.src = button.dataset.viewImage;
            viewerImage.alt = button.querySelector('img')?.alt || '';
            viewerTitle.textContent = button.dataset.viewTitle;
            viewer.showModal();
            viewerClose.focus();
          });
        });
        const closeViewer = () => {
          viewer.close();
          returnFocus?.focus();
        };
        viewerClose.addEventListener('click', closeViewer);
        viewer.addEventListener('click', (event) => {
          if (event.target === viewer) closeViewer();
        });
        viewer.addEventListener('cancel', (event) => {
          event.preventDefault();
          closeViewer();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && viewer.open) closeViewer();
        });

        const storageKey = 'pointcast.reach-line.v11';
        const fresh = () => ({
          hands: 2,
          chain: 0,
          route: 0,
          position: 0,
          farthest: 0,
          passes: 0,
          direction: 1,
          paused: false,
          returned: false,
          mode: 'armspan',
          history: [],
        });
        let state = fresh();
        try {
          const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
          if (saved && Number.isFinite(saved.hands) && Array.isArray(saved.history)) {
            state = { ...fresh(), ...saved };
          }
        } catch {}

        const hands = document.querySelector('#hands-value');
        const chain = document.querySelector('#chain-value');
        const route = document.querySelector('#route-value');
        const farthest = document.querySelector('#farthest-value');
        const custody = document.querySelector('#custody-value');
        const status = document.querySelector('#meter-status');
        const distance = document.querySelector('#reach-distance');
        const distanceLabel = document.querySelector('#distance-label');
        const pauseButton = document.querySelector('#pause-button');
        const turnButton = document.querySelector('#turn-button');
        const modeButtons = [...document.querySelectorAll('[data-mode]')];

        const save = () => {
          try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {}
        };
        const format = (value) => Number(value).toFixed(1);
        const render = () => {
          hands.textContent = String(state.hands);
          chain.textContent = format(state.chain);
          route.textContent = format(state.route);
          farthest.textContent = format(state.farthest);
          custody.textContent = state.returned
            ? 'UNBROKEN · RETURNED'
            : state.paused
              ? 'UNBROKEN · STAFFED PAUSE'
              : `UNBROKEN · ${state.direction === 1 ? 'OUTBOUND' : 'HOMEBOUND'}`;
          pauseButton.textContent = state.paused ? 'Resume custody' : 'Pause in cradle';
          turnButton.textContent = state.direction === 1 ? 'Turn toward home' : 'Continue outbound';
          modeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mode === state.mode)));
          distanceLabel.textContent = state.mode === 'armspan'
            ? '02 · Measured handoff gap'
            : '02 · Safe station leg';
          if (state.mode === 'armspan' && distance.value === '100') distance.value = '1.5';
          if (state.mode === 'station' && distance.value === '1.5') distance.value = '100';
          save();
        };
        const snapshot = () => {
          const { history, ...entry } = state;
          return entry;
        };
        const restore = (entry) => {
          const history = state.history;
          state = { ...fresh(), ...entry, history };
          render();
        };
        const bell = () => {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const context = new AudioContext();
          const now = context.currentTime;
          const master = context.createGain();
          master.gain.setValueAtTime(0.0001, now);
          master.gain.exponentialRampToValueAtTime(0.18, now + 0.02);
          master.gain.exponentialRampToValueAtTime(0.0001, now + 0.62);
          master.connect(context.destination);
          [392, 523.25, 659.25].forEach((frequency, index) => {
            const oscillator = context.createOscillator();
            const voice = context.createGain();
            oscillator.type = index === 0 ? 'sine' : 'triangle';
            oscillator.frequency.value = frequency;
            voice.gain.value = 0.34 / (index + 1);
            oscillator.connect(voice).connect(master);
            oscillator.start(now + index * 0.045);
            oscillator.stop(now + 0.64);
          });
          window.setTimeout(() => context.close(), 850);
        };

        modeButtons.forEach((button) => button.addEventListener('click', () => {
          state.mode = button.dataset.mode;
          status.textContent = state.mode === 'armspan'
            ? 'One-armspan mode: measure the controlled gap between paired handoffs.'
            : 'Station-leg mode: enter one confirmed safe pedestrian leg.';
          render();
        }));
        document.querySelector('#pass-button').addEventListener('click', () => {
          const meters = Number(distance.value);
          if (!Number.isFinite(meters) || meters <= 0 || meters > 100000) {
            status.textContent = 'Enter a measured distance between 0.1 and 100,000 meters.';
            distance.focus();
            return;
          }
          if (state.paused) {
            status.textContent = 'The baton is safe in its staffed cradle. Resume custody before the next pass.';
            pauseButton.focus();
            return;
          }
          if (state.returned) {
            status.textContent = 'This relay already returned to Pacific zero. Copy its receipt or reset for another rehearsal.';
            return;
          }
          state.history.push(snapshot());
          state.hands += 2;
          state.passes += 1;
          state.route += meters;
          if (state.mode === 'armspan') state.chain += meters;
          state.position = Math.max(0, state.position + meters * state.direction);
          state.farthest = Math.max(state.farthest, state.position);
          if (state.direction === -1 && state.position === 0) {
            state.returned = true;
            status.textContent = `Returned to Pacific zero after ${state.passes} passes with custody unbroken.`;
          } else {
            status.textContent = `${state.mode === 'armspan' ? 'Handoff gap' : 'Station leg'} accepted. Two new hands share custody.`;
          }
          bell();
          render();
        });
        pauseButton.addEventListener('click', () => {
          if (state.returned) return;
          state.history.push(snapshot());
          state.paused = !state.paused;
          status.textContent = state.paused
            ? 'Clock stopped. The staffed cradle preserves custody; nobody loses.'
            : 'Custody resumed only after the next pair and safe leg are ready.';
          render();
        });
        turnButton.addEventListener('click', () => {
          if (state.returned) return;
          state.history.push(snapshot());
          state.direction *= -1;
          status.textContent = state.direction === -1
            ? 'The baton is homebound. Keep passing until the position returns to Pacific zero.'
            : 'The baton is outbound again. Farthest distance updates only when new ground is reached.';
          render();
        });
        document.querySelector('#undo-button').addEventListener('click', () => {
          const entry = state.history.pop();
          if (!entry) {
            status.textContent = 'Nothing to undo yet.';
            return;
          }
          restore(entry);
          status.textContent = 'Last local move undone.';
        });
        document.querySelector('#reset-button').addEventListener('click', () => {
          state = fresh();
          distance.value = '1.5';
          status.textContent = 'Local rehearsal reset. The first pair holds the baton at Pacific zero.';
          render();
        });
        document.querySelector('#copy-button').addEventListener('click', async () => {
          const receipt = [
            'THE REACH LINE — local rehearsal',
            `Hands: ${state.hands}`,
            `Passes: ${state.passes}`,
            `Armspan chain: ${format(state.chain)} m`,
            `Route carried: ${format(state.route)} m`,
            `Farthest from Pacific zero: ${format(state.farthest)} m`,
            `Custody: ${state.returned ? 'unbroken + returned' : 'unbroken'}`,
            'No live event or public tracking. pointcast.xyz/beach-commons/v11',
          ].join('\n');
          try {
            await navigator.clipboard.writeText(receipt);
            status.textContent = 'Local relay receipt copied.';
          } catch {
            status.textContent = 'Copy was unavailable. Your local rehearsal remains in this browser.';
          }
        });
        render();
      })();
    </script>
  </body>
</html>
