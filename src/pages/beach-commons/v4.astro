---
import {
  BEACH_COMMONS_V4,
  BEACH_COMMONS_V4_PLATES,
} from '../../lib/beach-commons-v4';

const title = `${BEACH_COMMONS_V4.title} — ${BEACH_COMMONS_V4.subtitle}`;
const description = BEACH_COMMONS_V4.dek;
const canonical = BEACH_COMMONS_V4.url;
const socialImage = 'https://pointcast.xyz/images/og/beach-commons-v4.png';
const hero = BEACH_COMMONS_V4_PLATES[7];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  '@id': `${canonical}#field-study`,
  url: canonical,
  name: title,
  description,
  datePublished: BEACH_COMMONS_V4.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Field Study',
    url: 'https://pointcast.xyz',
  },
  isBasedOn: BEACH_COMMONS_V4.previousEdition.url,
  mainEntityOfPage: BEACH_COMMONS_V4.jsonUrl,
  image: BEACH_COMMONS_V4_PLATES.map((plate) => new URL(plate.image, canonical).href),
  creator: BEACH_COMMONS_V4.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f0a528" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V4.jsonUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,800&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --ink: #17211f;
        --paper: #f1ecdf;
        --sun: #f0a528;
        --fire: #d45c3f;
        --water: #78a6b1;
        --moon: #7d88ad;
        --stone: #b9ac96;
        --green: #4d694e;
        --night: #111a20;
        --line: rgba(23, 33, 31, .26);
        --sans: 'DM Sans', sans-serif;
        --serif: 'DM Serif Display', serif;
        --mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
      }
      a { color: inherit; }
      button { font: inherit; }
      img { max-width: 100%; }
      button, a { -webkit-tap-highlight-color: transparent; }

      .skip {
        position: fixed;
        z-index: 200;
        top: 8px;
        left: 8px;
        transform: translateY(-160%);
        background: white;
        padding: 10px 14px;
        font: 700 11px/1 var(--mono);
      }
      .skip:focus { transform: translateY(0); }

      .head {
        position: sticky;
        z-index: 80;
        top: 0;
        display: grid;
        grid-template-columns: minmax(160px, 1fr) auto auto auto;
        min-height: 54px;
        background: rgba(17, 26, 32, .95);
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, .24);
        backdrop-filter: blur(14px);
      }
      .head > * {
        min-width: 0;
        display: flex;
        align-items: center;
        padding: 0 22px;
        border-left: 1px solid rgba(255, 255, 255, .2);
        font: 700 10px/1 var(--mono);
        letter-spacing: .11em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .head .brand {
        border-left: 0;
        font: 800 14px/1 var(--sans);
        letter-spacing: .17em;
      }
      .head a:hover, .head a:focus-visible {
        background: var(--sun);
        color: var(--night);
        outline: 0;
      }

      .hero {
        position: relative;
        min-height: min(930px, calc(100vh - 54px));
        display: flex;
        align-items: flex-end;
        isolation: isolate;
        overflow: hidden;
        background: var(--night);
        color: white;
      }
      .hero__image, .hero__wash {
        position: absolute;
        inset: 0;
      }
      .hero__image {
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero__wash {
        z-index: -1;
        background:
          linear-gradient(90deg, rgba(8, 14, 16, .8) 0%, rgba(8, 14, 16, .18) 70%),
          linear-gradient(0deg, rgba(8, 14, 16, .9) 0%, transparent 63%);
      }
      .hero__copy {
        width: min(1440px, 100%);
        margin: 0 auto;
        padding: clamp(100px, 14vw, 190px) clamp(22px, 5vw, 78px) clamp(42px, 7vw, 94px);
      }
      .kicker, .eyebrow {
        margin: 0 0 18px;
        font: 700 10px/1.4 var(--mono);
        letter-spacing: .15em;
        text-transform: uppercase;
      }
      .hero h1 {
        max-width: 1200px;
        margin: 0;
        font: 400 clamp(68px, 13.2vw, 198px)/.7 var(--serif);
        letter-spacing: -.06em;
      }
      .hero h1 span {
        display: block;
        color: var(--sun);
        font-style: italic;
      }
      .hero__dek {
        max-width: 760px;
        margin: 34px 0 0;
        font-size: clamp(20px, 2.2vw, 34px);
        font-weight: 600;
        line-height: 1.08;
      }
      .hero__actions, .boundary__links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
      }
      .button {
        display: inline-flex;
        align-items: center;
        min-height: 46px;
        padding: 0 16px;
        border: 1px solid currentColor;
        font: 700 10px/1 var(--mono);
        letter-spacing: .1em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .button--hot { background: var(--sun); border-color: var(--sun); color: var(--night); }
      .button:hover, .button:focus-visible { background: white; color: var(--night); outline: 0; }

      .manifesto {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr);
        gap: clamp(42px, 8vw, 130px);
        padding: clamp(74px, 11vw, 160px) max(5vw, calc((100vw - 1440px) / 2));
      }
      .manifesto h2, .section-head h2 {
        margin: 0;
        font: 400 clamp(58px, 8.6vw, 126px)/.8 var(--serif);
        letter-spacing: -.05em;
      }
      .manifesto__copy {
        align-self: end;
        font-size: clamp(18px, 1.6vw, 25px);
        line-height: 1.46;
      }
      .manifesto__copy p { margin: 0 0 20px; }
      .manifesto__copy strong { color: var(--fire); }

      .element-field {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        border-block: 1px solid var(--line);
        background: var(--night);
        color: white;
      }
      .element {
        min-width: 0;
        min-height: 420px;
        display: flex;
        flex-direction: column;
        padding: clamp(20px, 2.3vw, 38px) clamp(14px, 1.8vw, 28px);
        border-right: 1px solid rgba(255,255,255,.22);
      }
      .element:last-child { border-right: 0; }
      .element__mark {
        display: block;
        color: var(--sun);
        font: 400 clamp(42px, 5vw, 76px)/1 var(--serif);
      }
      .element h3 {
        margin: auto 0 8px;
        font: 400 clamp(28px, 2.8vw, 44px)/.95 var(--serif);
      }
      .element h4 {
        margin: 0 0 18px;
        color: var(--sun);
        font: 700 9px/1.35 var(--mono);
        letter-spacing: .09em;
        text-transform: uppercase;
      }
      .element p {
        margin: 0;
        font-size: 13px;
        line-height: 1.42;
      }
      .element small {
        display: block;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,.22);
        color: rgba(255,255,255,.68);
        font: 500 9px/1.45 var(--mono);
      }

      .season-lab {
        --season: var(--water);
        padding: clamp(76px, 11vw, 160px) max(5vw, calc((100vw - 1440px) / 2));
        background: var(--season);
        transition: background-color .5s ease;
      }
      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, .6fr);
        gap: 40px;
        align-items: end;
        margin-bottom: 50px;
      }
      .section-head p:last-child {
        margin: 0;
        font-size: 18px;
        line-height: 1.5;
      }
      .season-controls {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border: 1px solid var(--ink);
      }
      .season-button {
        min-height: 72px;
        padding: 16px;
        border: 0;
        border-right: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        font: 700 10px/1.3 var(--mono);
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .season-button:last-child { border-right: 0; }
      .season-button[aria-pressed="true"], .season-button:hover, .season-button:focus-visible {
        background: var(--night);
        color: white;
        outline: 0;
      }
      .season-output {
        display: grid;
        grid-template-columns: .65fr 1.35fr;
        gap: clamp(30px, 6vw, 90px);
        min-height: 320px;
        align-items: end;
        padding-top: clamp(44px, 8vw, 110px);
      }
      .season-output__label {
        font: 700 10px/1.4 var(--mono);
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      .season-output h3 {
        margin: 12px 0 0;
        font: 400 clamp(44px, 6.8vw, 102px)/.84 var(--serif);
        letter-spacing: -.045em;
      }
      .season-output p {
        margin: 0;
        font-size: clamp(20px, 2.4vw, 36px);
        font-weight: 600;
        line-height: 1.14;
      }

      .plates { background: var(--paper); }
      .plates__intro {
        padding: clamp(78px, 11vw, 160px) max(5vw, calc((100vw - 1440px) / 2));
      }
      .plates__intro h2 {
        max-width: 1050px;
        margin: 0;
        font: 400 clamp(62px, 10vw, 150px)/.78 var(--serif);
        letter-spacing: -.055em;
      }
      .plates__intro p:last-child {
        max-width: 600px;
        margin: 32px 0 0 auto;
        font-size: 19px;
        line-height: 1.5;
      }
      .plate {
        min-height: 760px;
        display: grid;
        grid-template-columns: minmax(300px, .36fr) minmax(0, .64fr);
        border-top: 1px solid var(--line);
      }
      .plate:nth-child(odd) { grid-template-columns: minmax(0, .64fr) minmax(300px, .36fr); }
      .plate:nth-child(odd) .plate__copy { order: 2; }
      .plate__copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(34px, 5vw, 78px);
      }
      .plate__id { font: 700 10px/1 var(--mono); letter-spacing: .12em; }
      .plate h3 {
        margin: 22px 0 12px;
        font: 400 clamp(48px, 6vw, 88px)/.82 var(--serif);
        letter-spacing: -.04em;
      }
      .plate__mode {
        margin: 0;
        color: var(--fire);
        font: 700 9px/1.4 var(--mono);
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .plate__description {
        max-width: 480px;
        margin: 42px 0 0;
        font-size: 18px;
        line-height: 1.5;
      }
      .plate__open {
        position: relative;
        min-width: 0;
        min-height: 600px;
        padding: 0;
        overflow: hidden;
        border: 0;
        background: var(--night);
        cursor: zoom-in;
      }
      .plate__open img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .7s ease;
      }
      .plate__open span {
        position: absolute;
        right: 18px;
        bottom: 18px;
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--sun);
        color: var(--night);
        font-size: 28px;
      }
      .plate__open:hover img, .plate__open:focus-visible img { transform: scale(1.025); }
      .plate__open:focus-visible { outline: 4px solid var(--sun); outline-offset: -4px; }

      .rules {
        padding: clamp(78px, 11vw, 160px) max(5vw, calc((100vw - 1440px) / 2));
        background: var(--green);
        color: white;
      }
      .rules ol {
        margin: 52px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid rgba(255,255,255,.3);
      }
      .rules li {
        display: grid;
        grid-template-columns: 80px 1fr;
        gap: 20px;
        padding: 24px 0;
        border-bottom: 1px solid rgba(255,255,255,.3);
        font-size: clamp(17px, 1.7vw, 24px);
        line-height: 1.35;
      }
      .rules li::before {
        content: counter(list-item, decimal-leading-zero);
        color: var(--sun);
        font: 700 11px/1.5 var(--mono);
      }

      .reality {
        padding: clamp(78px, 11vw, 160px) max(5vw, calc((100vw - 1440px) / 2));
        background: var(--stone);
      }
      .reality h2, .boundary h2 {
        margin: 0;
        font: 400 clamp(58px, 9vw, 132px)/.8 var(--serif);
        letter-spacing: -.05em;
      }
      .reality__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 56px;
        border: 1px solid var(--ink);
      }
      .reality__grid article {
        min-height: 330px;
        display: flex;
        flex-direction: column;
        padding: 30px;
        border-right: 1px solid var(--ink);
      }
      .reality__grid article:last-child { border-right: 0; }
      .reality__grid b { font: 700 10px/1 var(--mono); }
      .reality__grid h3 {
        margin: auto 0 14px;
        font: 400 36px/.95 var(--serif);
      }
      .reality__grid p { margin: 0; font-size: 15px; line-height: 1.48; }

      .boundary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(40px, 8vw, 120px);
        padding: clamp(78px, 11vw, 160px) max(5vw, calc((100vw - 1440px) / 2));
        background: var(--fire);
        color: white;
      }
      .boundary > div { align-self: end; }
      .boundary p { margin: 0; font-size: clamp(18px, 2vw, 28px); line-height: 1.42; }

      .foot {
        display: flex;
        justify-content: space-between;
        gap: 26px;
        padding: 28px 5vw;
        background: var(--night);
        color: white;
        font: 700 9px/1.5 var(--mono);
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .foot nav { display: flex; flex-wrap: wrap; gap: 18px; }

      dialog {
        width: 100vw;
        max-width: none;
        height: 100vh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: var(--night);
        color: white;
      }
      dialog::backdrop { background: rgba(17,26,32,.97); }
      .viewer {
        min-height: 100%;
        display: grid;
        grid-template-rows: 56px minmax(0, 1fr) auto;
      }
      .viewer__top {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,.25);
        font: 700 9px/1 var(--mono);
        letter-spacing: .12em;
      }
      .viewer__top span, .viewer__close { display: flex; align-items: center; padding: 0 18px; }
      .viewer__close {
        border: 0;
        border-left: 1px solid rgba(255,255,255,.25);
        background: transparent;
        color: white;
        font: inherit;
        cursor: pointer;
        text-transform: uppercase;
      }
      .viewer__stage { position: relative; min-height: 0; display: grid; place-items: center; padding: 16px 74px; }
      .viewer__stage img { width: 100%; height: 100%; max-height: calc(100vh - 190px); object-fit: contain; }
      .viewer__nav {
        position: absolute;
        top: 50%;
        width: 48px;
        height: 48px;
        border: 1px solid rgba(255,255,255,.45);
        border-radius: 50%;
        background: rgba(17,26,32,.7);
        color: white;
        font-size: 24px;
        cursor: pointer;
      }
      .viewer__prev { left: 14px; }
      .viewer__next { right: 14px; }
      .viewer__caption {
        display: grid;
        grid-template-columns: .45fr 1fr;
        gap: 24px;
        padding: 18px;
        border-top: 1px solid rgba(255,255,255,.25);
      }
      .viewer__caption strong { color: var(--sun); font: 700 10px/1.4 var(--mono); text-transform: uppercase; }
      .viewer__caption span { font-size: 15px; line-height: 1.4; }

      @media (max-width: 1080px) {
        .element-field { grid-template-columns: repeat(4, 1fr); }
        .element { min-height: 330px; border-bottom: 1px solid rgba(255,255,255,.22); }
        .element:nth-child(4) { border-right: 0; }
        .element:nth-last-child(-n+3) { border-bottom: 0; }
      }

      @media (max-width: 820px) {
        .manifesto, .section-head, .boundary, .season-output { grid-template-columns: 1fr; }
        .element-field { grid-template-columns: repeat(2, 1fr); }
        .element { min-height: 300px; }
        .element:nth-child(even) { border-right: 0; }
        .element:nth-child(4) { border-right: 0; }
        .element:nth-last-child(-n+3) { border-bottom: 1px solid rgba(255,255,255,.22); }
        .element:last-child { grid-column: 1 / -1; min-height: 250px; border-bottom: 0; }
        .season-controls { grid-template-columns: repeat(2, 1fr); }
        .season-button:nth-child(2) { border-right: 0; }
        .season-button:nth-child(-n+2) { border-bottom: 1px solid var(--ink); }
        .season-output { min-height: 390px; align-content: end; }
        .plate, .plate:nth-child(odd) { grid-template-columns: 1fr; min-height: 0; }
        .plate:nth-child(odd) .plate__copy { order: 0; }
        .plate__copy { min-height: 440px; }
        .plate__open { min-height: 68vw; }
        .reality__grid { grid-template-columns: 1fr; }
        .reality__grid article { min-height: 260px; border-right: 0; border-bottom: 1px solid var(--ink); }
        .reality__grid article:last-child { border-bottom: 0; }
      }

      @media (max-width: 560px) {
        .head { grid-template-columns: minmax(0, 1fr) auto auto; }
        .head .issue { display: none; }
        .head > * { padding-inline: 13px; }
        .hero { min-height: calc(100svh - 54px); }
        .hero__image { object-position: 51% center; }
        .hero h1 { font-size: clamp(64px, 22vw, 100px); }
        .hero__dek { font-size: 19px; }
        .element h3 { font-size: 34px; }
        .season-button { min-height: 82px; padding: 12px; font-size: 9px; }
        .plates__intro p:last-child { margin-left: 0; }
        .plate__copy { min-height: 400px; }
        .plate__open { min-height: 76vw; }
        .rules li { grid-template-columns: 52px 1fr; }
        .foot { flex-direction: column; }
        .viewer__stage { padding: 14px 16px 74px; }
        .viewer__stage img { height: auto; max-height: calc(100vh - 210px); }
        .viewer__nav { top: auto; bottom: 12px; }
        .viewer__caption { grid-template-columns: 1fr; gap: 8px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .plate__open img, .season-lab { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#study">Skip to field study</a>

    <header class="head">
      <a class="brand" href="/">PointCast</a>
      <span class="issue">Field Study 004 · El Segundo Coast</span>
      <a href="/beach-commons/v3">V3 ↙</a>
      <a href="/beach-commons/v4.json">JSON ↗</a>
    </header>

    <main id="study">
      <section class="hero" aria-labelledby="page-title">
        <img class="hero__image" src={hero.image} width="1536" height="1024" alt={hero.alt} fetchpriority="high" />
        <div class="hero__wash"></div>
        <div class="hero__copy">
          <p class="kicker">PointCast Field Study 004 · Sculpture edition · July 2026</p>
          <h1 id="page-title">Beach Commons <span>V4</span></h1>
          <p class="hero__dek">{BEACH_COMMONS_V4.dek}</p>
          <div class="hero__actions">
            <a class="button button--hot" href="#seasons">Play the seasonal score ↓</a>
            <a class="button" href="#plates">Open eight plates ↓</a>
          </div>
        </div>
      </section>

      <section class="manifesto" aria-labelledby="manifesto-title">
        <div>
          <p class="eyebrow">The V4 move</p>
          <h2 id="manifesto-title">Weather is the artist. The crowd is the amplifier.</h2>
        </div>
        <div class="manifesto__copy">
          <p><strong>Max the experience, not the extraction.</strong> Make shadow darker, rain more musical, wind more visible, water more carefully shared, and moonrise worth gathering for.</p>
          <p>Every sculpture keeps a double life: useful public equipment on an ordinary day, then one part of a social seasonal score.</p>
        </div>
      </section>

      <section class="element-field" aria-label="Seven elemental civic systems">
        {BEACH_COMMONS_V4.elements.map((element) => (
          <article class="element">
            <span class="element__mark" aria-hidden="true">{element.mark}</span>
            <h3>{element.title}</h3>
            <h4>{element.action}</h4>
            <p>{element.daily}</p>
            <small>{element.boundary}</small>
          </article>
        ))}
      </section>

      <section class="season-lab" id="seasons" aria-labelledby="season-title" data-season-lab>
        <header class="section-head">
          <div>
            <p class="eyebrow">Choose a season</p>
            <h2 id="season-title">One yard. Four scores.</h2>
          </div>
          <p>The structure stays recognizable. The public choreography changes with what the coast actually offers.</p>
        </header>
        <div class="season-controls" role="group" aria-label="Choose a seasonal element score">
          {BEACH_COMMONS_V4.seasons.map((season, index) => (
            <button
              class="season-button"
              type="button"
              data-season={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {season.title}
            </button>
          ))}
        </div>
        <div class="season-output" aria-live="polite">
          <div>
            <span class="season-output__label" data-season-elements>{BEACH_COMMONS_V4.seasons[0].elements}</span>
            <h3 data-season-title>{BEACH_COMMONS_V4.seasons[0].title}</h3>
          </div>
          <p data-season-cue>{BEACH_COMMONS_V4.seasons[0].cue}</p>
        </div>
      </section>

      <section class="plates" id="plates" aria-labelledby="plates-title">
        <header class="plates__intro">
          <p class="eyebrow">Eight field plates</p>
          <h2 id="plates-title">Gather. Amplify. Fold away.</h2>
          <p>Seven elemental rooms and one complete seasonal commons. Open any image for the full field plate.</p>
        </header>
        {BEACH_COMMONS_V4_PLATES.map((plate, index) => (
          <article class="plate">
            <div class="plate__copy">
              <div>
                <span class="plate__id">{plate.id}</span>
                <h3>{plate.title}</h3>
                <p class="plate__mode">{plate.element} · {plate.civicUse}</p>
              </div>
              <p class="plate__description">{plate.description}</p>
            </div>
            <button class="plate__open" type="button" data-open={index} aria-label={`Open full image: ${plate.title}`}>
              <img src={plate.image} width="1536" height="1024" alt={plate.alt} loading={index < 2 ? 'eager' : 'lazy'} />
              <span aria-hidden="true">+</span>
            </button>
          </article>
        ))}
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <header class="section-head">
          <div>
            <p class="eyebrow">The operating score</p>
            <h2 id="rules-title">Maximum feeling. Real limits.</h2>
          </div>
          <p>The engineering, ecology, and access rules are visible parts of the artwork—not notes hidden after the beautiful picture.</p>
        </header>
        <ol>
          {BEACH_COMMONS_V4.operatingRules.map((rule) => <li>{rule}</li>)}
        </ol>
      </section>

      <section class="reality" aria-labelledby="reality-title">
        <p class="eyebrow">From image to place</p>
        <h2 id="reality-title">Three levels of reality.</h2>
        <div class="reality__grid">
          {BEACH_COMMONS_V4.realityLevels.map((level, index) => (
            <article>
              <b>{String(index + 1).padStart(2, '0')}</b>
              <h3>{level.title}</h3>
              <p>{level.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <h2 id="boundary-title">The honest boundary.</h2>
        <div>
          <p>{BEACH_COMMONS_V4.boundary}</p>
          <div class="boundary__links">
            <a class="button" href="/beach-commons/v4.json">Machine edition ↗</a>
            <a class="button" href="/b/0511">Block 0511 ↗</a>
            <a class="button" href="/beach-commons/v3">Previous edition ↙</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Michael Hoydich + Codex · El Segundo · 2026</span>
      <nav aria-label="Field study links">
        <a href="/beach-commons/v3">V3 · Flash Bakery + Palm Loom</a>
        <a href="/beach-commons/v4.json">Machine edition</a>
        <a href="/">PointCast home</a>
      </nav>
    </footer>

    <dialog aria-label="Beach Commons V4 full image viewer" data-viewer>
      <div class="viewer">
        <header class="viewer__top">
          <span data-count>01 / 08</span>
          <button class="viewer__close" type="button" data-close>Close ×</button>
        </header>
        <div class="viewer__stage">
          <img data-viewer-image src={hero.image} alt="" />
          <button class="viewer__nav viewer__prev" type="button" data-prev aria-label="Previous prototype">←</button>
          <button class="viewer__nav viewer__next" type="button" data-next aria-label="Next prototype">→</button>
        </div>
        <div class="viewer__caption">
          <strong data-caption-title></strong>
          <span data-caption-copy></span>
        </div>
      </div>
    </dialog>

    <script define:vars={{ plates: BEACH_COMMONS_V4_PLATES, seasons: BEACH_COMMONS_V4.seasons }}>
      const seasonLab = document.querySelector('[data-season-lab]');
      const seasonButtons = [...document.querySelectorAll('[data-season]')];
      const seasonTitle = document.querySelector('[data-season-title]');
      const seasonElements = document.querySelector('[data-season-elements]');
      const seasonCue = document.querySelector('[data-season-cue]');

      seasonButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const season = seasons[Number(button.dataset.season)];
          if (!season || !seasonLab || !seasonTitle || !seasonElements || !seasonCue) return;
          seasonButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          seasonLab.style.setProperty('--season', season.color);
          seasonTitle.textContent = season.title;
          seasonElements.textContent = season.elements;
          seasonCue.textContent = season.cue;
        });
      });

      const dialog = document.querySelector('[data-viewer]');
      const image = dialog?.querySelector('[data-viewer-image]');
      const count = dialog?.querySelector('[data-count]');
      const captionTitle = dialog?.querySelector('[data-caption-title]');
      const captionCopy = dialog?.querySelector('[data-caption-copy]');
      const openers = [...document.querySelectorAll('[data-open]')];
      let active = 0;
      let returnFocus = null;

      const render = () => {
        const plate = plates[active];
        if (!plate || !image || !count || !captionTitle || !captionCopy) return;
        image.src = plate.image;
        image.alt = plate.alt;
        count.textContent = `${plate.id} / ${String(plates.length).padStart(2, '0')}`;
        captionTitle.textContent = `${plate.id} · ${plate.title}`;
        captionCopy.textContent = plate.description;
      };

      const move = (delta) => {
        active = (active + delta + plates.length) % plates.length;
        render();
      };

      openers.forEach((button) => {
        button.addEventListener('click', () => {
          active = Number(button.dataset.open);
          returnFocus = button;
          render();
          dialog?.showModal();
        });
      });

      dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      dialog?.querySelector('[data-prev]')?.addEventListener('click', () => move(-1));
      dialog?.querySelector('[data-next]')?.addEventListener('click', () => move(1));
      dialog?.addEventListener('close', () => returnFocus?.focus());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') move(-1);
        if (event.key === 'ArrowRight') move(1);
        if (event.key === 'Escape') dialog.close();
      });
    </script>
  </body>
</html>
