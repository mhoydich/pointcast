---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

import {
  BEACH_COMMONS,
  BEACH_COMMONS_PROTOTYPES,
} from '../../lib/beach-commons';

const canonical = BEACH_COMMONS.url;
const shareImage = 'https://pointcast.xyz/images/og/beach-commons.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `${BEACH_COMMONS.title} — ${BEACH_COMMONS.subtitle}`,
  headline: BEACH_COMMONS.dek,
  description:
    'Six speculative coastal-architecture prototypes for a communal, low-digital beach habitat built from a mineral service hardpoint and reusable lightweight rooms.',
  url: canonical,
  image: shareImage,
  datePublished: BEACH_COMMONS.publishedAt,
  numberOfItems: BEACH_COMMONS_PROTOTYPES.length,
  creator: BEACH_COMMONS.creators.map((creator) => ({
    '@type': creator.name.includes('Codex') ? 'Organization' : 'Person',
    name: creator.name,
  })),
  isPartOf: {
    '@type': 'WebSite',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  mainEntityOfPage: BEACH_COMMONS.jsonUrl,
  hasPart: BEACH_COMMONS_PROTOTYPES.map((prototype) => ({
    '@type': 'VisualArtwork',
    name: prototype.title,
    position: Number(prototype.id),
    image: new URL(prototype.image, canonical).href,
    description: prototype.description,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Dockweiler Beach Commons: six speculative Hardpoint + Softkit prototypes for shared shelter, sleeping, celebration, and wave-made art."
    />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/json"
      href={BEACH_COMMONS.jsonUrl}
      title="Dockweiler Beach Commons machine edition"
    />
    <link
      rel="preload"
      as="image"
      href={BEACH_COMMONS_PROTOTYPES[0].image}
      fetchpriority="high"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta
      property="og:title"
      content={`${BEACH_COMMONS.title} — ${BEACH_COMMONS.subtitle}`}
    />
    <meta property="og:description" content={BEACH_COMMONS.dek} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={`${BEACH_COMMONS.title} — ${BEACH_COMMONS.subtitle}`}
    />
    <meta name="twitter:description" content={BEACH_COMMONS.dek} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#252723" />
    <title>{BEACH_COMMONS.title} — {BEACH_COMMONS.subtitle} · PointCast</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        color-scheme: dark;
        --ink: #252723;
        --ink-soft: #353832;
        --sand: #d8c9ae;
        --sand-light: #eee6d4;
        --fog: #f2f1ea;
        --brick: #a7442d;
        --brick-dark: #6e291d;
        --kelp: #526553;
        --ocean: #6e98a7;
        --night: #111b25;
        --orange: #ef6a31;
        --amber: #f4b75e;
        --rule-dark: rgba(242, 241, 234, 0.24);
        --rule-light: rgba(37, 39, 35, 0.2);
        --gutter: clamp(16px, 3vw, 48px);
        --mono: "JetBrains Mono Variable", "SFMono-Regular", Consolas, monospace;
        --sans: "Inter Variable", Inter, "Helvetica Neue", Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        scroll-behavior: smooth;
        background: var(--ink);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background: var(--sand-light);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      body:has(dialog[open]) {
        overflow: hidden;
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        color: inherit;
        font: inherit;
      }

      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--orange);
        outline-offset: 4px;
      }

      ::selection {
        background: var(--orange);
        color: var(--ink);
      }

      .skip-link {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 200;
        padding: 10px 14px;
        background: var(--fog);
        color: var(--ink);
        font: 700 12px/1 var(--mono);
        text-transform: uppercase;
        transform: translateY(-180%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        display: grid;
        min-height: 54px;
        grid-template-columns: minmax(0, 1fr) auto auto auto;
        align-items: stretch;
        border-bottom: 1px solid var(--rule-dark);
        background: color-mix(in srgb, var(--ink) 90%, transparent);
        color: var(--fog);
        backdrop-filter: blur(16px);
      }

      .site-head a,
      .issue {
        display: flex;
        align-items: center;
        min-width: 0;
        padding: 0 clamp(12px, 2.2vw, 28px);
        border-left: 1px solid var(--rule-dark);
        font: 700 clamp(9px, 1.2vw, 11px)/1 var(--mono);
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .site-head .brand {
        border-left: 0;
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 850;
        letter-spacing: 0.15em;
      }

      .site-head a:hover {
        background: var(--fog);
        color: var(--ink);
      }

      .hero {
        position: relative;
        display: grid;
        min-height: calc(100svh - 54px);
        overflow: hidden;
        place-items: end start;
        background: var(--night);
        color: var(--fog);
      }

      .hero::after {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, transparent 18%, rgba(17, 27, 37, 0.1) 45%, rgba(17, 27, 37, 0.88) 100%),
          linear-gradient(90deg, rgba(17, 27, 37, 0.22), transparent 58%);
        content: "";
      }

      .hero__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero__copy {
        position: relative;
        z-index: 1;
        width: min(1160px, 100%);
        padding: clamp(28px, 6vw, 88px) var(--gutter);
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 22px;
        font: 650 11px/1.2 var(--mono);
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 0 0 5px rgba(239, 106, 49, 0.2);
        content: "";
      }

      h1 {
        max-width: 11ch;
        margin: 0;
        font-size: clamp(54px, 10.4vw, 172px);
        font-weight: 850;
        letter-spacing: -0.075em;
        line-height: 0.78;
        text-wrap: balance;
      }

      h1 span {
        display: block;
        margin-top: 0.16em;
        color: var(--amber);
        font-size: 0.42em;
        font-weight: 520;
        letter-spacing: -0.035em;
        line-height: 1;
      }

      .hero__dek {
        max-width: 720px;
        margin: clamp(28px, 5vw, 58px) 0 0;
        font-size: clamp(18px, 2.1vw, 30px);
        font-weight: 520;
        letter-spacing: -0.025em;
        line-height: 1.17;
      }

      .intro {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        border-bottom: 1px solid var(--rule-light);
      }

      .intro__title,
      .intro__body {
        padding: clamp(34px, 6vw, 92px) var(--gutter);
      }

      .intro__title {
        border-right: 1px solid var(--rule-light);
        background: var(--sand);
      }

      .section-label {
        margin: 0 0 18px;
        font: 700 10px/1.3 var(--mono);
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .intro h2,
      .reality h2 {
        max-width: 10ch;
        margin: 0;
        font-size: clamp(42px, 6.5vw, 98px);
        font-weight: 790;
        letter-spacing: -0.065em;
        line-height: 0.88;
      }

      .intro__body {
        display: grid;
        align-content: center;
        gap: 34px;
      }

      .intro__lead {
        max-width: 29ch;
        margin: 0;
        font-size: clamp(24px, 3.2vw, 47px);
        font-weight: 620;
        letter-spacing: -0.045em;
        line-height: 1.04;
      }

      .thesis {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule-light);
        border-bottom: 1px solid var(--rule-light);
      }

      .thesis article {
        padding: 24px 20px 4px 0;
      }

      .thesis article + article {
        padding-left: 20px;
        border-left: 1px solid var(--rule-light);
      }

      .thesis h3 {
        margin: 0 0 11px;
        color: var(--brick);
        font: 750 11px/1.2 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .thesis p {
        margin: 0;
        font-size: 14px;
        line-height: 1.55;
      }

      .rules {
        padding: clamp(46px, 8vw, 110px) var(--gutter);
        background: var(--ink);
        color: var(--fog);
      }

      .rules__head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 42px;
      }

      .rules h2 {
        max-width: 12ch;
        margin: 0;
        font-size: clamp(38px, 6vw, 82px);
        letter-spacing: -0.06em;
        line-height: 0.92;
      }

      .rules__aside {
        max-width: 34ch;
        margin: 0;
        color: rgba(242, 241, 234, 0.7);
        font: 500 12px/1.5 var(--mono);
      }

      .rules ol {
        display: grid;
        margin: 0;
        padding: 0;
        counter-reset: commons-rule;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--rule-dark);
        list-style: none;
      }

      .rules li {
        min-height: 170px;
        padding: 18px 20px 28px 0;
        border-bottom: 1px solid var(--rule-dark);
        counter-increment: commons-rule;
        font-size: clamp(15px, 1.35vw, 19px);
        line-height: 1.35;
      }

      .rules li:not(:nth-child(4n + 1)) {
        padding-left: 20px;
        border-left: 1px solid var(--rule-dark);
      }

      .rules li::before {
        display: block;
        margin-bottom: 40px;
        color: var(--orange);
        content: counter(commons-rule, decimal-leading-zero);
        font: 700 11px/1 var(--mono);
      }

      .plates {
        background: var(--sand-light);
      }

      .plates__head {
        display: grid;
        padding: clamp(48px, 8vw, 118px) var(--gutter);
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: end;
        border-bottom: 1px solid var(--rule-light);
      }

      .plates__head h2 {
        margin: 0;
        font-size: clamp(42px, 7vw, 112px);
        letter-spacing: -0.075em;
        line-height: 0.82;
      }

      .plates__head p {
        max-width: 37ch;
        margin: 0;
        justify-self: end;
        font-size: clamp(16px, 1.8vw, 24px);
        line-height: 1.35;
      }

      .plate {
        display: grid;
        grid-template-columns: minmax(0, 1.48fr) minmax(280px, 0.52fr);
        border-bottom: 1px solid var(--rule-light);
      }

      .plate:nth-child(even) {
        grid-template-columns: minmax(280px, 0.52fr) minmax(0, 1.48fr);
      }

      .plate:nth-child(even) .plate__media {
        order: 2;
        border-right: 0;
        border-left: 1px solid var(--rule-light);
      }

      .plate__media {
        position: relative;
        min-width: 0;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-right: 1px solid var(--rule-light);
        background: var(--ink);
        cursor: zoom-in;
      }

      .plate__media::after {
        position: absolute;
        right: 18px;
        bottom: 18px;
        display: grid;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(242, 241, 234, 0.6);
        border-radius: 50%;
        background: rgba(17, 27, 37, 0.56);
        color: var(--fog);
        content: "+";
        font: 400 26px/1 var(--sans);
        place-items: center;
        transition: transform 180ms ease, background 180ms ease;
        backdrop-filter: blur(8px);
      }

      .plate__media:hover::after {
        background: var(--orange);
        color: var(--ink);
        transform: rotate(90deg);
      }

      .plate__media img {
        width: 100%;
        height: 100%;
        min-height: 520px;
        object-fit: cover;
        transition: transform 600ms cubic-bezier(0.2, 0.75, 0.25, 1);
      }

      .plate__media:hover img {
        transform: scale(1.012);
      }

      .plate__copy {
        display: flex;
        min-width: 0;
        min-height: 580px;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(26px, 4vw, 64px) var(--gutter);
      }

      .plate__number {
        color: var(--brick);
        font: 750 clamp(30px, 4vw, 58px)/1 var(--mono);
        letter-spacing: -0.08em;
      }

      .plate h3 {
        max-width: 9ch;
        margin: 36px 0 18px;
        font-size: clamp(34px, 4.4vw, 70px);
        font-weight: 760;
        letter-spacing: -0.065em;
        line-height: 0.9;
      }

      .plate__mode {
        margin: 0;
        font: 700 10px/1.3 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .plate__description {
        max-width: 32ch;
        margin: 36px 0 0;
        font-size: clamp(15px, 1.35vw, 19px);
        line-height: 1.48;
      }

      .reality {
        display: grid;
        grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
        background: var(--brick);
        color: var(--fog);
      }

      .reality__head {
        padding: clamp(48px, 8vw, 110px) var(--gutter);
        border-right: 1px solid rgba(242, 241, 234, 0.28);
      }

      .reality h2 {
        max-width: 8ch;
      }

      .reality__levels {
        display: grid;
      }

      .reality article {
        display: grid;
        padding: clamp(28px, 4vw, 54px) var(--gutter);
        grid-template-columns: 70px minmax(0, 1fr);
        gap: 22px;
        align-content: center;
      }

      .reality article + article {
        border-top: 1px solid rgba(242, 241, 234, 0.28);
      }

      .reality__number {
        color: var(--amber);
        font: 700 13px/1 var(--mono);
      }

      .reality h3 {
        margin: 0 0 12px;
        font-size: clamp(22px, 2.3vw, 34px);
        letter-spacing: -0.04em;
      }

      .reality p {
        max-width: 48ch;
        margin: 0;
        color: rgba(242, 241, 234, 0.8);
        line-height: 1.55;
      }

      .boundary {
        display: grid;
        padding: clamp(46px, 8vw, 118px) var(--gutter);
        grid-template-columns: 0.7fr 1.3fr;
        gap: 48px;
        background: var(--sand);
      }

      .boundary h2 {
        margin: 0;
        font: 750 11px/1.3 var(--mono);
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .boundary__copy {
        max-width: 1000px;
      }

      .boundary__lead {
        margin: 0;
        font-size: clamp(25px, 4vw, 58px);
        font-weight: 650;
        letter-spacing: -0.05em;
        line-height: 1.02;
      }

      .sources {
        display: flex;
        margin: 42px 0 0;
        padding: 0;
        flex-wrap: wrap;
        gap: 10px;
        list-style: none;
      }

      .sources a {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        padding: 10px 14px;
        border: 1px solid var(--ink);
        font: 700 10px/1.2 var(--mono);
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .sources a:hover {
        background: var(--ink);
        color: var(--fog);
      }

      .site-foot {
        display: flex;
        min-height: 110px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 26px var(--gutter);
        background: var(--ink);
        color: var(--fog);
        font: 600 10px/1.5 var(--mono);
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .site-foot nav {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .site-foot a {
        text-underline-offset: 4px;
      }

      dialog {
        width: 100vw;
        max-width: none;
        height: 100dvh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: rgba(17, 27, 37, 0.98);
        color: var(--fog);
      }

      dialog::backdrop {
        background: rgba(17, 27, 37, 0.9);
      }

      .viewer {
        display: grid;
        height: 100%;
        grid-template-rows: 54px minmax(0, 1fr) auto;
      }

      .viewer__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--rule-dark);
      }

      .viewer__count,
      .viewer__close {
        padding: 0 18px;
        font: 700 10px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .viewer__close {
        height: 100%;
        border: 0;
        border-left: 1px solid var(--rule-dark);
        background: transparent;
        cursor: pointer;
      }

      .viewer__close:hover {
        background: var(--fog);
        color: var(--ink);
      }

      .viewer__stage {
        position: relative;
        display: grid;
        min-height: 0;
        padding: 16px clamp(16px, 4vw, 64px);
        place-items: center;
      }

      .viewer__image {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .viewer__nav {
        position: absolute;
        top: 50%;
        display: grid;
        width: 48px;
        height: 48px;
        border: 1px solid var(--rule-dark);
        border-radius: 50%;
        background: rgba(17, 27, 37, 0.76);
        color: var(--fog);
        cursor: pointer;
        font-size: 24px;
        place-items: center;
        transform: translateY(-50%);
      }

      .viewer__nav:hover {
        background: var(--orange);
        color: var(--ink);
      }

      .viewer__nav[data-step="-1"] {
        left: 14px;
      }

      .viewer__nav[data-step="1"] {
        right: 14px;
      }

      .viewer__caption {
        display: grid;
        padding: 18px var(--gutter) 24px;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 20px;
        border-top: 1px solid var(--rule-dark);
      }

      .viewer__caption strong {
        color: var(--orange);
        font: 700 11px/1.4 var(--mono);
      }

      .viewer__caption span {
        font-size: clamp(14px, 1.5vw, 18px);
        line-height: 1.35;
      }

      @media (max-width: 900px) {
        .intro,
        .reality,
        .boundary {
          grid-template-columns: 1fr;
        }

        .intro__title,
        .reality__head {
          border-right: 0;
          border-bottom: 1px solid var(--rule-light);
        }

        .rules ol {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .rules li:not(:nth-child(4n + 1)) {
          padding-left: 0;
          border-left: 0;
        }

        .rules li:nth-child(even) {
          padding-left: 20px;
          border-left: 1px solid var(--rule-dark);
        }

        .plate,
        .plate:nth-child(even) {
          grid-template-columns: 1fr;
        }

        .plate:nth-child(even) .plate__media {
          order: initial;
        }

        .plate__media,
        .plate:nth-child(even) .plate__media {
          border: 0;
          border-bottom: 1px solid var(--rule-light);
        }

        .plate__media img {
          min-height: 0;
          aspect-ratio: 3 / 2;
        }

        .plate__copy {
          min-height: 0;
        }
      }

      @media (max-width: 640px) {
        .site-head {
          grid-template-columns: minmax(0, 1fr) auto auto;
        }

        .issue {
          display: none;
        }

        .site-head a {
          padding-inline: 14px;
        }

        .hero {
          min-height: 84svh;
        }

        .hero__image {
          object-position: 53% center;
        }

        h1 {
          font-size: clamp(50px, 17vw, 74px);
          line-height: 0.82;
        }

        .thesis,
        .plates__head {
          grid-template-columns: 1fr;
        }

        .thesis article,
        .thesis article + article {
          padding: 18px 0;
          border-left: 0;
        }

        .thesis article + article {
          border-top: 1px solid var(--rule-light);
        }

        .rules__head {
          display: grid;
        }

        .rules ol {
          grid-template-columns: 1fr;
        }

        .rules li,
        .rules li:nth-child(even) {
          min-height: 0;
          padding: 18px 0 24px;
          border-left: 0;
        }

        .rules li::before {
          margin-bottom: 22px;
        }

        .plates__head p {
          justify-self: start;
        }

        .plate__copy {
          padding-block: 28px 42px;
        }

        .plate h3 {
          margin-top: 30px;
        }

        .reality article {
          grid-template-columns: 44px minmax(0, 1fr);
        }

        .boundary {
          gap: 24px;
        }

        .site-foot {
          align-items: flex-start;
          flex-direction: column;
        }

        .viewer__caption {
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .viewer__nav {
          top: auto;
          bottom: 14px;
          transform: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#study">Skip to field study</a>

    <header class="site-head">
      <a class="brand" href="/">PointCast</a>
      <span class="issue">Field Study 001 · El Segundo Coast</span>
      <a href="/beach-commons">Series ↗</a>
      <a href="/beach-commons/v1.json">JSON ↗</a>
    </header>

    <main id="study">
      <section class="hero" aria-labelledby="page-title">
        <img
          class="hero__image"
          src={BEACH_COMMONS_PROTOTYPES[5].image}
          alt=""
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <div class="hero__copy">
          <p class="eyebrow">PointCast Field Study 001 · July 2026</p>
          <h1 id="page-title">
            Beach Commons
            <span>Hardpoint + Softkit</span>
          </h1>
          <p class="hero__dek">{BEACH_COMMONS.dek}</p>
        </div>
      </section>

      <section class="intro" aria-labelledby="central-move">
        <div class="intro__title">
          <p class="section-label">The central move</p>
          <h2 id="central-move">Do not ask one material to do everything.</h2>
        </div>
        <div class="intro__body">
          <p class="intro__lead">
            Stone where weather and shared services demand calm. A kit everywhere
            people should be able to change their minds.
          </p>
          <div class="thesis">
            <article>
              <h3>Hardpoint</h3>
              <p>{BEACH_COMMONS.thesis.hardpoint}</p>
            </article>
            <article>
              <h3>Softkit</h3>
              <p>{BEACH_COMMONS.thesis.softkit}</p>
            </article>
            <article>
              <h3>Sacrificial edge</h3>
              <p>{BEACH_COMMONS.thesis.edge}</p>
            </article>
          </div>
        </div>
      </section>

      <section class="rules" aria-labelledby="commons-rules">
        <div class="rules__head">
          <h2 id="commons-rules">Eight rules of the commons</h2>
          <p class="rules__aside">
            Architecture is treated as a social protocol before it becomes a
            collection of objects.
          </p>
        </div>
        <ol>
          {BEACH_COMMONS.rules.map((rule) => <li>{rule}</li>)}
        </ol>
      </section>

      <section class="plates" aria-labelledby="six-prototypes">
        <div class="plates__head">
          <h2 id="six-prototypes">Six prototypes</h2>
          <p>
            From a kit laid out on sand to a low-digital night commons. Open any
            plate for the full field image.
          </p>
        </div>

        {BEACH_COMMONS_PROTOTYPES.map((prototype, index) => (
          <article class="plate" id={`prototype-${prototype.id}`}>
            <button
              class="plate__media"
              type="button"
              data-prototype-index={index}
              aria-label={`Open full image: ${prototype.title}`}
            >
              <img
                src={prototype.image}
                alt={prototype.alt}
                width="1536"
                height="1024"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>
            <div class="plate__copy">
              <div>
                <span class="plate__number">{prototype.id}</span>
                <h3>{prototype.title}</h3>
                <p class="plate__mode">{prototype.mode}</p>
              </div>
              <p class="plate__description">{prototype.description}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="reality" aria-labelledby="three-realities">
        <div class="reality__head">
          <p class="section-label">From image to place</p>
          <h2 id="three-realities">Three levels of reality</h2>
        </div>
        <div class="reality__levels">
          {BEACH_COMMONS.realityLevels.map((level, index) => (
            <article>
              <span class="reality__number">0{index + 1}</span>
              <div>
                <h3>{level.title}</h3>
                <p>{level.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="boundary" aria-labelledby="boundary">
        <h2 id="boundary">The honest boundary</h2>
        <div class="boundary__copy">
          <p class="boundary__lead">{BEACH_COMMONS.boundary}</p>
          <ul class="sources" aria-label="Place and regulatory context">
            <li>
              <a href="https://beaches.lacounty.gov/dockweiler-beach/">
                Dockweiler context ↗
              </a>
            </li>
            <li>
              <a href="https://beaches.lacounty.gov/coastal-resilience/living-shorelines/">
                Living shorelines ↗
              </a>
            </li>
            <li>
              <a href="https://coastal.ca.gov/whoweare.html">
                Coastal Commission ↗
              </a>
            </li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <span>Michael Hoydich + Codex · El Segundo · 2026</span>
      <nav aria-label="Field study links">
        <a href="/beach-commons">Beach Commons series</a>
        <a href="/beach-commons/v2">V2 · Superstructures + Living Games</a>
        <a href="/b/0506">Block 0506</a>
        <a href="/beach-commons/v1.json">Machine edition</a>
        <a href="/">PointCast home</a>
      </nav>
    </footer>

    <dialog aria-label="Beach Commons full image viewer">
      <div class="viewer">
        <div class="viewer__head">
          <span class="viewer__count">01 / 06</span>
          <button class="viewer__close" type="button">Close ×</button>
        </div>
        <div class="viewer__stage">
          <img class="viewer__image" alt="" width="1536" height="1024" />
          <button class="viewer__nav" type="button" data-step="-1" aria-label="Previous prototype">
            ←
          </button>
          <button class="viewer__nav" type="button" data-step="1" aria-label="Next prototype">
            →
          </button>
        </div>
        <div class="viewer__caption">
          <strong class="viewer__title"></strong>
          <span class="viewer__description"></span>
        </div>
      </div>
    </dialog>

    <script define:vars={{ prototypes: BEACH_COMMONS_PROTOTYPES }}>
      const dialog = document.querySelector('dialog');
      const image = dialog?.querySelector('.viewer__image');
      const count = dialog?.querySelector('.viewer__count');
      const title = dialog?.querySelector('.viewer__title');
      const description = dialog?.querySelector('.viewer__description');
      let activeIndex = 0;
      let opener = null;

      function render(index) {
        if (!dialog || !image || !count || !title || !description) return;
        activeIndex = (index + prototypes.length) % prototypes.length;
        const prototype = prototypes[activeIndex];
        image.src = prototype.image;
        image.alt = prototype.alt;
        count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(prototypes.length).padStart(2, '0')}`;
        title.textContent = `${prototype.id} · ${prototype.title}`;
        description.textContent = prototype.description;
      }

      document.querySelectorAll('[data-prototype-index]').forEach((button) => {
        button.addEventListener('click', () => {
          opener = button;
          render(Number(button.getAttribute('data-prototype-index') || 0));
          dialog?.showModal();
        });
      });

      dialog?.addEventListener('close', () => {
        opener?.focus();
      });

      dialog?.querySelector('.viewer__close')?.addEventListener('click', () => {
        dialog.close();
      });

      dialog?.querySelectorAll('[data-step]').forEach((button) => {
        button.addEventListener('click', () => {
          render(activeIndex + Number(button.getAttribute('data-step') || 0));
        });
      });

      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      window.addEventListener('keydown', (event) => {
        if (!dialog?.open) return;
        if (event.key === 'ArrowLeft') render(activeIndex - 1);
        if (event.key === 'ArrowRight') render(activeIndex + 1);
        if (event.key === 'Escape') {
          event.preventDefault();
          dialog.close();
        }
      });
    </script>
  </body>
</html>
