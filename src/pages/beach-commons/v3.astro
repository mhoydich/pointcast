---
import {
  BEACH_COMMONS_V3,
  BEACH_COMMONS_V3_PLATES,
} from '../../lib/beach-commons-v3';

const title = `${BEACH_COMMONS_V3.title} — ${BEACH_COMMONS_V3.subtitle}`;
const description = BEACH_COMMONS_V3.dek;
const canonical = BEACH_COMMONS_V3.url;
const socialImage = 'https://pointcast.xyz/images/og/beach-commons-v3.png';
const hero = BEACH_COMMONS_V3_PLATES[7];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  '@id': `${canonical}#field-study`,
  url: canonical,
  name: title,
  alternateName: BEACH_COMMONS_V3.magazineTitle,
  description,
  datePublished: BEACH_COMMONS_V3.publishedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Field Study',
    url: 'https://pointcast.xyz',
  },
  isBasedOn: BEACH_COMMONS_V3.previousEdition.url,
  mainEntityOfPage: BEACH_COMMONS_V3.jsonUrl,
  image: BEACH_COMMONS_V3_PLATES.map((plate) => new URL(plate.image, canonical).href),
  creator: BEACH_COMMONS_V3.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e75a2f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BEACH_COMMONS_V3.jsonUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,800&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --ink: #14201d;
        --paper: #f3ead8;
        --cream: #fff7e8;
        --orange: #e75a2f;
        --palm: #727a38;
        --sea: #2c7784;
        --night: #101a21;
        --line: rgba(20, 32, 29, .26);
        --sans: 'DM Sans', sans-serif;
        --serif: 'DM Serif Display', serif;
        --mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
      }
      a { color: inherit; }
      img { max-width: 100%; }
      button, a { -webkit-tap-highlight-color: transparent; }

      .skip {
        position: fixed;
        z-index: 200;
        top: 8px;
        left: 8px;
        transform: translateY(-150%);
        background: var(--cream);
        padding: 10px 14px;
        font: 700 11px/1 var(--mono);
      }
      .skip:focus { transform: translateY(0); }

      .head {
        position: sticky;
        z-index: 80;
        top: 0;
        display: grid;
        grid-template-columns: minmax(160px, 1fr) auto auto auto auto;
        min-height: 54px;
        background: rgba(16, 26, 33, .95);
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, .25);
        backdrop-filter: blur(14px);
      }
      .head > * {
        min-width: 0;
        display: flex;
        align-items: center;
        padding: 0 24px;
        border-left: 1px solid rgba(255, 255, 255, .2);
        font: 700 10px/1 var(--mono);
        letter-spacing: .11em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .head .brand {
        border-left: 0;
        font: 800 14px/1 var(--sans);
        letter-spacing: .17em;
      }
      .head a:hover, .head a:focus-visible {
        background: var(--orange);
        color: white;
        outline: 0;
      }

      .hero {
        position: relative;
        min-height: min(900px, calc(100vh - 54px));
        display: flex;
        align-items: flex-end;
        isolation: isolate;
        overflow: hidden;
        background: var(--night);
        color: white;
      }
      .hero__image, .hero__wash {
        position: absolute;
        inset: 0;
      }
      .hero__image {
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero__wash {
        z-index: -1;
        background:
          linear-gradient(90deg, rgba(9, 14, 17, .84) 0%, rgba(9, 14, 17, .28) 62%, rgba(9, 14, 17, .12)),
          linear-gradient(0deg, rgba(9, 14, 17, .82) 0%, transparent 58%);
      }
      .hero__copy {
        width: min(1420px, 100%);
        margin: 0 auto;
        padding: clamp(80px, 12vw, 170px) clamp(22px, 5vw, 76px) clamp(44px, 7vw, 92px);
      }
      .kicker, .eyebrow {
        margin: 0 0 18px;
        font: 700 10px/1.4 var(--mono);
        letter-spacing: .15em;
        text-transform: uppercase;
      }
      .hero h1 {
        max-width: 1050px;
        margin: 0;
        font: 400 clamp(66px, 12.8vw, 190px)/.71 var(--serif);
        letter-spacing: -.055em;
      }
      .hero h1 span {
        display: block;
        color: #f3b848;
        font-style: italic;
      }
      .hero__dek {
        max-width: 690px;
        margin: 32px 0 0;
        font-size: clamp(20px, 2.25vw, 34px);
        font-weight: 600;
        line-height: 1.08;
      }
      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 32px;
      }
      .button {
        display: inline-flex;
        align-items: center;
        min-height: 46px;
        padding: 0 16px;
        border: 1px solid currentColor;
        font: 700 10px/1 var(--mono);
        letter-spacing: .1em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .button--hot { background: var(--orange); border-color: var(--orange); color: white; }
      .button:hover, .button:focus-visible { background: white; color: var(--ink); outline: 0; }

      .lede {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
        gap: clamp(36px, 8vw, 120px);
        padding: clamp(70px, 10vw, 150px) max(5vw, calc((100vw - 1420px) / 2));
        background: var(--cream);
      }
      .lede h2 {
        margin: 0;
        font: 400 clamp(54px, 8vw, 116px)/.86 var(--serif);
        letter-spacing: -.045em;
      }
      .lede__copy {
        align-self: end;
        font-size: clamp(18px, 1.6vw, 25px);
        line-height: 1.45;
      }
      .lede__copy p { margin: 0 0 20px; }
      .lede__copy strong { color: var(--orange); }

      .numbers {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        background: var(--orange);
        color: white;
        border-block: 1px solid rgba(20, 32, 29, .35);
      }
      .numbers div { min-width: 0; padding: clamp(28px, 4vw, 56px); border-right: 1px solid rgba(255, 255, 255, .28); }
      .numbers div:last-child { border-right: 0; }
      .numbers strong { display: block; font: 400 clamp(52px, 7vw, 102px)/.75 var(--serif); }
      .numbers span { display: block; margin-top: 16px; font: 700 9px/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; }

      .loops {
        padding: clamp(74px, 10vw, 150px) max(5vw, calc((100vw - 1420px) / 2));
        background: var(--ink);
        color: var(--cream);
      }
      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, .65fr);
        gap: 30px;
        align-items: end;
        margin-bottom: 44px;
      }
      .section-head h2 {
        margin: 0;
        font: 400 clamp(54px, 8vw, 116px)/.8 var(--serif);
        letter-spacing: -.045em;
      }
      .section-head p:last-child { margin: 0; font-size: 18px; line-height: 1.5; }
      .loop-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid rgba(255,255,255,.25); }
      .loop {
        min-width: 0;
        padding: clamp(26px, 4vw, 52px);
        border-right: 1px solid rgba(255,255,255,.25);
        border-bottom: 1px solid rgba(255,255,255,.25);
      }
      .loop:nth-child(even) { border-right: 0; }
      .loop:nth-last-child(-n + 2) { border-bottom: 0; }
      .loop h3 { margin: 0 0 34px; color: #f3b848; font: 400 clamp(34px, 4vw, 56px)/1 var(--serif); }
      .loop dl { margin: 0; }
      .loop dt { margin-top: 20px; font: 700 9px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; opacity: .65; }
      .loop dd { margin: 8px 0 0; font-size: 17px; line-height: 1.42; }

      .plates { background: var(--paper); }
      .plates__intro {
        padding: clamp(68px, 9vw, 130px) max(5vw, calc((100vw - 1420px) / 2)) 46px;
      }
      .plates__intro h2 { margin: 0; font: 400 clamp(58px, 9vw, 130px)/.8 var(--serif); letter-spacing: -.05em; }
      .plates__intro p:last-child { max-width: 620px; margin: 26px 0 0 auto; font-size: 20px; line-height: 1.45; }
      .plate {
        display: grid;
        grid-template-columns: minmax(290px, .65fr) minmax(0, 1.35fr);
        min-height: min(780px, 76vw);
        border-top: 1px solid var(--line);
      }
      .plate:nth-child(even) { grid-template-columns: minmax(0, 1.35fr) minmax(290px, .65fr); }
      .plate:nth-child(even) .plate__copy { order: 2; }
      .plate__copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(28px, 4vw, 62px);
        background: var(--cream);
      }
      .plate__id { color: var(--orange); font: 700 clamp(38px, 5vw, 72px)/1 var(--mono); }
      .plate h3 { margin: 34px 0 10px; font: 400 clamp(48px, 6vw, 88px)/.86 var(--serif); letter-spacing: -.04em; }
      .plate__mode { font: 700 9px/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
      .plate__description { max-width: 39ch; margin: 30px 0 0; font-size: clamp(17px, 1.5vw, 22px); line-height: 1.45; }
      .plate__open {
        position: relative;
        min-width: 0;
        min-height: 440px;
        padding: 0;
        overflow: hidden;
        border: 0;
        background: var(--night);
        cursor: zoom-in;
      }
      .plate__open img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .5s ease; }
      .plate__open:hover img, .plate__open:focus-visible img { transform: scale(1.018); }
      .plate__open span {
        position: absolute;
        right: 20px;
        bottom: 20px;
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        border: 1px solid white;
        border-radius: 50%;
        background: rgba(16,26,33,.55);
        color: white;
        font-size: 26px;
      }
      .plate__open:focus-visible { outline: 4px solid var(--orange); outline-offset: -4px; }

      .games {
        padding: clamp(72px, 10vw, 150px) max(5vw, calc((100vw - 1420px) / 2));
        background: #d6d68c;
      }
      .games h2 { margin: 0 0 42px; font: 400 clamp(56px, 9vw, 126px)/.78 var(--serif); letter-spacing: -.05em; }
      .game {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 24px;
        padding: 24px 0;
        border-top: 1px solid var(--ink);
      }
      .game:last-child { border-bottom: 1px solid var(--ink); }
      .game h3 { margin: 0; font: 400 clamp(28px, 3vw, 44px)/1 var(--serif); }
      .game p { margin: 0; font-size: 18px; line-height: 1.45; }

      .reality {
        padding: clamp(72px, 10vw, 150px) max(5vw, calc((100vw - 1420px) / 2));
        background: var(--paper);
      }
      .reality h2 { margin: 0 0 44px; font: 400 clamp(56px, 9vw, 126px)/.8 var(--serif); letter-spacing: -.05em; }
      .reality__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .reality article { padding: 26px; border: 1px solid var(--ink); background: var(--cream); }
      .reality b { color: var(--orange); font: 700 11px/1 var(--mono); }
      .reality h3 { margin: 24px 0 12px; font: 400 34px/1 var(--serif); }
      .reality p { margin: 0; line-height: 1.5; }

      .boundary {
        display: grid;
        grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr);
        gap: 42px;
        padding: clamp(62px, 8vw, 110px) max(5vw, calc((100vw - 1420px) / 2));
        background: var(--orange);
        color: white;
      }
      .boundary h2 { margin: 0; font: 400 clamp(50px, 7vw, 94px)/.82 var(--serif); }
      .boundary p { margin: 0; font-size: clamp(18px, 2vw, 28px); line-height: 1.42; }
      .boundary__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

      .foot {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        padding: 32px 5vw;
        background: var(--night);
        color: white;
        font: 700 9px/1.5 var(--mono);
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .foot nav { display: flex; flex-wrap: wrap; gap: 18px; }

      dialog {
        width: 100vw;
        max-width: none;
        height: 100vh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: var(--night);
        color: white;
      }
      dialog::backdrop { background: rgba(16,26,33,.96); }
      .viewer {
        min-height: 100%;
        display: grid;
        grid-template-rows: 56px minmax(0, 1fr) auto;
      }
      .viewer__top {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,.25);
        font: 700 9px/1 var(--mono);
        letter-spacing: .12em;
      }
      .viewer__top span, .viewer__close { display: flex; align-items: center; padding: 0 18px; }
      .viewer__close { border: 0; border-left: 1px solid rgba(255,255,255,.25); background: transparent; color: white; font: inherit; cursor: pointer; text-transform: uppercase; }
      .viewer__stage { position: relative; min-height: 0; display: grid; place-items: center; padding: 16px 74px; }
      .viewer__stage img { width: 100%; height: 100%; max-height: calc(100vh - 190px); object-fit: contain; }
      .viewer__nav {
        position: absolute;
        top: 50%;
        width: 48px;
        height: 48px;
        border: 1px solid rgba(255,255,255,.45);
        border-radius: 50%;
        background: rgba(16,26,33,.68);
        color: white;
        font-size: 24px;
        cursor: pointer;
      }
      .viewer__prev { left: 14px; }
      .viewer__next { right: 14px; }
      .viewer__caption {
        display: grid;
        grid-template-columns: .45fr 1fr;
        gap: 24px;
        padding: 18px;
        border-top: 1px solid rgba(255,255,255,.25);
      }
      .viewer__caption strong { color: #f3b848; font: 700 10px/1.4 var(--mono); text-transform: uppercase; }
      .viewer__caption span { font-size: 15px; line-height: 1.4; }

      @media (max-width: 820px) {
        .head { grid-template-columns: minmax(0, 1fr) auto auto auto; }
        .head .issue { display: none; }
        .lede, .section-head, .boundary { grid-template-columns: 1fr; }
        .numbers { grid-template-columns: repeat(2, 1fr); }
        .numbers div:nth-child(2) { border-right: 0; }
        .numbers div:nth-child(-n + 2) { border-bottom: 1px solid rgba(255,255,255,.28); }
        .plate, .plate:nth-child(even) { grid-template-columns: 1fr; min-height: 0; }
        .plate:nth-child(even) .plate__copy { order: 0; }
        .plate__copy { min-height: 460px; }
        .plate__open { min-height: 62vw; }
        .reality__grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 560px) {
        .head > * { padding-inline: 13px; }
        .head .review-link { display: none; }
        .head { grid-template-columns: minmax(0, 1fr) auto auto; }
        .hero { min-height: calc(100svh - 54px); }
        .hero__image { object-position: 62% center; }
        .hero h1 { font-size: clamp(62px, 22vw, 98px); }
        .hero__dek { font-size: 19px; }
        .loop-grid { grid-template-columns: 1fr; }
        .loop, .loop:nth-child(even) { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.25); }
        .loop:last-child { border-bottom: 0; }
        .plates__intro p:last-child { margin-left: 0; }
        .plate__copy { min-height: 410px; }
        .plate__open { min-height: 72vw; }
        .game { grid-template-columns: 1fr; }
        .foot { flex-direction: column; }
        .viewer__stage { padding: 14px 16px 74px; }
        .viewer__stage img { height: auto; max-height: calc(100vh - 210px); }
        .viewer__nav { top: auto; bottom: 12px; }
        .viewer__caption { grid-template-columns: 1fr; gap: 8px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .plate__open img { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#study">Skip to field study</a>

    <header class="head">
      <a class="brand" href="/">PointCast</a>
      <span class="issue">Field Study 003 · El Segundo Coast</span>
      <a href="/beach-commons/v2">V2 ↙</a>
      <a class="review-link" href="/reviews/beach-commons-v3">Review ↗</a>
      <a href="/beach-commons/v3.json">JSON ↗</a>
    </header>

    <main id="study">
      <section class="hero" aria-labelledby="page-title">
        <img class="hero__image" src={hero.image} width="1536" height="1024" alt={hero.alt} fetchpriority="high" />
        <div class="hero__wash"></div>
        <div class="hero__copy">
          <p class="kicker">PointCast Field Study 003 · Flash edition · July 2026</p>
          <h1 id="page-title">Beach Commons <span>V3</span></h1>
          <p class="hero__dek">{BEACH_COMMONS_V3.dek}</p>
          <div class="hero__actions">
            <a class="button button--hot" href="#plates">Open the eight plates ↓</a>
            <a class="button" href={BEACH_COMMONS_V3.reviewUrl}>Read The Maximum Beach ↗</a>
          </div>
        </div>
      </section>

      <section class="lede" aria-labelledby="lede-title">
        <div>
          <p class="eyebrow">The V3 move</p>
          <h2 id="lede-title">The building is a breakfast clock.</h2>
        </div>
        <div class="lede__copy">
          <p><strong>Fast does not mean careless.</strong> The ingredients, tools, safety roles, permits, and choreography arrive before dawn. The public action is the transformation.</p>
          <p>Grain becomes bread. Clean pruning material becomes shade. Labor becomes a game. Cleanup becomes the final score.</p>
        </div>
      </section>

      <section class="numbers" aria-label="Beach Commons V3 key facts">
        <div><strong>01</strong><span>One-day public metabolism</span></div>
        <div><strong>08</strong><span>Generated field plates</span></div>
        <div><strong>00</strong><span>Living palms harvested</span></div>
        <div><strong>01</strong><span>Very long shared table</span></div>
      </section>

      <section class="loops" aria-labelledby="loops-title">
        <header class="section-head">
          <div>
            <p class="eyebrow">Four closed loops</p>
            <h2 id="loops-title">Useful, visible, finite.</h2>
          </div>
          <p>Everything entering the commons has a public use, a steward, and a way back out. Nothing needs a screen to explain whether it is working.</p>
        </header>
        <div class="loop-grid">
          {BEACH_COMMONS_V3.loops.map((loop) => (
            <article class="loop">
              <h3>{loop.title}</h3>
              <dl>
                <dt>Input</dt>
                <dd>{loop.input}</dd>
                <dt>Output</dt>
                <dd>{loop.output}</dd>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section class="plates" id="plates" aria-labelledby="plates-title">
        <header class="plates__intro">
          <p class="eyebrow">Eight collective states</p>
          <h2 id="plates-title">Bake. Weave. Raise. Feast.</h2>
          <p>From the first oven glow to one moonlit table. Open any image for the full field plate.</p>
        </header>
        {BEACH_COMMONS_V3_PLATES.map((plate, index) => (
          <article class="plate">
            <div class="plate__copy">
              <div>
                <span class="plate__id">{plate.id}</span>
                <h3>{plate.title}</h3>
                <p class="plate__mode">{plate.mode} · {plate.system}</p>
              </div>
              <p class="plate__description">{plate.description}</p>
            </div>
            <button class="plate__open" type="button" data-open={index} aria-label={`Open full image: ${plate.title}`}>
              <img src={plate.image} width="1536" height="1024" alt={plate.alt} loading={index < 2 ? 'eager' : 'lazy'} />
              <span aria-hidden="true">+</span>
            </button>
          </article>
        ))}
      </section>

      <section class="games" aria-labelledby="games-title">
        <p class="eyebrow">How the crowd plays</p>
        <h2 id="games-title">Four games. Four useful scores.</h2>
        {BEACH_COMMONS_V3.games.map((game) => (
          <article class="game">
            <h3>{game.title}</h3>
            <p>{game.score}</p>
          </article>
        ))}
      </section>

      <section class="reality" aria-labelledby="reality-title">
        <p class="eyebrow">From image to place</p>
        <h2 id="reality-title">Three levels of reality.</h2>
        <div class="reality__grid">
          {BEACH_COMMONS_V3.realityLevels.map((level, index) => (
            <article>
              <b>{String(index + 1).padStart(2, '0')}</b>
              <h3>{level.title}</h3>
              <p>{level.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <h2 id="boundary-title">The honest boundary.</h2>
        <div>
          <p>{BEACH_COMMONS_V3.boundary}</p>
          <div class="boundary__links">
            <a class="button" href="/reviews/beach-commons-v3">Magazine feature ↗</a>
            <a class="button" href="/beach-commons/v3.json">Machine edition ↗</a>
            <a class="button" href="/b/0509">Block 0509 ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Michael Hoydich + Codex · El Segundo · 2026</span>
      <nav aria-label="Field study links">
        <a href="/beach-commons/v2">V2 · Living Games</a>
        <a href="/reviews/beach-commons-v3">The Maximum Beach</a>
        <a href="/beach-commons/v3.json">Machine edition</a>
        <a href="/">PointCast home</a>
      </nav>
    </footer>

    <dialog aria-label="Beach Commons V3 full image viewer" data-viewer>
      <div class="viewer">
        <header class="viewer__top">
          <span data-count>01 / 08</span>
          <button class="viewer__close" type="button" data-close>Close ×</button>
        </header>
        <div class="viewer__stage">
          <img data-viewer-image src={hero.image} alt="" />
          <button class="viewer__nav viewer__prev" type="button" data-prev aria-label="Previous prototype">←</button>
          <button class="viewer__nav viewer__next" type="button" data-next aria-label="Next prototype">→</button>
        </div>
        <div class="viewer__caption">
          <strong data-caption-title></strong>
          <span data-caption-copy></span>
        </div>
      </div>
    </dialog>

    <script define:vars={{ plates: BEACH_COMMONS_V3_PLATES }}>
      const dialog = document.querySelector('[data-viewer]');
      const image = dialog?.querySelector('[data-viewer-image]');
      const count = dialog?.querySelector('[data-count]');
      const title = dialog?.querySelector('[data-caption-title]');
      const copy = dialog?.querySelector('[data-caption-copy]');
      const openers = [...document.querySelectorAll('[data-open]')];
      let active = 0;
      let returnFocus = null;

      const render = () => {
        const plate = plates[active];
        if (!plate || !image || !count || !title || !copy) return;
        image.src = plate.image;
        image.alt = plate.alt;
        count.textContent = `${plate.id} / ${String(plates.length).padStart(2, '0')}`;
        title.textContent = `${plate.id} · ${plate.title}`;
        copy.textContent = plate.description;
      };

      const move = (delta) => {
        active = (active + delta + plates.length) % plates.length;
        render();
      };

      openers.forEach((button) => {
        button.addEventListener('click', () => {
          active = Number(button.dataset.open);
          returnFocus = button;
          render();
          dialog?.showModal();
        });
      });

      dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      dialog?.querySelector('[data-prev]')?.addEventListener('click', () => move(-1));
      dialog?.querySelector('[data-next]')?.addEventListener('click', () => move(1));
      dialog?.addEventListener('close', () => returnFocus?.focus());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') move(-1);
        if (event.key === 'ArrowRight') move(1);
        if (event.key === 'Escape') dialog.close();
      });
    </script>
  </body>
</html>
