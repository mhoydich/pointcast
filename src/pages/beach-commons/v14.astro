---
import {
  BEACH_COMMONS_V14,
  HARDPOINT_PLATES,
  HARDPOINT_RULES,
  HARDPOINT_SOURCES,
  HARDPOINT_HOUSES,
  HARDPOINT_OUTCOMES,
  HARDPOINT_SCORE,
  HARDPOINT_FIXTURES,
} from '../../lib/beach-commons-v14';

const canonical = BEACH_COMMONS_V14.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0540.png';
const totalPoints = HARDPOINT_SCORE.reduce((sum, category) => sum + category.points, 0);
const chassisElements = [
  'masonry core',
  'connection rail',
  'isolating gasket',
  'replaceable plate',
  'pin + tether',
  'panel cassette',
  'drainage edge',
  'access zone',
  'inspection mark',
  'service hatch',
  'inventory cart',
  'clean close',
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${canonical}#field-study`,
  name: 'The Hardpoint League — Beach Commons V14',
  alternativeHeadline: BEACH_COMMONS_V14.dek,
  description:
    'A speculative architecture league in which six temporary material houses compete from one durable civic foundation and return cleanly at the end of the season.',
  url: canonical,
  image: socialImage,
  datePublished: BEACH_COMMONS_V14.publishedAt,
  creator: BEACH_COMMONS_V14.creators.map((creator) => ({
    '@type': creator.name.includes('Codex') ? 'Organization' : 'Person',
    name: creator.name,
  })),
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'Beach Commons',
    url: 'https://pointcast.xyz/beach-commons',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content="One durable civic hardpoint hosts six reversible material houses, a complete imagined season, and a league where architecture competes through comfort, repair, access, delight, and clean return."
    />
    <meta name="theme-color" content="#102a37" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/beach-commons/v14.json" />
    <link rel="preload" as="image" href={HARDPOINT_PLATES[0].image} fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="The Hardpoint League — Beach Commons V14" />
    <meta property="og:description" content={BEACH_COMMONS_V14.dek} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Hardpoint League — Beach Commons V14" />
    <meta name="twitter:description" content={BEACH_COMMONS_V14.dek} />
    <meta name="twitter:image" content={socialImage} />
    <title>The Hardpoint League — Beach Commons V14 · PointCast</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the field study</a>

    <nav class="nav" aria-label="Hardpoint League navigation">
      <a class="brand" href="/">PointCast</a>
      <span>Beach Commons · V14</span>
      <div>
        <a href="/beach-commons">Series</a>
        <a href="#styles">Houses</a>
        <a href="#draft-board">Fixture board</a>
        <a href="/beach-commons/v14.json">JSON ↗</a>
      </div>
    </nav>

    <main id="main">
      <header class="hero">
        <div class="hero__image">
          <img
            src={HARDPOINT_PLATES[0].image}
            alt={HARDPOINT_PLATES[0].alt}
            width="1536"
            height="1024"
            fetchpriority="high"
          />
          <div class="hero__stamp" aria-hidden="true">14</div>
        </div>
        <div class="hero__copy">
          <p class="eyebrow">PointCast Field Study 014 · Beach Commons</p>
          <h1><span>The</span> Hardpoint <em>League</em></h1>
          <p class="hero__dek">One foundation. Six architectures. Let the rooms compete.</p>
          <div class="hero__rule">
            <strong>The center stays.</strong>
            <strong>The rooms go home.</strong>
          </div>
          <p class="hero__note">
            A speculative season for timber, aluminum, coated steel, fiberglass, textile, translucent panels,
            cork, woven shade, repair, public life, and one common chassis.
          </p>
          <a class="button" href="#styles">Meet the six houses ↓</a>
        </div>
      </header>

      <section class="opening">
        <p class="section-label">The premise</p>
        <div class="opening__grid">
          <h2>The foundation is the constitution. Every shelter is an amendment.</h2>
          <div>
            <p>
              Return to the first Beach Commons question: what if one storm-tough brick, stone, and precast center
              supplied storage, water, modest power, drainage, accessible seating, and a trustworthy connection
              interface—then invited temporary architectures to keep changing around it?
            </p>
            <p>
              V14 removes compulsory role assignments. Teams choose their own organization and enter complete
              rooms. The league supplies the common bay, safety and access envelope, inspection gates, scoring,
              and clean-return rule. Feedback from every fixture changes the next version of both kit and chassis.
            </p>
          </div>
        </div>
        <div class="facts" aria-label="Hardpoint League facts">
          <div><strong>1</strong><span>Durable hardpoint</span></div>
          <div><strong>6</strong><span>Material houses</span></div>
          <div><strong>{totalPoints}</strong><span>Possible points</span></div>
          <div><strong>8</strong><span>Season plates</span></div>
        </div>
      </section>

      <section class="plates" aria-labelledby="plates-title">
        <div class="section-head">
          <div>
            <p class="section-label">Eight visual plates</p>
            <h2 id="plates-title">From foundation to final return.</h2>
          </div>
          <p>Open any plate for the full field view.</p>
        </div>
        <div class="plate-grid">
          {
            HARDPOINT_PLATES.map((plate, index) => (
              <article class:list={['plate', { 'plate--wide': [0, 5, 7].includes(index) }]}>
                <button
                  class="plate__image"
                  type="button"
                  data-plate-index={index}
                  data-title={plate.title}
                  data-src={plate.image}
                  data-alt={plate.alt}
                  aria-label={`Open full image for ${plate.title}`}
                >
                  <img src={plate.image} alt={plate.alt} width="1536" height="1024" loading={index > 1 ? 'lazy' : 'eager'} />
                  <span>Open plate ↗</span>
                </button>
                <div class="plate__body">
                  <div class="plate__meta">
                    <span>{plate.number}</span>
                    <span>{plate.kicker}</span>
                  </div>
                  <h3>{plate.title}</h3>
                  <p class="plate__thesis">{plate.thesis}</p>
                  <p>{plate.program}</p>
                  <p class="plate__boundary"><strong>Imagined outcome:</strong> {plate.result}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="styles" id="styles" aria-labelledby="styles-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">The material houses</p>
            <h2 id="styles-title">Same chassis. Six complete worlds.</h2>
          </div>
          <p>
            These are simulated entries and results, not material specifications. Each house chooses its own
            organization, program, structural family, enclosure, and atmosphere.
          </p>
        </div>
        <div class="team-grid">
          {
            HARDPOINT_HOUSES.map((house) => (
              <article class="team" style={`--team:${house.color}`}>
                <div class="team__head">
                  <span>{house.mark}</span>
                  <h3>{house.title}</h3>
                </div>
                <p class="team__argument">{house.room}</p>
                <dl>
                  <div><dt>Material argument</dt><dd>{house.material}</dd></div>
                  <div><dt>Table</dt><dd>{house.result}</dd></div>
                  <div><dt>Award</dt><dd>{house.award}</dd></div>
                  <div><dt>Revision</dt><dd>{house.revision}</dd></div>
                </dl>
              </article>
            ))
          }
        </div>
        <aside class="standings-note">
          <span>The fictional final table</span>
          <p>
            Lantern Truss 88 · Palm Vault 86 · Cork Court 84 · Blue Rig 82 · Salt Lantern 80 · Second Sail 78.
            No score is an engineering result. The standings exist to show how repair, comfort, access, and return
            could change the story.
          </p>
        </aside>
      </section>

      <section class="relay" aria-labelledby="relay-title">
        <div class="relay__copy">
          <p class="section-label">The common chassis</p>
          <h2 id="relay-title">Twelve shared facts. Infinite room plans.</h2>
          <p>
            The league does not tell a team who should lead, fabricate, design, finance, host, or repair. It tells
            every entry what must remain compatible, inspectable, accessible, and reversible.
          </p>
          <div class="role-loop" aria-label="Twelve common chassis elements">
            {chassisElements.map((element, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{element}</span>)}
          </div>
        </div>
        <img
          src={HARDPOINT_PLATES[1].image}
          alt={HARDPOINT_PLATES[1].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
      </section>

      <section class="score" aria-labelledby="score-title">
        <div class="section-head">
          <div>
            <p class="section-label">The complete-room score</p>
            <h2 id="score-title">Standing up is the beginning, not the victory.</h2>
          </div>
          <p>No points for unsafe speed, mystery hardware, inaccessible spectacle, or materials with no credible next life.</p>
        </div>
        <div class="score__grid">
          {
            HARDPOINT_SCORE.map((category) => (
              <div class="score-row">
                <span>{category.label}</span>
                <div aria-hidden="true"><i style={`--score:${category.points}`}></i></div>
                <strong>{category.points}</strong>
              </div>
            ))
          }
        </div>
        <p class="score__verdict">
          A striking room can lose. The winning architecture must also explain itself, admit feedback, survive repair,
          welcome the public, come apart, and return every component.
        </p>
      </section>

      <section class="draft" id="draft-board" aria-labelledby="draft-title">
        <div class="draft__intro">
          <p class="section-label">Local instrument · no account · no network write</p>
          <h2 id="draft-title">Fixture Board</h2>
          <p>
            Pick a house and a fixture to see the imagined commentary shift. This is a tiny editorial toy, not a
            structural calculator, forecast, registration, reservation, team, product, or real event.
          </p>
          <div class="draft__buttons" role="group" aria-label="Choose a material house">
            {
              HARDPOINT_HOUSES.map((house, index) => (
                <button
                  type="button"
                  data-team={house.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  style={`--team:${house.color}`}
                >
                  <span>{house.mark}</span>{house.title}
                </button>
              ))
            }
          </div>
          <div class="draft__buttons draft__buttons--fixtures" role="group" aria-label="Choose a league fixture">
            {
              HARDPOINT_FIXTURES.map((fixture, index) => (
                <button
                  type="button"
                  data-fixture={fixture.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span>{fixture.mark}</span>{fixture.title}
                </button>
              ))
            }
          </div>
        </div>
        <div class="draft__receipt" aria-live="polite">
          <p>Simulated fixture commentary</p>
          <h3 id="draft-team">{HARDPOINT_HOUSES[0].title}</h3>
          <dl>
            <div><dt>Material</dt><dd id="draft-material">{HARDPOINT_HOUSES[0].material}</dd></div>
            <div><dt>Room</dt><dd id="draft-room">{HARDPOINT_HOUSES[0].room}</dd></div>
            <div><dt>Fixture</dt><dd id="draft-fixture">{HARDPOINT_FIXTURES[0].title}</dd></div>
            <div><dt>Season result</dt><dd id="draft-result">{HARDPOINT_HOUSES[0].result}</dd></div>
          </dl>
          <p id="draft-argument">{HARDPOINT_HOUSES[0].strength}</p>
          <p id="draft-commentary">{HARDPOINT_FIXTURES[0].entertainment}</p>
          <div>
            <button type="button" id="copy-draft">Copy fixture card</button>
            <button type="button" id="reset-draft">Reset</button>
          </div>
          <small id="draft-status">Nothing is stored or sent.</small>
        </div>
      </section>

      <section class="circuit" aria-labelledby="circuit-title">
        <div class="circuit__image">
          <img
            src={HARDPOINT_PLATES[5].image}
            alt={HARDPOINT_PLATES[5].alt}
            width="1536"
            height="1024"
            loading="lazy"
          />
        </div>
        <div class="circuit__copy">
          <p class="section-label">Overall entertainment</p>
          <h2 id="circuit-title">No central stage. Six reasons to keep walking.</h2>
          <article>
            <span>Daylight / architecture as sport</span>
            <h3>Watch it arrive, rise, prove, and change.</h3>
            <p>
              Carts, tools, joints, raising choreography, inspection gates, shade demonstrations, drainage tests,
              material stories, repairs, and exact pack-down make construction legible without making it reckless.
            </p>
          </article>
          <article>
            <span>Blue hour / architecture as atmosphere</span>
            <h3>Enter six different evenings.</h3>
            <p>
              A concert, dinner, shadow game, reading room, story porch, and quiet cork chamber share one center.
              Visitors edit their own sequence and compare how each material changes public life.
            </p>
          </article>
          <p class="circuit__rule">
            The season is fictional. Any actual installation or organized gathering would need a lawful site,
            qualified design and review, manufacturer or engineered systems, weather limits, accessibility, and
            the permissions applicable to its real scale and program.
          </p>
        </div>
      </section>

      <section class="games" aria-labelledby="games-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">The six-fixture season</p>
            <h2 id="games-title">Every round reveals a different architecture.</h2>
          </div>
          <p>The league alternates spectacle with occupation, feedback, repair, and return.</p>
        </div>
        <ol class="game-grid">
          {
            HARDPOINT_FIXTURES.map((fixture) => (
              <li>
                <span>{fixture.mark}</span>
                <div><strong>{fixture.title}</strong><small>{fixture.time}</small><p>{fixture.entertainment}</p></div>
              </li>
            ))
          }
        </ol>
        <p class="games__ban">
          No unsafe speed · no public storm stunt · no mystery anchors · no climbing · no surf-edge construction ·
          no uninspected occupation · no abandoned kit
        </p>
      </section>

      <section class="phases" aria-labelledby="phases-title">
        <div class="section-head">
          <div>
            <p class="section-label">The imagined first-season report</p>
            <h2 id="phases-title">What changes after the applause?</h2>
          </div>
          <p>
            These are editorial outcomes, not measured claims. Their purpose is to make feedback consequential:
            every problem becomes a visible revision rather than a hidden failure.
          </p>
        </div>
        <div class="phase-list">
          {
            HARDPOINT_OUTCOMES.map((outcome, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{outcome.title}</h3>
                <p>{outcome.copy}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <div>
          <p class="section-label">The honest edge</p>
          <h2 id="boundary-title">Imagine fully. Announce nothing.</h2>
          <p>
            The Hardpoint League is an unofficial PointCast field study. The images, teams, fixtures, scores,
            revisions, chassis, structures, and outcomes are invented to explore a design system. They are not
            engineering guidance, construction drawings, approvals, products, or an invitation to gather.
          </p>
        </div>
        <ul>
          {HARDPOINT_RULES.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <section class="sources" aria-labelledby="sources-title">
        <div class="section-head section-head--light">
          <div>
            <p class="section-label">Current source desk · checked July 29, 2026</p>
            <h2 id="sources-title">The coast reaches every connector.</h2>
          </div>
          <p>
            Sources establish material, corrosion, moisture, wind, and permission context. They do not endorse this
            project, approve a depicted detail, or verify a future site, design, operator, or event.
          </p>
        </div>
        <div class="source-grid">
          {
            HARDPOINT_SOURCES.map((source, index) => (
              <a href={source.url} target="_blank" rel="noreferrer">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{source.label}</strong>
                <p>{source.note}</p>
                <i>Open source ↗</i>
              </a>
            ))
          }
        </div>
      </section>

      <nav class="closing" aria-label="Beach Commons edition links">
        <a href="/beach-commons/v13"><span>Previous · V13</span><strong>The Fermentation League ←</strong></a>
        <a href="/beach-commons"><span>Complete series</span><strong>All fourteen editions ↗</strong></a>
        <a href="/beach-commons/v14.json"><span>Machine edition</span><strong>Open V14 JSON ↗</strong></a>
      </nav>
    </main>

    <footer>
      <span>Michael Hoydich + Codex / OpenAI · PointCast · 2026</span>
      <span>Field Study 014 · The Hardpoint League</span>
    </footer>

    <dialog class="viewer" id="plate-viewer" aria-label="Hardpoint League full image viewer">
      <div class="viewer__bar">
        <p id="viewer-title">Hardpoint League plate</p>
        <button type="button" id="viewer-close" aria-label="Close full image">Close ×</button>
      </div>
      <div class="viewer__image"><img id="viewer-image" alt="" /></div>
      <div class="viewer__controls">
        <button type="button" id="viewer-prev">← Previous</button>
        <span id="viewer-count">1 / 8</span>
        <button type="button" id="viewer-next">Next →</button>
      </div>
    </dialog>

    <script define:vars={{ teams: HARDPOINT_HOUSES, fixtures: HARDPOINT_FIXTURES }}>
      const teamButtons = [...document.querySelectorAll('[data-team]')];
      const fixtureButtons = [...document.querySelectorAll('[data-fixture]')];
      const fields = {
        team: document.querySelector('#draft-team'),
        material: document.querySelector('#draft-material'),
        room: document.querySelector('#draft-room'),
        fixture: document.querySelector('#draft-fixture'),
        result: document.querySelector('#draft-result'),
        argument: document.querySelector('#draft-argument'),
        commentary: document.querySelector('#draft-commentary'),
      };
      const status = document.querySelector('#draft-status');
      let activeTeam = teams[0];
      let activeFixture = fixtures[0];

      const renderBoard = () => {
        if (fields.team) fields.team.textContent = activeTeam.title;
        if (fields.material) fields.material.textContent = activeTeam.material;
        if (fields.room) fields.room.textContent = activeTeam.room;
        if (fields.fixture) fields.fixture.textContent = activeFixture.title;
        if (fields.result) fields.result.textContent = activeTeam.result;
        if (fields.argument) fields.argument.textContent = `${activeTeam.strength} Revision: ${activeTeam.revision}`;
        if (fields.commentary) {
          fields.commentary.textContent = `${activeFixture.entertainment} ${activeFixture.proof}`;
        }
      };

      const selectTeam = (id) => {
        activeTeam = teams.find((team) => team.id === id) || teams[0];
        teamButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.team === activeTeam.id)));
        renderBoard();
        if (status) status.textContent = `${activeTeam.title} selected locally. Nothing was stored or sent.`;
      };

      const selectFixture = (id) => {
        activeFixture = fixtures.find((fixture) => fixture.id === id) || fixtures[0];
        fixtureButtons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.fixture === activeFixture.id)),
        );
        renderBoard();
        if (status) status.textContent = `${activeFixture.title} selected locally. Nothing was stored or sent.`;
      };

      teamButtons.forEach((button) => button.addEventListener('click', () => selectTeam(button.dataset.team)));
      fixtureButtons.forEach((button) =>
        button.addEventListener('click', () => selectFixture(button.dataset.fixture)),
      );
      document.querySelector('#reset-draft')?.addEventListener('click', () => {
        activeTeam = teams[0];
        activeFixture = fixtures[0];
        teamButtons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.team === activeTeam.id)),
        );
        fixtureButtons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.fixture === activeFixture.id)),
        );
        renderBoard();
        if (status) status.textContent = 'Fixture Board reset. Nothing was stored or sent.';
      });
      document.querySelector('#copy-draft')?.addEventListener('click', async () => {
        const receipt = [
          'THE HARDPOINT LEAGUE / FICTIONAL FIXTURE',
          `HOUSE: ${activeTeam.title}`,
          `MATERIAL: ${activeTeam.material}`,
          `ROOM: ${activeTeam.room}`,
          `FIXTURE: ${activeFixture.title}`,
          `RESULT: ${activeTeam.result}`,
          `REVISION: ${activeTeam.revision}`,
          '',
          'Editorial simulation only. Not engineering guidance, a registration, structure, product, permit, or event.',
          'https://pointcast.xyz/beach-commons/v14',
        ].join('\n');
        try {
          await navigator.clipboard.writeText(receipt);
          if (status) status.textContent = 'Fixture card copied.';
        } catch {
          if (status) status.textContent = 'Copy was unavailable; the slate remains visible above.';
        }
      });

      const viewer = document.querySelector('#plate-viewer');
      const viewerImage = document.querySelector('#viewer-image');
      const viewerTitle = document.querySelector('#viewer-title');
      const viewerCount = document.querySelector('#viewer-count');
      const plateButtons = [...document.querySelectorAll('[data-plate-index]')];
      let currentPlate = 0;
      let lastOpener = null;

      const showPlate = (index) => {
        currentPlate = (index + plateButtons.length) % plateButtons.length;
        const button = plateButtons[currentPlate];
        if (viewerImage) {
          viewerImage.src = button.dataset.src || '';
          viewerImage.alt = button.dataset.alt || '';
        }
        if (viewerTitle) viewerTitle.textContent = button.dataset.title || 'Hardpoint League plate';
        if (viewerCount) viewerCount.textContent = `${currentPlate + 1} / ${plateButtons.length}`;
      };

      plateButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          lastOpener = button;
          showPlate(index);
          viewer?.showModal();
        });
      });
      document.querySelector('#viewer-close')?.addEventListener('click', () => viewer?.close());
      document.querySelector('#viewer-prev')?.addEventListener('click', () => showPlate(currentPlate - 1));
      document.querySelector('#viewer-next')?.addEventListener('click', () => showPlate(currentPlate + 1));
      viewer?.addEventListener('click', (event) => {
        if (event.target === viewer) viewer.close();
      });
      viewer?.addEventListener('close', () => lastOpener?.focus());
      viewer?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') showPlate(currentPlate - 1);
        if (event.key === 'ArrowRight') showPlate(currentPlate + 1);
      });
    </script>
  </body>
</html>

<style>
  :root {
    --ink: #102a37;
    --cream: #ece6d6;
    --paper: #f8f3e7;
    --gold: #d9d64b;
    --orange: #e2653b;
    --blue: #2859a8;
    --green: #73a899;
    --line: rgba(16, 42, 55, 0.22);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--cream);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--cream); }
  button, a { font: inherit; }
  img { display: block; width: 100%; }
  a { color: inherit; }
  .skip {
    position: fixed; top: 8px; left: 8px; z-index: 100;
    padding: 10px 14px; background: white; transform: translateY(-160%);
