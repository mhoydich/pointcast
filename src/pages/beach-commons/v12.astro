---
import {
  BEACH_COMMONS_V12,
  BOAT_FUTURES,
  HARBOR_PATHS,
  HARBOR_PLATES,
  HARBOR_RULES,
  HARBOR_SOURCES,
} from '../../lib/beach-commons-v12';

const pageTitle = `${BEACH_COMMONS_V12.title} — ${BEACH_COMMONS_V12.subtitle}`;
const description = BEACH_COMMONS_V12.dek;
const canonical = BEACH_COMMONS_V12.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0532.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102a39" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/beach-commons/v12.json" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #102a39;
        --paper: #f5f0e5;
        --white: #fffdf7;
        --orange: #f06635;
        --green: #1d725f;
        --blue: #1f5ab6;
        --red: #be473e;
        --steel: #b7c4c7;
        --line: rgba(16, 42, 57, 0.22);
        --mono: "SFMono-Regular", "Roboto Mono", "Courier New", monospace;
        --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --serif: Iowan Old Style, Baskerville, "Times New Roman", serif;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--ink); }
      body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); }
      a { color: inherit; }
      button, select { font: inherit; }
      img { display: block; width: 100%; }
      [hidden] { display: none !important; }
      .skip { position: fixed; left: 1rem; top: -8rem; z-index: 100; padding: .8rem 1rem; background: var(--white); }
      .skip:focus { top: 1rem; }

      .nav {
        position: sticky; top: 0; z-index: 30; min-height: 58px;
        display: flex; align-items: stretch; justify-content: space-between;
        color: var(--white); background: rgba(16, 42, 57, .96); border-bottom: 1px solid rgba(255,255,255,.2);
        backdrop-filter: blur(12px);
      }
      .brand { display: flex; align-items: center; padding: 0 1.2rem; text-decoration: none; font: 800 .76rem/1 var(--mono); letter-spacing: .16em; }
      .nav__links { display: flex; }
      .nav__links a { display: flex; align-items: center; padding: 0 1rem; border-left: 1px solid rgba(255,255,255,.2); text-decoration: none; font: 700 .66rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }

      .hero { position: relative; min-height: min(820px, 86vh); color: var(--white); overflow: hidden; background: var(--ink); }
      .hero img { position: absolute; inset: 0; height: 100%; object-fit: cover; opacity: .78; }
      .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(16,42,57,.94) 0%, rgba(16,42,57,.56) 54%, rgba(16,42,57,.12)), linear-gradient(0deg, rgba(16,42,57,.78), transparent 54%); }
      .hero__copy { position: relative; z-index: 2; display: flex; min-height: inherit; flex-direction: column; justify-content: flex-end; padding: clamp(2rem, 6vw, 6.5rem); max-width: 1160px; }
      .eyebrow { font: 800 .72rem/1.45 var(--mono); letter-spacing: .14em; text-transform: uppercase; }
      h1 { max-width: 960px; margin: .55rem 0 1.2rem; font-size: clamp(4.5rem, 13.5vw, 12.5rem); line-height: .73; letter-spacing: -.095em; text-transform: uppercase; }
      h1 span { color: var(--orange); }
      .hero__dek { max-width: 780px; margin: 0; font: 500 clamp(1.35rem, 2.8vw, 2.5rem)/1.08 var(--serif); }
      .hero__action { align-self: flex-start; margin-top: 1.7rem; padding: .95rem 1.15rem; color: var(--ink); background: var(--orange); text-decoration: none; font: 800 .7rem/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; }

      .principles { display: grid; grid-template-columns: repeat(6, 1fr); color: var(--white); background: var(--ink); border-top: 1px solid rgba(255,255,255,.2); }
      .principles span { min-height: 82px; display: grid; place-items: center; padding: 1rem; border-right: 1px solid rgba(255,255,255,.18); text-align: center; font: 700 .64rem/1.35 var(--mono); letter-spacing: .06em; text-transform: uppercase; }

      .thesis { display: grid; grid-template-columns: 1.15fr .85fr; border-bottom: 1px solid var(--line); }
      .thesis > * { padding: clamp(2rem, 6vw, 6rem); }
      .thesis h2, .section-title { margin: 0; font: 500 clamp(3rem, 7vw, 7.3rem)/.86 var(--serif); letter-spacing: -.05em; }
      .thesis h2 em { color: var(--orange); font-weight: 500; }
      .thesis__copy { display: grid; align-content: center; gap: 1.2rem; background: var(--white); border-left: 1px solid var(--line); }
      .thesis__copy p { max-width: 620px; margin: 0; font-size: clamp(1.05rem, 1.6vw, 1.35rem); line-height: 1.52; }

      .reality { padding: clamp(2rem, 5vw, 5rem); color: var(--white); background: var(--green); }
      .reality__grid { display: grid; grid-template-columns: .55fr 1.45fr; gap: 2rem; align-items: start; max-width: 1320px; margin: auto; }
      .reality h2 { margin: 0; font: 800 clamp(2.7rem, 5vw, 5.5rem)/.88 var(--sans); letter-spacing: -.06em; text-transform: uppercase; }
      .reality p { margin: 0 0 1rem; font: 500 clamp(1.05rem, 1.65vw, 1.38rem)/1.45 var(--serif); }
      .reality strong { color: #ffcca9; }

      .plates { padding: clamp(2rem, 5vw, 5rem); }
      .section-head { display: grid; grid-template-columns: 1fr .8fr; gap: 2rem; align-items: end; margin-bottom: 2.3rem; }
      .section-head p { max-width: 640px; margin: 0; font-size: 1.05rem; line-height: 1.5; }
      .plate-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
      .plate { background: var(--white); }
      .plate__open { position: relative; width: 100%; padding: 0; border: 0; cursor: zoom-in; background: var(--ink); }
      .plate__open img { aspect-ratio: 3/2; object-fit: cover; transition: opacity .2s ease, transform .25s ease; }
      .plate__open:hover img { opacity: .86; transform: scale(1.008); }
      .plate__open span { position: absolute; right: 0; bottom: 0; padding: .7rem .8rem; color: var(--white); background: var(--ink); font: 700 .62rem/1 var(--mono); text-transform: uppercase; }
      .plate__body { padding: clamp(1.4rem, 3vw, 2.6rem); }
      .plate__meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--orange); font: 800 .64rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .plate h3 { margin: .65rem 0 .5rem; font: 750 clamp(1.8rem, 3.2vw, 3.25rem)/.92 var(--sans); letter-spacing: -.055em; }
      .plate__thesis { margin: 0 0 1.25rem; font: 600 1.08rem/1.35 var(--serif); }
      .plate dl { display: grid; grid-template-columns: 5.2rem 1fr; gap: .55rem 1rem; margin: 0; font-size: .92rem; line-height: 1.42; }
      .plate dt { font: 800 .62rem/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
      .plate dd { margin: 0; }

      .sorter { padding: clamp(2rem, 5vw, 5rem); color: var(--white); background: var(--ink); }
      .sorter__layout { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(2rem, 5vw, 5rem); max-width: 1420px; margin: auto; }
      .sorter .section-title { color: var(--white); }
      .sorter__intro p { max-width: 540px; font-size: 1.05rem; line-height: 1.55; }
      .sorter__intro small { display: block; margin-top: 1.3rem; color: var(--steel); line-height: 1.5; }
      .sorter__panel { padding: clamp(1.25rem, 3vw, 2.5rem); color: var(--ink); background: var(--paper); }
      .sorter__fields { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .field { display: grid; gap: .45rem; }
      .field label { font: 800 .63rem/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
      .field select { width: 100%; min-height: 48px; padding: .7rem; border: 1px solid var(--line); border-radius: 0; color: var(--ink); background: var(--white); }
      .sorter__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
      .sorter button { min-height: 46px; padding: .8rem 1rem; border: 1px solid var(--ink); cursor: pointer; font: 800 .66rem/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; }
      .sorter__run { color: var(--white); background: var(--orange); }
      .sorter__copy { color: var(--ink); background: transparent; }
      .result { margin-top: 1rem; padding: 1.3rem; border: 2px solid var(--ink); background: var(--white); }
      .result__gate { margin: 0 0 .55rem; color: var(--orange); font: 800 .67rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .result h3 { margin: 0; font: 800 clamp(2rem, 4vw, 4.5rem)/.9 var(--sans); letter-spacing: -.06em; text-transform: uppercase; }
      .result p { margin: .8rem 0 0; line-height: 1.5; }
      .future-strip { display: grid; grid-template-columns: repeat(5, 1fr); max-width: 1420px; margin: 2rem auto 0; border: 1px solid rgba(255,255,255,.24); }
      .future { min-height: 135px; padding: 1rem; border-right: 1px solid rgba(255,255,255,.24); }
      .future:last-child { border: 0; }
      .future b { display: block; color: var(--orange); font: 800 .65rem/1 var(--mono); }
      .future span { display: block; margin-top: 1rem; font-weight: 750; line-height: 1.05; }

      .paths { padding: clamp(2rem, 5vw, 5rem); }
      .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 2rem; background: var(--line); border: 1px solid var(--line); }
      .path { min-height: 310px; padding: clamp(1.5rem, 3vw, 3rem); background: var(--white); }
      .path__scale { color: var(--orange); font: 800 .63rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
      .path h3 { margin: 1rem 0; font-size: clamp(1.6rem, 2.4vw, 2.65rem); line-height: .98; letter-spacing: -.04em; }
      .path p { line-height: 1.55; }

      .rules { display: grid; grid-template-columns: .65fr 1.35fr; color: var(--white); background: var(--red); }
      .rules h2 { margin: 0; padding: clamp(2rem, 5vw, 5rem); font: 800 clamp(3rem, 6vw, 6.5rem)/.85 var(--sans); letter-spacing: -.07em; text-transform: uppercase; }
      .rules ol { margin: 0; padding: 0; list-style: none; border-left: 1px solid rgba(255,255,255,.28); }
      .rules li { display: grid; grid-template-columns: 3.3rem 1fr; gap: 1rem; padding: 1.35rem 1.6rem; border-bottom: 1px solid rgba(255,255,255,.25); line-height: 1.45; }
      .rules li span { font: 800 .65rem/1 var(--mono); }

      .sources { padding: clamp(2rem, 5vw, 5rem); background: var(--white); }
      .source-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-top: 2rem; background: var(--line); border: 1px solid var(--line); }
      .source { display: block; min-height: 160px; padding: 1.35rem; background: var(--paper); text-decoration: none; }
      .source:hover { background: #eee4d3; }
      .source strong { display: block; margin-bottom: .6rem; }
      .source span { font-size: .88rem; line-height: 1.45; }
      .sources__note { max-width: 920px; margin: 2rem 0 0; padding: 1.2rem; border-left: 8px solid var(--orange); line-height: 1.5; }

      .edition-nav { display: flex; justify-content: space-between; gap: 1rem; padding: 1.4rem; color: var(--white); background: var(--ink); }
      .edition-nav a { font: 700 .7rem/1.3 var(--mono); text-transform: uppercase; }
      footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 1.4rem; color: var(--white); background: #081b25; font: 700 .64rem/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
      footer nav { display: flex; gap: 1rem; }

      dialog { width: min(94vw, 1500px); max-width: none; padding: 0; border: 1px solid rgba(255,255,255,.3); color: var(--white); background: var(--ink); }
      dialog::backdrop { background: rgba(4,15,21,.9); backdrop-filter: blur(8px); }
      .viewer__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1rem; }
      .viewer__bar p { margin: 0; font: 700 .7rem/1 var(--mono); text-transform: uppercase; }
      .viewer__bar button { color: var(--white); border: 1px solid rgba(255,255,255,.4); background: transparent; padding: .65rem .8rem; cursor: pointer; }
      .viewer img { max-height: calc(100vh - 110px); object-fit: contain; background: #06131b; }

      @media (max-width: 850px) {
        .nav__links a:not(:last-child) { display: none; }
        .hero { min-height: 720px; }
        .hero__copy { padding: 2.2rem 1.3rem; }
        h1 { font-size: clamp(4.1rem, 23vw, 7.5rem); }
        .principles { grid-template-columns: repeat(2, 1fr); }
        .thesis, .reality__grid, .section-head, .sorter__layout, .rules { grid-template-columns: 1fr; }
        .thesis__copy, .rules ol { border-left: 0; border-top: 1px solid var(--line); }
        .plate-grid, .path-grid, .source-grid { grid-template-columns: 1fr; }
        .sorter__fields { grid-template-columns: 1fr; }
        .future-strip { grid-template-columns: 1fr; }
        .future { min-height: 78px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.24); }
        .future span { margin-top: .55rem; }
        .edition-nav { flex-direction: column; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .plate__open img { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to Harbor Works</a>
    <nav class="nav" aria-label="Harbor Works navigation">
      <a class="brand" href="/">POINTCAST</a>
      <div class="nav__links">
        <a href="#plates">Eight rooms</a>
        <a href="#sorter">Boat sorter</a>
        <a href="#paths">Three paths</a>
        <a href="/beach-commons/v12.json">JSON ↗</a>
      </div>
    </nav>

    <main id="main">
      <header class="hero" aria-labelledby="title">
        <img src={HARBOR_PLATES[0].image} alt={HARBOR_PLATES[0].alt} width="1536" height="1024" />
        <div class="hero__copy">
          <div class="eyebrow">PointCast Field Study 012 · unofficial concept · Marina del Rey</div>
          <h1 id="title">Harbor<br /><span>Works</span></h1>
          <p class="hero__dek">{BEACH_COMMONS_V12.dek}</p>
          <a class="hero__action" href="#sorter">Sort one imagined boat ↓</a>
        </div>
      </header>

      <div class="principles" aria-label="Harbor Works principles">
        <span>Ownership before reuse</span>
        <span>Repair before replacement</span>
        <span>Work happens on land</span>
        <span>No discharge</span>
        <span>Public access stays open</span>
        <span>Utility earns contentment</span>
      </div>

      <section class="thesis" aria-labelledby="thesis-title">
        <div>
          <div class="eyebrow">The proposition</div>
          <h2 id="thesis-title">A marina is not parking. <em>It is metabolism.</em></h2>
        </div>
        <div class="thesis__copy">
          <p>Boats arrive as transportation, craft, memory, work, sport, liability, material, and sometimes trouble. A useful harbor has a dignified path for every one of those states.</p>
          <p><strong>Harbor Works</strong> puts triage, repair, training, clean-water utility, public launch, industrial archaeology, electronics, art, and slow public life into one working civic imagination.</p>
          <p>The goal is not to decorate neglect. It is to make maintenance visible enough that people want to participate in it.</p>
        </div>
      </section>

      <section class="reality" aria-labelledby="reality-title">
        <div class="reality__grid">
          <h2 id="reality-title">Provocation ≠ condition report</h2>
          <div>
            <p>The originating post describes Marina del Rey as languishing and points to undeveloped land, a fire-damaged yacht-club building, and abandoned boats. <strong>This edition treats that as a creative prompt, not a verified inventory.</strong></p>
            <p>LA County’s current pages describe active capital work and more than 4,600 slips across 23 marinas. County material also confirms the former California Yacht Club clubhouse was seriously damaged by a December 2023 fire and describes a later licensing path for the adjacent former Tony P’s site.</p>
            <p>So the useful question is not “what can we take over?” It is: <em>what public, industrial, environmental, and cultural systems should a modern working harbor make easier?</em></p>
          </div>
        </div>
      </section>

      <section class="plates" id="plates" aria-labelledby="plates-title">
        <header class="section-head">
          <h2 class="section-title" id="plates-title">Eight useful harbor rooms.</h2>
          <p>Each image is a speculative architectural prototype. Together they form a vessel lifecycle: understand, repair, share, recover, keep the water clean, learn the signal, and sit down when the work is done.</p>
        </header>
        <div class="plate-grid">
          {HARBOR_PLATES.map((plate) => (
            <article class="plate">
              <button class="plate__open" type="button" data-image={plate.image} data-title={`${plate.number} · ${plate.title}`} aria-label={`Open full image: ${plate.title}`}>
                <img src={plate.image} alt={plate.alt} width="1536" height="1024" loading="lazy" />
                <span>Full plate ↗</span>
              </button>
              <div class="plate__body">
                <div class="plate__meta"><span>{plate.number}</span><span>{plate.kicker}</span></div>
                <h3>{plate.title}</h3>
                <p class="plate__thesis">{plate.thesis}</p>
                <dl>
                  <dt>Program</dt><dd>{plate.program}</dd>
                  <dt>Boundary</dt><dd>{plate.boundary}</dd>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="sorter" id="sorter" aria-labelledby="sorter-title">
        <div class="sorter__layout">
          <div class="sorter__intro">
            <div class="eyebrow">Local educational instrument</div>
            <h2 class="section-title" id="sorter-title">One boat. Five futures.</h2>
            <p>Set five imaginary conditions. The sorter applies the gates in order: ownership, hazards, structure, public usefulness, then inspectable components.</p>
            <p>The interesting result may be a hold. A boat does not become available just because someone calls it abandoned.</p>
            <small>This browser-local exercise is not a title search, marine survey, lien determination, appraisal, environmental test, disposal instruction, salvage authorization, or recommendation about a real vessel. It stores and sends nothing.</small>
          </div>
          <form class="sorter__panel" id="boat-sorter">
            <div class="sorter__fields">
              <div class="field">
                <label for="ownership">01 · Ownership + authority</label>
                <select id="ownership" name="ownership">
                  <option value="clear">Documented and authorized</option>
                  <option value="unknown">Unknown, disputed, or incomplete</option>
                </select>
              </div>
              <div class="field">
                <label for="hazards">02 · Hazard screen</label>
                <select id="hazards" name="hazards">
                  <option value="cleared">Professionally screened / controlled</option>
                  <option value="unknown">Unknown or not yet screened</option>
                </select>
              </div>
              <div class="field">
                <label for="structure">03 · Hull structure</label>
                <select id="structure" name="structure">
                  <option value="sound">Sound and supportable</option>
                  <option value="repairable">Repairable with a bounded plan</option>
                  <option value="failed">Failed or economically defeated</option>
                </select>
              </div>
              <div class="field">
                <label for="public-use">04 · Shared-fleet value</label>
                <select id="public-use" name="publicUse">
                  <option value="no">Private or specialized use</option>
                  <option value="yes">Strong public use + operating sponsor</option>
                </select>
              </div>
              <div class="field">
                <label for="parts">05 · Safe component value</label>
                <select id="parts" name="parts">
                  <option value="yes">Inspectable parts can re-enter service</option>
                  <option value="no">No defensible parts recovery</option>
                </select>
              </div>
            </div>
            <div class="sorter__actions">
              <button class="sorter__run" type="submit">Sort this boat →</button>
              <button class="sorter__copy" type="button" id="copy-result">Copy local receipt</button>
            </div>
            <div class="result" id="sort-result" aria-live="polite">
              <p class="result__gate" id="result-gate">Path 01 / cleared to assess</p>
              <h3 id="result-title">Keep Sailing</h3>
              <p id="result-copy">Documented ownership, cleared hazards, and sound structure point toward survey, a bounded repair list, and safe return-to-service review.</p>
              <p id="result-status">Choose conditions, then sort this imagined boat.</p>
            </div>
          </form>
        </div>
        <div class="future-strip" aria-label="Five vessel futures">
          {BOAT_FUTURES.map((future) => (
            <div class="future"><b>{future.mark}</b><span>{future.title}</span></div>
          ))}
        </div>
      </section>

      <section class="paths" id="paths" aria-labelledby="paths-title">
        <header class="section-head">
          <h2 class="section-title" id="paths-title">Three ways to make it real.</h2>
          <p>Start with existing lawful capacity. The first version can teach and exchange knowledge without acquiring one boat or pretending a new public yard already exists.</p>
        </header>
        <div class="path-grid">
          {HARBOR_PATHS.map((path) => (
            <article class="path">
              <div class="path__scale">{path.scale}</div>
              <h3>{path.title}</h3>
              <p>{path.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <h2 id="rules-title">The harbor says no.</h2>
        <ol>
          {HARBOR_RULES.map((rule, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><div>{rule}</div></li>
          ))}
        </ol>
      </section>

      <section class="sources" aria-labelledby="sources-title">
        <header class="section-head">
          <h2 class="section-title" id="sources-title">Current-source dock.</h2>
          <p>Official County and coastal-planning pages anchor the current operating context. The X post remains linked as the creative provocation that started the assignment.</p>
        </header>
        <div class="source-grid">
          {HARBOR_SOURCES.map((source) => (
            <a class="source" href={source.url} target="_blank" rel="noreferrer">
              <strong>{source.label} ↗</strong>
              <span>{source.note}</span>
            </a>
          ))}
        </div>
        <p class="sources__note"><strong>What is not claimed:</strong> PointCast has not verified a “massive abandoned boat epidemic,” counted abandoned vessels, identified available parcels or boats, inspected the fire-damaged building, obtained a lease, secured agency partners, designed an approved facility, or announced a public program. The visuals depict an imagined working marina, not present-day conditions.</p>
      </section>

      <nav class="edition-nav" aria-label="Beach Commons editions">
        <a href="/b/0532">Open Block 0532 ↗</a>
        <a href="/beach-commons/v11">Previous: The Reach Line ↗</a>
      </nav>
    </main>

    <footer>
      <span>PointCast · Field Study 012 · Harbor Works</span>
      <nav aria-label="Footer">
        <a href="/beach-commons">Beach Commons</a>
        <a href="/beach-commons/v12.json">JSON</a>
        <a href="/">Home</a>
      </nav>
    </footer>

    <dialog class="viewer" id="plate-viewer" aria-label="Harbor Works full image viewer">
      <div class="viewer__bar">
        <p id="viewer-title">Harbor Works plate</p>
        <button type="button" id="viewer-close" aria-label="Close full image">Close</button>
      </div>
      <img id="viewer-image" alt="" width="1536" height="1024" />
    </dialog>

    <script>
      const form = document.querySelector('#boat-sorter');
      const resultGate = document.querySelector('#result-gate');
      const resultTitle = document.querySelector('#result-title');
      const resultCopy = document.querySelector('#result-copy');
      const resultStatus = document.querySelector('#result-status');
      const copyButton = document.querySelector('#copy-result');
      let receipt = '';

      const writeResult = (gate, title, copy, conditions) => {
        if (!(resultGate instanceof HTMLElement) || !(resultTitle instanceof HTMLElement) || !(resultCopy instanceof HTMLElement) || !(resultStatus instanceof HTMLElement)) return;
        resultGate.textContent = gate;
        resultTitle.textContent = title;
        resultCopy.textContent = copy;
        resultStatus.textContent = conditions;
        receipt = `HARBOR WORKS / ONE BOAT, FIVE FUTURES\nResult: ${title}\nGate: ${gate}\nConditions: ${conditions}\nEducational browser-local rehearsal only. No real vessel assessed.`;
      };

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;
        const data = new FormData(form);
        const ownership = String(data.get('ownership'));
        const hazards = String(data.get('hazards'));
        const structure = String(data.get('structure'));
        const publicUse = String(data.get('publicUse'));
        const parts = String(data.get('parts'));
        const conditions = `ownership ${ownership}; hazards ${hazards}; structure ${structure}; shared-fleet ${publicUse}; parts ${parts}`;

        if (ownership !== 'clear') {
          writeResult('Hold 00 / authority gate', 'Resolve Ownership', 'Stop. Identify the owner, title, liens, permissions, responsible party, and lawful disposition path before inspection becomes intervention.', conditions);
          return;
        }
        if (hazards !== 'cleared') {
          writeResult('Hold 00 / hazard gate', 'Contain + Survey', 'Stop. Stabilize access and commission qualified fuel, fluid, battery, sewage, coating, dust, and material assessment before choosing a future.', conditions);
          return;
        }
        if (structure === 'sound' && publicUse === 'yes') {
          writeResult('Path 03 / public use', 'Donate to the Shared Fleet', 'A sound, supportable craft with lawful transfer and a real operating sponsor may become public access—after fleet standards, storage, maintenance, training, insurance, and scheduling are funded.', conditions);
          return;
        }
        if (structure === 'sound') {
          writeResult('Path 01 / keep operating', 'Keep Sailing', 'Documented ownership, cleared hazards, and sound structure point toward survey, a bounded repair list, operating budget, insurance, and return-to-service sign-off.', conditions);
          return;
        }
        if (structure === 'repairable') {
          writeResult('Path 02 / learning repair', 'Repair + Train', 'A qualified lead can turn a bounded repair into instruction—inside a contained hardstand bay, with a cost ceiling, stop rules, documented materials, and post-repair survey.', conditions);
          return;
        }
        if (parts === 'yes') {
          writeResult('Path 04 / component recovery', 'Harvest Safe Parts', 'The complete vessel is not viable, but inspected components may re-enter service through a licensed landside plan, provenance tags, component tests, contained work, and lawful waste streams.', conditions);
          return;
        }
        writeResult('Path 05 / final disposition', 'Licensed Dismantling', 'After title and hazards are resolved, qualified dismantling removes fluids and dangerous materials, documents recoverable streams, controls dust, and routes the remainder lawfully.', conditions);
      });

      copyButton?.addEventListener('click', async () => {
        if (!receipt) form?.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        try {
          await navigator.clipboard.writeText(receipt);
          if (resultStatus instanceof HTMLElement) resultStatus.textContent = 'Local educational receipt copied. No network submission.';
        } catch {
          if (resultStatus instanceof HTMLElement) resultStatus.textContent = 'Copy unavailable in this browser. The result remains visible and local.';
        }
      });

      const viewer = document.querySelector('#plate-viewer');
      const viewerImage = document.querySelector('#viewer-image');
      const viewerTitle = document.querySelector('#viewer-title');
      const viewerClose = document.querySelector('#viewer-close');
      let opener = null;

      document.querySelectorAll('.plate__open').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement) || !(viewer instanceof HTMLDialogElement) || !(viewerImage instanceof HTMLImageElement) || !(viewerTitle instanceof HTMLElement)) return;
          opener = button;
          viewerImage.src = button.dataset.image || '';
          viewerImage.alt = button.querySelector('img')?.getAttribute('alt') || '';
          viewerTitle.textContent = button.dataset.title || 'Harbor Works plate';
          viewer.showModal();
          viewerClose?.focus();
        });
      });

      const closeViewer = () => {
        if (!(viewer instanceof HTMLDialogElement)) return;
        viewer.close();
        if (opener instanceof HTMLElement) opener.focus();
      };
      viewerClose?.addEventListener('click', closeViewer);
      viewer?.addEventListener('click', (event) => {
        if (event.target === viewer) closeViewer();
      });
      viewer?.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeViewer();
      });
    </script>
  </body>
</html>
