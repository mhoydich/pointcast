    <script is:inline>
      const instrument = document.querySelector('[data-route-options]');
      if (instrument) {
        const routeOptions = JSON.parse(instrument.dataset.routeOptions || '{}');
        const motiveButtons = [...instrument.querySelectorAll('[data-motive]')];
        const durationButtons = [...instrument.querySelectorAll('[data-duration]')];
        const result = instrument.querySelector('.route-result');
        let motive = 'touch';
        let duration = '45';

        const renderRoute = () => {
          const route = routeOptions?.[motive]?.[duration];
          if (!route || !result) return;
          const stops = route.stops.map((stop) => `<li>${stop}</li>`).join('');
          result.innerHTML = `
            <span class="route-result__eyebrow">Your fair route · ${duration} minutes</span>
            <h3>${route.title}</h3>
            <ol>${stops}</ol>
            <p class="route-result__finish">${route.finish}</p>
          `;
        };

        motiveButtons.forEach((button) => {
          button.addEventListener('click', () => {
            motive = button.dataset.motive || 'touch';
            motiveButtons.forEach((candidate) => {
              candidate.setAttribute('aria-pressed', String(candidate === button));
            });
            renderRoute();
          });
        });

        durationButtons.forEach((button) => {
          button.addEventListener('click', () => {
            duration = button.dataset.duration || '45';
            durationButtons.forEach((candidate) => {
              candidate.setAttribute('aria-pressed', String(candidate === button));
            });
            renderRoute();
          });
        });
      }
    </script>
