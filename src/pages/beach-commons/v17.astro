---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

import {
  BEACH_COMMONS_V17,
  BOOTH_RECIPE,
  FAIR_AVENUES,
  FAIR_AWARDS,
  FAIR_DAY,
  FAIR_SCORE,
  FAIR_SOURCES,
  POPULARITY_ENGINE,
  PUBLIC_PROOF,
  ROUTE_MOTIVES,
  ROUTE_OPTIONS,
  VISUAL_PLATES,
} from '../../lib/beach-commons-v17';

const canonical = BEACH_COMMONS_V17.url;
const socialImage = 'https://pointcast.xyz/images/og/b/0546.png';
const boothCount = FAIR_AVENUES.reduce((sum, avenue) => sum + avenue.booths.length, 0);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: 'Ask the Beach — The Commons Science Fair',
  alternativeHeadline: BEACH_COMMONS_V17.dek,
  description:
    'A playable Beach Commons science fair with seven avenues, twelve public experiments, two layers of judging, a route builder, and one blue-hour results theater.',
  url: canonical,
  image: socialImage,
  datePublished: BEACH_COMMONS_V17.publishedAt,
  dateModified: BEACH_COMMONS_V17.publishedAt,
  creator: BEACH_COMMONS_V17.creators.map((creator) => ({
    '@type': creator.name.includes('Codex') ? 'Organization' : 'Person',
    name: creator.name,
  })),
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'Beach Commons',
    url: 'https://pointcast.xyz/beach-commons',
  },
  about: [
    { '@type': 'Thing', name: 'Public science fair design' },
    { '@type': 'Thing', name: 'Hands-on science exhibits' },
    { '@type': 'Place', name: 'El Segundo, California' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content="Ask the Beach is a playable Commons Science Fair: seven avenues, twelve public experiments, a fair-route builder, friendly awards, live evidence, and one unforgettable blue-hour finish."
    />
    <meta name="theme-color" content="#133862" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/beach-commons/v17.json" />
    <link rel="preload" as="image" href="/beach-commons/v17/assets/poster-01.png" fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="Ask the Beach — The Commons Science Fair" />
    <meta property="og:description" content={BEACH_COMMONS_V17.dek} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ask the Beach — Beach Commons V17" />
    <meta name="twitter:description" content={BEACH_COMMONS_V17.dek} />
    <meta name="twitter:image" content={socialImage} />
    <title>Ask the Beach — The Commons Science Fair · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <style>
      :root {
        color-scheme: light;
        --blue: #133862;
        --blue-deep: #08243f;
        --sky: #dceefa;
        --paper: #f7f1df;
        --paper-deep: #e9dfc9;
        --ink: #142d3f;
        --orange: #e9582c;
        --yellow: #f2bd38;
        --green: #62a375;
        --aqua: #4ea6b8;
        --rose: #be4c72;
        --white: #fffdf6;
        --line: rgba(20, 45, 63, 0.22);
        --gutter: clamp(18px, 4vw, 64px);
        --sans: "Inter Variable", Inter, "Helvetica Neue", Arial, sans-serif;
        --mono: "JetBrains Mono Variable", "SFMono-Regular", Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        scroll-behavior: smooth;
        background: var(--blue-deep);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        color: inherit;
        font: inherit;
      }

      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--yellow);
        outline-offset: 4px;
      }

      ::selection {
        background: var(--yellow);
        color: var(--blue-deep);
      }

      .skip {
        position: fixed;
        z-index: 200;
        top: 10px;
        left: 10px;
        padding: 12px 15px;
        background: var(--yellow);
        color: var(--blue-deep);
        font: 750 11px/1 var(--mono);
        text-decoration: none;
        text-transform: uppercase;
        transform: translateY(-180%);
      }

      .skip:focus {
        transform: translateY(0);
      }

      .nav {
        position: sticky;
        z-index: 100;
        top: 0;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        min-height: 56px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.24);
        padding: 0 var(--gutter);
        background: rgba(8, 36, 63, 0.94);
        color: var(--white);
        backdrop-filter: blur(16px);
      }

      .nav a {
        font: 650 11px/1 var(--mono);
        letter-spacing: 0.02em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .nav__brand {
        font-weight: 900 !important;
      }

      .nav__edition {
        justify-self: center;
        color: rgba(255, 253, 246, 0.72);
        font: 600 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .nav__links {
        display: flex;
        gap: 20px;
      }

      .hero {
        display: grid;
        min-height: calc(100svh - 56px);
        grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
        background: var(--blue);
        color: var(--white);
      }

      .hero__copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(48px, 8vw, 120px) var(--gutter) clamp(34px, 5vw, 72px);
      }

      .kicker,
      .section-kicker {
        margin: 0 0 18px;
        color: var(--yellow);
        font: 750 11px/1.35 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .hero h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(62px, 10vw, 150px);
        font-weight: 850;
        letter-spacing: -0.085em;
        line-height: 0.78;
      }

      .hero h1 span {
        display: block;
        color: var(--yellow);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.72em;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.055em;
        line-height: 1.08;
      }

      .hero__dek {
        max-width: 650px;
        margin: clamp(32px, 5vw, 72px) 0 0;
        font-size: clamp(24px, 3vw, 46px);
        font-weight: 600;
        letter-spacing: -0.045em;
        line-height: 1.02;
      }

      .hero__dek em {
        color: var(--yellow);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
      }

      .hero__facts {
        display: grid;
        margin-top: 44px;
        border-top: 1px solid rgba(255, 255, 255, 0.28);
        grid-template-columns: repeat(4, 1fr);
      }

      .hero__facts span {
        padding: 16px 10px 0 0;
        color: rgba(255, 253, 246, 0.72);
        font: 600 10px/1.3 var(--mono);
        text-transform: uppercase;
      }

      .hero__facts b {
        display: block;
        margin-bottom: 7px;
        color: var(--white);
        font-size: clamp(22px, 2.6vw, 36px);
        font-weight: 750;
      }

      .hero__visual {
        position: relative;
        min-height: 720px;
        overflow: hidden;
        background: #d6b47e;
      }

      .hero__visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero__stamp {
        position: absolute;
        top: 24px;
        right: 24px;
        display: grid;
        width: clamp(76px, 9vw, 126px);
        aspect-ratio: 1;
        place-items: center;
        border: 2px solid rgba(255, 255, 255, 0.8);
        border-radius: 50%;
        background: rgba(233, 88, 44, 0.94);
        box-shadow: 0 10px 30px rgba(8, 36, 63, 0.2);
        color: white;
        font: 800 clamp(28px, 4vw, 52px)/1 var(--mono);
        transform: rotate(7deg);
      }

      .hero__caption {
        position: absolute;
        right: 18px;
        bottom: 18px;
        left: 18px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 15px;
        background: rgba(8, 36, 63, 0.88);
        color: white;
        font: 600 10px/1.4 var(--mono);
        text-transform: uppercase;
      }

      .premise {
        display: grid;
        border-bottom: 1px solid var(--line);
        grid-template-columns: 0.72fr 1.28fr;
      }

      .premise__label {
        padding: clamp(46px, 7vw, 100px) var(--gutter);
        background: var(--orange);
        color: var(--white);
      }

      .premise__label strong {
        display: block;
        max-width: 420px;
        font-size: clamp(38px, 5.5vw, 78px);
        letter-spacing: -0.07em;
        line-height: 0.92;
      }

      .premise__copy {
        padding: clamp(48px, 8vw, 120px) var(--gutter);
      }

      .premise__copy p {
        max-width: 920px;
        margin: 0 0 24px;
        font-size: clamp(22px, 3vw, 40px);
        letter-spacing: -0.04em;
        line-height: 1.15;
      }

      .premise__copy p:last-child {
        margin-bottom: 0;
      }

      .premise__copy em {
        font-family: Georgia, "Times New Roman", serif;
      }

      .popularity {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
        background: var(--white);
      }

      .section-head {
        display: grid;
        align-items: end;
        margin-bottom: clamp(34px, 6vw, 78px);
        grid-template-columns: 1fr minmax(280px, 0.68fr);
        gap: 40px;
      }

      .section-head h2,
      .instrument h2,
      .score h2,
      .proof h2,
      .day h2 {
        max-width: 860px;
        margin: 0;
        font-size: clamp(46px, 7vw, 104px);
        font-weight: 820;
        letter-spacing: -0.075em;
        line-height: 0.88;
      }

      .section-head__copy {
        max-width: 600px;
        margin: 0;
        font-size: clamp(17px, 2vw, 25px);
        line-height: 1.42;
      }

      .reason-grid {
        display: grid;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
        grid-template-columns: repeat(4, 1fr);
      }

      .reason {
        min-height: 340px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        padding: 24px;
        background: var(--paper);
      }

      .reason:nth-child(2),
      .reason:nth-child(7) {
        background: var(--yellow);
      }

      .reason:nth-child(4),
      .reason:nth-child(5) {
        background: var(--sky);
      }

      .reason__number {
        font: 700 11px/1 var(--mono);
      }

      .reason h3 {
        margin: 70px 0 18px;
        font-size: clamp(24px, 2.4vw, 36px);
        letter-spacing: -0.045em;
        line-height: 0.98;
      }

      .reason p {
        margin: 0;
        font-size: 15px;
        line-height: 1.48;
      }

      .reason strong {
        display: block;
        margin-top: 24px;
        padding-top: 12px;
        border-top: 1px solid currentColor;
        font: 650 10px/1.4 var(--mono);
        text-transform: uppercase;
      }

      .double-plate {
        display: grid;
        background: var(--blue-deep);
        grid-template-columns: 1fr 1fr;
      }

      .plate {
        position: relative;
        margin: 0;
        overflow: hidden;
      }

      .plate + .plate {
        border-left: 1px solid rgba(255, 255, 255, 0.28);
      }

      .plate img {
        width: 100%;
        height: min(84vw, 1100px);
        object-fit: cover;
      }

      .plate figcaption {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        min-height: 70px;
        padding: 18px 22px;
        background: var(--blue-deep);
        color: var(--white);
        font: 550 11px/1.45 var(--mono);
      }

      .plate figcaption span {
        color: var(--yellow);
        text-transform: uppercase;
      }

      .recipe {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
        background: var(--yellow);
      }

      .recipe__intro {
        display: grid;
        margin-bottom: 48px;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }

      .recipe__intro h2 {
        max-width: 850px;
        margin: 0;
        font-size: clamp(48px, 7vw, 100px);
        letter-spacing: -0.075em;
        line-height: 0.88;
      }

      .recipe__intro p {
        align-self: end;
        max-width: 560px;
        margin: 0;
        font-size: clamp(18px, 2vw, 25px);
        line-height: 1.4;
      }

      .recipe__steps {
        display: grid;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
        grid-template-columns: repeat(5, 1fr);
      }

      .recipe__step {
        min-height: 290px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        padding: 20px;
      }

      .recipe__step span {
        font: 700 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .recipe__step h3 {
        margin: 54px 0 16px;
        font-size: 30px;
        letter-spacing: -0.045em;
      }

      .recipe__step p {
        margin: 0;
        line-height: 1.42;
      }

      .recipe__step small {
        display: block;
        margin-top: 20px;
        font: 600 10px/1.4 var(--mono);
      }

      .avenues {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
      }

      .avenue-list {
        border-top: 1px solid var(--ink);
      }

      .avenue {
        display: grid;
        border-bottom: 1px solid var(--ink);
        grid-template-columns: 0.54fr 1.46fr;
      }

      .avenue__head {
        padding: 26px 24px 30px 0;
      }

      .avenue__head span {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font: 700 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .avenue__head span::before {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--avenue-color);
        content: "";
      }

      .avenue__head h3 {
        margin: 76px 0 12px;
        font-size: clamp(34px, 4vw, 58px);
        letter-spacing: -0.06em;
        line-height: 0.94;
      }

      .avenue__head p {
        max-width: 430px;
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 20px;
        font-style: italic;
        line-height: 1.35;
      }

      .avenue__booths {
        display: grid;
        border-left: 1px solid var(--ink);
        grid-template-columns: repeat(3, 1fr);
      }

      .booth {
        min-height: 420px;
        border-right: 1px solid var(--line);
        padding: 25px 22px;
      }

      .booth:last-child {
        border-right: 0;
      }

      .booth h4 {
        margin: 0 0 44px;
        font-size: clamp(25px, 2.5vw, 38px);
        letter-spacing: -0.045em;
        line-height: 0.98;
      }

      .booth dl {
        margin: 0;
      }

      .booth dt {
        margin-top: 17px;
        color: #527084;
        font: 700 9px/1 var(--mono);
        text-transform: uppercase;
      }

      .booth dd {
        margin: 6px 0 0;
        font-size: 14px;
        line-height: 1.42;
      }

      .booth__use {
        margin-top: 24px;
        padding-top: 17px;
        border-top: 4px solid var(--avenue-color);
        font-weight: 650;
      }

      .instrument {
        padding: clamp(62px, 9vw, 124px) var(--gutter);
        background: var(--blue);
        color: var(--white);
      }

      .instrument__top {
        display: grid;
        align-items: end;
        margin-bottom: 55px;
        grid-template-columns: 1fr minmax(280px, 0.7fr);
        gap: 38px;
      }

      .instrument__top p {
        max-width: 620px;
        margin: 0;
        color: rgba(255, 253, 246, 0.75);
        font-size: clamp(17px, 2vw, 24px);
        line-height: 1.42;
      }

      .route-builder {
        display: grid;
        border: 1px solid rgba(255, 255, 255, 0.38);
        grid-template-columns: 0.92fr 0.42fr 1fr;
      }

      .route-column {
        padding: 28px;
        border-right: 1px solid rgba(255, 255, 255, 0.32);
      }

      .route-column:last-child {
        border-right: 0;
      }

      .route-column__label {
        display: block;
        margin-bottom: 22px;
        color: var(--yellow);
        font: 700 10px/1.3 var(--mono);
        text-transform: uppercase;
      }

      .route-options {
        display: grid;
        gap: 9px;
      }

      .route-options button {
        display: grid;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 0;
        padding: 13px 14px;
        background: transparent;
        cursor: pointer;
        text-align: left;
        transition: background 160ms ease, color 160ms ease, transform 160ms ease;
      }

      .route-options button:hover {
        transform: translateX(3px);
      }

      .route-options button[aria-pressed="true"] {
        border-color: var(--yellow);
        background: var(--yellow);
        color: var(--blue-deep);
      }

      .route-options button strong {
        font-size: 15px;
      }

      .route-options button small {
        margin-top: 3px;
        color: inherit;
        font-size: 11px;
        line-height: 1.35;
        opacity: 0.72;
      }

      .duration-options button {
        text-align: center;
      }

      .route-result {
        min-height: 470px;
        background: var(--white);
        color: var(--ink);
      }

      .route-result__eyebrow {
        color: var(--orange);
        font: 700 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .route-result h3 {
        margin: 34px 0 24px;
        font-size: clamp(34px, 4vw, 58px);
        letter-spacing: -0.055em;
        line-height: 0.92;
      }

      .route-result ol {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: route;
      }

      .route-result li {
        display: grid;
        border-top: 1px solid var(--line);
        padding: 10px 0;
        grid-template-columns: 36px 1fr;
        counter-increment: route;
        font-size: 15px;
      }

      .route-result li::before {
        color: var(--orange);
        content: counter(route, decimal-leading-zero);
        font: 700 10px/1.6 var(--mono);
      }

      .route-result__finish {
        margin: 24px 0 0;
        padding-top: 18px;
        border-top: 4px solid var(--yellow);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-style: italic;
        line-height: 1.42;
      }

      .route-note {
        margin: 22px 0 0;
        color: rgba(255, 253, 246, 0.63);
        font: 500 10px/1.5 var(--mono);
      }

      .feature-plate {
        display: grid;
        min-height: 780px;
        background: var(--paper-deep);
        grid-template-columns: 1.1fr 0.9fr;
      }

      .feature-plate img {
        width: 100%;
        height: 100%;
        max-height: 1000px;
        object-fit: cover;
      }

      .feature-plate__copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(42px, 7vw, 96px) var(--gutter);
      }

      .feature-plate__copy h2 {
        max-width: 650px;
        margin: 0;
        font-size: clamp(54px, 7vw, 104px);
        letter-spacing: -0.08em;
        line-height: 0.86;
      }

      .feature-plate__copy h2 em {
        display: block;
        color: var(--orange);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
      }

      .feature-plate__copy p {
        max-width: 530px;
        margin: 38px 0 0;
        font-size: clamp(19px, 2.2vw, 29px);
        line-height: 1.35;
      }

      .feature-plate__caption {
        padding-top: 20px;
        border-top: 1px solid var(--ink);
        font: 600 10px/1.4 var(--mono) !important;
        text-transform: uppercase;
      }

      .score {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
        background: var(--white);
      }

      .score__intro {
        display: grid;
        align-items: end;
        margin-bottom: 52px;
        grid-template-columns: 1fr 0.7fr;
        gap: 40px;
      }

      .score__intro p {
        max-width: 620px;
        margin: 0;
        font-size: clamp(17px, 2vw, 25px);
        line-height: 1.42;
      }

      .score-grid {
        display: grid;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
        grid-template-columns: repeat(5, 1fr);
      }

      .score-card {
        min-height: 270px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        padding: 22px;
      }

      .score-card strong {
        display: block;
        color: var(--orange);
        font: 750 clamp(36px, 4vw, 60px)/1 var(--mono);
      }

      .score-card h3 {
        margin: 50px 0 12px;
        font-size: 24px;
        letter-spacing: -0.04em;
      }

      .score-card p {
        margin: 0;
        font-size: 14px;
        line-height: 1.45;
      }

      .awards {
        display: grid;
        margin-top: 52px;
        border-top: 1px solid var(--ink);
        grid-template-columns: repeat(3, 1fr);
      }

      .award {
        min-height: 230px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--ink);
        padding: 24px 24px 30px 0;
      }

      .award:nth-child(3n + 2),
      .award:nth-child(3n + 3) {
        padding-left: 24px;
      }

      .award:nth-child(3n) {
        border-right: 0;
      }

      .award span {
        color: var(--orange);
        font: 650 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .award h3 {
        margin: 58px 0 10px;
        font-size: clamp(24px, 2.8vw, 40px);
        letter-spacing: -0.05em;
      }

      .award p {
        max-width: 390px;
        margin: 0;
        line-height: 1.44;
      }

      .day {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
        background: var(--orange);
        color: var(--white);
      }

      .day__top {
        display: grid;
        align-items: end;
        margin-bottom: 56px;
        grid-template-columns: 1fr 0.7fr;
        gap: 40px;
      }

      .day__top p {
        max-width: 550px;
        margin: 0;
        font-size: 21px;
        line-height: 1.4;
      }

      .day-list {
        border-top: 1px solid var(--white);
      }

      .day-stop {
        display: grid;
        border-bottom: 1px solid rgba(255, 255, 255, 0.58);
        padding: 18px 0 20px;
        grid-template-columns: 0.3fr 0.7fr 1fr;
        gap: 24px;
      }

      .day-stop time {
        color: var(--yellow);
        font: 700 13px/1.4 var(--mono);
        text-transform: uppercase;
      }

      .day-stop h3 {
        margin: 0;
        font-size: clamp(24px, 3vw, 42px);
        letter-spacing: -0.045em;
        line-height: 1;
      }

      .day-stop p {
        max-width: 620px;
        margin: 0;
        font-size: 16px;
        line-height: 1.45;
      }

      .gallery {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
        background: var(--blue-deep);
        color: var(--white);
      }

      .gallery__top {
        display: grid;
        align-items: end;
        margin-bottom: 50px;
        grid-template-columns: 1fr 0.6fr;
        gap: 40px;
      }

      .gallery__top h2 {
        margin: 0;
        font-size: clamp(54px, 8vw, 118px);
        letter-spacing: -0.08em;
        line-height: 0.84;
      }

      .gallery__top p {
        margin: 0;
        color: rgba(255, 253, 246, 0.7);
        font-size: 19px;
        line-height: 1.42;
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: rgba(255, 255, 255, 0.28);
      }

      .gallery-card {
        margin: 0;
        background: var(--blue-deep);
      }

      .gallery-card img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
      }

      .gallery-card figcaption {
        min-height: 150px;
        padding: 18px;
      }

      .gallery-card span {
        color: var(--yellow);
        font: 650 10px/1 var(--mono);
      }

      .gallery-card h3 {
        margin: 16px 0 8px;
        font-size: 21px;
        letter-spacing: -0.03em;
      }

      .gallery-card p {
        margin: 0;
        color: rgba(255, 253, 246, 0.65);
        font-size: 12px;
        line-height: 1.42;
      }

      .proof {
        display: grid;
        background: var(--yellow);
        grid-template-columns: 0.85fr 1.15fr;
      }

      .proof__copy {
        padding: clamp(64px, 9vw, 130px) var(--gutter);
      }

      .proof__copy p {
        max-width: 620px;
        margin: 30px 0 0;
        font-size: clamp(18px, 2vw, 26px);
        line-height: 1.4;
      }

      .proof__list {
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-left: 1px solid var(--ink);
        padding: clamp(50px, 8vw, 112px) var(--gutter);
        counter-reset: proof;
      }

      .proof__list li {
        display: grid;
        border-top: 1px solid var(--ink);
        padding: 13px 0;
        grid-template-columns: 48px 1fr;
        counter-increment: proof;
        font-size: clamp(16px, 1.8vw, 23px);
        list-style: none;
      }

      .proof__list li::before {
        color: var(--orange);
        content: counter(proof, decimal-leading-zero);
        font: 750 11px/2 var(--mono);
      }

      .boundary {
        display: grid;
        background: var(--paper-deep);
        grid-template-columns: 0.8fr 1.2fr;
      }

      .boundary__image {
        min-height: 760px;
      }

      .boundary__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .boundary__copy {
        padding: clamp(54px, 8vw, 110px) var(--gutter);
      }

      .boundary__copy h2 {
        max-width: 720px;
        margin: 0;
        font-size: clamp(48px, 7vw, 102px);
        letter-spacing: -0.08em;
        line-height: 0.86;
      }

      .boundary__copy > p {
        max-width: 700px;
        margin: 34px 0;
        font-size: clamp(18px, 2.1vw, 27px);
        line-height: 1.4;
      }

      .boundary__rules {
        display: grid;
        border-top: 1px solid var(--ink);
        grid-template-columns: 1fr 1fr;
      }

      .boundary__rules div {
        padding: 20px 20px 0 0;
      }

      .boundary__rules div + div {
        border-left: 1px solid var(--ink);
        padding-left: 20px;
      }

      .boundary__rules strong {
        font: 750 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .boundary__rules p {
        margin: 12px 0 0;
        font-size: 14px;
        line-height: 1.5;
      }

      .sources {
        padding: clamp(60px, 8vw, 110px) var(--gutter);
        background: var(--white);
      }

      .sources h2 {
        margin: 0 0 42px;
        font-size: clamp(42px, 6vw, 84px);
        letter-spacing: -0.065em;
        line-height: 0.9;
      }

      .source-list {
        display: grid;
        border-top: 1px solid var(--ink);
        grid-template-columns: repeat(3, 1fr);
      }

      .source {
        min-height: 240px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--ink);
        padding: 22px 24px 28px 0;
        text-decoration: none;
      }

      .source:nth-child(3n + 2),
      .source:nth-child(3n + 3) {
        padding-left: 24px;
      }

      .source:nth-child(3n) {
        border-right: 0;
      }

      .source span {
        color: var(--orange);
        font: 700 10px/1.3 var(--mono);
        text-transform: uppercase;
      }

      .source h3 {
        margin: 42px 0 12px;
        font-size: 21px;
        letter-spacing: -0.03em;
        line-height: 1.08;
      }

      .source p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
      }

      .source b {
        display: inline-block;
        margin-top: 18px;
        font: 650 10px/1 var(--mono);
        text-transform: uppercase;
      }

      .closing {
        display: grid;
        background: var(--blue-deep);
        color: var(--white);
        grid-template-columns: repeat(3, 1fr);
      }

      .closing a {
        min-height: 170px;
        border-right: 1px solid rgba(255, 255, 255, 0.28);
        padding: 30px var(--gutter);
        text-decoration: none;
      }

      .closing a:last-child {
        border-right: 0;
      }

      .closing span {
        color: var(--yellow);
        font: 650 10px/1.3 var(--mono);
        text-transform: uppercase;
      }

      .closing strong {
        display: block;
        margin-top: 50px;
        font-size: clamp(20px, 2.4vw, 34px);
        letter-spacing: -0.04em;
      }

      footer {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        padding: 24px var(--gutter);
        background: var(--blue-deep);
        color: rgba(255, 253, 246, 0.55);
        font: 550 10px/1.5 var(--mono);
      }

      footer nav {
        display: flex;
        gap: 18px;
      }

      @media (max-width: 1000px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .hero__visual {
          min-height: 80svh;
        }

        .reason-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .recipe__steps,
        .score-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .avenue {
          grid-template-columns: 1fr;
        }

        .avenue__head {
          padding-right: 0;
        }

        .avenue__head h3 {
          margin-top: 36px;
        }

        .avenue__booths {
          border-top: 1px solid var(--ink);
          border-left: 0;
        }

        .route-builder {
          grid-template-columns: 1fr 0.5fr;
        }

        .route-result {
          border-top: 1px solid rgba(255, 255, 255, 0.32);
          grid-column: 1 / -1;
        }

        .gallery-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .source-list {
          grid-template-columns: repeat(2, 1fr);
        }

        .source:nth-child(n) {
          border-right: 1px solid var(--line);
          padding: 22px 24px 28px 0;
        }

        .source:nth-child(2n) {
          border-right: 0;
          padding-left: 24px;
        }
      }

      @media (max-width: 720px) {
        .nav {
          grid-template-columns: 1fr auto;
        }

        .nav__edition,
        .nav__links a:not(:first-child) {
          display: none;
        }

        .hero {
          min-height: auto;
        }

        .hero__copy {
          min-height: 690px;
        }

        .hero__facts {
          grid-template-columns: repeat(2, 1fr);
        }

        .hero__visual {
          min-height: 72svh;
        }

        .premise,
        .section-head,
        .recipe__intro,
        .instrument__top,
        .score__intro,
        .day__top,
        .gallery__top,
        .feature-plate,
        .proof,
        .boundary {
          grid-template-columns: 1fr;
        }

        .reason-grid,
        .double-plate,
        .awards,
        .source-list,
        .closing {
          grid-template-columns: 1fr;
        }

        .plate + .plate {
          border-top: 1px solid rgba(255, 255, 255, 0.28);
          border-left: 0;
        }

        .plate img {
          height: auto;
        }

        .recipe__steps,
        .score-grid {
          grid-template-columns: 1fr;
        }

        .recipe__step,
        .score-card {
          min-height: 220px;
        }

        .avenue__booths {
          grid-template-columns: 1fr;
        }

        .booth {
          min-height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .route-builder {
          grid-template-columns: 1fr;
        }

        .route-column {
          border-right: 0;
          border-bottom: 1px solid rgba(255, 255, 255, 0.32);
        }

        .route-result {
          grid-column: auto;
        }

        .feature-plate img {
          max-height: none;
        }

        .award:nth-child(n),
        .source:nth-child(n) {
          border-right: 0;
          padding: 24px 0 30px;
        }

        .day-stop {
          grid-template-columns: 0.28fr 0.72fr;
        }

        .day-stop p {
          grid-column: 2;
        }

        .gallery-grid {
          grid-template-columns: 1fr;
        }

        .proof__list {
          border-top: 1px solid var(--ink);
          border-left: 0;
        }

        .boundary__image {
          min-height: 72svh;
        }

        .boundary__rules {
          grid-template-columns: 1fr;
        }

        .boundary__rules div + div {
          margin-top: 20px;
          border-top: 1px solid var(--ink);
          border-left: 0;
          padding-left: 0;
        }

        .closing a {
          min-height: 140px;
          border-right: 0;
          border-bottom: 1px solid rgba(255, 255, 255, 0.28);
        }

        footer {
          flex-direction: column;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .route-options button {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the fair</a>

    <nav class="nav" aria-label="Ask the Beach navigation">
      <a class="nav__brand" href="/">PointCast</a>
      <span class="nav__edition">Beach Commons · Field Study 017</span>
      <div class="nav__links">
        <a href="/beach-commons">Series</a>
        <a href="#route">Build a route</a>
        <a href="/beach-commons/v17.json">JSON ↗</a>
      </div>
    </nav>

    <main id="main">
      <header class="hero">
        <div class="hero__copy">
          <div>
            <p class="kicker">PointCast Field Study 017 · The popular experiment</p>
            <h1>Ask <span>the Beach</span></h1>
            <p class="hero__dek">Every booth <em>proves one thing</em> in public.</p>
          </div>
          <div class="hero__facts" aria-label="Commons Science Fair facts">
            <span><b>07</b> avenues</span>
            <span><b>{boothCount.toString().padStart(2, '0')}</b> experiments</span>
            <span><b>08</b> visual plates</span>
            <span><b>01</b> public proof</span>
          </div>
        </div>
        <div class="hero__visual">
          <img
            src="/beach-commons/v17/assets/poster-01.png"
            alt="An intergenerational science fair enters seven colorful avenues through a reversible curiosity gate beside the beach."
            width="1024"
            height="1536"
            fetchpriority="high"
          />
          <span class="hero__stamp" aria-hidden="true">17</span>
          <div class="hero__caption">
            <span>Plate 01 · The Curiosity Gate</span>
            <span>Imagined editorial rehearsal</span>
          </div>
        </div>
      </header>

      <section class="premise" aria-labelledby="premise-title">
        <div class="premise__label">
          <p class="section-kicker">The assignment</p>
          <strong id="premise-title">Make science the reason everyone stays.</strong>
        </div>
        <div class="premise__copy">
          <p>
            Most science fairs ask how to judge a project. This one begins one step earlier:
            <em>why would half the beach wander in, touch something, bring a friend, return at sunset, and talk about it tomorrow?</em>
          </p>
          <p>
            Popularity is not a marketing layer. It is a scientific design constraint. The phenomenon must be
            visible. The visitor must be useful. The result must change in public. The question must belong to the
            place. And the ending must be better than slowly packing a gymnasium.
          </p>
        </div>
      </section>

      <section class="popularity" aria-labelledby="popular-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">Eight reasons it catches</p>
            <h2 id="popular-title">Popularity, built into the apparatus.</h2>
          </div>
          <p class="section-head__copy">
            The fair does not assign shared roles. People choose why they came, how long they have, and what small
            move they want to contribute. Coordination appears from good invitations.
          </p>
        </div>
        <div class="reason-grid">
          {
            POPULARITY_ENGINE.map((reason) => (
              <article class="reason">
                <span class="reason__number">{reason.number}</span>
                <h3>{reason.title}</h3>
                <p>{reason.summary}</p>
                <strong>{reason.proof}</strong>
              </article>
            ))
          }
        </div>
      </section>

      <section class="double-plate" aria-label="Sun and wind visual plates">
        {
          VISUAL_PLATES.slice(1, 3).map((plate) => (
            <figure class="plate">
              <img src={plate.src} alt={plate.alt} width="1024" height="1536" loading="lazy" />
              <figcaption>
                <span>Plate {plate.id} · {plate.title}</span>
                <b>{plate.caption}</b>
              </figcaption>
            </figure>
          ))
        }
      </section>

      <section class="recipe" aria-labelledby="recipe-title">
        <div class="recipe__intro">
          <h2 id="recipe-title">The five-part booth.</h2>
          <p>
            A booth is not a poster plus a presenter. It is a tiny public instrument: one question, one visible
            effect, one visitor move, one accumulating measure, and one use worth carrying home.
          </p>
        </div>
        <div class="recipe__steps">
          {
            BOOTH_RECIPE.map((item, index) => (
              <article class="recipe__step">
                <span>{(index + 1).toString().padStart(2, '0')} / {item.step}</span>
                <h3>{item.step}</h3>
                <p>{item.instruction}</p>
                <small>For example: {item.example}</small>
              </article>
            ))
          }
        </div>
      </section>

      <section class="avenues" aria-labelledby="avenues-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">The field plan</p>
            <h2 id="avenues-title">Seven avenues. Twelve proofs.</h2>
          </div>
          <p class="section-head__copy">
            The experiments stay small enough to understand: low-energy, contained, supervised, reversible, and
            deliberately separate from the surf, dunes, habitat, and any claim of real coastal engineering.
          </p>
        </div>
        <div class="avenue-list">
          {
            FAIR_AVENUES.map((avenue) => (
              <article class="avenue" style={`--avenue-color:${avenue.color}`}>
                <header class="avenue__head">
                  <span>{avenue.number}</span>
                  <h3>{avenue.title}</h3>
                  <p>{avenue.question}</p>
                </header>
                <div class="avenue__booths">
                  {avenue.booths.map((booth) => (
                    <section class="booth">
                      <h4>{booth.title}</h4>
                      <dl>
                        <dt>Hook</dt>
                        <dd>{booth.hook}</dd>
                        <dt>Visitor move</dt>
                        <dd>{booth.move}</dd>
                        <dt>Public measure</dt>
                        <dd>{booth.measure}</dd>
                      </dl>
                      <p class="booth__use">{booth.takeaway}</p>
                    </section>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="instrument"
        id="route"
        aria-labelledby="route-title"
        data-route-options={JSON.stringify(ROUTE_OPTIONS)}
      >
        <div class="instrument__top">
          <div>
            <p class="section-kicker">Local instrument · No tracking</p>
            <h2 id="route-title">Why did you come?</h2>
          </div>
          <p>
            Pick a motive and the time you actually have. The fair returns a route. Nothing is stored, sent,
            registered, scored, or attached to an identity.
          </p>
        </div>
        <div class="route-builder">
          <div class="route-column">
            <span class="route-column__label">01 · Choose your motive</span>
            <div class="route-options" aria-label="Choose a reason for visiting">
              {
                ROUTE_MOTIVES.map((motive, index) => (
                  <button
                    type="button"
                    data-motive={motive.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <strong>{motive.title}</strong>
                    <small>{motive.note}</small>
                  </button>
                ))
              }
            </div>
          </div>
          <div class="route-column">
            <span class="route-column__label">02 · Choose your time</span>
            <div class="route-options duration-options" aria-label="Choose visit duration">
              <button type="button" data-duration="15" aria-pressed="false">
                <strong>15 min</strong>
                <small>Three quick stops</small>
              </button>
              <button type="button" data-duration="45" aria-pressed="true">
                <strong>45 min</strong>
                <small>One complete loop</small>
              </button>
              <button type="button" data-duration="120" aria-pressed="false">
                <strong>120 min</strong>
                <small>A real fair day</small>
              </button>
            </div>
          </div>
          <div class="route-column route-result" aria-live="polite">
            <span class="route-result__eyebrow">Your fair route · 45 minutes</span>
            <h3>The tactile loop</h3>
            <ol>
              <li>Curiosity Gate</li>
              <li>Shadow Atlas</li>
              <li>Tabletop Tide</li>
              <li>Cup Choir</li>
              <li>Pack-Down Physics</li>
            </ol>
            <p class="route-result__finish">
              Compare five different ways a small physical move becomes public evidence.
            </p>
          </div>
        </div>
        <p class="route-note">
          Browser-only route composer · no cookies · no storage · no analytics · no geolocation · no network writes.
        </p>
      </section>

      <section class="feature-plate" aria-labelledby="failure-title">
        <img
          src="/beach-commons/v17/assets/poster-05.png"
          alt="A mixed-age group examines a collapsed miniature structure beside contained material trays and a repair library."
          width="1024"
          height="1536"
          loading="lazy"
        />
        <div class="feature-plate__copy">
          <div>
            <p class="section-kicker">The most popular table</p>
            <h2 id="failure-title">Give the collapse <em>center stage.</em></h2>
            <p>
              A fair gets smarter the moment failure stops being a private embarrassment. Leave the broken model
              intact. Find the first visible failure. Separate evidence from explanation. Change one variable. If
              the next test is safe, run it in public.
            </p>
          </div>
          <p class="feature-plate__caption">Plate 05 · Best Failure is an award and a method.</p>
        </div>
      </section>

      <section class="score" aria-labelledby="score-title">
        <div class="score__intro">
          <div>
            <p class="section-kicker">Two layers of recognition</p>
            <h2 id="score-title">Rigor underneath. Delight everywhere.</h2>
          </div>
          <p>
            The serious score respects question, method, evidence, imagination, and public explanation. The public
            awards notice other forms of excellence without pretending applause is data.
          </p>
        </div>
        <div class="score-grid" aria-label="One hundred point project score">
          {
            FAIR_SCORE.map((item) => (
              <article class="score-card">
                <strong>{item.points}</strong>
                <h3>{item.label}</h3>
                <p>{item.test}</p>
              </article>
            ))
          }
        </div>
        <div class="awards" aria-label="Public science fair awards">
          {
            FAIR_AWARDS.map((award) => (
              <article class="award">
                <span>{award.icon}</span>
                <h3>{award.title}</h3>
                <p>{award.note}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="day" aria-labelledby="day-title">
        <div class="day__top">
          <div>
            <p class="section-kicker">One complete day</p>
            <h2 id="day-title">Open with wonder. End with proof.</h2>
          </div>
          <p>
            The shape of the day matters as much as the shape of a booth. Testing repeats. Methods travel. Results
            accumulate. The ending gathers everyone without requiring a stage or amplified sound.
          </p>
        </div>
        <div class="day-list">
          {
            FAIR_DAY.map((stop) => (
              <article class="day-stop">
                <time>{stop.time}</time>
                <h3>{stop.title}</h3>
