---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Almanac | PointCast";
const description =
  "A quiet El Segundo daily almanac: sun, moon, tides note, and one small truth about today.";
---

<BaseLayout title={title} description={description}>
  <main class="almanac-shell" data-almanac>
    <section class="masthead" aria-labelledby="almanac-title">
      <p class="kicker">PointCast daily almanac</p>
      <h1 id="almanac-title">The El Segundo Almanac</h1>
      <div class="date-rule" aria-live="polite">
        <p class="today-date" data-today-date>Loading today...</p>
        <p class="today-meta" data-today-meta>33.92°N, 118.42°W</p>
      </div>
    </section>

    <section class="intro-panel">
      <p>
        A small register of the day: light, moon, tide station, and one local
        note. No forecast. No urgency. Just the page turning over.
      </p>
    </section>

    <section class="almanac-grid">
      <article class="panel sun-panel" aria-labelledby="sun-title">
        <div class="panel-heading">
          <p class="section-mark">I</p>
          <div>
            <h2 id="sun-title">Sun</h2>
            <p>Pacific light over El Segundo</p>
          </div>
        </div>

        <div class="sun-figure" aria-hidden="true">
          <svg viewBox="0 0 420 230" role="img">
            <defs>
              <linearGradient id="sunArc" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0%" stop-color="#c96f3d" />
                <stop offset="50%" stop-color="#e2b85e" />
                <stop offset="100%" stop-color="#315f83" />
              </linearGradient>
            </defs>
            <path
              class="horizon-line"
              d="M 28 178 L 392 178"
              vector-effect="non-scaling-stroke"
            />
            <path
              class="arc-line"
              d="M 46 178 C 108 40, 312 40, 374 178"
              vector-effect="non-scaling-stroke"
            />
            <circle class="sun-dot" data-sun-dot cx="46" cy="178" r="13" />
            <line
              class="sun-drop"
              data-sun-drop
              x1="46"
              y1="178"
              x2="46"
              y2="178"
              vector-effect="non-scaling-stroke"
            />
            <text x="42" y="204" class="svg-label">rise</text>
            <text x="340" y="204" class="svg-label">set</text>
          </svg>
        </div>

        <dl class="measure-list">
          <div>
            <dt>Sunrise</dt>
            <dd data-sunrise>--</dd>
          </div>
          <div>
            <dt>Sunset</dt>
            <dd data-sunset>--</dd>
          </div>
          <div>
            <dt>Day length</dt>
            <dd data-day-length>--</dd>
          </div>
          <div>
            <dt>Solar note</dt>
            <dd data-sun-note>Calculating the day.</dd>
          </div>
        </dl>
      </article>

      <article class="panel moon-panel" aria-labelledby="moon-title">
        <div class="panel-heading">
          <p class="section-mark">II</p>
          <div>
            <h2 id="moon-title">Moon</h2>
            <p>Approximate lunar page</p>
          </div>
        </div>

        <div class="moon-stage">
          <svg class="moon-svg" viewBox="0 0 160 160" aria-hidden="true">
            <defs>
              <mask id="moonMask">
                <rect width="160" height="160" fill="black" />
                <circle cx="80" cy="80" r="58" fill="white" />
              </mask>
            </defs>
            <circle cx="80" cy="80" r="58" class="moon-base" />
            <path data-moon-shadow class="moon-shadow" d="" mask="url(#moonMask)" />
            <circle cx="80" cy="80" r="58" class="moon-ring" />
          </svg>

          <div>
            <p class="phase-name" data-moon-phase>--</p>
            <p class="phase-copy" data-moon-copy>
              The moon is being set into the margin.
            </p>
          </div>
        </div>

        <dl class="measure-list moon-measures">
          <div>
            <dt>Illumination</dt>
            <dd data-moon-illumination>--</dd>
          </div>
          <div>
            <dt>Moonrise</dt>
            <dd data-moonrise>approx. --</dd>
          </div>
          <div>
            <dt>Moonset</dt>
            <dd data-moonset>approx. --</dd>
          </div>
          <div>
            <dt>Method</dt>
            <dd>Meeus-style phase, simplified rise/set scan.</dd>
          </div>
        </dl>
      </article>

      <article class="panel tide-panel" aria-labelledby="tide-title">
        <div class="panel-heading">
          <p class="section-mark">III</p>
          <div>
            <h2 id="tide-title">Tide</h2>
            <p>Do not invent the water</p>
          </div>
        </div>

        <p class="tide-note">
          For official tide predictions, use NOAA station
          <strong>9410660</strong> — Los Angeles. This almanac does not fetch
          or fabricate tide heights.
        </p>
      </article>

      <article class="panel local-panel" aria-labelledby="local-title">
        <div class="panel-heading">
          <p class="section-mark">IV</p>
          <div>
            <h2 id="local-title">Today in El Segundo</h2>
            <p>A small date-keyed note</p>
          </div>
        </div>

        <p class="local-line" data-local-line>Loading the local margin note.</p>
      </article>
    </section>

    <section class="footer-note" aria-label="Editorial note">
      <p data-footer-line>
        The day does not need to become content to be worth noticing. This page
        keeps the ledger small on purpose.
      </p>
    </section>
  </main>

  <script>
    const LATITUDE = 33.9192;
    const LONGITUDE = -118.4165;
    const TZ = "America/Los_Angeles";
    const ZENITH = 90.833;
    const RAD = Math.PI / 180;
    const DEG = 180 / Math.PI;

    const $ = (selector) => document.querySelector(selector);

    function pad(number) {
      return String(number).padStart(2, "0");
    }

    function localParts(date) {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: TZ,
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        weekday: "long",
      }).formatToParts(date);

      const byType = Object.fromEntries(parts.map((part) => [part.type, part.value]));

      return {
        year: Number(byType.year),
        month: Number(byType.month),
        day: Number(byType.day),
        weekday: byType.weekday,
      };
    }

    function localDateKey(date) {
      const parts = localParts(date);
      return `${parts.year}-${pad(parts.month)}-${pad(parts.day)}`;
    }

    function dateFromLocalNoon(parts) {
      return new Date(Date.UTC(parts.year, parts.month - 1, parts.day, 20, 0, 0));
    }

    function dayOfYear(parts) {
      const start = Date.UTC(parts.year, 0, 1);
      const current = Date.UTC(parts.year, parts.month - 1, parts.day);
      return Math.floor((current - start) / 86400000) + 1;
    }

    function daysInYear(year) {
      return new Date(Date.UTC(year, 1, 29)).getUTCMonth() === 1 ? 366 : 365;
    }

    function formatDateLong(parts) {
      const date = new Date(Date.UTC(parts.year, parts.month - 1, parts.day, 12));
      return new Intl.DateTimeFormat("en-US", {
        timeZone: "UTC",
        month: "long",
        day: "numeric",
        year: "numeric",
      }).format(date);
    }

    function timezoneOffsetHours(date) {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: TZ,
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hourCycle: "h23",
      }).formatToParts(date);

      const byType = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      const asUTC = Date.UTC(
        Number(byType.year),
        Number(byType.month) - 1,
        Number(byType.day),
        Number(byType.hour),
        Number(byType.minute),
        Number(byType.second)
      );

      return (asUTC - date.getTime()) / 3600000;
    }

    function normalizeDegrees(value) {
      return ((value % 360) + 360) % 360;
    }

    function normalizeHours(value) {
      return ((value % 24) + 24) % 24;
    }

    function sinDeg(value) {
      return Math.sin(value * RAD);
    }

    function cosDeg(value) {
      return Math.cos(value * RAD);
    }

    function tanDeg(value) {
      return Math.tan(value * RAD);
    }

    function acosDeg(value) {
      return Math.acos(value) * DEG;
    }

    function atanDeg(value) {
      return Math.atan(value) * DEG;
    }

    function formatTime(date) {
      if (!date) return "--";
      return new Intl.DateTimeFormat("en-US", {
        timeZone: TZ,
        hour: "numeric",
        minute: "2-digit",
      }).format(date);
    }

    function formatDuration(ms) {
      const totalMinutes = Math.round(ms / 60000);
      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      return `${hours}h ${minutes}m`;
    }

    function noaaSunTime(parts, isRise) {
      const n = dayOfYear(parts);
      const lngHour = LONGITUDE / 15;
      const approximate = n + ((isRise ? 6 : 18) - lngHour) / 24;
      const meanAnomaly = 0.9856 * approximate - 3.289;

      let trueLongitude =
        meanAnomaly +
        1.916 * sinDeg(meanAnomaly) +
        0.02 * sinDeg(2 * meanAnomaly) +
        282.634;
      trueLongitude = normalizeDegrees(trueLongitude);

      let rightAscension = atanDeg(0.91764 * tanDeg(trueLongitude));
      rightAscension = normalizeDegrees(rightAscension);

      const longitudeQuadrant = Math.floor(trueLongitude / 90) * 90;
      const ascensionQuadrant = Math.floor(rightAscension / 90) * 90;
      rightAscension = (rightAscension + longitudeQuadrant - ascensionQuadrant) / 15;

      const sinDeclination = 0.39782 * sinDeg(trueLongitude);
      const cosDeclination = Math.cos(Math.asin(sinDeclination));

      const cosHour =
        (cosDeg(ZENITH) - sinDeclination * sinDeg(LATITUDE)) /
        (cosDeclination * cosDeg(LATITUDE));

      if (cosHour > 1 || cosHour < -1) return null;

      let hourAngle = isRise ? 360 - acosDeg(cosHour) : acosDeg(cosHour);
      hourAngle = hourAngle / 15;

      const localMeanTime =
        hourAngle + rightAscension - 0.06571 * approximate - 6.622;
      const utcTime = normalizeHours(localMeanTime - lngHour);
      const offset = timezoneOffsetHours(dateFromLocalNoon(parts));
      const localTime = normalizeHours(utcTime + offset);

      const hour = Math.floor(localTime);
      const minute = Math.round((localTime - hour) * 60);
      return new Date(parts.year, parts.month - 1, parts.day, hour, minute, 0);
    }

    function julianDate(date) {
      return date.getTime() / 86400000 + 2440587.5;
    }

    function moonAge(date) {
      const synodicMonth = 29.530588853;
      const knownNewMoon = 2451550.1;
      const age = (julianDate(date) - knownNewMoon) % synodicMonth;
      return age < 0 ? age + synodicMonth : age;
    }

    function moonPhase(date) {
      const age = moonAge(date);
      const synodicMonth = 29.530588853;
      const fraction = age / synodicMonth;
      const illumination = (1 - Math.cos(2 * Math.PI * fraction)) / 2;

      const phases = [
        { name: "New moon", max: 1.84566 },
        { name: "Waxing crescent", max: 5.53699 },
        { name: "First quarter", max: 9.22831 },
        { name: "Waxing gibbous", max: 12.91963 },
        { name: "Full moon", max: 16.61096 },
        { name: "Waning gibbous", max: 20.30228 },
        { name: "Last quarter", max: 23.99361 },
        { name: "Waning crescent", max: 27.68493 },
        { name: "New moon", max: synodicMonth },
      ];

      return {
        age,
        fraction,
        illumination,
        name: phases.find((phase) => age < phase.max).name,
      };
    }

    function moonCoordinates(date) {
      const d = julianDate(date) - 2451543.5;
      const n = normalizeDegrees(125.1228 - 0.0529538083 * d);
      const i = 5.1454;
      const w = normalizeDegrees(318.0634 + 0.1643573223 * d);
      const a = 60.2666;
      const e = 0.0549;
      const m = normalizeDegrees(115.3654 + 13.0649929509 * d);

      const eccentricAnomaly =
        m + e * DEG * sinDeg(m) * (1 + e * cosDeg(m));
      const xv = a * (cosDeg(eccentricAnomaly) - e);
      const yv = a * Math.sqrt(1 - e * e) * sinDeg(eccentricAnomaly);
      const v = atanDeg(yv / xv) + (xv < 0 ? 180 : 0);
      const r = Math.sqrt(xv * xv + yv * yv);

      const xh =
        r *
        (cosDeg(n) * cosDeg(v + w) -
          sinDeg(n) * sinDeg(v + w) * cosDeg(i));
      const yh =
        r *
        (sinDeg(n) * cosDeg(v + w) +
          cosDeg(n) * sinDeg(v + w) * cosDeg(i));
      const zh = r * sinDeg(v + w) * sinDeg(i);

      const longitude = atanDeg(yh / xh) + (xh < 0 ? 180 : 0);
      const latitude = atanDeg(zh / Math.sqrt(xh * xh + yh * yh));
      const obliquity = 23.4393 - 3.563e-7 * d;

      const xe = cosDeg(longitude) * cosDeg(latitude);
      const ye =
        sinDeg(longitude) * cosDeg(latitude) * cosDeg(obliquity) -
        sinDeg(latitude) * sinDeg(obliquity);
      const ze =
        sinDeg(longitude) * cosDeg(latitude) * sinDeg(obliquity) +
        sinDeg(latitude) * cosDeg(obliquity);

      const ra = normalizeDegrees(atanDeg(ye / xe) + (xe < 0 ? 180 : 0));
      const dec = atanDeg(ze / Math.sqrt(xe * xe + ye * ye));

      return { ra, dec };
    }

    function siderealTime(date) {
      const jd = julianDate(date);
      const t = (jd - 2451545.0) / 36525;
      const theta =
        280.46061837 +
        360.98564736629 * (jd - 2451545.0) +
        0.000387933 * t * t -
        (t * t * t) / 38710000;

      return normalizeDegrees(theta + LONGITUDE);
    }

    function moonAltitude(date) {
      const coords = moonCoordinates(date);
      const hourAngle = normalizeDegrees(siderealTime(date) - coords.ra);
      const adjustedHourAngle = hourAngle > 180 ? hourAngle - 360 : hourAngle;

      return (
        Math.asin(
          sinDeg(LATITUDE) * sinDeg(coords.dec) +
            cosDeg(LATITUDE) * cosDeg(coords.dec) * cosDeg(adjustedHourAngle)
        ) * DEG
      );
    }

    function refineCrossing(start, end, threshold) {
      let low = start.getTime();
      let high = end.getTime();

      for (let index = 0; index < 12; index += 1) {
        const middle = new Date((low + high) / 2);
        const lowAlt = moonAltitude(new Date(low)) - threshold;
        const midAlt = moonAltitude(middle) - threshold;

        if ((lowAlt <= 0 && midAlt > 0) || (lowAlt >= 0 && midAlt < 0)) {
          high = middle.getTime();
        } else {
          low = middle.getTime();
        }
      }

      return new Date((low + high) / 2);
    }

    function findMoonRiseSet(parts) {
      const start = new Date(parts.year, parts.month - 1, parts.day, 0, 0, 0);
      const end = new Date(parts.year, parts.month - 1, parts.day + 1, 0, 0, 0);
      const threshold = 0.125;
      const step = 20 * 60000;

      let previousTime = start;
      let previousAltitude = moonAltitude(previousTime) - threshold;
      let rise = null;
      let set = null;

      for (
        let time = new Date(start.getTime() + step);
        time <= end;
        time = new Date(time.getTime() + step)
      ) {
        const altitude = moonAltitude(time) - threshold;

        if (previousAltitude <= 0 && altitude > 0 && !rise) {
          rise = refineCrossing(previousTime, time, threshold);
        }

        if (previousAltitude >= 0 && altitude < 0 && !set) {
          set = refineCrossing(previousTime, time, threshold);
        }

        previousTime = time;
        previousAltitude = altitude;
      }

      return { rise, set };
    }

    function moonShadowPath(phase) {
      const waxing = phase.fraction < 0.5;
      const illum = phase.illumination;
      const width = Math.max(0.02, Math.abs(1 - illum * 2));
      const sweep = waxing ? 1 : 0;
      const oppositeSweep = waxing ? 0 : 1;
      const control = 58 * width;

      if (illum < 0.03) {
        return "M 22 80 A 58 58 0 1 0 138 80 A 58 58 0 1 0 22 80";
      }

      if (illum > 0.97) {
        return "";
      }

      if (illum < 0.5) {
        return `
          M 80 22
          A 58 58 0 1 ${sweep} 80 138
          C ${80 + (waxing ? control : -control)} 124,
            ${80 + (waxing ? control : -control)} 36,
            80 22
        `;
      }

      return `
        M 80 22
        A 58 58 0 1 ${oppositeSweep} 80 138
        C ${80 + (waxing ? -control : control)} 124,
          ${80 + (waxing ? -control : control)} 36,
          80 22
      `;
    }

    function hashDate(key) {
      let hash = 2166136261;
      for (const char of key) {
        hash ^= char.charCodeAt(0);
        hash +=
          (hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24);
      }
      return hash >>> 0;
    }

    function localLine(parts) {
      const key = `${pad(parts.month)}-${pad(parts.day)}`;
      const exact = {
        "09-18":
          "On this date in 1917, El Segundo incorporated as a city: a refinery town learning civic posture.",
        "01-18":
          "El Segundo keeps its oil-town origin story close: Standard Oil selected the site in 1911, before the city had the name it carries now.",
        "01-01":
          "A new civic ledger opens beside the same refinery stacks, beach fog, and airport approach paths.",
        "04-01":
          "ESMoA opened in 2013 as an art laboratory, a small cultural engine tucked into the city grid.",
        "07-04":
          "The holiday lands here with marine layer, backyard smoke, and the ocean doing its older work west of town.",
      };

      if (exact[key]) return exact[key];

      const notes = [
        "The refinery, the beach, and the airport all keep time differently; El Segundo lives in the overlap.",
        "Morning here often begins as a negotiation between marine layer and hard sun.",
        "The city is small enough to cross on foot and complicated enough to keep explaining itself.",
        "Grand Avenue still behaves like a main street when the light is right.",
        "The western edge of town is measured in dunes, chain link, and the slow blue argument of the Pacific.",
        "Aerospace buildings, Little League fields, and coffee counters share the same square miles.",
        "The Chevron stacks remain a blunt reminder that local history is industrial before it is picturesque.",
      ];

      return notes[hashDate(`${parts.year}-${key}`) % notes.length];
    }

    function footerLine(parts) {
      const lines = [
        "The almanac is a way to keep the day from becoming abstract. Look once, then go back outside.",
        "Nothing here asks to be optimized. The useful thing is the quiet measurement itself.",
        "A place becomes legible through repeated noticing: light, water, moon, pavement, errands.",
        "This is the opposite of a dashboard. It is a small page for letting the day have edges.",
      ];

      return lines[hashDate(`${parts.year}-${parts.month}-${parts.day}-footer`) % lines.length];
    }

    function updateSunArc(now, sunrise, sunset) {
      const dot = $("[data-sun-dot]");
      const drop = $("[data-sun-drop]");
      if (!dot || !drop || !sunrise || !sunset) return;

      const start = sunrise.getTime();
      const end = sunset.getTime();
      const current = now.getTime();
      const progress = Math.max(0, Math.min(1, (current - start) / (end - start)));

      const x = 46 + 328 * progress;
      const y = 178 - Math.sin(progress * Math.PI) * 105;

      dot.setAttribute("cx", x.toFixed(1));
      dot.setAttribute("cy", y.toFixed(1));
      drop.setAttribute("x1", x.toFixed(1));
      drop.setAttribute("x2", x.toFixed(1));
      drop.setAttribute("y1", y.toFixed(1));
      drop.setAttribute("y2", "178");
    }

    function setText(selector, value) {
      const node = $(selector);
      if (node) node.textContent = value;
    }

    function render() {
      const now = new Date();
      const parts = localParts(now);
      const key = localDateKey(now);
      const doy = dayOfYear(parts);
      const totalDays = daysInYear(parts.year);

      const sunrise = noaaSunTime(parts, true);
      const sunset = noaaSunTime(parts, false);
      const length = sunrise && sunset ? sunset.getTime() - sunrise.getTime() : null;
      const phase = moonPhase(dateFromLocalNoon(parts));
      const moonTimes = findMoonRiseSet(parts);

      setText("[data-today-date]", formatDateLong(parts));
      setText(
        "[data-today-meta]",
        `${parts.weekday} · Day ${doy} of ${parts.year} · ${totalDays - doy} days remain`
      );

      setText("[data-sunrise]", formatTime(sunrise));
      setText("[data-sunset]", formatTime(sunset));
      setText("[data-day-length]", length ? formatDuration(length) : "--");

      const solarNote =
        sunrise && sunset && now < sunrise
          ? "The sun is still below the eastern edge."
          : sunrise && sunset && now > sunset
            ? "The sun has left the working page."
            : "The sun is above the local horizon.";
      setText("[data-sun-note]", solarNote);

      setText("[data-moon-phase]", phase.name);
      setText("[data-moon-illumination]", `${Math.round(phase.illumination * 100)}%`);
      setText("[data-moonrise]", moonTimes.rise ? `approx. ${formatTime(moonTimes.rise)}` : "not in this local day");
      setText("[data-moonset]", moonTimes.set ? `approx. ${formatTime(moonTimes.set)}` : "not in this local day");

      const moonCopy =
        phase.name === "New moon"
          ? "Mostly hidden: the lunar page is turned inward."
          : phase.name === "Full moon"
            ? "A bright disc, useful for anyone walking home late."
            : phase.name.includes("Waxing")
              ? "Adding light, slowly, one evening at a time."
              : "Giving light back, slowly, toward the next dark.";
      setText("[data-moon-copy]", moonCopy);

      const shadow = $("[data-moon-shadow]");
      if (shadow) shadow.setAttribute("d", moonShadowPath(phase));

      setText("[data-local-line]", localLine(parts));
      setText("[data-footer-line]", footerLine(parts));

      updateSunArc(now, sunrise, sunset);
      document.documentElement.style.setProperty("--date-key", `"${key}"`);
    }

    render();
  </script>

  <style>
    :root {
      --paper: #f3ead8;
      --paper-deep: #e2d2b8;
      --ink: #24313a;
      --muted: #6f675c;
      --rule: rgba(65, 48, 33, 0.28);
      --ocean: #315f83;
      --ocean-dark: #172d46;
      --rust: #b45f3c;
      --gold: #d9aa4d;
      --cream: #fff8e9;
    }

    .almanac-shell {
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 20% 8%, rgba(217, 170, 77, 0.22), transparent 28rem),
        linear-gradient(180deg, #f8f0df 0%, var(--paper) 44%, #dfd0b8 100%);
      padding: clamp(1rem, 3vw, 2.5rem);
      font-family: Georgia, "Times New Roman", serif;
    }

    .masthead,
    .intro-panel,
    .almanac-grid,
    .footer-note {
      width: min(1080px, 100%);
      margin-inline: auto;
    }

    .masthead {
      border: 1px solid var(--rule);
      border-left: 0;
      border-right: 0;
      padding: clamp(1.2rem, 4vw, 2.4rem) 0;
      text-align: center;
    }

    .kicker {
      margin: 0 0 0.6rem;
      color: var(--rust);
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h1,
    h2,
