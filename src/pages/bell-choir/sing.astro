---
import SONGS from '../../data/bell-choir-songs.json';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Bell Choir · Songs to Come Back To · PointCast</title>
<meta name="description" content="Three uplifting original songs to sing with the Bell Choir. Follow the words, let the bells carry the melody, and find a little room for your voice." />
<link rel="canonical" href="https://pointcast.xyz/bell-choir/sing/" />
<meta property="og:title" content="Bell Choir · Songs to Come Back To" />
<meta property="og:description" content="A little chorus. A familiar room. Three original songs, and a place for your voice." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://pointcast.xyz/bell-choir/sing/" />
<meta property="og:image" content="https://pointcast.xyz/images/bell-choir/bloom-1a.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#f5f1e5" />
<style is:global>
:root{color-scheme:light;--paper:#f5f1e5;--ink:#1b342d;--blue:#304fc1;--line:#d5d3bf;--orange:#c25333}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}button,select,input{font:inherit}button,a,select,input{touch-action:manipulation}button{cursor:pointer}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--orange);outline-offset:5px}main{max-width:1180px;margin:auto;padding:28px 38px 60px}header{display:flex;justify-content:space-between;gap:15px;padding-bottom:20px;border-bottom:1px solid var(--line);font-size:11px;font-weight:700;letter-spacing:.13em}a{color:inherit}header a{text-decoration:none}.intro{display:flex;justify-content:space-between;align-items:end;gap:25px;margin:38px 0 28px}h1{font-size:clamp(42px,6vw,76px);letter-spacing:-.065em;line-height:.96;margin:10px 0 0;font-weight:700}h1 em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.06em;color:var(--blue)}.eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase}.intro p{max-width:270px;line-height:1.6;font-size:15px;margin:0}.songs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.song{border:1px solid var(--line);padding:12px;display:flex;text-align:left;align-items:center;gap:13px;background:transparent;color:var(--ink);border-radius:3px}.song img{width:66px;height:80px;object-fit:cover}.song strong{font-size:17px;display:block;line-height:1.2}.song small{display:block;margin-top:8px;font-size:11px;line-height:1.4}.song[aria-pressed=true]{background:#e7ecd9;border-color:#819375;box-shadow:inset 0 -3px #819375}.stage{display:grid;grid-template-columns:31% 1fr;gap:42px;padding:32px 0 28px;align-items:center}.portrait{position:relative;padding:18px 0}.portrait img{width:100%;aspect-ratio:1;object-fit:cover;transform:rotate(-3deg);border:7px solid #fffdf4;box-shadow:0 10px 30px #25372b13}.portrait:after{content:'A SMALL PLACE TO MAKE A SOUND';display:block;text-align:center;font-size:9px;letter-spacing:.13em;margin-top:20px}.karaoke{min-width:0}.song-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:23px}.song-head span{font-size:11px;letter-spacing:.06em}#status{color:var(--blue)}#lyrics{font-family:Georgia,serif;font-size:clamp(34px,4.5vw,57px);line-height:1.25;letter-spacing:-.045em;min-height:144px;display:flex;align-content:center;align-items:center;flex-wrap:wrap;gap:0 .24em}#lyrics span{transition:color .12s,background .12s;padding-bottom:3px}#lyrics .sung{color:#718572}#lyrics .current{color:var(--blue);box-shadow:0 3px var(--blue)}#next{font-family:Georgia,serif;color:#748277;font-size:22px;min-height:30px;margin:22px 0}progress{width:100%;height:4px;border:0;appearance:none;background:#dcdccc}progress::-webkit-progress-bar{background:#dcdccc}progress::-webkit-progress-value{background:var(--orange)}.transport{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-top:23px}.primary{background:var(--blue);color:#fffef7;border:0;border-radius:30px;padding:15px 27px;font-weight:700;min-width:142px}.secondary{background:transparent;border:1px solid #a8b09f;border-radius:30px;color:var(--ink);padding:13px 20px}.controls{display:flex;flex-wrap:wrap;gap:17px;margin:18px 0 0;font-size:12px;align-items:center}.controls label{display:flex;gap:8px;align-items:center}select{background:transparent;border:0;border-bottom:1px solid var(--line);padding:6px;color:var(--ink)}input[type=range]{width:70px;accent-color:var(--blue)}input[type=checkbox]{accent-color:var(--blue)}.wall{display:grid;grid-template-columns:repeat(12,1fr);gap:7px;padding:20px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.bell{height:60px;border:1px solid #b5bbaa;background:#e7eadc;color:var(--ink);font:12px Georgia,serif;border-radius:2px;transition:background .1s,transform .1s}.bell.hit{background:#ebbe69;transform:translateY(-4px)}footer{display:flex;gap:30px;justify-content:space-between;margin-top:22px;font-size:12px;line-height:1.6;color:#637563}footer p{max-width:520px;margin:0}details{margin-top:25px}summary{cursor:pointer;font-size:12px}#songbook{font-family:Georgia,serif;line-height:1.8;padding:14px 0}#note{font-size:12px;color:#677568;min-height:19px;margin-top:15px}@media(max-width:700px){main{padding:20px 18px 35px}.intro{display:block;margin-top:25px}.intro p{max-width:100%;margin-top:20px}.songs{grid-template-columns:1fr;gap:8px}.song{padding:8px}.song img{width:42px;height:43px}.song strong{font-size:15px}.song small{margin-top:3px}.stage{grid-template-columns:1fr;gap:0;padding-top:18px}.portrait{display:none}#lyrics{min-height:110px;font-size:42px}.song-head{margin-bottom:10px}#next{font-size:20px;margin:14px 0}.wall{grid-template-columns:repeat(6,1fr)}.bell{height:43px}footer{display:block}footer a{display:inline-block;margin-top:14px}header{font-size:9px}.intro h1{font-size:51px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}.bell.hit{transform:none}}
</style>
</head><body><main><header><a href="https://pointcast.xyz/bell-choir">POINTCAST / BELL CHOIR</a><span>THREE ORIGINAL SONGS · COME SING</span></header>
<section class="intro"><div><span class="eyebrow">Come as you are. Sing what you can.</span><h1>Songs to<br><em>come back to.</em></h1></div><p>A little chorus. A familiar room.<br>The bells will carry the tune.<br>You just bring your voice.</p></section>
<section class="songs" aria-label="Choose an original song" id="songs"></section>
<section class="stage" aria-label="Sing along"><div class="portrait"><img id="art" alt="Floral collage from Bell Choir"></div><div class="karaoke"><div class="song-head"><span id="songtitle"></span><span role="status" id="status">READY WHEN YOU ARE</span></div><div id="lyrics"></div><p id="next"></p><progress id="progress" value="0" max="1" aria-label="Song progress"></progress><div class="transport"><button class="primary" id="play">Sing with the bells</button><button class="secondary" id="stop" disabled>Stop</button><button class="secondary" id="restart">Start over</button></div><div class="controls"><label>Sound <select id="voice"><option value="chime">Warm chime</option><option value="glass">Clear glass</option><option value="bowl">Soft bowl</option></select></label><label>Pace <select id="pace"><option value="0.8">Gentle</option><option value="1" selected>Original</option><option value="1.15">Lively</option></select></label><label><input id="repeat" type="checkbox" checked> Sing it twice</label><label>Volume <input id="volume" type="range" min="0" max="1" step="0.05" value="0.6"></label></div><p id="note">Four beats to find your breath. No microphone needed.</p></div></section>
<section id="wall" class="wall" aria-label="Play your own bells"></section><footer><p>These songs are yours to sing here. No score, no perfect pitch, no recording. Try a hum first; the words will be waiting.</p><a href="https://pointcast.xyz/bell-choir">Visit the shared bell room ↗</a></footer><details><summary>Keep the words close</summary><div id="songbook"></div></details></main>
<script is:inline define:vars={{ SONGS }}>
const $=id=>document.getElementById(id); const frequencies=[261.63,293.66,329.63,392,440,523.25,587.33,659.25,783.99,880,1046.5,1174.66];const names=['C4','D4','E4','G4','A4','C5','D5','E5','G5','A5','C6','D6'];
let chosen=0,ac,master,sessionGain,active=false,generation=0,events=[],index=0,origin=0,end=0,clock,raf,oscillators=new Set(),lastLine=-1,lastCycle=-1,selectionVersion=0;
function audio(){if(!ac){ac=new AudioContext();master=ac.createGain();master.gain.value=+$('volume').value*.5;const comp=ac.createDynamicsCompressor();master.connect(comp).connect(ac.destination)}return ac}
function tone(note,at,gain=.75,duration=1.8,bus=master){const type=$('voice').value;const parts=type==='bowl'?[[1,.75,3.6],[2.4,.16,1.5]]:type==='glass'?[[1,.5,1.4],[3.01,.12,.55],[6.2,.035,.3]]:[[1,.6,2.2],[2.76,.15,1.1],[5.4,.06,.45]];parts.forEach(([ratio,level,tail])=>{const osc=ac.createOscillator(),g=ac.createGain();osc.frequency.value=frequencies[note]*ratio;g.gain.setValueAtTime(.00001,at);g.gain.exponentialRampToValueAtTime(Math.max(.00002,gain*level),at+.012);g.gain.exponentialRampToValueAtTime(.00001,at+tail);osc.connect(g).connect(bus);osc.start(at);osc.stop(at+tail+.04);oscillators.add(osc);osc.onended=()=>{oscillators.delete(osc);osc.disconnect();g.disconnect()}})}
function flash(note){const b=$('wall').children[note];b.classList.add('hit');setTimeout(()=>b.classList.remove('hit'),260)}
function clearPlayback(){generation++;active=false;clearInterval(clock);cancelAnimationFrame(raf);if(sessionGain&&ac){sessionGain.gain.cancelScheduledValues(ac.currentTime);sessionGain.gain.setTargetAtTime(0,ac.currentTime,.018);const old=sessionGain;setTimeout(()=>old.disconnect(),150)}for(const o of oscillators){try{o.stop()}catch{}}oscillators.clear();$('play').disabled=false;$('stop').disabled=true;$('pace').disabled=false;$('repeat').disabled=false;$('wall').querySelectorAll('.hit').forEach(e=>e.classList.remove('hit'))}
function select(i){clearPlayback();selectionVersion++;chosen=i;const s=SONGS[i];$('art').src=s.image;$('songtitle').textContent=s.title.toUpperCase();$('voice').value=s.voice;$('status').textContent='READY WHEN YOU ARE';$('note').textContent='Four beats to find your breath. No microphone needed.';$('progress').value=0;$('next').textContent=s.lines[1].words.join(' ');showLine(0,-1);$('songs').querySelectorAll('button').forEach((b,j)=>b.setAttribute('aria-pressed',String(i===j)));$('songbook').replaceChildren(...s.lines.map(l=>{const p=document.createElement('div');p.textContent=l.words.join(' ');return p}));history.replaceState(null,'','#'+s.id)}
function showLine(line,word){const l=SONGS[chosen].lines[line];$('lyrics').replaceChildren(...l.words.map((w,i)=>{const el=document.createElement('span');el.textContent=w;el.className=i<word?'sung':i===word?'current':'';return el}));$('next').textContent=SONGS[chosen].lines[line+1]?.words.join(' ')||'Let the last note find its way.'}
async function start(){clearPlayback();const token=generation,version=selectionVersion;try{await audio().resume()}catch{$('status').textContent='TAP AGAIN TO ENABLE SOUND';return}if(token!==generation||version!==selectionVersion)return;if(ac.state!=='running'){$('status').textContent='TAP AGAIN TO ENABLE SOUND';return}active=true;sessionGain=ac.createGain();sessionGain.connect(master);$('play').disabled=true;$('stop').disabled=false;$('pace').disabled=true;$('repeat').disabled=true;const s=SONGS[chosen],beat=60/(s.bpm*+$('pace').value),cycles=$('repeat').checked?2:1;events=[];origin=ac.currentTime+.12;let cursor=0;for(let n=0;n<4;n++){events.push({time:cursor,note:0,count:4-n,vol:.12});cursor+=beat}for(let cycle=0;cycle<cycles;cycle++){s.lines.forEach((l,line)=>{l.words.forEach((word,k)=>{events.push({time:cursor,note:l.notes[k],line,word:k,cycle,vol:.7});cursor+=l.beats[k]*beat})});if(cycle<cycles-1){events.push({time:cursor,breath:true});cursor+=2*beat}}end=cursor;index=0;lastLine=-1;lastCycle=-1;let displayed=-1;
function schedule(){if(!active)return;while(index<events.length&&origin+events[index].time<ac.currentTime+.14){const e=events[index++];if(e.note!==undefined)tone(e.note,Math.max(ac.currentTime,origin+e.time),e.vol,1.8,sessionGain)}}
function draw(){if(!active)return;const elapsed=ac.currentTime-origin;$('progress').value=Math.max(0,elapsed/end);let current=displayed;while(current+1<events.length&&events[current+1].time<=elapsed)current++;if(current!==displayed&&current>=0){displayed=current;const e=events[current];if(e.count){$('lyrics').textContent=e.count;$('next').textContent=s.lines[0].words.join(' ');$('status').textContent='BREATHE IN · HERE WE GO'}else if(e.breath){$('status').textContent='ONE MORE TIME';$('lyrics').textContent='Now you know the way.';$('next').textContent=s.lines[0].words.join(' ')}else{showLine(e.line,e.word);$('status').textContent=`${e.cycle+1} / ${cycles} · SING ALONG`;$('note').textContent=e.cycle===0?'Follow the blue word. A hum counts, too.':'A little more yours this time.'}if(e.note!==undefined)flash(e.note)}if(elapsed>=end){clearPlayback();$('progress').value=1;$('status').textContent='THANK YOU FOR YOUR VOICE';$('lyrics').textContent='There’s a place for you here.';$('next').textContent='Come back whenever you need a song.';$('note').textContent='Sing again, or pick another little chorus.';return}raf=requestAnimationFrame(draw)}schedule();clock=setInterval(schedule,25);raf=requestAnimationFrame(draw)}
SONGS.forEach((s,i)=>{const b=document.createElement('button');b.className='song';b.type='button';b.setAttribute('aria-pressed','false');const img=document.createElement('img');img.src=s.image;img.alt='';const label=document.createElement('span'),title=document.createElement('strong'),sub=document.createElement('small');title.textContent=s.title;sub.textContent=s.tag;label.append(title,sub);b.append(img,label);b.onclick=()=>select(i);$('songs').append(b)});
names.forEach((name,i)=>{const b=document.createElement('button');b.className='bell';b.textContent=name;b.setAttribute('aria-label','Ring '+name);b.onclick=async()=>{await audio().resume();tone(i,ac.currentTime,.6);flash(i)};$('wall').append(b)});
$('play').onclick=start;$('restart').onclick=start;$('stop').onclick=()=>{clearPlayback();$('status').textContent='REST A MOMENT';$('note').textContent='Start again whenever you’re ready.'};$('volume').oninput=()=>{if(master)master.gain.setTargetAtTime(+$('volume').value*.5,ac.currentTime,.025)};document.addEventListener('visibilitychange',()=>{if(document.hidden&&active){clearPlayback();$('status').textContent='PAUSED WHILE YOU WERE AWAY';$('note').textContent='Tap Sing with the bells to begin again.'}});window.addEventListener('pagehide',clearPlayback);select(Math.max(0,SONGS.findIndex(s=>s.id===location.hash.slice(1))));
</script></body></html>
