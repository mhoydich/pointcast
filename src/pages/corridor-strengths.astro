---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CITIES, CS_META, CS_NOTES, FEDERATION_SHAPE, REFERENCES } from '../lib/corridorStrengths';
const title = `${CS_META.title} — ${CS_META.subtitle}`;
const description = CS_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/corridor-strengths', name: CS_META.title, description, url: 'https://pointcast.xyz/corridor-strengths', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
const statusColor: Record<string, string> = { parent: '#2d6a3d', scaffolded: '#5b8aa8', candidate: '#d4a534', edge: '#a06478', neighbor: '#5a5450' };
const statusLabel: Record<string, string> = { parent: 'PARENT INSTANCE', scaffolded: 'SCAFFOLDED', candidate: 'CANDIDATE', edge: 'EDGE INSTANCE', neighbor: 'NEIGHBOR' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/corridor-strengths.json', title: 'Corridor Strengths (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/strand-corridor">strand-corridor</a><span aria-hidden="true">/</span><span>corridor-strengths</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{CS_META.paperNumber} · STRENGTHS OVERVIEW · {CITIES.length} CITIES</p>
      <h1>WHO / SHIPS / WHAT.</h1>
      <p class="subtitle">{CS_META.subtitle}</p>
      <p class="thesis">{CS_META.thesis}</p>
    </header>

    <section class="legend"><p class="kicker">LEGEND · STATUS</p>
      <ul class="lg-list">
        <li><span class="lg__dot" style="background:#2d6a3d;"></span><strong>PARENT</strong> — reference instance, all six shapes building or shipping</li>
        <li><span class="lg__dot" style="background:#5b8aa8;"></span><strong>SCAFFOLDED</strong> — fork instance with full scaffold; awaiting local Land</li>
        <li><span class="lg__dot" style="background:#d4a534;"></span><strong>CANDIDATE</strong> — natural next fork; scaffold pending</li>
        <li><span class="lg__dot" style="background:#a06478;"></span><strong>EDGE</strong> — adjacent geography; potential edge fork</li>
        <li><span class="lg__dot" style="background:#5a5450;"></span><strong>NEIGHBOR</strong> — adjacent but not yet candidate; satellite or contributor</li>
      </ul>
    </section>

    {CITIES.map((c, i) => (
      <article id={`city-${c.id}`} class={`city city--${c.status}`} style={`--st-color: ${statusColor[c.status]};`}>
        <p class="kicker">{String(i+1).padStart(2,'0')} · {statusLabel[c.status]} · {c.population} · {c.area}</p>
        <h2>{c.name}</h2>
        <p class="city__head">{c.strengthHeadline}</p>

        <h3 class="ch">Signature strengths · {c.signatureStrengths.length}</h3>
        <ol class="sg-list">{c.signatureStrengths.map((s) => (
          <li>
            <h4>{s.domain}</h4>
            <p>{s.detail}</p>
          </li>
        ))}</ol>

        <h3 class="ch">Civic muscle</h3>
        <ul class="cm-list">{c.civicMuscle.map((m) => (<li>{m}</li>))}</ul>

        <h3 class="ch">Asymmetric advantages</h3>
        <p class="cp">{c.asymmetricAdvantages}</p>

        <h3 class="ch">Best-suited shapes · {c.bestSuitedShapes.length}</h3>
        <ul class="bs-list">{c.bestSuitedShapes.map((s) => (<li>{s}</li>))}</ul>

        <h3 class="ch">Best-suited Giant Works · {c.bestSuitedGiantWorks.length}</h3>
        <ul class="bg-list">{c.bestSuitedGiantWorks.map((g) => (<li>{g}</li>))}</ul>

        <h3 class="ch">What this city ships</h3>
        <p class="cp ships">{c.whatThisCityShips}</p>

        <h3 class="ch">What this city should not host</h3>
        <p class="cp dont">{c.whatThisCityShouldNotHost}</p>
      </article>
    ))}

    <section class="fed"><p class="kicker">FEDERATION SHAPE · ~700K · ~90 SQ MI</p><h2>The realistic outer scope.</h2>
      <p class="lede">{FEDERATION_SHAPE.thesis}</p>
      <h3 class="fed-h">Why this scale matters</h3>
      <ol class="fed-list">{FEDERATION_SHAPE.whyThisScaleMatters.map((w) => (<li>{w}</li>))}</ol>
      <p class="fed-next"><strong>What comes next:</strong> {FEDERATION_SHAPE.whatComesNext}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · LOCAL CORRECTION</p>
      <p>{CS_NOTES.uesNote}</p>
      <p class="invite-cta">{CS_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/giant-works">Giant Works · Tier D</a>
      <a href="/forkable-radius">The Forkable Radius</a>
      <a href="/manhattan-beach">Manhattan Beach</a>
      <a href="/hermosa-beach">Hermosa Beach</a>
      <a href="/redondo-beach">Redondo Beach</a>
      <a href="/torrance">Torrance</a>
      <a href="/corridor-strengths.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --cs-ink:#1a1a1a; --cs-paper:#fdf9ee; --cs-mustard:#d4a534; --cs-rust:#b85a3a; --cs-sage:#2d6a3d; --cs-strand:#5b8aa8; --cs-mauve:#a06478; --cs-fog:#d8d2c4; --cs-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--cs-paper); color: var(--cs-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--cs-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--cs-sage); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cs-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--cs-sage); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0; }

  section, article { padding: 28px; border-top: 4px solid var(--cs-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 28px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }

  .legend { background: linear-gradient(135deg, #fff, var(--cs-paper)); }
  .lg-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 8px; }
  .lg-list li { display: flex; gap: 10px; align-items: center; padding: 10px 12px; background: #fff; border: 2px solid var(--cs-ink); font-size: 12.5px; }
  .lg__dot { width: 14px; height: 14px; flex-shrink: 0; }
  .lg-list strong { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .12em; }

  .city { background: linear-gradient(180deg, var(--cs-paper), #fff); border-top-color: var(--st-color); }
  .city .kicker { background: var(--st-color); }
  .city__head { font-size: 16px; line-height: 1.5; font-weight: 500; max-width: 72ch; margin: 0 0 18px; padding: 12px 14px; background: #fff; border-left: 5px solid var(--st-color); }
  .ch { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--st-color); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--st-color); }
  .cp { font-size: 13.5px; line-height: 1.6; margin: 0 0 12px; max-width: 72ch; padding: 10px 12px; background: #fff; border-left: 4px solid var(--st-color); }
  .cp.ships { border-left-color: var(--cs-sage); }
  .cp.dont { border-left-color: var(--cs-rust); }

  .sg-list { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 6px; }
  .sg-list li { padding: 10px 12px; background: #fff; border: 2px solid var(--cs-ink); border-left: 5px solid var(--st-color); }
  .sg-list h4 { font-family: var(--pc-font-mono); font-size: 12.5px; margin: 0 0 4px; font-weight: 700; }
  .sg-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .cm-list, .bs-list, .bg-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13px; line-height: 1.55; }
  .cm-list li { color: var(--cs-ink); padding: 2px 0; }
  .bs-list li { color: var(--st-color); padding: 2px 0; font-weight: 500; }
  .bg-list li { color: var(--cs-ink); padding: 2px 0; }

  .fed { background: var(--cs-paper); border-top: 8px solid var(--cs-sage); }
  .fed .kicker { background: var(--cs-sage); }
  .lede { font-size: 15px; line-height: 1.6; margin: 0 0 16px; max-width: 72ch; }
  .fed-h { font-family: var(--pc-font-mono); font-size: 13px; margin: 16px 0 8px; font-weight: 700; text-transform: uppercase; color: var(--cs-sage); }
  .fed-list { list-style: decimal; padding-left: 22px; margin: 0 0 14px; font-size: 14px; line-height: 1.55; }
  .fed-list li { margin-bottom: 6px; }
  .fed-next { padding: 12px 14px; background: #fff; border-left: 4px solid var(--cs-sage); font-size: 13.5px; line-height: 1.55; }
  .fed-next strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--cs-sage); margin-right: 6px; }

  .invitation { background: var(--cs-sage); color: var(--cs-paper); border-top-color: var(--cs-sage); }
  .invitation .kicker { background: var(--cs-mustard); color: var(--cs-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--cs-mustard); color: var(--cs-ink); border-left: 4px solid var(--cs-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--cs-sage); color: var(--cs-paper); text-decoration: none; }
  .links a:hover { background: var(--cs-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } }
</style>
