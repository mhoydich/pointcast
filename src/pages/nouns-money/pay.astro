---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { SOURCE_NOTES } from '../../lib/nouns-money/catalog';
import '../../styles/nouns-money-platform.css';
---
<BlockLayout title="Pay with Nouns Money · sandbox" description="Try a local demo payment flow using Nouns Money artwork. Test intents and receipts only; no funds, fees, wallet signature, transfer or redemption.">
<main class="nmp-shell" id="main-content" data-nm-pay>
  <nav class="nmp-nav" aria-label="Nouns Money"><a href="/nouns-money/">Nouns Money</a><a href="/nouns-money/collect/">Collect</a><a href="/me#nouns-money">Profile companion</a><a href="/nouns-money/developers/">Developers</a></nav>
  <span class="nmp-badge">TEST MODE · LOCAL SANDBOX</span>
  <h1 class="nmp-title">Pay with Nouns Money.</h1>
  <p>This is a programmable payment rehearsal. Demo notes are unlimited artwork references: they are never money, consumed from your collection, transferred, or redeemable. No real funds or gas.</p>
  <p class="nmp-status" role="status" data-nm-pay-status>Opening this browser’s sandbox…</p>
  <div class="nmp-workspace">
    <section class="nmp" aria-labelledby="nm-pay-title">
      <div data-nm-setup><p class="nmp-kicker">01 · CREATE A DEMO INTENT</p><h2 id="nm-pay-title">Try a small art-table exchange</h2>
        <form data-nm-create><label for="nm-label">Demo exchange label</label><input id="nm-label" name="label" type="text" value="Demo art table" maxlength="80" required /><label for="nm-note-count">Number of demo notes</label><select id="nm-note-count" name="noteCount">{[1,2,3,4,5].map(count=><option value={count}>{count} {count===1?'note':'notes'}</option>)}</select><div class="nmp-controls"><button type="submit" data-nm-create-button disabled>Create demo intent</button></div></form>
      </div>
      <div data-nm-checkout hidden><p class="nmp-kicker">02 · CHOOSE DEMO NOTES</p><h2 data-nm-intent-label>Demo intent</h2><p data-nm-select-instruction></p><p class="nmp-fine" data-nm-intent-meta></p>
        <div class="nmp-selection" data-nm-selection>{SOURCE_NOTES.map(note=><label><img src={note.image} width="1000" height="500" alt={`Nouns Money demo artwork · Noun #${note.nounId}`} loading="lazy"/><input type="checkbox" value={note.id} />Noun #{note.nounId}</label>)}</div>
        <p data-nm-selection-count>0 notes selected</p><div class="nmp-controls"><button type="button" data-nm-confirm disabled>Confirm demo payment</button><button type="button" data-nm-cancel>Cancel intent</button><button type="button" data-nm-back>Back to setup</button></div>
      </div>
      <div class="nmp-receipt" data-nm-receipt hidden></div>
    </section>
    <aside class="nmp"><p class="nmp-kicker">THIS BROWSER · DEMO HISTORY</p><h2>Intents &amp; receipts</h2><p class="nmp-fine">Stored in IndexedDB on this device, separate from your account collection. Clearing site data removes this history. Signing out does not clear these demos. Do not enter private information.</p><ul class="nmp-intents" data-nm-intents><li>No demo intents yet.</li></ul><p><a href="/nouns-money/docs/#state-model">Read the state model</a></p></aside>
  </div><noscript><p>Enable JavaScript to use the local sandbox.</p></noscript>
</main>
</BlockLayout>
<script>
import { mountPaymentSandbox } from '../../scripts/nouns-money-pay';
mountPaymentSandbox(); document.addEventListener('astro:page-load', mountPaymentSandbox);
</script>
