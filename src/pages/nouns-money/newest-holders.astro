---
import config from '../../data/nouns-money-collections.json';
import { newestHoldersMarkup } from '../../lib/nouns-money-newest-holders-markup.mjs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Newest holders · Nouns Money review</title>
    <link rel="stylesheet" href="/nouns-money/newest-holders/strip.css" />
  </head>
  <body style="margin:0;background:#f3f0e7">
    <main>
      <header style="padding:32px 24px;font-family:Arial,sans-serif">
        <p>NOUNS MONEY · REVIEW</p>
        <h1>Newest holders</h1>
        <p>This is the strip prepared for the separate nounsmoney.xyz home page.</p>
      </header>
      <Fragment set:html={newestHoldersMarkup(config)} />
    </main>
    <script is:inline type="module" src="/nouns-money/newest-holders/strip.mjs"></script>
  </body>
</html>
