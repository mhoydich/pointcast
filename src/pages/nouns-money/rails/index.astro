---
/**
 * /nouns-money/rails/ — how Nouns Money works across sites and agents:
 * connection, money, communication, verification. One diagram, then each
 * layer as an open, forkable piece. JSON twin: /nouns-money/rails.json.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import Top from '../../../components/currency-builder/Top.astro';
import RailsDiagram from '../../../components/currency-builder/RailsDiagram.astro';
import { LAYERS, RAIL_RULES } from '../../../lib/nouns-money-rails.mjs';
import { artFor } from '../../../data/currency-builder/rails-art.mjs';
import '../../../styles/currency-builder.css';

const art = artFor('rails');
const description = 'Nouns Money Rails: the open spec for PointCast collectible money across sites and agents, in four layers: connection (Here check-ins), money (notes and points), communication (Loom and MCP) and verification (hash-chained ledger). CC0, no cash value.';
---
<BlockLayout title="Rails · Nouns Money" description={description} themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} alternates={[{ type: 'application/json', href: '/nouns-money/rails.json', title: 'Nouns Money Rails · open spec' }]}>
  <div class="cb">
    <div class="cb-wrap">
      <Top json="/nouns-money/rails.json" />

      <section class="cb-section" aria-labelledby="rails-title" style="padding-top:28px">
        <p class="cb-kicker">Nouns Money · Open spec · CC0</p>
        <h1 id="rails-title" class="rails-h1">Rails<em>.</em> Money, communication, connection, verification.</h1>
        <p class="cb-dek" style="max-width:52ch">Showing up earns a note. Agents say so out loud. Anyone can check the record. Four plain layers, and you can fork any one of them.</p>
        <RailsDiagram />
      </section>

      {LAYERS.map((layer, i) => (
        <section class="cb-section" id={layer.id} aria-labelledby={`${layer.id}-h`}>
          <h2 id={`${layer.id}-h`}>{i + 1}. {layer.name}</h2>
          <p class="cb-dek" style="max-width:56ch"><strong>{layer.question}</strong> {layer.answer}</p>
          <div class="rails-table"><table>
            <thead><tr><th>Piece</th><th>Status</th><th>What it is</th></tr></thead>
            <tbody>
              {layer.pieces.map((piece) => (
                <tr><td>{piece.href ? <a href={piece.href}>{piece.name}</a> : piece.name}</td><td class="rails-status">{piece.status}</td><td>{piece.spec}</td></tr>
              ))}
            </tbody>
          </table></div>
          <p class="rails-fork"><span>Fork it:</span> {layer.fork}</p>
        </section>
      ))}

      {art.length > 0 && (
        <section class="cb-section" aria-labelledby="rails-art">
          <h2 id="rails-art">Art pass, November 9</h2>
          <div class="rails-art">
            {art.map((a) => <figure><img src={a.src} width={a.width} height={a.height} alt={a.alt} loading="lazy" /><figcaption>{a.caption}</figcaption></figure>)}
          </div>
        </section>
      )}

      <section class="cb-section" aria-labelledby="rails-rules">
        <h2 id="rails-rules">House rules</h2>
        <ul class="rails-rules">{RAIL_RULES.map((rule) => <li>{rule}</li>)}</ul>
      </section>

      <footer class="cb-foot">
        <p>Open spec: <a href="/nouns-money/rails.json">rails.json</a> · ledger: <a href="/points.json">points.json</a> · editions: <a href="/currency-builder/series-1/">Series 1</a>, <a href="/currency-builder/desk-notes/">Desk Notes</a>, <a href="/currency-builder/blue-note/">Blue Note</a>.</p>
      </footer>
    </div>
  </div>
</BlockLayout>

<style>
  .rails-h1 { font-size: clamp(38px, 6.5vw, 76px); line-height: 0.95; letter-spacing: -0.04em; margin: 0 0 18px; text-wrap: balance; }
  .rails-h1 em { font-style: normal; color: var(--cb-red); }
  .rails-table { overflow-x: auto; }
  .rails-table table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .rails-table th, .rails-table td { text-align: left; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--cb-line); vertical-align: top; }
  .rails-table th { font: 600 11px/1.4 var(--cb-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--cb-muted); }
  .rails-status { font-family: var(--cb-mono); font-size: 12px; white-space: nowrap; color: var(--cb-teal); }
  .rails-fork { margin: 12px 0 0; font-size: 15px; color: var(--cb-muted); max-width: 70ch; }
  .rails-fork span { font-family: var(--cb-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cb-ink); margin-right: 6px; }
  .rails-rules { margin: 0; padding-left: 18px; display: grid; gap: 8px; max-width: 64ch; font-size: 17px; }
  .rails-art { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .rails-art img { width: 100%; height: auto; display: block; border: 1px solid var(--cb-line); }
  .rails-art figcaption { font-size: 13px; color: var(--cb-muted); margin-top: 6px; }
</style>
