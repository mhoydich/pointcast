---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { ENJOY_URL, ENJOY_PUBLISHED, ENJOY_STATUS, ENJOY_RULES, ENJOY_TOKENS, ENJOY_AGENTS, ENJOY_PHASES, ENJOY_DELIVERABLES } from '../../data/enjoy-money';
const description = 'Hoydich Enterprises’ plan for Enjoy. Money: paper notes you scan to claim on Tezos, a public Bank ledger, and agent wallets that pay and earn Bot Notes. Closed loop: nothing cashes out.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: 'Enjoy. Money — paper notes and bot money', description,
  url: ENJOY_URL, datePublished: ENJOY_PUBLISHED, dateModified: ENJOY_PUBLISHED,
  author: { '@type': 'Person', name: 'Michael Hoydich' }, publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' },
  isPartOf: { '@type': 'CreativeWork', name: 'Nouns Money', url: 'https://pointcast.xyz/nouns-money/' },
};
---
<BlockLayout title="Enjoy. Money · Hoydich Enterprises" description={description} image="/images/og/nouns-money.png" themeColor="#f6edcd" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/nouns-money/enjoy.json', title: 'Enjoy. Money plan · machine edition' }]}>
  <article class="ej" data-enjoy-money>
    <nav class="ej-top" aria-label="Enjoy. Money"><a href="/">POINTCAST ↗</a><a href="/nouns-money/">NOUNS MONEY ↗</a><span>HOYDICH ENTERPRISES · PLAN · {ENJOY_PUBLISHED}</span></nav>

    <header class="ej-hero">
      <div>
        <p class="ej-kicker">HOYDICH ENTERPRISES · SERIES 1</p>
        <h1>Enjoy.</h1>
        <p class="ej-dek">Paper notes you can hold. Scan one, and it lands in your wallet. Bots get money too.</p>
        <p class="ej-status" role="status"><strong>{ENJOY_STATUS.label}</strong> {ENJOY_STATUS.detail}</p>
        <div class="ej-actions"><a class="ej-primary" href="#phases">Read the build plan ↓</a><a href="/nouns-money/enjoy.json">Machine edition ↗</a></div>
      </div>
      <figure class="ej-note" aria-label="Specimen of an Enjoy. note">
        <div class="ej-note__face">
          <span class="ej-note__corner">1</span><span class="ej-note__corner ej-note__corner--br">1</span>
          <p class="ej-note__issuer">HOYDICH ENTERPRISES</p>
          <p class="ej-note__mark">Enjoy.</p>
          <p class="ej-note__serial">S1-ENJ-0001</p>
          <p class="ej-note__sig">Michael Hoydich</p>
          <span class="ej-note__qr" aria-hidden="true"></span>
        </div>
        <figcaption>SPECIMEN · ILLUSTRATION ONLY · NOT YET PRINTED</figcaption>
      </figure>
    </header>

    <section class="ej-section" aria-labelledby="ej-loop">
      <div class="ej-heading"><p class="ej-kicker">00 / GROUND RULES</p><h2 id="ej-loop">Value comes in.<br/>It never goes out.</h2></div>
      <ol class="ej-rules">{ENJOY_RULES.map((rule) => <li><h3>{rule.title}</h3><p>{rule.body}</p></li>)}</ol>
    </section>

    <section class="ej-section" aria-labelledby="ej-board">
      <div class="ej-heading"><p class="ej-kicker">THE BOARD · ONE FA2 CONTRACT</p><h2 id="ej-board">Four notes on one contract.</h2></div>
      <div class="ej-board" role="table" aria-label="Enjoy. Money token IDs">
        <div class="ej-row ej-row--head" role="row"><span role="columnheader">ID</span><span role="columnheader">Note</span><span role="columnheader">Symbol</span><span role="columnheader">Supply</span></div>
        {ENJOY_TOKENS.map((t) => <div class="ej-row" role="row"><span role="cell" class="ej-mono">{String(t.id).padStart(2, '0')}</span><span role="cell"><strong>{t.name}</strong><small>{t.kind}{t.sealed ? ' · sealed after mint' : ''}</small></span><span role="cell" class="ej-mono">{t.symbol}</span><span role="cell">{t.supply}</span></div>)}
      </div>
      <p class="ej-fine">Zero decimals on every token. Notes mint their whole print run to Treasury, then seal. Agents never mint.</p>
    </section>

    <section class="ej-section" id="phases" aria-labelledby="ej-phases">
      <div class="ej-heading"><p class="ej-kicker">THE BUILD · TESTNET, THEN MAINNET</p><h2 id="ej-phases">Six phases. A gate after each.</h2></div>
      <div class="ej-phases">{ENJOY_PHASES.map((p) => <article class:list={['ej-phase', `ej-phase--${p.state}`]}>
        <div class="ej-phase__top"><span class="ej-mono">PHASE {p.n}</span><span class="ej-pill">{p.state === 'later' ? 'LATER' : p.state.toUpperCase()}</span></div>
        <h3>{p.title}</h3><p>{p.summary}</p>
        <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
        <p class="ej-gate"><span class="ej-mono">{p.state === 'later' ? 'BEFORE STARTING' : `GATE ${p.n}`}</span>{p.gate}</p>
      </article>)}</div>
    </section>

    <section class="ej-section ej-bots" aria-labelledby="ej-bots">
      <div class="ej-heading"><p class="ej-kicker">BOT MONEY · ENJOY. CREDITS</p><h2 id="ej-bots">The first three accounts.</h2></div>
      <div class="ej-agents">{ENJOY_AGENTS.map((a) => <div><span class="ej-mono">AGENT</span><strong>{a.name}</strong><small>{a.model}</small></div>)}</div>
      <p>Agents call a relay with a per-agent key; the relay signs from that agent’s wallet and holds the caps. They earn Bot Notes for approved night-shift work and spend them on <code>desk_ask</code>. A person can hand a paper note to an agent by claiming its code to the agent’s address.</p>
      <p class="ej-fine">Bot Notes are closed-loop credits. They buy nothing outside PointCast and redeem for nothing. See also the <a href="/bot-money/">Bot Money Lab</a>.</p>
    </section>

    <section class="ej-section" aria-labelledby="ej-ship">
      <div class="ej-heading"><p class="ej-kicker">DELIVERABLES</p><h2 id="ej-ship">What ships.</h2></div>
      <ul class="ej-checklist">{ENJOY_DELIVERABLES.map((d) => <li><span aria-hidden="true">☐</span>{d}</li>)}</ul>
    </section>

    <footer class="ej-foot"><p>Plan by Michael Hoydich for Hoydich Enterprises; page by Claude Code for PointCast. Nothing here is an offer, a security or a promise of value. Notes and credits are collectible and closed-loop, with no cash value and no redemption.</p><a href="/nouns-money/">Back to Nouns Money ↗</a></footer>
  </article>
</BlockLayout>

<style>
.ej{--ej-paper:#f6edcd;--ej-ink:#13261c;--ej-green:#0b6b3a;--ej-gold:#b8862b;--ej-card:#fffaf0;--ej-line:#13261c;max-width:1180px;margin:0 auto;padding:16px 16px 64px;color:var(--ej-ink);background:var(--ej-paper);font-family:var(--pc-font-sans,'Inter',sans-serif)}
.ej-mono,.ej-kicker,.ej-top{font-family:var(--pc-font-mono,ui-monospace,monospace);letter-spacing:.08em}
.ej-top{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:.75rem;padding-bottom:12px;border-bottom:2px solid var(--ej-line)}.ej-top a{color:inherit}.ej-top span{margin-left:auto}
.ej-kicker{margin:0 0 6px;font-size:.78rem;color:var(--ej-green)}
.ej-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:center;padding:40px 0}
.ej-hero h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(4rem,12vw,8rem);line-height:.9;margin:0 0 12px;font-weight:400;font-style:italic;letter-spacing:-.03em}
.ej-dek{font-size:1.35rem;line-height:1.35;margin:0 0 16px;max-width:30ch}
.ej-status{border:2px solid var(--ej-line);background:var(--ej-card);padding:12px 14px;margin:0 0 16px;line-height:1.5}.ej-status strong{display:block;color:#8a2a1b}
.ej-actions{display:flex;flex-wrap:wrap;gap:10px}.ej-actions a{display:inline-flex;align-items:center;min-height:44px;padding:8px 14px;border:2px solid var(--ej-line);color:var(--ej-ink);text-decoration:none;background:var(--ej-card)}.ej-actions .ej-primary{background:var(--ej-green);color:#fff;border-color:var(--ej-green)}
.ej-note{margin:0}.ej-note__face{position:relative;aspect-ratio:2/1;border:3px double var(--ej-green);background:repeating-linear-gradient(45deg,#e9f3dc 0 6px,#f3f8e8 6px 12px);box-shadow:8px 8px 0 var(--ej-gold);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#0d3b22}
.ej-note__corner{position:absolute;top:8px;left:12px;font:700 2rem/1 Georgia,serif}.ej-note__corner--br{top:auto;left:auto;bottom:8px;right:12px}
.ej-note__issuer{margin:0;font:600 .75rem/1 var(--pc-font-mono,monospace);letter-spacing:.2em}.ej-note__mark{margin:4px 0;font:italic 400 clamp(2.4rem,6vw,3.6rem)/1 Georgia,serif}.ej-note__serial{margin:0;font:.75rem/1 var(--pc-font-mono,monospace);color:#8a2a1b}.ej-note__sig{margin:8px 0 0;font:italic .95rem/1 Georgia,serif;border-top:1px solid #0d3b22;padding-top:3px}
.ej-note__qr{position:absolute;right:14%;bottom:14%;width:13%;aspect-ratio:1;background:conic-gradient(#0d3b22 0 25%,transparent 0 50%,#0d3b22 0 75%,transparent 0) 0 0/33% 33%;border:2px solid #0d3b22}
.ej-note figcaption{margin-top:14px;font:.7rem/1.4 var(--pc-font-mono,monospace);letter-spacing:.08em}
.ej-section{padding:36px 0;border-top:2px solid var(--ej-line)}
.ej-heading h2{font-family:Georgia,serif;font-weight:400;font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.1;margin:0 0 20px}
.ej-rules{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.ej-rules li{border:1px solid var(--ej-line);background:var(--ej-card);padding:14px}.ej-rules h3{margin:0 0 6px;font-size:1.05rem}.ej-rules p{margin:0;line-height:1.5}
.ej-board{border:2px solid var(--ej-line);background:#10261a;color:#f4e9c4}.ej-row{display:grid;grid-template-columns:56px minmax(0,2.2fr) 90px minmax(0,1.4fr);gap:12px;padding:12px 14px;border-top:1px solid #2f4a3a;align-items:center}.ej-row--head{border-top:0;font:.72rem/1 var(--pc-font-mono,monospace);letter-spacing:.1em;color:#d9b45a}.ej-row strong{display:block}.ej-row small{opacity:.75}.ej-row .ej-mono{color:#ffd877;font-size:1.05rem}
.ej-fine{font-size:.875rem;line-height:1.5;margin:12px 0 0;opacity:.85}
.ej-phases{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}.ej-phase{border:2px solid var(--ej-line);background:var(--ej-card);padding:16px;display:flex;flex-direction:column}.ej-phase--later{background:transparent;border-style:dashed}.ej-phase--built{box-shadow:6px 6px 0 var(--ej-green)}.ej-phase--built .ej-pill{background:var(--ej-green);color:#fff;border-color:var(--ej-green)}
.ej-phase__top{display:flex;justify-content:space-between;font-size:.75rem}.ej-pill{font:.68rem/1 var(--pc-font-mono,monospace);padding:4px 7px;border:1px solid currentColor}
.ej-phase h3{margin:10px 0 6px;font-size:1.2rem}.ej-phase p{margin:0 0 8px;line-height:1.5}.ej-phase ul{margin:0 0 12px;padding-left:18px;line-height:1.5}.ej-phase li{margin-bottom:4px}
.ej-gate{margin-top:auto !important;padding:10px;background:#e3efd9;border-left:4px solid var(--ej-green)}.ej-gate .ej-mono{display:block;font-size:.7rem;color:var(--ej-green);margin-bottom:3px}
.ej-agents{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:16px}.ej-agents div{border:2px solid var(--ej-line);background:#10261a;color:#f4e9c4;padding:14px;display:flex;flex-direction:column}.ej-agents .ej-mono{font-size:.68rem;color:#d9b45a}.ej-agents strong{font:italic 400 2rem/1.1 Georgia,serif}.ej-agents small{opacity:.8}
.ej-bots>p{max-width:70ch;line-height:1.55}
.ej-checklist{list-style:none;padding:0;margin:0;columns:2 280px;column-gap:24px}.ej-checklist li{break-inside:avoid;padding:6px 0;border-bottom:1px dotted var(--ej-line);display:flex;gap:8px}
.ej-foot{border-top:2px solid var(--ej-line);padding-top:16px;font-size:.875rem;line-height:1.5}.ej-foot a{color:var(--ej-green)}
.ej a:focus-visible{outline:3px solid #c8412e;outline-offset:3px}
@media(max-width:760px){.ej-hero{grid-template-columns:1fr;padding:24px 0}.ej-top span{margin-left:0}.ej-row{grid-template-columns:40px minmax(0,1fr) 64px}.ej-row>:nth-child(4){grid-column:2/-1;font-size:.85rem;opacity:.85}.ej-row--head>:nth-child(4){display:none}.ej-agents{grid-template-columns:1fr}}
@media(prefers-color-scheme:dark){.ej{--ej-paper:#14201a;--ej-ink:#efe7cc;--ej-card:#1c2b23;--ej-line:#8ebda3;--ej-green:#7fd1a2}.ej-status strong{color:#ff9d86}.ej-actions .ej-primary{color:#0b1a12}.ej-gate{background:#223a2d}}
</style>
