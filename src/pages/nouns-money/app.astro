---
import { APP_CATALOG, APP_SERIES, APP_DISCLOSURE } from '../../lib/nouns-money-app-catalog';
import '../../styles/nouns-money-app.css';
const flowers = APP_CATALOG.filter(a=>a.seriesKey==='flowers');
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
 <title>Nouns Money · Michael Hoydich’s Currency Builder</title>
 <meta name="description" content="Your little art collection. Browse Nouns Money, save favorites on this device, print a proof and compose a local design prototype. Ivory, ink and a little rainbow."/>
 <meta name="theme-color" content="#f5f1e7"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="default"/><meta name="apple-mobile-web-app-title" content="Nouns Money"/>
 <link rel="canonical" href="https://pointcast.xyz/nouns-money/app/"/><link rel="manifest" href="/nouns-money/app/manifest.webmanifest"/><link rel="icon" href="/nouns-money/app/icon.svg"/><link rel="apple-touch-icon" href="/nouns-money/app/icon-192.png"/>
 <meta property="og:type" content="website"/><meta property="og:title" content="Nouns Money · Your little art collection"/><meta property="og:description" content="Michael Hoydich’s Currency Builder. Design. Print. Produce. Profit. Collectible art and a local studio prototype."/><meta property="og:image" content="https://pointcast.xyz/images/nouns-money/flowers-2026/01_saltwater_poppy_nouns_trio.webp"/><meta property="og:url" content="https://pointcast.xyz/nouns-money/app/"/>
</head>
<body>
 <a class="cb-skip" href="#main-content">Skip to collection</a>
 <div class="cb-rainbow" aria-hidden="true"></div>
 <header class="cb-menubar"><a class="cb-logo" href="/nouns-money/" aria-label="Nouns Money archive"><span aria-hidden="true">⌐◨-◨</span> <strong>Nouns Money</strong></a><nav aria-label="App information"><a href="/nouns-money/">Archive ↗</a><a href="#about">Help</a></nav></header>
 <main id="main-content" class="cb-app" data-currency-app>
  <header class="cb-intro"><p class="cb-eyebrow">MICHAEL HOYDICH’S</p><h1>Currency<br/>Builder<span class="cb-dot">.</span></h1><p class="cb-tagline">Design. Print. Produce. Profit.</p><p class="cb-description">Your little art collection.<br/>A whole world of things to make.</p><p class="cb-prototype">An independent collectible-art studio. Physical production is proposed; “Profit” is the brand motto, not a return promise.</p></header>
  <section class="cb-window cb-feature" aria-labelledby="new-title"><div class="cb-titlebar"><span class="cb-stripes" aria-hidden="true"></span><h2 id="new-title">New on the desk</h2><span class="cb-stripes" aria-hidden="true"></span></div><div class="cb-feature-body"><a href={flowers[0].original} data-open-art="flower-01"><img src={flowers[0].image} width={flowers[0].width} height={flowers[0].height} alt="Saltwater Poppy: Nouns-inspired flower note, decorative stamp and medallion generated study" fetchpriority="high"/></a><div><p class="cb-eyebrow">FLOWER STUDIES / 2026</p><h3>A little color.<br/>A lot of character.</h3><p>Notes, decorative stamps and medallions, imagined through flowers, coastlines and the familiar Nouns-inspired glasses.</p><a class="cb-button" href="#catalog" data-series-link="flowers">Browse the flowers <span aria-hidden="true">→</span></a><p class="cb-caption">Generated design studies. Not manufactured objects, legal tender or postage.</p></div></div></section>
  <section class="cb-window cb-section" id="catalog" data-panel="catalog" aria-labelledby="catalog-title"><div class="cb-titlebar"><span class="cb-stripes" aria-hidden="true"></span><h2 id="catalog-title">The collection</h2><span class="cb-stripes" aria-hidden="true"></span></div><div class="cb-panel-body"><div class="cb-tools" data-js><label class="cb-search"><span>Find a design</span><input type="search" data-search placeholder="A flower, a title, a Noun…" maxlength="80" autocomplete="off"/></label><label><span>Edition</span><select data-series><option value="all">All collections</option>{APP_SERIES.map(s=><option value={s.key}>{s.title}</option>)}</select></label><button type="button" class="cb-small" data-reset>Reset</button></div><p class="cb-result" data-result aria-live="polite">{APP_CATALOG.length} designs · exact-source originals and clearly labeled generated studies</p><div class="cb-gallery" data-gallery>{APP_CATALOG.map(art=><article class="cb-card" data-art-card={art.id} data-series={art.seriesKey}><a href={art.original} data-open-art={art.id} aria-label={`View ${art.title} full screen`}><img src={art.image} width={art.width} height={art.height} loading="lazy" alt={`${art.title} · ${art.seriesLabel} · ${art.kind==='generated-study'?'generated design study':'exact-source collectible art'}`}/></a><div class="cb-card-body"><p class="cb-eyebrow">{art.seriesLabel}</p><h3><a href={art.original} data-open-art={art.id}>{art.title}</a></h3><p class="cb-card-kind">{art.kind==='generated-study'?'Generated study':'Exact-source artwork'}</p><button class="cb-save" type="button" data-favorite={art.id} aria-label={`Save ${art.title}`} aria-pressed="false" data-js><span aria-hidden="true">♡</span> Save</button></div></article>)}</div><p data-empty hidden>No designs found. Try another title or reset the filters.</p><noscript><p>All artwork and original-file links work here without JavaScript. Enable JavaScript for filters, full-screen viewing, saved favorites and the local workshop.</p></noscript></div></section>
  <section class="cb-window cb-section" id="saved" data-panel="saved" aria-labelledby="saved-title"><div class="cb-titlebar"><span class="cb-stripes" aria-hidden="true"></span><h2 id="saved-title">Your saved set</h2><span class="cb-stripes" aria-hidden="true"></span></div><div class="cb-panel-body"><p>Keep a few things you love. These are design preferences on this device, not proof of owning artwork or an NFT.</p><p data-storage role="status">Enable JavaScript to save favorites in this browser.</p><div class="cb-actions" data-js><button type="button" data-export-favorites>Export saved list</button><button type="button" class="cb-small" data-clear-favorites>Clear saved list</button><button type="button" class="cb-small" data-undo-clear hidden>Undo clear</button></div><div class="cb-gallery" data-saved-gallery></div><p data-saved-empty>Your set is waiting. Tap Save on a design to begin.</p></div></section>
  <section class="cb-window cb-section" id="workshop" data-panel="workshop" aria-labelledby="workshop-title"><div class="cb-titlebar"><span class="cb-stripes" aria-hidden="true"></span><h2 id="workshop-title">Print workshop</h2><span class="cb-stripes" aria-hidden="true"></span></div><div class="cb-panel-body"><p class="cb-lead">From a favorite to a paper proof.</p><p>Compose a browser print sheet from the actual catalog images. Print at <strong>100% / Actual Size</strong>, with browser headers and footers off. Measure the 50 mm line first.</p><form data-print-form data-js><label>Artwork<select name="art">{APP_CATALOG.map(a=><option value={a.id}>{a.title} · {a.seriesLabel}</option>)}</select></label><div class="cb-form-row"><label>Paper<select name="paper"><option value="letter">US Letter</option><option value="a4">A4</option></select></label><label>Image width (mm)<input name="width" type="number" min="40" max="170" value="150" step="1" required/></label><label>Copies<input name="count" type="number" min="1" max="12" value="2" step="1" required/></label></div><p data-print-summary role="status"></p><div class="cb-actions"><button type="submit">Open print sheet ↗</button><button type="button" class="cb-small" data-print-reset>Reset</button></div></form><div class="cb-print-preview" data-print-preview aria-label="Selected artwork print preview"><img src={flowers[0].image} width={flowers[0].width} height={flowers[0].height} alt="Artwork selected for a digital print proof"/></div><p class="cb-caption">RGB screen proofs only. No CMYK separation, bleed, duplex reverse, physical sample or press certification is established. Foil, embossing and metal are pictured effects. Confirm rights, stock, color and finishing with a printer before production.</p><div class="cb-actions"><a href="/downloads/nouns-money-2027-three-design-print-sheet-light.pdf" download>Existing three-design PDF ↓</a><a href="/nouns-money/#print-proofs">Original print instructions ↗</a></div></div></section>
  <section class="cb-window cb-section" id="studio" data-panel="studio" aria-labelledby="studio-title"><div class="cb-titlebar"><span class="cb-stripes" aria-hidden="true"></span><h2 id="studio-title">Design studio · prototype</h2><span class="cb-stripes" aria-hidden="true"></span></div><div class="cb-panel-body"><p class="cb-lead">A small idea. Your own arrangement.</p><p>Choose existing artwork, set a title and an ink color, then download the composition. This is a local layout tool; it does not generate new artwork or manufacture an edition.</p><form data-studio-form data-js><label>Artwork<select name="art">{APP_CATALOG.map(a=><option value={a.id}>{a.title} · {a.seriesLabel}</option>)}</select></label><label>Your display title<input name="title" value="A little world of our own" maxlength="60" required/></label><div class="cb-form-row"><label>Ink<select name="ink"><option value="#181818">Black ink</option><option value="#b43220">Vermilion</option><option value="#1e4e78">Ocean blue</option><option value="#28523f">Garden green</option></select></label><label>Arrangement<select name="format"><option value="wide">Display card</option><option value="square">Square art card</option><option value="tall">Collector card</option></select></label></div><div class="cb-actions"><button type="submit">Download prototype SVG ↓</button><button type="button" class="cb-small" data-studio-reset>Reset</button></div><p data-studio-status role="status"></p></form><div class="cb-studio-preview" data-studio-preview><div class="cb-studio-title">A little world of our own</div><img src={flowers[0].image} width={flowers[0].width} height={flowers[0].height} alt="Live local composition preview"/><p>COLLECTIBLE ART · DESIGN PROTOTYPE</p></div><p class="cb-caption">The SVG embeds a raster catalog preview with your local title and border. It is a layout prototype, not an editable original artwork or a print master. No account, cloud generation or payment is involved.</p><details><summary>Brand & proposed workshop</summary><figure class="cb-brand-poster"><img src="/images/nouns-money/currency-builder/01-currency-builder-launch-poster.webp" width="1122" height="1402" loading="lazy" alt="Approved Michael Hoydich’s Currency Builder brand poster with Design. Print. Produce. Profit. lettering"/><figcaption>Generated brand study · approved wordmark. El Segundo workshop and physical production remain proposals.</figcaption></figure><p>Michael Hoydich’s Currency Builder is a developing design and production workshop for collectible notes, decorative stamps, medallions and printed editions. The El Segundo concept brings original artwork, careful materials and small-batch making together. The current collection presents design studies and a proposed workshop; purchasing, redemption, financial participation and health-payment services are not enabled.</p><p>Any future physical edition, DAO or backing plan needs separate permission, verified terms and legal review. The current artwork establishes none of those rights or benefits.</p></details></div></section>
  <footer class="cb-about" id="about"><h2>A little clarity.</h2><p>{APP_DISCLOSURE}</p><details><summary>Add to your iPhone Home Screen</summary><p>Open this page in Safari, tap Share, then Add to Home Screen. The web app opens in its own window on supported iOS versions. It needs a connection to load artwork; offline use is not promised. Favorites stay in this browser’s storage, and may differ between Safari and the Home Screen app.</p></details><p><a href="/nouns-money/">All original editions ↗</a> · <a href="/nouns-money/app/catalog.json">Read the catalog JSON ↗</a> · <a href="/">PointCast ↗</a></p><p class="cb-caption">Direction: Michael Hoydich · Nouns-inspired generated flower studies and preserved CC0 Nouns originals · independent, without official endorsement.</p></footer>
 </main>
 <nav class="cb-dock" aria-label="Nouns Money app"><a href="#catalog" aria-current="page"><span aria-hidden="true">▦</span>Collection</a><a href="#saved"><span aria-hidden="true">♡</span>Saved <b data-saved-count>0</b></a><a href="#workshop"><span aria-hidden="true">▤</span>Print</a><a href="#studio"><span aria-hidden="true">⌘</span>Studio</a></nav>
 <dialog class="cb-viewer" aria-labelledby="viewer-title" data-viewer><div class="cb-viewer-toolbar"><button type="button" data-viewer-close>← Close</button><p id="viewer-title" data-viewer-title></p><button type="button" data-viewer-save>♡ Save</button></div><div class="cb-viewer-art"><img data-viewer-image alt=""/></div><div class="cb-viewer-info"><p data-viewer-description></p><p class="cb-caption" data-viewer-disclaimer></p><div class="cb-actions"><button type="button" data-viewer-previous aria-label="Previous artwork">← Previous</button><button type="button" data-viewer-next aria-label="Next artwork">Next →</button><a data-viewer-original download>Original file ↓</a><button type="button" data-viewer-print>Print this design</button></div></div></dialog>
 <script type="application/json" id="currency-app-catalog" set:html={JSON.stringify(APP_CATALOG).replaceAll('<','\\u003c')}/>
 <script>import { initCurrencyApp } from '../../scripts/nouns-money-app-client.mjs'; initCurrencyApp();</script>
</body></html>
