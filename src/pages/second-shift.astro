---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  SECOND_SHIFT,
  SECOND_SHIFT_GAME_URL,
  SECOND_SHIFT_ORDERS,
} from '../lib/second-shift';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  '@id': `${SECOND_SHIFT.canonical}#game`,
  name: `${SECOND_SHIFT.name} — ${SECOND_SHIFT.subtitle}`,
  description: SECOND_SHIFT.description,
  url: SECOND_SHIFT.canonical,
  sameAs: SECOND_SHIFT_GAME_URL,
  image: SECOND_SHIFT.socialImage,
  gamePlatform: 'Web browser',
  applicationCategory: 'GameApplication',
  genre: ['Incremental game', 'Simulation game'],
  playMode: 'SinglePlayer',
  numberOfPlayers: 1,
  isAccessibleForFree: true,
  inLanguage: 'en-US',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout
  title="Second Shift"
  description={SECOND_SHIFT.description}
  image="/images/second-shift/social-card.png"
  themeColor="#071f2a"
  immersive={true}
  showNetworkStrip={false}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/second-shift.json', title: 'Second Shift game record' }]}
  frame={{
    image: SECOND_SHIFT.socialImage,
    buttons: [
      { label: 'Play Second Shift', action: 'link', target: SECOND_SHIFT.canonical },
      { label: 'Open game direct', action: 'link', target: SECOND_SHIFT_GAME_URL },
      { label: 'Game JSON', action: 'link', target: SECOND_SHIFT.machine },
    ],
  }}
>
  <main class="shift-wrapper">
    <header class="shift-head">
      <nav aria-label="Breadcrumb">
        <a href="/">PointCast</a><span>/</span><a href="/apps">Apps</a><span>/</span><b>Second Shift</b>
      </nav>
      <div class="shift-head__title">
        <div>
          <p>CH.ESC · APP · BLOCK 0571 · NIGHT ORDER</p>
          <h1>SECOND SHIFT</h1>
        </div>
        <p class="shift-head__dek">
          Six ordinary needs. One seven-minute night order. Build the local line until the useful knowledge outlives the clicking.
        </p>
        <div class="shift-head__actions">
          <button type="button" data-fullscreen data-direct={SECOND_SHIFT_GAME_URL}>Full screen</button>
          <a href={SECOND_SHIFT_GAME_URL} target="_blank" rel="noopener">Open direct ↗</a>
          <a href="/second-shift.json">JSON</a>
        </div>
      </div>
    </header>

    <section class="game-frame" aria-label="Playable Second Shift workshop">
      <iframe
        data-second-shift-frame
        src={SECOND_SHIFT_GAME_URL}
        title="Second Shift — El Segundo Makes the Morning"
        loading="eager"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="autoplay; clipboard-write; fullscreen"
        allowfullscreen
      >
        <a href={SECOND_SHIFT_GAME_URL}>Open Second Shift directly.</a>
      </iframe>
    </section>

    <section class="field-note" aria-labelledby="local-list-title">
      <div class="field-note__thesis">
        <p>THE LOCAL TEST</p>
        <h2 id="local-list-title">Bulky. Breakable. Repairable. Needed by morning.</h2>
        <p>
          The workshop begins with six useful candidates—not a supplier claim, a procurement offer, or proof that any one is already made in town.
        </p>
      </div>
      <ol>
        {SECOND_SHIFT_ORDERS.map((order, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{order.name}</strong>
            <small>{order.note}</small>
          </li>
        ))}
      </ol>
    </section>

    <footer class="shift-foot">
      <p><b>GAME BOUNDARY</b> The clock may run into overtime. Scores and the dawn receipt are simulated. Progress stays in this browser.</p>
      <a href="/b/0571">Read the permanent Block →</a>
    </footer>
  </main>
</BlockLayout>

<script>
  const frame = document.querySelector('[data-second-shift-frame]');
  const fullscreenButton = document.querySelector('[data-fullscreen]');

  fullscreenButton?.addEventListener('click', async () => {
    if (frame instanceof HTMLIFrameElement && frame.requestFullscreen) {
      try {
        await frame.requestFullscreen();
        return;
      } catch {
        // The direct game remains the fallback when a browser denies fullscreen.
      }
    }

    if (fullscreenButton instanceof HTMLElement && fullscreenButton.dataset.direct) {
      window.open(fullscreenButton.dataset.direct, '_blank', 'noopener');
    }
  });
</script>

<style>
  .shift-wrapper {
    --night: #071f2a;
    --paper: #f0eadb;
    --electric: #d9ff38;
    --orange: #ff7040;
    --rule: rgba(240, 234, 219, 0.28);
    min-height: 100vh;
    padding: 16px clamp(10px, 2vw, 24px) 72px;
    color: var(--paper);
    background: var(--night);
  }
  .shift-head {
    max-width: 1600px;
    margin: 0 auto;
    border: 1px solid var(--rule);
    border-bottom: 0;
  }
  nav {
    display: flex;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
    color: rgba(240, 234, 219, 0.72);
    font: 700 9px/1.2 var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  nav a { color: inherit; }
  .shift-head__title {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(280px, 0.78fr) auto;
    gap: 24px;
    align-items: end;
    padding: clamp(20px, 4vw, 48px);
  }
  .shift-head__title p:first-child {
    margin: 0 0 8px;
    color: var(--electric);
    font: 700 9px/1.3 var(--pc-font-mono);
    letter-spacing: 0.13em;
  }
  h1 {
    margin: 0;
    font-size: clamp(52px, 8vw, 124px);
    line-height: 0.78;
    letter-spacing: -0.075em;
  }
  .shift-head__dek {
    max-width: 560px;
    margin: 0;
    font-size: clamp(16px, 1.7vw, 23px);
    line-height: 1.35;
  }
  .shift-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    justify-content: flex-end;
  }
  .shift-head__actions a,
  .shift-head__actions button {
    appearance: none;
    padding: 10px 12px;
    border: 1px solid var(--paper);
    border-radius: 0;
    color: var(--paper);
    background: transparent;
    font: 700 9px/1 var(--pc-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .shift-head__actions button { color: var(--night); background: var(--electric); border-color: var(--electric); }
  .shift-head__actions a:hover,
  .shift-head__actions button:hover { color: var(--night); background: var(--orange); border-color: var(--orange); text-decoration: none; }
  .game-frame {
    max-width: 1600px;
    margin: 0 auto;
    border: 1px solid var(--rule);
    background: #08131a;
  }
  .game-frame iframe {
    display: block;
    width: 100%;
    height: max(690px, calc(100svh - 152px));
    border: 0;
    background: #08131a;
  }
  .field-note {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(420px, 1.22fr);
    gap: clamp(28px, 6vw, 88px);
    max-width: 1600px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 110px) clamp(10px, 4vw, 60px);
    border-inline: 1px solid var(--rule);
  }
  .field-note__thesis > p:first-child {
    margin: 0 0 14px;
    color: var(--electric);
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.14em;
  }
  .field-note h2 {
    margin: 0;
    max-width: 700px;
    font-size: clamp(42px, 5.6vw, 84px);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }
  .field-note__thesis > p:last-child { max-width: 650px; margin: 26px 0 0; color: rgba(240, 234, 219, 0.72); line-height: 1.55; }
  .field-note ol { margin: 0; padding: 0; border-top: 1px solid var(--paper); list-style: none; }
  .field-note li { display: grid; grid-template-columns: 42px minmax(150px, .75fr) 1fr; gap: 12px; align-items: baseline; padding: 15px 0; border-bottom: 1px solid var(--rule); }
  .field-note li span { color: var(--orange); font: 700 9px var(--pc-font-mono); }
  .field-note li strong { font-size: 18px; }
  .field-note li small { color: rgba(240, 234, 219, 0.62); font-size: 12px; }
  .shift-foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 18px clamp(10px, 4vw, 60px);
    border: 1px solid var(--rule);
    color: rgba(240, 234, 219, 0.68);
    font: 10px/1.5 var(--pc-font-mono);
    letter-spacing: 0.04em;
  }
  .shift-foot p { max-width: 780px; margin: 0; }
  .shift-foot a { color: var(--electric); white-space: nowrap; }
  @media (max-width: 920px) {
    .shift-head__title { grid-template-columns: 1fr; align-items: start; }
    .shift-head__actions { justify-content: flex-start; }
    .game-frame iframe { height: 78svh; min-height: 680px; }
    .field-note { grid-template-columns: 1fr; }
  }
  @media (max-width: 580px) {
    .shift-wrapper { padding-inline: 0; padding-top: 0; }
    .shift-head, .game-frame, .field-note, .shift-foot { border-inline: 0; }
    .shift-head__title { padding: 24px 14px; }
    .game-frame iframe { height: 82svh; min-height: 700px; }
    .field-note { padding-inline: 16px; }
    .field-note li { grid-template-columns: 34px 1fr; }
    .field-note li small { grid-column: 2; }
    .shift-foot { flex-direction: column; padding-inline: 16px; }
  }
</style>
