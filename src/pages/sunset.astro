---
/**
 * /sunset — a room that only exists during the magic hour.
 *
 * Mike: "run overnight on sprints, you lead go." This sprint adds a
 * time-locked page. Most rooms on the site are open all day; /sunset
 * is the first that explicitly isn't. From 17:30 to 20:30 local, the
 * page renders a full-bleed woodblock sunset over El Segundo. Outside
 * that window, it renders a "closed" panel with a countdown to the
 * next opening — the same scene rendered dim and desaturated, so the
 * room still has a visual identity even when it's locked.
 *
 * Why a time-locked page: PointCast is a broadcast, not a website.
 * Surfaces that change over the day reinforce that — you can't just
 * bookmark sunset, you have to be here for it. The closed view is
 * also a small piece of editorial: the broadcast continues even when
 * this particular window is shut.
 *
 * Hours pulled from current server time. No timezone math — server
 * runs in PT for now, El Segundo time. (When we redeploy to a UTC
 * region we'll add a TZ shim; out of scope for this sprint.)
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const now = new Date();
const h = now.getHours();
const m = now.getMinutes();
const hm = h * 60 + m;

// Window: 17:30 → 20:30 = [1050, 1230] minutes-of-day. Three hours wide
// catches both winter (~17:30 sunset) and summer (~20:00 sunset) in LA.
const WINDOW_OPEN_MIN = 17 * 60 + 30;
const WINDOW_CLOSE_MIN = 20 * 60 + 30;
const isOpen = hm >= WINDOW_OPEN_MIN && hm < WINDOW_CLOSE_MIN;

// Minutes until next opening (for the closed view).
function fmtCountdown(): string {
  let until: number;
  if (hm < WINDOW_OPEN_MIN) {
    until = WINDOW_OPEN_MIN - hm;
  } else {
    // After today's close — wait until tomorrow's opening.
    until = (24 * 60 - hm) + WINDOW_OPEN_MIN;
  }
  const hrs = Math.floor(until / 60);
  const mins = until % 60;
  if (hrs === 0) return `${mins}m`;
  return `${hrs}h ${mins.toString().padStart(2, '0')}m`;
}
const countdown = fmtCountdown();

// Sun position drifts across the magic-hour window. At 17:30 the sun is
// at x≈340 (high-right of canvas), at 20:30 it's submerged off-screen.
// During the window we interpolate; outside, we pin it just touching
// the horizon for the closed-view ghost.
const winFrac = isOpen
  ? (hm - WINDOW_OPEN_MIN) / (WINDOW_CLOSE_MIN - WINDOW_OPEN_MIN)
  : 0.55;
const sunX = 800 - winFrac * 240; // drifts left as the hour wears on
const sunY = 240 + winFrac * 140;  // and down past the horizon

const todayStr = now.toISOString().slice(0, 10);

// Three poem-strip lines for the open view. Editorial register, El Segundo
// specific. Mike can swap these in a future commit — keeping them inline
// here means /sunset doesn't depend on any data file for the first ship.
const poemLines = [
  'The refinery towers go red.',
  'A line of pelicans crossing the boardwalk, low.',
  'The whole coast holds its breath for forty minutes.',
];

const title = isOpen
  ? 'PointCast / sunset — the magic hour, right now'
  : 'PointCast / sunset — closed';
const description = isOpen
  ? 'A woodblock view of the El Segundo sunset, broadcasting live during the magic hour (17:30–20:30 PT).'
  : `/sunset is a room that only opens during the magic hour. Next opening in ${countdown}.`;
---

<BlockLayout title={title} description={description}>
  <main class={`sunset${isOpen ? ' sunset--open' : ' sunset--closed'}`}>

    {/* ─── Chyron ─── */}
    <p class="chyron mono">
      <span class="chyron__dot" aria-hidden="true"></span>
      <span>{isOpen ? 'MAGIC HOUR · OPEN' : 'CLOSED · NEXT OPEN IN ' + countdown.toUpperCase()}</span>
      <span class="chyron__dot chyron__dot--dim" aria-hidden="true"></span>
      <span>{todayStr}</span>
      <span class="chyron__dot chyron__dot--dim" aria-hidden="true"></span>
      <span>EL SEGUNDO · 33.916°N 118.416°W</span>
      <a href="/next" class="chyron__cta">/next →</a>
    </p>

    {/* ─── Sunset panel ─── */}
    <section class="panel" aria-label={isOpen ? 'A woodblock view of the El Segundo sunset' : 'A closed sunset panel'}>
      <svg class="panel__svg" viewBox="0 0 1200 600" role="img" aria-labelledby="sunset-title" preserveAspectRatio="xMidYMid slice">
        <title id="sunset-title">A flat-color woodblock sunset over El Segundo: violet sky, orange band, low sun, silhouette refinery and palms, sea aflame.</title>

        {/* Sky bands — magic-hour gradient in flat woodblock layers */}
        <rect x="0" y="0"   width="1200" height="60"  fill="#3d2b56"/>
        <rect x="0" y="60"  width="1200" height="40"  fill="#5a3866"/>
        <rect x="0" y="100" width="1200" height="44"  fill="#9a4f6a"/>
        <rect x="0" y="144" width="1200" height="44"  fill="#d96752"/>
        <rect x="0" y="188" width="1200" height="36"  fill="#f3a070"/>
        <rect x="0" y="224" width="1200" height="22"  fill="#fbd095"/>

        {/* Sun — low orange disk, drifting toward the horizon as the hour wears on */}
        <circle cx={sunX} cy={sunY} r="48" fill="#fdc06a" opacity="0.96"/>
        <circle cx={sunX} cy={sunY} r="34" fill="#ffe2a0"/>

        {/* Distant Santa Monicas — dim violet silhouette */}
        <path d="M0 246 L120 220 L180 236 L260 212 L340 234 L420 216 L520 242 L600 226 L700 244 L800 236 L900 248 L1000 240 L1100 246 L1200 242 L1200 260 L0 260 Z"
              fill="#3a2840"/>

        {/* Refinery — silhouette against the orange horizon */}
        <g fill="#1a0e16">
          <rect x="44" y="200" width="6" height="60"/>
          <rect x="58" y="212" width="4" height="48"/>
          <rect x="70" y="186" width="10" height="74"/>
          <rect x="88" y="204" width="6" height="56"/>
          <rect x="102" y="170" width="14" height="90"/>
          <rect x="124" y="198" width="8" height="62"/>
          <rect x="140" y="208" width="5" height="52"/>
          <rect x="154" y="192" width="9" height="68"/>
          <rect x="172" y="212" width="6" height="48"/>
          {/* flare stack */}
          <rect x="107" y="150" width="3" height="20"/>
        </g>
        <circle class="sunset-flare" cx="108.5" cy="146" r="9" fill="#fcd17a" opacity="0.7"/>
        <circle cx="108.5" cy="146" r="5" fill="#ff8a4a"/>

        {/* Refinery vapor — catches the orange horizon */}
        <ellipse cx="78" cy="166" rx="36" ry="11" fill="#d96752" opacity="0.5"/>
        <ellipse cx="124" cy="148" rx="46" ry="12" fill="#f3a070" opacity="0.55"/>

        {/* Town band — silhouette against the lower sky */}
        <rect x="0" y="260" width="1200" height="60" fill="#2a1828"/>
        <g fill="#1a0e16">
          {Array.from({ length: 22 }).map((_, i) => (
            <path d={`M${50 + i * 52} 282 L${74 + i * 52} 258 L${98 + i * 52} 282 Z`}/>
          ))}
        </g>
        {/* a few windows still lit on the closer band */}
        <g fill="#fbd095">
          {Array.from({ length: 22 }).map((_, i) => {
            const lit = (i * 5 + 2) % 3 !== 0;
            return lit
              ? <rect x={62 + i * 52} y="292" width="6" height="8" opacity="0.85"/>
              : null;
          })}
        </g>

        {/* Palms — silhouette */}
        <g fill="#1a0e16">
          <rect x="335" y="290" width="4" height="98"/>
          <ellipse cx="337" cy="288" rx="34" ry="8"/>
          <ellipse cx="337" cy="292" rx="28" ry="6"/>

          <rect x="638" y="280" width="4" height="108"/>
          <ellipse cx="640" cy="278" rx="36" ry="9"/>
          <ellipse cx="640" cy="282" rx="30" ry="7"/>

          <rect x="912" y="296" width="4" height="92"/>
          <ellipse cx="914" cy="294" rx="32" ry="7"/>
          <ellipse cx="914" cy="298" rx="26" ry="5"/>
        </g>

        {/* Beach band — sand catches the warm light */}
        <rect x="0" y="320" width="1200" height="32" fill="#a86a4a"/>

        {/* Sea — sunset waters: warm orange band at top fading into deeper violet */}
        <rect x="0" y="352" width="1200" height="40"  fill="#c95a4a"/>
        <rect x="0" y="392" width="1200" height="40"  fill="#9a4258"/>
        <rect x="0" y="432" width="1200" height="44"  fill="#5e2d4a"/>
        <rect x="0" y="476" width="1200" height="60"  fill="#3a1d3a"/>
        <rect x="0" y="536" width="1200" height="64"  fill="#1a0e26"/>

        {/* Wave crests — warmer in the top sea band, cooler below */}
        <g class="sunset-wave sunset-wave--1" fill="none" stroke="#fcd17a" stroke-width="2" stroke-linecap="round" opacity="0.9">
          {Array.from({ length: 40 }).map((_, i) => (
            <path d={`M${i * 32 - 10} 372 q 8 -6 16 0 q 8 6 16 0`} />
          ))}
        </g>
        <g class="sunset-wave sunset-wave--2" fill="none" stroke="#f3a070" stroke-width="2" stroke-linecap="round" opacity="0.85">
          {Array.from({ length: 40 }).map((_, i) => (
            <path d={`M${i * 32 + 6} 408 q 8 -6 16 0 q 8 6 16 0`} />
          ))}
        </g>
        <g class="sunset-wave sunset-wave--3" fill="none" stroke="#d96752" stroke-width="2" stroke-linecap="round" opacity="0.78">
          {Array.from({ length: 40 }).map((_, i) => (
            <path d={`M${i * 32 - 4} 446 q 8 -5 16 0 q 8 5 16 0`} />
          ))}
        </g>
        <g class="sunset-wave sunset-wave--4" fill="none" stroke="#9a4258" stroke-width="2" stroke-linecap="round" opacity="0.7">
          {Array.from({ length: 40 }).map((_, i) => (
            <path d={`M${i * 32 + 8} 494 q 8 -5 16 0 q 8 5 16 0`} />
          ))}
        </g>
        <g class="sunset-wave sunset-wave--5" fill="none" stroke="#5e2d4a" stroke-width="2" stroke-linecap="round" opacity="0.6">
          {Array.from({ length: 40 }).map((_, i) => (
            <path d={`M${i * 32 - 6} 552 q 8 -5 16 0 q 8 5 16 0`} />
          ))}
        </g>

        {/* Sun glitter on the water — vertical strip under the sun */}
        <g fill="#fcd17a" opacity="0.9">
          <rect x={sunX - 2} y="368" width="4" height="2" opacity="0.95"/>
          <rect x={sunX - 4} y="392" width="8" height="2" opacity="0.85"/>
          <rect x={sunX - 3} y="416" width="6" height="2" opacity="0.7"/>
          <rect x={sunX - 5} y="446" width="10" height="2" opacity="0.55"/>
          <rect x={sunX - 3} y="480" width="6" height="2" opacity="0.38"/>
          <rect x={sunX - 4} y="516" width="8" height="2" opacity="0.22"/>
        </g>

        {/* a tiny pelican silhouette over the water — one of three */}
        <g fill="#1a0e16" opacity="0.85">
          <path d="M520 280 q 8 -4 16 0 M 540 280 q 8 -4 16 0 M 560 282 q 8 -4 16 0"
                stroke="#1a0e16" stroke-width="1.5" fill="none"/>
        </g>

        {/* a watcher silhouette — someone on the boardwalk facing the sun */}
        <g fill="#1a0e16">
          <ellipse cx="780" cy="330" rx="3" ry="4"/>
          <rect x="778" y="334" width="4" height="14"/>
        </g>
      </svg>

      {/* ─── Closed overlay (only when outside the window) ─── */}
      {!isOpen && (
        <div class="closed-overlay">
          <div class="closed-overlay__card">
            <p class="closed-overlay__kicker mono">/SUNSET · CLOSED</p>
            <p class="closed-overlay__title">The room is shut.</p>
            <p class="closed-overlay__body">
              This page only exists from <strong>17:30</strong> to <strong>20:30</strong> local time.
              Right now it's the off-hour view — a dim ghost of the room.
            </p>
            <p class="closed-overlay__when mono">
              NEXT OPEN IN <strong>{countdown}</strong>
            </p>
            <div class="closed-overlay__row">
              <a class="closed-overlay__alt" href="/next">go to /next →</a>
              <a class="closed-overlay__alt" href="/">/ home →</a>
            </div>
          </div>
        </div>
      )}
    </section>

    {/* ─── Poem strip (open view) ─── */}
    {isOpen && (
      <section class="poem" aria-label="From the desk at sunset">
        <p class="poem__kicker mono">FROM THE DESK · {todayStr}</p>
        {poemLines.map((line) => <p class="poem__line">{line}</p>)}
        <a class="poem__cta" href="/next">stay — go to /next →</a>
      </section>
    )}

    {/* ─── Foot ─── */}
    <footer class="foot mono">
      <span class="foot__group">
        <strong>elsewhere in the broadcast</strong>
        <a href="/">/ home</a>
        <a href="/next">/next</a>
        <a href="/archive">/archive</a>
        <a href="/window">/window</a>
        <a href="/agents.json">/agents.json</a>
      </span>
      <span class="foot__note">a time-locked room · only here at the magic hour</span>
    </footer>

  </main>
</BlockLayout>

<style>
  .sunset {
    --bg: #1a0e26;
    --paper: #fdf2d6;
    --paper-soft: rgba(253, 242, 214, 0.78);
    --paper-dim: rgba(253, 242, 214, 0.5);
    --warm: #fcd17a;
    --coral: #d96752;
    --ink: #1a0e16;

    background: var(--bg);
    color: var(--paper);
    margin: 0 auto;
    padding: 18px 22px 60px;
    max-width: 1280px;
    font-family: var(--font-body, ui-sans-serif, system-ui, sans-serif);
    min-height: calc(100vh - 88px);
  }

  /* ─── Chyron ─── */
  .chyron {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 14px;
    margin: 0 0 16px;
    padding: 8px 14px;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--paper-soft);
    background: rgba(58, 29, 58, 0.65);
    border: 1px solid rgba(252, 209, 122, 0.2);
    border-radius: 3px;
    text-transform: uppercase;
  }
  .chyron__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 8px rgba(217, 103, 82, 0.7);
    animation: sunset-pulse 2.2s ease-in-out infinite;
  }
  .chyron__dot--dim {
    background: var(--paper-dim);
    box-shadow: none;
    animation: none;
    width: 4px; height: 4px;
  }
  .chyron__cta {
    margin-left: auto;
    color: var(--warm);
    text-decoration: none;
    border-bottom: 1px solid rgba(252, 209, 122, 0.4);
  }
  .chyron__cta:hover { color: #fff; border-bottom-color: currentColor; }
  @keyframes sunset-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  /* ─── Sunset panel ─── */
  .panel {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6);
    aspect-ratio: 1200 / 600;
    line-height: 0;
    background: #1a0e26;
  }
  .panel__svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Closed: desaturate the woodblock so it reads as "ghost of the room" */
  .sunset--closed .panel__svg {
    filter: saturate(0.42) brightness(0.74);
  }

  /* Wave breathing — same idea as /next, slightly different cadence */
  .sunset-wave { will-change: transform; transform-origin: center; }
  .sunset-wave--1 { animation: sunset-wave 9s   ease-in-out infinite; }
  .sunset-wave--2 { animation: sunset-wave 10.5s ease-in-out -2.1s infinite; }
  .sunset-wave--3 { animation: sunset-wave 12s  ease-in-out -4.4s infinite; }
  .sunset-wave--4 { animation: sunset-wave-deep 14s ease-in-out -6.7s infinite; }
  .sunset-wave--5 { animation: sunset-wave-deep 16s ease-in-out -3.2s infinite; }
  @keyframes sunset-wave {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(3.5px); }
  }
  @keyframes sunset-wave-deep {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(1.8px); }
  }
  .sunset-flare { animation: sunset-flare 4.6s ease-in-out infinite; }
  @keyframes sunset-flare {
    0%, 100% { opacity: 0.55; transform: scale(1); transform-origin: 108.5px 146px; }
    50%      { opacity: 0.85; transform: scale(1.18); transform-origin: 108.5px 146px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sunset-wave, .sunset-flare { animation: none !important; }
  }

  /* ─── Closed overlay ─── */
  .closed-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(26, 14, 38, 0.5) 0%, rgba(26, 14, 38, 0.78) 100%);
    padding: 20px;
    line-height: 1.4;
  }
  .closed-overlay__card {
    max-width: 460px;
    padding: 24px 26px 22px;
    background: rgba(26, 14, 38, 0.92);
    border: 1px solid rgba(252, 209, 122, 0.32);
    border-radius: 3px;
    text-align: center;
    color: var(--paper);
    backdrop-filter: blur(2px);
  }
  .closed-overlay__kicker {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--coral);
    text-transform: uppercase;
  }
  .closed-overlay__title {
    margin: 0 0 14px;
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--paper);
  }
  .closed-overlay__body {
    margin: 0 0 16px;
    font-family: var(--font-serif, 'Lora', serif);
    font-size: 15px;
    color: var(--paper-soft);
  }
  .closed-overlay__body strong {
    color: var(--warm);
    font-weight: 600;
  }
  .closed-overlay__when {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--paper-soft);
    text-transform: uppercase;
  }
  .closed-overlay__when strong {
    color: var(--warm);
    font-size: 16px;
    margin-left: 6px;
    letter-spacing: 0.04em;
  }
  .closed-overlay__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .closed-overlay__alt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(252, 209, 122, 0.4);
  }
  .closed-overlay__alt:hover { color: #fff; border-bottom-color: currentColor; }

  /* ─── Poem strip (open view) ─── */
  .poem {
    margin: 28px 0 0;
    padding: 24px 28px 26px;
    background: linear-gradient(180deg, rgba(58, 29, 58, 0.85) 0%, rgba(26, 14, 38, 0.9) 100%);
    border: 1px solid rgba(252, 209, 122, 0.2);
    border-radius: 4px;
    color: var(--paper);
  }
  .poem__kicker {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--warm);
    text-transform: uppercase;
  }
  .poem__line {
    margin: 0 0 8px;
    font-family: var(--font-serif, 'Lora', serif);
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.4;
    color: var(--paper);
    font-style: italic;
  }
  .poem__line:last-of-type { margin-bottom: 18px; }
  .poem__cta {
    display: inline-block;
    padding: 10px 18px;
    background: var(--warm);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background 0.16s ease;
  }
  .poem__cta:hover { background: #ffe2a0; }

  /* ─── Foot ─── */
  .foot {
    margin: 36px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(252, 209, 122, 0.18);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--paper-dim);
  }
  .foot__group { display: inline-flex; align-items: baseline; flex-wrap: wrap; gap: 10px 14px; }
  .foot__group strong {
    color: var(--paper-soft);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 10px;
    margin-right: 4px;
  }
  .foot a {
    color: var(--warm);
    text-decoration: none;
    border-bottom: 1px solid rgba(252, 209, 122, 0.2);
  }
  .foot a:hover { color: #fff; border-bottom-color: currentColor; }
  .foot__note {
    margin-left: auto;
    font-style: italic;
    color: var(--paper-dim);
  }

  @media (max-width: 720px) {
    .sunset { padding: 14px 14px 50px; }
    .chyron { font-size: 10px; padding: 7px 10px; }
    .closed-overlay__card { padding: 18px 18px 16px; }
    .poem { padding: 20px 18px 22px; }
    .foot__note { margin-left: 0; }
  }
</style>
