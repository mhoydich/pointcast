---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();

// Eight Noun music artists, each a "trading card." Data hand-curated from
// the /cast-real and /cast-studio catalogs.
const CARDS = [
  {
    id: 313,
    name: 'Marine Layer',
    title: 'The Patience Kit',
    color: '#9ed6f0',
    rarity: 'COMMON',
    rarityHex: '#bdbdbd',
    bpm: '60-80',
    mood: 'chill',
    kit: 'Soft kick · Brush snare · Choir pad',
    realInstrument: 'Electric piano + choir pad + acoustic bass',
    quote: 'Born of fog and morning quiet.',
    sigTrack: 'Morning Fog',
    sigSecondTrack: 'Foghorn Letter',
    bio: 'When the gulls have not woken and the sailboat is not painted. The patience kit. 60-80 BPM. Soft kick, brush snare, distant bell.',
    powerStat: { label: 'PATIENCE', val: 95 },
  },
  {
    id: 523,
    name: 'Block Runner',
    title: 'The Sidewalk-Stepper',
    color: '#a8ff3a',
    rarity: 'UNCOMMON',
    rarityHex: '#a8ff3a',
    bpm: '100-120',
    mood: 'driving',
    kit: 'Punchy kick + sub · Square lead',
    realInstrument: 'Synth charang + synth brass + synth bass',
    quote: 'Block Runner finishes first.',
    sigTrack: 'Block Runner Funk',
    sigSecondTrack: 'Sidewalk Claps',
    bio: 'Aggressive 16ths, sidewalk-stepper. 100-120 BPM. Always one beat ahead. Sneakers on Grand, sneakers on Main.',
    powerStat: { label: 'DRIVE', val: 92 },
  },
  {
    id: 1042,
    name: 'Release Train',
    title: 'The Five-O-Nine',
    color: '#ffd400',
    rarity: 'UNCOMMON',
    rarityHex: '#ffd400',
    bpm: '78-102',
    mood: 'driving · cinema',
    kit: 'Tight kick · Tonal snare · Bright lead',
    realInstrument: 'Grand piano + grand piano + acoustic bass',
    quote: 'Boarding now.',
    sigTrack: 'Sunrise on Imperial',
    sigSecondTrack: 'The Promise',
    bio: 'The reliable 100 BPM cousin. Bright lead lines, steady pad. Five o nine the train is here, five o nine the sun is here.',
    powerStat: { label: 'RELIABILITY', val: 88 },
  },
  {
    id: 1189,
    name: 'Night Broadcast',
    title: 'The After-Hours Dial',
    color: '#6f59c0',
    rarity: 'RARE',
    rarityHex: '#6f59c0',
    bpm: '60-72',
    mood: 'meditative · cinema',
    kit: 'Half-time kick · Held pad · Bell',
    realInstrument: 'Sweep pad + choir pad + synth bass 2',
    quote: 'The dial-tone of late thinking.',
    sigTrack: 'El Segundo at Dusk',
    sigSecondTrack: 'Late Station',
    bio: 'After hours, after lights. 60-72 BPM ambient pad, bell every fourth bar. Three a m radio. Someone is awake somewhere.',
    powerStat: { label: 'STILLNESS', val: 90 },
  },
  {
    id: 287,
    name: 'Brass on Main',
    title: 'The Honest Pickup',
    color: '#f6c15e',
    rarity: 'RARE',
    rarityHex: '#f6c15e',
    bpm: '84-88',
    mood: 'playful · orchestral',
    kit: 'Parade kick · Snare · Sawtooth horn',
    realInstrument: 'Real trumpet + grand piano + tuba',
    quote: 'Small parade · no permit · no problem.',
    sigTrack: 'Brass on Main',
    sigSecondTrack: 'Parade Detour',
    bio: 'Old man, brass kit, small parade. 84 BPM. Honest pickup. Plays El Segundo summer evenings without invitation.',
    powerStat: { label: 'WARMTH', val: 91 },
  },
  {
    id: 742,
    name: 'Main Street',
    title: 'The Pink Awning',
    color: '#e8b3c0',
    rarity: 'COMMON',
    rarityHex: '#bdbdbd',
    bpm: '88-92',
    mood: 'chill · jazz',
    kit: 'Soft kick · Brush snare · Walking bass',
    realInstrument: 'Vibraphone + Rhodes + electric bass',
    quote: 'Pink awning at three.',
    sigTrack: 'Boba & Cassette',
    sigSecondTrack: 'Pink Awning',
    bio: 'The Noun named after a place. Postcards — pink awnings, cassettes, after-school. 88-92 BPM. Soft kick, brush snare.',
    powerStat: { label: 'NOSTALGIA', val: 87 },
  },
  {
    id: 612,
    name: 'Friday Five',
    title: 'When Meters Stop',
    color: '#ff5f7a',
    rarity: 'RARE',
    rarityHex: '#ff5f7a',
    bpm: '124-132',
    mood: 'rush · dance',
    kit: 'Loud kit · Square bell · Sub bass',
    realInstrument: 'Sawtooth lead + synth brass + synth bass',
    quote: 'Nothing subtle. Dance.',
    sigTrack: 'Friday at Five',
    sigSecondTrack: 'Parking Meter Runs',
    bio: 'When the parking meters stop. Loud kit. 124 BPM. Square bell. The bartender said yes, the kitchen said yes.',
    powerStat: { label: 'LOUDNESS', val: 96 },
  },
  {
    id: 928,
    name: 'Aurora Slow',
    title: 'The Healing Room',
    color: '#7d9a7c',
    rarity: 'LEGENDARY',
    rarityHex: '#f6c15e',
    bpm: '56-60',
    mood: 'meditative · ambient',
    kit: 'No drums · Held pads · Bell',
    realInstrument: 'Real flute + choir pad + acoustic bass',
    quote: 'Tide comes slow.',
    sigTrack: 'Aurora Slow',
    sigSecondTrack: 'Tide Comes In',
    bio: 'Tides come slow. 56 BPM, held pads, occasional chime. Healing-room kit. Kelp on the shore, gull at five a m.',
    powerStat: { label: 'STILLNESS', val: 99 },
  },
];
---
<BlockLayout title="Cast Deck — eight Noun music artist trading cards" description="A printable deck of trading cards for the eight Noun music artists of pointcast.xyz. Each card has the artist's kit, signature tracks, BPM range, and one stat. Print landscape or screenshot to share.">
  <main class="cd" id="cd" data-built={built}>
    <header class="cd__hero">
      <p class="cd__kicker">CAST · DECK · eight artists, eight cards</p>
      <h1 class="cd__title">The roster.</h1>
      <p class="cd__sub">Every Noun music artist on the site, as a trading card. Each one has their own kit, their own tempo range, their own mood. Hold them up. Stack them. Print the deck (Cmd+P → landscape).</p>
    </header>

    <section class="cd__grid">
      {CARDS.map(c => (
        <article class={`cd__card cd__card--${c.rarity.toLowerCase()}`} style={`--card-c: ${c.color}; --rarity-c: ${c.rarityHex};`}>
          <header class="cd__card-top">
            <p class="cd__card-rarity">{c.rarity}</p>
            <p class="cd__card-bpm">{c.bpm} bpm</p>
          </header>

          <div class="cd__card-portrait">
            <div class="cd__card-portrait-frame">
              <img src={`https://noun.pics/${c.id}.svg`} alt={`Noun ${c.id}`} loading="lazy"/>
            </div>
          </div>

          <div class="cd__card-body">
            <p class="cd__card-name">{c.name}</p>
            <p class="cd__card-title">{c.title}</p>
            <p class="cd__card-quote">"{c.quote}"</p>

            <dl class="cd__card-stats">
              <dt>MOOD</dt><dd>{c.mood}</dd>
              <dt>KIT</dt><dd>{c.kit}</dd>
              <dt>REAL</dt><dd>{c.realInstrument}</dd>
            </dl>

            <p class="cd__card-tracks">
              <span class="cd__card-track">▶ {c.sigTrack}</span><br/>
              <span class="cd__card-track">▶ {c.sigSecondTrack}</span>
            </p>

            <p class="cd__card-bio">{c.bio}</p>
          </div>

          <footer class="cd__card-foot">
            <div class="cd__card-power">
              <p class="cd__card-power-label">{c.powerStat.label}</p>
              <div class="cd__card-power-bar"><div class="cd__card-power-fill" style={`width: ${c.powerStat.val}%;`}></div></div>
              <p class="cd__card-power-val">{c.powerStat.val}</p>
            </div>
            <p class="cd__card-id">NOUN #{c.id}</p>
          </footer>
        </article>
      ))}
    </section>

    <section class="cd__legend">
      <p class="cd__legend-label">RARITY</p>
      <div class="cd__legend-row">
        <span class="cd__legend-pip" style="--p: #bdbdbd"></span> COMMON · 2 cards
        <span class="cd__legend-pip" style="--p: #a8ff3a"></span> UNCOMMON · 2 cards
        <span class="cd__legend-pip" style="--p: #6f59c0"></span> RARE · 3 cards
        <span class="cd__legend-pip" style="--p: #f6c15e"></span> LEGENDARY · 1 card
      </div>
    </section>

    <footer class="cd__foot">
      <p>Cast Deck · {built.slice(0,10)} · all 8 Noun music artists from pointcast.xyz</p>
      <p>Tracks live at <a href="/cast-music-pro">/cast-music-pro</a> · <a href="/cast-real">/cast-real</a> · <a href="/cast-on">/cast-on</a>. Compose your own at <a href="/cast-make">/cast-make</a> or <a href="/cast-make-pro">/cast-make-pro</a>. <a href="/town-music">Map the landscape</a> · <a href="/">PointCast home</a>.</p>
      <p class="cd__foot-credit">Print landscape A3/letter or screenshot a single card to share. Nouns are CC0.</p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cd-bg: #0a0610;
    --cd-velvet: #1a0820;
    --cd-walnut: #5a3422;
    --cd-flame: #f6c15e;
    --cd-cream: #f4e7c8;
    --cd-line: rgba(244,231,200,0.10);
    --cd-text: #f4e7c8;
    --cd-text-mute: rgba(244,231,200,0.62);
    --cd-text-quiet: rgba(244,231,200,0.38);
    --cd-display: 'Inter Tight', system-ui, sans-serif;
    --cd-body: 'Inter', system-ui, sans-serif;
    --cd-mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  body { background: var(--cd-bg); color: var(--cd-text); font-family: var(--cd-body); }

  .cd { max-width: 1120px; margin: 0 auto; padding: 36px 22px 60px 22px; }

  /* HERO */
  .cd__hero { margin-bottom: 32px; }
  .cd__kicker { font-family: var(--cd-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--cd-flame); text-transform: uppercase; margin: 0 0 14px 0; }
  .cd__title {
    font-family: var(--cd-display); font-weight: 900;
    font-size: clamp(40px, 6.5vw, 72px);
    line-height: 0.94; letter-spacing: -0.025em;
    margin: 0 0 14px 0;
    background: linear-gradient(180deg, var(--cd-cream), var(--cd-flame));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .cd__sub { font-family: var(--cd-body); font-size: 15px; line-height: 1.55; color: var(--cd-text-mute); max-width: 680px; margin: 0; }

  /* GRID */
  .cd__grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    margin-bottom: 36px;
  }
  @media (max-width: 980px) { .cd__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cd__grid { grid-template-columns: 1fr; } }

  /* CARD */
  .cd__card {
    position: relative;
    background:
      linear-gradient(135deg, rgba(244,231,200,0.04), rgba(244,231,200,0.01)),
      linear-gradient(180deg, color-mix(in srgb, var(--card-c) 14%, var(--cd-velvet)) 0%, var(--cd-velvet) 100%);
    border: 2px solid var(--rarity-c, var(--cd-walnut));
    border-radius: 14px;
    padding: 14px 14px 12px 14px;
    display: flex; flex-direction: column;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0,0,0,0.40);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .cd__card:hover { transform: translateY(-4px); box-shadow: 0 10px 32px rgba(0,0,0,0.55); }

  /* Holographic shimmer for legendary */
  .cd__card--legendary {
    background:
      linear-gradient(135deg, rgba(246,193,94,0.10), rgba(168,255,58,0.04) 50%, rgba(110,89,192,0.10)),
      linear-gradient(180deg, color-mix(in srgb, var(--card-c) 14%, var(--cd-velvet)) 0%, var(--cd-velvet) 100%);
    box-shadow: 0 0 0 1px rgba(246,193,94,0.25), 0 8px 32px rgba(246,193,94,0.18), 0 6px 24px rgba(0,0,0,0.40);
  }
  .cd__card--legendary::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at 20% 10%, rgba(246,193,94,0.18) 0%, transparent 50%);
  }

  /* TOP STRIP */
  .cd__card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px dashed rgba(244,231,200,0.10); }
  .cd__card-rarity {
    font-family: var(--cd-mono); font-size: 9px;
    letter-spacing: 0.7px; color: var(--rarity-c, var(--cd-text));
    text-transform: uppercase; margin: 0;
    padding: 2px 7px; border: 1px solid var(--rarity-c, var(--cd-line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--rarity-c, var(--cd-velvet)) 16%, transparent);
  }
  .cd__card-bpm { font-family: var(--cd-mono); font-size: 11px; color: var(--cd-text-mute); margin: 0; letter-spacing: 0.3px; }

  /* PORTRAIT */
  .cd__card-portrait {
    margin: 0 -4px 12px -4px;
    aspect-ratio: 1.3;
    background:
      radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--card-c) 30%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--card-c) 22%, var(--cd-velvet)), var(--cd-velvet));
    border-radius: 10px;
    display: grid; place-items: center;
    border: 1px solid rgba(244,231,200,0.10);
  }
  .cd__card-portrait-frame { width: 70%; max-width: 130px; }
  .cd__card-portrait-frame img { width: 100%; image-rendering: pixelated; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5)); }

  /* BODY */
  .cd__card-body { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .cd__card-name {
    font-family: var(--cd-display); font-weight: 800;
    font-size: 19px; letter-spacing: -0.015em; line-height: 1.15;
    margin: 0; color: var(--cd-text);
  }
  .cd__card-title {
    font-family: var(--cd-body); font-size: 12px; font-style: italic;
    color: var(--card-c); margin: 0; letter-spacing: 0.1px;
  }
  .cd__card-quote {
    font-family: var(--cd-display); font-weight: 500;
    font-size: 13.5px; font-style: italic; line-height: 1.4;
    color: var(--cd-cream); margin: 4px 0 2px 0;
    padding-left: 8px; border-left: 2px solid var(--card-c);
  }
  .cd__card-stats {
    display: grid; grid-template-columns: 38px 1fr; gap: 4px 8px;
    margin: 6px 0 4px 0; padding: 6px 0;
    border-top: 1px dashed rgba(244,231,200,0.08);
    border-bottom: 1px dashed rgba(244,231,200,0.08);
  }
  .cd__card-stats dt {
    font-family: var(--cd-mono); font-size: 8.5px; color: var(--cd-text-quiet);
    letter-spacing: 0.6px; text-transform: uppercase; padding-top: 2px;
  }
  .cd__card-stats dd {
    font-family: var(--cd-body); font-size: 11px; line-height: 1.35;
    color: var(--cd-text-mute); margin: 0;
  }
  .cd__card-tracks {
    font-family: var(--cd-mono); font-size: 11px; line-height: 1.55;
    color: var(--cd-flame); margin: 4px 0; letter-spacing: 0.1px;
  }
  .cd__card-track { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; max-width: 100%; }
  .cd__card-bio {
    font-family: var(--cd-body); font-size: 11.5px; line-height: 1.5;
    color: var(--cd-text-quiet); margin: 2px 0 0 0;
  }

  /* FOOT */
  .cd__card-foot { margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(244,231,200,0.10); }
  .cd__card-power { display: grid; grid-template-columns: 80px 1fr 32px; gap: 8px; align-items: center; margin-bottom: 6px; }
  .cd__card-power-label { font-family: var(--cd-mono); font-size: 9px; letter-spacing: 0.5px; color: var(--cd-text-quiet); text-transform: uppercase; margin: 0; }
  .cd__card-power-bar { height: 4px; background: rgba(244,231,200,0.08); border-radius: 2px; overflow: hidden; }
  .cd__card-power-fill { height: 100%; background: linear-gradient(90deg, var(--card-c), var(--cd-flame)); border-radius: 2px; }
  .cd__card-power-val { font-family: var(--cd-display); font-weight: 700; font-size: 13px; color: var(--cd-text); margin: 0; text-align: right; letter-spacing: -0.01em; }
  .cd__card-id { font-family: var(--cd-mono); font-size: 9px; color: var(--cd-text-quiet); margin: 0; letter-spacing: 0.5px; text-align: center; }

  /* LEGEND */
  .cd__legend { padding: 18px 22px; background: rgba(244,231,200,0.03); border: 1px solid var(--cd-line); border-radius: 10px; margin-bottom: 22px; }
  .cd__legend-label { font-family: var(--cd-mono); font-size: 10px; letter-spacing: 0.6px; color: var(--cd-flame); margin: 0 0 8px 0; text-transform: uppercase; }
  .cd__legend-row { font-family: var(--cd-mono); font-size: 11px; color: var(--cd-text-mute); display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
  .cd__legend-pip { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--p, var(--cd-walnut)); margin-right: 4px; vertical-align: middle; }

  /* FOOT */
  .cd__foot {
    padding-top: 24px; border-top: 1px solid var(--cd-line);
    margin-top: 18px;
    font-family: var(--cd-mono); font-size: 11px;
    color: var(--cd-text-quiet); line-height: 1.7; text-align: center;
  }
  .cd__foot a { color: var(--cd-flame); text-decoration: none; }
  .cd__foot a:hover { text-decoration: underline; }
  .cd__foot-credit { margin-top: 10px; font-size: 10.5px; }

  /* PRINT */
  @media print {
    body { background: #fff; color: #000; }
    .cd { padding: 0; max-width: none; }
    .cd__title { -webkit-text-fill-color: #000; background: none; color: #000; }
    .cd__kicker, .cd__sub { color: #444; }
    .cd__kicker { color: #b97f00; }
    .cd__grid { grid-template-columns: repeat(4, 1fr); page-break-inside: avoid; }
    .cd__card { background: #fff; border-color: #aaa; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .cd__card-name, .cd__card-quote, .cd__card-power-val { color: #000; }
    .cd__card-stats dd, .cd__card-bio, .cd__card-bpm { color: #444; }
    .cd__card-tracks { color: #b97f00; }
    .cd__card-portrait { background: #f8f5ed; }
    .cd__legend, .cd__foot { background: none; }
    .cd__legend-label { color: #b97f00; }
    .cd__legend-row, .cd__foot { color: #555; }
    .cd__foot a { color: #b97f00; }
  }
</style>
</BlockLayout>
