---
import BlockLayout from '../layouts/BlockLayout.astro';
import threshold from '../assets/shrines/open-road-v7/01-dawn-threshold.webp';
import firstFace from '../assets/shrines/open-road-v7/02-dawn-face.webp';
import opening from '../assets/shrines/open-road-v7/03-dawn-leaves.webp';
import attention from '../assets/shrines/open-road-v7/04-dawn-blue-eyes.webp';
import standing from '../assets/shrines/open-road-v7/05-day-standing.webp';
import garden from '../assets/shrines/open-road-v7/06-day-garden.webp';
import turning from '../assets/shrines/open-road-v7/07-day-berries.webp';
import fullness from '../assets/shrines/open-road-v7/08-day-flowers.webp';
import homeward from '../assets/shrines/open-road-v7/09-dusk-landscape.webp';
import vessels from '../assets/shrines/open-road-v7/10-dusk-vessels.webp';
import rest from '../assets/shrines/open-road-v7/11-dusk-rest.webp';
import afterglow from '../assets/shrines/open-road-v7/12-dusk-thicket.webp';
import halfShadow from '../assets/shrines/open-road-v7/13-night-half-shadow.webp';
import turningIn from '../assets/shrines/open-road-v7/14-night-turning-in.webp';
import keepingWatch from '../assets/shrines/open-road-v7/15-night-watch.webp';
import presence from '../assets/shrines/open-road-v7/16-night-presence.webp';
import socialCard from '../assets/shrines/open-road-v7/open-road-v7-og.jpg';

const title = 'Open Road VIII · The Long Way Home';
const description =
  'An eight-mile passage through changing light. Walk at your own pace, listen for the road, and arrive somewhere slightly different.';

const miles = [
  {
    number: '01',
    name: 'Departure',
    bearing: 'West by morning',
    line: 'The road begins before the map agrees.',
    note: 'Leave one certainty at the gate.',
    color: '#d97762',
    glow: '#ffd09a',
    images: [
      { src: threshold, alt: 'A small white cat waits on a coral threshold below a stippled blue field.' },
      { src: firstFace, alt: 'A pale cat faces forward against a quiet blue field.' },
    ],
  },
  {
    number: '02',
    name: 'Verge',
    bearing: 'Where the leaves begin',
    line: 'Keep one thing unnamed.',
    note: 'The edge is part of the way.',
    color: '#b86758',
    glow: '#eabf8f',
    images: [
      { src: opening, alt: 'A pale cat appears between broad dark-blue leaves.' },
      { src: attention, alt: 'A white cat with blue eyes sits beside a dark floral pattern.' },
    ],
  },
  {
    number: '03',
    name: 'Company',
    bearing: 'Two shadows, one road',
    line: 'What walks beside you does not need explaining.',
    note: 'Make room without making a claim.',
    color: '#8f5660',
    glow: '#f3b895',
    images: [
      { src: standing, alt: 'A pale cat stands against a dense blue floral field.' },
      { src: garden, alt: 'A pale cat looks out from layered blue and cream leaves.' },
    ],
  },
  {
    number: '04',
    name: 'Distance',
    bearing: 'The field opens',
    line: 'The far country enters at the speed of looking.',
    note: 'Nothing beautiful needs to be captured.',
    color: '#62516b',
    glow: '#d6a982',
    images: [
      { src: turning, alt: 'A pale cat turns beside blue stems and red berries.' },
      { src: fullness, alt: 'A white cat rests among large blue and coral flowers.' },
    ],
  },
  {
    number: '05',
    name: 'Weather',
    bearing: 'Clouds from the south',
    line: 'Let the sky revise the plan.',
    note: 'A changed road is still a road.',
    color: '#364d6b',
    glow: '#d99070',
    images: [
      { src: homeward, alt: 'A white cat stands in a dark landscape of coral grasses.' },
      { src: vessels, alt: 'A black-and-white cat sits between patterned vessels and plants.' },
    ],
  },
  {
    number: '06',
    name: 'The Bend',
    bearing: 'Out of sight, not gone',
    line: 'The bend keeps part of the world in reserve.',
    note: 'Continue without requiring proof.',
    color: '#263d5b',
    glow: '#c47b6a',
    images: [
      { src: rest, alt: 'A cream cat reclines beneath dark blue trees.' },
      { src: afterglow, alt: 'A peach-toned cat waits beside a blue botanical thicket.' },
    ],
  },
  {
    number: '07',
    name: 'Nearness',
    bearing: 'One lamp ahead',
    line: 'Home is sometimes the light that recognizes you.',
    note: 'Let yourself be expected.',
    color: '#142e4b',
    glow: '#c36c5e',
    images: [
      { src: halfShadow, alt: 'A pale cat with a dark facial patch appears against botanical panels.' },
      { src: turningIn, alt: 'A black-and-white cat lowers its head before blue branches.' },
    ],
  },
  {
    number: '08',
    name: 'Arrival',
    bearing: 'The light left on',
    line: 'You have not returned unchanged.',
    note: 'Enter quietly. Bring the whole road in.',
    color: '#071c2f',
    glow: '#e57d67',
    images: [
      { src: keepingWatch, alt: 'A black cat keeps watch from dense blue and coral foliage.' },
      { src: presence, alt: 'A black cat faces forward among pale blue leaves and coral flowers.' },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v8',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={socialCard.src}
  imageWidth={1600}
  imageHeight={900}
  themeColor="#071c2f"
  immersive
  jsonLd={jsonLd}
>
  <section
    class="or8"
    id="open-road-v8"
    aria-labelledby="or8-title"
    style={`--sky:${miles[0].color};--glow:${miles[0].glow};--mile-progress:0`}
    data-mile="0"
    data-walking="false"
  >
    <div class="or8__weather" aria-hidden="true">
      <span class="or8__sun"></span>
      <span class="or8__horizon"></span>
      <span class="or8__grain"></span>
    </div>

    <nav class="or8__editions" aria-label="Open Road editions">
      <a class="or8__home" href="/" aria-label="Return to PointCast home">← PointCast</a>
      <span aria-hidden="true">/</span>
      <a href="/open-road">I</a>
      <a href="/open-road-v2">II</a>
      <a href="/open-road-v3">III</a>
      <a href="/open-road-v4">IV</a>
      <a href="/open-road-v5">V</a>
      <a href="/open-road-v6">VI</a>
      <a href="/open-road-v7">VII</a>
      <span aria-current="page">VIII</span>
    </nav>

    <header class="or8__header">
      <div>
        <p class="or8__eyebrow">Open Road VIII</p>
        <h1 id="or8-title">The Long Way Home</h1>
      </div>
      <div class="or8__odometer" aria-live="polite">
        <span id="or8-distance">0.0</span>
        <small>miles from where you began</small>
      </div>
    </header>

    <main class="or8__passage">
      <div class="or8__markers" role="group" aria-label="Eight mile markers">
        {miles.map((mile, index) => (
          <button
            class:list={['or8__marker', { 'is-active': index === 0 }]}
            type="button"
            data-mile={index}
            data-color={mile.color}
            data-glow={mile.glow}
            aria-pressed={index === 0 ? 'true' : 'false'}
            aria-label={`Mile ${index + 1}: ${mile.name}`}
          >
            <span>{mile.number}</span>
            <i aria-hidden="true"></i>
            <strong>{mile.name}</strong>
          </button>
        ))}
      </div>

      <div class="or8__stage" id="or8-stage">
        <div class="or8__road" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>

        <div class="or8__frames" aria-live="polite">
          {miles.map((mile, index) => (
            <article
              class:list={['or8__mile', { 'is-active': index === 0 }]}
              data-mile-panel={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <figure class="or8__image or8__image--near">
                <img
                  src={mile.images[0].src.src}
                  width={mile.images[0].src.width}
                  height={mile.images[0].src.height}
                  alt={mile.images[0].alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>
              <figure class="or8__image or8__image--far">
                <img
                  src={mile.images[1].src.src}
                  width={mile.images[1].src.width}
                  height={mile.images[1].src.height}
                  alt={mile.images[1].alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>

              <div class="or8__copy">
                <p class="or8__bearing">Mile {mile.number} · {mile.bearing}</p>
                <h2>{mile.name}</h2>
                <p class="or8__line">{mile.line}</p>
                <p class="or8__note">{mile.note}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="or8__controls">
        <button id="or8-back" type="button" disabled aria-label="Walk back one mile">←</button>
        <button class="or8__walk" id="or8-walk" type="button" aria-pressed="false">
          <span class="or8__walk-icon" aria-hidden="true">▶</span>
          <span id="or8-walk-label">Walk the road</span>
        </button>
        <button id="or8-forward" type="button" aria-label="Walk forward one mile">→</button>
        <button class="or8__listen" id="or8-listen" type="button" aria-pressed="false">
          <span aria-hidden="true">◌</span>
          <span id="or8-listen-label">Road quiet</span>
        </button>
      </div>
    </main>

    <footer class="or8__footer">
      <p>Space to walk · arrows to step · 1—8 to choose a mile · M to listen</p>
      <p>Your place on the road stays in this browser.</p>
    </footer>

    <p class="or8__status" id="or8-status" aria-live="polite">Mile one. Departure.</p>
  </section>

  <script>
    const root = document.querySelector('#open-road-v8');
    if (root instanceof HTMLElement) {
      const markerButtons = Array.from(root.querySelectorAll('[data-mile]'));
      const panels = Array.from(root.querySelectorAll('[data-mile-panel]'));
      const back = root.querySelector('#or8-back');
      const forward = root.querySelector('#or8-forward');
      const walk = root.querySelector('#or8-walk');
      const walkLabel = root.querySelector('#or8-walk-label');
      const listen = root.querySelector('#or8-listen');
      const listenLabel = root.querySelector('#or8-listen-label');
      const distance = root.querySelector('#or8-distance');
      const status = root.querySelector('#or8-status');
      const stage = root.querySelector('#or8-stage');
      const mileNames = ['Departure', 'Verge', 'Company', 'Distance', 'Weather', 'The Bend', 'Nearness', 'Arrival'];
      const stepMs = 9000;
      let mile = 0;
      let walking = false;
      let soundOn = false;
      let startedAt = 0;
      let elapsedBeforePause = 0;
      let animationFrame = 0;
      let audioContext = null;
      let roadGain = null;
      let roadSource = null;

      try {
        const saved = Number.parseInt(localStorage.getItem('pointcast-open-road-v8-mile') || '0', 10);
        if (Number.isFinite(saved) && saved >= 0 && saved < panels.length) mile = saved;
      } catch {}

      const announce = () => {
        if (status) status.textContent = `Mile ${mile + 1}. ${mileNames[mile]}.`;
      };

      const tone = (index) => {
        if (!soundOn || !(audioContext instanceof AudioContext) || !(roadGain instanceof GainNode)) return;
        const now = audioContext.currentTime;
        const notes = [146.83, 164.81, 196, 220, 246.94, 293.66, 329.63, 392];
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();
        oscillator.type = index > 5 ? 'sine' : 'triangle';
        oscillator.frequency.setValueAtTime(notes[index] || 196, now);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.08, now + 0.12);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.8);
        oscillator.connect(gain).connect(roadGain);
        oscillator.start(now);
        oscillator.stop(now + 3);
      };

      const render = (shouldAnnounce = true) => {
        const activeMarker = markerButtons[mile];
        markerButtons.forEach((button, index) => {
          button.classList.toggle('is-active', index === mile);
          button.setAttribute('aria-pressed', index === mile ? 'true' : 'false');
        });
        panels.forEach((panel, index) => {
          panel.classList.toggle('is-active', index === mile);
          panel.setAttribute('aria-hidden', index === mile ? 'false' : 'true');
        });
        if (activeMarker instanceof HTMLElement) {
          root.style.setProperty('--sky', activeMarker.dataset.color || '#071c2f');
          root.style.setProperty('--glow', activeMarker.dataset.glow || '#e57d67');
        }
        root.dataset.mile = String(mile);
        if (distance) distance.textContent = (mile * 1.3).toFixed(1);
        if (back instanceof HTMLButtonElement) back.disabled = mile === 0;
        if (forward instanceof HTMLButtonElement) forward.disabled = mile === panels.length - 1;
        try { localStorage.setItem('pointcast-open-road-v8-mile', String(mile)); } catch {}
        if (shouldAnnounce) announce();
      };

      const stopWalking = () => {
        walking = false;
        root.dataset.walking = 'false';
        elapsedBeforePause = 0;
        if (walk instanceof HTMLButtonElement) walk.setAttribute('aria-pressed', 'false');
        if (walkLabel) walkLabel.textContent = mile === panels.length - 1 ? 'Walk it again' : 'Walk the road';
        cancelAnimationFrame(animationFrame);
        root.style.setProperty('--mile-progress', '0');
      };

      const setMile = (next, fromWalk = false) => {
        const bounded = Math.max(0, Math.min(panels.length - 1, next));
        if (bounded === mile && !fromWalk) return;
        mile = bounded;
        render();
        tone(mile);
        if (!fromWalk) stopWalking();
      };

      const tick = (now) => {
        if (!walking) return;
        const elapsed = elapsedBeforePause + now - startedAt;
        const progress = Math.min(1, elapsed / stepMs);
        root.style.setProperty('--mile-progress', String(progress));
        if (progress >= 1) {
          if (mile >= panels.length - 1) {
            stopWalking();
            return;
          }
          mile += 1;
          render();
          tone(mile);
          startedAt = now;
          elapsedBeforePause = 0;
          root.style.setProperty('--mile-progress', '0');
        }
        animationFrame = requestAnimationFrame(tick);
      };

      const toggleWalk = () => {
        if (walking) {
          elapsedBeforePause += performance.now() - startedAt;
          walking = false;
          root.dataset.walking = 'false';
          if (walk instanceof HTMLButtonElement) walk.setAttribute('aria-pressed', 'false');
          if (walkLabel) walkLabel.textContent = 'Continue walking';
          cancelAnimationFrame(animationFrame);
          return;
        }
        if (mile === panels.length - 1) {
          mile = 0;
          render();
        }
        walking = true;
        root.dataset.walking = 'true';
        startedAt = performance.now();
        if (walk instanceof HTMLButtonElement) walk.setAttribute('aria-pressed', 'true');
        if (walkLabel) walkLabel.textContent = 'Pause here';
        animationFrame = requestAnimationFrame(tick);
      };

      const startRoadSound = () => {
        if (audioContext) return;
        audioContext = new AudioContext();
        roadGain = audioContext.createGain();
        roadGain.gain.value = 0.42;
        roadGain.connect(audioContext.destination);

        const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 3, audioContext.sampleRate);
        const channel = buffer.getChannelData(0);
        let last = 0;
        for (let index = 0; index < channel.length; index += 1) {
          const white = Math.random() * 2 - 1;
          last = last * 0.985 + white * 0.015;
          channel[index] = last * 0.38;
        }
        roadSource = audioContext.createBufferSource();
        roadSource.buffer = buffer;
        roadSource.loop = true;
        const filter = audioContext.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 520;
        const bed = audioContext.createGain();
        bed.gain.value = 0.16;
        roadSource.connect(filter).connect(bed).connect(roadGain);
        roadSource.start();
      };

      const toggleSound = async () => {
        startRoadSound();
        if (!(audioContext instanceof AudioContext) || !(roadGain instanceof GainNode)) return;
        soundOn = !soundOn;
        if (audioContext.state === 'suspended') await audioContext.resume();
        const now = audioContext.currentTime;
        roadGain.gain.cancelScheduledValues(now);
        roadGain.gain.setTargetAtTime(soundOn ? 0.42 : 0.0001, now, 0.2);
        if (listen instanceof HTMLButtonElement) listen.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
        if (listenLabel) listenLabel.textContent = soundOn ? 'Road listening' : 'Road quiet';
        if (soundOn) tone(mile);
      };

      markerButtons.forEach((button, index) => button.addEventListener('click', () => setMile(index)));
      back?.addEventListener('click', () => setMile(mile - 1));
      forward?.addEventListener('click', () => setMile(mile + 1));
      walk?.addEventListener('click', toggleWalk);
      listen?.addEventListener('click', toggleSound);

      let pointerStart = 0;
      stage?.addEventListener('pointerdown', (event) => { pointerStart = event.clientX; });
      stage?.addEventListener('pointerup', (event) => {
        const distanceMoved = event.clientX - pointerStart;
        if (Math.abs(distanceMoved) > 55) setMile(mile + (distanceMoved < 0 ? 1 : -1));
      });

      document.addEventListener('keydown', (event) => {
        if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
        if (event.key === 'ArrowRight') setMile(mile + 1);
        else if (event.key === 'ArrowLeft') setMile(mile - 1);
        else if (event.key === ' ') { event.preventDefault(); toggleWalk(); }
        else if (event.key.toLowerCase() === 'm') toggleSound();
        else if (/^[1-8]$/.test(event.key)) setMile(Number(event.key) - 1);
      });

      render(false);
    }
  </script>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #071c2f;
    color: #f6eadb;
  }

  :global(.pc-block-shell:has(.or8)) {
    max-width: none;
    padding: 0;
  }

  .or8 {
    --ink: #f6eadb;
    --blue: #071c2f;
    --coral: #e57d67;
    position: relative;
    min-height: 100svh;
    padding: clamp(1rem, 2.6vw, 2.5rem);
    overflow: hidden;
    isolation: isolate;
    color: var(--ink);
    background: var(--sky);
    font-family: 'JetBrains Mono Variable', 'SFMono-Regular', Consolas, monospace;
    transition: background 1.8s cubic-bezier(.2,.7,.2,1);
  }

  .or8::after {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: '';
    background:
      linear-gradient(90deg, rgba(5, 19, 33, .36), transparent 38%, rgba(5, 19, 33, .28)),
      linear-gradient(180deg, transparent 30%, rgba(5, 18, 32, .52) 100%);
    pointer-events: none;
  }

  .or8__weather,
  .or8__weather > span {
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
  }

  .or8__sun {
    width: min(44vw, 42rem);
    height: min(44vw, 42rem);
    top: auto !important;
    right: -8vw;
    bottom: -25vw;
    left: auto !important;
    border-radius: 50%;
    opacity: .74;
    background: radial-gradient(circle, var(--glow) 0 12%, color-mix(in srgb, var(--glow), transparent 42%) 44%, transparent 72%);
    filter: blur(2px);
    transition: background 1.8s ease, transform 1.8s ease;
    transform: translateY(calc(var(--mile-progress) * -1.2rem));
  }

  .or8__horizon {
    top: 54% !important;
    opacity: .34;
    background:
      linear-gradient(164deg, transparent 0 49%, rgba(4, 16, 28, .7) 49.2% 54%, transparent 54.2%),
      linear-gradient(195deg, transparent 0 51%, rgba(4, 16, 28, .58) 51.2% 57%, transparent 57.2%);
    transform: scale(1.2);
    transform-origin: center;
  }

  .or8__grain {
    opacity: .14;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.72'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .or8__editions,
  .or8__header,
  .or8__passage,
  .or8__footer {
    position: relative;
    z-index: 2;
  }

  .or8__editions {
    display: flex;
    gap: .72rem;
    align-items: center;
    min-height: 1.5rem;
    font-size: .62rem;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .or8__editions a,
  .or8__editions span {
    color: inherit;
    opacity: .68;
    text-decoration: none;
  }

  .or8__editions a:hover,
  .or8__editions a:focus-visible,
  .or8__editions [aria-current='page'] {
    opacity: 1;
  }

  .or8__home {
    margin-right: .3rem;
  }

  .or8__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(1rem, 2.8vh, 2.25rem);
  }

  .or8__eyebrow,
  .or8__bearing,
  .or8__footer,
  .or8__note,
  .or8__odometer small {
    font-size: clamp(.57rem, .65vw, .68rem);
    letter-spacing: .14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .or8__eyebrow {
    margin: 0 0 .35rem;
    opacity: .7;
  }

  .or8__header h1 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.75rem, 3.1vw, 3.7rem);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: .95;
  }

  .or8__odometer {
    display: grid;
    grid-template-columns: auto minmax(7rem, 10rem);
    align-items: baseline;
    gap: .65rem;
    text-align: right;
  }

  .or8__odometer > span {
    min-width: 3ch;
    font-size: clamp(1.5rem, 3.2vw, 3.25rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -.08em;
  }

  .or8__odometer small {
    opacity: .62;
    text-align: left;
  }

  .or8__passage {
    display: grid;
    grid-template-columns: minmax(7.5rem, 10rem) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.2vw, 2.4rem);
    min-height: min(68vh, 48rem);
    margin-top: clamp(1.25rem, 3vh, 2.5rem);
  }

  .or8__markers {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    grid-row: 1 / span 2;
    padding: .3rem 0;
  }

  .or8__marker {
    display: grid;
    grid-template-columns: 1.7rem 1fr;
    grid-template-rows: auto auto;
    gap: .08rem .5rem;
    align-items: center;
    width: 100%;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: .44;
    transition: opacity .45s ease, transform .45s ease;
  }

