---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ADAPTOGEN_VS_NOOTROPIC, ADVANCED_TIER, HONEST_CAUTIONS_SECTION, INTERMEDIATE_TIER, NINETY_DAY_PROTOCOL, PAPER_META, PAPER_NOTES, PLANT_YEAR_COHORT, REFERENCES, SOURCING_PRINCIPLES, STARTER_TIER, THE_FRAMING } from '../lib/plantPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/plant', name: PAPER_META.title, description, url: 'https://pointcast.xyz/plant', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
const evidenceColor: Record<string, string> = { strong: '#2d6a3d', moderate: '#d4a534', emerging: '#a06478', 'traditional-only': '#8a6a3d' };
const tierColor: Record<string, string> = { '1': '#2d6a3d', '2': '#d4a534', '3': '#b85a3a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/plant.json', title: 'Plant (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/practice">practice</a><span aria-hidden="true">/</span><span>plant</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY · ANDREW-WEIL LINEAGE</p>
      <h1>PLANT.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="frame"><p class="kicker">FRAMING · WHY THIS, WHY NOT THE STACK</p><h2>The relationship-with-the-plant lineage.</h2>
      <p class="block"><strong>Why not stack culture:</strong> {THE_FRAMING.whyNotStackCulture}</p>
      <p class="block"><strong>Why Andrew Weil:</strong> {THE_FRAMING.whyAndrewWeil}</p>
      <p class="block"><strong>What relationship means:</strong> {THE_FRAMING.whatRelationshipMeans}</p>
      <p class="block"><strong>One over many:</strong> {THE_FRAMING.oneOverMany}</p>
      <p class="block"><strong>Honest uncertainty:</strong> {THE_FRAMING.honestUncertainty}</p>
    </section>

    <section class="def"><p class="kicker">ADAPTOGEN VS NOOTROPIC · TERM DEFINITIONS</p><h2>The categories you'll encounter.</h2>
      <p class="block"><strong>Adaptogen:</strong> {ADAPTOGEN_VS_NOOTROPIC.adaptogen}</p>
      <p class="block"><strong>Nootropic:</strong> {ADAPTOGEN_VS_NOOTROPIC.nootropic}</p>
      <p class="block"><strong>Overlap and distinction:</strong> {ADAPTOGEN_VS_NOOTROPIC.overlapAndDistinction}</p>
      <p class="block"><strong>What neither term covers:</strong> {ADAPTOGEN_VS_NOOTROPIC.whatNeitherTermCovers}</p>
    </section>

    <section class="tier1"><p class="kicker">STARTER TIER · 6 PLANTS</p><h2>Where to begin.</h2>
      <ol class="pl-list">{STARTER_TIER.map((p) => (
        <li>
          <div class="pl__head">
            <h3>{p.commonName}</h3>
            <span class="pl__tier" style={`background: ${tierColor[String(p.beginnerRanking)]};`}>TIER {p.beginnerRanking}</span>
          </div>
          <p class="pl__binom"><em>{p.botanicalName}</em> · part used: {p.partUsed} · category: {p.category}</p>
          <p class="pl__row pl__trad"><strong>Tradition:</strong> {p.tradition}</p>
          <p class="pl__row pl__what"><strong>What it does:</strong> {p.whatItDoes}</p>
          <p class="pl__evi"><strong>Evidence tier:</strong> <span class="evi-pill" style={`background: ${evidenceColor[p.evidenceTier]};`}>{p.evidenceTier}</span></p>
          <p class="pl__row"><strong>Traditional preparation:</strong> {p.traditionalPreparation}</p>
          <p class="pl__row"><strong>Modern dosing:</strong> {p.modernDosing}</p>
          <p class="pl__row pl__src"><strong>Sourcing notes:</strong> {p.sourcingNotes}</p>
          <p class="pl__row pl__cau"><strong>Cautions:</strong> {p.cautions}</p>
        </li>
      ))}</ol>
    </section>

    <section class="tier2"><p class="kicker">INTERMEDIATE TIER · 6 PLANTS</p><h2>After the foundation.</h2>
      <ol class="pl-list">{INTERMEDIATE_TIER.map((p) => (
        <li>
          <div class="pl__head">
            <h3>{p.commonName}</h3>
            <span class="pl__tier" style={`background: ${tierColor[String(p.beginnerRanking)]};`}>TIER {p.beginnerRanking}</span>
          </div>
          <p class="pl__binom"><em>{p.botanicalName}</em> · part used: {p.partUsed} · category: {p.category}</p>
          <p class="pl__row pl__trad"><strong>Tradition:</strong> {p.tradition}</p>
          <p class="pl__row pl__what"><strong>What it does:</strong> {p.whatItDoes}</p>
          <p class="pl__evi"><strong>Evidence tier:</strong> <span class="evi-pill" style={`background: ${evidenceColor[p.evidenceTier]};`}>{p.evidenceTier}</span></p>
          <p class="pl__row"><strong>Traditional preparation:</strong> {p.traditionalPreparation}</p>
          <p class="pl__row"><strong>Modern dosing:</strong> {p.modernDosing}</p>
          <p class="pl__row pl__src"><strong>Sourcing notes:</strong> {p.sourcingNotes}</p>
          <p class="pl__row pl__cau"><strong>Cautions:</strong> {p.cautions}</p>
        </li>
      ))}</ol>
    </section>

    <section class="tier3"><p class="kicker">ADVANCED TIER · 4 PLANTS</p><h2>Deeper engagement, deeper care.</h2>
      <ol class="pl-list">{ADVANCED_TIER.map((p) => (
        <li>
          <div class="pl__head">
            <h3>{p.commonName}</h3>
            <span class="pl__tier" style={`background: ${tierColor[String(p.beginnerRanking)]};`}>TIER {p.beginnerRanking}</span>
          </div>
          <p class="pl__binom"><em>{p.botanicalName}</em> · part used: {p.partUsed} · category: {p.category}</p>
          <p class="pl__row pl__trad"><strong>Tradition:</strong> {p.tradition}</p>
          <p class="pl__row pl__what"><strong>What it does:</strong> {p.whatItDoes}</p>
          <p class="pl__evi"><strong>Evidence tier:</strong> <span class="evi-pill" style={`background: ${evidenceColor[p.evidenceTier]};`}>{p.evidenceTier}</span></p>
          <p class="pl__row"><strong>Traditional preparation:</strong> {p.traditionalPreparation}</p>
          <p class="pl__row"><strong>Modern dosing:</strong> {p.modernDosing}</p>
          <p class="pl__row pl__src"><strong>Sourcing notes:</strong> {p.sourcingNotes}</p>
          <p class="pl__row pl__cau"><strong>Cautions:</strong> {p.cautions}</p>
        </li>
      ))}</ol>
    </section>

    <section class="src"><p class="kicker">SOURCING PRINCIPLES · 9</p><h2>How to buy and source plants well.</h2>
      <ol class="src-list">{SOURCING_PRINCIPLES.map((s, i) => (
        <li><span class="src__num">{String(i+1).padStart(2,'0')}</span><p>{s}</p></li>
      ))}</ol>
    </section>

    <section class="proto"><p class="kicker">90-DAY PROTOCOL · ONE PLANT, BEGINNING</p><h2>{NINETY_DAY_PROTOCOL.description}</h2>
      <h3 class="sh">Week-by-week</h3>
      <ol class="wk-list">{NINETY_DAY_PROTOCOL.weekByWeek.map((w) => (
        <li><span class="wk__n">WEEK {w.week}</span><p>{w.focus}</p></li>
      ))}</ol>
      <h3 class="sh">Decision framework</h3>
      <ul class="dt-list">{NINETY_DAY_PROTOCOL.decisionFramework.map((d) => (<li>{d}</li>))}</ul>
    </section>

    <section class="pyc"><p class="kicker">PLANT YEAR COHORT · 4 YEARS · 16 PLANTS</p><h2>The corridor's long-form plant-relationship cohort.</h2>
      <p class="lede">{PLANT_YEAR_COHORT.description}</p>
      <p class="block"><strong>Structure:</strong> {PLANT_YEAR_COHORT.structure}</p>
      <p class="block"><strong>Year 1 — Starter tier:</strong> {PLANT_YEAR_COHORT.yearOne}</p>
      <p class="block"><strong>Year 2 — Intermediate tier:</strong> {PLANT_YEAR_COHORT.yearTwo}</p>
      <p class="block"><strong>Year 3 — Food-medicines deepening:</strong> {PLANT_YEAR_COHORT.yearThree}</p>
      <p class="block"><strong>Year 4 — Advanced tier:</strong> {PLANT_YEAR_COHORT.yearFour}</p>
      <p class="block"><strong>Outcome:</strong> {PLANT_YEAR_COHORT.outcome}</p>
      <p class="block"><strong>Cost:</strong> {PLANT_YEAR_COHORT.cost}</p>
    </section>

    <section class="cau"><p class="kicker">HONEST CAUTIONS · 7 AREAS</p><h2>What the federation flags loudly.</h2>
      <p class="block warn"><strong>Drug interactions:</strong> {HONEST_CAUTIONS_SECTION.drugInteractions}</p>
      <p class="block warn"><strong>Pregnancy and nursing:</strong> {HONEST_CAUTIONS_SECTION.pregnancyAndNursing}</p>
      <p class="block warn"><strong>Hypertension and cardiovascular:</strong> {HONEST_CAUTIONS_SECTION.hypertensionAndCardiovascular}</p>
      <p class="block warn"><strong>Children and adolescents:</strong> {HONEST_CAUTIONS_SECTION.childrenAndAdolescents}</p>
      <p class="block warn"><strong>Autoimmune conditions:</strong> {HONEST_CAUTIONS_SECTION.autoimmuneConditions}</p>
      <p class="block warn"><strong>Dependence:</strong> {HONEST_CAUTIONS_SECTION.dependence}</p>
      <p class="block warn"><strong>When to seek clinical care:</strong> {HONEST_CAUTIONS_SECTION.whenToSeekClinicalCare}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · HERBALISTS · COHORT MEMBERS · INTEGRATIVE PHYSICIANS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/living-body">Living Body · UES-WP-2026-18</a>
      <a href="/practice">Practice · UES-WP-2026-20</a>
      <a href="/time">Time · UES-WP-2026-16</a>
      <a href="/marine-layer">Marine Layer · UES-WP-2026-01</a>
      <a href="/civic-federation">Civic Federation · UES-WP-2026-19</a>
      <a href="/plant.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --pl-ink:#1a1a1a; --pl-paper:#fdf9ee; --pl-mustard:#d4a534; --pl-rust:#b85a3a; --pl-sage:#2d6a3d; --pl-mauve:#a06478; --pl-earth:#8a6a3d; --pl-fog:#d8d2c4; --pl-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--pl-paper); color: var(--pl-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--pl-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--pl-sage); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--pl-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--pl-sage); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 156px; line-height: .9; font-weight: 700; letter-spacing: -.04em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--pl-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--pl-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--pl-sage); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--pl-sage); }

  .lede { font-size: 15px; line-height: 1.65; margin: 0 0 14px; max-width: 72ch; font-family: Georgia, serif; }
  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--pl-sage); max-width: 72ch; font-family: Georgia, serif; }
  .block.warn { border-left-color: var(--pl-rust); border-left-width: 6px; background: linear-gradient(90deg, #fff5f0, #fff); }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--pl-sage); margin-right: 6px; }
  .block.warn strong { color: var(--pl-rust); }

  .pl-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .pl-list li { padding: 14px; background: #fff; border: 2px solid var(--pl-ink); border-left: 8px solid var(--pl-sage); }
  .pl__head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 2px solid var(--pl-sage); margin-bottom: 8px; }
  .pl__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; flex: 1; }
  .pl__tier { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; padding: 3px 8px; color: #fff; }
  .pl__binom { font-size: 13px; line-height: 1.55; margin: 0 0 8px; padding: 6px 10px; background: var(--pl-paper); border-left: 3px solid var(--pl-earth); font-family: Georgia, serif; color: var(--pl-slate); }
  .pl__row { padding: 6px 10px; background: var(--pl-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--pl-fog); }
  .pl__trad { border-left-color: var(--pl-mauve); }
  .pl__what { border-left-color: var(--pl-sage); }
  .pl__src { border-left-color: var(--pl-mustard); }
  .pl__cau { border-left-color: var(--pl-rust); }
  .pl__evi { padding: 4px 10px; background: transparent; margin: 4px 0 !important; font-size: 12px; line-height: 1.55; font-family: var(--pc-font-mono); display: flex; align-items: center; gap: 8px; }
  .evi-pill { font-size: 10px; letter-spacing: .12em; padding: 3px 8px; color: #fff; text-transform: uppercase; }
  .pl-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--pl-sage); margin-right: 4px; }

  .src-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .src-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--pl-ink); border-left: 6px solid var(--pl-mustard); align-items: baseline; }
  .src__num { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--pl-mustard); }
  .src-list p { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .wk-list { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 6px; }
  .wk-list li { display: grid; grid-template-columns: 90px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--pl-ink); border-left: 5px solid var(--pl-sage); align-items: baseline; }
  .wk__n { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--pl-rust); padding: 2px 8px; background: var(--pl-paper); letter-spacing: .12em; }
  .wk-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }

  .invitation { background: var(--pl-sage); color: var(--pl-paper); border-top-color: var(--pl-sage); }
  .invitation .kicker { background: var(--pl-mustard); color: var(--pl-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--pl-mustard); color: var(--pl-ink); border-left: 4px solid var(--pl-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .9; padding: 12px 14px; background: rgba(255,255,255,0.08); border-left: 4px solid var(--pl-mustard); line-height: 1.5; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--pl-sage); color: var(--pl-paper); text-decoration: none; }
  .links a:hover { background: var(--pl-rust); }

  @media (max-width: 800px) { h1 { font-size: 110px; } .pl__head { flex-direction: column; align-items: flex-start; } .src-list li, .wk-list li { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 78px; } }
</style>
