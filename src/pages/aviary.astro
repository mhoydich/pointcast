---
/**
 * /aviary — a grove of birds, listening only.
 *
 * Multi-bird ambient surface in the shrine register. 16 Nouns scattered
 * across the night-grove, each chirping on its own slow timer. The
 * pitches all come from NounBells' pentatonic scale, so the flock
 * harmonises with itself and with the rest of the music suite.
 *
 * No interaction other than hover (immediate chirp + halo) and a mute
 * toggle. No state persisted. The aviary is for *being with* the birds,
 * not for collecting them. Set the tab to background; come back later.
 *
 * Distinct from /shrine-bird (single focused visitor): aviary is a
 * gathering. Sister to /drum-pavilion (audio-first meditative) but
 * image-first and using real Visit Nouns artwork.
 *
 * Background: painterly grove (Manus-delivered, gradient placeholder
 * until then; see docs/briefs/2026-05-16-manus-shrine-altar-backgrounds.md).
 *
 * Bird selection: 16 Nouns drawn deterministically from a single
 * hourly seed (hash of YYYY-MM-DD-HH), so the same flock visits every
 * visitor at the same hour. Refresh to roll forward; revisit later in
 * the day to find a different flock.
 *
 * Shipped 2026-05-16. Third shrine surface, opens the bird register.
 * — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Aviary — sixteen birds, listening only"
  description="A grove of Visit Nouns, each chirping on its own slow timer. The pitches harmonise because they share a pentatonic scale. Hover a bird to hear it; otherwise just set the tab and let the flock pass through. Listening only — no interaction, no persisted state."
  image="/images/og-drum.png"
>
  <main class="avi" id="avi" data-built={built}>
    <!-- Backdrop: forest grove placeholder -->
    <div class="avi__backdrop" id="avi-backdrop" aria-hidden="true"></div>

    <!-- Bird stage — 16 Nouns scatter across this area -->
    <div class="avi__stage" id="avi-stage" aria-label="A grove of sixteen Nouns"></div>

    <!-- Bottom-left card: title + controls -->
    <aside class="avi__plaque">
      <p class="avi__kicker">SHRINE · AVIARY · LISTENING ONLY</p>
      <h1 class="avi__title">Sixteen birds.</h1>
      <p class="avi__sub">A grove of <a href="https://noun.pics" target="_blank" rel="noopener">Nouns</a>, each on its own slow chirp. The flock turns over every hour. Hover a bird to hear it now.</p>
      <div class="avi__controls">
        <button class="avi__btn" id="avi-mute" type="button" aria-pressed="false">🔊 sound on</button>
        <button class="avi__btn" id="avi-refresh" type="button">↺ new flock</button>
      </div>
      <p class="avi__links">
        <a href="/shrine-bird">↗ /shrine-bird</a>
        <span class="avi__dot">·</span>
        <a href="/shrine-water">↗ /shrine-water</a>
        <span class="avi__dot">·</span>
        <a href="/music-hub">↗ /music-hub</a>
      </p>
    </aside>
  </main>

  <style is:global>
    :root {
      --avi-ink: #050810;
      --avi-deep: #0c1820;
      --avi-grove-1: #1a2820;
      --avi-grove-2: #28403c;
      --avi-mist: #b0c4c0;
      --avi-cream: #f4ede0;
      --avi-cream-dim: rgba(244, 237, 224, 0.62);
      --avi-cream-dimmer: rgba(244, 237, 224, 0.34);
      --avi-accent: #d8b878;
      --avi-card-bg: rgba(8, 14, 18, 0.55);
      --avi-card-border: rgba(244, 237, 224, 0.12);
    }

    html, body { background: var(--avi-ink); margin: 0; padding: 0; height: 100%; }
    body:has(.avi) {
      color: var(--avi-cream);
      font-family: -apple-system, 'SF Pro Display', BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .avi {
      position: fixed;
      inset: 0;
    }

    /* BACKDROP — grove placeholder */
    .avi__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 50% 15%, rgba(216, 184, 120, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 25% 75%, rgba(40, 64, 60, 0.55) 0%, transparent 60%),
        radial-gradient(ellipse at 75% 80%, rgba(26, 40, 32, 0.65) 0%, transparent 60%),
        linear-gradient(180deg, #0c1820 0%, #1a2820 50%, #28403c 100%);
      animation: aviBackdrop 40s ease-in-out infinite alternate;
    }
    @keyframes aviBackdrop {
      0%   { filter: brightness(1.0); }
      100% { filter: brightness(0.94); }
    }
    .avi__backdrop--image {
      background-image: url('/images/shrines/shrine-grove.png');
      background-size: cover;
      background-position: center;
      animation: none;
    }
    .avi__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(5, 8, 16, 0.45) 100%);
      pointer-events: none;
    }

    /* STAGE — bird scatter area */
    .avi__stage {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .avi__bird {
      position: absolute;
      width: 64px;
      height: 64px;
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      transform: translate(-50%, -50%);
      opacity: 0;
      animation: aviBirdArrive 2.4s cubic-bezier(0.16, 0.84, 0.30, 1.00) forwards,
                 aviBirdHover 6s ease-in-out infinite;
      animation-delay: var(--arrive-delay, 0s), var(--hover-delay, 0s);
      background: rgba(0, 0, 0, 0.25);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.4);
      transition: transform 240ms cubic-bezier(0.2, 0.7, 0.3, 1),
                  box-shadow 240ms ease;
    }
    .avi__bird:hover {
      transform: translate(-50%, -50%) scale(1.18);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.5),
                  0 0 0 2px rgba(216, 184, 120, 0.4);
      z-index: 5;
    }
    .avi__bird--chirping {
      animation: aviBirdArrive 2.4s cubic-bezier(0.16, 0.84, 0.30, 1.00) forwards,
                 aviBirdHover 6s ease-in-out infinite,
                 aviBirdChirp 1.4s cubic-bezier(0.25, 0.6, 0.30, 1);
    }
    @keyframes aviBirdArrive {
      0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
      100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    @keyframes aviBirdHover {
      0%, 100% { transform: translate(-50%, -50%) translateY(0); }
      50%      { transform: translate(-50%, -50%) translateY(-3px); }
    }
    @keyframes aviBirdChirp {
      0%   { box-shadow: 0 8px 18px rgba(0,0,0,0.4), 0 0 0 0 rgba(216, 184, 120, 0.5); }
      50%  { box-shadow: 0 8px 18px rgba(0,0,0,0.4), 0 0 0 18px rgba(216, 184, 120, 0); }
      100% { box-shadow: 0 8px 18px rgba(0,0,0,0.4); }
    }
    .avi__bird img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      image-rendering: pixelated;
    }

    /* PLAQUE — bottom-left card */
    .avi__plaque {
      position: absolute;
      bottom: 24px;
      left: 24px;
      z-index: 10;
      max-width: 340px;
      padding: 22px 24px 20px;
      background: var(--avi-card-bg);
      border: 1px solid var(--avi-card-border);
      border-radius: 22px;
      backdrop-filter: blur(28px) saturate(130%);
      -webkit-backdrop-filter: blur(28px) saturate(130%);
      box-shadow:
        0 24px 48px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(244, 237, 224, 0.08);
      animation: aviPlaqueEnter 1.4s cubic-bezier(0.16, 0.84, 0.30, 1.00) both 0.6s;
    }
    @keyframes aviPlaqueEnter {
      0%   { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .avi__kicker {
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--avi-cream-dim);
      text-transform: uppercase;
      margin: 0 0 12px;
      font-weight: 500;
    }
    .avi__title {
      font-family: 'New York', 'Charter', 'Iowan Old Style', Georgia, serif;
      font-weight: 500;
      font-size: 28px;
      letter-spacing: -0.018em;
      line-height: 1.10;
      margin: 0 0 10px;
      color: var(--avi-cream);
    }
    .avi__sub {
      font-size: 13px;
      line-height: 1.55;
      color: var(--avi-cream-dim);
      margin: 0 0 16px;
    }
    .avi__sub a {
      color: var(--avi-accent);
      text-decoration: none;
      border-bottom: 1px dotted rgba(216, 184, 120, 0.4);
    }

    .avi__controls {
      display: flex;
      gap: 8px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }
    .avi__btn {
      border: 1px solid rgba(244, 237, 224, 0.18);
      background: rgba(244, 237, 224, 0.06);
      color: var(--avi-cream);
      padding: 7px 12px;
      border-radius: 999px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.01em;
      cursor: pointer;
      transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .avi__btn:hover {
      background: rgba(244, 237, 224, 0.14);
      border-color: rgba(244, 237, 224, 0.35);
    }
    .avi__btn[aria-pressed="true"] {
      color: var(--avi-cream-dim);
    }

    .avi__links {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--avi-cream-dimmer);
      margin: 0;
    }
    .avi__links a {
      color: var(--avi-cream-dim);
      text-decoration: none;
      transition: color 200ms ease;
    }
    .avi__links a:hover { color: var(--avi-cream); }
    .avi__dot { display: inline-block; margin: 0 6px; opacity: 0.4; }

    @media (max-width: 600px) {
      .avi__bird { width: 48px; height: 48px; border-radius: 9px; }
      .avi__plaque {
        bottom: 16px; left: 16px; right: 16px; max-width: none;
        padding: 18px 20px 16px;
      }
      .avi__title { font-size: 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .avi__bird, .avi__backdrop, .avi__plaque { animation: none; opacity: 1; transform: translate(-50%, -50%); }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // Same pentatonic scale as /shrine-bird and NounBells
    const SCALE = [
      130.81, 146.83, 164.81, 196.00, 220.00,
      261.63, 293.66, 329.63, 392.00, 440.00,
      523.25, 587.33, 659.25, 783.99, 880.00,
      1046.5,
    ];
    const NOUN_COUNT = 1200;
    const FLOCK_SIZE = 16;

    function hash32(str: string): number {
      let h = 2166136261;
      for (let i = 0; i < str.length; i++) {
        h ^= str.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    }
    function mulberry32(seed: number) {
      let a = seed >>> 0;
      return function() {
        a = (a + 0x6D2B79F5) | 0;
        let t = a;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // Hourly seed — flock turns over every hour
    function hourlySeed(): string {
      const d = new Date();
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      const h = String(d.getHours()).padStart(2, '0');
      return `${y}-${m}-${dd}-${h}`;
    }

    interface Bird {
      seed: number;
      freq: number;
      x: number;  // 0..1 viewport position
      y: number;
      arriveDelay: number;
      hoverDelay: number;
      chirpInterval: number;  // ms between chirps
      el: HTMLDivElement;
      timer: number | null;
    }

    function generateFlock(seedStr: string): Omit<Bird, 'el' | 'timer'>[] {
      const baseSeed = hash32(seedStr);
      const rng = mulberry32(baseSeed);
      const birds: Omit<Bird, 'el' | 'timer'>[] = [];
      const placed: { x: number; y: number }[] = [];
      for (let i = 0; i < FLOCK_SIZE; i++) {
        const nounSeed = Math.floor(rng() * NOUN_COUNT);
        const freqIdx = Math.floor(rng() * SCALE.length);
        const freq = SCALE[freqIdx];
        // Place with minimum distance to avoid clustering
        let x = 0, y = 0;
        let attempts = 0;
        do {
          x = 0.08 + rng() * 0.84;
          y = 0.10 + rng() * 0.65;  // leave room for plaque at bottom-left
          attempts++;
        } while (attempts < 30 && placed.some(p => Math.hypot(p.x - x, p.y - y) < 0.12));
        placed.push({ x, y });
        birds.push({
          seed: nounSeed,
          freq,
          x, y,
          arriveDelay: rng() * 1200,
          hoverDelay: rng() * 6000,
          chirpInterval: 5000 + rng() * 10000,  // 5..15s
        });
      }
      return birds;
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let convolver: ConvolverNode | null = null;
    let dryGain: GainNode | null = null;
    let wetGain: GainNode | null = null;
    let muted = false;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.25;
      masterGain.connect(ctx.destination);
      convolver = ctx.createConvolver();
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 1.6);
      const ir = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const ch = ir.getChannelData(c);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 3.6);
        }
      }
      convolver.buffer = ir;
      dryGain = ctx.createGain();
      wetGain = ctx.createGain();
      dryGain.gain.value = 0.55;
      wetGain.gain.value = 0.45;
      dryGain.connect(masterGain);
      convolver.connect(wetGain).connect(masterGain);
    }
    function connectVoice(node: AudioNode) {
      if (!dryGain || !convolver) return;
      node.connect(dryGain);
      node.connect(convolver);
    }

    function playChirp(baseFreq: number, gain: number = 0.22) {
      if (muted) return;
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const dur = 0.07 + Math.random() * 0.06;
      const detune = 0.92 + Math.random() * 0.16;
      const f = baseFreq * detune;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(f * 0.82, t);
      osc.frequency.exponentialRampToValueAtTime(f * 1.18, t + dur * 0.45);
      osc.frequency.exponentialRampToValueAtTime(f * 0.94, t + dur);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(gain, t + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(g);
      connectVoice(g);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + dur + 0.04);
    }

    function playCluster(baseFreq: number) {
      const count = 1 + Math.floor(Math.random() * 3);  // 1..3
      for (let i = 0; i < count; i++) {
        const delay = i * (80 + Math.random() * 90);
        setTimeout(() => playChirp(baseFreq), delay);
      }
    }

    // ---- state ----
    let birds: Bird[] = [];

    function clearFlock() {
      for (const b of birds) {
        if (b.timer != null) clearTimeout(b.timer);
        b.el.remove();
      }
      birds = [];
    }

    function renderFlock(seedStr: string) {
      clearFlock();
      const stage = document.getElementById('avi-stage')!;
      const generated = generateFlock(seedStr);
      for (const g of generated) {
        const el = document.createElement('div');
        el.className = 'avi__bird';
        el.style.left = `${g.x * 100}%`;
        el.style.top = `${g.y * 100}%`;
        el.style.setProperty('--arrive-delay', `${g.arriveDelay}ms`);
        el.style.setProperty('--hover-delay', `${g.hoverDelay}ms`);
        el.title = `Noun #${g.seed}`;
        const img = document.createElement('img');
        img.src = `https://noun.pics/${g.seed}.svg`;
        img.alt = `Noun #${g.seed}`;
        img.loading = 'lazy';
        img.decoding = 'async';
        el.appendChild(img);

        const bird: Bird = { ...g, el, timer: null };
        birds.push(bird);

        // Hover: immediate chirp + halo
        el.addEventListener('mouseenter', () => {
          playChirp(bird.freq, 0.30);
          el.classList.remove('avi__bird--chirping');
          void el.offsetWidth;
          el.classList.add('avi__bird--chirping');
        });

        stage.appendChild(el);
      }
    }

    function startBirdTimers() {
      for (const b of birds) {
        if (b.timer != null) continue;
        const tick = () => {
          // Chirp + visual pulse
          playCluster(b.freq);
          b.el.classList.remove('avi__bird--chirping');
          void b.el.offsetWidth;
          b.el.classList.add('avi__bird--chirping');
          // Next chirp
          b.timer = window.setTimeout(tick, b.chirpInterval + (Math.random() - 0.5) * 2000);
        };
        // First chirp after a delay (so they don't all chirp at once)
        b.timer = window.setTimeout(tick, 1500 + Math.random() * b.chirpInterval);
      }
    }
    function stopBirdTimers() {
      for (const b of birds) {
        if (b.timer != null) { clearTimeout(b.timer); b.timer = null; }
      }
    }

    function setMuted(m: boolean) {
      muted = m;
      const btn = document.getElementById('avi-mute')! as HTMLButtonElement;
      btn.textContent = m ? '🔇 sound off' : '🔊 sound on';
      btn.setAttribute('aria-pressed', String(m));
      if (m) stopBirdTimers();
      else if (ctx) startBirdTimers();
    }

    function refreshFlock() {
      // Generate a new flock using a random offset so people can roll a new one
      const fresh = `${hourlySeed()}-${Math.random().toString(36).slice(2, 8)}`;
      renderFlock(fresh);
      if (!muted && ctx) startBirdTimers();
    }

    function init() {
      renderFlock(hourlySeed());

      document.getElementById('avi-mute')!.addEventListener('click', () => setMuted(!muted));
      document.getElementById('avi-refresh')!.addEventListener('click', refreshFlock);

      // Audio wakes on first interaction
      const wake = () => {
        if (muted) return;
        ensureCtx();
        startBirdTimers();
        document.removeEventListener('pointerdown', wake);
        document.removeEventListener('keydown', wake);
      };
      document.addEventListener('pointerdown', wake);
      document.addEventListener('keydown', wake);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopBirdTimers();
        else if (ctx && !muted) startBirdTimers();
      });

      // Auto-rotate flock at the top of each hour
      const scheduleHourTick = () => {
        const now = new Date();
        const nextHour = new Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours() + 1, 0, 5);
        const wait = nextHour.getTime() - now.getTime();
        setTimeout(() => {
          renderFlock(hourlySeed());
          if (!muted && ctx) startBirdTimers();
          scheduleHourTick();
        }, wait);
      };
      scheduleHourTick();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
