---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCHITECTURE_PRINCIPLES, PRINCIPLES, PROPOSAL_FORMAT, TRACK_META, TWELVE_SPECIES, TWELVE_WALKS } from '../lib/naturePractice';
const title = `${TRACK_META.title} — ${TRACK_META.subtitle}`;
const description = TRACK_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Course', '@id': 'https://pointcast.xyz/nature-practice', name: TRACK_META.title, description, url: 'https://pointcast.xyz/nature-practice', provider: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, timeRequired: 'P12M' };
const monthName = (n: number) => ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][n-1];
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/nature-practice.json', title: 'Nature Practice (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span><span>nature-practice</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{TRACK_META.paperNumber} · 12-MONTH PATHWAY · 12 SPECIES · 12 WALKS</p>
      <h1>NATURE / PRACTICE.</h1>
      <p class="subtitle">{TRACK_META.subtitle}</p>
      <p class="thesis">{TRACK_META.thesis}</p>
    </header>

    <section><p class="kicker">PRINCIPLES</p><h2>Six rules of the pathway.</h2>
      <ol class="rules">{PRINCIPLES.map((p, i) => (<li><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>))}</ol>
    </section>

    <section><p class="kicker">TWELVE NATIVE SPECIES · ONE PER MONTH</p><h2>The native palette.</h2>
      <ol class="species">{TWELVE_SPECIES.map((s) => (
        <li class="sp">
          <div class="sp__head"><span class="sp__mo">{monthName(s.month).toUpperCase()} · MONTH {String(s.month).padStart(2,'0')}</span>{s.commonsCommission && <span class="sp__cf">Common Forms {s.commonsCommission}</span>}</div>
          <h3>{s.common} <em>({s.latin})</em></h3>
          <p class="sp__meta"><strong>Family:</strong> {s.family} · <strong>Habitat:</strong> {s.habitat} · <strong>Bloom:</strong> {s.bloomSeason}</p>
          <p class="sp__use"><strong>UES use:</strong> {s.uesUseCase}</p>
        </li>
      ))}</ol>
    </section>

    <section><p class="kicker">TWELVE WALKS · ONE PER MONTH</p><h2>The pathway.</h2>
      <ol class="walks">{TWELVE_WALKS.map((w) => (
        <li class="wk">
          <div class="wk__head"><span class="wk__mo">{monthName(w.month).toUpperCase()} {String(w.month).padStart(2,'0')}</span><span class="wk__pace">{w.pacing}</span></div>
          <p class="wk__route"><strong>Route:</strong> {w.route}</p>
          <p class="wk__obs"><strong>Observe:</strong> {w.observe}</p>
          <p class="wk__cap"><strong>Capture:</strong> {w.capture}</p>
          <p class="wk__prog"><strong>Lights up:</strong> {w.uesProgram}</p>
        </li>
      ))}</ol>
    </section>

    <section><p class="kicker">ARCHITECTURE PRINCIPLES</p><h2>Build with the local condition.</h2>
      <ol class="ap">{ARCHITECTURE_PRINCIPLES.map((p, i) => (<li><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>))}</ol>
    </section>

    <section class="proposal"><p class="kicker">YEAR-13 PROPOSAL</p><h2>The deliverable.</h2>
      <p class="lede"><strong>Duration:</strong> {PROPOSAL_FORMAT.duration}.<br/><strong>Length:</strong> {PROPOSAL_FORMAT.proposalLength}.</p>
      <ol class="prop-sec">{PROPOSAL_FORMAT.proposalSections.map((s, i) => (<li><span>{String(i+1).padStart(2,'0')}</span><p>{s}</p></li>))}</ol>
      <p class="prop-review"><strong>Cohort review:</strong> {PROPOSAL_FORMAT.cohortReview}</p>
    </section>

    <section class="links">
      <a href="/marine-layer">Marine Layer · air</a>
      <a href="/geology">Geology · earth</a>
      <a href="/ocean-wing">Ocean Wing · water</a>
      <a href="/fire">Fire · forthcoming</a>
      <a href="/commons">Commons</a>
      <a href="/common-forms">Common Forms</a>
      <a href="/honey-league">Honey League</a>
      <a href="/university-of-el-segundo">UES tracks</a>
      <a href="/nature-practice.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --np-ink:#1a1a1a; --np-paper:#fdf9ee; --np-sage:#7a8c4f; --np-sage-d:#4a5a2f; --np-poppy:#e8722a; --np-buckwheat:#d49a8c; --np-oak:#5a4628; --np-fog:#d8d2c4; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--np-paper); color: var(--np-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--np-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--np-sage-d); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--np-ink); margin: 0 0 10px; padding: 4px 8px; background: var(--np-sage); color: #fff; display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 88px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 20px; font-weight: 500; margin: 0 0 14px; max-width: 50ch; }
  .thesis { font-size: 16px; line-height: 1.6; max-width: 70ch; margin: 0; }
  section { padding: 30px 28px; border-top: 4px solid var(--np-sage-d); }
  h2 { font-family: var(--pc-font-mono); font-size: 28px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  .lede { font-size: 15px; line-height: 1.6; margin: 0 0 14px; max-width: 72ch; }

  .rules, .ap { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rules li, .ap li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--np-ink); align-items: baseline; }
  .rules span, .ap span { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--np-sage-d); }
  .rules p, .ap p { margin: 0; font-size: 15px; line-height: 1.5; }

  .species { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .sp { padding: 14px 16px; background: #fff; border: 2px solid var(--np-ink); border-left: 8px solid var(--np-sage); }
  .sp__head { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; }
  .sp__mo { color: var(--np-sage-d); font-weight: 700; }
  .sp__cf { color: var(--np-poppy); padding: 2px 6px; background: var(--np-paper); border: 1px solid var(--np-poppy); }
  .sp h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0 0 6px; font-weight: 700; }
  .sp h3 em { font-family: Georgia, serif; font-style: italic; color: #5a5450; font-weight: 400; font-size: 14px; }
  .sp__meta, .sp__use { margin: 0 0 4px; font-size: 13px; line-height: 1.5; }
  .sp strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--np-sage-d); margin-right: 4px; }

  .walks { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .wk { padding: 14px 16px; background: #fff; border: 2px solid var(--np-ink); border-left: 8px solid var(--np-oak); }
  .wk__head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; }
  .wk__mo { color: var(--np-oak); font-weight: 700; padding: 3px 8px; background: var(--np-paper); border: 1px solid var(--np-oak); }
  .wk__pace { color: var(--np-poppy); }
  .wk p { margin: 0 0 5px; font-size: 13.5px; line-height: 1.5; }
  .wk strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--np-sage-d); margin-right: 4px; }

  .proposal { background: linear-gradient(180deg, #fff, var(--np-paper)); border-top-color: var(--np-poppy); }
  .prop-sec { list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 6px; }
  .prop-sec li { display: grid; grid-template-columns: 40px 1fr; gap: 12px; padding: 10px 12px; background: #fff; border-left: 3px solid var(--np-poppy); }
  .prop-sec span { font-family: var(--pc-font-mono); font-size: 12px; font-weight: 700; color: var(--np-poppy); }
  .prop-sec p { margin: 0; font-size: 14px; }
  .prop-review { padding: 12px 14px; background: var(--np-paper); border-left: 4px solid var(--np-poppy); font-size: 14px; line-height: 1.55; }
  .prop-review strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--np-poppy); margin-right: 4px; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--np-sage-d); color: #fff; text-decoration: none; }
  .links a:hover { background: var(--np-sage); }

  @media (max-width: 800px) { h1 { font-size: 60px; } .species { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } }
</style>
