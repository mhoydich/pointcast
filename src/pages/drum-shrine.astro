---
/**
 * /drum-shrine — a single-Noun shrine, daily rotation.
 *
 * Mike: "more on nouns, alters, shrines, meditatives". One Noun
 * per UTC day, deterministically derived from day-of-year. Pixel-art
 * temple front with a brass bell at the apex, two columns flanking,
 * and an inner sanctum housing the day's Noun. Click anywhere on the
 * temple to ring the apex bell. Click the inner sanctum to "kneel"
 * (separate counter, more reverent).
 *
 * Today's Noun is the same for every visitor — that's the point. A
 * small global daily focus. Incense smoke drifts upward from braziers
 * on either side as a CSS keyframe.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';
import { shrineState } from '../lib/drum-shrine';

const title = 'Shrine · One Noun a Day · PointCast';
const description =
  'A single Noun on display in a velvet pixel-art shrine. Rotates daily at UTC midnight. Click the bell to ring; click the sanctum to kneel.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Shrine',
  url: 'https://pointcast.xyz/drum-shrine',
  description,
  applicationCategory: 'MultimediaApplication',
};

// Accurate no-JS state; the client refreshes it for long-open tabs.
const initialShrine = shrineState();
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="ds" id="ds-main">
    <DrumNav current="shrine" />

    <header class="ds__header">
      <div class="ds__chrome">
        <span>TODAY'S SHRINE</span>
        <span class="ds__chrome-sep">·</span>
        <span id="ds-date">—</span>
        <span class="ds__chrome-sep">·</span>
        <span id="ds-day">DAY ---</span>
      </div>
      <h1 class="ds__title">SHRINE</h1>
      <p class="ds__tagline">a single Noun on display until UTC midnight</p>
    </header>

    <section class="ds__temple" aria-label="Click the bell or sanctum">
      <!-- Temple silhouette -->
      <svg class="ds__temple-svg" viewBox="0 0 320 380" shape-rendering="crispEdges" aria-hidden="true">
        <!-- pediment + roof tip -->
        <path d="M 160 8 L 280 70 L 40 70 Z" fill="#3a2410"/>
        <path d="M 160 14 L 270 70 L 50 70 Z" fill="#5a3618"/>
        <!-- roof apex bell housing -->
        <rect x="148" y="34" width="24" height="22" fill="#1a0820"/>
        <rect x="146" y="34" width="28" height="3" fill="#d4a437"/>
        <rect x="146" y="56" width="28" height="3" fill="#d4a437"/>
        <!-- pediment trim -->
        <rect x="40" y="68" width="240" height="4" fill="#d4a437"/>
        <!-- entablature -->
        <rect x="34" y="72" width="252" height="14" fill="#3a2410"/>
        <rect x="34" y="86" width="252" height="3" fill="#6b4d12"/>
        <!-- columns left -->
        <rect x="48" y="89" width="20" height="220" fill="#b8862c"/>
        <rect x="46" y="305" width="24" height="8" fill="#d4a437"/>
        <rect x="50" y="91" width="2" height="218" fill="#fff5c0" opacity="0.5"/>
        <rect x="62" y="91" width="2" height="218" fill="#6b4d12" opacity="0.7"/>
        <!-- columns right -->
        <rect x="252" y="89" width="20" height="220" fill="#b8862c"/>
        <rect x="250" y="305" width="24" height="8" fill="#d4a437"/>
        <rect x="254" y="91" width="2" height="218" fill="#fff5c0" opacity="0.5"/>
        <rect x="266" y="91" width="2" height="218" fill="#6b4d12" opacity="0.7"/>
        <!-- inner wall (recessed) -->
        <rect x="68" y="89" width="184" height="220" fill="#0c0410"/>
        <!-- floor -->
        <rect x="34" y="313" width="252" height="14" fill="#3a2410"/>
        <rect x="28" y="327" width="264" height="6" fill="#6b4d12"/>
        <rect x="22" y="333" width="276" height="4" fill="#3a2410"/>
        <!-- braziers -->
        <rect x="84" y="290" width="16" height="20" fill="#6b4d12"/>
        <rect x="80" y="288" width="24" height="4" fill="#d4a437"/>
        <rect x="220" y="290" width="16" height="20" fill="#6b4d12"/>
        <rect x="216" y="288" width="24" height="4" fill="#d4a437"/>
      </svg>

      <!-- Apex bell (clickable) -->
      <button class="ds__bell" id="ds-bell" type="button" aria-label="Ring the apex bell">
        <svg viewBox="0 0 60 70" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M 12 14 L 48 14 L 50 56 L 10 56 Z" fill="#d4a437"/>
          <rect x="10" y="56" width="40" height="3" fill="#b8862c"/>
          <rect x="8"  y="59" width="44" height="3" fill="#6b4d12"/>
          <rect x="16" y="22" width="2" height="22" fill="#fff5c0" opacity="0.55"/>
          <rect x="26" y="6"  width="8" height="2" fill="#6b4d12"/>
          <rect x="24" y="8"  width="12" height="6" fill="#b8862c"/>
        </svg>
      </button>

      <!-- Inner sanctum (clickable for kneel) -->
      <button class="ds__sanctum" id="ds-sanctum" type="button" aria-label="Kneel before the Noun">
        <div class="ds__sanctum-frame">
          <img class="ds__noun" id="ds-noun" src={initialShrine.nounImage} alt={`Today's Noun #${initialShrine.noun}`} />
        </div>
        <div class="ds__nameplate">
          NOUN <span id="ds-noun-num">{String(initialShrine.noun).padStart(4, '0')}</span>
        </div>
      </button>

      <!-- Incense smoke (CSS animation) -->
      <div class="ds__smoke ds__smoke--left">
        <span></span><span></span><span></span>
      </div>
      <div class="ds__smoke ds__smoke--right">
        <span></span><span></span><span></span>
      </div>
    </section>

    <section class="ds__readout">
      <div class="ds__panel">
        <div class="ds__panel-label">YOUR RINGS</div>
        <div class="ds__panel-value" id="ds-rings">0</div>
      </div>
      <div class="ds__panel">
        <div class="ds__panel-label">YOUR KNEELS</div>
        <div class="ds__panel-value" id="ds-kneels">0</div>
      </div>
      <div class="ds__panel">
        <div class="ds__panel-label">UNTIL ROTATION</div>
        <div class="ds__panel-value" id="ds-countdown">--:--</div>
      </div>
    </section>

    <section class="ds__how">
      <p>
        Today's Noun is a single fixed identity — derived from the UTC day-of-year so every visitor is
        looking at the same Noun, today, until midnight UTC. Click the brass apex bell to ring, click
        the inner sanctum to kneel. Two counts, both yours alone.
      </p>
      <p>
        Tomorrow brings a different Noun. The day after, another. There are 1200 Nouns, so the cycle
        recurs every ~3.3 years.
      </p>
      <p class="ds__contract">
        Agents can read today's shared focus at <a href="/drum-shrine.json">/drum-shrine.json</a>.
      </p>
    </section>
  </main>
</BlockLayout>

<style is:global>
  body:has(#ds-main) {
    background: #0c0410;
  }

  .ds {
    --ds-velvet: #1a0820;
    --ds-velvet-deep: #0c0410;
    --ds-brass: #d4a437;
    --ds-brass-soft: #b8862c;
    --ds-brass-deep: #6b4d12;
    --ds-flame: #f6c15e;
    --ds-flame-tip: #ff6b3a;
    --ds-ink-light: #f4e7c8;
    --ds-ink-mid: #c9b78c;
    --ds-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 32px;
    color: var(--ds-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--ds-velvet) 0%, var(--ds-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .ds::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 30px 30px, rgba(212, 164, 55, 0.08) 1.5px, transparent 2px);
    background-size: 130px 130px;
    opacity: 0.4;
    z-index: -1;
  }
  .ds .drum-nav {
    opacity: 0.45;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }

  .ds__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(12px, 1.5vh, 22px);
  }
  .ds__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px;
    border: 1.5px solid var(--ds-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ds-ink-mid);
    background: rgba(0, 0, 0, 0.35);
  }
  .ds__chrome-sep { color: var(--ds-brass-deep); }
  #ds-date, #ds-day { color: var(--ds-flame); font-weight: 700; }

  .ds__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(34px, 5.5vw, 76px);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ds-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--ds-velvet-deep);
  }
  .ds__tagline {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px);
    color: var(--ds-ink-mid);
  }

  /* Temple */
  .ds__temple {
    position: relative;
    width: clamp(280px, 36vw, 420px);
    aspect-ratio: 320 / 380;
    margin: clamp(20px, 3vh, 36px) auto;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.7));
  }
  .ds__temple-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Apex bell — clickable button on top of the temple */
  .ds__bell {
    position: absolute;
    top: 4%;
    left: 50%;
    transform: translateX(-50%);
    width: 12%;
    aspect-ratio: 60 / 70;
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transform-origin: 50% 0%;
    transition: filter 220ms;
    filter: drop-shadow(0 0 8px rgba(212, 164, 55, 0.30));
  }
  .ds__bell:hover {
    filter: drop-shadow(0 0 16px rgba(246, 193, 94, 0.55));
  }
  .ds__bell svg { width: 100%; height: 100%; display: block; }
  .ds__bell.ds__bell--ringing {
    animation: ds-bell-swing 0.8s ease-in-out 1;
  }
  @keyframes ds-bell-swing {
    0%, 100% { transform: translateX(-50%) rotate(0deg); }
    25%      { transform: translateX(-50%) rotate(-14deg); }
    75%      { transform: translateX(-50%) rotate(12deg); }
  }

  /* Inner sanctum — clickable for kneel */
  .ds__sanctum {
    position: absolute;
    top: 30%;
    left: 22%;
    width: 56%;
    height: 50%;
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
  }
  .ds__sanctum-frame {
    width: clamp(100px, 14vw, 140px);
    aspect-ratio: 1;
    padding: 4px;
    background: linear-gradient(135deg, var(--ds-brass) 0%, var(--ds-brass-soft) 50%, var(--ds-brass-deep) 100%);
    box-shadow:
      0 0 0 2px var(--ds-velvet-deep),
      0 0 0 4px var(--ds-brass-deep),
      0 8px 18px rgba(0, 0, 0, 0.6);
  }
  .ds__sanctum-frame > img {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
    background: var(--ds-velvet-deep);
  }
  .ds__nameplate {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.20em;
    color: var(--ds-ink-mid);
  }
  .ds__nameplate span { color: var(--ds-brass); font-weight: 700; }
  .ds__sanctum:hover .ds__sanctum-frame {
    box-shadow:
      0 0 0 2px var(--ds-velvet-deep),
      0 0 0 4px var(--ds-brass),
      0 12px 28px rgba(212, 164, 55, 0.25);
  }
  .ds__sanctum.ds__sanctum--knelt .ds__sanctum-frame {
    animation: ds-sanctum-flash 0.9s ease-out 1;
  }
  @keyframes ds-sanctum-flash {
    0%   { filter: brightness(1); }
    25%  { filter: brightness(1.4) drop-shadow(0 0 18px rgba(246, 193, 94, 0.6)); }
    100% { filter: brightness(1); }
  }

  /* Incense smoke */
  .ds__smoke {
    position: absolute;
    bottom: 21%;
    width: 12px;
    height: 80px;
    pointer-events: none;
  }
  .ds__smoke--left { left: 26%; }
  .ds__smoke--right { right: 26%; }
  .ds__smoke span {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 8px;
    height: 8px;
    background: rgba(244, 231, 200, 0.18);
    border-radius: 50%;
    transform: translateX(-50%);
    animation: ds-smoke-rise 4.5s ease-out infinite;
  }
  .ds__smoke span:nth-child(1) { animation-delay: 0s; }
  .ds__smoke span:nth-child(2) { animation-delay: 1.5s; }
  .ds__smoke span:nth-child(3) { animation-delay: 3s; }
  @keyframes ds-smoke-rise {
    0%   { opacity: 0; transform: translate(-50%, 0) scale(0.4); }
    20%  { opacity: 0.6; }
    60%  { opacity: 0.4; transform: translate(calc(-50% + 4px), -60px) scale(1); }
    100% { opacity: 0; transform: translate(calc(-50% - 4px), -100px) scale(1.4); }
  }

  /* Readout */
  .ds__readout {
    display: flex;
    justify-content: center;
    gap: clamp(12px, 2vw, 32px);
    padding: clamp(8px, 1.5vh, 16px) 0;
    flex-wrap: wrap;
  }
  .ds__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 18px;
    border: 1px solid var(--ds-brass-deep);
    background: rgba(0, 0, 0, 0.3);
    min-width: 130px;
  }
  .ds__panel-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ds-ink-dim);
  }
  .ds__panel-value {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 800;
    color: var(--ds-flame);
    letter-spacing: 0.04em;
    text-shadow: 0 0 10px rgba(246, 193, 94, 0.35);
  }

  /* How */
  .ds__how {
    max-width: 580px;
    margin: clamp(20px, 3vh, 36px) auto 0;
    padding: 18px 16px 0;
    border-top: 1px solid rgba(212, 164, 55, 0.18);
  }
  .ds__how p {
    font-family: 'Lora', Georgia, serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ds-ink-mid);
    margin-bottom: 10px;
    text-align: center;
  }
</style>

<script>
  // ── Day-of-year deterministic Noun ────────────────────
  function dayOfYearUTC() {
    const now = new Date();
    const start = Date.UTC(now.getUTCFullYear(), 0, 0);
    const diff = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - start;
    return Math.floor(diff / 86400000); // 1..366
  }
  function todayNoun() {
    const yr = new Date().getUTCFullYear();
    const doy = dayOfYearUTC();
    // Mix year + doy so two consecutive years' day-1 give different Nouns
    return (yr * 7 + doy * 13) % 1200;
  }

  // ── Audio ────────────────────────────────────────────
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  function playApexBell() {
    const a = ctx(); const t = a.currentTime;
    const f = 587.33; // D5 — bright shrine bell
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.36, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 2.4);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.13, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 2.5); o2.start(t); o2.stop(t + 1.7);
  }
  function playKneel() {
    // Soft low gong for the kneel — different timbre than the apex bell
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 146.83; // D3 — low
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 146.83 * 2;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 600;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.34, t + 0.04); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.8);
    o.connect(filt); o2.connect(filt); filt.connect(g); g.connect(a.destination);
    o.start(t); o2.start(t); o.stop(t + 1.9); o2.stop(t + 1.9);
  }

  // ── Date helpers ─────────────────────────────────────
  function pad(n) { return String(n).padStart(2, '0'); }
  function fmtDate(d) {
    const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
    return `${months[d.getUTCMonth()]} ${d.getUTCDate()}`;
  }
  function fmtDur(ms) {
    const s = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = s % 60;
    return `${pad(h)}:${pad(m)}:${pad(ss)}`;
  }
  function untilNextRotationMs() {
    const now = new Date();
    const next = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1, 0, 0, 0, 0));
    return next.getTime() - now.getTime();
  }

  // ── State ────────────────────────────────────────────
  // Counters keyed by date so they reset each UTC day.
  const dateKey = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
  const RINGS_KEY = `pc:shrine:rings:${dateKey}`;
  const KNEELS_KEY = `pc:shrine:kneels:${dateKey}`;
  let rings = 0, kneels = 0;
  try {
    rings = parseInt(localStorage.getItem(RINGS_KEY) || '0', 10) || 0;
    kneels = parseInt(localStorage.getItem(KNEELS_KEY) || '0', 10) || 0;
  } catch {}

  const dateEl = document.getElementById('ds-date');
  const dayEl = document.getElementById('ds-day');
  const nounEl = document.getElementById('ds-noun');
  const nounNumEl = document.getElementById('ds-noun-num');
  const bellBtn = document.getElementById('ds-bell');
  const sanctumBtn = document.getElementById('ds-sanctum');
  const ringsEl = document.getElementById('ds-rings');
  const kneelsEl = document.getElementById('ds-kneels');
  const countdownEl = document.getElementById('ds-countdown');

  function paint() {
    if (ringsEl) ringsEl.textContent = String(rings);
    if (kneelsEl) kneelsEl.textContent = String(kneels);
  }

  function bootstrap() {
    const noun = todayNoun();
    const doy = dayOfYearUTC();
    if (nounEl) {
      nounEl.src = `https://noun.pics/${noun}.svg`;
      nounEl.alt = `Today's Noun #${noun}`;
    }
    if (nounNumEl) nounNumEl.textContent = String(noun).padStart(4, '0');
    if (dateEl) dateEl.textContent = fmtDate(new Date());
    if (dayEl) dayEl.textContent = `DAY ${doy}`;
    paint();
  }

  // ── Click handlers ───────────────────────────────────
  let bellCooldown = false;
  bellBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (bellCooldown) return;
    bellCooldown = true;
    try { playApexBell(); } catch {}
    if (bellBtn) {
      bellBtn.classList.remove('ds__bell--ringing');
      void bellBtn.offsetWidth;
      bellBtn.classList.add('ds__bell--ringing');
    }
    rings += 1;
    try { localStorage.setItem(RINGS_KEY, String(rings)); } catch {}
    paint();
    setTimeout(() => { bellCooldown = false; }, 700);
  });

  let kneelCooldown = false;
  sanctumBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (kneelCooldown) return;
    kneelCooldown = true;
    try { playKneel(); } catch {}
    if (sanctumBtn) {
      sanctumBtn.classList.remove('ds__sanctum--knelt');
      void sanctumBtn.offsetWidth;
      sanctumBtn.classList.add('ds__sanctum--knelt');
    }
    kneels += 1;
    try { localStorage.setItem(KNEELS_KEY, String(kneels)); } catch {}
    paint();
    setTimeout(() => { kneelCooldown = false; }, 1000);
  });

  // ── Countdown loop ───────────────────────────────────
  function paintCountdown() {
    if (countdownEl) countdownEl.textContent = fmtDur(untilNextRotationMs());
  }
  setInterval(paintCountdown, 1000);
  paintCountdown();
  bootstrap();
</script>
