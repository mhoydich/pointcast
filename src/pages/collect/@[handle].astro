---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { listPublicCollectors, type PublicCollector } from '../../lib/collect-public';

export async function getStaticPaths() {
  const collectors = await listPublicCollectors();
  return collectors.map((collector) => ({ params: { handle: collector.handle }, props: { collector } }));
}

const { collector } = Astro.props as { collector: PublicCollector };
const title = `@${collector.handle} · Collector`;
const description = `${collector.counts.dogs} of 30 September sittings collected, ${collector.streak}-day streak, ${collector.counts.seals} seals.`;
const ownerShort = `${collector.owner.slice(0, 7)}…${collector.owner.slice(-5)}`;
const claimed = new Set(collector.claimedDays);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: title,
  url: collector.url,
  description,
  mainEntity: {
    '@type': 'Person',
    name: collector.profile.name || `@${collector.handle}`,
    identifier: collector.owner,
    image: collector.noun,
  },
};
---

<BlockLayout legacy title={title} description={description} image={collector.og} hideAds>
  <main class="public-collector">
    <nav><a href="/">PointCast</a><span>/</span><a href="/collect">Collect</a><span>/</span><strong>@{collector.handle}</strong><a class="json" href={`/collect/@${collector.handle}.json`}>JSON</a></nav>
    <header>
      <div><p>PUBLIC COLLECTOR · PROFILE OBJECT OWNED</p><h1>@{collector.handle}</h1><span>{collector.profile.name || 'PointCast collector'}</span></div>
      <img src={collector.noun} alt={`Noun for @${collector.handle}`} width="512" height="512" />
    </header>
    <section class="ledger" aria-label="Collector totals">
      <div><span>Dogs</span><strong>{collector.counts.dogs} / 30</strong></div>
      <div><span>Streak</span><strong>{collector.streak} days</strong></div>
      <div><span>Seals</span><strong>{collector.counts.seals}</strong></div>
      <div><span>Mugs / Nouns</span><strong>{collector.counts.mugs} / {collector.counts.nouns}</strong></div>
    </section>
    <ol class="public-grid" aria-label={`Kennel Club collection for @${collector.handle}`}>
      {collector.calendar.map((sitting) => (
        <li class:list={[claimed.has(sitting.day) && 'held']}>
          <a href={sitting.href}>
            {claimed.has(sitting.day) ? <img src={sitting.image} alt={sitting.name} width="1024" height="1280" loading="lazy" /> : <span>{String(sitting.day).padStart(2, '0')}</span>}
            <small>{claimed.has(sitting.day) ? sitting.name : 'Missing'}</small>
          </a>
        </li>
      ))}
    </ol>
    <footer><span>Owner <a href={`https://tzkt.io/${collector.owner}`}>{ownerShort}</a></span><span>{collector.source}</span></footer>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </main>
</BlockLayout>

<style>
  .public-collector{--blue:#185fa5;width:min(1080px,calc(100vw - 24px));margin:0 auto;padding:18px 0 90px;color:#171717}.public-collector nav,.public-collector header p,.public-collector header span,.ledger span,.public-grid small,.public-collector footer{font-family:var(--pc-font-mono);letter-spacing:.09em;text-transform:uppercase}.public-collector nav{display:flex;gap:8px;padding:10px 0;border-bottom:2px solid var(--blue);font-size:10px}.json{margin-left:auto}.public-collector header{display:grid;grid-template-columns:1fr 180px;border:1.5px solid var(--blue);border-top:0;background:#fff}.public-collector header>div{padding:28px}.public-collector header p{margin:0;color:var(--blue);font-size:9px}.public-collector h1{margin:9px 0 4px;font-size:clamp(52px,10vw,118px);font-weight:500;letter-spacing:-.07em;line-height:.85}.public-collector header span{font-size:10px}.public-collector header img{width:100%;height:100%;object-fit:cover;border-left:1.5px solid var(--blue)}.ledger{display:grid;grid-template-columns:repeat(4,1fr);border:1.5px solid var(--blue);border-top:0}.ledger div{display:grid;gap:8px;padding:13px;border-right:1px solid var(--blue)}.ledger div:last-child{border-right:0}.ledger span{font-size:8px;color:#59636d}.ledger strong{font-weight:500}.public-grid{display:grid;grid-template-columns:repeat(6,1fr);margin:24px 0 0;padding:0;border-top:1px solid #171717;border-left:1px solid #171717;list-style:none}.public-grid li{min-height:176px;border-right:1px solid #171717;border-bottom:1px solid #171717;background:#f4f0ea}.public-grid a{position:relative;display:grid;height:176px;place-items:center;color:#171717;text-decoration:none;overflow:hidden}.public-grid span{font-size:34px}.public-grid img{width:100%;height:100%;object-fit:cover}.public-grid small{position:absolute;right:5px;bottom:5px;left:5px;padding:4px;background:rgba(255,255,255,.92);font-size:7px}.public-grid li:not(.held) small{position:static;background:transparent;color:#777;text-align:center}.public-collector footer{display:flex;justify-content:space-between;gap:20px;padding:14px;border:1px solid #171717;border-top:0;font-size:8px;line-height:1.5}.public-collector footer span:last-child{text-align:right}@media(max-width:700px){.public-collector header{grid-template-columns:1fr 110px}.ledger{grid-template-columns:1fr 1fr}.ledger div:nth-child(2){border-right:0}.ledger div:nth-child(-n+2){border-bottom:1px solid var(--blue)}.public-grid{grid-template-columns:repeat(3,1fr)}.public-grid li,.public-grid a{min-height:145px;height:145px}.public-collector footer{flex-direction:column}.public-collector footer span:last-child{text-align:left}}
</style>
