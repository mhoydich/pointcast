---
/**
 * /links — PointCast's main surfaces as one column of big buttons.
 *
 * Mike asked in chat on 2026-11-10 for "a link tree". Drafted by Claude Code
 * (author cc per VOICE.md); none of the copy is in Mike's voice.
 *
 * This replaces the old public/links/index.html, which only redirected to
 * /linktree/. The long directory stays at /linktree/ and is linked below.
 * Groups are kept by hand in src/data/deck.json; tests/deck-links.test.mjs
 * fails on a dead internal link or an outside link not on the allow list.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import data from '../data/deck.json';

const title = 'Links';
const description = 'PointCast in one list of big buttons: start here, play, listen, read and explore, say something, and the door for AI agents.';
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const [y, m, d] = data.updated.split('-').map(Number);
const updated = `${MONTHS[m - 1]} ${d}, ${y}`;
const isOutside = (href: string) => href.startsWith('https://');
---

<BlockLayout title={title} description={description} author="PointCast · Claude Code" hideAds showNetworkStrip={false}>
  <div class="links-page">
    <p class="links-kicker">POINTCAST · LINKS</p>
    <h1 class="links-title">PointCast</h1>
    <p class="links-lead">A broadcast from El Segundo: blocks to read, games to play, things to hear, and a door for AI agents.</p>

    {data.groups.map((g) => (
      <section class="links-group" aria-labelledby={`links-${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
        <h2 id={`links-${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.title}</h2>
        <ul>
          {g.links.map((l) => (
            <li>
              <a href={l.href} rel={isOutside(l.href) ? 'noopener' : undefined}>
                <span>{l.text}</span><span aria-hidden="true">{isOutside(l.href) ? '↗' : '→'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="links-foot">Updated {updated}. Kept by hand. Drafted by Claude Code for PointCast.</p>
  </div>
</BlockLayout>

<style>
  .links-page { max-width: 520px; margin: 0 auto; padding: 32px 16px 48px; }
  .links-kicker { margin: 0; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.12em; color: var(--pc-ink-muted); text-align: center; }
  .links-title { margin: 6px 0 8px; font-size: clamp(30px, 8vw, 40px); font-weight: 500; line-height: 1.1; text-align: center; }
  .links-lead { margin: 0 0 24px; color: var(--pc-ink-soft); text-align: center; line-height: 1.5; }
  .links-group { margin-top: 24px; }
  .links-group h2 { margin: 0 0 8px; font-family: var(--pc-font-mono); font-size: 11px; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pc-ink-muted); }
  .links-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .links-group a {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    min-height: 56px; padding: 12px 16px;
    color: var(--pc-ink); background: var(--pc-bg);
    border: 1px solid var(--pc-ink); border-radius: 4px;
    font-size: 17px; line-height: 1.3;
  }
  .links-group a:hover { text-decoration: none; background: var(--pc-rule-soft); }
  .links-group a:focus-visible { outline: 2px solid var(--pc-accent); outline-offset: 2px; }
  .links-group a span:last-child { color: var(--pc-accent); flex: none; }
  @media (prefers-reduced-motion: no-preference) { .links-group a { transition: background-color 120ms ease; } }
  .links-foot { margin-top: 32px; font-size: 13px; color: var(--pc-ink-muted); text-align: center; }
</style>
