---
/**
 * PointCast Rosebud — the drum garden room.
 * Directed by Mike on 2026-08-31: "try a new front page drum game ... very rosebud."
 * Built by Codex as the front door on 2026-08-31; moved to its own room on
 * 2026-09-01 when the front door was rebuilt to carry the whole town. The
 * pads still live on the home page as a compact play module (HomePlayFirst).
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { CHANNEL_LIST } from '../lib/channels';

const pads = [
  { id: 'kick', key: 'A', name: 'ROOT', note: 'low & round' },
  { id: 'bloom', key: 'S', name: 'BLOOM', note: 'paper snap' },
  { id: 'dew', key: 'K', name: 'DEW', note: 'silver air' },
  { id: 'thorn', key: 'L', name: 'THORN', note: 'dry bite' },
];

const seedPattern = [
  [true, false, false, false, true, false, false, false, true, false, false, true, true, false, false, false],
  [false, false, false, false, true, false, false, false, false, false, false, false, true, false, false, false],
  [true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, true],
  [false, false, false, false, false, false, true, false, false, false, false, false, false, false, true, false],
];

const steps = Array.from({ length: 16 }, (_, index) => index);
const homeDescription = 'Rosebud is a four-voice drum garden and a sixteen-step sequencer. No sign-in, sound on. Built by Codex as the PointCast front door on 2026-08-31.';
const socialImage = 'https://pointcast.xyz/images/og-pointcast-rosebud.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://pointcast.xyz/rosebud#room',
      name: 'PointCast Rosebud',
      description: homeDescription,
      url: 'https://pointcast.xyz/rosebud',
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://pointcast.xyz/rosebud#rosebud',
      name: 'PointCast Rosebud',
      applicationCategory: 'GameApplication',
      operatingSystem: 'Any modern web browser',
      browserRequirements: 'Web Audio API',
      isAccessibleForFree: true,
      url: 'https://pointcast.xyz/rosebud#rosebud',
      description: 'A four-voice playable drum garden and sixteen-step sequencer.',
    },
  ],
};

const alternates = [
  { type: 'application/json', href: '/blocks.json', title: 'All PointCast blocks (JSON)' },
  { type: 'application/rss+xml', href: '/feed.xml', title: 'PointCast RSS' },
  { type: 'application/feed+json', href: '/feed.json', title: 'PointCast JSON Feed' },
  ...CHANNEL_LIST.map((channel) => ({
    type: 'application/rss+xml',
    href: `/c/${channel.slug}.rss`,
    title: `PointCast · ${channel.name}`,
  })),
];
---

<BlockLayout
  title="Rosebud"
  description={homeDescription}
  image={socialImage}
  imageWidth={1200}
  imageHeight={630}
  themeColor="#e53f47"
  jsonLd={jsonLd}
  alternates={alternates}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Play Rosebud', action: 'link', target: 'https://pointcast.xyz/rosebud#rosebud' },
      { label: 'Enter the drum universe', action: 'link', target: 'https://pointcast.xyz/drum' },
      { label: 'Read the wire', action: 'link', target: 'https://pointcast.xyz/archive' },
    ],
  }}
>
  <div class="rb-home" data-rosebud-home>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="PointCast home">
        <span class="mark-dot">P</span>
        <span>POINTCAST</span>
      </a>
      <div class="live-line"><i></i> LIVE FROM EL SEGUNDO · SIGNAL 104</div>
      <a class="menu-pill" href="/">FRONT DOOR <span>↗</span></a>
    </header>

    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">THE ROSEBUD ROOM · OPENED 08/31 AS A FRONT-DOOR FIELD TEST</p>
        <h1>The internet should make a little <em>noise.</em></h1>
        <p class="dek">PointCast is an agent-native broadcast from El Segundo. Today, the broadcast is you.</p>
        <div class="hero-meta">
          <a href="#rosebud">↓ TOUCH THE ROSEBUD</a>
          <span>NO SIGN-IN · SOUND ON</span>
        </div>
      </div>

      <div class="rose-orbit" aria-hidden="true">
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
        <span class="petal petal-a"></span>
        <span class="petal petal-b"></span>
        <span class="petal petal-c"></span>
        <span class="rose-core">104</span>
        <span class="orbit-copy">SOMETHING IS ALWAYS<br />COMING INTO BLOOM</span>
      </div>
    </section>

    <section class="machine-section" id="rosebud" aria-labelledby="machine-title">
      <div class="machine-topline">
        <div>
          <p class="eyebrow dark">PLAY LAYER / 001</p>
          <h2 id="machine-title">ROSEBUD</h2>
        </div>
        <div class="counter"><span data-hit-count>000</span> blooms sent · pad hits count in the drum house</div>
      </div>

      <div class="machine">
        <div class="machine-labels">
          <span>POINTCAST SOUND SYSTEM</span>
          <span class="serial">PC–RB / 2026</span>
        </div>
        <div class="pads" role="group" aria-label="Rosebud drum pads">
          {pads.map((pad, index) => (
            <button
              class={`drum-pad pad-${index + 1}`}
              type="button"
              data-drum={pad.id}
              aria-label={`Play ${pad.name}: ${pad.note}. Keyboard key ${pad.key}`}
            >
              <span class="keycap">{pad.key}</span>
              <span class="pad-flower" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <strong>{pad.name}</strong>
              <small>{pad.note}</small>
            </button>
          ))}
        </div>
        <div class="machine-footer">
          <p>PLAY WITH <kbd>A</kbd> <kbd>S</kbd> <kbd>K</kbd> <kbd>L</kbd></p>
          <div class="level"><span>SOFT</span><i></i><i></i><i class="on"></i><i class="on"></i><i class="hot"></i><span>LOUD</span></div>
          <p>ONE ROOM · MANY HANDS</p>
        </div>
      </div>
    </section>

    <section class="sequencer-section" aria-labelledby="sequence-title">
      <header class="sequence-head">
        <div>
          <p class="eyebrow">MAKE A 16-PETAL LOOP</p>
          <h2 id="sequence-title">GROW A RHYTHM.</h2>
        </div>
        <p>Every square is a small decision.<br />Turn a few on. Let it repeat.</p>
      </header>

      <div class="transport">
        <button type="button" class="play-button" data-transport aria-pressed="false">
          <span data-transport-icon>▶</span> <b data-transport-copy>START THE BLOOM</b>
        </button>
        <label class="tempo-control">
          <span>TEMPO</span>
          <input data-tempo type="range" min="72" max="148" value="104" />
          <strong data-tempo-copy>104 BPM</strong>
        </label>
        <button type="button" class="shuffle-button" data-shuffle>SHAKE THE GARDEN ↝</button>
      </div>

      <div class="seq-scroller" tabindex="0" aria-label="Scrollable 16-step sequencer">
        <div class="sequence">
          <div class="sequence-numbers" aria-hidden="true">
            <span>VOICE</span>
            {steps.map((step) => <i>{String(step + 1).padStart(2, '0')}</i>)}
          </div>
          {pads.map((pad, row) => (
            <div class="sequence-row">
              <div class="track-name"><i class={`track-dot track-${row + 1}`}></i><strong>{pad.name}</strong><small>{pad.key}</small></div>
              {seedPattern[row].map((on, step) => (
                <button
                  type="button"
                  class:list={{ 'rb-step': true, 'is-on': on }}
                  data-row={row}
                  data-step={step}
                  aria-label={`${on ? 'Remove' : 'Add'} ${pad.name} on step ${step + 1}`}
                  aria-pressed={on ? 'true' : 'false'}
                ><span></span></button>
              ))}
            </div>
          ))}
        </div>
      </div>
      <p class="step-status" data-step-status aria-live="polite">OFF AIR · YOUR PATTERN IS READY</p>
    </section>

    <section class="manifesto">
      <div class="manifesto-lead">
        <p class="eyebrow">WHY THIS DOOR?</p>
        <h2>A SIGNAL,<br /><em>NOT A SCROLL.</em></h2>
      </div>
      <div class="manifesto-grid">
        <article><span>01</span><h3>PLAY FIRST</h3><p>The homepage begins with a gesture. You do something; the signal answers.</p></article>
        <article><span>02</span><h3>NOTICE MORE</h3><p>A tiny daily broadcast, an odd room, a living archive. No infinite feed required.</p></article>
        <article><span>03</span><h3>COME BACK DIFFERENT</h3><p>PointCast is rebuilt in public by humans and agents. The front door should keep surprising us.</p></article>
      </div>
    </section>

    <section class="broadcast-strip" aria-label="PointCast destinations">
      <p class="eyebrow">CONTINUE THE BROADCAST</p>
      <div class="broadcast-links">
        <a href="/digital-pets"><span>FUTURE BOOK 001</span><small>the animal after the internet · living edition</small><b>↗</b></a>
        <a href="/digital-pets/microduck"><span>MICRODUCK / FUTURE BOOK</span><small>full review, open stack, behavior lab, consumer arc</small><b>↗</b></a>
        <a href="/next-models"><span>NEXT MODELS</span><small>Astra, Mythos, open weights, moving image</small><b>↗</b></a>
        <a href="/archive"><span>THE ARCHIVE</span><small>every block, newest first</small><b>↗</b></a>
        <a href="/drum"><span>DRUM UNIVERSE</span><small>rooms, crews, strange instruments</small><b>↗</b></a>
        <a href="/"><span>THE FRONT DOOR</span><small>the whole town, one page</small><b>↗</b></a>
        <a href="/about"><span>ABOUT THE SIGNAL</span><small>from El Segundo, with agents</small><b>↗</b></a>
      </div>
    </section>

    <footer>
      <div class="footer-mark"><span class="mark-dot">P</span><strong>POINTCAST</strong></div>
      <p>IT IS NEVER FINISHED.<br />IT IS JUST ON AIR.</p>
      <div class="footer-signal"><i></i> EL SEGUNDO, CA<br />33.9192° N · 118.4165° W</div>
    </footer>
  </div>

  <script is:inline>
    (() => {
      const home = document.querySelector('[data-rosebud-home]');
      if (!home || home.dataset.ready === 'true') return;
      home.dataset.ready = 'true';
      document.body.classList.add('rosebud-body');

      const padIds = ['kick', 'bloom', 'dew', 'thorn'];
      const keyMap = { a: 'kick', s: 'bloom', k: 'dew', l: 'thorn' };
      const pattern = [
        [true, false, false, false, true, false, false, false, true, false, false, true, true, false, false, false],
        [false, false, false, false, true, false, false, false, false, false, false, false, true, false, false, false],
        [true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, true],
        [false, false, false, false, false, false, true, false, false, false, false, false, false, false, true, false],
      ];
      let audio = null;
      let hitCount = 0;
      let playing = false;
      let currentStep = 0;
      let timer = null;
      let bpm = 104;

      // --- Drum house bus -------------------------------------------------
      // Same localStorage key as DrumModule / drum.astro, so one visitor is one drummer everywhere.
      const SESSION_KEY = 'pc:reactSessionId';
      const sessionId = (() => {
        try {
          let id = localStorage.getItem(SESSION_KEY);
          if (!id) {
            id = crypto.randomUUID?.() ?? `s-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
            localStorage.setItem(SESSION_KEY, id);
          }
          return id;
        } catch {
          return `s-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
        }
      })();
      // Batched delta to POST /api/drum: every ten hits or five seconds, whichever comes first.
      // functions/api/drum.ts clamps one delta to 1000 and answers { ok, globalTotal, yourTotal }.
      let pendingDelta = 0;
      let flushTimer = null;
      const flushDelta = async () => {
        if (pendingDelta <= 0) return;
        const delta = pendingDelta;
        pendingDelta = 0;
        if (flushTimer) { clearTimeout(flushTimer); flushTimer = null; }
        try {
          const res = await fetch('/api/drum', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ delta, sessionId }),
            keepalive: true,
          });
          if (!res.ok) throw new Error(String(res.status));
        } catch {
          pendingDelta += delta;
        }
      };
      const queueDrum = () => {
        pendingDelta += 1;
        if (pendingDelta >= 10) { flushDelta(); return; }
        if (flushTimer) clearTimeout(flushTimer);
        flushTimer = window.setTimeout(flushDelta, 5000);
      };
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flushDelta(); });
      window.addEventListener('pagehide', () => {
        if (pendingDelta <= 0) return;
        const delta = pendingDelta;
        pendingDelta = 0;
        try { navigator.sendBeacon('/api/drum', new Blob([JSON.stringify({ delta, sessionId })], { type: 'application/json' })); } catch {}
      });
      // Shared sounds bus: the body HomeBeatDesk sends, throttled so one visitor cannot flood it, best effort.
      const padOrder = ['kick', 'bloom', 'dew', 'thorn'];
      let lastBroadcast = 0;
      const broadcast = (drum) => {
        const now = Date.now();
        if (now - lastBroadcast < 900) return;
        lastBroadcast = now;
        try {
          fetch('/api/sounds', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'drum', seed: padOrder.indexOf(drum), sessionId }),
            keepalive: true,
          }).catch(() => {});
        } catch {}
      };

      const ensureAudio = () => {
        if (!audio) audio = new AudioContext();
        if (audio.state === 'suspended') audio.resume();
        return audio;
      };

      const hit = (drum) => {
        const context = ensureAudio();
        const now = context.currentTime;
        const gain = context.createGain();
        gain.connect(context.destination);

        if (drum === 'kick') {
          const osc = context.createOscillator();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(148, now);
          osc.frequency.exponentialRampToValueAtTime(43, now + 0.28);
          gain.gain.setValueAtTime(0.82, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
          osc.connect(gain);
          osc.start(now);
          osc.stop(now + 0.32);
        } else {
          const size = Math.floor(context.sampleRate * 0.38);
          const buffer = context.createBuffer(1, size, context.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < size; i += 1) data[i] = Math.random() * 2 - 1;
          const noise = context.createBufferSource();
          const filter = context.createBiquadFilter();
          noise.buffer = buffer;
          filter.type = drum === 'bloom' ? 'bandpass' : 'highpass';
          filter.frequency.value = drum === 'bloom' ? 1450 : drum === 'dew' ? 7600 : 3100;
          filter.Q.value = drum === 'bloom' ? 0.75 : 1.2;
          gain.gain.setValueAtTime(drum === 'bloom' ? 0.46 : 0.24, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + (drum === 'dew' ? 0.075 : 0.18));
          noise.connect(filter);
          filter.connect(gain);
          noise.start(now);
          noise.stop(now + 0.38);
        }

        const pad = home.querySelector(`[data-drum="${drum}"]`);
        pad?.classList.add('is-hit');
        window.setTimeout(() => pad?.classList.remove('is-hit'), 105);
        hitCount += 1;
        const count = home.querySelector('[data-hit-count]');
        if (count) count.textContent = String(hitCount).padStart(3, '0');
      };

      // A hand hit: the voice, plus the drum house. The sequencer plays hit() on its own and does not count.
      const strike = (drum) => {
        hit(drum);
        queueDrum();
        broadcast(drum);
      };

      const paintStep = (step) => {
        home.querySelectorAll('.rb-step').forEach((button) => {
          button.classList.toggle('is-current', Number(button.dataset.step) === step);
        });
        const status = home.querySelector('[data-step-status]');
        if (status) status.textContent = `ON AIR · PETAL ${step + 1} OF 16`;
      };

      const tick = () => {
        pattern.forEach((row, rowIndex) => {
          if (row[currentStep]) hit(padIds[rowIndex]);
        });
        paintStep(currentStep);
        currentStep = (currentStep + 1) % 16;
      };

      const startClock = () => {
        window.clearInterval(timer);
        tick();
        timer = window.setInterval(tick, 60000 / bpm / 4);
      };

      const transport = home.querySelector('[data-transport]');
      transport?.addEventListener('click', () => {
        ensureAudio();
        playing = !playing;
        transport.classList.toggle('is-playing', playing);
        transport.setAttribute('aria-pressed', String(playing));
        const icon = home.querySelector('[data-transport-icon]');
        const copy = home.querySelector('[data-transport-copy]');
        if (icon) icon.textContent = playing ? '■' : '▶';
        if (copy) copy.textContent = playing ? 'STOP THE BLOOM' : 'START THE BLOOM';
        if (playing) startClock();
        else {
          window.clearInterval(timer);
          currentStep = 0;
          home.querySelectorAll('.rb-step').forEach((button) => button.classList.remove('is-current'));
          const status = home.querySelector('[data-step-status]');
          if (status) status.textContent = 'OFF AIR · YOUR PATTERN IS READY';
        }
      });

      home.querySelectorAll('[data-drum]').forEach((button) => {
        button.addEventListener('pointerdown', () => strike(button.dataset.drum));
      });

      home.querySelectorAll('.rb-step').forEach((button) => {
        button.addEventListener('click', () => {
          const row = Number(button.dataset.row);
          const step = Number(button.dataset.step);
          pattern[row][step] = !pattern[row][step];
          button.classList.toggle('is-on', pattern[row][step]);
          button.setAttribute('aria-pressed', String(pattern[row][step]));
          const name = home.querySelectorAll('.track-name strong')[row]?.textContent || 'voice';
          button.setAttribute('aria-label', `${pattern[row][step] ? 'Remove' : 'Add'} ${name} on step ${step + 1}`);
        });
      });

      const tempo = home.querySelector('[data-tempo]');
      tempo?.addEventListener('input', () => {
        bpm = Number(tempo.value);
        const copy = home.querySelector('[data-tempo-copy]');
        if (copy) copy.textContent = `${bpm} BPM`;
        if (playing) startClock();
      });

      home.querySelector('[data-shuffle]')?.addEventListener('click', () => {
        const densities = [0.3, 0.17, 0.55, 0.16];
        pattern.forEach((row, rowIndex) => row.forEach((_, step) => {
          row[step] = rowIndex === 0 && step === 0 ? true : Math.random() < densities[rowIndex];
          home.querySelector(`.rb-step[data-row="${rowIndex}"][data-step="${step}"]`)?.classList.toggle('is-on', row[step]);
        }));
      });

      window.addEventListener('keydown', (event) => {
        if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
        const drum = keyMap[event.key.toLowerCase()];
        if (drum) strike(drum);
      });
    })();
  </script>
</BlockLayout>

<style is:global>
  body.rosebud-body { padding-bottom: 0 !important; }
</style>

<style>
  :root {
    --rb-paper: #f5efdf;
    --rb-ink: #1e231c;
    --rb-rose: #e53f47;
    --rb-blush: #f3a0a6;
    --rb-yellow: #f4d83e;
  }

  .rb-home { min-height: 100vh; overflow: hidden; background: var(--rb-paper); color: var(--rb-ink); font-family: Arial, Helvetica, sans-serif; background-image: radial-gradient(circle at 12% 4%, rgba(255,255,255,.7), transparent 31%); }
  .rb-home button, .rb-home a, .rb-home input { font: inherit; }
  .rb-home button { color: inherit; }
  .site-header { height: 76px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 4vw; border-bottom: 1.5px solid var(--rb-ink); font-size: 11px; font-weight: 800; letter-spacing: .1em; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; width: max-content; }
  .mark-dot { width: 32px; height: 32px; border-radius: 50%; background: var(--rb-rose); color: var(--rb-paper); display: grid; place-items: center; font-family: Georgia, serif; font-style: italic; font-size: 18px; letter-spacing: 0; }
  .live-line { display: flex; align-items: center; gap: 8px; }
  .live-line i { width: 7px; height: 7px; border-radius: 50%; background: var(--rb-rose); box-shadow: 0 0 0 5px rgba(229,63,71,.12); animation: rb-pulse 1.8s infinite; }
  .menu-pill { justify-self: end; border: 1.5px solid var(--rb-ink); border-radius: 999px; padding: 10px 15px; color: inherit; text-decoration: none; font-size: 10px; font-weight: 800; letter-spacing: .08em; }
  .menu-pill span { margin-left: 12px; }
  .hero { position: relative; min-height: 565px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(340px, .8fr); align-items: center; gap: 5vw; padding: 70px 6vw 64px; border-bottom: 1.5px solid var(--rb-ink); }
  .hero-copy { position: relative; z-index: 2; max-width: 850px; }
  .eyebrow { margin: 0 0 27px; font-size: 11px; font-weight: 900; letter-spacing: .16em; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(68px, 8.2vw, 134px); line-height: .82; letter-spacing: -.075em; font-weight: 900; text-transform: uppercase; }
  h1 em { color: var(--rb-rose); font-family: Georgia, 'Times New Roman', serif; font-weight: 400; text-transform: lowercase; letter-spacing: -.06em; }
  .dek { max-width: 580px; margin: 34px 0 0 20%; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(20px, 2vw, 29px); line-height: 1.18; }
  .hero-meta { margin-top: 45px; display: flex; justify-content: space-between; gap: 30px; border-top: 1px solid var(--rb-ink); padding-top: 13px; font-size: 9px; font-weight: 900; letter-spacing: .14em; }
  .hero-meta a { color: inherit; text-decoration: none; }
  .hero-meta a:hover { color: var(--rb-rose); }
  .rose-orbit { position: relative; aspect-ratio: 1; width: min(38vw, 500px); justify-self: center; display: grid; place-items: center; }
  .orbit { position: absolute; border: 1.5px solid var(--rb-ink); border-radius: 50%; }
  .orbit-one { inset: 3%; }
  .orbit-two { inset: 21%; border-style: dashed; animation: rb-spin 18s linear infinite; }
  .rose-core { width: 108px; height: 108px; border-radius: 50%; display: grid; place-items: center; z-index: 2; background: var(--rb-yellow); border: 1.5px solid var(--rb-ink); font-size: 35px; font-weight: 900; letter-spacing: -.08em; box-shadow: 8px 9px 0 var(--rb-ink); }
  .petal { position: absolute; width: 38%; height: 25%; background: var(--rb-blush); border: 1.5px solid var(--rb-ink); border-radius: 70% 25% 70% 25%; transform-origin: 100% 50%; }
  .petal-a { transform: translateX(-42%) rotate(16deg); }
  .petal-b { transform: translateY(-40%) rotate(126deg); background: var(--rb-rose); }
  .petal-c { transform: translate(18%, 36%) rotate(245deg); background: #ff6b6c; }
  .orbit-copy { position: absolute; bottom: 8%; right: -3%; font-size: 9px; line-height: 1.4; font-weight: 900; letter-spacing: .1em; transform: rotate(-8deg); }
