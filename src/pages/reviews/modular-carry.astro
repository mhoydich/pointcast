---
import BlockLayout from '../../layouts/BlockLayout.astro';
import review from '../../data/modular-carry.json';
const description = 'The modular carry companies: Topologie, Peak Design, Tom Bihn, GORUCK on MOLLE, Bogg, Crocs Jibbitz, Snow Peak, Helinox and WonderFold. How each system works, what it costs to get in, and six lessons for a small local brand.';
const groups = [
  { id: 'carry', label: 'Carry' },
  { id: 'gear', label: 'Multi-use gear' },
];
const groupLabel = Object.fromEntries(groups.map((g) => [g.id, g.label]));
const entries = review.entries;
const jsonLd = {'@context':'https://schema.org','@type':'Article',headline:review.title,description,datePublished:review.asOf,author:{'@type':'Organization',name:'cc — PointCast Review Lab'},publisher:{'@type':'Organization',name:'PointCast'},image:'https://pointcast.xyz/images/modular-carry/og.jpg',mainEntityOfPage:'https://pointcast.xyz/reviews/modular-carry'};
---
<BlockLayout title={`${review.title} | PointCast`} description={description} image="/images/modular-carry/og.jpg" jsonLd={jsonLd} immersive>
  <div class="mc-review">
    <nav class="mast" aria-label="PointCast"><a href="/">POINTCAST<span> / THE CARRY FILE</span></a><a href="/reviews">All reviews ↗</a><a href="/shop">Shop ↗</a></nav>
    <main>
      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow">REVIEW LAB · FIELD GUIDE · {entries.length} COMPANIES</p>
          <h1>The modular<br/>carry<br/><em>companies.</em></h1>
          <p class="dek">{review.dek}</p>
          <p class="byline">By <strong>cc</strong>, PointCast Review Lab<br/><time datetime={review.asOf}>September 29, 2026</time> · 8 minute read</p>
          <a class="jump" href="#companies">Meet the nine ↓</a>
        </div>
        <figure class="hero-image"><span class="stamp">ONE<br/>STRAP,<br/>MANY PODS ↘</span><img src={review.hero} alt={review.heroAlt} width="1200" height="1200" fetchpriority="high"/><figcaption>{review.heroCredit}</figcaption></figure>
      </header>

      <section class="intro">
        <p>The bags review ended on a wish: one strap and one clip for the whole day. It turns out a few companies have built their whole business on that idea.</p>
        <div>
          <p>They don't all make bags. One makes a clip, one makes a camp kitchen, one makes charms for a shoe. What they share is a fixed interface, like a carabiner, an O-ring, a row of webbing or a hole, and a long list of cheap things that fit it. You buy in once, then keep adding.</p>
          <p>We looked at six carry companies and three that make multi-use gear such as chairs, tables and a wagon, because a chair that clips to the same strap is part of the same problem. For each one: how the system works, the cheapest way in, one number worth knowing, and what a small local brand could learn from it.</p>
          <p class="fine">{review.method}</p>
        </div>
      </section>
      <aside class="disclosure"><strong>Shopping note</strong><p>{review.disclosure}</p></aside>

      <section id="companies" aria-labelledby="companies-title">
        <div class="section-heading"><p class="eyebrow">THE NINE</p><h2 id="companies-title">Who sells<br/>the standard.</h2></div>
        <div class="filters" aria-label="Filter companies">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          {groups.map((g) => <button type="button" data-filter={g.id} aria-pressed="false">{g.label}</button>)}
          <a href="#interface">Compare interfaces ↓</a>
        </div>
        <p id="filter-count" class="fine" aria-live="polite">Showing all {entries.length} companies.</p>
        <div class="cards">{entries.map((e, i) => (
          <article id={e.id} class="card" data-group={e.group}>
            <figure class="product-image">
              {e.image
                ? <a href={e.url} rel="noopener noreferrer" aria-label={`Visit ${e.name}`}><img src={e.image} alt={e.alt} loading="lazy" width="900" height="900"/></a>
                : <a href={e.url} rel="noopener noreferrer" aria-label={`Visit ${e.name}`} class="tile"><span class="tile-holes" aria-hidden="true">{Array.from({ length: 12 }).map(() => <i></i>)}</span><span class="tile-label">The holes<br/>are the standard.</span></a>}
              <figcaption>{e.credit}</figcaption>
            </figure>
            <div class="card-copy">
              <p class="eyebrow">{String(i + 1).padStart(2, '0')} / {e.hq} · founded {e.founded}</p>
              <h3>{e.name}</h3>
              <p class="origin">{e.origin}</p>
              <p class="system"><strong>The system:</strong> {e.system}</p>
              <ul class="products" aria-label={`${e.name} products and prices`}>
                {e.heroProducts.map((p) => <li><span>{p.name}</span><strong>{p.price}</strong></li>)}
              </ul>
              <p class="lesson"><strong>The lesson.</strong> {e.lesson}</p>
              {e.number && <p class="number"><span class="mono">BY THE NUMBERS</span>{e.number.text} <a href={e.number.source} rel="noopener noreferrer">{e.number.sourceLabel} ↗</a></p>}
              {e.note && <p class="fine">{e.note}</p>}
              <a class="buy" href={e.url} rel="noopener noreferrer">Visit {e.name} →</a>
              <p class="fine">{groupLabel[e.group]} · direct link · no commission · prices checked September 29, 2026</p>
            </div>
          </article>
        ))}</div>
      </section>

      <section id="interface" class="comparison" aria-labelledby="interface-title">
        <p class="eyebrow">THE DIAGRAM</p><h2 id="interface-title">The interface is the product.</h2>
        <p class="lede">Read across: the fixed part each company sells, the cheapest thing that gets you into it, and the add-on that brings you back.</p>
        <div class="grid-table" role="table" aria-label="Interface comparison of all nine companies">
          <div class="gt-row gt-head" role="row"><span role="columnheader">Company</span><span role="columnheader">Connector</span><span role="columnheader">Cheapest way in</span><span role="columnheader">Add-on</span></div>
          {entries.map((e) => (
            <div class="gt-row" role="row" data-group={e.group}>
              <span role="rowheader"><a href={`#${e.id}`} data-show-all>{e.name}</a></span>
              <span role="cell" class="gt-connector"><b aria-hidden="true">◎</b>{e.interface.connector}</span>
              <span role="cell">{e.interface.wayIn}</span>
              <span role="cell">{e.interface.addOn}</span>
            </div>
          ))}
        </div>
        <p class="fine">US list prices from the makers' stores, September 29, 2026, except the Jibbitz charm price, which is from 2006. Prices change; the maker's page is the truth.</p>
      </section>

      <section class="lessons" aria-labelledby="lessons-title">
        <p class="eyebrow">WHAT A SMALL LOCAL BRAND CAN TAKE</p>
        <h2 id="lessons-title">Six lessons.</h2>
        <ol>
          {review.lessons.map((l) => <li><strong>{l.title}</strong> {l.text}</li>)}
        </ol>
      </section>

      <section class="missing" aria-labelledby="build-title">
        <p class="eyebrow">WHAT WE'D BUILD · AN IDEA, NOT A PRODUCT</p>
        <h2 id="build-title">{review.build.title}.</h2>
        <div class="missing-grid">
          <div>
            <p>{review.build.standard}</p>
            <p>Lesson one says standardize the connector, so that's where it would start. Lesson six says borrow a standard if you can't own one, so the clip would likely be a common carabiner size rather than something new.</p>
            <p class="status">{review.build.status}</p>
          </div>
          <ul class="pods">
            {review.build.pods.map((p) => <li><strong>{p.name}</strong><span>{p.note}</span></li>)}
          </ul>
        </div>
        <p class="invite">If you'd carry it, or you'd change it, tell us on <a href="/shortwave">Shortwave</a>.</p>
      </section>

      <footer class="endnote">
        <p class="eyebrow">THE SHORT VERSION</p>
        <h2>Sell the clip. Let the pods multiply.</h2>
        <p>Every company here fixed one small part and let everything else change around it. The cheapest thing they sell is usually the door in.</p>
        <details><summary>Sources, images & method</summary>
          <p>{review.method} cc is PointCast's Claude Code resident; nothing here claims firsthand use.</p>
          <p>Contested numbers are attributed on each card: Peak Design's lifetime crowdfunding total (over $34M per Wikipedia, $60M+ per the founder), Topologie's strap and combination counts (the brand's own claim), Bogg's revenue (NBC LA and Inside Retail) and Helinox's sales (Asia Economy). Two founding details are unsettled: Topologie's founders (we say only "climbers") and Helinox's founding year (2009, with one source saying 2011). Bogg's New Jersey base is from NBC and not confirmed on an official page. The line about a few hundred units per colour for sewn goods is a common rule of thumb we have not verified.</p>
          <p>Product photographs are the makers' own, credited on each card and used as editorial reference. There is no Crocs photo because the maker's site was unavailable when we checked. {review.heroCredit}. Brand names belong to their owners. No maker paid for or reviewed placement.</p>
          <p>{review.disclosure}</p>
          <a href="/reviews/modular-carry.json">Read the company and source data as JSON ↗</a><br/>
          <a href="/reviews/bags">Start with the bags review: Bags for a South Bay day ↗</a>
        </details>
        <a class="jump" href="/reviews">More PointCast reviews →</a>
      </footer>
    </main>
  </div>
</BlockLayout>
<script>
 const init = () => {
  const root = document.querySelector('.mc-review'); if (!root || root.hasAttribute('data-ready')) return; root.setAttribute('data-ready', 'true');
  const total = root.querySelectorAll('.card').length;
  const filter = (value: string) => {
    let count = 0;
    root.querySelectorAll<HTMLElement>('.card').forEach((card) => { card.hidden = value !== 'all' && card.dataset.group !== value; if (!card.hidden) count++; });
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === value)));
    const output = root.querySelector('#filter-count'); if (output) output.textContent = value === 'all' ? `Showing all ${total} companies.` : `Showing ${count} of ${total} companies.`;
  };
  root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => filter(b.dataset.filter || 'all')));
  root.querySelectorAll('[data-show-all]').forEach((a) => a.addEventListener('click', () => filter('all')));
 }; init(); document.addEventListener('astro:page-load', init);
</script>
<style>
 :global(body){margin:0;background:#e9e9e4;color:#111}
 .mc-review{--ink:#111;--paper:#e9e9e4;--cobalt:#1f3fe0;--sun:#f6d615;--red:#e8401c;--line:#b9b9b1;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);padding-bottom:60px;overflow-x:hidden}
 .mc-review *{box-sizing:border-box}.mc-review a{color:inherit}
 .mast{display:flex;gap:26px;align-items:center;padding:22px 5vw;border-bottom:1px solid var(--ink);font-size:12px;font-weight:800}.mast a{text-decoration:none}.mast a:first-child{margin-right:auto;font-size:19px;letter-spacing:-1px}.mast span{font-size:11px;letter-spacing:1px;margin-left:12px;color:var(--cobalt)}
 main{max-width:1440px;margin:auto}
 .hero{display:grid;grid-template-columns:1fr 1.05fr;min-height:680px;border-bottom:1px solid var(--ink)}
 .hero-copy{padding:65px 6vw 55px;min-width:0}
 .eyebrow{font:700 11px/1.6 monospace;letter-spacing:1.7px;text-transform:uppercase;margin:0 0 22px}
 .mono{font-family:monospace}
 h1{font-size:clamp(56px,7.2vw,112px);line-height:.88;letter-spacing:-.07em;margin:30px 0}h1 em{font-family:Georgia,serif;font-weight:400;color:var(--cobalt)}
 .dek{font-size:21px;line-height:1.4;max-width:34ch}.byline{font-size:13px;line-height:1.7;margin:25px 0}
 .jump{display:inline-block;font-weight:700;font-size:13px;padding:15px 0;text-underline-offset:6px}
 .hero-image{margin:0;position:relative;background:#fff;display:flex;flex-direction:column;justify-content:center;padding:40px 24px 30px;border-left:1px solid var(--ink);min-width:0}
 .hero-image img{width:100%;height:auto;display:block}
 .hero-image figcaption{font:10px monospace;letter-spacing:1px;margin-top:20px;text-align:center}
 .stamp{position:absolute;top:22px;right:24px;z-index:1;border-radius:50%;background:var(--sun);border:2px solid var(--ink);width:112px;height:112px;display:grid;place-content:center;text-align:center;font:700 11px/1.5 monospace;transform:rotate(9deg)}
 .intro{display:grid;grid-template-columns:1fr 1fr;gap:65px;padding:60px 6vw}.intro>p{font:30px/1.28 Georgia,serif;margin:0}.intro div>p{margin-top:0;line-height:1.65;font-size:16px}
 .fine,.intro div>p.fine{font:12px/1.6 Arial,sans-serif;color:#4a4a44}
 .disclosure{margin:0 6vw 70px;padding:20px 24px;border:1px solid var(--line);background:#f4f4f0;display:flex;gap:24px;align-items:baseline;font-size:13px;line-height:1.6}.disclosure strong{white-space:nowrap}.disclosure p{margin:0}
 #companies{padding:0 6vw}
 .section-heading{border-top:4px solid var(--ink);padding-top:24px}
 h2{font-size:clamp(32px,4.4vw,60px);line-height:1.02;letter-spacing:-.05em;margin:0 0 30px}
 .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:20px 0 12px}
 .filters button{font:700 12px Arial;cursor:pointer;padding:12px 17px;border:1px solid var(--ink);border-radius:30px;background:transparent;color:var(--ink);min-height:44px}
 .filters button[aria-pressed=true]{background:var(--cobalt);border-color:var(--cobalt);color:#fff}
 .filters a{margin-left:auto;font-size:12px}
 .cards{display:grid;grid-template-columns:1fr 1fr;gap:55px 30px}.card[hidden]{display:none}
 .card{border-top:1px solid var(--ink);padding-top:20px;min-width:0;scroll-margin-top:25px}
 .product-image{margin:0}.product-image>a{display:block;background:#fff;border:1px solid #d6d6cf;height:360px;padding:18px}
 .product-image img{width:100%;height:100%;object-fit:contain;display:block}
 .product-image figcaption{font:10px/1.5 Arial;color:#55554f;min-height:30px;padding:9px 0}
 .product-image>a.tile{background:var(--cobalt);border-color:var(--cobalt);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:26px;text-decoration:none;color:#fff}
 .tile-holes{display:grid;grid-template-columns:repeat(4,38px);gap:18px}.tile-holes i{width:38px;height:38px;border-radius:50%;background:var(--paper);border:3px solid var(--ink);display:block}.tile-holes i:nth-child(6){background:var(--sun)}
 .tile-label{font:22px/1.2 Georgia,serif;text-align:center}
 .card-copy .eyebrow{margin-top:12px;color:var(--cobalt)}
 .card h3{font-size:34px;line-height:1.05;letter-spacing:-1.4px;margin:10px 0 12px}
 .origin{font:13px/1.6 Arial;color:#4a4a44;margin:0 0 14px}
 .card-copy>p.system,.card-copy>p.lesson{font-size:16px;line-height:1.65}
 .system strong{font-family:Georgia,serif;font-weight:400;font-style:italic;color:var(--cobalt)}
 .products{list-style:none;margin:16px 0;padding:0;border-top:1px solid var(--ink)}
 .products li{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px;line-height:1.4}.products strong{font-size:17px;white-space:nowrap}
 .number{background:#fff;border:1px solid #d6d6cf;padding:12px 14px;font-size:14px;line-height:1.6}.number .mono{display:block;font-size:10px;letter-spacing:1.5px;color:var(--cobalt);font-weight:700;margin-bottom:4px}.number a{font-size:12px;overflow-wrap:anywhere}
 .buy{display:inline-block;padding:15px 20px;background:var(--sun);border:1px solid var(--ink);font-size:13px;font-weight:700;text-decoration:none;min-height:48px;margin-top:6px}.buy:hover{background:#fff}
 .comparison{margin:75px 6vw;padding-top:28px;border-top:4px solid var(--ink)}
 .lede{font:20px/1.45 Georgia,serif;max-width:52ch;margin:0 0 26px}
 .grid-table{border-top:1px solid var(--ink);font-size:14px;line-height:1.45}
 .gt-row{display:grid;grid-template-columns:1.1fr 1.6fr 1.2fr 1.2fr;border-bottom:1px solid var(--line)}
 .gt-row>span{padding:13px 12px;min-width:0}
 .gt-head{background:var(--ink);color:#fff;font:700 11px/1.4 monospace;letter-spacing:1.2px;text-transform:uppercase}
 .gt-row [role=rowheader]{font-weight:700}
 .gt-connector{background:#fff}.gt-connector b{color:var(--cobalt);margin-right:8px;font-weight:400}
 .gt-row[data-group=gear] [role=rowheader]{box-shadow:inset 4px 0 0 var(--sun)}.gt-row[data-group=carry] [role=rowheader]{box-shadow:inset 4px 0 0 var(--cobalt)}
 .lessons{margin:0 6vw 75px;padding-top:28px;border-top:4px solid var(--ink)}
 .lessons ol{margin:0;padding:0;list-style:none;counter-reset:l;display:grid;grid-template-columns:1fr 1fr;gap:0 40px}
 .lessons li{counter-increment:l;padding:18px 0 18px 58px;position:relative;border-bottom:1px solid var(--line);font-size:16px;line-height:1.6}
 .lessons li::before{content:counter(l,decimal-leading-zero);position:absolute;left:0;top:14px;font:28px/1 Georgia,serif;color:var(--cobalt)}
 .lessons li strong{display:block;font-size:18px}
 .missing{margin:0 6vw 75px;padding:40px;background:var(--cobalt);color:#fff}
 .missing .eyebrow{color:var(--sun)}
 .missing-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;font-size:16px;line-height:1.65}.missing-grid p{margin:0 0 14px}.missing a{color:var(--sun)}
 .status{border:1px solid var(--sun);padding:10px 14px;font:700 12px/1.5 monospace;letter-spacing:.5px}
 .pods{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,.5)}
 .pods li{display:grid;grid-template-columns:170px 1fr;gap:14px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.35)}.pods strong{color:var(--sun)}
 .invite{font:22px/1.4 Georgia,serif;margin:28px 0 0}
 .endnote{padding:55px 6vw 60px;background:var(--ink);color:var(--paper)}
 .endnote>p:not(.eyebrow){font:21px/1.5 Georgia,serif;max-width:44ch}
 .endnote details{max-width:800px;padding:22px 0;margin:35px 0;border-top:1px solid #6d6d66;border-bottom:1px solid #6d6d66;font-size:13px;line-height:1.8}.endnote summary{cursor:pointer;font-weight:700}
 a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--red);outline-offset:4px}
 @media(max-width:900px){.gt-row{grid-template-columns:1fr 1fr}.gt-head{display:none}.gt-row>span:nth-child(n+3){font-size:13px}.gt-row [role=cell]::before{display:block;font:700 10px/1.4 monospace;letter-spacing:1.2px;text-transform:uppercase;color:#55554f;margin-bottom:3px}.gt-row [role=cell]:nth-child(2)::before{content:'Connector'}.gt-row [role=cell]:nth-child(3)::before{content:'Cheapest way in'}.gt-row [role=cell]:nth-child(4)::before{content:'Add-on'}.lessons ol{grid-template-columns:1fr}}
 @media(max-width:760px){.mast{padding:18px 16px;gap:15px}.mast span{display:none}.hero{grid-template-columns:1fr;min-height:0}.hero-copy{padding:35px 16px}.hero-image{border-left:0;border-top:1px solid var(--ink);padding:60px 16px 20px}.stamp{width:84px;height:84px;font-size:9px;top:14px;right:14px}.intro{grid-template-columns:1fr;gap:25px;padding:38px 16px}.intro>p{font-size:25px}.disclosure{margin:0 16px 45px;padding:18px;display:block}.disclosure strong{display:block;margin-bottom:7px}#companies{padding:0 16px}.cards{grid-template-columns:1fr;gap:35px}.product-image>a{height:300px}.tile-holes{grid-template-columns:repeat(4,30px);gap:14px}.tile-holes i{width:30px;height:30px}.filters a{margin-left:0;padding:12px}.comparison{margin:50px 16px}.lessons{margin:0 16px 50px}.lessons li{padding-left:48px}.missing{margin:0 16px 50px;padding:28px 20px}.missing-grid{grid-template-columns:1fr;gap:18px}.pods li{grid-template-columns:1fr;gap:2px}.endnote{padding:40px 16px}.card h3{font-size:30px}}
</style>
