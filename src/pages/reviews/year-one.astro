---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reviewsBySlug } from '../../data/reviews';

const review = reviewsBySlug.get('year-one')!;
const title = review.title;
const description = review.dek;

const reviewJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  '@id': 'https://pointcast.xyz/reviews/year-one#review',
  url: 'https://pointcast.xyz/reviews/year-one',
  name: title,
  headline: title,
  description,
  datePublished: '2026-07-26',
  inLanguage: 'en-US',
  author: {
    '@type': 'Organization',
    name: 'PointCast Review Lab',
    url: 'https://pointcast.xyz/reviews',
  },
  itemReviewed: {
    '@type': 'CreativeWorkSeries',
    name: 'Year One',
    creator: {
      '@type': 'Person',
      name: 'Michael Hoydich',
    },
    numberOfItems: 116,
    artform: 'AI-assisted object study',
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: 4.5,
    bestRating: 5,
    worstRating: 1,
  },
};

const awards = [
  {
    label: 'BEST IN SHOW',
    title: 'Night Wave',
    image: '/images/year-one/neon-ring.webp',
    alt: 'A circular neon wave pedestal wrapping around a can in a dark room',
    note: 'The silhouette is immediate. The color is ridiculous. It knows exactly when to stop.',
  },
  {
    label: 'BEST DRESSED',
    title: 'Hokusai After Hours',
    image: '/images/year-one/great-wave.webp',
    alt: 'A pale sculptural wave pedestal with Japanese print detail and a pink can',
    note: 'The reference is obvious; the balance is not. Museum-shop energy, in the good way.',
  },
  {
    label: 'MOST LIKELY TO DISAPPEAR',
    title: 'The Soft Curl',
    image: '/images/year-one/soft-lilac.webp',
    alt: 'A deep blue crescent wave pedestal against a lilac wall',
    note: 'Compact, calm, and dangerously easy to imagine carrying out under one arm.',
  },
];
---

<BaseLayout title={title} description={description} image="/images/year-one/year-one-og.jpg">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewJsonLd)} />

  <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

  <article class="feature">
    <header class="cover">
      <img
        class="cover__image"
        src="/images/year-one/cover.webp"
        width="1800"
        height="1800"
        alt="A glowing rainbow wave sculpture curling around a brightly illustrated can"
        loading="eager"
        fetchpriority="high"
      />
      <div class="cover__shade"></div>
      <nav class="cover__nav" aria-label="Feature navigation">
        <a class="cover__brand" href="/">POINTCAST</a>
        <a href="/reviews">REVIEWS</a>
        <span>ISSUE 03</span>
        <a href="/reviews/year-one.json">JSON ↗</a>
      </nav>
      <div class="cover__type">
        <p class="cover__kicker">SPECIAL ISSUE / JULY 2026</p>
        <h1><span>YEAR</span><em>ONE</em></h1>
        <p class="cover__dek">THE MALL LEARNED TO SURF</p>
      </div>
      <div class="cover__lines">
        <p><b>116</b> OBJECTS</p>
        <p><b>29</b> TURNS</p>
        <p><b>1</b> GLORIOUS WAVE</p>
      </div>
      <a class="cover__scroll" href="#review">OPEN THE ISSUE <span>↓</span></a>
    </header>

    <section class="cold-open" id="review">
      <figure class="cold-open__image" data-reveal>
        <img
          src="/images/year-one/transmission.webp"
          width="1800"
          height="1800"
          alt="A satellite dish on a tiny wheeled platform against a bright test-pattern field"
        />
        <figcaption>THE TRANSMISSION BEFORE THE WAVE. <b>01 / 116</b></figcaption>
      </figure>
      <div class="cold-open__copy" data-reveal>
        <p class="eyebrow">THE 30-SECOND VERSION</p>
        <h2>IT STARTS WITH A SIGNAL. THEN THE FURNITURE GETS WET.</h2>
        <p class="lede">
          <b>Year One</b> turns a beverage pedestal into a full personality test: pop object,
          museum prop, late-night trophy, and occasionally a very expensive place to put a can.
        </p>
        <p>
          The idea repeats 116 times. That is the joke—and the strength. Every new curl asks the
          same clean question: how much attitude can one wave hold?
        </p>
      </div>
    </section>

    <section class="numbers" aria-label="Year One key facts">
      <div><strong>116</strong><span>IMAGES</span></div>
      <div><strong>29</strong><span>VISUAL TURNS</span></div>
      <div><strong>01</strong><span>SATELLITE</span></div>
      <div class="numbers__score"><strong>4.5</strong><span>OUT OF 5</span></div>
    </section>

    <section class="statement">
      <p class="eyebrow">THE VERDICT</p>
      <p data-reveal>
        A single strong idea, pushed until it becomes a world.
        <em>The best pieces look useful, impossible, and already famous.</em>
      </p>
    </section>

    <figure class="full-bleed" data-reveal>
      <img
        src="/images/year-one/classic-black.webp"
        width="1800"
        height="1800"
        alt="A black and cream pedestal patterned with a great wave and supporting an amber can"
        loading="lazy"
      />
      <figcaption><b>THE CLASSIC.</b> WHEN THE REFERENCE AND THE OBJECT AGREE, THE SERIES SINGS.</figcaption>
    </figure>

    <section class="chapter chapter--cream">
      <div class="chapter__index">01</div>
      <div class="chapter__copy" data-reveal>
        <p class="eyebrow">THE BIG IDEA</p>
        <h2>ONE MOVE.<br />NO APOLOGY.</h2>
        <p>
          The wave is shelf, plinth, mascot, logo, and little bit of theater. Year One does not
          hide its repetition. It makes repetition the engine.
        </p>
      </div>
      <figure class="chapter__image chapter__image--tall" data-reveal>
        <img
          src="/images/year-one/porcelain-color.webp"
          width="1800"
          height="1800"
          alt="A brightly patterned porcelain wave pedestal holding a can"
          loading="lazy"
        />
        <figcaption>POP CERAMIC / ATTITUDE: 9.4</figcaption>
      </figure>
    </section>

    <section class="runway" aria-labelledby="runway-title">
      <div class="runway__head">
        <p class="eyebrow">THE QUICK CUT</p>
        <h2 id="runway-title">FOUR WAYS TO HOLD A DRINK</h2>
      </div>
      <figure data-reveal>
        <img src="/images/year-one/pop-curl.webp" width="1800" height="1800" alt="A graphic blue wave pedestal on a pink background" loading="lazy" />
        <figcaption>01 / POP</figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/year-one/minimal-line.webp" width="1800" height="1800" alt="A low minimalist white shelf with a dark can" loading="lazy" />
        <figcaption>02 / QUIET</figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/year-one/emerald-curl.webp" width="1800" height="1800" alt="A glossy green and blue curling wave pedestal" loading="lazy" />
        <figcaption>03 / GLOSS</figcaption>
      </figure>
      <figure data-reveal>
        <img src="/images/year-one/primitive.webp" width="1800" height="1800" alt="A chunky hand-drawn blue and black pedestal supporting a painted can" loading="lazy" />
        <figcaption>04 / RAW</figcaption>
      </figure>
    </section>

    <section class="awards" aria-labelledby="awards-title">
      <div class="awards__head">
        <p class="eyebrow">THE EDIT</p>
        <h2 id="awards-title">BEST IN SHOW</h2>
        <p>Three winners. Zero committee meetings.</p>
      </div>
      <div class="awards__grid">
        {awards.map((award, index) => (
          <article class="award" data-reveal>
            <div class="award__rank">{String(index + 1).padStart(2, '0')}</div>
            <img src={award.image} width="1800" height="1800" alt={award.alt} loading="lazy" />
            <p class="eyebrow">{award.label}</p>
            <h3>{award.title}</h3>
            <p>{award.note}</p>
          </article>
        ))}
      </div>
    </section>

    <blockquote class="pullquote">
      <span>“</span>
      <p>USEFUL. IMPOSSIBLE.<br /><em>ALREADY FAMOUS.</em></p>
    </blockquote>

    <section class="chapter chapter--black">
      <div class="chapter__index">02</div>
      <div class="chapter__copy" data-reveal>
        <p class="eyebrow">AFTER DARK</p>
        <h2>THE WAVE FINDS ITS NIGHTLIFE.</h2>
        <p>
          Neon changes the premise. What looked like craft becomes a tiny stage set. These are the
          images that turn a good study into a cover story.
        </p>
      </div>
      <figure class="chapter__image chapter__image--wide" data-reveal>
        <img
          src="/images/year-one/neon-run.webp"
          width="1800"
          height="1800"
          alt="A neon wave pedestal racing across a dark interior with orange and violet light"
          loading="lazy"
        />
        <figcaption>NIGHT MODE / SPEED: UNREASONABLE</figcaption>
      </figure>
    </section>

    <section class="moods" aria-labelledby="moods-title">
      <div class="moods__intro">
        <p class="eyebrow">THREE GOOD MOODS</p>
        <h2 id="moods-title">PICK YOUR WAVE.</h2>
      </div>
      <article class="mood mood--pop" data-reveal>
        <img src="/images/year-one/double-rainbow.webp" width="1800" height="1800" alt="A double-ended rainbow wave pedestal holding a can" loading="lazy" />
        <div><b>01</b><h3>POP</h3><p>Color first. Explanation later.</p></div>
      </article>
      <article class="mood mood--museum" data-reveal>
        <img src="/images/year-one/classic-window.webp" width="1800" height="1800" alt="A black and cream wave pedestal framed like a print" loading="lazy" />
        <div><b>02</b><h3>MUSEUM</h3><p>Polite enough for the gift shop. Strange enough for the gallery.</p></div>
      </article>
      <article class="mood mood--midnight" data-reveal>
        <img src="/images/year-one/neon-pillar.webp" width="1800" height="1800" alt="A luminous blue wave pedestal in a dark room" loading="lazy" />
        <div><b>03</b><h3>MIDNIGHT</h3><p>The version your sensible friend pretends not to want.</p></div>
      </article>
    </section>

    <section class="contact-strip" aria-label="More images from Year One">
      <img src="/images/year-one/blue-arch.webp" width="1800" height="1800" alt="Blue arch wave pedestal" loading="lazy" />
      <img src="/images/year-one/flower-wave.webp" width="1800" height="1800" alt="Blue wave pedestal holding flowers" loading="lazy" />
      <img src="/images/year-one/pop-swan.webp" width="1800" height="1800" alt="Graphic blue and pink wave pedestal" loading="lazy" />
      <img src="/images/year-one/minimal-arc.webp" width="1800" height="1800" alt="Minimal arcing shelf sculpture" loading="lazy" />
      <img src="/images/year-one/maximal-wave.webp" width="1800" height="1800" alt="Maximal patterned wave pedestal" loading="lazy" />
      <img src="/images/year-one/lime-curl.webp" width="1800" height="1800" alt="Color-blocked wave pedestal on a wood base" loading="lazy" />
    </section>

    <section class="scorecard">
      <div class="scorecard__intro">
        <p class="eyebrow">THE SCORECARD</p>
        <h2>FAST MATH.<br />NO HOMEWORK.</h2>
      </div>
      <div class="scorecard__scores">
        <div><span>CONCEPT</span><strong>4.8</strong></div>
        <div><span>ART DIRECTION</span><strong>4.7</strong></div>
        <div><span>VARIETY</span><strong>4.3</strong></div>
        <div><span>THE EDIT</span><strong>4.2</strong></div>
      </div>
      <div class="scorecard__lists">
        <div class="scorecard__list scorecard__list--hits">
          <h3>WHAT HITS</h3>
          <ul>
            <li>One instantly legible idea</li>
            <li>Color that earns the scroll</li>
            <li>Objects with real silhouettes</li>
            <li>A late neon run worth waiting for</li>
          </ul>
        </div>
        <div class="scorecard__list scorecard__list--misses">
          <h3>WHAT DRAGS</h3>
          <ul>
            <li>Similar setups blur together</li>
            <li>A few shapes feel like studies, not keepers</li>
            <li>The strongest 20 make the other 96 work hard</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="final">
      <figure class="final__image" data-reveal>
        <img
          src="/images/year-one/paper-model.webp"
          width="1800"
          height="1800"
          alt="A pale paper-model wave pedestal displayed against a small backdrop"
          loading="lazy"
        />
      </figure>
      <div class="final__copy" data-reveal>
        <p class="eyebrow">BOTTOM LINE</p>
        <div class="final__rating"><strong>4.5</strong><span>/ 5</span></div>
        <h2>KEEP THE WAVE.<br />CUT THE LINE.</h2>
        <p>
          Year One works because the premise is simple enough to repeat and weird enough to
          survive repetition. The next move is not more volume. It is a ruthless second issue.
        </p>
        <div class="final__actions">
          <a class="button button--red" href="/reviews">ALL REVIEWS →</a>
          <a class="button" href="/reviews/year-one.json">READ THE JSON ↗</a>
        </div>
      </div>
    </section>

    <footer class="feature__footer">
      <a href="/">POINTCAST</a>
      <p>YEAR ONE / REVIEW LAB / JULY 2026</p>
      <a href="#review">BACK TO TOP ↑</a>
    </footer>
  </article>

  <script is:inline>
    function initYearOne() {
      const bar = document.querySelector('[data-progress]');
      const updateProgress = () => {
        if (!bar) return;
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const value = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;
        bar.style.transform = `scaleX(${value})`;
      };

      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((element) => element.classList.add('is-visible'));
      }
    }

    initYearOne();
    document.addEventListener('astro:page-load', initYearOne);
  </script>

  <style>
    :global(body) {
      background: #efe9dd;
      color: #0b0b0b;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    .reading-progress {
      position: fixed;
      z-index: 100;
      inset: 0 0 auto;
      height: 5px;
      background: rgb(255 255 255 / .2);
      pointer-events: none;
    }

    .reading-progress span {
      display: block;
      width: 100%;
      height: 100%;
      background: #ef233c;
      transform: scaleX(0);
      transform-origin: left;
    }

    .feature {
      overflow: clip;
      background: #efe9dd;
    }

    .cover {
      position: relative;
      min-height: 100svh;
      isolation: isolate;
      display: grid;
      align-content: space-between;
      color: white;
      background: #0a1820;
    }

    .cover__image,
    .cover__shade {
      position: absolute;
      z-index: -2;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .cover__image {
      object-fit: cover;
      object-position: center 58%;
    }

    .cover__shade {
      z-index: -1;
      background:
        linear-gradient(90deg, rgb(0 0 0 / .9) 0%, rgb(0 0 0 / .48) 46%, rgb(0 0 0 / .04) 78%),
        linear-gradient(0deg, rgb(0 0 0 / .72) 0%, transparent 42%);
    }

    .cover__nav {
      margin: 30px clamp(22px, 4vw, 64px) 0;
      padding: 14px 0 12px;
      display: flex;
      align-items: center;
      gap: clamp(14px, 2vw, 32px);
      border-top: 6px solid #ef233c;
      border-bottom: 1px solid rgb(255 255 255 / .5);
      font: 700 11px/1 'JetBrains Mono', monospace;
      letter-spacing: .09em;
    }

    .cover__nav a {
      color: inherit;
      text-decoration: none;
    }

    .cover__brand {
      margin-right: auto;
      color: #ffd60a !important;
      font-size: 15px;
    }

    .cover__type {
      align-self: center;
      margin: clamp(60px, 10vh, 130px) clamp(22px, 4vw, 64px) 40px;
    }

    .cover__kicker,
    .eyebrow {
      margin: 0;
      font: 700 11px/1.2 'JetBrains Mono', monospace;
      letter-spacing: .14em;
    }

    .cover h1 {
      margin: 12px 0 20px;
      width: min-content;
      font: 700 clamp(88px, 18vw, 258px)/.67 'Syne', sans-serif;
      letter-spacing: -.095em;
    }

    .cover h1 span,
    .cover h1 em {
      display: block;
    }

    .cover h1 em {
      color: #ef233c;
      font-style: normal;
    }

    .cover__dek {
      margin: 0;
      font: 700 clamp(24px, 3vw, 44px)/.95 'Syne', sans-serif;
      letter-spacing: -.035em;
    }

    .cover__lines {
      position: absolute;
      right: clamp(22px, 4vw, 64px);
      bottom: 110px;
      width: min(230px, 32vw);
      border-top: 3px solid white;
    }

    .cover__lines p {
      margin: 0;
      padding: 10px 0;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid rgb(255 255 255 / .55);
      font: 700 10px/1 'JetBrains Mono', monospace;
      letter-spacing: .08em;
    }

    .cover__lines b {
      color: #ffd60a;
      font: 700 28px/1 'Syne', sans-serif;
    }

    .cover__scroll {
      margin: 0 clamp(22px, 4vw, 64px) 28px;
      width: fit-content;
      color: white;
      text-decoration: none;
      font: 700 11px/1 'JetBrains Mono', monospace;
      letter-spacing: .1em;
    }

    .cover__scroll span {
      display: inline-block;
      margin-left: 8px;
      color: #ef233c;
      font-size: 22px;
      animation: nudge 1.4s ease-in-out infinite;
    }

    .cold-open {
      max-width: 1320px;
      margin: 0 auto;
      padding: clamp(68px, 10vw, 150px) clamp(22px, 4vw, 64px);
      display: grid;
      grid-template-columns: minmax(0, .85fr) minmax(300px, 1.15fr);
      gap: clamp(36px, 8vw, 120px);
      align-items: center;
    }

    .cold-open figure,
    .full-bleed,
    .chapter figure,
    .runway figure,
    .award,
    .mood,
    .final figure {
      margin: 0;
    }

    .cold-open img,
    .full-bleed img,
    .chapter img,
    .runway img,
    .award img,
    .mood img,
    .contact-strip img,
    .final img {
      display: block;
      width: 100%;
    }

    figcaption {
      padding-top: 10px;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font: 700 10px/1.35 'JetBrains Mono', monospace;
      letter-spacing: .06em;
    }

    .cold-open__copy h2,
    .runway__head h2,
    .awards__head h2,
    .moods__intro h2,
    .scorecard h2,
    .final h2 {
      margin: 14px 0 22px;
      font: 700 clamp(46px, 7vw, 104px)/.84 'Syne', sans-serif;
      letter-spacing: -.06em;
    }

    .cold-open__copy p:not(.eyebrow),
    .chapter__copy p:not(.eyebrow),
    .scorecard__intro + *,
    .final__copy > p:not(.eyebrow) {
      max-width: 39ch;
      font: 500 clamp(17px, 1.5vw, 21px)/1.5 'Lora', serif;
    }

    .cold-open__copy .lede {
      margin-top: 0;
      font-size: clamp(22px, 2.1vw, 30px);
      line-height: 1.35;
    }

    .numbers {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      color: white;
      background: #0b0b0b;
    }

    .numbers div {
      min-height: 190px;
      padding: 24px clamp(18px, 3vw, 44px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: 1px solid #444;
    }

    .numbers strong {
      font: 700 clamp(60px, 8vw, 126px)/.75 'Syne', sans-serif;
      letter-spacing: -.07em;
    }

    .numbers span {
      font: 700 10px/1 'JetBrains Mono', monospace;
      letter-spacing: .12em;
    }

    .numbers__score {
      color: #0b0b0b;
      background: #ef233c;
      border-right: 0 !important;
    }

    .statement {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(86px, 13vw, 190px) clamp(22px, 5vw, 76px);
    }

    .statement > p:last-child {
      margin: 18px 0 0;
      font: 700 clamp(42px, 7.4vw, 110px)/.95 'Syne', sans-serif;
      letter-spacing: -.06em;
    }

    .statement em {
      color: #ef233c;
      font-style: normal;
    }

    .full-bleed {
      position: relative;
      background: #111;
    }

    .full-bleed img {
      width: 100%;
      max-height: 94svh;
      object-fit: cover;
      object-position: center;
    }

    .full-bleed figcaption {
      position: absolute;
      right: clamp(14px, 3vw, 38px);
      bottom: clamp(14px, 3vw, 38px);
      padding: 10px 12px;
      color: white;
      background: #0b0b0b;
    }

    .chapter {
      position: relative;
      padding: clamp(76px, 11vw, 160px) clamp(22px, 5vw, 78px);
      display: grid;
      grid-template-columns: 90px minmax(280px, .75fr) minmax(340px, 1.25fr);
      gap: clamp(24px, 5vw, 80px);
      align-items: center;
    }

    .chapter__index {
      align-self: start;
      font: 700 clamp(50px, 7vw, 102px)/1 'Syne', sans-serif;
      letter-spacing: -.06em;
    }

    .chapter__copy h2 {
      margin: 14px 0 24px;
      font: 700 clamp(48px, 6.5vw, 96px)/.84 'Syne', sans-serif;
      letter-spacing: -.06em;
    }

    .chapter__image--tall img {
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }

    .chapter__image--wide img {
      aspect-ratio: 5 / 4;
      object-fit: cover;
    }

    .chapter--black {
      color: white;
      background: #0b0b0b;
    }

    .chapter--black .eyebrow,
    .chapter--black .chapter__index {
      color: #ef233c;
    }

    .runway {
      padding: clamp(80px, 11vw, 160px) clamp(22px, 4vw, 64px);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      background: #ef233c;
    }

    .runway__head {
      grid-column: 1 / -1;
      max-width: 950px;
      margin-bottom: 34px;
    }

    .runway figure {
      padding: 10px;
      background: #efe9dd;
    }

    .runway figure:nth-of-type(even) {
      transform: translateY(30px);
    }

    .runway img {
      aspect-ratio: 4 / 5;
