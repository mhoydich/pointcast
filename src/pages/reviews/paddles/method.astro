---
/**
 * /reviews/paddles/method — how a paddle take gets made.
 *
 * The one page every disclosure links back to. Nothing here changes what a
 * take says or where a paddle sits; commission never moves the order.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../../lib/channels';
import { AFFILIATE_PROGRAMS } from '../../../data/affiliate-programs';
import { PAID_LINK_DISCLOSURE, NO_COMMISSION_NOTE } from '../../../lib/commerce';
import { MIN_HOURS, MAX_HOURS, RELATIONSHIP_PRECEDENCE, RELATIONSHIP_WORDS, TAKE_FIELDS, VERDICT_WORDS } from '../../../lib/paddle-takes';

const court = CHANNELS.CRT;
const title = 'How a paddle take gets made';
const description = `The hour floor, the four relationships a reviewer discloses, the affiliate programs on file, and the exact disclosure that sits beside every paid link. Commission never changes the order.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://pointcast.xyz/reviews/paddles/method#page',
  name: title,
  description,
  url: 'https://pointcast.xyz/reviews/paddles/method',
  isPartOf: { '@type': 'CollectionPage', name: 'Paddle Takes', url: 'https://pointcast.xyz/reviews/paddles' },
};

const verdictOrder: (keyof typeof VERDICT_WORDS)[] = ['bag', 'depends', 'pass'];

// Computed from the config, so this sentence can't go stale when a switch flips.
const approvedCount = AFFILIATE_PROGRAMS.filter((p) => p.approved).length;
const programsLine = approvedCount === 0
  ? `None of the ${AFFILIATE_PROGRAMS.length} programs below has approved PointCast, so none of them can pay a link. A program starts paying only after its maker approves PointCast and its switch is turned on in PointCast's program config, which is what this table reads.`
  : `${approvedCount} of the ${AFFILIATE_PROGRAMS.length} programs below ${approvedCount === 1 ? 'has' : 'have'} approved PointCast. The rest cannot pay a link until their maker approves PointCast and their switch is turned on in PointCast's program config, which is what this table reads.`;
---

<BlockLayout title={title} description={description} image="/images/og/paddles.png" jsonLd={jsonLd}>
  <main class="method" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/reviews/paddles">paddle takes</a><span>/</span><span>method</span>
    </nav>

    <header class="hero">
      <p class="kicker">CH.CRT · METHOD · READ THIS FIRST</p>
      <h1>How a take gets made, and how a link gets paid.</h1>
      <p class="dek">
        One page, linked from every disclosure box. It says who reviewers are to the paddles they
        write about, what has to be true before a take publishes, which affiliate programs exist on
        paper, and the one rule that never bends: <strong>commission never changes the order a paddle
        shows in, and never changes what a take says.</strong>
      </p>
    </header>

    <section class="sec" aria-label="The hour floor and the buckets">
      <p class="kicker">THE HOUR FLOOR</p>
      <p class="body">
        A take does not publish before the reviewer has {MIN_HOURS} hours on real courts with the
        paddle, and a take claiming more than {MAX_HOURS.toLocaleString('en-US')} hours is rejected
        as a typo. There are three verdicts, and no fourth, softer option:
      </p>
      <div class="buckets">
        {verdictOrder.map((v) => (<div><strong>{VERDICT_WORDS[v]}</strong></div>))}
      </div>
      <p class="body">
        A pass publishes exactly like a keeper — same length, same place in the list, same disclosure
        box. Nothing is suppressed for reading badly, and no reward of any kind, cash, credit, or
        otherwise, is tied to what a take ends up saying.
      </p>
    </section>

    <section class="sec" aria-label="How paddles are sourced">
      <p class="kicker">HOW PADDLES ARE SOURCED</p>
      <p class="body">Every take discloses one of four relationships to the paddle it covers, right beside the reviewer's handle:</p>
      <dl class="rows">
        {RELATIONSHIP_PRECEDENCE.map((r) => (<div class="row"><dt>{r}</dt><dd>{RELATIONSHIP_WORDS[r]}</dd></div>))}
      </dl>
      <p class="body">
        When more than one fits, the first in that list wins. How a paddle was obtained outranks who
        holds it: any financial tie to the maker reads <code>owner</code>, and a paddle sent free or
        discounted reads <code>sample</code>, even once it lives in Mike's bag. <code>insider</code>
        only ever means a paddle Mike paid retail for.
      </p>
      <p class="fine">Hours played are as the reviewer reports them; the register does not independently verify a court session.</p>
    </section>

    <section class="sec" aria-label="Ranking">
      <p class="kicker">RANKING</p>
      <p class="body">
        Commission never changes what we rank or recommend. Order on <a href="/shop/court">the court
        lane</a> is release date, full stop; order on <a href="/reviews/paddles">the takes desk</a> is
        the record and the publish date. No program's rate, no approval, and no size of a paddle
        maker moves either list.
      </p>
    </section>

    <section class="sec" aria-label="Affiliate programs on file">
      <p class="kicker">THE PROGRAMS ON FILE</p>
      <p class="body">{programsLine}</p>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Brand</th><th>Network</th><th>Approved</th><th>Status</th></tr></thead>
          <tbody>
            {AFFILIATE_PROGRAMS.map((p) => (
              <tr>
                <th>{p.brand}</th>
                <td>{p.network}</td>
                <td class={p.approved ? 'yes' : 'no'}>{p.approved ? 'Yes' : 'No'}</td>
                <td>{p.status}{!p.accepting && !/not accepting/i.test(p.status) && ' Not accepting applications.'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec disclosure" aria-label="Disclosure">
      <p class="kicker">DISCLOSURE</p>
      <p class="body">
        The exact string <strong>"{PAID_LINK_DISCLOSURE}"</strong> sits directly beside every paid
        link, on the paddle review page and in the court lane, every time — never a lone word like
        "affiliate," and never tucked into a page footer where it is easy to miss. Until a program is
        approved, the same spot instead says <strong>"{NO_COMMISSION_NOTE}"</strong> If PointCast or
        Mike ever holds a financial tie to a paddle maker, that tie is disclosed as <code>owner</code>
        on the take itself, ambassador programs included. The Federal Trade Commission's endorsement
        guides set the bar this policy is built to clear: <a href="https://www.ftc.gov/business-guidance/resources/ftcs-endorsement-guides-what-people-are-saying" rel="noopener">ftc.gov ↗</a>.
      </p>
    </section>

    <section class="sec" aria-label="Take fields">
      <p class="kicker">WHAT'S IN A TAKE</p>
      <dl class="rows">
        {Object.entries(TAKE_FIELDS).map(([key, field]) => (<div class="row"><dt>{field.label}</dt><dd>{field.meaning}</dd></div>))}
      </dl>
    </section>

    <section class="sec" aria-label="The register">
      <p class="kicker">THE REGISTER STAYS SEPARATE</p>
      <p class="body">
        <a href="/paddles">The Paddle Register</a> carries no affiliate links and no discount codes —
        that promise does not change here. A paid link, once one exists, appears only through this
        page's rules: on a paddle's review page, and in the shop's <a href="/shop/court">court
        lane</a>. It never appears on a register page.
      </p>
    </section>

    <p class="foot">
      <a href="/reviews/paddles">every take</a> · <a href="/shop/court">the court lane</a> · <a href="/paddles">the register</a> · <a href="/reviews/paddles.json">paddles.json</a> · CC0
    </p>
  </main>
</BlockLayout>

<style>
  .method{max-width:860px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{padding:40px 0 24px}
  .hero h1{margin:0;font:500 clamp(32px,5.4vw,56px)/1.05 var(--pc-font-sans);letter-spacing:-.03em;text-wrap:balance}
  .dek{margin:18px 0 0;font:400 17px/1.6 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .dek strong{color:var(--pc-ink);font-weight:600}
  .sec{padding-top:36px}
  .body{margin:0 0 14px;font:400 16px/1.65 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .body:last-child{margin-bottom:0}
  .body a{color:var(--c800)}
  .body code{font:400 13px var(--pc-font-mono);background:var(--c50);padding:1px 4px}
  .body strong{color:var(--pc-ink);font-weight:600}
  .rows + .body{margin-top:14px}
  .fine{margin:0;font:400 13px/1.5 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .buckets{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 16px;border:1.5px solid var(--c600)}
  .buckets div{padding:14px;text-align:center;border-right:1.5px solid var(--c600)}
  .buckets div:last-child{border-right:0}
  .buckets strong{font:500 15px var(--pc-font-sans)}
  .rows{margin:0;border-top:1.5px solid var(--c600)}
  .row{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:12px 0;border-bottom:1px solid var(--pc-rule-soft)}
  .row dt{font:500 11px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--c800)}
  .row dd{margin:0;font:400 15px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .tablewrap{overflow-x:auto;border:1.5px solid var(--c600)}
  table{width:100%;border-collapse:collapse;font:400 13.5px var(--pc-font-sans)}
  th,td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--pc-rule-soft);white-space:nowrap}
  thead th{font:500 10px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--pc-ink-muted);background:var(--c50)}
  tbody th{font-weight:500}
  tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}
  td.yes{color:var(--c800);font-weight:500}
  td.no{color:var(--pc-ink-muted)}
  .disclosure{padding:20px;border:1.5px solid var(--c600);background:var(--c50)}
  .foot{margin:32px 0 0;font:400 10px/1.8 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .foot a{color:var(--c800)}
  @media(max-width:600px){.buckets{grid-template-columns:1fr}.row{grid-template-columns:1fr;gap:2px}}
</style>
