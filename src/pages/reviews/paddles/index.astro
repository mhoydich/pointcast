---
/**
 * /reviews/paddles — the Paddle Takes desk.
 *
 * A take is a first-hand read from one reviewer, not a lab score: no stars,
 * a disclosed relationship to the paddle, hours actually played, and a
 * verdict bucket. Stage 1 ships this empty on purpose — the first take
 * comes from Mike's own bag, not from a seeded entry made to look occupied.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../../lib/channels';
import { PADDLES, paddleById, paddleUrl } from '../../../lib/paddle-register';
import { PADDLE_REVIEWS } from '../../../data/paddle-reviews';
import { AFFILIATE_PROGRAM_IDS } from '../../../lib/commerce';
import { orderTakes, publishableTakes, VERDICT_WORDS } from '../../../lib/paddle-takes';

const court = CHANNELS.CRT;
const knownIds = PADDLES.map((p) => p.id);
const takes = orderTakes(publishableTakes(PADDLE_REVIEWS, knownIds, AFFILIATE_PROGRAM_IDS));

const title = 'Paddle Takes';
const description = "First-hand reads on paddles, one reviewer at a time: no stars, a disclosed relationship, hours actually played, and a verdict — stays in the bag, depends, or pass.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/reviews/paddles',
  name: title,
  description,
  url: 'https://pointcast.xyz/reviews/paddles',
  ...(takes.length > 0
    ? {
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: takes.length,
          itemListElement: takes.map((t, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: `https://pointcast.xyz/reviews/paddles/${t.id}`,
          })),
        },
      }
    : {}),
};
---

<BlockLayout title={title} description={description} image="/images/og/paddles.png" jsonLd={jsonLd}>
  <main class="takes" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/reviews">reviews</a><span>/</span><span>paddles</span>
      <a href="/reviews/paddles.json">JSON</a>
    </nav>

    <header class="hero">
      <p class="kicker">CH.CRT · COURT · PADDLE TAKES</p>
      <h1>What it's actually like to play these.</h1>
      <p class="dek">
        A take is a first-hand read, not a lab score: no stars, a disclosed relationship to the
        paddle, real hours on real courts, and a verdict — stays in the bag, depends on your game, or
        pass. Every published take, good or bad, stays up. See <a href="/reviews/paddles/method">how this works</a>.
      </p>
    </header>

    {takes.length === 0 ? (
      <section class="empty" aria-label="No takes yet">
        <p class="empty__line">First review coming from Mike's bag.</p>
        <p class="empty__body">
          Nothing is seeded here to make the page look occupied. Read <a href="/reviews/paddles/method">how takes get made</a>,
          browse <a href="/shop/court">the shop's court lane</a> for what's releasing, or open
          <a href="/paddles">the Paddle Register</a> for the permanent record on every paddle.
        </p>
      </section>
    ) : (
      <ol class="list">
        {takes.map((t) => {
          const p = paddleById(t.paddleId);
          return (
            <li>
              <a class="card" href={`/reviews/paddles/${t.id}`}>
                <span class="card__verdict" data-v={t.verdict}>{VERDICT_WORDS[t.verdict]}</span>
                <strong>{p ? `${p.brand} ${p.model}` : t.paddleId}</strong>
                <span class="card__thesis">{t.thesis}</span>
                <span class="card__meta">{t.reviewer.handle} · {t.hoursPlayed}h on court</span>
              </a>
            </li>
          );
        })}
      </ol>
    )}

    <p class="foot">
      <a href="/reviews/paddles/method">the method</a> · <a href="/shop/court">the court lane</a> · <a href="/paddles">the register</a> · <a href="/reviews/paddles.json">paddles.json</a> · CC0
    </p>
  </main>
</BlockLayout>

<style>
  .takes{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}.crumb a:last-child{margin-left:auto;color:var(--c800)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{padding:44px 0 28px;max-width:820px}
  .hero h1{margin:0;font:500 clamp(38px,6vw,68px)/.97 var(--pc-font-sans);letter-spacing:-.035em;text-wrap:balance}
  .dek{margin:18px 0 0;font:400 17px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .dek a{color:var(--c800)}
  .empty{padding:28px;border:1.5px dashed var(--c600);background:var(--c50)}
  .empty__line{margin:0 0 10px;font:500 22px/1.3 var(--pc-font-sans);letter-spacing:-.01em;color:var(--pc-ink)}
  .empty__body{margin:0;max-width:640px;font:400 15px/1.6 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .empty__body a{color:var(--c800)}
  .list{margin:0;padding:0;list-style:none;border-top:1.5px solid var(--c600)}
  .card{display:grid;grid-template-columns:140px 1fr;grid-template-rows:auto auto;gap:4px 16px;padding:16px 0;border-bottom:1px solid var(--pc-rule-soft);color:var(--pc-ink)}
  .card:hover{background:var(--c50);text-decoration:none}
  .card__verdict{grid-row:1/3;align-self:start;padding:4px 8px;border:1px solid var(--c600);font:500 10px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--c800);height:fit-content}
  .card strong{font:500 18px var(--pc-font-sans)}
  .card__thesis{font:400 14px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .card__meta{grid-column:2;font:400 11px var(--pc-font-mono);letter-spacing:.04em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .foot{margin:32px 0 0;font:400 10px/1.8 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .foot a{color:var(--c800)}
  @media(max-width:600px){.card{grid-template-columns:1fr}.card__verdict{grid-row:auto;width:fit-content}.card__meta{grid-column:1}}
</style>
