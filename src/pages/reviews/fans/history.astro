---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import history from '../../../data/fans-history.json';

const description = history.dek;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: history.title,
  description,
  datePublished: history.asOf,
  dateModified: history.asOf,
  author: { '@type': 'Organization', name: 'Grok Bot — PointCast Review Lab' },
  publisher: { '@type': 'Organization', name: 'PointCast' },
  mainEntityOfPage: 'https://pointcast.xyz/reviews/fans/history',
  wordCount: history.wordCount,
};
---
<BlockLayout title={`${history.title} | PointCast`} description={description} jsonLd={jsonLd} immersive>
  <article class="history">
    <nav class="mast" aria-label="PointCast">
      <a href="/">POINTCAST<span> / FAN HISTORY</span></a>
      <a href="/reviews/fans">The buying guide</a>
      <a href="/reviews">All reviews</a>
    </nav>
    <header>
      <p class="eyebrow">DESK HISTORY · NO HANDS-ON TESTING · {history.asOf}</p>
      <h1>{history.title}</h1>
      <p class="dek">{history.dek}</p>
      <p class="byline">By {history.byline} · Research checked <time datetime={history.asOf}>October 5, 2026</time> · {history.wordCount.toLocaleString('en-US')} words</p>
    </header>
    {history.lede.map((p) => <p class="lede">{p}</p>)}
    {history.sections.map((section) => (
      <section id={section.id}>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((p) => <p>{p}</p>)}
      </section>
    ))}
    <footer>
      <p class="eyebrow">THE BUYING GUIDE</p>
      <p><a href={history.guide.path}>{history.guide.title} →</a></p>
      <p>Desk history. No hands-on testing. PointCast has not restored a punkah or timed a fan in a lab. The six-fan desk review, with dated prices and non-affiliate maker links, is <a href="/reviews/fans">the buying guide</a>.</p>
      <details>
        <summary>Sources</summary>
        <ul>
          {history.sources.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer">{s.url}</a></li>
          ))}
        </ul>
      </details>
      <p><a href="/reviews/fans/history.json">Read this history as JSON ↗</a></p>
    </footer>
  </article>
</BlockLayout>
<style>
  :global(body) { margin: 0; background: #f7f5f0; color: #1a1916; }
  .history { max-width: 740px; margin: 0 auto; padding: 0 22px 80px; font: 19px/1.65 Georgia, 'Iowan Old Style', serif; }
  .mast { display: flex; gap: 16px; align-items: center; margin: 0 -22px 28px; padding: 16px 22px; border-bottom: 1px solid #1a1916; font: 700 12px/1 Arial, Helvetica, sans-serif; }
  .mast a { color: inherit; text-decoration: none; }
  .mast a:first-child { margin-right: auto; letter-spacing: .04em; }
  .mast span { margin-left: 8px; letter-spacing: .08em; }
  .eyebrow { font: 700 11px/1.5 Arial, Helvetica, sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  h1 { font-size: clamp(36px, 5vw, 56px); line-height: 1.05; font-weight: 500; letter-spacing: -.02em; margin: 10px 0 14px; }
  h2 { font-size: 28px; line-height: 1.2; font-weight: 500; margin: 36px 0 8px; }
  .dek, .byline { color: #3d3a34; }
  .byline { font: 13px/1.5 Arial, Helvetica, sans-serif; }
  .lede { font-size: 21px; }
  a { color: #1f3a5f; }
  footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid #1a1916; font: 15px/1.6 Arial, Helvetica, sans-serif; }
  footer ul { padding-left: 18px; }
  footer li { margin: 0 0 6px; word-break: break-word; }
  summary { cursor: pointer; font-weight: 700; }
</style>
