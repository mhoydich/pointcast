---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { reviewsBySlug } from '../../data/reviews';
import {
  ART_CREDIT,
  CHANGE_SCHEDULE,
  DESK_DATE,
  FEEDERS,
  NECTAR,
  NO_COMMISSION,
  PICKS,
  PLANTS,
  RUBRIC,
  SOURCES,
  SOURCE_GROUPS,
  UNVERIFIED,
  feedersById,
  sourcesById,
} from '../../lib/hummingbird-feeders.mjs';

const review = reviewsBySlug.get('hummingbird-feeders')!;
const pageUrl = 'https://pointcast.xyz/reviews/hummingbird-feeders';
const fmt = (n: number) => n.toFixed(1);
const top = FEEDERS[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#review`,
  url: pageUrl,
  headline: review.title,
  description: review.dek,
  datePublished: DESK_DATE,
  inLanguage: 'en-US',
  author: { '@type': 'Organization', name: 'PointCast Review Lab', url: 'https://pointcast.xyz' },
  image: `https://pointcast.xyz${review.image}`,
  about: {
    '@type': 'ItemList',
    name: 'Hummingbird feeders ranked on the PointCast desk-review rubric',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: FEEDERS.map((f) => ({
      '@type': 'ListItem',
      position: f.rank,
      name: `${f.model} (${f.maker})`,
    })),
  },
  citation: SOURCES.map((s) => s.url),
};

const shortLabel: Record<string, string> = {
  cleaning: 'C',
  defenses: 'B/A',
  durability: 'D',
  capacity: 'CAP',
  price: '$',
};
---

<BlockLayout legacy title={review.title} description={review.dek} image={review.image} imageWidth={review.imageWidth} imageHeight={review.imageHeight}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <article class="hfr">
    <nav class="hfr__bar" aria-label="Review navigation">
      <a href="/">POINTCAST</a>
      <a href="/reviews">REVIEWS</a>
      <span>SEPTEMBER 2026 · DESK REVIEW</span>
      <a href="/reviews/hummingbird-feeders.json">JSON ↗</a>
    </nav>

    <header class="hfr__hero">
      <figure class="hfr__cover">
        <picture>
          <source srcset="/images/hummingbird-feeders/hero.webp" type="image/webp" />
          <img src={review.image} width={review.imageWidth} height={review.imageHeight} alt={review.imageAlt} loading="eager" />
        </picture>
        <span class="hfr__stamp">DESK<br />REVIEW</span>
        <figcaption>{ART_CREDIT}</figcaption>
      </figure>
      <div class="hfr__headline">
        <p class="hfr__eyebrow">BACKYARD HARDWARE / NINE FEEDERS / FOUR STYLES / CHECKED {DESK_DATE}</p>
        <h1>THE FEEDER<br />YOU'LL <em>CLEAN</em></h1>
        <p>{review.dek}</p>
        <div class="hfr__buttons">
          <a class="hfr__button hfr__button--ink" href="#ranking">SEE THE RANKING ↓</a>
          <a class="hfr__button" href="#care">THE CARE GUIDE ↓</a>
          <a class="hfr__button" href="#verdict">SKIP TO VERDICT ↓</a>
        </div>
      </div>
      <div class="hfr__score"><strong>09</strong><span>FEEDERS RANKED<br />ON A PUBLISHED RUBRIC<br />NONE HANDLED</span></div>
    </header>

    <main>
      <section class="hfr__lede">
        <p class="hfr__drop"><span>A</span> hummingbird feeder is a bottle of sugar water that has to be emptied and washed every few days for as long as it hangs. So the best feeder is the one you will actually take apart and clean. <strong>This is a desk review. PointCast has not used these feeders.</strong> Most of the ranking rests on maker pages and retailer listings. Hands-on tester reports exist for only two of the nine, the HummZinger HighView and the Perky-Pet 217 in Bob Vila's six-week yard test, plus Bird Watching HQ's years with the 16-oz sibling of the First Nature 3055. Birds &amp; Blooms supplies style-level guidance. From that we ranked nine widely sold models on a published rubric.</p>
        <p>Cleaning is 40 percent of the score. Bee and ant defenses and durability reports are 20 percent each. Capacity and price are 10 percent each. Every number below is printed next to the rule that produced it. There are no stars, because stars would suggest we held the thing. Product links go to maker pages only, and only where we opened one. {NO_COMMISSION}</p>
      </section>

      <section class="hfr__facts" aria-label="Review facts">
        <div><strong>09</strong><span>FEEDERS · FOUR STYLES</span></div>
        <div><strong>40%</strong><span>OF THE SCORE IS CLEANING</span></div>
        <div><strong>1:4</strong><span>SUGAR TO WATER · NOTHING ELSE</span></div>
        <div><strong>0</strong><span>FEEDERS HANDLED · DESK ONLY</span></div>
      </section>

      <section class="hfr__chapter">
        <span class="hfr__chapter-no">01</span>
        <div>
          <p class="hfr__eyebrow">THE CASE</p>
          <h2>CLEANING IS THE WHOLE JOB</h2>
          <p>Nectar spoils. Audubon's feeding FAQ ties the cleaning schedule to the weather: every day or every other day when it is hot, every three days when it is temperate, twice a week when it is cool, and sooner when the birds are drinking hard. Cloudiness, mold or insects inside mean change it now. A feeder that is a chore to take apart is a feeder that gets cleaned late.</p>
          <p>The testers split the market by shape. Bird Watching HQ, writing from years of hands-on use, calls dish-style feeders "incredibly easy" to clean because the reservoir has no hard-to-reach corners, and finds bottle feeders "much harder to clean" and more likely to leak. Birds &amp; Blooms agrees that saucers win on convenience. Bottles answer with capacity, a classic look and, on the Perky-Pet and More Birds glass models, built-in bee guards and ant moats. Window mounts trade capacity for the close view and hang on suction cups. Bob Vila's Perky-Pet 217 held through six weeks that included heavy rain, but owners on Perky-Pet's page report that the suction cup on newer units does not fit the mounting hole.</p>
          <p>Material is the second argument. Bob Vila's testers found that plastic resists cracking but fades in the sun over time, while glass wears better and breaks if dropped. Birds &amp; Blooms adds that glass survives the dishwasher better than mixed-material bottles, though the attached plastic ports still need hand-washing, and flags BPA concerns for plastic reservoirs left in direct sun. Hang plastic in shade.</p>
        </div>
      </section>

      <figure class="hfr__plate">
        <picture>
          <source srcset="/images/hummingbird-feeders/feeder-types.webp" type="image/webp" />
          <img src="/images/hummingbird-feeders/feeder-types.jpg" width="1600" height="1000" alt="A painted plate of four red-and-clear hummingbird feeders on a blue ground: a covered saucer with a hummingbird perched on its lid, a hanging glass bottle with flower ports, a small window feeder with two suction cups, and a tall high-capacity bottle" loading="lazy" />
        </picture>
        <figcaption>THE FOUR STYLES, LEFT TO RIGHT: SAUCER, BOTTLE, WINDOW MOUNT, HIGH-CAPACITY BOTTLE. AN ILLUSTRATION OF THE STYLES, NOT THE REVIEWED PRODUCTS. {ART_CREDIT.toUpperCase()}</figcaption>
      </figure>

      <section class="hfr__chapter hfr__chapter--dark">
        <span class="hfr__chapter-no">02</span>
        <div>
          <p class="hfr__eyebrow">THE RUBRIC</p>
          <h2>FIVE CRITERIA, EVERY RULE SHOWN</h2>
          <p>Nobody here has filled one of these, so the score cannot be a feeling. It is arithmetic on what the sources say, and each criterion has a fixed rule. Change a rule and the ranking moves. The review JSON carries the same rules and inputs, so anyone can recompute it.</p>
          <div class="hfr__rubric">
            {RUBRIC.map((c) => (
              <section class="hfr__criterion" aria-label={`${c.label} criterion`}>
                <header><b>{Math.round(c.weight * 100)}%</b><h3>{c.label.toUpperCase()}</h3></header>
                <p>{c.why}</p>
                <ul>
                  {c.scale.map((s) => (
                    <li>{s.rule}</li>
                  ))}
                </ul>
                <p class="hfr__criterion-note">{c.note}</p>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section class="hfr__ranking" id="ranking" aria-labelledby="ranking-title">
        <p class="hfr__eyebrow">COMPARISON TABLE · SCORES OUT OF 10 · PRICES FROM THE NAMED LISTING, CHECKED {DESK_DATE}</p>
        <h2 id="ranking-title">THE NINE, RANKED</h2>
        <p class="hfr__table-key">C cleaning (40%) · B/A bee and ant defenses (20%) · D durability reports (20%) · CAP capacity fit (10%) · $ price (10%). The Big Gulp and the Diamond tie at 7.0 with the same cleaning score; the tie breaks on price. Scroll the table sideways on a phone.</p>
        <div class="hfr__table-wrap" tabindex="0" role="region" aria-label="Comparison table of nine hummingbird feeders">
          <table class="hfr__table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Model</th>
                <th scope="col">Style</th>
                <th scope="col">Oz</th>
                <th scope="col">Ports</th>
                <th scope="col">Material</th>
                <th scope="col">Cleaning</th>
                <th scope="col">Bee / ant</th>
                <th scope="col">Price</th>
                <th scope="col">Notable complaints</th>
                {RUBRIC.map((c) => <th scope="col" class="hfr__num">{shortLabel[c.key]}</th>)}
                <th scope="col" class="hfr__num">Score</th>
                <th scope="col">Link</th>
              </tr>
            </thead>
            <tbody>
              {FEEDERS.map((f) => (
                <tr>
                  <td class="hfr__rank">{String(f.rank).padStart(2, '0')}</td>
                  <th scope="row"><b>{f.model}</b><small>{f.maker}</small></th>
                  <td>{f.style}</td>
                  <td class="hfr__num">{f.capacityOz}</td>
                  <td class="hfr__num">{f.ports}</td>
                  <td>{f.material}</td>
                  <td>{f.cleaningText}</td>
                  <td>{f.defensesText}</td>
                  <td>{f.priceText}</td>
                  <td>{f.complaints}</td>
                  {RUBRIC.map((c) => <td class="hfr__num">{f.scores[c.key as keyof typeof f.scores]}</td>)}
                  <td class="hfr__num hfr__total">{fmt(f.total)}</td>
                  <td>{f.makerPage ? <a href={f.makerPage} rel="noopener">maker page ↗</a> : <span class="hfr__nolink">no maker page opened</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="hfr__math">
          <p class="hfr__eyebrow">THE MATH, FEEDER BY FEEDER</p>
          {FEEDERS.map((f) => (
            <details>
              <summary><span>{String(f.rank).padStart(2, '0')}</span> {f.model} <b>{fmt(f.total)}</b></summary>
              <dl>
                <div><dt>Cleaning {f.scores.cleaning}</dt><dd>{RUBRIC[0].scale.find((s) => s.score === f.scores.cleaning)?.rule}</dd></div>
                <div><dt>Bee / ant {f.scores.defenses}</dt><dd>{f.defensesText}</dd></div>
                <div><dt>Durability {f.scores.durability}</dt><dd>Start at 7. {f.durability.map((a) => `${a.delta > 0 ? '+' : ''}${a.delta}: ${a.why}`).join(' ')}</dd></div>
                <div><dt>Capacity {f.scores.capacity}</dt><dd>{f.capacityOz} oz.</dd></div>
                <div><dt>Price {f.scores.price}</dt><dd>{f.priceText}{f.priceLow === f.priceHigh ? `, scored at $${f.priceLow.toFixed(2)}` : `, midpoint $${((f.priceLow + f.priceHigh) / 2).toFixed(2)}`}, checked {DESK_DATE}.{f.priceVerified ? '' : ' Street price unverified.'}</dd></div>
                <div><dt>Sources</dt><dd>{f.sourceIds.map((id) => sourcesById.get(id)?.publisher).join(' · ')}</dd></div>
              </dl>
            </details>
          ))}
        </div>
      </section>

      <section class="hfr__split" id="care">
        <div>
          <p class="hfr__eyebrow">03 · THE CARE GUIDE</p>
          <h2>MIX IT, CHANGE IT, HANG IT RIGHT</h2>
          <p><b>Nectar.</b> One part refined white sugar to four parts water. Audubon's version: dissolve a quarter cup of sugar in a cup of boiling water, let it cool, fill the feeder. No red dye, which Audubon calls unnecessary and possibly harmful. No honey, which can promote dangerous fungal growth. No artificial sweeteners, because the birds need the calories in real sugar.</p>
          <p><b>Schedule.</b> Change it by the thermometer, and wash the feeder every time you change it. Audubon's feeding FAQ says the feeder should be emptied and cleaned every day or every other day in heat, every three days in temperate weather, twice a week when it is cool. In El Segundo's marine-layer weather that usually means every three days, and daily when a heat spike pushes through. Dump it at once if it turns cloudy, grows mold, collects insects, or a sick bird has been at it.</p>
          <p><b>Cleaning.</b> Every change, not every week. Audubon's method: hot tap water with hydrogen peroxide or a weak vinegar solution, and no dish soap, which can leave a harmful residue. Take the feeder apart and brush every nectar surface. The More Birds maker pages rule out the dishwasher and recommend a vinegar-water soak. The widely repeated Cornell guidance, which we could not open at the source, also allows a 1:9 bleach soak; if you use bleach, rinse thoroughly with clean water and let the feeder air-dry before refilling. Perky-Pet's 217 page suggests weekly mild soap and water, so the sources disagree on soap; Audubon says skip it.</p>
          <p><b>Ants and bees.</b> An ant moat, a small cup of water hung above the feeder, stops ants, and many feeders now build one in. Bees and wasps go for yellow more than red, so choose an all-red feeder with narrow flower-shaped ports or bee guards, and skip yellow decor. The biggest bee magnet is a leaky or overfilled feeder, and Audubon notes that nectar spilled on the outside defeats any guard. Wipe the drips.</p>
          <p><b>Windows.</b> Use the 3-or-30 rule from Yakima Valley Audubon: closer than 3 feet to the glass, where a bird leaving the feeder cannot build killing speed, or farther than 30 feet, where the reflection is less likely to read as open sky. The middle distance is where strikes happen. A window mount sits inside the 3-foot line by design. Hang plastic in shade, and hang heavy glass from a hook that can hold it.</p>
        </div>
        <aside aria-label="Nectar card">
          <span>NECTAR CARD · PIN IT BY THE SINK</span>
          <dl>
            <div><dt>Ratio</dt><dd>{NECTAR.ratio} white sugar to water</dd></div>
            <div><dt>Recipe</dt><dd>1/4 cup sugar in 1 cup boiling water, cooled</dd></div>
            <div><dt>Never</dt><dd>Red dye, honey, artificial sweetener</dd></div>
            {CHANGE_SCHEDULE.map((row) => (
              <div><dt>{row.weather}</dt><dd>{row.every}</dd></div>
            ))}
            <div><dt>Toss now</dt><dd>Cloudy, moldy, insects, or a sick bird</dd></div>
            <div><dt>Wash</dt><dd>Every change: hot water + brush; vinegar soak; no soap</dd></div>
            <div><dt>Hang</dt><dd>Under 3 ft or over 30 ft from glass, in shade</dd></div>
          </dl>
        </aside>
      </section>

      <section class="hfr__quote">
        <p>"ANNA'S HUMMINGBIRDS ARE RESIDENT IN MUCH OF THE WEST FROM BAJA CALIFORNIA TO SOUTHERN COASTAL BRITISH COLUMBIA, SO SIGHTINGS OF THIS SPECIES ARE COMMON AT FEEDERS IN THE WINTER."</p>
        <span>— CORNELL LAB PROJECT FEEDERWATCH, HUMMINGBIRDS IN WINTER</span>
      </section>

      <section class="hfr__chapter">
        <span class="hfr__chapter-no">04</span>
        <div>
          <p class="hfr__eyebrow">LOCAL NOTES · EL SEGUNDO AND THE SOUTH BAY</p>
          <h2>WHO DRINKS HERE, ALL YEAR</h2>
          <p>Two species carry South Bay feeders through the whole calendar. Anna's Hummingbird is a permanent Pacific Coast resident, per Audubon's field guide, and the Palos Verdes–South Bay Sierra Club calls it abundant year-round in Los Angeles County, especially in the coastal lowlands, foothills and urban areas. The Sierra Club also notes the male is the only North American hummingbird with a red crown. Allen's Hummingbird here is mostly the non-migratory subspecies <i>sedentarius</i>, which colonized the Palos Verdes Peninsula and stayed.</p>
          <p>Its spread is one of the better bird stories in Southern California. Working from eBird checklists, a 2017 study in <i>The Condor</i> found the resident population's mainland range grew from about 70 square kilometers in 1970 to about 13,000 by 2016, with the species on more than a fifth of Southern California checklists and an estimated 46,000 to 350,000 birds in the region. Migratory Rufous and Allen's pass through in spring. The rest of the year, the yard runs on Anna's and resident Allen's.</p>
          <p>So leave the feeder up in winter. Project FeederWatch notes that Anna's are resident from Baja California to southern coastal British Columbia and common at feeders in winter, and Audubon's feeding FAQ says a feeder can stay up year-round where hummingbirds remain; leaving it up does not keep migrants from heading south. Audubon's advice for freezing weather rarely applies on this coast. The cleaning schedule is the whole job.</p>
          <p>A feeder supplements a garden; it should not replace one. The CNPS South Coast Chapter points to a coastal core of Mediterranean-climate natives that need little to no irrigation once rooted, and Calscape's plant finder filters them by zip code, with a hummingbird and pollinator layer.</p>
          <ul class="hfr__plants">
            {PLANTS.map((p) => (
              <li><b>{p.common}</b><i>{p.latin}</i><span>{p.note}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="hfr__verdict" id="verdict">
        <div class="hfr__verdict-title">
          <p class="hfr__eyebrow">POINTCAST REVIEW LAB · DESK REVIEW · RUBRIC SCORES OUT OF 10</p>
          <h2>THE VERDICT</h2>
          <span class="hfr__round-score">DESK<small>NO STARS</small></span>
        </div>
        <div class="hfr__ratings">
          {FEEDERS.map((f) => (
            <div style={`--score:${Math.round(f.total * 10)}%`}><span>{f.model.toUpperCase()}</span><i></i><b>{fmt(f.total)}</b></div>
          ))}
        </div>
        <div class="hfr__verdict-copy">
          <div class="hfr__picks">
            <p><b>PICKS:</b></p>
            <ul>
              {PICKS.map((p) => {
                const f = feedersById.get(p.id)!;
                return <li><b>{p.label}: {f.model} ({fmt(f.total)}).</b> {p.why}</li>;
              })}
            </ul>
          </div>
          <p><b>WATCH FOR:</b> Base seams that leak unless seated exactly right (First Nature). Suction cups that do not fit the mounting hole on newer units (Perky-Pet 217). Plastic bases, perches and port inserts that crack, turn brittle or rot, with no replacement parts sold (Big Gulp, Diamond, 209B), per owners on the maker pages. The weight of 40 ounces of nectar and glass (Big Gulp). Dishwasher claims no source could confirm. Prices that move by retailer and season. And the bottom of the table: the Jewel Box scores last mostly because its maker page says little about cleaning, not because anyone reported it failing.</p>
          <p class="hfr__bottom"><b>BOTTOM LINE:</b> {review.verdict}</p>
        </div>
      </section>

      <section class="hfr__sources" aria-labelledby="sources-title">
        <p class="hfr__eyebrow">EVERY CLAIM ON THIS PAGE TRACES TO ONE OF THESE · OPENED DURING RESEARCH, {DESK_DATE}</p>
        <h2 id="sources-title">SOURCES</h2>
        <div class="hfr__source-groups">
          {SOURCE_GROUPS.map((g) => (
            <section>
              <h3>{g.label}</h3>
              <ol>
                {SOURCES.filter((s) => s.kind === g.kind).map((s) => (
                  <li><a href={s.url} rel="noopener">{s.publisher}: {s.title}</a></li>
                ))}
              </ol>
            </section>
          ))}
        </div>
        <div class="hfr__unverified">
          <h3>Not verified this pass</h3>
          <ul>
            {UNVERIFIED.map((u) => <li>{u}</li>)}
          </ul>
        </div>
      </section>
    </main>

    <footer class="hfr__footer">
      <div><p class="hfr__eyebrow">WHAT TO DO TODAY</p><a href="#care">MIX 1:4. HANG IT IN SHADE. ↑</a></div>
      <nav><a href="/reviews">ALL REVIEWS →</a><a href="/b/0629">BLOCK 0629 →</a><a href="/c/garden">GARDEN CHANNEL →</a><a href="/reviews/hummingbird-feeders.json">REVIEW JSON →</a></nav>
      <p>DESK REVIEW · POINTCAST HAS NOT USED THESE FEEDERS · THE RANKING COMES FROM PUBLISHED SPECS AND THE CITED TESTERS · MAKER LINKS ONLY, NO AFFILIATE OR PAID LINKS · {NO_COMMISSION.toUpperCase()} · {ART_CREDIT.toUpperCase()} · REVIEW BY CLAUDE FOR POINTCAST · SEPTEMBER 28, 2026 · TOP OF THE RUBRIC: {top.model.toUpperCase()}, {fmt(top.total)} OF 10</p>
    </footer>
  </article>

  <style>
    :global(body) { margin: 0; background: #f4efdf; color: #141414; }
    .hfr { --ink:#141414; --paper:#f4efdf; --red:#d6232f; --sky:#5a8ee6; --leaf:#3f7d3a; --flame:#ff7a1a; --cream:#fff6d8; font-family:'Inter Variable',Inter,sans-serif; overflow-x:clip; }
    .hfr__bar { min-height:52px; padding:0 4vw; display:flex; align-items:center; gap:26px; background:var(--ink); color:white; font:800 10px/1 'JetBrains Mono',monospace; letter-spacing:.1em; }
    .hfr__bar a { color:inherit; text-decoration:none; }
    .hfr__bar a:first-child { margin-right:auto; color:var(--flame); font-size:14px; }
    .hfr__hero { position:relative; display:grid; grid-template-columns:minmax(0,1.45fr) minmax(300px,.75fr); border-bottom:4px solid var(--ink); }
    .hfr__cover { position:relative; grid-column:1/-1; margin:0; border-bottom:4px solid var(--ink); background:var(--sky); overflow:hidden; }
    .hfr__cover img { display:block; width:100%; height:min(72vh,820px); object-fit:cover; object-position:center 40%; }
    .hfr__cover figcaption { position:absolute; left:0; bottom:0; padding:8px 12px; background:rgba(20,20,20,.78); color:white; font:700 9px/1.3 'JetBrains Mono',monospace; letter-spacing:.06em; }
    .hfr__stamp { position:absolute; right:3vw; top:3vw; display:grid; place-items:center; width:110px; aspect-ratio:1; border:3px solid var(--ink); border-radius:50%; background:var(--cream); color:var(--red); font:900 13px/1.05 'JetBrains Mono',monospace; text-align:center; transform:rotate(8deg); }
    .hfr__headline { min-width:0; padding:clamp(34px,6vw,86px) 4vw; border-right:3px solid var(--ink); background:var(--paper); }
    .hfr__eyebrow { margin:0 0 14px; font:800 9px/1.3 'JetBrains Mono',monospace; letter-spacing:.14em; }
    .hfr__headline h1 { margin:0; font:800 clamp(52px,9vw,132px)/.78 Syne,sans-serif; letter-spacing:-.06em; }
    .hfr__headline h1 em { color:var(--red); font:italic 500 1em/.78 Lora,serif; }
    .hfr__headline > p:not(.hfr__eyebrow) { max-width:760px; margin:32px 0 0; font:600 clamp(18px,2vw,26px)/1.32 Lora,serif; }
    .hfr__buttons { display:flex; flex-wrap:wrap; gap:10px; margin-top:30px; }
    .hfr__button { padding:14px 17px; border:2px solid var(--ink); color:var(--ink); font:800 9px/1 'JetBrains Mono',monospace; letter-spacing:.09em; text-decoration:none; }
    .hfr__button--ink { background:var(--ink); color:var(--flame); }
    .hfr__score { display:grid; place-content:center; text-align:center; background:var(--red); color:var(--cream); }
    .hfr__score strong { font:800 clamp(90px,15vw,220px)/.7 Syne,sans-serif; letter-spacing:-.08em; }
    .hfr__score span { margin-top:22px; color:white; font:800 10px/1.5 'JetBrains Mono',monospace; letter-spacing:.16em; }
    .hfr main { max-width:1280px; margin:0 auto; padding:72px 4vw 120px; box-sizing:border-box; }
    .hfr__lede { display:grid; grid-template-columns:1fr 1fr; gap:5vw; }
    .hfr__lede p { margin:0; font:600 clamp(18px,2vw,25px)/1.5 Lora,serif; }
    .hfr__drop span { float:left; margin:-8px 10px 0 0; color:var(--red); font:700 100px/.75 Lora,serif; }
    .hfr__facts { display:grid; grid-template-columns:repeat(4,1fr); margin:76px 0; border:3px solid var(--ink); }
    .hfr__facts div { min-width:0; padding:24px; border-right:2px solid var(--ink); text-align:center; }
    .hfr__facts div:last-child { border-right:0; background:var(--flame); }
