or:#526056}.vocabulary{padding-top:0}.four{display:grid;grid-template-columns:repeat(4,1fr);border-top:3px solid var(--ink);border-bottom:1px solid #b4baac}.four article{padding:25px 25px 20px 0}.four span,.card-top,.stack-price{font:700 11px monospace}.four p{font-size:14px}.lead{font-size:21px;max-width:65ch}.areas{display:grid;grid-template-columns:1fr 1fr;column-gap:35px;margin-top:35px;align-items:start}.areas details{border-top:1px solid #aeb5a6;padding:0}.areas summary{display:flex;gap:18px;align-items:center;font-size:19px;font-weight:700;padding:23px 0;cursor:pointer;list-style:none}.areas summary::-webkit-details-marker{display:none}.areas summary span{font:11px monospace;color:#526056}.areas summary b{margin-left:auto;font-size:22px}.areas details[open] summary b{transform:rotate(45deg)}.areas p{font-size:14px;margin:0 0 18px}.checkpoint{border-left:3px solid #cf5b38;padding-left:15px}.plans{background:#e7eadd;max-width:none}.note{padding:22px;border:1px solid #adb5a2;font-size:13px;line-height:1.7;margin:30px 0}.toolbar{display:flex;gap:20px;margin:35px 0 15px;align-items:end}.toolbar label{flex:1}.toolbar label:last-child{max-width:260px}label{display:block;font-size:12px;font-weight:700;line-height:1.6}input,select{display:block;width:100%;font:16px Arial;color:var(--ink);background:white;border:1px solid #8a9786;border-radius:0;padding:14px;margin-top:8px;min-height:48px}.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.plan{display:flex;flex-direction:column;padding:25px;background:var(--paper);border:1px solid #bec6b3;min-width:0;scroll-margin-top:25px}.plan[hidden]{display:none}.card-top{display:flex;justify-content:space-between;text-transform:uppercase;letter-spacing:1px;color:#526056}.plan h3{font-size:32px;margin:24px 0 14px;line-height:1.1}.plan p{font-size:14px;margin:0 0 20px}.plan .price{font:700 13px/1.6 monospace;background:var(--green);padding:13px;margin-bottom:22px}.catch{color:#526056}.alternative{border-top:1px solid #c3c9b9;padding-top:18px}.shop-link{display:block;margin-top:auto;font-size:12px;font-weight:700;padding:16px 0;border-top:2px solid var(--ink);text-decoration:none}.plan>.fine{font-size:10px}.models>p:not(.eyebrow):not(.fine){max-width:75ch}.table-scroll{overflow:auto;margin-top:35px}table{border-collapse:collapse;width:100%;min-width:660px;font-size:14px;text-align:left}caption{text-align:left;font:11px/1.7 monospace;padding-bottom:15px}thead{background:var(--ink);color:white}th,td{padding:20px 15px;border-bottom:1px solid #b4bdab}td{font-family:monospace}th small{display:block;font-size:11px;font-weight:400;margin-top:6px}table a{text-decoration-thickness:1px;text-underline-offset:4px}.model-notes{display:grid;grid-template-columns:1fr 1fr;gap:5px 35px;margin:30px 0}.model-notes p{font-size:14px}.model-notes h3{font-size:19px}.subhead{font-size:32px;margin-top:45px}.calculator{background:var(--ink);color:white;max-width:none;display:grid;grid-template-columns:1fr 1fr;gap:60px}.calculator .eyebrow,.calculator h2{color:var(--green)}.calculator .fine{color:#b6c5bb}.inputs{display:grid;grid-template-columns:1fr 1fr;gap:20px}.calculator input{background:#f3f2e9}output{display:block;font-size:16px;line-height:1.5;background:var(--green);color:var(--ink);padding:25px;margin-top:25px}output strong{display:block;font-size:60px;letter-spacing:-3px}output small{display:block;font-size:12px;margin-top:12px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:35px}.three article{border-top:3px solid var(--ink);padding-top:30px}.stack-price{font-size:55px;letter-spacing:-3px}.stack-price span{font-size:15px;letter-spacing:0}.three p{font-size:15px}.closing{background:var(--orange);max-width:none}.closing h2 em{color:#fff5d9}.closing>p:not(.eyebrow){max-width:58ch;font-size:20px}.closing details{max-width:850px;border-top:1px solid #91351e;margin-top:40px;padding:20px 0;font-size:13px}.closing details p{font-size:13px}.closing summary{cursor:pointer;font-weight:700}.closing>a{display:inline-block;margin:25px 25px 0 0;font-size:14px;font-weight:700}a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,.table-scroll:focus-visible{outline:3px solid #275cf5;outline-offset:4px}[id]{scroll-margin-top:20px}
@media(min-width:1600px){.plans,.calculator,.closing{padding-left:max(6vw,calc((100vw - 1408px)/2));padding-right:max(6vw,calc((100vw - 1408px)/2))}}
@media(max-width:1000px){.plan-grid{grid-template-columns:1fr 1fr}.four{grid-template-columns:1fr 1fr}.hero{padding-top:45px}.hero img{min-width:0}.calculator{gap:30px}}
@media(max-width:700px){.mast{padding:20px;gap:16px}.mast span{display:none}.mast a:first-child{font-size:18px}.hero{grid-template-columns:1fr;padding:35px 24px}.hero h1{font-size:85px}.hero figure{max-width:450px}.hero figcaption{font-size:8px}.ribbon{display:grid;grid-template-columns:1fr 1fr;padding:20px 24px}.contents{padding:22px 24px;gap:18px 24px}.section{padding:42px 24px}.intro,.calculator{grid-template-columns:1fr;gap:10px}.four{gap:5px 20px}.four article{padding-right:0}.four h3{font-size:21px}.areas,.plan-grid,.model-notes,.three{grid-template-columns:1fr}.areas{gap:0}.toolbar{display:block}.toolbar label:last-child{max-width:none;margin-top:15px}.plan{padding:23px}.inputs{gap:15px}.calculator form{margin-top:20px}output strong{font-size:48px}.closing>p:not(.eyebrow){font-size:18px}.three{gap:35px}.lead{font-size:19px}}
</style>
