 .fx .card.is-in .product-image>a:hover img,.fx .card.is-in .product-image>a:focus-visible img{transform:rotate(-3deg) scale(1.02)}
 .fx .product-image>a:hover .glint::before,.fx .product-image>a:focus-visible .glint::before{opacity:1;animation:sweep-once .9s ease-out 1 forwards}
 @keyframes sweep-once{0%{transform:translateX(-160%) skewX(-18deg)}100%{transform:translateX(420%) skewX(-18deg)}}
