 .product-image figcaption{font:10px/1.5 Arial;color:#55554f;min-height:30px;padding:9px 0}
 .product-image .glint::before{width:30%}
 /* Scroll-in: blade slides in from the left, edge line draws under the name (once). */
 .fx .card .product-image img{opacity:0;transform:translateX(-18px)}
 .fx .card.is-in .product-image img{opacity:1;transform:none}
 .edge-line{display:block;height:3px;width:100%;max-width:220px;background:var(--cobalt);margin:-6px 0 16px;transform-origin:left center}
