---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reviews } from '../../data/reviews';

const title = 'PointCast Reviews';
const description =
  'Independent reviews of art software, small web products, listening tools, and interfaces worth living with.';
const latest = reviews[0];
---

<BaseLayout
  title={title}
  description={description}
  image="/images/listening-grove-review/listening-grove-review-og.jpg"
>
  <header class="desk-head">
    <div class="desk-head__top">
      <a href="/" class="wordmark">POINTCAST</a>
      <span>REVIEWS</span>
      <a href="/reviews.json">JSON ↗</a>
    </div>
    <div class="desk-head__title">
      <p>INDEPENDENT PRODUCT CRITICISM / EST. 2026</p>
      <h1>REVIEWS</h1>
      <p class="intro">{description}</p>
    </div>
  </header>

  <main class="desk">
    <article class="lead">
      <a class="lead__image" href={latest.reviewUrl}>
        <img
          src={latest.image}
          width={latest.imageWidth}
          height={latest.imageHeight}
          alt={latest.imageAlt}
          loading="eager"
        />
        <span class="lead__score">{latest.rating}<small>/5</small></span>
      </a>
      <div class="lead__copy">
        <p class="kicker">LATEST / {latest.category.toUpperCase()}</p>
        <h2><a href={latest.reviewUrl}>{latest.title}</a></h2>
        <p>{latest.dek}</p>
        <div class="lead__actions">
          <a class="button button--ink" href={latest.reviewUrl}>READ THE REVIEW →</a>
          <a class="button" href={latest.experienceUrl}>OPEN EXPERIENCE ↗</a>
        </div>
      </div>
    </article>

    <section class="method" aria-labelledby="method-title">
      <div>
        <p class="kicker">THE POINTCAST METHOD</p>
        <h2 id="method-title">USE IT. LISTEN. LOOK AGAIN.</h2>
      </div>
      <p>
        We review the released product on real desktop and mobile viewports, preserve screenshots
        from the tested build, separate design promise from working behavior, and never call a
        wallet handoff a completed transaction. Scores are editorial judgments, not affiliate math.
      </p>
    </section>

    <section class="catalog" aria-labelledby="catalog-title">
      <div class="catalog__head">
        <h2 id="catalog-title">ALL REVIEWS</h2>
        <span>{reviews.length.toString().padStart(2, '0')} PUBLISHED</span>
      </div>
      <div class="catalog__grid">
        {reviews.map((review, index) => (
          <article class="card">
            <a class="card__image" href={review.reviewUrl}>
              <img
                src={review.image}
                width={review.imageWidth}
                height={review.imageHeight}
                alt={review.imageAlt}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </a>
            <div class="card__meta">
              <span>{review.category.toUpperCase()}</span>
              <strong>{review.rating}<small>/5</small></strong>
            </div>
            <h3><a href={review.reviewUrl}>{review.title}</a></h3>
            <p>{review.dek}</p>
            <div class="card__links">
              <a href={review.reviewUrl}>REVIEW →</a>
              <a href={review.jsonUrl}>JSON ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <style>
    :global(body) { background: #f4efdf; color: #151719; }
    .desk-head { border-bottom: 4px solid #151719; }
    .desk-head__top {
      min-height: 50px; padding: 0 4vw; display: flex; align-items: center; gap: 24px;
      background: #151719; color: white; font: 700 12px/1 'JetBrains Mono', monospace;
      letter-spacing: .08em;
    }
    .desk-head__top .wordmark { margin-right: auto; color: #f6dc4c; font-size: 15px; }
    .desk-head__top a { color: inherit; text-decoration: none; }
    .desk-head__title {
      max-width: 1280px; margin: 0 auto; padding: clamp(42px, 8vw, 110px) 4vw 40px;
      display: grid; grid-template-columns: 1fr minmax(250px, 420px); gap: 20px 48px; align-items: end;
      box-sizing: border-box; width: 100%;
    }
    .desk-head__title > p:first-child {
      grid-column: 1 / -1; margin: 0; font: 700 11px/1 'JetBrains Mono', monospace;
      letter-spacing: .14em;
    }
    h1 {
      margin: 0; font: 700 clamp(74px, 15vw, 210px)/.72 'Syne', sans-serif; letter-spacing: -.07em;
    }
    .intro { margin: 0; max-width: 38ch; font: 600 clamp(20px, 2.4vw, 33px)/1.08 'Lora', serif; }
    .desk { max-width: 1280px; margin: 0 auto; padding: 56px 4vw 120px; box-sizing: border-box; width: 100%; }
    .lead { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(270px, .65fr); gap: 38px; align-items: center; }
    .lead__image { position: relative; display: block; background: #111; overflow: hidden; border: 3px solid #151719; }
    .lead__image img { display: block; width: 100%; height: auto; transition: transform .4s ease; }
    .lead__image:hover img { transform: scale(1.012); }
    .lead__score {
      position: absolute; right: 18px; bottom: 18px; width: 98px; aspect-ratio: 1;
      display: grid; place-items: center; background: #f6dc4c; color: #151719;
      border: 3px solid #151719; border-radius: 50%; font: 700 36px/1 'Syne', sans-serif;
      transform: rotate(5deg);
    }
    .lead__score small, .card__meta small { font: 700 12px/1 'JetBrains Mono', monospace; }
    .kicker { margin: 0 0 10px; font: 700 11px/1.2 'JetBrains Mono', monospace; letter-spacing: .12em; }
    .lead h2 { margin: 0 0 18px; font: 700 clamp(42px, 5vw, 76px)/.92 'Syne', sans-serif; letter-spacing: -.045em; }
    .lead h2 a, .card h3 a { color: inherit; text-decoration: none; }
    .lead__copy > p:not(.kicker) { font: 500 19px/1.45 'Lora', serif; }
    .lead__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
    .button {
      padding: 13px 16px; color: #151719; border: 2px solid #151719; text-decoration: none;
      font: 700 11px/1 'JetBrains Mono', monospace;
    }
    .button--ink { background: #151719; color: white; }
    .method {
      margin: 78px 0; padding: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
      border: 3px solid #151719; background: #60d8e7;
    }
    .method h2 { margin: 0; font: 700 clamp(34px, 4vw, 62px)/.93 'Syne', sans-serif; letter-spacing: -.04em; }
    .method > p { margin: 0; font: 600 18px/1.45 'Lora', serif; }
    .catalog__head {
      display: flex; justify-content: space-between; align-items: end; padding-bottom: 12px;
      border-bottom: 4px solid #151719;
    }
    .catalog__head h2 { margin: 0; font: 700 clamp(44px, 7vw, 94px)/.8 'Syne', sans-serif; letter-spacing: -.05em; }
    .catalog__head span { font: 700 11px/1 'JetBrains Mono', monospace; }
    .catalog__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 54px 28px; padding-top: 28px; }
    .card__image { display: block; border: 2px solid #151719; overflow: hidden; background: #ddd; }
    .card__image img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform .35s ease; }
    .card__image:hover img { transform: scale(1.02); }
    .card__meta { display: flex; justify-content: space-between; margin-top: 14px; font: 700 11px/1 'JetBrains Mono', monospace; }
    .card__meta strong { font: 700 30px/1 'Syne', sans-serif; }
    .card h3 { margin: 4px 0 10px; font: 700 clamp(29px, 3.2vw, 48px)/.96 'Syne', sans-serif; letter-spacing: -.035em; }
    .card > p { margin: 0; max-width: 54ch; font: 500 16px/1.5 'Lora', serif; }
    .card__links { display: flex; gap: 20px; margin-top: 18px; }
    .card__links a { color: inherit; font: 700 11px/1 'JetBrains Mono', monospace; }
    @media (max-width: 800px) {
      .desk-head__title, .lead, .method { grid-template-columns: 1fr; }
      .intro { max-width: none; }
      .catalog__grid { grid-template-columns: 1fr; }
      .lead__score { width: 76px; font-size: 28px; }
    }
    @media (max-width: 520px) {
      .desk-head__top { gap: 14px; padding-inline: 18px; }
      .desk-head__title, .desk { padding-left: 18px; padding-right: 18px; }
      .desk-head__title { padding-top: 54px; }
      .desk { padding-top: 28px; }
      .lead { gap: 24px; }
      .method { margin-block: 54px; padding: 22px; gap: 20px; }
    }
  </style>
</BaseLayout>
