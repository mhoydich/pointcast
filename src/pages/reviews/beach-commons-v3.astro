---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { reviewsBySlug } from '../../data/reviews';
import {
  BEACH_COMMONS_V3,
  BEACH_COMMONS_V3_PLATES,
} from '../../lib/beach-commons-v3';

const review = reviewsBySlug.get('beach-commons-v3')!;
const [bakery, loom, relay, energy, shade, oven, wildlife, finale] = BEACH_COMMONS_V3_PLATES;

const reviewJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  '@id': 'https://pointcast.xyz/reviews/beach-commons-v3#review',
  url: 'https://pointcast.xyz/reviews/beach-commons-v3',
  name: review.title,
  headline: review.title,
  description: review.dek,
  datePublished: '2026-07-27',
  inLanguage: 'en-US',
  author: {
    '@type': 'Organization',
    name: 'PointCast Review Lab',
    url: 'https://pointcast.xyz/reviews',
  },
  itemReviewed: {
    '@type': 'CreativeWorkSeries',
    name: BEACH_COMMONS_V3.title,
    alternateName: BEACH_COMMONS_V3.magazineTitle,
    url: BEACH_COMMONS_V3.url,
    creator: {
      '@type': 'Person',
      name: 'Michael Hoydich',
    },
    numberOfItems: BEACH_COMMONS_V3_PLATES.length,
    artform: 'Speculative civic-architecture image series',
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: review.rating,
    bestRating: 5,
    worstRating: 1,
  },
};

const kit = [
  {
    number: '01',
    name: 'Pedal mixer',
    line: 'Enough theater to make dough visible. Enough guard to keep the theater honest.',
  },
  {
    number: '02',
    name: 'Solar proofing cabinet',
    line: 'A small, believable use of California sun. Warm dough, not the electrical grid.',
  },
  {
    number: '03',
    name: 'Palm loom',
    line: 'Pre-collected pruning material enters as waste and leaves as shade, basket, flag, or fan.',
  },
  {
    number: '04',
    name: 'Clean-down cart',
    line: 'The least photogenic machine is the one that decides whether the whole idea deserves tomorrow.',
  },
];
---

<BlockLayout legacy
  title={review.title}
  description={review.dek}
  image="/images/og/beach-commons-v3.png"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewJsonLd)} />

  <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

  <article class="issue">
    <header class="cover">
      <img
        src={finale.image}
        width="1536"
        height="1024"
        alt={finale.alt}
        fetchpriority="high"
      />
      <div class="cover__wash"></div>
      <nav class="cover__nav" aria-label="Magazine feature navigation">
        <a class="cover__pointcast" href="/">POINTCAST</a>
        <a href="/reviews">REVIEWS</a>
        <span>ISSUE 04</span>
        <a href="/reviews/beach-commons-v3.json">JSON ↗</a>
      </nav>
      <div class="cover__disclosure">
        UNOFFICIAL MAGAZINE CONCEPT · NOT AFFILIATED WITH MAXIM
      </div>
      <div class="cover__copy">
        <p>FOOD / TRAVEL / GEAR / SPORT / CIVIC FANTASY</p>
        <h1>THE<br /><em>MAXIMUM</em><br />BEACH</h1>
        <h2>BREAD BEFORE BREAKFAST. SHADE BEFORE NOON. EVERYTHING GONE BY MOONRISE.</h2>
      </div>
      <a class="cover__open" href="#review">OPEN THE ISSUE <span>↓</span></a>
    </header>

    <section class="cold-open" id="review">
      <figure data-reveal>
        <img src={bakery.image} width="1536" height="1024" alt={bakery.alt} />
        <figcaption>THE FLASH BAKERY / SUNRISE / ONE DAY ONLY</figcaption>
      </figure>
      <div class="cold-open__copy" data-reveal>
        <p class="eyebrow">THE 30-SECOND VERSION</p>
        <h2>THIS ISN’T A BAKERY ON A BEACH. IT’S A TOWN CLOCK WITH CRUST.</h2>
        <p class="lede">
          <b>Beach Commons V3</b> trades monumentality for metabolism. Grain arrives. Dough wakes
          up. Clean palm material becomes shade. Everybody gets a job worth watching.
        </p>
        <p>
          By dinner, the games have made a roof, the ovens have made a table, and cleanup has
          become the closing ceremony. The pitch is outrageous. The sequence is unusually clear.
        </p>
      </div>
    </section>

    <section class="numbers" aria-label="Review numbers">
      <div><strong>08</strong><span>FIELD PLATES</span></div>
      <div><strong>01</strong><span>DAY</span></div>
      <div><strong>00</strong><span>PALMS HARVESTED</span></div>
      <div class="numbers__score"><strong>4.6</strong><span>OUT OF 5</span></div>
    </section>

    <section class="verdict">
      <p class="eyebrow">THE VERDICT</p>
      <p data-reveal>
        The rare beach fantasy that understands glamour as
        <em>fresh bread, useful shade, good tools, and a seat for everybody.</em>
      </p>
    </section>

    <section class="split split--palm">
      <div class="split__copy" data-reveal>
        <span class="chapter-no">01</span>
        <p class="eyebrow">THE MATERIAL</p>
        <h2>WEAVE THE ROOF.<br />KEEP THE PALM.</h2>
        <p>
          V3 gets one thing exactly right: the beach is not a craft store. No frond is cut from a
          living tree, dune, or habitat. Clean pruning material arrives through a documented waste
          stream and enters the court like equipment.
        </p>
        <p>
          Sorting, trimming, teaching, weaving, testing, repairing, and raising the shade all count.
          The object is useful. The process is the sport.
        </p>
      </div>
      <figure data-reveal>
        <img src={loom.image} width="1536" height="1024" alt={loom.alt} loading="lazy" />
        <figcaption>PALM LOOM COURT / THE HANDS MAKE THE WEATHER</figcaption>
      </figure>
    </section>

    <section class="full-image" data-reveal>
      <img src={relay.image} width="1536" height="1024" alt={relay.alt} loading="lazy" />
      <div class="full-image__type">
        <p>THE DOUGH RELAY</p>
        <h2>THE OPPONENT IS BREAKFAST.</h2>
      </div>
    </section>

    <section class="relay-copy">
      <p class="eyebrow">THE GAME</p>
      <div>
        <h2>WASH. MIX. REST. SHAPE. LOAD. SET. CLEAN.</h2>
        <p>
          The smartest move in the issue is turning the production line into a social line. The
          cyclist, the baker, the child with the bell, the seated shaper, the table setter, and the
          clean-down crew are not supporting the event. They are the event.
        </p>
      </div>
    </section>

    <section class="gear" aria-labelledby="gear-title">
      <header>
        <p class="eyebrow">THE GEAR</p>
        <h2 id="gear-title">FOUR MACHINES WE’D ACTUALLY WATCH.</h2>
      </header>
      <figure class="gear__image" data-reveal>
        <img src={energy.image} width="1536" height="1024" alt={energy.alt} loading="lazy" />
        <figcaption>SUN, FLOUR, WATER / NO MIRACLE GENERATOR REQUIRED</figcaption>
      </figure>
      <div class="gear__list">
        {kit.map((item) => (
          <article data-reveal>
            <span>{item.number}</span>
            <h3>{item.name}</h3>
            <p>{item.line}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="quote">
      <p>“THE PUBLIC SCORE IS HOW MUCH COMFORT APPEARS—AND HOW LITTLE TROUBLE REMAINS.”</p>
    </section>

    <section class="split split--shade">
      <figure data-reveal>
        <img src={shade.image} width="1536" height="1024" alt={shade.alt} loading="lazy" />
        <figcaption>SHADE RAISING / USEFUL WORK WITH A CROWD</figcaption>
      </figure>
      <div class="split__copy" data-reveal>
        <span class="chapter-no">02</span>
        <p class="eyebrow">THE SPORT</p>
        <h2>THE ROOF<br />HAS A SCORE.</h2>
        <p>
          Raise the most useful shade with the least material. Keep everybody clear of moving
          panels. Give seated operators real controls. Release the sail before the wind makes the
          decision for you.
        </p>
        <p>
          It is less macho than conquering the elements and far more attractive: build something
          comfortable together, then know exactly when to fold it.
        </p>
      </div>
    </section>

    <section class="oven">
      <div class="oven__copy" data-reveal>
        <p class="eyebrow">HOT STUFF / ACTUAL BOUNDARIES</p>
        <h2>THE OVENS STAY INLAND.</h2>
        <p>
          The best photograph in most fantasy projects is where the rules disappear. Here, the
          rules improve the picture: compact commercial ovens on approved hardscape, trained
          operators, guarded heat, water, extinguishers, clean circulation, and the public table
          close enough to smell what is coming.
        </p>
        <p>
          Real service still needs permits, public-health controls, cold storage, allergen
          management, professional staffing, and a site plan. The image is a proposition, not an
          operating license.
        </p>
      </div>
      <figure data-reveal>
        <img src={oven.image} width="1536" height="1024" alt={oven.alt} loading="lazy" />
        <figcaption>OVEN HOUR / GLAMOUR WITH AN EXTINGUISHER</figcaption>
      </figure>
    </section>

    <section class="wildlife">
      <img src={wildlife.image} width="1536" height="1024" alt={wildlife.alt} loading="lazy" />
      <div class="wildlife__copy" data-reveal>
        <p class="eyebrow">THE MORNING AFTER</p>
        <h2>BREAKFAST FOR PEOPLE.<br />DISTANCE FOR BIRDS.</h2>
        <p>
          Food stays inland. Waste stays sealed. Habitat stays empty. The best evidence that the
          commons worked is the wide quiet beach it gives back.
        </p>
      </div>
    </section>

    <section class="scorecard">
      <div class="scorecard__intro">
        <p class="eyebrow">THE SCORECARD</p>
        <h2>HIGH HEAT.<br />COOL HEAD.</h2>
        <p>The score applies to the published conceptual experience—not to a real bakery, structure, or permitted event.</p>
      </div>
      <div class="scorecard__scores">
        <div><span>CONCEPT</span><strong>4.9</strong></div>
        <div><span>ART DIRECTION</span><strong>4.8</strong></div>
        <div><span>PUBLIC JOY</span><strong>4.9</strong></div>
        <div><span>BUILD REALITY</span><strong>3.8</strong></div>
      </div>
      <div class="scorecard__lists">
        <div>
          <h3>WHAT HITS</h3>
          <ul>
            <li>An instantly legible public premise</li>
            <li>Craft becomes architecture and sport</li>
            <li>Food, energy, cleanup, and habitat form one day</li>
            <li>Eight images hold one distinctive world</li>
          </ul>
        </div>
        <div>
          <h3>WHAT NEEDS WORK</h3>
          <ul>
            <li>The roof demands serious wind engineering</li>
            <li>Professional food operations are non-negotiable</li>
            <li>The energy system is intentionally small</li>
            <li>Permits decide whether “flash” is actually fast</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="final">
      <img src={finale.image} width="1536" height="1024" alt={finale.alt} loading="lazy" />
      <div class="final__wash"></div>
      <div class="final__copy" data-reveal>
        <p class="eyebrow">BOTTOM LINE</p>
        <div class="final__rating"><strong>4.6</strong><span>/ 5</span></div>
        <h2>BAKE THE SHADE.<br />WEAVE THE MEAL.</h2>
        <p>
          Beach Commons V3 is an excellent fantasy because its pleasure comes from useful things:
          a hot loaf, a cool patch of ground, a tool passed hand to hand, and a table long enough
          to become the evening.
        </p>
        <div class="final__actions">
          <a class="button button--hot" href="/beach-commons/v3">ENTER THE FIELD STUDY →</a>
          <a class="button" href="/reviews/beach-commons-v3.json">READ THE JSON ↗</a>
        </div>
      </div>
    </section>

    <aside class="disclosure">
      <b>EDITORIAL DISCLOSURE</b>
      <p>{BEACH_COMMONS_V3.magazineBoundary}</p>
    </aside>

    <footer class="issue__footer">
      <a href="/">POINTCAST</a>
      <p>THE MAXIMUM BEACH / REVIEW LAB / JULY 2026</p>
      <a href="#review">BACK TO TOP ↑</a>
    </footer>
  </article>

  <script is:inline>
    function initMaximumBeach() {
      const bar = document.querySelector('[data-progress]');
      const update = () => {
        if (!bar) return;
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const value = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;
        bar.style.transform = `scaleX(${value})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });

      const reveals = document.querySelectorAll('[data-reveal]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        reveals.forEach((element) => element.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      reveals.forEach((element) => observer.observe(element));
    }

    initMaximumBeach();
    document.addEventListener('astro:page-load', initMaximumBeach);
  </script>

  <style>
    :global(body) {
      background: #e9e0d0;
      color: #121817;
    }
    :global(html) { scroll-behavior: smooth; }
    .reading-progress {
      position: fixed;
      z-index: 150;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: rgba(255,255,255,.25);
    }
    .reading-progress span {
      display: block;
      width: 100%;
      height: 100%;
      transform: scaleX(0);
      transform-origin: left;
      background: #ff5d2e;
    }
    .issue {
      --ink: #121817;
      --cream: #f6eddb;
      --hot: #ff5d2e;
      --sun: #f1bb40;
      --palm: #777d3c;
      --sea: #2c7686;
      --mono: 'JetBrains Mono', monospace;
      --display: 'Syne', sans-serif;
      --serif: 'Lora', serif;
      background: var(--cream);
      color: var(--ink);
    }
    .issue img { display: block; width: 100%; }
    .cover {
      position: relative;
      min-height: max(760px, calc(100vh - 20px));
      overflow: hidden;
      isolation: isolate;
      background: #101820;
      color: white;
    }
    .cover > img, .cover__wash { position: absolute; inset: 0; width: 100%; height: 100%; }
    .cover > img { z-index: -2; object-fit: cover; }
    .cover__wash {
      z-index: -1;
      background:
        linear-gradient(90deg, rgba(6,10,13,.82), rgba(6,10,13,.12) 72%),
        linear-gradient(0deg, rgba(6,10,13,.7), transparent 60%);
    }
    .cover__nav {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto auto;
      min-height: 56px;
      border-bottom: 1px solid rgba(255,255,255,.36);
    }
    .cover__nav > * {
      display: flex;
      align-items: center;
      padding: 0 22px;
      border-left: 1px solid rgba(255,255,255,.28);
      color: inherit;
      font: 700 9px/1 var(--mono);
      letter-spacing: .13em;
      text-decoration: none;
    }
    .cover__nav .cover__pointcast { border-left: 0; font-family: var(--display); font-size: 14px; }
    .cover__disclosure {
      position: absolute;
      top: 76px;
      right: 22px;
      max-width: 290px;
      padding: 9px 12px;
      border: 1px solid rgba(255,255,255,.42);
      background: rgba(6,10,13,.62);
      font: 700 8px/1.4 var(--mono);
      letter-spacing: .11em;
    }
    .cover__copy {
      position: absolute;
      left: clamp(22px, 5vw, 80px);
      bottom: clamp(76px, 8vw, 110px);
      width: min(880px, calc(100% - 44px));
    }
    .cover__copy > p {
      margin: 0 0 20px;
      font: 700 9px/1.4 var(--mono);
      letter-spacing: .15em;
    }
    .cover h1 {
      margin: 0;
      font: 700 clamp(68px, 10.8vw, 170px)/.66 var(--display);
      letter-spacing: -.075em;
    }
    .cover h1 em { color: var(--sun); font-family: var(--serif); font-weight: 500; }
    .cover h2 {
      max-width: 620px;
      margin: 32px 0 0;
      font: 700 clamp(17px, 2vw, 29px)/1.12 var(--display);
      letter-spacing: -.02em;
    }
    .cover__open {
      position: absolute;
      right: 24px;
      bottom: 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      color: white;
      font: 700 9px/1 var(--mono);
      letter-spacing: .12em;
      text-decoration: none;
    }
    .cover__open span {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid white;
      border-radius: 50%;
      font-size: 20px;
    }
    .eyebrow {
      margin: 0 0 16px;
      font: 700 9px/1.3 var(--mono);
      letter-spacing: .14em;
    }
    .cold-open {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
      gap: clamp(34px, 6vw, 90px);
      padding: clamp(70px, 9vw, 130px) max(5vw, calc((100vw - 1380px) / 2));
      background: var(--cream);
    }
    figure { margin: 0; }
    figcaption {
      padding-top: 10px;
      font: 700 8px/1.4 var(--mono);
      letter-spacing: .1em;
    }
    .cold-open figure img { aspect-ratio: 3 / 2; object-fit: cover; }
    .cold-open__copy { align-self: center; }
    .cold-open h2, .relay-copy h2, .gear h2, .oven h2 {
      margin: 0;
      font: 700 clamp(40px, 5.2vw, 76px)/.88 var(--display);
      letter-spacing: -.055em;
    }
    .cold-open__copy .lede {
      margin-top: 28px;
      font: 600 clamp(20px, 2vw, 28px)/1.38 var(--serif);
    }
    .cold-open__copy > p:last-child { font: 500 17px/1.55 var(--serif); }
    .numbers {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      background: var(--hot);
      color: white;
    }
    .numbers div { padding: clamp(28px, 4vw, 56px); border-right: 1px solid rgba(255,255,255,.35); }
    .numbers div:last-child { border-right: 0; background: var(--ink); }
    .numbers strong { display: block; font: 700 clamp(52px, 7vw, 100px)/.72 var(--display); letter-spacing: -.06em; }
    .numbers span { display: block; margin-top: 17px; font: 700 8px/1 var(--mono); letter-spacing: .13em; }
    .verdict {
      padding: clamp(70px, 11vw, 160px) max(5vw, calc((100vw - 1180px) / 2));
      background: var(--ink);
      color: white;
    }
    .verdict > p:last-child {
      margin: 0;
      font: 700 clamp(46px, 7vw, 98px)/.92 var(--display);
      letter-spacing: -.055em;
    }
    .verdict em { color: var(--sun); font-family: var(--serif); font-weight: 500; }
    .split {
      display: grid;
      grid-template-columns: minmax(320px, .72fr) minmax(0, 1.28fr);
      min-height: 760px;
    }
    .split--shade { grid-template-columns: minmax(0, 1.28fr) minmax(320px, .72fr); background: #d7d58e; }
    .split__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(42px, 6vw, 88px);
      background: #d7d58e;
    }
    .split--shade .split__copy { background: var(--cream); }
    .chapter-no { margin-bottom: auto; color: var(--hot); font: 700 42px/1 var(--mono); }
    .split h2 {
      margin: 0 0 28px;
      font: 700 clamp(45px, 6vw, 86px)/.84 var(--display);
      letter-spacing: -.06em;
    }
    .split__copy > p:not(.eyebrow) { margin: 0 0 18px; font: 500 17px/1.55 var(--serif); }
    .split figure { min-width: 0; display: flex; flex-direction: column; }
    .split figure img { flex: 1; height: 100%; object-fit: cover; }
    .split figcaption { padding: 10px 18px 18px; }
    .full-image { position: relative; min-height: 82vh; background: #111; color: white; }
    .full-image img { position: absolute; inset: 0; height: 100%; object-fit: cover; }
    .full-image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.74), transparent 58%); }
    .full-image__type { position: absolute; z-index: 1; left: 5vw; right: 5vw; bottom: 5vw; }
    .full-image__type p { font: 700 9px/1 var(--mono); letter-spacing: .14em; }
    .full-image__type h2 { margin: 0; font: 700 clamp(50px, 8vw, 120px)/.78 var(--display); letter-spacing: -.06em; }
    .relay-copy {
      display: grid;
      grid-template-columns: .35fr 1fr;
      gap: 50px;
      padding: clamp(70px, 10vw, 140px) max(5vw, calc((100vw - 1200px) / 2));
      background: var(--hot);
      color: white;
    }
    .relay-copy > div p { max-width: 760px; font: 500 19px/1.5 var(--serif); }
    .gear {
      padding: clamp(74px, 10vw, 150px) max(5vw, calc((100vw - 1380px) / 2));
      background: var(--ink);
      color: white;
    }
    .gear header { max-width: 930px; margin-bottom: 48px; }
    .gear__image img { aspect-ratio: 3 / 2; object-fit: cover; }
    .gear__list { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 44px; border: 1px solid rgba(255,255,255,.28); }
    .gear__list article { padding: 30px; border-right: 1px solid rgba(255,255,255,.28); border-bottom: 1px solid rgba(255,255,255,.28); }
    .gear__list article:nth-child(even) { border-right: 0; }
    .gear__list article:nth-last-child(-n + 2) { border-bottom: 0; }
    .gear__list span { color: var(--sun); font: 700 10px/1 var(--mono); }
    .gear__list h3 { margin: 24px 0 10px; font: 700 32px/1 var(--display); }
    .gear__list p { margin: 0; font: 500 16px/1.5 var(--serif); }
    .quote {
      padding: clamp(72px, 10vw, 140px) 5vw;
      background: var(--sun);
    }
    .quote p {
      max-width: 1300px;
      margin: 0 auto;
      text-align: center;
      font: 700 clamp(48px, 8vw, 116px)/.86 var(--display);
      letter-spacing: -.06em;
    }
    .oven {
      display: grid;
      grid-template-columns: minmax(320px, .78fr) minmax(0, 1.22fr);
      background: var(--cream);
    }
    .oven__copy { align-self: center; padding: clamp(44px, 6vw, 88px); }
    .oven__copy > p:not(.eyebrow) { font: 500 17px/1.55 var(--serif); }
    .oven figure { min-width: 0; }
    .oven figure img { height: 100%; min-height: 740px; object-fit: cover; }
    .oven figcaption { padding: 10px 16px 18px; }
    .wildlife { position: relative; min-height: 85vh; overflow: hidden; background: #24363b; color: white; }
    .wildlife > img { position: absolute; inset: 0; height: 100%; object-fit: cover; }
    .wildlife::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,17,20,.82), transparent 72%); }
