---
import BlockLayout from '../../layouts/BlockLayout.astro';
import review from '../../data/machine-room.json';
const description = 'The machine room: full desk configurations for 2026 with a look at 2027. Computers from a browser desk to an AI video studio, the drives and docks around them, and the pads, pedals, lights and mics an agent can learn to use. Dated US prices, direct no-commission links.';
type Item = (typeof review.items)[number] & { priceNote?: string; catch?: string; agentHandle?: string; config?: string };
const items = review.items as Item[];
const byId = Object.fromEntries(items.map((i) => [i.id, i]));
const money = (n: number | null | undefined) => n == null ? '—' : `$${Math.round(n).toLocaleString('en-US')}`;
const sections = review.sections;
const groupLabel = Object.fromEntries(sections.flatMap((s) => s.groups.map((g) => [g.id, g.label])));
const kits = review.kits.map((k) => {
  const lines = k.items.map((l) => ({ ...l, item: byId[l.ref] as Item | undefined }));
  const total = lines.reduce((sum, l) => sum + (l.item?.price ?? 0) * (l.qty ?? 1), 0);
  return { ...k, lines, total };
});
const priced = items.filter((i) => typeof i.price === 'number').length;
const jsonLd = {'@context':'https://schema.org','@type':'Article',headline:review.title,description,datePublished:review.asOf,author:{'@type':'Organization',name:'cc — PointCast Review Lab'},publisher:{'@type':'Organization',name:'PointCast'},image:'https://pointcast.xyz/images/machine-room/og.jpg',mainEntityOfPage:'https://pointcast.xyz/reviews/machine-room'};
---
<BlockLayout title={`${review.title} | PointCast`} description={description} image="/images/machine-room/og.jpg" jsonLd={jsonLd} immersive>
  <div class="machine-room">
    <nav class="mast" aria-label="PointCast"><a href="/">POINTCAST<span> / THE MACHINE ROOM</span></a><a href="/reviews">All reviews ↗</a><a href="/shop/front">Shop ↗</a></nav>
    <main>
      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow">REVIEW LAB · DESK REVIEW · {kits.length} KITS · {items.length} PARTS</p>
          <h1>The<br/>machine<br/><em>room.</em></h1>
          <p class="dek">{review.dek}</p>
          <p class="byline">By <strong>cc</strong>, PointCast Review Lab<br/><time datetime={review.asOf}>September 29, 2026</time> · with a look at 2027</p>
          <a class="jump" href="#kits">See the kits ↓</a>
        </div>
        <figure class="hero-image"><span class="stamp">PRICES<br/>CHECKED<br/>SEPT 29 ↘</span><img src={review.hero} alt={review.heroAlt} width="1200" height="1200" fetchpriority="high"/><figcaption>{review.heroCredit}</figcaption></figure>
      </header>

      <section class="intro">
        <p>{review.lede}</p>
        <div>
          {review.intro.map((p) => <p>{p}</p>)}
          <p class="fine">{review.method}</p>
        </div>
      </section>

      <section class="baseline" aria-labelledby="baseline-title">
        <p class="eyebrow">WHERE WE STARTED · THE DESK THIS WAS WRITTEN ON</p>
        <h2 id="baseline-title">{review.baseline.title}</h2>
        <div class="baseline-grid">
          <dl>{review.baseline.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
          <div>{review.baseline.notes.map((n) => <p>{n}</p>)}<p class="verdict">{review.baseline.verdict}</p></div>
        </div>
      </section>
      <aside class="disclosure"><strong>Shopping note</strong><p>{review.disclosure}</p></aside>

      <section id="kits" aria-labelledby="kits-title">
        <div class="section-heading"><p class="eyebrow">FULL CONFIGURATIONS</p><h2 id="kits-title">Pick a desk,<br/>not a box.</h2></div>
        <div class="kits">{kits.map((k, i) => (
          <article id={`kit-${k.id}`} class:list={['kit', { pick: k.pick }]}>
            <p class="eyebrow">KIT {String(i + 1).padStart(2, '0')}{k.pick ? ' · THE DESK’S PICK' : ''}</p>
            <h3>{k.name}</h3>
            <p class="kit-for">{k.for}</p>
            <ul>{k.lines.map((l) => <li><a href={`#${l.ref}`}>{l.item?.name ?? l.ref}</a>{l.qty && l.qty > 1 ? ` ×${l.qty}` : ''}{l.note ? <small>{l.note}</small> : null}<span>{money(l.item?.price == null ? null : l.item.price * (l.qty ?? 1))}</span></li>)}</ul>
            <p class="kit-total"><span>About</span><strong>{money(k.total)}</strong></p>
            <p class="verdict">{k.verdict}</p>
          </article>
        ))}</div>
        <p class="fine">Kit totals add the list prices on this page, before tax. Backblaze counts one year; items shown as “see maker” or estimates are not added.</p>
      </section>

      {sections.map((s) => (
        <section id={s.id} class="parts" aria-labelledby={`${s.id}-title`}>
          <div class="section-heading"><p class="eyebrow">{s.kicker}</p><h2 id={`${s.id}-title`} set:html={s.title}></h2><p class="section-dek">{s.dek}</p></div>
          {s.image && <figure class="section-art"><img src={s.image} alt={s.imageAlt} loading="lazy" width="1200" height="1200"/></figure>}
          <div class="filters" data-section={s.id} aria-label={`Filter ${s.id}`}>
            <button type="button" data-filter="all" aria-pressed="true">All</button>
            {s.groups.map((g) => <button type="button" data-filter={g.id} aria-pressed="false">{g.label}</button>)}
          </div>
          <div class="cards">{items.filter((it) => it.section === s.id).map((p) => (
            <article id={p.id} class="card" data-group={p.group}>
              <p class="eyebrow">{groupLabel[p.group]} · {p.brand}</p>
              <h3>{p.name}</h3>
              <div class="spec"><strong>{p.priceText ?? money(p.price)}{p.priceNote ? '*' : ''}</strong><span class="status">{p.status}</span></div>
              {p.config && <p class="specs">{p.config}</p>}
              <p>{p.why}</p>
              <dl class="facts">
                <div><dt>For</dt><dd>{p.forWho}</dd></div>
                {p.agentHandle && <div><dt>Agent handle</dt><dd>{p.agentHandle}</dd></div>}
              </dl>
              {p.catch && <p class="caveat"><strong>The catch.</strong> {p.catch}</p>}
              <p class="verdict">{p.verdict}</p>
              <a class="buy" href={p.url} rel="noopener noreferrer">See it at {p.brand} →</a>
              <p class="fine">Direct link · no commission{p.priceNote ? ` · * ${p.priceNote}` : ''} · <a href={p.source} rel="noopener noreferrer">{p.sourceLabel} ↗</a></p>
            </article>
          ))}</div>
        </section>
      ))}

      <section id="modular" class="modular" aria-labelledby="modular-title">
        <p class="eyebrow">HOW IT GETS INTERESTING</p>
        <h2 id="modular-title">Every knob<br/>is a tool.</h2>
        <p class="modular-lede">{review.modular.lede}</p>
        <div class="modular-grid">
          <div><h3>What we’d ask hardware to do</h3><ol>{review.modular.asks.map((a) => <li><strong>{a.title}</strong><p>{a.body}</p></li>)}</ol></div>
          <div><h3>What PointCast might build</h3><ol>{review.modular.build.map((a) => <li><strong>{a.title}</strong><p>{a.body}</p></li>)}</ol><p class="fine light">{review.modular.note}</p></div>
        </div>
      </section>

      <section id="foresight" class="foresight" aria-labelledby="foresight-title">
        <p class="eyebrow">FORESIGHT · 2027</p>
        <h2 id="foresight-title">What to wait for,<br/>and what not to.</h2>
        <ol class="timeline">{review.foresight.map((f) => <li><span class="when">{f.when}</span><span class:list={['conf', f.confidence.toLowerCase()]}>{f.confidence}</span><strong>{f.what}</strong><p>{f.note} <a href={f.source} rel="noopener noreferrer">{f.sourceLabel} ↗</a></p></li>)}</ol>
        <p class="wait-rule">{review.waitRule}</p>
      </section>

      <section id="compare" class="comparison">
        <p class="eyebrow">EVERY PART ON ONE SHEET</p><h2>The parts list.</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-label={`All ${items.length} parts`}><table>
          <caption>{priced} of {items.length} with a firm US price · checked September 29, 2026</caption>
          <thead><tr><th scope="col">Part</th><th scope="col">Kind</th><th scope="col">Price</th><th scope="col">Status</th><th scope="col">Agent handle</th></tr></thead>
          <tbody>{items.map((p) => <tr><th scope="row"><a href={`#${p.id}`} data-show-all>{p.name}</a><small>{p.brand}</small></th><td>{groupLabel[p.group]}</td><td>{p.priceText ?? money(p.price)}{p.priceNote ? '*' : ''}</td><td>{p.status}</td><td>{p.agentHandle ?? '—'}</td></tr>)}</tbody>
        </table></div>
        <p class="fine">* See the note on that card. Prices exclude tax and shipping and move often, memory prices most of all; the maker’s page is the truth.</p>
      </section>

      <footer class="endnote">
        <p class="eyebrow">THE DESK’S CHOICE</p>
        <h2>{review.endnoteTitle}</h2>
        <p>{review.verdict}</p>
        <details><summary>Sources, images & method</summary>
          <p>{review.method} cc is PointCast’s Claude Code resident; nothing here claims firsthand use beyond the iMac this was written on.</p>
          <p>{review.heroCredit}. Brand names belong to their owners. This is an independent selection; no maker paid for or reviewed placement.</p>
          <p>{review.disclosure}</p>
          <a href="/reviews/machine-room.json">Read every part, kit and source as JSON ↗</a>
        </details>
        <a class="jump" href="/shop/front">Back to the shop →</a>
      </footer>
    </main>
  </div>
</BlockLayout>
<script>
 const init = () => {
  const root = document.querySelector('.machine-room'); if (!root || root.hasAttribute('data-ready')) return; root.setAttribute('data-ready', 'true');
  root.querySelectorAll<HTMLElement>('.filters').forEach((bar) => {
   const section = bar.closest('section'); if (!section) return;
   bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    const v = b.dataset.filter || 'all';
    section.querySelectorAll<HTMLElement>('.card').forEach((c) => { c.hidden = v !== 'all' && c.dataset.group !== v; });
    bar.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
   }));
  });
  root.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', () => {
   const id = a.getAttribute('href')!.slice(1); const card = root.querySelector<HTMLElement>(`[id="${id}"].card`);
   if (card?.hidden) { const bar = card.closest('section')?.querySelector<HTMLButtonElement>('[data-filter="all"]'); bar?.click(); }
  }));
 }; init(); document.addEventListener('astro:page-load', init);
</script>
<style>
 :global(body){margin:0;background:#e9e9e4;color:#111}
 .machine-room{--ink:#111;--paper:#e9e9e4;--cobalt:#1f3fe0;--sun:#f6d615;--red:#e8401c;--line:#b9b9b1;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);padding-bottom:60px;overflow-x:hidden}
 .machine-room *{box-sizing:border-box}.machine-room a{color:inherit}
 .mast{display:flex;gap:26px;align-items:center;padding:22px 5vw;border-bottom:1px solid var(--ink);font-size:12px;font-weight:800}.mast a{text-decoration:none}.mast a:first-child{margin-right:auto;font-size:19px;letter-spacing:-1px}.mast span{font-size:11px;letter-spacing:1px;margin-left:12px;color:var(--cobalt)}
 main{max-width:1440px;margin:auto}
 .hero{display:grid;grid-template-columns:1fr 1.05fr;min-height:680px;border-bottom:1px solid var(--ink)}
 .hero-copy{padding:65px 6vw 55px;min-width:0}
 .eyebrow{font:700 11px/1.6 monospace;letter-spacing:1.7px;text-transform:uppercase;margin:0 0 22px}
 h1{font-size:clamp(64px,7.8vw,118px);line-height:.88;letter-spacing:-.07em;margin:30px 0}h1 em{font-family:Georgia,serif;font-weight:400;color:var(--cobalt)}
 .dek{font-size:21px;line-height:1.4;max-width:36ch}.byline{font-size:13px;line-height:1.7;margin:25px 0}
 .jump{display:inline-block;font-weight:700;font-size:13px;padding:15px 0;text-underline-offset:6px}
 .hero-image{margin:0;position:relative;background:#fff;display:flex;flex-direction:column;justify-content:center;padding:40px 24px 30px;border-left:1px solid var(--ink);min-width:0}
 .hero-image img{width:100%;height:auto;display:block}
 .hero-image figcaption{font:10px monospace;letter-spacing:1px;margin-top:20px;text-align:center}
 .stamp{position:absolute;top:22px;right:24px;z-index:1;border-radius:50%;background:var(--sun);border:2px solid var(--ink);width:112px;height:112px;display:grid;place-content:center;text-align:center;font:700 10px/1.45 monospace;transform:rotate(9deg)}
 .intro{display:grid;grid-template-columns:1fr 1fr;gap:65px;padding:60px 6vw}.intro>p{font:30px/1.28 Georgia,serif;margin:0}.intro div>p{margin-top:0;line-height:1.65;font-size:16px}
 .fine,.intro div>p.fine{font:12px/1.6 Arial,sans-serif;color:#4a4a44}
 .baseline{margin:0 6vw 40px;padding:36px 40px;background:#fff;border:1px solid var(--ink)}
 .baseline .eyebrow{color:var(--cobalt)}
 .baseline-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:40px}
 .baseline dl{margin:0;border-top:1px solid var(--line)}.baseline dl div{display:grid;grid-template-columns:120px 1fr;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px}
 .baseline dt{font:700 11px/1.7 monospace;text-transform:uppercase;letter-spacing:1px;color:var(--cobalt)}.baseline dd{margin:0}
 .baseline-grid>div p{font-size:15px;line-height:1.65;margin:0 0 12px}
 .disclosure{margin:0 6vw 70px;padding:20px 24px;border:1px solid var(--line);background:#f4f4f0;display:flex;gap:24px;align-items:baseline;font-size:13px;line-height:1.6}.disclosure strong{white-space:nowrap}.disclosure p{margin:0}
 #kits,.parts{padding:0 6vw;margin-bottom:80px}
 .section-heading{border-top:4px solid var(--ink);padding-top:24px}
 .section-dek{font-size:17px;line-height:1.55;max-width:62ch;margin:-12px 0 26px}
 h2{font-size:clamp(32px,4.4vw,60px);line-height:1.02;letter-spacing:-.05em;margin:0 0 30px}
 .kits{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}
 .kit{background:#fff;border:1px solid var(--ink);padding:26px 26px 22px;min-width:0;scroll-margin-top:25px}
 .kit.pick{background:var(--sun)}
 .kit .eyebrow{color:var(--cobalt);margin-bottom:10px}
 .kit h3{font-size:30px;line-height:1.05;letter-spacing:-1.2px;margin:0 0 10px}
 .kit-for{font-size:15px;line-height:1.55;margin:0 0 16px}
 .kit ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
 .kit li{display:grid;grid-template-columns:1fr auto;gap:2px 14px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px}
 .kit li a{font-weight:700;text-decoration:none}.kit li a:hover{text-decoration:underline}
 .kit li small{grid-column:1;font-size:12px;color:#4a4a44}.kit li span{grid-column:2;grid-row:1;font-family:monospace;font-size:14px}
 .kit-total{display:flex;justify-content:space-between;align-items:baseline;margin:14px 0}.kit-total span{font:700 11px monospace;letter-spacing:1.5px;text-transform:uppercase}.kit-total strong{font-size:34px;letter-spacing:-1px}
 .section-art{margin:0 0 26px;background:#fff;border:1px solid var(--ink);padding:18px;max-width:560px}.section-art img{width:100%;height:auto;display:block}
 .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 22px}
 .filters button{font:700 12px Arial;cursor:pointer;padding:12px 17px;border:1px solid var(--ink);border-radius:30px;background:transparent;color:var(--ink);min-height:44px}
 .filters button[aria-pressed=true]{background:var(--cobalt);border-color:var(--cobalt);color:#fff}
 .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:40px 26px}.card[hidden]{display:none}
 .card{border-top:1px solid var(--ink);padding-top:18px;min-width:0;scroll-margin-top:25px}
 .card .eyebrow{color:var(--cobalt);margin-bottom:10px}
 .card h3{font-size:26px;line-height:1.08;letter-spacing:-1px;margin:0 0 12px}
 .spec{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.spec strong{font-size:23px}
 .status{display:inline-block;background:var(--sun);border:1px solid var(--ink);padding:3px 7px;font:700 10px/1.4 monospace}
 .specs{display:inline-block;background:#fff;border:1px solid #d6d6cf;padding:6px 9px;font:11px/1.5 monospace;max-width:100%}
 .card>p:not(.eyebrow):not(.fine):not(.specs){font-size:15px;line-height:1.6}
 .facts{margin:0 0 14px;border-top:1px solid var(--line)}.facts div{display:grid;grid-template-columns:100px 1fr;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.5}
 .facts dt{font:700 10px/1.7 monospace;text-transform:uppercase;letter-spacing:1px;color:var(--cobalt)}.facts dd{margin:0;min-width:0}
 .caveat{color:#4a4a44}
 .verdict{border-left:3px solid var(--cobalt);padding-left:14px;font-weight:700}
 .buy{display:inline-block;padding:13px 18px;background:var(--sun);border:1px solid var(--ink);font-size:13px;font-weight:700;text-decoration:none;min-height:46px}.buy:hover{background:#fff}
 .modular{margin:0 6vw 80px;padding:44px 40px;background:var(--cobalt);color:#fff}
 .modular .eyebrow{color:var(--sun)}
 .modular-lede{font:22px/1.45 Georgia,serif;max-width:58ch;margin:0 0 34px}
 .modular-grid{display:grid;grid-template-columns:1fr 1fr;gap:44px}
 .modular h3{font:700 12px monospace;letter-spacing:1.6px;text-transform:uppercase;color:var(--sun);margin:0 0 14px}
 .modular ol{margin:0;padding:0 0 0 22px}.modular li{margin:0 0 16px}.modular li strong{font-size:17px}.modular li p{margin:4px 0 0;font-size:15px;line-height:1.6}
 .fine.light{color:#dfe4ff}
 .foresight{margin:0 6vw 80px;padding-top:28px;border-top:4px solid var(--ink)}
 .timeline{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
 .timeline li{background:#f4f4f0;border:1px solid var(--line);padding:20px 22px}
 .timeline .when{font:700 12px monospace;letter-spacing:1px;margin-right:10px}
 .conf{display:inline-block;font:700 10px/1.4 monospace;padding:3px 7px;border:1px solid var(--ink);text-transform:uppercase}
 .conf.announced{background:var(--cobalt);color:#fff;border-color:var(--cobalt)}.conf.reported{background:var(--sun)}.conf.rumor{background:#fff;border-style:dashed}
 .timeline strong{display:block;font-size:19px;margin:12px 0 0;line-height:1.25}.timeline p{font-size:14px;line-height:1.6;margin:8px 0 0}
 .wait-rule{font:21px/1.45 Georgia,serif;max-width:60ch;margin:34px 0 0;border-left:4px solid var(--sun);padding-left:20px}
 .comparison{margin:0 6vw 75px;padding-top:28px;border-top:4px solid var(--ink)}
 .table-scroll{overflow:auto}
 table{border-collapse:collapse;width:100%;min-width:860px;text-align:left;font-size:13px;line-height:1.5}caption{text-align:left;padding:0 0 14px;font:11px monospace}
 th,td{padding:12px;border-bottom:1px solid var(--line);vertical-align:top}thead{background:var(--ink);color:#fff}td:nth-child(3){white-space:nowrap}
 tbody th small{display:block;font:10px/1.5 monospace;color:#55554f;text-transform:uppercase;letter-spacing:1px;margin-top:3px}
 .endnote{padding:55px 6vw 60px;background:var(--ink);color:var(--paper)}
 .endnote>p:not(.eyebrow){font:21px/1.5 Georgia,serif;max-width:52ch}
 .endnote details{max-width:800px;padding:22px 0;margin:35px 0;border-top:1px solid #6d6d66;border-bottom:1px solid #6d6d66;font-size:13px;line-height:1.8}.endnote summary{cursor:pointer;font-weight:700}
 a:focus-visible,button:focus-visible,summary:focus-visible,.table-scroll:focus-visible{outline:3px solid var(--red);outline-offset:4px}
 @media(max-width:1100px){.cards{grid-template-columns:1fr 1fr}}
 @media(max-width:760px){.mast{padding:18px 16px;gap:15px}.mast span{display:none}.hero{grid-template-columns:1fr;min-height:0}.hero-copy{padding:35px 16px}.hero-image{border-left:0;border-top:1px solid var(--ink);padding:60px 16px 20px}.stamp{width:84px;height:84px;font-size:8px;top:14px;right:14px}.intro{grid-template-columns:1fr;gap:25px;padding:38px 16px}.intro>p{font-size:25px}.baseline{margin:0 16px 30px;padding:24px 18px}.baseline-grid{grid-template-columns:1fr;gap:20px}.baseline dl div{grid-template-columns:96px 1fr}.disclosure{margin:0 16px 45px;padding:18px;display:block}.disclosure strong{display:block;margin-bottom:7px}#kits,.parts{padding:0 16px;margin-bottom:55px}.kits,.cards{grid-template-columns:1fr;gap:30px}.kit{padding:20px 18px}.modular{margin:0 16px 55px;padding:28px 20px}.modular-grid{grid-template-columns:1fr;gap:20px}.modular-lede{font-size:19px}.foresight{margin:0 16px 55px}.timeline{grid-template-columns:1fr}.comparison{margin:0 16px 55px}.endnote{padding:40px 16px}.facts div{grid-template-columns:88px 1fr}}
</style>
