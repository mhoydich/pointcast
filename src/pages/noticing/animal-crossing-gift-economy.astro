      display: block;
    }

    .sources > header > p:last-child {
      margin-top: 30px;
    }

    .sources li {
      grid-template-columns: 46px 1fr;
    }

    .sources li a {
      font-size: 17px;
    }

    .closing__mark {
      font-size: 90px;
    }

    .next-issue {
      grid-template-columns: 1fr;
      padding-inline: 20px;
    }

    .next-issue > a {
      grid-column: 1;
      justify-self: start;
    }

    .issue-footer {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .issue-footer > div {
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .issue-footer > span {
      grid-column: 1;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .reading-progress span,
    .pocket-lab fieldset button {
      transition: none;
    }
  }

  @media print {
    body * {
      visibility: hidden !important;
    }

    .town-rules,
    .town-rules * {
      visibility: visible !important;
    }

    .town-rules {
      position: absolute;
      inset: 0;
      display: block;
      padding: 0;
      background: white;
    }

    .town-rules__sheet {
      max-width: none;
      min-height: 100vh;
      box-shadow: none;
      transform: none;
    }

    .town-rules__actions {
      display: none;
    }

    .town-rules__sheet::after {
      content: 'pointcast.xyz/noticing/animal-crossing-gift-economy · Independent editorial study; not affiliated with Nintendo.';
      display: block;
      margin-top: 32px;
      font: 10px/1.4 ui-monospace, monospace;
    }
  }
</style>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const updateProgress = () => {
    if (!progress) return;
    const available = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = available > 0 ? Math.min(1, Math.max(0, window.scrollY / available)) : 0;
    progress.style.width = `${ratio * 100}%`;
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);

  const gateButton = document.querySelector<HTMLButtonElement>('[data-open-gate]');
  const gateStatus = document.querySelector<HTMLElement>('[data-gate-status]');

  const ringGate = () => {
    const AudioContextClass =
      window.AudioContext ??
      (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!AudioContextClass) return;

    const context = new AudioContextClass();
    const now = context.currentTime;
    const master = context.createGain();
    master.gain.setValueAtTime(0.0001, now);
    master.gain.exponentialRampToValueAtTime(0.14, now + 0.015);
    master.gain.exponentialRampToValueAtTime(0.0001, now + 1.45);
    master.connect(context.destination);

    [659.25, 783.99, 987.77].forEach((frequency, index) => {
      const oscillator = context.createOscillator();
      const voice = context.createGain();
      oscillator.type = index === 1 ? 'triangle' : 'sine';
      oscillator.frequency.setValueAtTime(frequency, now + index * 0.13);
      voice.gain.setValueAtTime(0.0001, now);
      voice.gain.exponentialRampToValueAtTime(0.7 / (index + 1), now + index * 0.13 + 0.02);
      voice.gain.exponentialRampToValueAtTime(0.0001, now + 0.75 + index * 0.2);
      oscillator.connect(voice);
      voice.connect(master);
      oscillator.start(now + index * 0.13);
      oscillator.stop(now + 1.3 + index * 0.2);
    });

    window.setTimeout(() => {
      void context.close();
    }, 1900);
  };

  gateButton?.addEventListener('click', () => {
    ringGate();
    gateButton.setAttribute('aria-pressed', 'true');
    if (gateStatus) gateStatus.textContent = 'Gate open. Company is coming.';
  });

  const pocketLab = document.querySelector<HTMLElement>('[data-pocket-lab]');
  const pocketOutput = document.querySelector<HTMLElement>('[data-pocket-output]');
  const pocketState: Record<string, string> = {
    object: 'native fruit',
    person: 'new neighbor',
    reason: 'to unblock',
  };

  const sentenceCase = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
  const updatePocket = () => {
    if (!pocketOutput) return;
    const personArticle = /^[aeiou]/i.test(pocketState.person) ? 'an' : 'a';
    pocketOutput.textContent =
      `${sentenceCase(pocketState.object)} for ${personArticle} ${pocketState.person}, carried ${pocketState.reason} the next small thing.`;
  };

  pocketLab?.querySelectorAll<HTMLButtonElement>('[data-pocket-choice]').forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.pocketChoice;
      const value = button.dataset.value;
      if (!category || !value) return;
      pocketState[category] = value;
      pocketLab
        .querySelectorAll<HTMLButtonElement>(`[data-pocket-choice="${category}"]`)
        .forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      updatePocket();
    });
  });

  document.querySelector<HTMLButtonElement>('[data-print-field-sheet]')?.addEventListener('click', () => {
    window.print();
  });

  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  const issueUrl = 'https://pointcast.xyz/noticing/animal-crossing-gift-economy';

  document.querySelector<HTMLButtonElement>('[data-copy-issue]')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(issueUrl);
    if (copyStatus) copyStatus.textContent = 'Issue 03 link copied.';
  });

  document.querySelector<HTMLButtonElement>('[data-share-issue]')?.addEventListener('click', async () => {
    if (navigator.share) {
      await navigator.share({
        title: 'Animal Crossing is a gift economy — PointCast',
        text: 'Issue 03 of What I Keep Noticing',
        url: issueUrl,
      });
      return;
    }
    await navigator.clipboard.writeText(issueUrl);
    if (copyStatus) copyStatus.textContent = 'Issue 03 link copied.';
  });
</script>
