---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CROSSING_ISSUE, CROSSING_SOURCES } from '../../lib/noticing-crossing';

const issue = CROSSING_ISSUE;
const socialImage = 'https://pointcast.xyz/images/noticing/animal-crossing-issue-03-og.png';
const [hero, pocketPlate, gatePlate] = issue.images;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${issue.url}#article`,
  url: issue.url,
  headline: issue.title,
  alternativeHeadline: issue.shortTitle,
  description: issue.dek,
  image: [socialImage, ...issue.images.map((image) => `https://pointcast.xyz${image.src}`)],
  datePublished: issue.publishedAt,
  dateModified: issue.publishedAt,
  inLanguage: 'en-US',
  articleSection: issue.desk,
  wordCount: 2210,
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'What I Keep Noticing',
    url: 'https://pointcast.xyz/noticing',
  },
  about: [
    { '@type': 'VideoGame', name: 'Animal Crossing: New Horizons' },
    { '@type': 'Thing', name: 'Gift economy' },
    { '@type': 'Thing', name: 'Digital anthropology' },
    { '@type': 'Thing', name: 'Online community' },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  creator: {
    '@type': 'Person',
    name: issue.credits.director,
  },
  contributor: [
    { '@type': 'SoftwareApplication', name: issue.credits.writingAndDesign },
    { '@type': 'SoftwareApplication', name: issue.credits.imageSystem },
  ],
  citation: CROSSING_SOURCES.map((source) => source.url),
};
---

<BlockLayout
  title={`${issue.title} — What I Keep Noticing`}
  description={issue.dek}
  image={socialImage}
  themeColor="#f06b4f"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/noticing/animal-crossing-gift-economy.json',
      title: 'Animal Crossing is a gift economy — structured issue and source ledger',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Read Issue 03', action: 'link', target: issue.url },
      { label: 'Open the source ledger', action: 'link', target: issue.jsonUrl },
    ],
  }}
>
  <article class="issue" data-crossing-issue>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="cover" id="top">
      <nav class="cover__nav" aria-label="Issue navigation">
        <a href="/">PointCast</a>
        <a href="/noticing">What I Keep Noticing</a>
        <span>Issue {issue.issue} · {issue.desk}</span>
        <a href="/noticing/animal-crossing-gift-economy.json">JSON ↗</a>
      </nav>

      <div class="cover__image">
        <img
          src={hero.src}
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          fetchpriority="high"
        />
      </div>
      <div class="cover__wash" aria-hidden="true"></div>

      <div class="cover__title">
        <p>The nicest town you know has a mortgage attached</p>
        <h1>
          <span>Animal</span>
          <span>Crossing</span>
          <em>is a gift economy</em>
        </h1>
        <p class="cover__dek">{issue.dek}</p>
      </div>

      <div class="cover__issue" aria-hidden="true">
        <b>03</b>
        <span>What I<br />keep noticing</span>
      </div>

      <div class="cover__tags" aria-hidden="true">
        <span>fruit</span>
        <span>debt</span>
        <span>visiting</span>
        <span>care</span>
      </div>

      <div class="cover__gate">
        <button type="button" data-open-gate aria-describedby="gate-note">
          <span>Open the gate</span>
          <b aria-hidden="true">♪</b>
        </button>
        <p id="gate-note" data-gate-status>The town is quiet. Company is possible.</p>
      </div>

      <p class="cover__caption">{hero.caption}</p>
    </header>

    <nav class="issue-path" aria-label="Issue 03 quick path">
      <span>Start here · one sentence</span>
      <p>{issue.thesis}</p>
      <div>
        <a href="#opening-title">Read the argument ↓</a>
        <a href="#economy-title">See the five economies ↓</a>
        <a href="#rules-title">Take the field sheet ↓</a>
      </div>
    </nav>

    <section class="opening" aria-labelledby="opening-title">
      <div class="opening__rail">
        <p>PointCast Weekly</p>
        <span>El Segundo · 27 July 2026</span>
        <span>{issue.readingTime}</span>
      </div>
      <div class="opening__copy">
        <p class="rubric">Digital anthropology / Study Of</p>
        <h2 id="opening-title">A peach becomes a town when somebody needs one.</h2>
        {issue.opening.map((paragraph, index) => (
          <p class:list={{ lead: index === 0 }}>{paragraph}</p>
        ))}
      </div>
    </section>

    <section class="economy-board" aria-labelledby="economy-title">
      <header>
        <p class="rubric">Five economies in one pocket</p>
        <h2 id="economy-title">Money is present. It is simply not alone.</h2>
      </header>
      <div class="economy-board__grid">
        {issue.economies.map((economy) => (
          <article>
            <div>
              <span>{economy.number}</span>
              <b>{economy.label}</b>
            </div>
            <h3>{economy.proposition}</h3>
            <p>{economy.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="essay essay--debt">
      <div class="essay__number" aria-hidden="true">{issue.essays[0].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[0].kicker}</p>
        <h2>{issue.essays[0].title}</h2>
        {issue.essays[0].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="tempo-card" aria-label="A humane progress loop">
        <span>collect</span>
        <i aria-hidden="true"></i>
        <span>choose</span>
        <i aria-hidden="true"></i>
        <span>build</span>
        <i aria-hidden="true"></i>
        <strong>no panic</strong>
        <small>A progress loop without a punishment clock.</small>
      </aside>
    </section>

    <figure class="plate plate--pocket">
      <img
        src={pocketPlate.src}
        alt={pocketPlate.alt}
        width={pocketPlate.width}
        height={pocketPlate.height}
        loading="lazy"
      />
      <figcaption>{pocketPlate.caption}</figcaption>
      <span aria-hidden="true">THE<br />POCKET<br />IS THE<br />ECONOMY</span>
    </figure>

    <section class="essay essay--gift">
      <div class="essay__number" aria-hidden="true">{issue.essays[1].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[1].kicker}</p>
        <h2>{issue.essays[1].title}</h2>
        {issue.essays[1].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="source-note">
          The anthropological gift is relationship, not merely free inventory:
          <a href={CROSSING_SOURCES[8].url}>Open Encyclopedia of Anthropology ↗</a>
        </p>
      </div>
      <aside class="gift-equation" aria-label="The social value of a gift">
        <p>object</p>
        <b aria-hidden="true">+</b>
        <p>attention</p>
        <b aria-hidden="true">+</b>
        <p>route</p>
        <strong>relationship</strong>
      </aside>
    </section>

    <section class="pocket-lab" data-pocket-lab aria-labelledby="pocket-lab-title">
      <header>
        <p class="rubric">A small social instrument</p>
        <h2 id="pocket-lab-title">{issue.pocketLab.title}</h2>
        <p>{issue.pocketLab.note}</p>
      </header>

      <div class="pocket-lab__choices">
        <fieldset>
          <legend>01 · Put in</legend>
          {issue.pocketLab.objects.map((choice, index) => (
            <button
              type="button"
              data-pocket-choice="object"
              data-value={choice}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
        <fieldset>
          <legend>02 · Carry to</legend>
          {issue.pocketLab.people.map((choice, index) => (
            <button
              type="button"
              data-pocket-choice="person"
              data-value={choice}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
        <fieldset>
          <legend>03 · Because</legend>
          {issue.pocketLab.reasons.map((choice, index) => (
            <button
              type="button"
              data-pocket-choice="reason"
              data-value={choice}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
      </div>

      <div class="pocket-lab__result">
        <span>Gift tag / 03</span>
        <p data-pocket-output>
          Native fruit for a new neighbor, carried to unblock the next small thing.
        </p>
        <small>Nothing left the screen. Something changed purpose.</small>
      </div>
    </section>

    <section class="essay essay--visit">
      <div class="essay__number" aria-hidden="true">{issue.essays[2].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[2].kicker}</p>
        <h2>{issue.essays[2].title}</h2>
        {issue.essays[2].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="visit-card">
        <p>THE VISIT</p>
        <ol>
          <li>say you are open</li>
          <li>make a little room</li>
          <li>endure the threshold</li>
          <li>notice who arrived</li>
          <li>send them home altered</li>
        </ol>
      </aside>
    </section>

    <figure class="plate plate--gate">
      <img
        src={gatePlate.src}
        alt={gatePlate.alt}
        width={gatePlate.width}
        height={gatePlate.height}
        loading="lazy"
      />
      <figcaption>{gatePlate.caption}</figcaption>
      <span aria-hidden="true">OPEN<br />IS A<br />SOCIAL<br />SETTING</span>
    </figure>

    <section class="research-interlude" aria-labelledby="research-title">
      <p class="rubric">Research does not permit the easy ending</p>
      <h2 id="research-title">A friendly world can help people meet. It cannot promise to make them less lonely.</h2>
      <div>
        <p>
          The ACM study found design patterns that supported positive, safe, friendly interactions and
          player-authored stories.
          <a href={CROSSING_SOURCES[4].url}>Read the study ↗</a>
        </p>
        <p>
          A nearly 2,000-player study described routine substitution and social connection during
          pandemic isolation.
          <a href={CROSSING_SOURCES[5].url}>Read the study ↗</a>
        </p>
        <p>
          A Frontiers study found minimal evidence that in-game socialization alone reduced loneliness.
          <a href={CROSSING_SOURCES[6].url}>Read the counterweight ↗</a>
        </p>
      </div>
    </section>

    <section class="essay essay--platform">
      <div class="essay__number" aria-hidden="true">{issue.essays[3].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[3].kicker}</p>
        <h2>{issue.essays[3].title}</h2>
        {issue.essays[3].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="platform-card">
        <span>THE ISLAND</span>
        <b>is soft</b>
        <span>THE PLATFORM</span>
        <b>has edges</b>
        <small>Hardware · accounts · membership · service · governance</small>
      </aside>
    </section>

    <section class="evidence-desk" aria-labelledby="evidence-title">
      <header>
        <p class="rubric">Keep the layers visible</p>
        <h2 id="evidence-title">Mechanic, practice, evidence, lens, limit.</h2>
      </header>
      <div>
        {issue.evidenceDesk.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.label}</h3>
            <p>{item.value}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="town-rules" aria-labelledby="rules-title">
      <div class="town-rules__sheet">
        <header>
          <span>PointCast field sheet · Issue 03</span>
          <h2 id="rules-title">Seven rules for a generous island</h2>
          <p>For games, group chats, offices, blocks, and anywhere else people keep arriving.</p>
        </header>
        <ol>
          {issue.townRules.map((rule) => <li>{rule}</li>)}
        </ol>
        <footer>
          <span>KEEP ONE SQUARE OPEN</span>
          <span>WHAT I KEEP NOTICING</span>
        </footer>
      </div>
      <div class="town-rules__actions">
        <button type="button" data-print-field-sheet>Print the town rules</button>
        <p>The printable view contains the field sheet, source boundary, and permanent URL.</p>
      </div>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header>
        <p class="rubric">The receipt stays attached</p>
        <h2 id="sources-title">Source ledger</h2>
        <p>{issue.reportingBoundary}</p>
      </header>
      <ol>
        {CROSSING_SOURCES.map((source) => (
          <li>
            <span>{source.id}</span>
            <div>
              <a href={source.url}>{source.title} ↗</a>
              <p>{source.publisher}</p>
              <small>{source.usedFor}</small>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <p class="rubric">The gate remains open</p>
      <h2 id="closing-title">The memorable part begins after the price.</h2>
      <div>
        {issue.closing.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="closing__mark">A town begins.</p>
    </section>

    <section class="next-issue" aria-labelledby="next-title">
      <div>
        <p>{issue.next.label}</p>
        <h2 id="next-title">{issue.next.title}</h2>
        <span>{issue.next.dateLabel}</span>
      </div>
      <p>{issue.next.dek}</p>
      <a href="/noticing">Return to the editorial desk <span aria-hidden="true">↗</span></a>
    </section>

    <footer class="issue-footer">
      <a href="#top">Back to the gate ↑</a>
      <p>PointCast · What I Keep Noticing · Issue 03</p>
      <div>
        <button type="button" data-copy-issue>Copy Issue 03 link</button>
        <button type="button" data-share-issue>Share</button>
      </div>
      <span data-copy-status aria-live="polite"></span>
    </footer>
  </article>
</BlockLayout>

<style is:global>
  :root {
    --crossing-ink: #182016;
    --crossing-paper: #f5ecd7;
    --crossing-green: #53783d;
    --crossing-grass: #8fb05e;
    --crossing-peach: #f06b4f;
    --crossing-blue: #79bddd;
    --crossing-yellow: #f4c64e;
    --crossing-violet: #49316f;
    --crossing-rule: rgba(24, 32, 22, 0.28);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--crossing-paper);
    color: var(--crossing-ink);
  }

  .issue,
  .issue * {
    box-sizing: border-box;
  }

  .issue {
    overflow: clip;
    background:
      linear-gradient(90deg, rgba(24, 32, 22, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--crossing-paper);
    font-family: Georgia, 'Times New Roman', serif;
  }

  .issue a {
    color: inherit;
  }

  .reading-progress {
    position: fixed;
    z-index: 30;
    inset: 0 0 auto;
    height: 4px;
    background: rgba(245, 236, 215, 0.25);
  }

  .reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--crossing-peach);
    transform-origin: left;
  }

  .cover {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #10170f;
    color: #fff8e7;
    border-bottom: 10px solid var(--crossing-peach);
  }

  .cover__nav {
    position: absolute;
    z-index: 7;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    min-height: 46px;
    padding: 0 22px;
    border-bottom: 2px solid #fff8e7;
    background: rgba(14, 18, 12, 0.64);
    backdrop-filter: blur(8px);
    font: 700 11px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .cover__nav a {
    text-decoration: none;
  }

  .cover__nav a:nth-child(2),
  .cover__nav span {
    text-align: center;
  }

  .cover__nav a:last-child {
    text-align: right;
  }

  .cover__image,
  .cover__image img,
  .cover__wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cover__image img {
    object-fit: cover;
    object-position: center center;
    filter: saturate(1.08) contrast(1.02);
  }

  .cover__wash {
    background:
      linear-gradient(90deg, rgba(13, 18, 12, 0.88) 0%, rgba(13, 18, 12, 0.6) 35%, rgba(13, 18, 12, 0.05) 72%),
      linear-gradient(0deg, rgba(13, 18, 12, 0.72) 0%, transparent 44%);
  }

  .cover__title {
    position: absolute;
    z-index: 3;
    left: clamp(24px, 5vw, 78px);
    top: clamp(118px, 17vh, 170px);
    width: min(760px, 60vw);
  }

  .cover__title > p:first-child,
  .rubric {
    margin: 0 0 16px;
    font: 800 11px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .cover__title > p:first-child {
    color: var(--crossing-yellow);
  }

  .cover h1 {
    margin: 0;
    font: 900 clamp(78px, 10.4vw, 158px) / 0.72 Arial, Helvetica, sans-serif;
    letter-spacing: -0.09em;
    text-transform: uppercase;
  }

  .cover h1 span {
    display: block;
  }

  .cover h1 em {
    display: block;
    max-width: 770px;
    margin-top: 0.14em;
    color: var(--crossing-peach);
    font: 700 clamp(50px, 7.3vw, 110px) / 0.78 Georgia, serif;
    letter-spacing: -0.075em;
    text-transform: none;
  }

  .cover__dek {
    max-width: 620px;
    margin: 30px 0 0;
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 700;
    line-height: 1.12;
  }

  .cover__issue {
    position: absolute;
    z-index: 4;
    top: 76px;
    right: clamp(22px, 4vw, 64px);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--crossing-ink);
    background: var(--crossing-yellow);
    border: 2px solid var(--crossing-ink);
    box-shadow: 8px 8px 0 var(--crossing-peach);
    transform: rotate(2deg);
  }

  .cover__issue b {
    font: 900 46px/0.9 Arial, sans-serif;
    letter-spacing: -0.08em;
  }

  .cover__issue span {
    font: 800 9px/1.05 ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cover__tags {
    position: absolute;
    z-index: 4;
    right: -10px;
    top: 42%;
    display: grid;
    justify-items: end;
    gap: 4px;
    transform: rotate(-2deg);
  }

  .cover__tags span {
    padding: 5px 12px;
    color: var(--crossing-ink);
    background: var(--crossing-paper);
    font: 900 clamp(18px, 2.2vw, 34px)/0.95 Arial, sans-serif;
    text-transform: uppercase;
  }

  .cover__tags span:nth-child(2) {
    background: var(--crossing-peach);
  }

  .cover__tags span:nth-child(3) {
    color: white;
    background: var(--crossing-violet);
  }

  .cover__tags span:nth-child(4) {
    background: var(--crossing-blue);
  }

  .cover__gate {
    position: absolute;
    z-index: 4;
    left: clamp(24px, 5vw, 78px);
    bottom: 62px;
  }

  .cover__gate button,
  .issue-footer button,
  .town-rules__actions button {
    padding: 12px 16px;
    border: 2px solid currentColor;
    color: inherit;
    background: rgba(14, 18, 12, 0.58);
    font: 800 11px/1 ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .cover__gate button {
    display: flex;
    gap: 22px;
  }

  .cover__gate button b {
    color: var(--crossing-yellow);
  }

  .cover__gate p {
    margin: 9px 0 0;
    font: 700 10px/1.3 ui-monospace, monospace;
  }

  .cover__caption {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 16px;
    max-width: 480px;
    margin: 0;
    text-align: right;
    font: 700 9px/1.3 ui-monospace, monospace;
    letter-spacing: 0.04em;
  }

  .issue-path {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) minmax(190px, 260px);
    gap: clamp(20px, 4vw, 60px);
    align-items: center;
    padding: 28px clamp(24px, 6vw, 96px);
    background: var(--crossing-yellow);
    border-bottom: 3px solid var(--crossing-ink);
  }

  .issue-path > span,
  .issue-path a {
    font: 800 10px/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .issue-path > p {
    max-width: 880px;
    margin: 0;
    font-size: clamp(24px, 3vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .issue-path > div {
    display: grid;
    gap: 8px;
  }

  .issue-path a {
    display: block;
    padding-bottom: 6px;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }

  .opening {
    display: grid;
    grid-template-columns: 130px minmax(0, 760px);
    gap: clamp(28px, 5vw, 84px);
    padding: clamp(72px, 11vw, 150px) clamp(24px, 6vw, 96px);
    background: var(--crossing-paper);
    border-bottom: 2px solid var(--crossing-ink);
  }

  .opening__rail {
    font: 700 10px/1.4 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .opening__rail p,
  .opening__rail span {
    margin: 0 0 24px;
  }

  .opening__copy {
    max-width: 760px;
  }

  .opening__copy h2,
  .economy-board h2,
  .evidence-desk h2,
  .research-interlude h2,
  .sources h2,
  .closing h2 {
    margin: 0 0 40px;
    font-size: clamp(52px, 7.2vw, 110px);
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

