---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { LIBRARY_ISSUE, LIBRARY_SOURCES } from '../../lib/noticing-library';

const issue = LIBRARY_ISSUE;
const socialImage = 'https://pointcast.xyz/images/noticing/library-issue-01-og.png';
const hero = issue.images[0];
const memoryPlate = issue.images[1];
const borrowPlate = issue.images[2];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${issue.url}#article`,
  url: issue.url,
  headline: issue.title,
  alternativeHeadline: issue.shortTitle,
  description: issue.dek,
  image: [
    socialImage,
    ...issue.images.map((image) => `https://pointcast.xyz${image.src}`),
  ],
  datePublished: issue.publishedAt,
  dateModified: issue.publishedAt,
  inLanguage: 'en-US',
  articleSection: issue.desk,
  wordCount: 1900,
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'What I Keep Noticing',
    url: 'https://pointcast.xyz/noticing',
  },
  about: {
    '@type': 'Library',
    name: issue.location.name,
    address: issue.location.address,
    url: issue.location.url,
  },
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  creator: {
    '@type': 'Person',
    name: issue.credits.director,
  },
  contributor: [
    {
      '@type': 'SoftwareApplication',
      name: issue.credits.writingAndDesign,
    },
    {
      '@type': 'SoftwareApplication',
      name: issue.credits.imageSystem,
    },
  ],
  citation: LIBRARY_SOURCES.map((source) => source.url),
};
---

<BlockLayout
  title={`${issue.title} — What I Keep Noticing`}
  description={issue.dek}
  image={socialImage}
  themeColor="#f4c928"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/noticing/the-future-of-the-library.json',
      title: 'The Future of the Library structured issue',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Read Issue 01', action: 'link', target: issue.url },
      { label: 'Inspect the sources', action: 'link', target: `${issue.url}#sources` },
      { label: 'Open the JSON', action: 'link', target: issue.jsonUrl },
    ],
  }}
>
  <div class="library-issue" data-library-issue>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="hero" id="top">
      <nav class="issue-nav" aria-label="Issue navigation">
        <a class="issue-nav__brand" href="/">PointCast</a>
        <a href="/noticing">What I Keep Noticing</a>
        <span>Issue {issue.issue}</span>
        <a href="/noticing/the-future-of-the-library.json">JSON ↗</a>
      </nav>

      <div class="hero__meta">
        <span>{issue.format}</span>
        <span>{issue.desk}</span>
        <span>{issue.readingTime}</span>
        <span>El Segundo · Jul 27, 2026</span>
      </div>

      <div class="hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">What I Keep Noticing · 01</p>
          <h1>The future<br />of the <em>library</em></h1>
          <p class="hero__dek">{issue.dek}</p>
          <div class="hero__thesis">
            <span>THE THESIS</span>
            <strong>{issue.thesis}</strong>
          </div>
          <a class="hero__start" href="#dispatch">Enter the dispatch <span aria-hidden="true">↓</span></a>
        </div>

        <figure class="hero__plate">
          <img
            src={hero.src}
            width={hero.width}
            height={hero.height}
            alt={hero.alt}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>{hero.caption}</figcaption>
        </figure>
      </div>

      <div class="hero__ticker" aria-label="The five library protocols">
        {issue.protocols.map((protocol) => (
          <span><b>{protocol.number}</b>{protocol.label}</span>
        ))}
      </div>
    </header>

    <article id="dispatch">
      <section class="opening section-shell">
        <div class="section-index">
          <span>OPENING DISPATCH</span>
          <span>111 W. MARIPOSA AVENUE</span>
        </div>
        <div class="opening__title">
          <p class="eyebrow">The quiet infrastructure</p>
          <h2>A protocol<br />with a roof.</h2>
        </div>
        <div class="opening__body">
          {issue.opening.map((paragraph, index) => (
            <p class:list={{ 'opening__lead': index === 0 }}>{paragraph}</p>
          ))}
        </div>
        <aside class="boundary">
          <span>REPORTING NOTE</span>
          <p>{issue.reportingBoundary}</p>
        </aside>
      </section>

      <section class="protocol-lab" aria-labelledby="protocol-title">
        <header class="protocol-lab__head section-shell">
          <div class="section-index">
            <span>THE CIVIC STACK</span>
            <span>FIVE AGREEMENTS</span>
          </div>
          <p class="eyebrow">Run the library</p>
          <h2 id="protocol-title">What do you<br />need today?</h2>
          <p>Choose a need. The building becomes a different kind of machine.</p>
        </header>

        <div class="protocol-lab__body">
          <div class="protocol-tabs" role="tablist" aria-label="Library protocols">
            {issue.protocols.map((protocol, index) => (
              <button
                type="button"
                role="tab"
                id={`protocol-tab-${protocol.id}`}
                aria-controls={`protocol-panel-${protocol.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-protocol-tab={protocol.id}
              >
                <span>{protocol.number}</span>
                <strong>{protocol.label}</strong>
              </button>
            ))}
          </div>

          <div class="protocol-panels">
            {issue.protocols.map((protocol, index) => (
              <section
                role="tabpanel"
                id={`protocol-panel-${protocol.id}`}
                aria-labelledby={`protocol-tab-${protocol.id}`}
                data-protocol-panel={protocol.id}
                hidden={index !== 0}
              >
                <span class="protocol-panel__number">{protocol.number}</span>
                <div>
                  <p class="eyebrow">Protocol · {protocol.label}</p>
                  <h3>{protocol.proposition}</h3>
                  <p>{protocol.current}</p>
                  <a href={protocol.url} rel="noreferrer">
                    Open the library’s {protocol.route.toLowerCase()} ↗
                  </a>
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section class="essay section-shell" aria-label="The argument">
        {issue.essays.map((section) => (
          <section class="essay__chapter">
            <div class="essay__number">{section.number}</div>
            <div class="essay__copy">
              <p class="eyebrow">{section.kicker}</p>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>
        ))}
      </section>

      <figure class="full-plate">
        <img
          src={memoryPlate.src}
          width={memoryPlate.width}
          height={memoryPlate.height}
          alt={memoryPlate.alt}
          loading="lazy"
        />
        <figcaption>
          <span>ORIGINAL PLATE · 02</span>
          <p>{memoryPlate.caption}</p>
        </figcaption>
      </figure>

      <section class="present section-shell" aria-labelledby="present-title">
        <div class="section-index">
          <span>THE PRESENT TENSE</span>
          <span>NOT A FORECAST</span>
        </div>
        <header>
          <p class="eyebrow">The pieces are already here</p>
          <h2 id="present-title">Four doors<br />already open.</h2>
          <p>
            The future becomes easier to imagine when it starts with what people have already
            built.
          </p>
        </header>
        <div class="present__grid">
          {issue.presentTense.map((item, index) => (
            <a href={item.url} rel="noreferrer">
              <span>{String(index + 1).padStart(2, '0')} · {item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </section>

      <section class="proposal" aria-labelledby="proposal-title">
        <div class="proposal__head section-shell">
          <div class="section-index">
            <span>SMALL PUBLIC FUTURES</span>
            <span>REVERSIBLE BY DESIGN</span>
          </div>
          <p class="eyebrow">PointCast proposes</p>
          <h2 id="proposal-title">Three experiments.<br />Ninety days.</h2>
          <p>
            No grand redesign. No magical staffing assumptions. Start small enough to learn in
            public.
          </p>
        </div>

        <div class="proposal__grid">
          {issue.proposals.map((proposal) => (
            <article>
              <div class="proposal__number">{proposal.number}</div>
              <div>
                <p class="eyebrow">Pilot {proposal.number}</p>
                <h3>{proposal.title}</h3>
                <p>{proposal.premise}</p>
                <dl>
                  <div>
                    <dt>The test</dt>
                    <dd>{proposal.test}</dd>
                  </div>
                  <div>
                    <dt>Boundary</dt>
                    <dd>{proposal.boundary}</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>

      <figure class="full-plate full-plate--yellow">
        <img
          src={borrowPlate.src}
          width={borrowPlate.width}
          height={borrowPlate.height}
          alt={borrowPlate.alt}
          loading="lazy"
        />
        <figcaption>
          <span>ORIGINAL PLATE · 03</span>
          <p>{borrowPlate.caption}</p>
        </figcaption>
      </figure>

      <section class="borrow section-shell" aria-labelledby="borrow-title">
        <div class="section-index">
          <span>THE CHECKOUT LIST</span>
          <span>HERE / NEXT?</span>
        </div>
        <header>
          <p class="eyebrow">Five things to borrow</p>
          <h2 id="borrow-title">A card is a key.</h2>
        </header>
        <ol>
          {issue.borrowList.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b class:list={{ 'is-next': item.status === 'NEXT?' }}>{item.status}</b>
              <h3>{item.title}</h3>
              <p>{item.note}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="field-sheet section-shell" aria-labelledby="field-title">
        <div class="field-sheet__intro">
          <p class="eyebrow">Take this with you</p>
          <h2 id="field-title">How to notice<br />a library.</h2>
          <p>
            Six questions for the next visit. No survey clipboard required. Look, sit, listen,
            write down one surprise.
          </p>
          <button type="button" data-print-field-sheet>Print the field sheet</button>
        </div>
        <ol>
          {issue.fieldPrompts.map((prompt, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{prompt}</p>
              <i aria-hidden="true"></i>
            </li>
          ))}
        </ol>
      </section>

      <section class="closing section-shell">
        <div class="closing__mark" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div>
          <p class="eyebrow">The open chair</p>
          <h2>{issue.thesis}</h2>
          {issue.closing.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="sources section-shell" id="sources" aria-labelledby="sources-title">
        <div class="section-index">
          <span>SOURCE LEDGER</span>
          <span>{String(LIBRARY_SOURCES.length).padStart(2, '0')} PUBLIC SOURCES</span>
        </div>
        <header>
          <p class="eyebrow">Receipts before certainty</p>
          <h2 id="sources-title">Where this<br />dispatch looked.</h2>
          <p>
            Official library and city surfaces were checked on July 27, 2026. Programs and links
            can change; the distinction between current service and PointCast proposal is
            deliberate.
          </p>
        </header>
        <ol>
          {LIBRARY_SOURCES.map((source) => (
            <li id={`source-${source.id.toLowerCase()}`}>
              <span>{source.id}</span>
              <div>
                <h3><a href={source.url} rel="noreferrer">{source.title} ↗</a></h3>
                <p>{source.publisher}</p>
                <small>{source.usedFor}</small>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </article>

    <section class="next-issue" aria-labelledby="next-title">
      <div class="next-issue__label">
        <span>WHAT I KEEP NOTICING</span>
        <span>02 / RITUAL</span>
      </div>
      <div class="next-issue__can" aria-hidden="true">
        <span></span>
        <i></i>
        <b>?</b>
      </div>
      <div class="next-issue__copy">
        <p class="eyebrow">{issue.next.label}</p>
        <h2 id="next-title">{issue.next.title}</h2>
        <p>{issue.next.dek}</p>
        <time datetime={issue.next.date}>{issue.next.dateLabel}</time>
        <div>
          <a href={issue.next.url}>Read Issue 02</a>
          <a href="/noticing">Editorial calendar</a>
          <button type="button" data-copy-issue>Copy this issue</button>
        </div>
        <p class="next-issue__status" aria-live="polite" data-copy-status></p>
      </div>
    </section>

    <footer class="issue-footer">
      <div>
        <a class="issue-footer__brand" href="/">PointCast</a>
        <p>Warm intelligence for bodies, homes, towns, networks, and worlds.</p>
      </div>
      <nav aria-label="Issue companions">
        <a href="/noticing">All issues</a>
        <a href="/noticing/the-future-of-the-library.json">Issue JSON</a>
        <a href="/b/0515">Block 0515</a>
        <a href="/feed.xml">RSS</a>
      </nav>
      <p>
        Directed by Michael Hoydich.<br />
        Written and designed with Codex / OpenAI.<br />
        Original visual plates generated with OpenAI image generation.<br />
        El Segundo, California · 2026.
      </p>
      <a href="#top">Sunward ↑</a>
    </footer>
  </div>

  <script is:inline>
    function initLibraryIssue() {
      const root = document.querySelector('[data-library-issue]');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const progress = root.querySelector('[data-reading-progress]');
      const updateProgress = () => {
        if (!progress) return;
        const available = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = available > 0 ? Math.min(1, Math.max(0, window.scrollY / available)) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });

      const tabs = Array.from(root.querySelectorAll('[data-protocol-tab]'));
      const panels = Array.from(root.querySelectorAll('[data-protocol-panel]'));
      const selectProtocol = (id) => {
        tabs.forEach((tab) => {
          const selected = tab.dataset.protocolTab === id;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.protocolPanel !== id;
        });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectProtocol(tab.dataset.protocolTab));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (index + direction + tabs.length) % tabs.length;
          const next = tabs[nextIndex];
          selectProtocol(next.dataset.protocolTab);
          next.focus();
        });
      });

      const printButton = root.querySelector('[data-print-field-sheet]');
      printButton?.addEventListener('click', () => window.print());

      const copyButton = root.querySelector('[data-copy-issue]');
      const copyStatus = root.querySelector('[data-copy-status]');
      copyButton?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (copyStatus) copyStatus.textContent = 'Issue link copied. Pass the library card.';
        } catch {
          if (copyStatus) copyStatus.textContent = window.location.href;
        }
      });
    }

    initLibraryIssue();
    document.addEventListener('astro:page-load', initLibraryIssue);
  </script>
</BlockLayout>

<style is:global>
  .library-issue {
    --sun: #f4c928;
    --paper: #fff9e9;
    --ink: #17140e;
    --blue: #1649cb;
    --coral: #e85d3f;
    --green: #31634a;
    --muted: #817967;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .library-issue *,
  .library-issue *::before,
  .library-issue *::after {
    box-sizing: border-box;
  }

  .library-issue a {
    color: inherit;
  }

  .library-issue img {
    display: block;
    max-width: 100%;
  }

  .reading-progress {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    height: 5px;
    background: rgb(23 20 14 / .12);
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
  }

  .section-shell {
    width: min(100% - 48px, 1240px);
    margin-inline: auto;
  }

  .eyebrow,
  .section-index,
  .hero__meta,
  .issue-nav,
  .hero__ticker,
  .full-plate figcaption span,
  .proposal dt,
  .borrow li > span,
  .borrow li > b,
  .sources li > span,
  .next-issue__label,
  .issue-footer nav {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 20px;
    font-size: 11px;
    font-weight: 800;
  }

  .section-index {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 14px;
    border-top: 2px solid currentColor;
    font-size: 10px;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    background:
      radial-gradient(var(--ink) .75px, transparent .75px),
      var(--sun);
    background-size: 7px 7px;
    border-bottom: 4px solid var(--ink);
  }

  .issue-nav {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    align-items: center;
    gap: 24px;
    min-height: 64px;
    padding: 12px 24px;
    border-bottom: 2px solid var(--ink);
    background: var(--paper);
    font-size: 10px;
  }

  .issue-nav a {
    text-decoration: none;
  }

  .issue-nav__brand {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -.04em;
    text-transform: none;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: 9px;
  }

  .hero__meta span {
    padding: 10px 16px;
    border-right: 1px solid rgb(255 249 233 / .35);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(520px, 1.12fr);
    min-height: calc(100svh - 144px);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(44px, 6vw, 96px) clamp(28px, 5vw, 76px);
    border-right: 3px solid var(--ink);
  }

  .hero__copy h1 {
    margin: auto 0 40px;
    font-size: clamp(78px, 9vw, 152px);
    font-weight: 950;
    letter-spacing: -.09em;
    line-height: .72;
  }

  .hero__copy h1 em {
    display: inline-block;
    color: var(--blue);
    font-style: italic;
    font-weight: 760;
    transform: translateX(6vw);
  }

  .hero__dek {
    max-width: 690px;
    margin: 0 0 32px;
    font-size: clamp(19px, 1.65vw, 25px);
    font-weight: 650;
    line-height: 1.35;
  }

  .hero__thesis {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    max-width: 650px;
    padding: 16px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .hero__thesis span {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .hero__thesis strong {
    font-size: 15px;
    line-height: 1.3;
  }

  .library-issue .hero__start {
    display: inline-flex;
    gap: 24px;
    margin-top: 24px;
    padding: 13px 16px;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero__plate {
    position: relative;
    min-width: 0;
    margin: 0;
    background: var(--ink);
  }

  .hero__plate img {
    width: 100%;
    height: 100%;
    min-height: 620px;
    object-fit: cover;
  }

  .hero__plate figcaption {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    padding: 12px 14px;
    border: 2px solid var(--ink);
    background: rgb(255 249 233 / .94);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .hero__ticker {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    min-height: 40px;
    background: var(--ink);
    color: var(--paper);
    font-size: 9px;
  }

  .hero__ticker span {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-right: 1px solid rgb(255 249 233 / .3);
  }

  .hero__ticker b {
    color: var(--sun);
  }

  .opening {
    display: grid;
    grid-template-columns: minmax(220px, .72fr) minmax(0, 1.28fr);
    gap: 0 72px;
    padding-block: clamp(80px, 11vw, 170px);
  }

  .opening .section-index,
  .present .section-index,
  .borrow .section-index,
  .sources .section-index {
    grid-column: 1 / -1;
    margin-bottom: 72px;
  }

  .opening__title h2,
  .protocol-lab__head h2,
  .present header h2,
  .proposal__head h2,
  .borrow header h2,
  .field-sheet h2,
  .sources header h2 {
    margin: 0;
    font-size: clamp(58px, 7vw, 108px);
    font-weight: 900;
    letter-spacing: -.075em;
    line-height: .83;
  }

  .opening__body p,
  .essay__copy > p,
  .closing > div:last-child > p {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(20px, 2vw, 29px);
    line-height: 1.55;
  }

  .opening__body p {
    margin: 0 0 1.4em;
  }

  .opening__body .opening__lead {
    font-size: clamp(29px, 3.2vw, 48px);
    font-weight: 700;
    letter-spacing: -.035em;
    line-height: 1.18;
  }

  .boundary {
    grid-column: 2;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    margin-top: 32px;
    padding: 22px;
    border: 2px solid var(--ink);
    background: #f2e7ca;
  }

  .boundary span {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .boundary p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .protocol-lab {
    border-block: 4px solid var(--ink);
    background: var(--blue);
    color: var(--paper);
  }

  .protocol-lab__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, .45fr);
    gap: 36px;
    padding-block: 80px 54px;
  }

  .protocol-lab__head .section-index {
    grid-column: 1 / -1;
  }

  .protocol-lab__head .eyebrow {
    grid-column: 1;
    margin-bottom: -22px;
  }

  .protocol-lab__head h2 {
    grid-column: 1;
  }

  .protocol-lab__head > p:last-child {
    align-self: end;
    margin: 0;
    font-size: 20px;
    font-weight: 650;
    line-height: 1.45;
  }

  .protocol-lab__body {
    display: grid;
    grid-template-columns: minmax(200px, .34fr) minmax(0, 1fr);
    border-top: 2px solid var(--paper);
  }

  .protocol-tabs {
    display: grid;
    border-right: 2px solid var(--paper);
  }

  .protocol-tabs button {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    min-height: 76px;
    padding: 12px 20px;
    border: 0;
    border-bottom: 1px solid rgb(255 249 233 / .45);
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .protocol-tabs button[aria-selected="true"] {
    background: var(--sun);
    color: var(--ink);
  }

  .protocol-tabs button:focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: -5px;
  }

  .protocol-tabs span {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
  }

  .protocol-tabs strong {
    font-size: 19px;
  }

  .protocol-panels {
    min-width: 0;
  }

  .protocol-panels section {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(30px, 6vw, 100px);
    min-height: 440px;
    padding: clamp(40px, 7vw, 100px);
    background:
      radial-gradient(rgb(255 249 233 / .55) .8px, transparent .8px),
      var(--blue);
    background-size: 9px 9px;
  }

  .protocol-panels section[hidden] {
    display: none;
  }

  .protocol-panel__number {
    color: var(--sun);
    font-size: clamp(100px, 18vw, 260px);
    font-weight: 950;
    letter-spacing: -.1em;
    line-height: .7;
  }

  .protocol-panels h3 {
    max-width: 760px;
    margin: 0 0 26px;
    font-size: clamp(38px, 5vw, 76px);
    letter-spacing: -.055em;
    line-height: .95;
  }

  .protocol-panels p:not(.eyebrow) {
    max-width: 720px;
    font-size: 18px;
    font-weight: 620;
    line-height: 1.55;
  }

  .protocol-panels a {
    display: inline-block;
    margin-top: 24px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .essay {
    padding-block: clamp(90px, 12vw, 190px);
  }

  .essay__chapter {
    display: grid;
    grid-template-columns: minmax(130px, .3fr) minmax(0, 1fr);
    gap: 50px;
    padding-block: 84px;
    border-top: 2px solid var(--ink);
  }

  .essay__number {
    color: var(--coral);
    font-size: clamp(86px, 12vw, 180px);
    font-weight: 950;
    letter-spacing: -.1em;
    line-height: .8;
  }

  .essay__copy {
    max-width: 860px;
  }

  .essay__copy h2 {
    margin: 0 0 46px;
    font-size: clamp(46px, 6vw, 88px);
    letter-spacing: -.065em;
    line-height: .92;
  }

  .essay__copy > p {
    margin: 0 0 1.5em;
  }

  .full-plate {
    margin: 0;
    padding: 24px;
    border-block: 4px solid var(--ink);
    background: var(--green);
  }

  .full-plate img {
    width: 100%;
    max-height: 84vh;
    border: 2px solid var(--ink);
    object-fit: cover;
  }

  .full-plate figcaption {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 30px;
    padding: 16px 2px 0;
    color: var(--paper);
  }

  .full-plate figcaption span {
    font-size: 9px;
  }

  .full-plate figcaption p {
    max-width: 760px;
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .full-plate--yellow {
    background: var(--sun);
  }

  .full-plate--yellow figcaption {
    color: var(--ink);
  }

  .present {
    padding-block: clamp(90px, 12vw, 170px);
  }

  .present > header,
  .sources > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, .45fr);
    gap: 40px;
    margin-bottom: 72px;
  }

  .present header .eyebrow,
  .sources header .eyebrow {
    grid-column: 1;
    margin-bottom: -20px;
  }

  .present header h2,
  .sources header h2 {
    grid-column: 1;
  }

  .present header > p:last-child,
  .sources header > p:last-child {
    align-self: end;
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
  }

  .present__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }

  .present__grid a {
    position: relative;
    min-height: 310px;
    padding: 28px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease;
  }

  .present__grid a:hover {
    background: var(--blue);
    color: var(--paper);
  }

  .present__grid span {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .present__grid h3 {
    margin: 56px 0 18px;
    font-size: clamp(34px, 4vw, 58px);
    letter-spacing: -.055em;
    line-height: .94;
  }

  .present__grid p {
    max-width: 520px;
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .present__grid b {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 26px;
  }

  .proposal {
    border-block: 4px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .proposal__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, .45fr);
    gap: 40px;
    padding-block: 84px;
  }

  .proposal__head .section-index {
    grid-column: 1 / -1;
  }

  .proposal__head .eyebrow {
    grid-column: 1;
    margin-bottom: -20px;
  }

  .proposal__head h2 {
    grid-column: 1;
  }

  .proposal__head > p:last-child {
    align-self: end;
    margin: 0;
    color: var(--sun);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
  }

  .proposal__grid {
    border-top: 2px solid var(--paper);
  }

  .proposal__grid article {
    display: grid;
    grid-template-columns: minmax(180px, .34fr) minmax(0, 1fr);
    border-bottom: 1px solid rgb(255 249 233 / .4);
  }

  .proposal__number {
    display: grid;
    place-items: center;
    min-height: 520px;
    border-right: 2px solid var(--paper);
    background: var(--sun);
    color: var(--ink);
    font-size: clamp(150px, 24vw, 340px);
    font-weight: 950;
    letter-spacing: -.12em;
    line-height: .7;
  }

  .proposal__grid article > div:last-child {
    padding: clamp(46px, 7vw, 100px);
  }

  .proposal__grid h3 {
    margin: 0 0 30px;
    font-size: clamp(46px, 6vw, 88px);
    letter-spacing: -.065em;
    line-height: .9;
  }

  .proposal__grid article > div:last-child > p:not(.eyebrow) {
    max-width: 820px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.55;
  }

  .proposal dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin: 50px 0 0;
  }

  .proposal dl > div {
    padding: 22px;
    border: 1px solid rgb(255 249 233 / .6);
  }

  .proposal dt {
    margin-bottom: 14px;
    color: var(--sun);
    font-size: 9px;
    font-weight: 800;
  }

  .proposal dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .borrow {
    padding-block: clamp(90px, 12vw, 170px);
  }

  .borrow header {
    margin-bottom: 60px;
  }

  .borrow ol {
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--ink);
    list-style: none;
  }

  .borrow li {
    display: grid;
    grid-template-columns: 64px 90px minmax(220px, .55fr) minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    min-height: 126px;
    padding: 20px;
    border-bottom: 2px solid var(--ink);
  }

  .borrow li > span,
  .borrow li > b {
    font-size: 10px;
  }

  .borrow li > b {
    justify-self: start;
    padding: 6px 8px;
    border: 1px solid var(--ink);
    background: var(--green);
    color: var(--paper);
  }

  .borrow li > b.is-next {
    background: var(--coral);
  }

  .borrow h3 {
    margin: 0;
    font-size: clamp(25px, 3vw, 42px);
    letter-spacing: -.04em;
  }

  .borrow li p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .field-sheet {
    display: grid;
    grid-template-columns: minmax(260px, .6fr) minmax(0, 1fr);
    gap: 68px;
    margin-bottom: clamp(90px, 12vw, 170px);
    padding: clamp(34px, 6vw, 82px);
    border: 3px solid var(--ink);
    background:
      linear-gradient(rgb(23 20 14 / .08) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 32px;
    box-shadow: 12px 12px 0 var(--sun);
  }

  .field-sheet__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .field-sheet__intro > p:last-of-type {
    max-width: 450px;
    font-size: 17px;
    font-weight: 620;
    line-height: 1.5;
  }

  .field-sheet button,
  .next-issue button {
    margin-top: auto;
    padding: 13px 16px;
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .field-sheet ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .field-sheet li {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 18px;
    min-height: 118px;
    padding: 18px 0;
    border-bottom: 2px solid var(--ink);
  }

  .field-sheet li > span {
    color: var(--coral);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 800;
  }

  .field-sheet li p {
    margin: 0;
    font-size: 17px;
    font-weight: 650;
    line-height: 1.42;
  }

  .field-sheet li i {
    grid-column: 2;
    display: block;
    height: 22px;
    border-bottom: 1px solid rgb(23 20 14 / .35);
  }

  .closing {
    display: grid;
    grid-template-columns: minmax(250px, .45fr) minmax(0, 1fr);
    gap: 70px;
    padding-block: clamp(90px, 12vw, 180px);
    border-top: 4px solid var(--ink);
  }

  .closing__mark {
    position: relative;
    min-height: 420px;
  }

  .closing__mark span {
    position: absolute;
    inset: 0 auto auto 0;
    width: min(100%, 390px);
    aspect-ratio: 1;
    border: 3px solid var(--ink);
    border-radius: 50%;
  }

  .closing__mark span:nth-child(2) {
    inset: 14% auto auto 14%;
    width: 72%;
  }

  .closing__mark span:nth-child(3) {
    inset: 35% auto auto 35%;
    width: 30%;
    background: var(--coral);
  }

  .closing__mark::after {
    position: absolute;
    top: 47%;
    right: -20px;
    left: -25vw;
    height: 4px;
    background: var(--blue);
    content: "";
    transform: rotate(-8deg);
  }

  .closing h2 {
    max-width: 850px;
    margin: 0 0 50px;
    color: var(--blue);
    font-size: clamp(48px, 6.5vw, 96px);
    letter-spacing: -.07em;
    line-height: .91;
  }

  .sources {
    padding-block: clamp(90px, 12vw, 170px);
    border-top: 4px solid var(--ink);
  }

  .sources ol {
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    list-style: none;
  }

  .sources li {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 26px;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink);
  }

  .sources li > span {
    padding-top: 5px;
    color: var(--coral);
    font-size: 10px;
    font-weight: 800;
  }

  .sources h3 {
    margin: 0 0 4px;
    font-size: 22px;
    letter-spacing: -.025em;
  }

  .sources h3 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .sources p,
  .sources small {
    display: block;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .next-issue {
    display: grid;
    grid-template:
      "label label" auto
      "can copy" minmax(560px, auto)
      / minmax(300px, .7fr) minmax(0, 1.3fr);
    border-block: 4px solid var(--ink);
    background: var(--sun);
  }

  .next-issue__label {
    grid-area: label;
    display: flex;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: 9px;
  }

  .next-issue__can {
    position: relative;
    grid-area: can;
    overflow: hidden;
    border-right: 3px solid var(--ink);
    background:
      radial-gradient(var(--ink) .8px, transparent .8px),
      var(--sun);
    background-size: 8px 8px;
  }

  .next-issue__can > span {
    position: absolute;
    top: 17%;
    left: 20%;
    width: 52%;
    height: 65%;
    border: 3px solid var(--ink);
    border-radius: 30% 30% 18% 18% / 10% 10% 8% 8%;
    background: var(--paper);
    box-shadow: 16px 16px 0 var(--coral);
    transform: rotate(8deg);
  }

  .next-issue__can > span::before,
  .next-issue__can > span::after {
    position: absolute;
    right: 8%;
    left: 8%;
    height: 12px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    content: "";
  }

  .next-issue__can > span::before {
    top: -7px;
    background: #cac3ae;
  }

  .next-issue__can > span::after {
    bottom: -7px;
  }

  .next-issue__can i {
    position: absolute;
    top: 42%;
    right: -10%;
    left: -20%;
    height: 4px;
    background: var(--blue);
    transform: rotate(-13deg);
  }

  .next-issue__can b {
    position: absolute;
    z-index: 2;
    top: 32%;
    left: 33%;
    color: var(--blue);
    font-size: clamp(120px, 18vw, 250px);
    font-style: italic;
    line-height: 1;
    transform: rotate(-8deg);
  }

  .next-issue__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(48px, 8vw, 110px);
  }

  .next-issue__copy h2 {
    margin: auto 0 22px;
    font-size: clamp(74px, 10vw, 154px);
    letter-spacing: -.09em;
    line-height: .76;
  }

  .next-issue__copy > p:not(.eyebrow, .next-issue__status) {
    max-width: 650px;
    font-size: 20px;
    font-weight: 650;
    line-height: 1.4;
  }

  .next-issue__copy time {
    margin: 20px 0 44px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .next-issue__copy > div {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .next-issue__copy a,
  .next-issue__copy button {
    margin: 0;
    padding: 13px 16px;
    border: 2px solid var(--ink);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .09em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .next-issue__copy a {
    background: var(--ink);
    color: var(--paper);
  }

  .next-issue__status {
    min-height: 1.4em;
    margin: 16px 0 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    text-transform: uppercase;
  }

  .issue-footer {
    display: grid;
    grid-template-columns: 1.2fr .8fr 1fr auto;
    gap: 42px;
    padding: 56px 28px;
    background: var(--ink);
    color: var(--paper);
  }

  .issue-footer__brand {
    font-size: 32px;
    font-weight: 850;
    letter-spacing: -.05em;
    text-decoration: none;
  }

  .issue-footer p {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.55;
  }

  .issue-footer nav {
    display: grid;
    align-content: start;
    gap: 10px;
    font-size: 9px;
  }

  .issue-footer > a:last-child {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      min-height: 720px;
      border-right: 0;
      border-bottom: 3px solid var(--ink);
    }

    .hero__plate img {
      min-height: 64vw;
    }

    .opening,
    .closing {
      grid-template-columns: 1fr;
    }

    .opening__title,
    .opening__body,
    .boundary,
    .closing__mark,
    .closing > div:last-child {
      grid-column: 1;
    }

    .opening__title {
      margin-bottom: 56px;
    }

    .protocol-lab__body {
      grid-template-columns: 1fr;
    }

    .protocol-tabs {
      grid-template-columns: repeat(5, minmax(120px, 1fr));
      overflow-x: auto;
      border-right: 0;
      border-bottom: 2px solid var(--paper);
    }

    .protocol-tabs button {
      grid-template-columns: 1fr;
      border-right: 1px solid rgb(255 249 233 / .45);
      border-bottom: 0;
    }

    .proposal__grid article {
      grid-template-columns: minmax(150px, .3fr) minmax(0, 1fr);
    }

    .field-sheet {
      grid-template-columns: 1fr;
    }

    .field-sheet button {
      margin-top: 20px;
    }

    .next-issue {
      grid-template:
        "label" auto
        "can" 470px
        "copy" auto
        / 1fr;
    }

    .next-issue__can {
      border-right: 0;
      border-bottom: 3px solid var(--ink);
    }

    .issue-footer {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .section-shell {
      width: min(100% - 28px, 1240px);
    }

    .issue-nav {
      grid-template-columns: 1fr auto;
      gap: 12px;
      min-height: 58px;
      padding: 10px 14px;
      font-size: 8px;
    }

    .issue-nav > :nth-child(2),
    .issue-nav > :nth-child(3) {
      display: none;
    }

    .issue-nav__brand {
      font-size: 23px;
    }

    .hero__meta {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero__meta span {
      padding: 8px 10px;
    }

    .hero__meta span:nth-child(3),
    .hero__meta span:nth-child(4) {
      display: none;
    }

    .hero__copy {
      min-height: 680px;
      padding: 34px 16px;
    }

    .hero__copy h1 {
      margin-block: auto 34px;
      font-size: clamp(68px, 23vw, 104px);
    }

    .hero__copy h1 em {
      transform: none;
    }

    .hero__dek {
      font-size: 18px;
    }

    .hero__thesis {
