<script>
  const progressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const updateProgress = () => {
    if (!progressBar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    progressBar.style.width = `${progress * 100}%`;
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });

  const costLab = document.querySelector<HTMLElement>('[data-cost-lab]');
  const costState: Record<string, number> = {
    duration: 30,
    prepare: 10,
    travel: 20,
    recover: 20,
  };

  const updateCost = () => {
    const shadow = costState.prepare + costState.travel + costState.recover;
    const total = costState.duration + shadow;
    const visiblePct = (costState.duration / total) * 100;
    const shadowPct = 100 - visiblePct;
    const setText = (selector: string, value: string) => {
      const node = costLab?.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };
    setText('[data-visible-minutes]', String(costState.duration));
    setText('[data-shadow-minutes]', String(shadow));
    setText('[data-total-minutes]', String(total));
    setText(
      '[data-cost-note]',
      `One rectangle. ${total} minutes of day${shadow === 0 ? '—if it truly has no edges.' : '.'}`,
    );
    const visibleBar = costLab?.querySelector<HTMLElement>('[data-visible-bar]');
    const shadowBar = costLab?.querySelector<HTMLElement>('[data-shadow-bar]');
    if (visibleBar) visibleBar.style.width = `${visiblePct}%`;
    if (shadowBar) shadowBar.style.width = `${shadowPct}%`;
  };

  costLab?.querySelectorAll<HTMLButtonElement>('[data-duration]').forEach((button) => {
    button.addEventListener('click', () => {
      costState.duration = Number(button.dataset.duration || 30);
      costLab
        .querySelectorAll<HTMLButtonElement>('[data-duration]')
        .forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      updateCost();
    });
  });

  costLab?.querySelectorAll<HTMLButtonElement>('[data-shadow-kind]').forEach((button) => {
    button.addEventListener('click', () => {
      const kind = button.dataset.shadowKind;
      if (!kind) return;
      costState[kind] = Number(button.dataset.minutes || 0);
      costLab
        .querySelectorAll<HTMLButtonElement>(`[data-shadow-kind="${kind}"]`)
        .forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      updateCost();
    });
  });

  const weatherLab = document.querySelector<HTMLElement>('[data-weather-lab]');
  const weatherStates = ['open', 'mixed', 'dense'] as const;
  const updateWeather = () => {
    const days = Array.from(
      weatherLab?.querySelectorAll<HTMLButtonElement>('[data-weather-day]') || [],
    );
    const openCount = days.filter((day) => day.dataset.state === 'open').length;
    const denseCount = days.filter((day) => day.dataset.state === 'dense').length;
    const countNode = weatherLab?.querySelector<HTMLElement>('[data-open-count]');
    const readingNode = weatherLab?.querySelector<HTMLElement>('[data-weather-reading]');
    if (countNode) countNode.textContent = String(openCount);
    if (!readingNode) return;
    if (openCount >= 2) {
      readingNode.textContent = `${openCount} open squares. Enough room for arrival if they remain unclaimed.`;
    } else if (openCount === 1) {
      readingNode.textContent = 'One open square. Protect it before the week mistakes it for inventory.';
    } else if (denseCount >= 4) {
      readingNode.textContent = 'No open squares and a dense front. The forecast asks for one renegotiation.';
    } else {
      readingNode.textContent = 'No open squares. Capacity may exist, but none is visible yet.';
    }
  };

  weatherLab?.querySelectorAll<HTMLButtonElement>('[data-weather-day]').forEach((button) => {
    button.addEventListener('click', () => {
      const current = weatherStates.indexOf(
        (button.dataset.state || 'open') as (typeof weatherStates)[number],
      );
      const next = weatherStates[(current + 1) % weatherStates.length];
      button.dataset.state = next;
      button.setAttribute(
        'aria-label',
        `${button.querySelector('span')?.textContent || 'Day'}: ${next}`,
      );
      const label = button.querySelector<HTMLElement>('[data-weather-label]');
      if (label) label.textContent = next;
      updateWeather();
    });
  });

  document.querySelector<HTMLButtonElement>('[data-print-field-sheet]')?.addEventListener('click', () => {
    window.print();
  });

  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  const issueUrl = 'https://pointcast.xyz/noticing/how-to-calendar-a-life';

  document.querySelector<HTMLButtonElement>('[data-copy-issue]')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(issueUrl);
    if (copyStatus) copyStatus.textContent = 'Issue 04 link copied.';
  });

  document.querySelector<HTMLButtonElement>('[data-share-issue]')?.addEventListener('click', async () => {
    if (navigator.share) {
      await navigator.share({
        title: 'How to calendar a life — PointCast',
        text: 'Issue 04 of What I Keep Noticing',
        url: issueUrl,
      });
      return;
    }
    await navigator.clipboard.writeText(issueUrl);
    if (copyStatus) copyStatus.textContent = 'Issue 04 link copied.';
  });
</script>
