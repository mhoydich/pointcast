---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CALENDAR_ISSUE, CALENDAR_SOURCES } from '../../lib/noticing-calendar';

const issue = CALENDAR_ISSUE;
const socialImage = 'https://pointcast.xyz/images/noticing/calendar-issue-04-og.png';
const [weatherPlate, shadowPlate, commonsPlate] = issue.images;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${issue.url}#article`,
  url: issue.url,
  headline: issue.title,
  alternativeHeadline: issue.shortTitle,
  description: issue.dek,
  image: [socialImage, ...issue.images.map((image) => `https://pointcast.xyz${image.src}`)],
  datePublished: issue.publishedAt,
  dateModified: issue.publishedAt,
  inLanguage: 'en-US',
  articleSection: issue.desk,
  wordCount: 1880,
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'What I Keep Noticing',
    url: 'https://pointcast.xyz/noticing',
  },
  about: [
    { '@type': 'Thing', name: 'Calendaring' },
    { '@type': 'Thing', name: 'Time use' },
    { '@type': 'Thing', name: 'Attention' },
    { '@type': 'Thing', name: 'Coordination' },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  creator: {
    '@type': 'Person',
    name: issue.credits.director,
  },
  contributor: [
    { '@type': 'SoftwareApplication', name: issue.credits.writingAndDesign },
    { '@type': 'SoftwareApplication', name: issue.credits.imageSystem },
  ],
  citation: CALENDAR_SOURCES.map((source) => source.url),
};
---

<BlockLayout
  title={`${issue.title} — What I Keep Noticing`}
  description={issue.dek}
  image={socialImage}
  themeColor="#f0b523"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/noticing/how-to-calendar-a-life.json',
      title: 'How to calendar a life — structured issue and source ledger',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Read Issue 04', action: 'link', target: issue.url },
      { label: 'Open the source ledger', action: 'link', target: issue.jsonUrl },
    ],
  }}
>
  <article class="calendar-issue" data-calendar-issue>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="cover" id="top">
      <nav class="cover__nav" aria-label="Issue navigation">
        <a href="/">PointCast</a>
        <a href="/noticing">What I Keep Noticing</a>
        <span>Issue {issue.issue} · {issue.desk}</span>
        <a href="/noticing/how-to-calendar-a-life.json">JSON ↗</a>
      </nav>

      <div class="cover__image">
        <img
          src={weatherPlate.src}
          alt={weatherPlate.alt}
          width={weatherPlate.width}
          height={weatherPlate.height}
          fetchpriority="high"
        />
      </div>
      <div class="cover__wash" aria-hidden="true"></div>

      <div class="cover__title">
        <p>How to calendar a life, or:</p>
        <h1>
          <span>A calendar</span>
          <em>is a treaty</em>
        </h1>
        <p class="cover__dek">{issue.dek}</p>
      </div>

      <div class="cover__issue" aria-hidden="true">
        <b>04</b>
        <span>What I<br />keep noticing</span>
      </div>

      <div class="cover__legend" aria-hidden="true">
        <span>anchors</span>
        <span>shadows</span>
        <span>tides</span>
        <span>weather</span>
        <span>commons</span>
      </div>

      <a class="cover__down" href="#opening">Read the treaty <span aria-hidden="true">↓</span></a>
    </header>

    <section class="opening section-shell" id="opening" aria-labelledby="opening-title">
      <div class="section-index">
        <span>00</span>
        <span>The invitation</span>
      </div>
      <div class="opening__copy">
        <p class="eyebrow">The rectangle is accurate about the meeting</p>
        <h2 id="opening-title">It is dishonest about the day.</h2>
        <div class="opening__paragraphs">
          {issue.opening.map((paragraph, index) => (
            <p class={index === 0 ? 'opening__lead' : undefined}>{paragraph}</p>
          ))}
        </div>
      </div>
      <aside class="opening__thesis">
        <span aria-hidden="true"></span>
        <p>{issue.thesis}</p>
      </aside>
    </section>

    <figure class="plate plate--weather">
      <img
        src={weatherPlate.src}
        alt={weatherPlate.alt}
        width={weatherPlate.width}
        height={weatherPlate.height}
        loading="lazy"
      />
      <figcaption>{weatherPlate.caption}</figcaption>
    </figure>

    <section class="terms section-shell" aria-labelledby="terms-title">
      <div class="section-index">
        <span>01</span>
        <span>Five treaty terms</span>
      </div>
      <header class="section-heading">
        <p class="eyebrow">A more truthful week</p>
        <h2 id="terms-title">The calendar needs more than busy and free.</h2>
        <p>
          Keep the grid. Add the dimensions it forgets.
        </p>
      </header>

      <div class="term-grid">
        {issue.treatyTerms.map((term) => (
          <article class={`term term--${term.id}`}>
            <header>
              <span>{term.number}</span>
              <h3>{term.label}</h3>
            </header>
            <p class="term__proposition">{term.proposition}</p>
            <p>{term.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="essay section-shell" aria-labelledby="essay-01-title">
      <div class="section-index">
        <span>02</span>
        <span>{issue.essays[0].kicker}</span>
      </div>
      <div class="essay__heading">
        <p class="eyebrow">{issue.essays[0].kicker}</p>
        <h2 id="essay-01-title">{issue.essays[0].title}</h2>
      </div>
      <div class="essay__body">
        {issue.essays[0].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="protocol-card" aria-label="iCalendar grammar">
        <p>THE MACHINE SEES</p>
        <code>START → END</code>
        <span>opaque / transparent</span>
        <small>The person still has to supply the edges.</small>
      </aside>
    </section>

    <section class="cost-lab" aria-labelledby="cost-title" data-cost-lab>
      <div class="cost-lab__intro">
        <p class="eyebrow">Instrument 01 · The true footprint</p>
        <h2 id="cost-title">How long is a 30-minute meeting?</h2>
        <p>
          Choose the visible event and its hidden edges. This is an accounting device, not a universal buffer rule.
        </p>
      </div>

      <div class="cost-lab__controls">
        <fieldset>
          <legend>Visible event</legend>
          <div class="choice-row">
            {[25, 30, 50, 90].map((minutes) => (
              <button
                type="button"
                data-duration={minutes}
                aria-pressed={minutes === 30 ? 'true' : 'false'}
              >
                {minutes} min
              </button>
            ))}
          </div>
        </fieldset>

        {[
          { id: 'prepare', label: 'Prepare', options: [0, 10, 20, 30], initial: 10 },
          { id: 'travel', label: 'Travel / setup', options: [0, 10, 20, 45], initial: 20 },
          { id: 'recover', label: 'Return / recover', options: [0, 10, 20, 40], initial: 20 },
        ].map((shadow) => (
          <fieldset>
            <legend>{shadow.label}</legend>
            <div class="choice-row">
              {shadow.options.map((minutes) => (
                <button
                  type="button"
                  data-shadow-kind={shadow.id}
                  data-minutes={minutes}
                  aria-pressed={minutes === shadow.initial ? 'true' : 'false'}
                >
                  {minutes === 0 ? 'none' : `+${minutes}`}
                </button>
              ))}
            </div>
          </fieldset>
        ))}
      </div>

      <div class="cost-lab__result" aria-live="polite">
        <div class="cost-lab__numbers">
          <span><b data-visible-minutes>30</b> visible</span>
          <span><b data-shadow-minutes>50</b> shadow</span>
          <strong><b data-total-minutes>80</b> minutes true footprint</strong>
        </div>
        <div class="cost-lab__bar" aria-hidden="true">
          <span data-visible-bar></span>
          <span data-shadow-bar></span>
        </div>
        <p data-cost-note>One rectangle. Eighty minutes of day.</p>
      </div>
    </section>

    <figure class="plate plate--shadow">
      <img
        src={shadowPlate.src}
        alt={shadowPlate.alt}
        width={shadowPlate.width}
        height={shadowPlate.height}
        loading="lazy"
      />
      <figcaption>{shadowPlate.caption}</figcaption>
    </figure>

    <section class="essay section-shell essay--dark" aria-labelledby="essay-02-title">
      <div class="section-index">
        <span>03</span>
        <span>{issue.essays[1].kicker}</span>
      </div>
      <div class="essay__heading">
        <p class="eyebrow">{issue.essays[1].kicker}</p>
        <h2 id="essay-02-title">{issue.essays[1].title}</h2>
      </div>
      <div class="essay__body">
        {issue.essays[1].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <blockquote>
        <p>End interrupted work with one line: “I was here. Return by doing this.”</p>
        <cite>PointCast field rule 07</cite>
      </blockquote>
    </section>

    <section class="weather-lab section-shell" aria-labelledby="weather-title" data-weather-lab>
      <div class="section-index">
        <span>04</span>
        <span>Instrument 02</span>
      </div>
      <header class="section-heading">
        <p class="eyebrow">The week has weather</p>
        <h2 id="weather-title">Forecast capacity before it is claimed.</h2>
        <p>
          Tap each day to cycle through open, mixed, and dense. This stays in your browser and disappears on refresh.
        </p>
      </header>

      <div class="week-weather" role="group" aria-label="Capacity forecast by day">
        {[
          ['Mon', 'mixed'],
          ['Tue', 'dense'],
          ['Wed', 'mixed'],
          ['Thu', 'open'],
          ['Fri', 'dense'],
          ['Sat', 'mixed'],
          ['Sun', 'open'],
        ].map(([day, state]) => (
          <button type="button" data-weather-day data-state={state} aria-label={`${day}: ${state}`}>
            <span>{day}</span>
            <b data-weather-label>{state}</b>
            <i aria-hidden="true"></i>
          </button>
        ))}
      </div>
      <div class="weather-lab__reading" aria-live="polite">
        <span data-open-count>2</span>
        <p data-weather-reading>
          Two open squares. Enough room for arrival if they remain unclaimed.
        </p>
      </div>
    </section>

    <section class="essay section-shell" aria-labelledby="essay-03-title">
      <div class="section-index">
        <span>05</span>
        <span>{issue.essays[2].kicker}</span>
      </div>
      <div class="essay__heading">
        <p class="eyebrow">{issue.essays[2].kicker}</p>
        <h2 id="essay-03-title">{issue.essays[2].title}</h2>
      </div>
      <div class="essay__body">
        {issue.essays[2].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="weather-note">
        <p>This week is:</p>
        <span>exposed / tidal / clearing / generous</span>
        <small>One sentence. No score.</small>
      </aside>
    </section>

    <figure class="plate plate--commons">
      <img
        src={commonsPlate.src}
        alt={commonsPlate.alt}
        width={commonsPlate.width}
        height={commonsPlate.height}
        loading="lazy"
      />
      <figcaption>{commonsPlate.caption}</figcaption>
    </figure>

    <section class="essay section-shell essay--commons" aria-labelledby="essay-04-title">
      <div class="section-index">
        <span>06</span>
        <span>{issue.essays[3].kicker}</span>
      </div>
      <div class="essay__heading">
        <p class="eyebrow">{issue.essays[3].kicker}</p>
        <h2 id="essay-04-title">{issue.essays[3].title}</h2>
      </div>
      <div class="essay__body">
        {issue.essays[3].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="empty-square" aria-label="A deliberately empty square">
        <span></span>
        <p>available<br />for arrival</p>
      </div>
    </section>

    <section class="field-sheet section-shell" aria-labelledby="field-title">
      <div class="section-index">
        <span>07</span>
        <span>Refrigerator-door protocol</span>
      </div>
      <header class="section-heading">
        <p class="eyebrow">The weekly treaty</p>
        <h2 id="field-title">Eight clauses for an inhabitable week.</h2>
        <p>
          Print it, mark it, ignore the clauses that do not fit, and renegotiate next week.
        </p>
      </header>

      <ol class="field-sheet__rules">
        {issue.fieldRules.map((rule, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{rule}</p>
          </li>
        ))}
      </ol>

      <div class="field-sheet__footer">
        <div>
          <p>My week’s weather:</p>
          <span></span>
        </div>
        <div>
          <p>The square I will leave open:</p>
          <span></span>
        </div>
        <button type="button" data-print-field-sheet>Print the treaty</button>
      </div>
    </section>

    <section class="evidence section-shell" aria-labelledby="evidence-title">
      <div class="section-index">
        <span>08</span>
        <span>Evidence desk</span>
      </div>
      <header class="section-heading">
        <p class="eyebrow">What is measured, what is interpreted</p>
        <h2 id="evidence-title">Keep the claims in their lanes.</h2>
      </header>

      <div class="evidence__grid">
        {issue.evidenceDesk.map((item) => (
          <article>
            <h3>{item.label}</h3>
            <p>{item.value}</p>
          </article>
        ))}
      </div>

      <aside class="boundary-note">
        <strong>Reporting boundary</strong>
        <p>{issue.reportingBoundary}</p>
      </aside>
    </section>

    <section class="sources section-shell" aria-labelledby="sources-title">
      <div class="section-index">
        <span>09</span>
        <span>Source ledger</span>
      </div>
      <header class="section-heading">
        <p class="eyebrow">Ten ways into the week</p>
        <h2 id="sources-title">Inspect the paper trail.</h2>
        <a href="/noticing/how-to-calendar-a-life.json">Open the structured issue ↗</a>
      </header>

      <ol class="source-list">
        {CALENDAR_SOURCES.map((source) => (
          <li>
            <span>{source.id}</span>
            <div>
              <a href={source.url}>{source.title} ↗</a>
              <p>{source.publisher}</p>
              <small>{source.usedFor}</small>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <p class="eyebrow">The treaty remains amendable</p>
      <h2 id="closing-title">Make a week a person can inhabit.</h2>
      <div>
        {issue.closing.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="closing__mark">Leave a square.</p>
    </section>

    <section class="next-issue" aria-labelledby="next-title">
      <div>
        <p>{issue.next.label}</p>
        <h2 id="next-title">{issue.next.title}</h2>
        <span>{issue.next.dateLabel}</span>
      </div>
      <p>{issue.next.dek}</p>
      <a href="/noticing">Return to the editorial desk <span aria-hidden="true">↗</span></a>
    </section>

    <footer class="issue-footer">
      <a href="#top">Back to the week ↑</a>
      <p>PointCast · What I Keep Noticing · Issue 04</p>
      <div>
        <button type="button" data-copy-issue>Copy Issue 04 link</button>
        <button type="button" data-share-issue>Share</button>
      </div>
      <span data-copy-status aria-live="polite"></span>
    </footer>
  </article>
</BlockLayout>

<style is:global>
  :root {
    --cal-ink: #101b2b;
    --cal-paper: #f4ecda;
    --cal-yellow: #f0b523;
    --cal-blue: #2f7392;
    --cal-tide: #8ab7bd;
    --cal-orange: #d95c2b;
    --cal-mint: #9ab79b;
    --cal-fog: #c8ced0;
    --cal-magenta: #d23974;
    --cal-rule: rgba(16, 27, 43, 0.24);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--cal-paper);
    color: var(--cal-ink);
  }

  .calendar-issue,
  .calendar-issue * {
    box-sizing: border-box;
  }

  .calendar-issue {
    overflow: clip;
    background:
      linear-gradient(90deg, transparent 49.8%, rgba(16, 27, 43, 0.035) 50%, transparent 50.2%),
      var(--cal-paper);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .calendar-issue a {
    color: inherit;
  }

  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: 4px;
    background: rgba(244, 236, 218, 0.25);
  }

  .reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--cal-magenta);
  }

  .cover {
    position: relative;
    min-height: 100svh;
    color: #fff8e9;
    background: var(--cal-ink);
    isolation: isolate;
  }

  .cover__nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 248, 233, 0.4);
    text-transform: uppercase;
    font: 700 0.67rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.11em;
  }

  .cover__nav a {
    text-decoration: none;
  }

  .cover__image,
  .cover__wash {
    position: absolute;
    inset: 0;
  }

  .cover__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% center;
  }

  .cover__wash {
    background:
      linear-gradient(90deg, rgba(10, 22, 38, 0.96) 0%, rgba(10, 22, 38, 0.75) 32%, rgba(10, 22, 38, 0.08) 68%),
      linear-gradient(0deg, rgba(10, 22, 38, 0.82) 0%, transparent 45%);
  }

  .cover__title {
    position: absolute;
    z-index: 3;
    left: clamp(1.5rem, 6vw, 6rem);
    top: 18%;
    width: min(54rem, 68vw);
  }

  .cover__title > p:first-child {
    margin: 0 0 1.2rem;
    color: var(--cal-yellow);
    text-transform: uppercase;
    font: 800 0.75rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.16em;
  }

  .cover h1 {
    margin: 0;
    text-transform: uppercase;
    font: 900 clamp(4.6rem, 10.5vw, 10rem)/0.78 Inter, ui-sans-serif, sans-serif;
    letter-spacing: -0.075em;
  }

  .cover h1 span,
  .cover h1 em {
    display: block;
  }

  .cover h1 em {
    margin-left: 0.12em;
    color: var(--cal-yellow);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.05em;
  }

  .cover__dek {
    max-width: 41rem;
    margin: 2rem 0 0;
    font: 500 clamp(1rem, 1.8vw, 1.35rem)/1.45 Georgia, 'Times New Roman', serif;
  }

  .cover__issue {
    position: absolute;
    z-index: 3;
    right: 2rem;
    top: 6rem;
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    text-transform: uppercase;
  }

  .cover__issue b {
    color: var(--cal-yellow);
    font: 900 4.5rem/0.8 Inter, sans-serif;
  }

  .cover__issue span {
    font: 800 0.62rem/1.2 ui-monospace, monospace;
    letter-spacing: 0.11em;
  }

  .cover__legend {
    position: absolute;
    z-index: 3;
    right: 1.5rem;
    bottom: 1.5rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 34rem;
  }

  .cover__legend span {
    padding: 0.45rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-transform: uppercase;
    font: 700 0.62rem/1 ui-monospace, monospace;
    letter-spacing: 0.08em;
  }

  .cover__legend span:nth-child(2) {
    color: var(--cal-yellow);
  }

  .cover__legend span:nth-child(4) {
    color: var(--cal-tide);
  }

  .cover__down {
    position: absolute;
    z-index: 3;
    left: clamp(1.5rem, 6vw, 6rem);
    bottom: 2rem;
    text-transform: uppercase;
    font: 800 0.7rem/1 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .section-shell {
    width: min(1180px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .section-index {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem 0;
    border-top: 1px solid currentColor;
    text-transform: uppercase;
    font: 700 0.66rem/1.2 ui-monospace, monospace;
    letter-spacing: 0.12em;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--cal-orange);
    text-transform: uppercase;
    font: 800 0.7rem/1.2 ui-monospace, monospace;
    letter-spacing: 0.14em;
  }

  .opening {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 17rem;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .opening .section-index {
    display: block;
    border-top: 0;
    border-right: 1px solid var(--cal-rule);
  }

  .opening .section-index span {
    display: block;
    margin-bottom: 0.5rem;
  }

  .opening h2,
  .section-heading h2,
  .essay h2,
  .cost-lab h2,
  .closing h2,
  .next-issue h2 {
    margin: 0;
    font: 700 clamp(2.7rem, 6vw, 6.7rem)/0.96 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.05em;
  }

  .opening__paragraphs {
    columns: 2 18rem;
    column-gap: 2rem;
    margin-top: 3rem;
  }

  .opening__paragraphs p {
    margin: 0 0 1.2rem;
    font: 400 1.03rem/1.75 Georgia, serif;
  }

  .opening__lead {
    font-size: 1.35rem !important;
    line-height: 1.45 !important;
  }

  .opening__thesis {
    align-self: end;
    padding: 1.4rem;
    color: #fff;
    background: var(--cal-blue);
  }

  .opening__thesis span {
    display: block;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.5rem;
    border-radius: 50%;
    background: var(--cal-yellow);
