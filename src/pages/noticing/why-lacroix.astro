  .flavor-lab__controls { display: grid; grid-template-columns: repeat(4, 1fr); border: 2px solid var(--cream); }
  .flavor-lab fieldset { display: flex; flex-direction: column; gap: .5rem; margin: 0; padding: 1rem; border: 0; border-right: 2px solid var(--cream); }
  .flavor-lab fieldset:last-child { border: 0; }
  .flavor-lab legend { padding: 0 .4rem; color: var(--lime); font: 800 .68rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .flavor-lab button {
