---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { LACROIX_ISSUE, LACROIX_SOURCES } from '../../lib/noticing-lacroix';

const issue = LACROIX_ISSUE;
const socialImage = 'https://pointcast.xyz/images/noticing/lacroix-issue-02-og.png';
const [hero, aromaPlate, shelfPlate] = issue.images;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${issue.url}#article`,
  url: issue.url,
  headline: issue.title,
  alternativeHeadline: issue.shortTitle,
  description: issue.dek,
  image: [socialImage, ...issue.images.map((image) => `https://pointcast.xyz${image.src}`)],
  datePublished: issue.publishedAt,
  dateModified: issue.publishedAt,
  inLanguage: 'en-US',
  articleSection: issue.desk,
  wordCount: 1850,
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'What I Keep Noticing',
    url: 'https://pointcast.xyz/noticing',
  },
  about: [
    { '@type': 'Thing', name: 'LaCroix Sparkling Water' },
    { '@type': 'Thing', name: 'Everyday ritual' },
    { '@type': 'Thing', name: 'Packaging design' },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  creator: {
    '@type': 'Person',
    name: issue.credits.director,
  },
  contributor: [
    { '@type': 'SoftwareApplication', name: issue.credits.writingAndDesign },
    { '@type': 'SoftwareApplication', name: issue.credits.imageSystem },
  ],
  citation: LACROIX_SOURCES.map((source) => source.url),
};
---

<BlockLayout
  title={`${issue.title} — What I Keep Noticing`}
  description={issue.dek}
  image={socialImage}
  themeColor="#ff5d47"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/noticing/why-lacroix.json',
      title: 'Why LaCroix structured issue and source ledger',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Read Issue 02', action: 'link', target: issue.url },
      { label: 'Open the source ledger', action: 'link', target: issue.jsonUrl },
    ],
  }}
>
  <article class="issue" data-lacroix-issue>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="cover" id="top">
      <nav class="cover__nav" aria-label="Issue navigation">
        <a href="/">PointCast</a>
        <a href="/noticing">What I Keep Noticing</a>
        <span>Issue {issue.issue} · {issue.desk}</span>
        <a href="/noticing/why-lacroix.json">JSON ↗</a>
      </nav>

      <div class="cover__image">
        <img
          src={hero.src}
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          fetchpriority="high"
        />
      </div>

      <div class="cover__wash" aria-hidden="true"></div>
      <div class="cover__stamp" aria-hidden="true">
        <span>cold</span>
        <span>bright</span>
        <span>barely there</span>
      </div>

      <div class="cover__title">
        <p>Almost nothing, made into an occasion</p>
        <h1>Why<br /><em>LaCroix?</em></h1>
        <p class="cover__dek">{issue.dek}</p>
      </div>

      <div class="cover__issue">
        <span>02</span>
        <p>What I<br />keep noticing</p>
      </div>

      <div class="cover__crack">
        <button type="button" data-crack aria-describedby="crack-note">
          <span>Crack the issue</span>
          <b aria-hidden="true">PSSHT</b>
        </button>
        <p id="crack-note" data-crack-status>The sound waits for your thumb.</p>
      </div>

      <p class="cover__caption">{hero.caption}</p>
    </header>

    <section class="opening" aria-labelledby="opening-title">
      <div class="opening__rail">
        <p>PointCast Weekly</p>
        <span>El Segundo · 27 July 2026</span>
        <span>{issue.readingTime}</span>
      </div>
      <div class="opening__copy">
        <p class="rubric">The ritual beverage</p>
        <h2 id="opening-title">Water does not usually get an entrance.</h2>
        {issue.opening.map((paragraph, index) => (
          <p class:list={{ lead: index === 0 }}>{paragraph}</p>
        ))}
      </div>
      <aside class="opening__thesis">
        <span>The whole issue<br />in one sentence</span>
        <p>{issue.thesis}</p>
      </aside>
    </section>

    <section class="signal-board" aria-labelledby="signals-title">
      <header>
        <p class="rubric">Five signals, one ordinary can</p>
        <h2 id="signals-title">The drink starts before the drink.</h2>
      </header>
      <div class="signal-board__grid">
        {issue.signals.map((signal) => (
          <article>
            <div>
              <span>{signal.number}</span>
              <b>{signal.label}</b>
            </div>
            <h3>{signal.title}</h3>
            <p>{signal.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="essay essay--first">
      <div class="essay__number" aria-hidden="true">{issue.essays[0].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[0].kicker}</p>
        <h2>{issue.essays[0].title}</h2>
        {issue.essays[0].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="source-note">
          Reporting note · Carbonation physiology:
          <a href={LACROIX_SOURCES[4].url}>Chemical Senses / NLM ↗</a>
        </p>
      </div>
      <aside class="pressure-card" aria-label="The pressure sequence">
        <span>pressure</span>
        <i aria-hidden="true"></i>
        <span>sound</span>
        <i aria-hidden="true"></i>
        <span>attention</span>
        <i aria-hidden="true"></i>
        <strong>occasion</strong>
      </aside>
    </section>

    <figure class="plate plate--aroma">
      <img
        src={aromaPlate.src}
        alt={aromaPlate.alt}
        width={aromaPlate.width}
        height={aromaPlate.height}
        loading="lazy"
      />
      <figcaption>{aromaPlate.caption}</figcaption>
      <span aria-hidden="true">AROMA<br />WITHOUT<br />FRUIT</span>
    </figure>

    <section class="essay essay--aroma">
      <div class="essay__number" aria-hidden="true">{issue.essays[1].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[1].kicker}</p>
        <h2>{issue.essays[1].title}</h2>
        {issue.essays[1].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="whisper" aria-label="A spectrum of flavor intensity">
        <p>A very unofficial flavor meter</p>
        <div>
          <span>nothing</span>
          <i aria-hidden="true"></i>
          <strong>LaCroix</strong>
          <i aria-hidden="true"></i>
          <span>fruit</span>
        </div>
        <small>The sweet spot is an argument.</small>
      </aside>
    </section>

    <section class="label-desk" aria-labelledby="label-desk-title">
      <header>
        <p class="rubric">Keep the categories clean</p>
        <h2 id="label-desk-title">Claim, evidence, reading, limit.</h2>
      </header>
      <div>
        {issue.labelDesk.map((item, index) => (
          <article>
            <span>0{index + 1}</span>
            <h3>{item.label}</h3>
            <p>{item.value}</p>
          </article>
        ))}
      </div>
      <p class="label-desk__boundary">{issue.reportingBoundary}</p>
    </section>

    <figure class="plate plate--shelf">
      <img
        src={shelfPlate.src}
        alt={shelfPlate.alt}
        width={shelfPlate.width}
        height={shelfPlate.height}
        loading="lazy"
      />
      <figcaption>{shelfPlate.caption}</figcaption>
    </figure>

    <section class="essay essay--shelf">
      <div class="essay__number" aria-hidden="true">{issue.essays[2].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[2].kicker}</p>
        <h2>{issue.essays[2].title}</h2>
        {issue.essays[2].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="can-poem" aria-hidden="true">
        <span>the liquid</span>
        <b>whispers</b>
        <span>the can</span>
        <strong>wears<br />the room</strong>
      </aside>
    </section>

    <section class="flavor-lab" aria-labelledby="flavor-lab-title" data-flavor-lab>
      <header>
        <div>
          <p class="rubric">Small interactive instrument</p>
          <h2 id="flavor-lab-title">{issue.fieldTest.title}</h2>
        </div>
        <p>{issue.fieldTest.note}</p>
      </header>

      <div class="flavor-lab__controls">
        <fieldset data-choice-group="temperature">
          <legend>01 · Temperature</legend>
          {issue.fieldTest.temperatures.map((choice, index) => (
            <button
              type="button"
              data-choice="temperature"
              data-value={choice}
              aria-pressed={index === 1 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
        <fieldset data-choice-group="bubble">
          <legend>02 · Bubble</legend>
          {issue.fieldTest.bubbles.map((choice, index) => (
            <button
              type="button"
              data-choice="bubble"
              data-value={choice}
              aria-pressed={index === 1 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
        <fieldset data-choice-group="aroma">
          <legend>03 · Aroma</legend>
          {issue.fieldTest.aromas.map((choice, index) => (
            <button
              type="button"
              data-choice="aroma"
              data-value={choice}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
        <fieldset data-choice-group="setting">
          <legend>04 · Setting</legend>
          {issue.fieldTest.settings.map((choice, index) => (
            <button
              type="button"
              data-choice="setting"
              data-value={choice}
              aria-pressed={index === 1 ? 'true' : 'false'}
            >
              {choice}
            </button>
          ))}
        </fieldset>
      </div>

      <div class="flavor-lab__result" aria-live="polite">
        <span>Your invisible flavor</span>
        <p data-flavor-result>
          Cool water with bright bubbles, lime-leaf static, opened after a walk.
        </p>
        <small data-flavor-code>COOL / BRIGHT / LIME LEAF / AFTER A WALK</small>
      </div>
    </section>

    <section class="essay essay--permission">
      <div class="essay__number" aria-hidden="true">{issue.essays[3].number}</div>
      <div class="essay__body">
        <p class="rubric">{issue.essays[3].kicker}</p>
        <h2>{issue.essays[3].title}</h2>
        {issue.essays[3].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="receipt">
        <p>Keep the receipt attached</p>
        <a href={LACROIX_SOURCES[5].url}>Dental erosion · ADA ↗</a>
        <a href={LACROIX_SOURCES[6].url}>Aluminum data · EPA ↗</a>
        <a href={LACROIX_SOURCES[7].url}>Local recycling rules · EPA ↗</a>
      </aside>
    </section>

    <section class="fridge-sheet" aria-labelledby="fridge-sheet-title">
      <div>
        <p class="rubric">Clip and keep</p>
        <h2 id="fridge-sheet-title">The refrigerator-door protocol</h2>
        <p>A field guide for getting more attention out of less beverage.</p>
      </div>
      <ol>
        {issue.fridgeProtocol.map((step) => <li>{step}</li>)}
      </ol>
      <button type="button" data-print-field-sheet>Print this field sheet ↗</button>
    </section>

    <section class="closing">
      <div class="closing__mark" aria-hidden="true">
        <span>pssht</span>
      </div>
      <div>
        {issue.closing.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="closing__last">Almost<br /><em>nothing.</em></p>
    </section>

    <section class="sources" id="sources" aria-labelledby="sources-title">
      <header>
        <div>
          <p class="rubric">Source ledger</p>
          <h2 id="sources-title">Eight places to keep reading.</h2>
        </div>
        <p>
          Company claims are attributed. Scientific, regulatory, dental, and recycling context
          comes from the linked research and public agencies. The interpretation is PointCast’s.
        </p>
      </header>
      <ol>
        {LACROIX_SOURCES.map((source) => (
          <li>
            <span>{source.id}</span>
            <div>
              <a href={source.url}>{source.title} ↗</a>
              <p>{source.publisher} · {source.usedFor}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="next">
      <div>
        <span>{issue.next.label}</span>
        <p>{issue.next.dateLabel}</p>
      </div>
      <h2>{issue.next.title}</h2>
      <p>{issue.next.dek}</p>
      <div class="next__actions">
        <button type="button" data-copy-issue>Copy Issue 02 link</button>
        <a href="/noticing">Return to the editorial calendar →</a>
      </div>
      <small data-copy-status aria-live="polite"></small>
    </footer>
  </article>
</BlockLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f7f0de; color: #16120d; }
  :global(.site-header), :global(.network-strip) { display: none !important; }
  :global(main) { padding: 0 !important; max-width: none !important; }
  :global(*) { box-sizing: border-box; }

  .issue {
    --ink: #16120d;
    --paper: #f7f0de;
    --cream: #fff9e9;
    --coral: #ff5d47;
    --lime: #bee620;
    --blue: #174fc7;
    --pink: #f4a3b8;
    --silver: #d7d6ce;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    overflow: clip;
    background:
      radial-gradient(circle at 20% 12%, rgb(255 255 255 / 56%), transparent 25rem),
      var(--paper);
  }

  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 5px;
    background: rgb(22 18 13 / 12%);
  }
  .reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--coral), var(--lime), var(--blue));
  }

  .cover {
    position: relative;
    min-height: 100svh;
    color: var(--cream);
    background: #2b241e;
    isolation: isolate;
  }
  .cover__nav {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: .9rem 1.25rem;
    border-bottom: 2px solid currentColor;
    font: 700 .68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .cover__nav a { color: inherit; text-decoration: none; }
  .cover__image { position: absolute; inset: 0; z-index: -3; }
  .cover__image img { width: 100%; height: 100%; object-fit: cover; }
  .cover__wash {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(22 18 13 / 86%) 0 28%, transparent 66%),
      linear-gradient(0deg, rgb(22 18 13 / 62%), transparent 48%);
  }
  .cover__title {
    position: absolute;
    left: clamp(1.25rem, 5vw, 5rem);
    top: 18%;
    z-index: 2;
    width: min(48rem, 70vw);
  }
  .cover__title > p:first-child {
    margin: 0 0 1rem;
    font: 800 .72rem/1 ui-monospace, monospace;
    letter-spacing: .19em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .cover h1 {
    margin: 0;
    font-size: clamp(5.5rem, 14vw, 12rem);
    line-height: .67;
    letter-spacing: -.09em;
    text-transform: uppercase;
  }
  .cover h1 em {
    color: var(--coral);
    font-family: Georgia, serif;
    font-weight: 400;
    text-transform: none;
  }
  .cover__dek {
    max-width: 37rem;
    margin: 2.4rem 0 0 !important;
    font: 650 clamp(1.15rem, 2vw, 1.65rem)/1.25 Georgia, serif;
  }
  .cover__issue {
    position: absolute;
    right: 1.4rem;
    top: 5rem;
    display: flex;
    gap: .8rem;
    align-items: flex-start;
    color: var(--ink);
    background: var(--lime);
    padding: .7rem .8rem;
    transform: rotate(2deg);
    box-shadow: 6px 6px 0 var(--coral);
  }
  .cover__issue span { font: 900 3.4rem/.8 sans-serif; letter-spacing: -.1em; }
  .cover__issue p { margin: 0; font: 800 .66rem/1.15 ui-monospace, monospace; text-transform: uppercase; }
  .cover__stamp {
    position: absolute;
    right: 2.2rem;
    top: 40%;
    display: grid;
    gap: .35rem;
    justify-items: end;
    color: var(--ink);
    font: 900 clamp(1rem, 2.5vw, 2rem)/1 sans-serif;
    text-transform: uppercase;
  }
  .cover__stamp span { display: block; padding: .2rem .5rem; background: var(--cream); }
  .cover__stamp span:nth-child(2) { background: var(--coral); transform: translateX(-2rem) rotate(-2deg); }
  .cover__stamp span:nth-child(3) { background: var(--blue); color: white; transform: rotate(1.5deg); }
  .cover__crack { position: absolute; left: 5vw; bottom: 4.7rem; z-index: 3; }
  .cover__crack button {
    display: flex;
    gap: 1rem;
    align-items: center;
    border: 2px solid var(--cream);
    padding: .8rem 1rem;
    color: var(--cream);
    background: rgb(22 18 13 / 70%);
    font: 800 .75rem/1 ui-monospace, monospace;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cover__crack button:hover, .cover__crack button:focus-visible {
    color: var(--ink);
    background: var(--lime);
  }
  .cover__crack b { color: var(--coral); letter-spacing: .18em; }
  .cover__crack p { margin: .55rem 0 0; font: 600 .68rem/1.2 ui-monospace, monospace; }
  .cover__caption {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    max-width: 35rem;
    margin: 0;
    text-align: right;
    font: 600 .68rem/1.35 ui-monospace, monospace;
  }

  .rubric {
    margin: 0 0 .8rem !important;
    color: var(--blue);
    font: 800 .71rem/1 ui-monospace, monospace !important;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .opening {
    display: grid;
    grid-template-columns: .65fr 2.3fr 1fr;
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: clamp(4rem, 9vw, 9rem) clamp(1.25rem, 5vw, 5rem);
    border-bottom: 2px solid var(--ink);
  }
  .opening__rail {
    display: flex;
    flex-direction: column;
    gap: .8rem;
    font: 700 .67rem/1.4 ui-monospace, monospace;
    text-transform: uppercase;
  }
  .opening__rail p { margin: 0; color: var(--coral); }
  .opening__copy h2, .essay h2, .signal-board h2, .label-desk h2, .flavor-lab h2,
  .fridge-sheet h2, .sources h2, .next h2 {
    margin: 0 0 2rem;
    font: 800 clamp(2.6rem, 6vw, 6.5rem)/.92 Georgia, serif;
    letter-spacing: -.055em;
  }
  .opening__copy > p:not(.rubric) {
    max-width: 50rem;
    font: 450 clamp(1.12rem, 1.7vw, 1.42rem)/1.62 Georgia, serif;
  }
  .opening__copy .lead::first-letter {
    float: left;
    margin: .06em .12em -.08em 0;
    color: var(--coral);
    font: 900 5.6em/.75 sans-serif;
  }
  .opening__thesis {
    align-self: start;
    border-top: 12px solid var(--lime);
    padding: 1rem 0;
  }
  .opening__thesis span { font: 800 .65rem/1.35 ui-monospace, monospace; text-transform: uppercase; }
  .opening__thesis p { font: 800 clamp(1.7rem, 3vw, 2.8rem)/.98 sans-serif; letter-spacing: -.05em; }

  .signal-board { padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 4vw, 4rem); background: var(--blue); color: var(--cream); }
  .signal-board header { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .signal-board .rubric { color: var(--lime); }
  .signal-board h2 { max-width: 65rem; }
  .signal-board__grid { display: grid; grid-template-columns: repeat(5, 1fr); border: 2px solid currentColor; }
  .signal-board__grid article { min-height: 22rem; padding: 1rem; border-right: 2px solid currentColor; }
  .signal-board__grid article:last-child { border: 0; }
  .signal-board__grid article > div { display: flex; justify-content: space-between; color: var(--lime); font: 800 .7rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .signal-board__grid h3 { margin: 5.5rem 0 1rem; font-size: clamp(1.3rem, 2.1vw, 2rem); line-height: .96; letter-spacing: -.04em; }
  .signal-board__grid p { font: 500 .92rem/1.5 Georgia, serif; }

  .essay {
    position: relative;
    display: grid;
    grid-template-columns: .45fr 1.8fr .8fr;
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 6vw, 6rem);
  }
  .essay__number { color: var(--coral); font: 900 clamp(5rem, 14vw, 13rem)/.7 sans-serif; letter-spacing: -.12em; }
  .essay__body { max-width: 54rem; }
  .essay__body > p:not(.rubric, .source-note) { font: 450 clamp(1.1rem, 1.7vw, 1.38rem)/1.68 Georgia, serif; }
  .source-note { margin-top: 2rem; font: 700 .68rem/1.5 ui-monospace, monospace; text-transform: uppercase; }
  .source-note a { color: var(--blue); }
  .pressure-card, .whisper, .can-poem, .receipt { align-self: center; }
  .pressure-card { display: grid; gap: .8rem; text-align: center; font: 800 .7rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .pressure-card i { justify-self: center; width: 1px; height: 2.5rem; background: var(--ink); }
  .pressure-card strong { padding: 1rem; color: var(--cream); background: var(--coral); font-size: 1rem; }

  .plate { position: relative; margin: 0; border-block: 2px solid var(--ink); background: var(--cream); }
  .plate img { display: block; width: 100%; height: auto; max-height: 94svh; object-fit: cover; }
  .plate figcaption { padding: .7rem 1rem; border-top: 2px solid var(--ink); font: 650 .68rem/1.35 ui-monospace, monospace; }
  .plate--aroma > span {
    position: absolute;
    right: 3vw;
    top: 3vw;
    color: var(--blue);
    font: 950 clamp(2rem, 7vw, 7rem)/.78 sans-serif;
    letter-spacing: -.07em;
    text-align: right;
    mix-blend-mode: multiply;
  }

  .essay--aroma { background: var(--cream); }
