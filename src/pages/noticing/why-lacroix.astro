  .flavor-lab__result { margin-top: 2rem; padding: 2rem; color: var(--ink); background: var(--cream); }
  .flavor-lab__result span, .flavor-lab__result small { font: 800 .68rem/1.3 ui-monospace, monospace; text-transform: uppercase; }
  .flavor-lab__result p { margin: 1rem 0; color: var(--blue); font: 800 clamp(2rem, 4vw, 4.5rem)/.95 Georgia, serif; }

  .essay--permission { background: var(--cream); }
  .receipt { display: grid; gap: .7rem; border: 2px solid var(--ink); padding: 1rem; box-shadow: 8px 8px 0 var(--coral); transform: rotate(1deg); }
  .receipt p { margin: 0 0 1rem; font: 900 1.5rem/.95 sans-serif; text-transform: uppercase; }
  .receipt a { color: var(--blue); font: 700 .68rem/1.3 ui-monospace, monospace; text-transform: uppercase; }

  .fridge-sheet { display: grid; grid-template-columns: 1fr 1.6fr; gap: 4rem; padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 6vw, 6rem); background: var(--coral); }
  .fridge-sheet ol { margin: 0; padding: 0; list-style: none; counter-reset: protocol; border-top: 2px solid var(--ink); }
  .fridge-sheet li { counter-increment: protocol; display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 2px solid var(--ink); font: 600 1rem/1.35 ui-monospace, monospace; }
  .fridge-sheet li::before { content: "0" counter(protocol); font-weight: 900; color: var(--cream); }
  .fridge-sheet button { grid-column: 2; justify-self: start; border: 2px solid var(--ink); padding: .8rem 1rem; color: inherit; background: transparent; font: 800 .7rem/1 ui-monospace, monospace; text-transform: uppercase; cursor: pointer; }
  .fridge-sheet button:hover { color: var(--cream); background: var(--ink); }

  .closing { position: relative; display: grid; grid-template-columns: .7fr 1.8fr .9fr; gap: 3rem; align-items: center; min-height: 80svh; padding: 5rem; color: var(--cream); background: var(--blue); }
  .closing__mark { aspect-ratio: 1; display: grid; place-items: center; border: 3px solid currentColor; border-radius: 50%; box-shadow: inset 0 0 0 1.4rem var(--coral); }
  .closing__mark span { font: 900 1rem/1 ui-monospace, monospace; text-transform: uppercase; transform: rotate(-12deg); }
  .closing > div:nth-child(2) p { font: 450 clamp(1.2rem, 2.2vw, 2rem)/1.5 Georgia, serif; }
  .closing__last { font: 900 clamp(4rem, 8vw, 9rem)/.72 sans-serif; letter-spacing: -.08em; text-transform: uppercase; }
  .closing__last em { color: var(--lime); font-family: Georgia, serif; text-transform: none; }

  .sources { padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 5vw, 5rem); }
  .sources header { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: end; }
  .sources header > p { font: 500 .85rem/1.6 ui-monospace, monospace; }
  .sources ol { margin: 3rem 0 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
  .sources li { display: grid; grid-template-columns: 4rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--ink); }
  .sources li > span { color: var(--coral); font: 900 1rem/1.2 ui-monospace, monospace; }
  .sources a { color: var(--ink); font: 800 .88rem/1.3 ui-monospace, monospace; }
  .sources li p { margin: .4rem 0 0; max-width: 65rem; font: 500 .72rem/1.45 ui-monospace, monospace; }

  .next { padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 5vw, 5rem); border-top: 2px solid var(--ink); background: var(--lime); }
  .next > div:first-child { display: flex; justify-content: space-between; font: 800 .68rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .next h2 { max-width: 75rem; margin-top: 4rem; }
  .next > p { max-width: 50rem; font: 500 1.2rem/1.5 Georgia, serif; }
  .next__actions { display: flex; gap: 1rem; margin-top: 3rem; }
  .next__actions button, .next__actions a { border: 2px solid var(--ink); padding: .8rem 1rem; color: inherit; background: transparent; font: 800 .7rem/1 ui-monospace, monospace; text-transform: uppercase; text-decoration: none; cursor: pointer; }
  .next__actions button:hover, .next__actions a:hover { color: var(--cream); background: var(--ink); }
  .next small { display: block; min-height: 1.2rem; margin-top: .8rem; font: 700 .68rem/1 ui-monospace, monospace; }

  @media (max-width: 900px) {
    .cover__nav { grid-template-columns: 1fr auto; }
    .cover__nav > :nth-child(2), .cover__nav > :nth-child(3) { display: none; }
    .cover__title { top: 25%; width: 90%; }
    .cover__stamp { display: none; }
    .opening, .essay, .closing { grid-template-columns: 1fr; }
    .opening__rail { flex-direction: row; flex-wrap: wrap; }
    .opening__thesis { max-width: 26rem; }
    .signal-board header { display: block; }
    .signal-board__grid { grid-template-columns: 1fr; }
    .signal-board__grid article { min-height: auto; border: 0; border-bottom: 2px solid currentColor; }
    .signal-board__grid article:last-child { border: 0; }
    .signal-board__grid h3 { margin-top: 2.5rem; }
    .essay__number { position: absolute; right: 1rem; top: 2.5rem; opacity: .18; }
    .label-desk header, .flavor-lab > header, .sources header { grid-template-columns: 1fr; }
    .label-desk > div, .flavor-lab__controls { grid-template-columns: 1fr 1fr; }
    .label-desk article:nth-child(2) { border-right: 0; }
    .label-desk article { border-bottom: 2px solid var(--ink); }
    .flavor-lab fieldset:nth-child(2) { border-right: 0; }
    .flavor-lab fieldset { border-bottom: 2px solid var(--cream); }
    .fridge-sheet { grid-template-columns: 1fr; }
    .fridge-sheet button { grid-column: 1; }
    .closing { padding: 4rem 1.25rem; }
    .closing__mark { width: 9rem; }
    .closing__last { text-align: right; }
  }

  @media (max-width: 560px) {
    .cover h1 { font-size: clamp(4.7rem, 25vw, 7rem); }
    .cover__issue { top: 4rem; transform: scale(.8) rotate(2deg); transform-origin: top right; }
    .cover__title { left: 1rem; }
    .cover__dek { max-width: 90%; }
    .cover__crack { left: 1rem; bottom: 5.5rem; }
    .cover__caption { max-width: 70%; font-size: .58rem; }
    .label-desk > div, .flavor-lab__controls { grid-template-columns: 1fr; }
    .label-desk article, .flavor-lab fieldset { border-right: 0; }
    .next__actions { align-items: stretch; flex-direction: column; }
    .next__actions a, .next__actions button { text-align: center; }
    .plate--aroma > span { top: 1rem; }
