  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .reading-progress { display: none; }
  }

  @media print {
    :global(body) * { visibility: hidden !important; }
    .fridge-sheet, .fridge-sheet * { visibility: visible !important; }
    .fridge-sheet {
      position: absolute;
      inset: 0;
      display: block;
      color: #000;
      background: #fff;
    }
    .fridge-sheet button { display: none; }
    .fridge-sheet ol { margin-top: 2rem; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-lacroix-issue]');
  const progress = root?.querySelector<HTMLElement>('[data-reading-progress]');

  const updateProgress = () => {
    if (!root || !progress) return;
    const max = root.scrollHeight - window.innerHeight;
    const value = max > 0 ? Math.min(1, Math.max(0, (window.scrollY - root.offsetTop) / max)) : 0;
    progress.style.width = `${value * 100}%`;
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);

  const crackButton = root?.querySelector<HTMLButtonElement>('[data-crack]');
  const crackStatus = root?.querySelector<HTMLElement>('[data-crack-status]');
  crackButton?.addEventListener('click', async () => {
    const AudioContextCtor = window.AudioContext
      || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!AudioContextCtor) {
      if (crackStatus) crackStatus.textContent = 'The can opened silently. Still counts.';
      return;
    }
    const context = new AudioContextCtor();
    await context.resume();
    const now = context.currentTime;
    const length = Math.floor(context.sampleRate * .55);
    const buffer = context.createBuffer(1, length, context.sampleRate);
    const channel = buffer.getChannelData(0);
    for (let index = 0; index < length; index += 1) {
      const time = index / context.sampleRate;
      const snap = time < .035 ? (Math.random() * 2 - 1) * (1 - time / .035) : 0;
      const hiss = (Math.random() * 2 - 1) * Math.exp(-time * 8.5) * .38;
      channel[index] = snap + hiss;
    }
    const source = context.createBufferSource();
    const filter = context.createBiquadFilter();
    const gain = context.createGain();
    source.buffer = buffer;
    filter.type = 'highpass';
    filter.frequency.setValueAtTime(1100, now);
    gain.gain.setValueAtTime(.0001, now);
    gain.gain.exponentialRampToValueAtTime(.32, now + .008);
    gain.gain.exponentialRampToValueAtTime(.0001, now + .55);
    source.connect(filter).connect(gain).connect(context.destination);
    source.start(now);
    source.stop(now + .56);
    if (crackStatus) crackStatus.textContent = 'Pressure became sound. The issue is open.';
    crackButton.animate(
      [
        { transform: 'translateY(0)' },
        { transform: 'translateY(-5px) rotate(-1deg)' },
        { transform: 'translateY(0)' },
      ],
      { duration: 260, easing: 'cubic-bezier(.2,.8,.2,1)' },
    );
    window.setTimeout(() => void context.close(), 800);
  });

  const selections: Record<string, string> = {
    temperature: 'cool',
    bubble: 'bright',
    aroma: 'lime leaf',
    setting: 'after a walk',
  };
  const result = root?.querySelector<HTMLElement>('[data-flavor-result]');
  const code = root?.querySelector<HTMLElement>('[data-flavor-code]');
  root?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.choice;
      const value = button.dataset.value;
      if (!key || !value) return;
      selections[key] = value;
      root.querySelectorAll<HTMLButtonElement>(`[data-choice="${key}"]`).forEach((peer) => {
        peer.setAttribute('aria-pressed', String(peer === button));
      });
      if (result) {
        const aroma = selections.aroma === 'no clue' ? 'no aromatic clue' : `${selections.aroma} static`;
        result.textContent =
          `${selections.temperature[0].toUpperCase()}${selections.temperature.slice(1)} water with `
          + `${selections.bubble} bubbles, ${aroma}, opened ${selections.setting}.`;
      }
      if (code) {
        code.textContent =
          `${selections.temperature} / ${selections.bubble} / ${selections.aroma} / ${selections.setting}`.toUpperCase();
      }
    });
  });

  root?.querySelector<HTMLButtonElement>('[data-print-field-sheet]')?.addEventListener('click', () => {
    window.print();
  });

  const copyButton = root?.querySelector<HTMLButtonElement>('[data-copy-issue]');
  const copyStatus = root?.querySelector<HTMLElement>('[data-copy-status]');
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('https://pointcast.xyz/noticing/why-lacroix');
      if (copyStatus) copyStatus.textContent = 'Issue 02 link copied.';
    } catch {
      if (copyStatus) copyStatus.textContent = 'Copy failed—use the address bar.';
    }
  });
</script>
