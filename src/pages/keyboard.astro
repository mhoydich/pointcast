---
// /keyboard — Keyboard Bloom front door. The page itself is playable: type
// anything and it answers in C-major pentatonic with blooming letters. Four
// doors (Play, Rooms, Write, Games) plus the shelf of small instruments.
// Old take links (/keyboard?t=…) still forward to /keyboard/play.
// The notebook that used to live here moved to /keyboard/notes.
// Built 2026-09-26 by Claude (Cowork) on a brief from Mike.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Keyboard Bloom · PointCast</title>
<meta name="description" content="The whole computer keyboard is an instrument. Play it, play it with friends in Bloom Rooms, write with it, or play games on it.">
<link rel="canonical" href="https://pointcast.xyz/keyboard">
<meta property="og:title" content="Keyboard Bloom">
<meta property="og:description" content="The whole keyboard is an instrument. Type anything and it sings.">
<meta property="og:url" content="https://pointcast.xyz/keyboard">
<meta property="og:image" content="https://pointcast.xyz/keyboard/rooms-og.webp">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script is:inline>if(new URLSearchParams(location.search).has('t')){location.replace('/keyboard/play'+location.search+location.hash);}</script>
<style is:inline>
:root{color-scheme:dark;--bg:#0b1412;--panel:#111d19;--panel2:#15241f;--line:#263a32;--ink:#e6ede4;--dim:#93aa9f;--faint:#4d6559;--gold:#e6c98a;--rose:#f0a3b5;--sky:#8fc8f0;--mint:#9fe0c0;--lilac:#c6b2f2;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink)}
body{min-height:100vh;background:radial-gradient(ellipse at 80% -10%,#2b3d3355,transparent 50%),radial-gradient(ellipse at 0% 40%,#3a2e4a33,transparent 45%),var(--bg)}
a{color:inherit}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px clamp(16px,4vw,40px);border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:28px;letter-spacing:-.5px}
.brand:before{content:'✳';color:var(--gold);margin-right:10px}
.brand em{color:var(--gold)}
nav{display:flex;gap:2px;flex-wrap:wrap;font-size:11px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}
nav a:hover,nav a:focus-visible{color:var(--ink);background:var(--panel2)}
nav a.new:after{content:'new';font-size:8px;letter-spacing:.12em;color:var(--bg);background:var(--gold);border-radius:8px;padding:1px 5px;margin-left:6px;vertical-align:2px}
main{max-width:1180px;margin:0 auto;padding:0 clamp(16px,4vw,40px) 60px}
.hero{position:relative;margin:28px 0 30px;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:linear-gradient(180deg,#0e1a16,#0b1412);min-height:340px;cursor:text;outline:none}
.hero:focus-visible{border-color:var(--gold)}
#field{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-copy{position:relative;z-index:1;padding:clamp(22px,5vw,48px);pointer-events:none;max-width:720px}
.hero h2{margin:0 0 12px;font-family:Georgia,serif;font-weight:normal;font-size:clamp(34px,6vw,62px);line-height:1.02;letter-spacing:-1.5px}
.hero h2 em{color:var(--gold)}
.hero p{margin:0;color:var(--dim);font-size:13px;line-height:1.7;max-width:520px}
.hint{position:absolute;z-index:1;left:clamp(22px,5vw,48px);bottom:22px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:11px;color:var(--dim);pointer-events:none}
.hint kbd{display:inline-block;min-width:26px;text-align:center;padding:5px 7px;border:1px solid var(--line);border-bottom-width:3px;border-radius:7px;background:var(--panel);color:var(--ink);font:inherit}
.live{position:absolute;z-index:1;right:22px;top:20px;text-align:right;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);pointer-events:none}
.live b{display:block;font-size:26px;letter-spacing:-.5px;color:var(--gold);font-weight:500;text-transform:none;font-family:Georgia,serif}
.live i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--mint);margin-right:6px;box-shadow:0 0 10px var(--mint);animation:pulse 2s infinite}
@keyframes pulse{50%{opacity:.35}}
.typed{position:absolute;z-index:1;right:22px;bottom:22px;max-width:46%;text-align:right;font-family:Georgia,serif;font-size:18px;color:var(--ink);opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:clip;pointer-events:none;direction:rtl}
.typed span{direction:ltr;unicode-bidi:embed}
.doors{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.door{position:relative;display:flex;flex-direction:column;gap:10px;padding:22px 20px 18px;border:1px solid var(--line);border-radius:18px;background:var(--panel);text-decoration:none;min-height:230px;transition:transform .18s,border-color .18s,background .18s}
.door:hover,.door:focus-visible{transform:translateY(-3px);border-color:var(--c);background:var(--panel2);outline:none}
.door .mark{font-size:26px;color:var(--c)}
.door h3{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:28px;letter-spacing:-.5px}
.door p{margin:0;color:var(--dim);font-size:12px;line-height:1.65;flex:1}
.door .go{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--c)}
.door .badge{position:absolute;top:16px;right:16px;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--bg);background:var(--c);border-radius:10px;padding:3px 8px}
.subs{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
.subs a{font-size:10px;color:var(--dim);text-decoration:none;border:1px solid var(--line);border-radius:14px;padding:4px 9px}
.subs a:hover{color:var(--ink);border-color:var(--c)}
section.shelf{margin-top:34px;border-top:1px solid var(--line);padding-top:24px}
.shelf-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.shelf-head h4{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:22px}
.shelf-head span{color:var(--dim);font-size:11px}
.shelf-head a{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);text-decoration:none}
.chips{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.chip{display:flex;gap:10px;align-items:flex-start;padding:12px 13px;border:1px solid var(--line);border-radius:14px;text-decoration:none;background:#0f1a17}
.chip:hover,.chip:focus-visible{border-color:var(--gold);outline:none}
.chip b{display:block;font-weight:500;font-size:12px;margin-bottom:3px}
.chip small{color:var(--dim);font-size:10px;line-height:1.5}
.chip .m{color:var(--gold);font-size:16px;width:20px;flex:none;text-align:center}
footer{margin-top:40px;color:var(--faint);font-size:11px;display:flex;gap:14px;flex-wrap:wrap}
footer a{color:var(--dim)}
@media (max-width:980px){.doors{grid-template-columns:repeat(2,1fr)}.chips{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.doors{grid-template-columns:1fr}.door{min-height:0}.hero{min-height:380px}.typed{display:none}.live{top:auto;bottom:62px;left:22px;right:auto;text-align:left}}
@media (prefers-reduced-motion:reduce){.door{transition:none}.live i{animation:none}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Keyboard <em>Bloom</em></h1>
  <nav aria-label="Keyboard Bloom">
    <a href="/keyboard/play">Play</a>
    <a href="/keyboard/rooms" class="new">Rooms</a>
    <a href="/keyboard/notes">Write</a>
    <a href="/brick-choir">Arcade</a>
    <a href="/keyboard/shelf">Shelf</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
</header>
<main>
  <div class="hero" id="hero" tabindex="0" aria-label="A playable field: type any key to hear it">
    <canvas id="field" aria-hidden="true"></canvas>
    <div class="hero-copy">
      <h2>The whole keyboard<br>is an <em>instrument.</em></h2>
      <p>Go ahead and type something. This page is listening. Every key is a note, every row is an octave, and nothing sounds wrong.</p>
    </div>
    <div class="live" id="live" hidden><i></i>notes across PointCast<b id="liveN">—</b></div>
    <div class="typed" aria-hidden="true"><span id="typed"></span></div>
    <div class="hint" id="hint"><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><kbd>F</kbd><span id="hintText">type anywhere · tap on a phone</span></div>
  </div>

  <div class="doors">
    <a class="door" href="/keyboard/play" style="--c:var(--gold)">
      <span class="mark">♫</span>
      <h3>Play</h3>
      <p>The instrument. Play over whatever song is on, record a take, pin it to the wall with a Spotify or YouTube link.</p>
      <span class="go">Open the instrument →</span>
    </a>
    <a class="door" href="/keyboard/rooms" style="--c:var(--rose)">
      <span class="badge">new</span>
      <span class="mark">✺</span>
      <h3>Rooms</h3>
      <p>Play together from anywhere, locked to one key and tempo. Talk in music, sing the Chorus, bloom one shared sculpture.</p>
      <span class="go">Start a room →</span>
    </a>
    <div class="door" style="--c:var(--sky)">
      <span class="mark">✎</span>
      <h3><a href="/keyboard/notes" style="text-decoration:none">Write</a></h3>
      <p>Writing that makes music. Your words stay in your browser or in the link.</p>
      <div class="subs"><a href="/keyboard/notes">Notes</a><a href="/keyboard/diary">Key Diary</a><a href="/keyboard/letter">Key Letter</a><a href="/keyboard/studio">Sol Studio</a><a href="/keyboard/garden">Garden</a></div>
    </div>
    <div class="door" style="--c:var(--mint)">
      <span class="mark">◇</span>
      <h3><a href="/brick-choir" style="text-decoration:none">Games</a></h3>
      <p>The Brick Choir arcade, games for four on one keyboard, and practice that sounds good when you play well.</p>
      <div class="subs"><a href="/brick-choir">Brick Choir</a><a href="/keyboard-garden">Garden</a><a href="/keyboard-quartet">Quartet</a><a href="/keyboard-rush">Rush</a><a href="/keyboard/typist">Typist</a></div>
    </div>
  </div>

  <section class="shelf" aria-label="Small instruments">
    <div class="shelf-head">
      <div><h4>Small instruments</h4> <span>one idea each, all tuned to the town's key</span></div>
      <a href="/keyboard/shelf">The whole shelf →</a>
    </div>
    <div class="chips">
      <a class="chip" href="/keyboard/clock"><span class="m">◷</span><span><b>Key Clock</b><small>the time, as a melody</small></span></a>
      <a class="chip" href="/keyboard/radio"><span class="m">◉</span><span><b>Town Radio</b><small>everyone's notes, live</small></span></a>
      <a class="chip" href="/keyboard/loops"><span class="m">∞</span><span><b>Loop Porch</b><small>four-track home-row looper</small></span></a>
      <a class="chip" href="/keyboard/name"><span class="m">✎</span><span><b>Name Song</b><small>a name, as a song</small></span></a>
      <a class="chip" href="/keyboard/ear"><span class="m">♪</span><span><b>Ear Trail</b><small>hear it, play it back</small></span></a>
      <a class="chip" href="/keyboard/weather"><span class="m">☁</span><span><b>Weather Keys</b><small>El Segundo, as music</small></span></a>
      <a class="chip" href="/keyboard/morse"><span class="m">·–</span><span><b>Morse Melody</b><small>Morse that sounds like a tune</small></span></a>
      <a class="chip" href="/keyboard/poems"><span class="m">❦</span><span><b>Poem Organ</b><small>poems, line by line</small></span></a>
      <a class="chip" href="/keyboard/kids"><span class="m">☺</span><span><b>Baby Keys</b><small>a smash pad for toddlers</small></span></a>
      <a class="chip" href="/keyboard-signal"><span class="m">✳</span><span><b>Signal</b><small>every note, one counter</small></span></a>
    </div>
  </section>

  <footer><span>Keyboard Bloom</span><a href="/keyboard/shelf">Shelf</a><a href="/brick-choir">Brick Choir</a><a href="/">PointCast</a></footer>
</main>

<script is:inline>
(() => {
  const hero = document.getElementById('hero');
  const cv = document.getElementById('field');
  const ctx2 = cv.getContext('2d');
  const typedEl = document.getElementById('typed');
  const hintText = document.getElementById('hintText');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const COLORS = ['#e6c98a', '#f0a3b5', '#8fc8f0', '#9fe0c0', '#c6b2f2'];
  const ROWS = ['1234567890-=', 'qwertyuiop[]', 'asdfghjkl;\'', 'zxcvbnm,./'];
  const PENTA = [0, 2, 4, 7, 9];
  let W = 0, H = 0, DPR = 1;
  const blooms = [];
  let typed = '';

  function resize() {
    DPR = Math.min(2, window.devicePixelRatio || 1);
    const r = hero.getBoundingClientRect();
    W = r.width; H = r.height;
    cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
    ctx2.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  addEventListener('resize', resize); resize();

  // ---------- audio ----------
  let ac = null, master = null, verb = null;
  function audio() {
    if (ac) { if (ac.state === 'suspended') ac.resume(); return ac; }
    const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return null;
    ac = new AC();
    master = ac.createDynamicsCompressor();
    master.threshold.value = -16; master.ratio.value = 6;
    const out = ac.createGain(); out.gain.value = 0.8;
    master.connect(out); out.connect(ac.destination);
    // small feedback-delay "room"
    const d = ac.createDelay(1); d.delayTime.value = 0.23;
    const fb = ac.createGain(); fb.gain.value = 0.32;
    const lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 2400;
    verb = ac.createGain(); verb.gain.value = 0.28;
    verb.connect(d); d.connect(lp); lp.connect(fb); fb.connect(d); lp.connect(master);
    hintText.textContent = 'sound on · keep typing';
    return ac;
  }
  function note(row, col) {
    const a = audio(); if (!a) return;
    const deg = PENTA[col % 5] + 12 * Math.floor(col / 5);
    const midi = 48 + (3 - row) * 12 + deg;
    const f = 440 * Math.pow(2, (midi - 69) / 12);
    const t = a.currentTime;
    const g = a.createGain();
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(0.22, t + 0.006);
    g.gain.exponentialRampToValueAtTime(0.0008, t + 1.6);
    // FM bell: carrier + modulator
    const car = a.createOscillator(); car.type = 'sine'; car.frequency.value = f;
    const mod = a.createOscillator(); mod.type = 'sine'; mod.frequency.value = f * 2.001;
    const mg = a.createGain();
    mg.gain.setValueAtTime(f * 1.4, t); mg.gain.exponentialRampToValueAtTime(f * 0.05, t + 0.9);
    mod.connect(mg); mg.connect(car.frequency);
    const tri = a.createOscillator(); tri.type = 'triangle'; tri.frequency.value = f / 2;
    const tg = a.createGain(); tg.gain.value = 0.25;
    tri.connect(tg); tg.connect(g);
    car.connect(g); g.connect(master); g.connect(verb);
    [car, mod, tri].forEach(o => { o.start(t); o.stop(t + 1.7); });
  }

  // ---------- blooms ----------
  function bloom(ch, row, col) {
    const x = W * (0.08 + 0.84 * ((col + row * 0.5) / 12.5));
    const y = H * (0.28 + 0.16 * row) + (Math.random() - 0.5) * 30;
    blooms.push({ ch, x, y, c: COLORS[(col + row) % COLORS.length], born: performance.now(), petals: 5 + (col % 3), rot: Math.random() * 6.28 });
    if (blooms.length > 90) blooms.shift();
    if (reduce) draw();
  }
  function draw() {
    const now = performance.now();
    ctx2.clearRect(0, 0, W, H);
    for (let i = blooms.length - 1; i >= 0; i--) {
      const b = blooms[i];
      const age = (now - b.born) / 1000;
      const life = 3.2;
      if (age > life) { blooms.splice(i, 1); continue; }
      const k = age / life;
      const open = Math.min(1, age * 3.2);
      const r = 10 + 34 * open;
      const alpha = (1 - k) * (1 - k);
      ctx2.save();
      ctx2.translate(b.x, b.y - age * 14);
      ctx2.rotate(b.rot + age * 0.4);
      ctx2.globalAlpha = alpha * 0.55;
      ctx2.fillStyle = b.c;
      for (let p = 0; p < b.petals; p++) {
        ctx2.rotate(6.283 / b.petals);
        ctx2.beginPath();
        ctx2.ellipse(r * 0.55, 0, r * 0.5, r * 0.2, 0, 0, 6.283);
        ctx2.fill();
      }
      ctx2.globalAlpha = alpha;
      ctx2.rotate(-(b.rot + age * 0.4));
      ctx2.fillStyle = '#0b1412';
      ctx2.beginPath(); ctx2.arc(0, 0, 11 * open + 2, 0, 6.283); ctx2.fill();
      ctx2.fillStyle = b.c;
      ctx2.font = '600 ' + Math.round(13 + 5 * open) + 'px ui-monospace,Menlo,monospace';
      ctx2.textAlign = 'center'; ctx2.textBaseline = 'middle';
      ctx2.fillText(b.ch.toUpperCase(), 0, 1);
      ctx2.restore();
    }
  }
  function loop() { draw(); requestAnimationFrame(loop); }
  if (!reduce) requestAnimationFrame(loop);

  function play(ch) {
    const c = ch.toLowerCase();
    for (let r = 0; r < ROWS.length; r++) {
      const col = ROWS[r].indexOf(c);
      if (col >= 0) { note(r, col); bloom(ch, r, col); return true; }
    }
    if (ch === ' ') { note(2, 0); return true; }
    return false;
  }

  addEventListener('keydown', e => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const tag = (document.activeElement && document.activeElement.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key === 'Backspace') { typed = typed.slice(0, -1); typedEl.textContent = typed; return; }
    if (e.key.length !== 1 || e.repeat) return;
    if (play(e.key)) {
      if (e.key === ' ') e.preventDefault();
      typed = (typed + e.key).slice(-48);
      typedEl.textContent = typed;
    }
  });

  // touch / click: position → row + column
  hero.addEventListener('pointerdown', e => {
    const r = hero.getBoundingClientRect();
    const row = Math.max(0, Math.min(3, Math.floor(((e.clientY - r.top) / r.height) * 4)));
    const col = Math.max(0, Math.min(ROWS[row].length - 1, Math.floor(((e.clientX - r.left) / r.width) * ROWS[row].length)));
    note(row, col); bloom(ROWS[row][col], row, col);
  });

  // ---------- live counter from the town signal ----------
  const live = document.getElementById('live'), liveN = document.getElementById('liveN');
  async function signal() {
    try {
      const r = await fetch('/api/keyboard/signal', { headers: { accept: 'application/json' } });
      if (!r.ok) return;
      const j = await r.json();
      if (typeof j.globalTotal === 'number') { liveN.textContent = j.globalTotal.toLocaleString(); live.hidden = false; }
    } catch (e) {}
  }
  signal(); setInterval(() => { if (!document.hidden) signal(); }, 30000);
})();
</script>
</body>
</html>
