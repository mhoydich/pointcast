---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Bell & Signal';
const description =
  'The PointCast door into Bell & Signal, a small sound foundry in El Segundo. Castings in code — bells, breaths, signals, blooms, thuds, and drones, every one born live. No samples.';
const pageUrl = 'https://pointcast.xyz/bell-and-signal';
const FOUNDRY_URL = 'https://bell-and-signal.pages.dev';

const LAW = [
  ['I', 'No samples', 'every sound is born live, from code'],
  ['II', 'Pink, not white', 'all chance follows 1/f'],
  ['III', 'Stretched partials', 'bells are 2–4% inharmonic, like real metal'],
  ['IV', 'The first 50 ms', 'identity lives in the attack'],
  ['V', 'Pentatonic default', 'no accidental roughness, ever'],
  ['VI', 'Bells are wet, signals are dry', 'devotion gets the room; utility gets none'],
  ['VII', 'The quiet floor', 'cues are short, soft, and never stack'],
  ['VIII', 'Silence is a material', 'every surface keeps a rest state'],
] as const;

const CATALOG = [
  ['BEL-01', 'Vesper', 'a small evening bell on D5'],
  ['BEL-02', 'Meridian', 'the working bell — hum, prime, and tierce'],
  ['BEL-03', 'Bourdon', 'the great bell, eleven seconds to silence'],
  ['BEL-04', 'Faraway', 'a bell from some other tower, mostly room'],
  ['RIT-01', 'Angelus', 'three threes on the bourdon'],
  ['RIT-02', 'Rounds', 'change-ringing on five bells, three rounds down'],
  ['BRE-01', 'Tide', 'seven seconds of pink-noise breath'],
  ['BRE-02', 'Offshore', 'the wind off the water, gusting as it pleases'],
  ['SIG-01', 'Tap', 'one dry touch, the stamp on paper'],
  ['SIG-02', 'Assent', 'the machine says yes'],
  ['SIG-03', 'Demur', 'the machine says no, kindly'],
  ['SIG-04', 'Knock', 'two soft knocks at the door'],
  ['BLM-01', 'Laurel', 'a pentatonic bloom for the win'],
  ['BLM-02', 'Penny', 'a coin for the games, gone in a blink'],
  ['THD-01', 'Setback', 'a soft landing, not a punishment'],
  ['TIK-01', 'Pendulum', 'tick and tock at sixty beats, left and right'],
  ['DRN-01', 'Ground', 'D2 and A2 under a slow pink drift'],
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl,
  name: title,
  description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  sameAs: FOUNDRY_URL,
  hasPart: CATALOG.map(([id, name, note]) => ({
    '@type': 'CreativeWork',
    identifier: id,
    name,
    description: note,
    url: FOUNDRY_URL,
    license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  })),
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="foundry">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span>/</span><span>bell &amp; signal</span><a href="/b/0479">BLOCK 0479</a></nav>

    <header class="hero">
      <div>
        <p class="kicker">POINTCAST · SATELLITE · A SMALL SOUND FOUNDRY</p>
        <h1>The town has a foundry now.</h1>
        <p class="dek">
          Bell &amp; Signal casts small sounds in code — bells for devotion, blooms and thuds for play,
          taps for polite machinery. No samples anywhere in the building: every sound is born live,
          in the browser, the moment you hear it.
        </p>
        <div class="actions">
          <a class="primary" href={FOUNDRY_URL}>Visit the foundry ↗</a>
          <button id="strike" type="button">Strike the working bell</button>
        </div>
      </div>
      <div class="tower" aria-hidden="true">
        <img src="/images/foundry/bell-and-signal.svg" alt="" width="1200" height="675" loading="lazy" />
      </div>
    </header>

    <section class="law" aria-label="The Foundry Law">
      <p class="kicker">THE FOUNDRY LAW · EIGHT ARTICLES</p>
      <div class="law__grid">
        {LAW.map(([num, name, note]) => (
          <div class="article"><small>{num}</small><strong>{name}.</strong><span>{note}.</span></div>
        ))}
      </div>
    </section>

    <section class="catalog" aria-label="Catalog No. 1">
      <p class="kicker">CATALOG No. 1 · SEVENTEEN CASTINGS · ALL CC0</p>
      <div class="rows">
        {CATALOG.map(([id, name, note]) => (
          <a class="row" href={FOUNDRY_URL}>
            <small>{id}</small><strong>{name}</strong><span>{note}</span><b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
      <p class="colophon">
        Cast in El Segundo. The bells are voiced the way towers voice them — hum, prime, tierce,
        quint, nominal — and every partial is a detuned pair, so they beat slowly like real metal.
        Take them, recast them, hang them in your own tower.
      </p>
    </section>
  </main>
</BlockLayout>

<script>
  // One casting from the foundry, inlined: BEL-02 Meridian, the working bell.
  // Church profile — hum, prime, tierce, quint, nominal — with beating pairs
  // and a synthesized room. Law VI: bells are wet.
  let ctx: AudioContext | null = null;
  let master: GainNode, wet: GainNode;

  function ensure() {
    if (ctx) { if (ctx.state === 'suspended') ctx.resume(); return; }
    ctx = new AudioContext();
    master = ctx.createGain();
    master.gain.value = 0.6;
    const comp = ctx.createDynamicsCompressor();
    master.connect(comp); comp.connect(ctx.destination);
    const seconds = 3, rate = ctx.sampleRate, len = Math.floor(rate * seconds);
    const ir = ctx.createBuffer(2, len, rate);
    for (let c = 0; c < 2; c++) {
      const d = ir.getChannelData(c);
      let lp = 0;
      for (let i = 0; i < len; i++) {
        const t = i / len;
        const k = 0.028 - 0.024 * t;
        lp = (1 - k) * lp + k * (Math.random() * 2 - 1);
        d[i] = lp * 7 * Math.pow(1 - t, 2.2);
      }
    }
    const verb = ctx.createConvolver();
    verb.buffer = ir;
    wet = ctx.createGain();
    wet.gain.value = 0.5;
    wet.connect(verb); verb.connect(master);
  }

  const CHURCH: Array<[number, number, number]> = [
    [0.5, 0.55, 1.65], [1.0, 1.0, 1.0], [1.19, 0.64, 0.78],
    [1.5, 0.34, 0.58], [2.0, 0.5, 0.46], [2.66, 0.24, 0.32],
  ];

  function meridian() {
    ensure();
    if (!ctx) return;
    const f0 = 293.66, dur = 5.5, when = ctx.currentTime;
    const out = ctx.createGain();
    out.gain.value = 0.5;
    out.connect(master);
    const send = ctx.createGain();
    send.gain.value = 0.8;
    out.connect(send); send.connect(wet);
    for (let n = 0; n < CHURCH.length; n++) {
      const [ratio, amp, dmul] = CHURCH[n];
      const decay = dur * dmul;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0, when);
      g.gain.linearRampToValueAtTime(amp, when + 0.003 + n * 0.002);
      g.gain.exponentialRampToValueAtTime(amp * 0.28, when + decay * 0.3);
      g.gain.exponentialRampToValueAtTime(0.0001, when + decay);
      g.connect(out);
      const beat = 0.0011;
      for (let s = -1; s <= 1; s += 2) {
        const osc = ctx.createOscillator();
        osc.type = 'sine';
        osc.frequency.value = f0 * ratio * (1 + s * beat);
        const half = ctx.createGain();
        half.gain.value = 0.5;
        osc.connect(half); half.connect(g);
        osc.start(when); osc.stop(when + decay + 0.1);
      }
    }
  }

  document.getElementById('strike')?.addEventListener('click', meridian);
</script>

<style>
  .foundry{--ink:#101018;--paper:#f2ead9;--gold:#c4a35a;--amber:#ff9b2f;--line:rgba(242,234,217,.2);background:var(--ink);color:var(--paper);min-height:100vh;padding:20px max(18px,calc((100vw - 1180px)/2)) 100px}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 20px;border-bottom:1px solid var(--line);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.11em}
  .crumb a{color:var(--paper)}.crumb a:last-child{margin-left:auto;color:var(--gold)}
  .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:5vw;align-items:center;padding:70px 0;border-bottom:1px solid var(--line)}
  .kicker{margin:0 0 16px;font:700 10px var(--pc-font-mono);letter-spacing:.15em;text-transform:uppercase;color:var(--gold)}
  .hero h1{margin:0;font-family:Georgia,serif;font-weight:400;letter-spacing:-.04em;font-size:clamp(44px,6vw,84px);line-height:.92}
  .dek{max-width:560px;margin:24px 0;font:18px/1.55 Georgia,serif;color:rgba(242,234,217,.85)}
  .actions{display:flex;gap:10px;flex-wrap:wrap}
  .actions a,.actions button{padding:12px 15px;border:1px solid var(--paper);background:none;color:var(--paper);font:700 10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em;cursor:pointer}
  .actions .primary{background:var(--paper);color:var(--ink)}
  .actions a:hover,.actions button:hover{background:var(--amber);border-color:var(--amber);color:var(--ink);text-decoration:none}
  .actions button:active{transform:scale(.96)}
  .tower img{width:100%;height:auto;border:1px solid var(--line)}
  .law{padding:70px 0;border-bottom:1px solid var(--line)}
  .law__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
  .article{background:var(--ink);padding:16px}
  .article small{display:block;font:10px var(--pc-font-mono);color:var(--amber);margin-bottom:6px}
  .article strong{display:block;font:20px Georgia,serif;font-weight:400;margin-bottom:4px}
  .article span{font-size:13px;color:rgba(242,234,217,.6)}
  .catalog{padding:70px 0}
  .rows{border-top:1px solid var(--paper)}
  .row{display:grid;grid-template-columns:90px 180px 1fr 24px;align-items:center;min-height:58px;border-bottom:1px solid var(--line);color:var(--paper)}
  .row:hover{background:rgba(242,234,217,.06);text-decoration:none}
  .row small{font:10px var(--pc-font-mono);color:var(--gold);letter-spacing:.1em}
  .row strong{font:22px Georgia,serif;font-weight:400}
  .row span{font-size:13px;color:rgba(242,234,217,.6)}
  .colophon{max-width:640px;margin:40px 0 0;font:16px/1.6 Georgia,serif;color:rgba(242,234,217,.7)}
  @media(max-width:820px){.hero{grid-template-columns:1fr;padding:50px 0}.row{grid-template-columns:70px 1fr 20px}.row span{display:none}}
</style>
