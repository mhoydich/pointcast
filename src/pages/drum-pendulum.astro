---
/**
 * /drum-pendulum — a brass pendulum bell.
 *
 * Mike 2026-05-02 afternoon: "ok keep going, run over next hour".
 * Sibling to /drum-bell-fall (kinetic field) and /drum-bell-jar
 * (contained shake). This one is meditative — a single brass bell
 * swings on a long rope; each apex strikes a hidden chime against
 * a fixed metal post and rings.
 *
 * Click anywhere on the velvet field to give the pendulum a push.
 * Larger pushes = wider swings = lower pitches (bigger bell, less
 * tension). Smaller pushes = tighter swings = higher pitches.
 * Energy decays naturally over ~30 seconds.
 *
 * Counters: total swings, total rings, longest swing arc seen.
 * localStorage'd. Pure static, no API.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Pendulum · Brass Bell on a Rope · PointCast';
const description =
  'A single brass bell swings on a long rope. Click anywhere to push it; each apex rings. Energy decays over 30 seconds. Meditative bell-wing surface.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Pendulum',
  url: 'https://pointcast.xyz/drum-pendulum',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dp" id="dp-main">
    <DrumNav current="pendulum" />

    <header class="dp__header">
      <div class="dp__chrome">
        <span>BRASS BELL</span>
        <span class="dp__chrome-sep">·</span>
        <span>30-SECOND DECAY</span>
        <span class="dp__chrome-sep">·</span>
        <span>CLICK TO PUSH</span>
      </div>
      <h1 class="dp__title">PENDULUM</h1>
      <p class="dp__tagline">a single bell on a long rope, hanging in the dark</p>
    </header>

    <section class="dp__field" id="dp-field" aria-label="Pendulum field — click to push">
      <!-- Pivot beam (decorative) -->
      <div class="dp__beam"></div>
      <div class="dp__pivot"></div>

      <!-- The pendulum itself: positioned absolutely, transforms apply rotation -->
      <div class="dp__arm" id="dp-arm">
        <div class="dp__rope"></div>
        <div class="dp__bell">
          <svg viewBox="0 0 60 70" shape-rendering="crispEdges" aria-hidden="true">
            <!-- bell body -->
            <path d="M 12 14 L 48 14 L 50 56 L 10 56 Z" fill="#d4a437"/>
            <rect x="10" y="56" width="40" height="3" fill="#b8862c"/>
            <rect x="8"  y="59" width="44" height="3" fill="#6b4d12"/>
            <!-- highlight -->
            <rect x="16" y="22" width="2" height="22" fill="#fff5c0" opacity="0.55"/>
            <rect x="20" y="22" width="1" height="14" fill="#fff5c0" opacity="0.35"/>
            <!-- top ring -->
            <rect x="26" y="6"  width="8" height="2" fill="#6b4d12"/>
            <rect x="24" y="8"  width="12" height="6" fill="#b8862c"/>
            <rect x="26" y="10" width="8" height="2" fill="#fff5c0" opacity="0.4"/>
            <!-- clapper visible at bottom -->
            <rect x="29" y="62" width="2" height="6" fill="#3a2410"/>
            <circle cx="30" cy="68" r="2" fill="#3a2410"/>
          </svg>
        </div>
      </div>

      <!-- Strike post (fixed, doesn't move) - lives on left wall, bell strikes it on apex -->
      <div class="dp__post"></div>

      <div class="dp__caption">click anywhere on the velvet to push the pendulum</div>
    </section>

    <footer class="dp__readout">
      <div class="dp__stat">
        <span class="dp__stat-num" id="dp-swings">0</span>
        <span class="dp__stat-label">swings</span>
      </div>
      <div class="dp__stat">
        <span class="dp__stat-num" id="dp-rings">0</span>
        <span class="dp__stat-label">rings</span>
      </div>
      <div class="dp__stat">
        <span class="dp__stat-num" id="dp-arc">0°</span>
        <span class="dp__stat-label">widest arc</span>
      </div>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dp-main) {
    background: #0c0410;
  }

  .dp {
    --dp-velvet: #1a0820;
    --dp-velvet-deep: #0c0410;
    --dp-brass: #d4a437;
    --dp-brass-soft: #b8862c;
    --dp-brass-deep: #6b4d12;
    --dp-flame: #f6c15e;
    --dp-flame-tip: #ff6b3a;
    --dp-ink-light: #f4e7c8;
    --dp-ink-mid: #c9b78c;
    --dp-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 0;
    color: var(--dp-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(212, 164, 55, 0.10), transparent 60%),
      linear-gradient(180deg, var(--dp-velvet) 0%, var(--dp-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
  }
  .dp::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 30px 30px, rgba(212, 164, 55, 0.08) 1.5px, transparent 2px);
    background-size: 130px 130px;
    opacity: 0.4;
    z-index: -1;
  }
  .dp .drum-nav {
    opacity: 0.45;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }

  .dp__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(8px, 1vh, 14px);
    flex-shrink: 0;
  }
  .dp__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 14px;
    border: 1.5px solid var(--dp-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dp-ink-mid);
    background: rgba(0, 0, 0, 0.35);
  }
  .dp__chrome-sep { color: var(--dp-brass-deep); }
  .dp__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(34px, 5.5vw, 76px);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--dp-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--dp-velvet-deep);
  }
  .dp__tagline {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px);
    color: var(--dp-ink-mid);
  }

  /* Field — the click target */
  .dp__field {
    flex: 1;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    min-height: 360px;
  }

  /* Pivot beam — across the top */
  .dp__beam {
    position: absolute;
    top: 18px;
    left: 18%;
    right: 18%;
    height: 12px;
    background: linear-gradient(180deg, #b8862c 0%, #6b4d12 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 245, 192, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.5),
      0 4px 0 rgba(0, 0, 0, 0.4);
  }
  /* small bracket dots on the beam */
  .dp__beam::before, .dp__beam::after {
    content: '';
    position: absolute;
    top: 2px;
    width: 4px; height: 8px;
    background: #fff5c0;
    opacity: 0.5;
  }
  .dp__beam::before { left: 6%; }
  .dp__beam::after  { right: 6%; }

  /* Pivot — the round dark dot the rope hangs from */
  .dp__pivot {
    position: absolute;
    top: 28px;
    left: 50%;
    transform: translateX(-50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #6b4d12 0%, #2a1a08 80%);
    z-index: 2;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.6);
  }

  /* Arm — anchored at the pivot, transforms rotate around its top */
  .dp__arm {
    position: absolute;
    top: 35px;
    left: 50%;
    transform-origin: 50% 0%;
    /* JS sets transform: rotate(...deg) */
    height: clamp(280px, 50vh, 480px);
    width: 4px;
    margin-left: -2px;
    will-change: transform;
  }
  .dp__rope {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, #6b4d12 0%, #b8862c 50%, #d4a437 100%);
    border-radius: 2px;
    box-shadow: 1px 0 0 rgba(0, 0, 0, 0.4);
  }
  .dp__bell {
    position: absolute;
    bottom: -68px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 90px;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 14px rgba(212, 164, 55, 0.18));
  }
  .dp__bell svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .dp__arm.dp__arm--struck .dp__bell {
    animation: dp-bell-flash 0.5s ease-out 1;
  }
  @keyframes dp-bell-flash {
    0%   { filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 14px rgba(212, 164, 55, 0.18)); }
    20%  { filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 32px rgba(246, 193, 94, 0.65)); }
    100% { filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 14px rgba(212, 164, 55, 0.18)); }
  }

  /* Strike post — visual only, doesn't actually collide */
  .dp__post {
    position: absolute;
    bottom: 8%;
    left: 14%;
    width: 8px;
    height: 80px;
    background: linear-gradient(180deg, #b8862c 0%, #6b4d12 100%);
    box-shadow: inset 0 1px 0 rgba(255, 245, 192, 0.35), 2px 0 0 rgba(0, 0, 0, 0.5);
  }
  .dp__post::after {
    content: '';
    position: absolute;
    bottom: 0; left: -4px; right: -4px;
    height: 6px;
    background: #6b4d12;
  }
  @media (max-width: 720px) { .dp__post { display: none; } }

  .dp__caption {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dp-ink-dim);
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Readout */
  .dp__readout {
    display: flex;
    justify-content: center;
    gap: clamp(20px, 3vw, 60px);
    padding: clamp(14px, 2vh, 28px) 0;
    flex-shrink: 0;
  }
  .dp__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .dp__stat-num {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 800;
    color: var(--dp-flame);
    letter-spacing: 0.04em;
    line-height: 1;
    text-shadow: 0 0 12px rgba(246, 193, 94, 0.4);
  }
  .dp__stat-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(9px, 0.8vw, 12px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dp-ink-dim);
  }
</style>

<script>
  // ── Audio ────────────────────────────────────────────
  let actx = null;
  function ctx() {
    if (!actx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      actx = new AC();
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  function playBell(freq, gain = 0.32) {
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = freq;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = freq * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 2.4);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(gain * 0.32, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 2.5); o2.start(t); o2.stop(t + 1.7);
  }

  // ── State ────────────────────────────────────────────
  // Physics: simple damped pendulum.
  // angle = current rotation in radians (0 = down)
  // velocity = rad/s
  // damping = 0.998 per tick at 60fps (slow decay)
  let angle = 0;
  let velocity = 0;
  const GRAVITY = 9.0;        // tuning: visual feel, not real-world
  const LENGTH = 1.0;         // normalized
  const DAMPING = 0.9985;     // per-frame
  const MAX_PUSH_RAD = 0.55;  // ~31° max from a single click
  const STRIKE_THRESHOLD = 0.05; // rad/s, below this we don't ring
  const RING_COOLDOWN_MS = 320; // min ms between rings

  let lastDirection = 0; // sign of velocity, used to detect apex
  let lastRingAt = 0;
  let widestArcDeg = 0;

  const SWINGS_KEY = 'pc:pendulum:swings';
  const RINGS_KEY = 'pc:pendulum:rings';
  const ARC_KEY = 'pc:pendulum:arc';

  let swings = 0;
  let rings = 0;
  try {
    swings = parseInt(localStorage.getItem(SWINGS_KEY) || '0', 10) || 0;
    rings = parseInt(localStorage.getItem(RINGS_KEY) || '0', 10) || 0;
    widestArcDeg = parseFloat(localStorage.getItem(ARC_KEY) || '0') || 0;
  } catch {}

  const armEl = document.getElementById('dp-arm');
  const fieldEl = document.getElementById('dp-field');
  const swingsEl = document.getElementById('dp-swings');
  const ringsEl = document.getElementById('dp-rings');
  const arcEl = document.getElementById('dp-arc');

  function fmt(n) { return n > 9999 ? (n / 1000).toFixed(1) + 'k' : String(n); }
  function paint() {
    if (swingsEl) swingsEl.textContent = fmt(swings);
    if (ringsEl) ringsEl.textContent = fmt(rings);
    if (arcEl) arcEl.textContent = `${Math.round(widestArcDeg)}°`;
  }
  paint();

  // ── Push handler ────────────────────────────────────
  function push(strength) {
    // strength: 0..1, scaled to MAX_PUSH_RAD/s of velocity
    const v = MAX_PUSH_RAD * Math.max(0.15, Math.min(1, strength));
    // Always push in the direction opposite to current angle (toward equilibrium first),
    // unless angle is near zero — then alternate based on current velocity sign.
    const dir = angle === 0
      ? (Math.random() < 0.5 ? -1 : 1)
      : -Math.sign(angle);
    velocity += dir * v;
    swings += 1;
    try { localStorage.setItem(SWINGS_KEY, String(swings)); } catch {}
    paint();
  }

  fieldEl?.addEventListener('click', (e) => {
    // Ignore clicks on the readout/header
    const t = e.target;
    if (t && (t.closest('.dp__readout') || t.closest('.dp__header'))) return;
    // Strength from y-position: lower clicks = stronger pushes (visual metaphor of pulling rope)
    const rect = fieldEl.getBoundingClientRect();
    const y = (e.clientY - rect.top) / rect.height; // 0..1
    push(0.35 + 0.65 * y);
  });

  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && !e.repeat) {
      e.preventDefault();
      push(0.7);
    }
  });

  // ── Physics loop ────────────────────────────────────
  let lastT = performance.now();
  function tick(now) {
    const dt = Math.min(0.05, (now - lastT) / 1000);
    lastT = now;

    // Pendulum equation: a = -(g/L) * sin(angle)
    const accel = -(GRAVITY / LENGTH) * Math.sin(angle);
    velocity += accel * dt;
    velocity *= DAMPING;
    angle += velocity * dt;

    // Snap to rest if very small
    if (Math.abs(angle) < 0.005 && Math.abs(velocity) < 0.005) {
      angle = 0;
      velocity = 0;
    }

    // Detect apex: velocity direction reversed
    const dir = Math.sign(velocity);
    if (dir !== lastDirection && lastDirection !== 0) {
      // Just hit an apex — angle is at a local extreme
      const apexDeg = Math.abs(angle * 180 / Math.PI);
      const apexAbs = Math.abs(angle);
      // Only ring if the apex is meaningful (not just dust drift)
      if (apexAbs > 0.04 && Math.abs(velocity) >= STRIKE_THRESHOLD && now - lastRingAt > RING_COOLDOWN_MS) {
        // Pitch: bigger arc → lower pitch (heavier bell)
        // 0.55 rad apex → 220 Hz. 0.05 rad apex → 880 Hz. Inverse map.
        const norm = Math.min(1, apexAbs / 0.55); // 0..1
        const freq = 880 - norm * 660; // 880..220
        // Gain: stronger on bigger arcs
        const gain = 0.18 + norm * 0.22;
        playBell(freq, gain);
        rings += 1;
        try { localStorage.setItem(RINGS_KEY, String(rings)); } catch {}
        if (apexDeg > widestArcDeg) {
          widestArcDeg = apexDeg;
          try { localStorage.setItem(ARC_KEY, String(widestArcDeg)); } catch {}
        }
        paint();
        // Visual flash on bell
        if (armEl) {
          armEl.classList.add('dp__arm--struck');
          setTimeout(() => armEl.classList.remove('dp__arm--struck'), 480);
        }
        lastRingAt = now;
      }
    }
    if (dir !== 0) lastDirection = dir;

    // Apply transform
    if (armEl) {
      armEl.style.transform = `rotate(${(angle * 180 / Math.PI).toFixed(2)}deg)`;
    }

    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
</script>
