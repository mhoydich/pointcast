---
/**
 * /chain — the PointCast Chain home: pointcast-chain, PointCast's broadcast
 * chain in Rust, organized as a home with wayfinding. Explore (Block Yard,
 * VERIFY, Town Hall, the explorer feed), Build (dev tools), Wallets + First
 * Mints, Art, Roadmap, Learn (case study, intern assignments), what works
 * today, and status with numbers.
 *
 * Plain BlockLayout grammar. Every visual flourish lives inside the Block
 * Yard iframe (public/chain/yard/), a static copy of the explorer built in
 * pointcast-chain with a recorded --dev chain beside it, so the replay and
 * VERIFY run in the visitor's browser with no node behind them.
 *
 * Facts come only from the pointcast-chain repo at main da7bc09 (README,
 * DESIGN.md, docs/V2.md, docs/WALLETS.md, docs/ART_MINTING.md,
 * crates/chain-sim/FINDINGS.md, docs/reviews/*), plus docs/TOWN_NETWORK.md at
 * main 50015e4 (docs only) for the roadmap. Shared numbers live in
 * src/data/chain-home.ts. Filed as block 0660 (cc).
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import ChainHeader from '../components/chain/ChainHeader.astro';
import HomeChainStrip from '../components/HomeChainStrip.astro';
import { CHANNELS } from '../lib/channels';
import { CRATES, DEVNET, SOURCE, TESTS, firstMints, yardStats } from '../data/chain-home';
import '../styles/chain.css';

const BLOCK = '0660';
const URL_SELF = 'https://pointcast.xyz/chain';
const yard = yardStats();
const mints = firstMints();
const title = 'PointCast Chain';
const description =
  'The home of pointcast-chain, a broadcast chain where every block is a PointCast Block. Watch a recorded dev chain in the Block Yard and verify it in your browser, then read the dev tools, the docs, a University of El Segundo case study and ten intern assignments. Built and tested locally; not yet a public network.';
const ch = CHANNELS.FD;

const stats = [
  { value: String(yard.blocks), label: 'Blocks in the yard', note: `A recorded dev chain: ${yard.txs} transactions, ${yard.anchors} anchors, ${yard.accounts} accounts.` },
  { value: `${yard.verifierKiB} KiB`, label: 'Verifier, in your browser', note: 'The consensus code compiled to wasm, pinned by sha256.' },
  { value: String(TESTS.total), label: 'Tests passing', note: `Rust, rollup kernel and JS suites at ${SOURCE.commit}. None failed.` },
  { value: '66% → 10.1%', label: 'Farming, measured', note: 'Sybil share of issuance with room_only plus one tap an hour.' },
];

const explore = [
  {
    k: 'VERIFY · IN YOUR BROWSER',
    title: 'Your browser replays every block.',
    body: `Press ✓ VERIFY in the yard. Your browser downloads the consensus code, ${yard.verifierKiB} KiB of wasm checked against a pinned sha256, and replays every block from genesis in a Web Worker. A stack turns green only when your replay matches. A lie gets a red banner that names the height and an evidence.json anyone can check offline.`,
    links: [{ label: 'Open the yard full screen', href: yard.href }],
  },
  {
    k: 'TOWN HALL · RUNS LOCALLY',
    title: 'A town square that checks its own numbers.',
    body: 'pc-town follows a node over its read-only routes, replays every block with the real verifier, and serves account, channel, room and block pages. Every number it shows comes from its own replay, not the node’s word. A fault with evidence turns the page red and stops indexing. It runs on a laptop today; there is no public Town Hall.',
    links: [{ label: 'Run it', href: '/chain/dev#quickstart' }],
  },
  {
    k: 'THE EXPLORER FEED · RUNS LOCALLY',
    title: 'The chain as a PointCast feed.',
    body: 'Every node serves an explorer at its root: newest blocks first, with transaction cards, anchors linked to TzKT, VERIFY, and a Transmit panel that signs taps, posts and sends with Kukai or Temple. It runs wherever a node runs. The yard above is a static recording of one.',
    links: [{ label: 'HTTP API', href: '/chain/dev#api' }],
  },
  {
    k: 'DAILY NET · PUBLIC DEVNET · NO VALUE',
    title: 'Bots check in. Code agents witness.',
    body: 'Once a UTC day, bots on the public devnet check in and do three small duties, and agents that run code replay the chain from genesis and sign a checkpoint with their own key. A witness is a claim, not proof of replay: “correct” means it agreed with the devnet’s server. Counts are keys, not people.',
    links: [{ label: 'Today’s net', href: '/chain/net' }, { label: 'The Witness lens', href: `${DEVNET.yardHref}&lens=witness` }],
  },
];

const buildCounts = [
  { n: '33', l: 'HTTP routes on the node' },
  { n: '15', l: 'Routes on pc-town' },
  { n: '10', l: 'MCP tools: 6 node, 4 town' },
  { n: '13', l: 'CLI subcommands, plus pc-sim' },
];

const wallets = [
  { k: 'A PASS · NO EXTENSION', title: 'Face ID would be your pass.', body: 'A passkey would become your pass. pointcast-chain would learn a webauthn signing mode and pcp1 addresses for passkey accounts. It can verify the WebAuthn envelope; Tezos L1 tz3 cannot.' },
  { k: 'DEVICE PASSES', title: 'One approval, then quiet.', body: 'A device pass would be a session key that can tap, drum and post for up to 30 days, and can never spend, mint or change keys. Anything permanent would ask every time and say what it does first.' },
  { k: 'ONE PROFILE', title: 'One person, one profile.', body: 'The PointCast account is canonical. Logins, the town card and chain accounts hang off it, and nothing merges automatically. The address-to-person link is shown only when the member opts in.' },
];

type Fact = { n: string; tag: string; claim: string; proof: string; today?: boolean; refs?: { label: string; href: string }[] };
const facts: Fact[] = [
  {
    n: '01', tag: 'VERIFY IN YOUR BROWSER',
    claim: 'Press VERIFY and your browser replays every block from genesis with the chain’s own consensus code.',
    proof: `The code ships as a ${yard.verifierKiB} KiB wasm module that the page checks against a pinned sha256 before it runs. If the sequencer signed something false, a red banner names the height and offers evidence.json, which anyone can check offline. The lying-node demo re-seals a tampered state root at #37, and VERIFY catches it.`,
  },
  {
    n: '02', tag: 'ANCHORED ON TEZOS',
    claim: 'Every 100 blocks the sequencer signs an anchor, and on 2026-10-02 anchors went to Tezos Shadownet as casts on the tez-cast tower.',
    proof: 'Run end to end against the live protocol with a throwaway key. Read back from TzKT: sequencer signature valid, block hash and state root match. Each anchor verifies against the genesis params alone, whoever posted it.',
    refs: [
      { label: 'reveal ooT6hDN…', href: 'https://shadownet.tzkt.io/ooT6hDNcvmz9VZM3hnusexyEgHzAnHoQugCcsm7oCsNqPLBqZc6' },
      { label: 'post @200 opP5W2o…', href: 'https://shadownet.tzkt.io/opP5W2o3s8UQZZjhmUt51nRyTWWuJVwyaZrw6iVxWmaAX2DX3cP' },
      { label: 'node job @100 opVXzWi…', href: 'https://shadownet.tzkt.io/opVXzWiyYEe5E2eumwW8tCarPZwtR6CSyqcG86ETRbaXQzGrSAL' },
    ],
  },
  {
    n: '03', tag: 'GENESIS-BOUND SIGNATURES',
    claim: 'Every signature binds the chain’s genesis hash, so nothing signed for one chain can be replayed on another.',
    proof: 'Transactions, block seals, anchors, attestations and the kernel’s chunk manifests all commit to the hash of the genesis parameters. A review caught the first gap, when transactions bound only the chain id. The Verify Desk found the second: evidence built on one chain checked as valid against another. Now it reads NOT EVIDENCE.',
  },
  {
    n: '04', tag: 'KUKAI AND TEMPLE',
    claim: 'People sign with the Tezos wallets they already have: Kukai or Temple signs one readable line, and the chain rebuilds that line from the transaction itself.',
    proof: 'tz1 and tz2 keys work, including Kukai’s Google sign-in. Text sent by a client is never trusted, and the wallet form signs exact integers or refuses. The test vectors are real Taquito signatures; a live Kukai and a live Temple signature are still to do.',
  },
  {
    n: '05', tag: 'AGENT MANDATES',
    claim: 'An agent’s owner grants it a mandate on chain: which kinds of transaction, which channels and rooms, an allowance and an expiry.',
    proof: 'The allowance spends from the owner’s balance within per-period and total caps. At expiry every transaction from the agent is rejected until the owner re-grants. A rejected transaction changes nothing, not even the nonce, and chains from before mandates replay byte for byte.',
  },
  {
    n: '06', tag: 'ROLLUP KERNEL',
    claim: 'The same state machine runs inside a Tezos smart-rollup kernel and reaches the native state root byte for byte.',
    proof: 'Checked at every inbox level on the SDK’s mock host: 200 blocks with all ten original transaction kinds, plus a 90-block chain with the presence kinds. A review found valid blocks too big for the inbox transport; the ceiling now covers every block chain-core accepts. Lazy storage, the bridge and origination are not done yet.',
  },
  {
    n: '07', tag: 'SIMULATOR = NODE',
    claim: 'The economy simulator drives the unmodified state machine, and a test proves it matches the real node block for block.',
    proof: 'Fed to the real node, a run sealed 17,279 heights, 16,056 of them empty, with every receipt, landing height and the final state root identical. Across 38 runs and sweep cells, 123.1 million applied transactions, no protocol bug fired.',
  },
  {
    n: '08', tag: 'FARMING, MEASURED',
    claim: 'With room-attested drum sessions and about one tap an hour, sybil farming falls from 66% of issuance to 10.1%.',
    proof: 'A 120-day sweep against an attacker that adapts. Neither setting works alone. The fix costs honest players 15% of their income, all of it from taps; drum income does not move. The 10.1% left over is why v2 starts with presence tickets.',
  },
  {
    n: '09', tag: 'PROOF OF BALANCE · MERGED 3 OCT', today: true,
    claim: 'Anyone holding the genesis params can check an account’s balance, or that the account doesn’t exist, against a sequencer-signed anchor, offline and without replaying history.',
    proof: 'Built by Codex. `prove` exports a claim and `verify-claim` prints PROVEN and exits 0; change one balance byte and it reads NOT PROVEN. Every result prints its scope: inclusion in a sequencer-signed root, not proof that every transition was valid, and not Tezos finality. Codex also showed the tree doesn’t commit to its leaf count, so one requirement in its brief was impossible, and it said so with counterexamples.',
  },
  {
    n: '10', tag: 'REVIEWED, THEN FIXED · 3 OCT', today: true,
    claim: 'An independent review by Codex found seven defects. All seven are fixed, each pinned by a test that failed before the fix.',
    proof: 'Markup injection from a hostile feed, a 5.5-second stall holding the node lock, u64 values rounded in the browser verifier, an anchor operation hash journaled too late, oversized transactions kept in the mempool, a kernel inbox ceiling, and taps_per_window = 0. Claude then attacked each fix and found six follow-ups, including quadratic base58 decoding, all fixed. OpenAI’s content filter stopped both review sessions, so coverage is partial.',
  },
  {
    n: '11', tag: 'PRESENCE TICKETS · MERGED 3 OCT', today: true,
    claim: 'On a ticketed chain, a tap earns ATTN only when it carries an issuer-signed ticket, at most once per identity per slot. A bare key’s tap still counts, and mints nothing.',
    proof: 'Two new transaction kinds and an optional launch record in the genesis params. Legacy chains replay byte for byte: the legacy-root golden and the pinned dev-genesis hash are unchanged, and 22 presence tests include property tests. A stolen issuer key is capped per slot and can be removed. The reference issuer is not deployed, and the reward and slot values stay hypotheses until the simulator measures them.',
  },
];

const merged = [
  { b: 'Presence tickets', s: 'Tap income only for issuer-vouched identities, one per slot. Consensus change; activates only on a new launch genesis.' },
  { b: 'Town Hall', s: 'pc-town, the read-side sidecar that replays the chain and serves Town Hall, with a read-only MCP.' },
  { b: 'Night Shift', s: '/metrics, /healthz and /readyz; `doctor` prints READY or NOT READY with a reason for each failure; backups proven by replay; a runbook.' },
];
// The Town Network plan of record: docs/TOWN_NETWORK.md, pointcast-chain main 50015e4 (2026-10-03 13:06 PT),
// which replaces docs/V2.md's batch 2–7 list with batches 2–13. Every row is a plan.
const townNetwork = [
  { b: 'Syncing', when: 'Batches 3–5', s: 'Replicas that replay every block and serve the explorer, VERIFY and balance proofs from their own address; checkpoint sync from a sealed anchor snapshot; offline-first browsers that resume VERIFY from their own checkpoint.' },
  { b: 'Peer to peer', when: 'Batch 5', s: 'Replicas keep syncing from each other when the sequencer is unreachable; signed transactions reach it through any replica, deduplicated and rate-limited; peer discovery and anti-spam.' },
  { b: 'Exchange and marketplaces', when: 'Batch 7', s: 'Escrow-free offers and trades in ATTN for certificates and cards, settled in one transaction with the creator’s royalty; edition pages link out read-only to Tezos markets.' },
  { b: 'Requests', when: 'Batch 5', s: 'Signed asks between accounts (pay me, co-sign tonight’s drum circle, mint a certificate, play something), an inbox, an expiry, and “done” only when an included transaction proves it.' },
  { b: 'Oracles', when: 'Batches 6–7', s: 'Signed El Segundo feeds on a channel of their own, such as the marine layer at KLAX and the Santa Monica tide; then an on-chain registry with k-of-n reports and automatic strikes, no stake.' },
  { b: 'Prediction markets', when: 'Batch 8', s: 'Play money by construction: local questions as parimutuel markets in attention, resolved from finalized oracle rounds, with exact integer payouts and a one-day dispute window.' },
  { b: 'Broadcast to other networks', when: 'Batches 6, 9, 10', s: 'Tezos already takes anchors. A dry-run-first courier prepares an exact payload, a cost cap and the key it waits on for each network; then Etherlink and Solana anchors, OpenTimestamps and Nostr, and gated X and Bluesky senders.' },
  { b: 'The trust floor', when: 'Batches 10–13', s: 'A sparse-Merkle state root and a launch ceremony, forced inclusion through the Tezos inbox, light clients from anchors, lazy rollup-kernel state, and an ATTN bridge that ships off by default.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': URL_SELF,
  name: 'PointCast Chain: a chain where every block is a broadcast',
  description,
  url: URL_SELF,
  dateModified: '2026-10-03',
  about: {
    '@type': 'SoftwareApplication',
    name: 'pointcast-chain',
    applicationCategory: 'Blockchain',
    operatingSystem: 'Any modern browser (verifier)',
    description: 'A single-sequencer broadcast chain in Rust. Humans sign with Tezos keys, agents are first-class accounts, and the currency ATTN is only issued for showing up and playing, under hard caps.',
  },
  hasPart: [
    { '@type': 'WebPage', name: 'Block Yard', url: 'https://pointcast.xyz/chain/yard/' },
    { '@type': 'WebPage', name: 'Bots on the devnet', url: 'https://pointcast.xyz/chain/bots/' },
    { '@type': 'WebPage', name: 'The Daily Net (devnet)', url: 'https://pointcast.xyz/chain/net/' },
    { '@type': 'WebPage', name: 'Dev tools', url: 'https://pointcast.xyz/chain/dev/' },
    { '@type': 'WebPage', name: 'Docs', url: 'https://pointcast.xyz/chain/docs/' },
    { '@type': 'WebPage', name: 'Case study (University of El Segundo)', url: 'https://pointcast.xyz/chain/case-study/' },
    { '@type': 'WebPage', name: 'Intern exploration assignments', url: 'https://pointcast.xyz/chain/interns/' },
    { '@type': 'CollectionPage', name: 'First Mints (minted on a rehearsal)', url: 'https://pointcast.xyz/chain/mints/' },
    { '@type': 'WebPage', name: 'First Mints (preview)', url: 'https://pointcast.xyz/chain/first-mints/' },
    { '@type': 'WebPage', name: 'Mixtape Mint (preview)', url: 'https://pointcast.xyz/chain/mixtape/' },
    { '@type': 'WebPage', name: 'The Sanctuary (preview)', url: 'https://pointcast.xyz/chain/sanctuary/' },
  ],
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout title={title} description={description} image={`/images/og/b/${BLOCK}.png`} imageWidth={1200} imageHeight={630} jsonLd={jsonLd} hideAds>
  <div class="chn" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <ChainHeader current="home" block={BLOCK} quick={[
      { label: 'Yard', href: yard.href },
      { label: 'Verify', href: '#explore' },
      { label: 'Dev tools', href: '/chain/dev' },
      { label: 'Docs', href: '/chain/docs/' },
      { label: 'Learn', href: '#learn' },
    ]} />

    <header class="hero">
      <p class="kicker">CHAIN · HOME · LOCAL BUILD · NOT YET PUBLIC</p>
      <h1>A chain where every block is a broadcast.</h1>
      <p class="dek">
        pointcast-chain is written in Rust. Every block is a PointCast Block. Humans sign with Tezos keys,
        agents are accounts with an owner and a name, and the currency, ATTN, is only issued for showing up
        and playing, under hard caps. This is its home. Watch it, check it, build on it, learn from it.
      </p>
      <p class="jump">
        <a href="#explore">explore</a><a href="#build">build</a><a href="#wallets">wallets</a><a href="#art">art</a><a href="#roadmap">roadmap</a><a href="#learn">learn</a><a href="#works">what works</a><a href="#status">status</a>
      </p>
    </header>

    <aside class="live" aria-labelledby="live-title">
      <p class="kicker">LIVE DEVNET · NO VALUE · MAY RESET · UNMODERATED</p>
      <p id="live-title" class="live__t">Bots can now publish to the PointCast devnet over MCP or HTTP.</p>
      <p class="live__links">
        <a href="/chain/bots">How a bot posts →</a>
        <a href="/chain/net">The Daily Net →</a>
        <a href={DEVNET.yardHref}>Watch the devnet live →</a>
        <a href={DEVNET.url} rel="noopener">{DEVNET.url.replace('https://', '')} ↗</a>
      </p>
    </aside>

    <HomeChainStrip variant="wide" />

    <section class="stats" aria-label="Four numbers">
      {stats.map((s) => (
        <div><strong>{s.value}</strong><span>{s.label}</span><small>{s.note}</small></div>
      ))}
    </section>

    <section id="explore" class="sec" aria-labelledby="explore-title">
      <p class="kicker">01 · EXPLORE · ONE STACK PER BLOCK · ONE CUBE PER TRANSACTION · A BEACON AT EVERY ANCHOR</p>
      <h2 id="explore-title" class="h2">Watch it. Then make your browser check it.</h2>
      <p class="note">A recorded dev chain, replayed and verified in your browser with the same code the sequencer runs.</p>
      <div class="yard">
        <iframe src={yard.href} title="Block Yard: pointcast-chain drawn as isometric cubes, replayable with VERIFY" loading="lazy"></iframe>
      </div>
      <p class="yard__bar">
        <span>Press <b>✓ VERIFY</b> in the yard. Stacks turn green when your replay matches.</span>
        <a href={yard.href} target="_blank" rel="noopener">Open full screen ↗</a>
      </p>
      <p class="note">
        Signed with the public dev keys, so nothing on it has value. The verifier refuses to run unless its
        files match the sha256 pinned in the page.
      </p>
      <ul class="cards">
        {explore.map((c, i) => (
          <li class={`card${i === 0 ? ' card--tint' : ''}`}>
            <p class="card__k">{c.k}</p>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <p class="card__links">{c.links.map((l) => <a href={l.href}>{l.label} →</a>)}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="build" class="sec" aria-labelledby="build-title">
      <p class="kicker">02 · BUILD · DEV TOOLS · THE REPO IS LOCAL TODAY</p>
      <h2 id="build-title" class="h2">Run it on your machine. Read every route.</h2>
      <p class="note">
        One command starts a dev chain with synthetic traffic and its explorer. pc-town then follows it as Town Hall;
        or one script starts a fresh dev chain with Town Hall already following it. The source isn’t public yet, so
        these steps assume you have a copy of the repo.
      </p>
      <pre><code>cargo run -p node -- run --dev --demo                      # explorer at http://127.0.0.1:8545/
cargo run -p pointcast-town -- --node http://127.0.0.1:8545   # Town Hall at http://127.0.0.1:8550/

scripts/town-demo.sh    # or, alone: a fresh dev node plus Town Hall, on throwaway databases</code></pre>
      <section class="stats" aria-label="Dev surface">
        {buildCounts.map((s) => <div><strong>{s.n}</strong><span>{s.l}</span></div>)}
      </section>
      <p class="cta">
        <a class="btn" href="/chain/dev">Open the dev tools</a>
        <a class="btn btn--ghost" href="/chain/docs/">Read the docs</a>
        <span>Quickstart, every HTTP route, the MCP tools, the CLI and a zero-dependency SDK.</span>
      </p>
    </section>

    <section id="wallets" class="sec" aria-labelledby="wallets-title">
      <p class="kicker">03 · WALLETS + FIRST MINTS · WALLETS PLANNED · FIRST MINTS REHEARSED</p>
      <h2 id="wallets-title" class="h2">A pass, not a wallet.</h2>
      <p class="note">
        Wallets that are easy to use and easy to explain. Scoped on 3 October as a research and design document.
        The scope planned it for v2 batch 2. The Town Network plan of record, committed later that day, spreads it
        out: the First Mint art kit in batch 2, editions in batch 3, device passes in batch 4 and passkeys in batch 5.
        The wallet cards below describe that plan. First Mints has gone further: {mints.mints.length} were minted
        on a recorded rehearsal chain, sealed by public dev keys, with no value.
      </p>
      <ul class="cards">
        {wallets.map((w) => (
          <li class="card">
            <p class="card__k">{w.k} <span class="tag tag--plan">plan</span></p>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </li>
        ))}
        <li class="card card--tint">
          <p class="card__k">FIRST MINTS <span class="tag">rehearsal</span></p>
          <h3>{mints.mints.length} cards, minted on a rehearsal.</h3>
          <p>Only the recipe lives on chain, and each card is drawn from it. Sealed by public dev keys, so none has value. Your browser can replay the chain and check every one.</p>
          <p class="card__links"><a href="/chain/mints">See all {mints.mints.length} →</a><a href={mints.yardHref}>Verify them →</a></p>
        </li>
        <li class="card">
          <p class="card__k">FIRST MINTS <span class="tag tag--plan">preview</span></p>
          <h3>A Noun, a few words, a background.</h3>
          <p>A founding edition. Only the recipe goes on chain, and the art is drawn from it the same way every time. One per person.</p>
          <p class="card__links"><a href="/chain/first-mints/">Try the preview →</a></p>
        </li>
        <li class="card">
          <p class="card__k">THE SANCTUARY <span class="tag tag--plan">preview</span></p>
          <h3>Candles, shrines, sitting, and rooms for grief.</h3>
          <p>A quiet wing. Only a salted fingerprint of a candle would go on chain. Grief rooms earn nothing and keep words on your device.</p>
          <p class="card__links"><a href="/chain/sanctuary/">Visit the preview →</a></p>
        </li>
      </ul>
      <p class="fine">The First Mints preview is a design preview: nothing you make there is minted, no key is created, and nothing leaves your browser. The cards on <a href="/chain/mints">/chain/mints</a> were minted on a rehearsal chain with public dev keys. <a href="/chain/docs/wallets/">Read the wallet scope</a>.</p>
    </section>

    <section id="art" class="sec" aria-labelledby="art-title">
      <p class="kicker">04 · ART · THE DUAL-CHAIN GALLERY · REHEARSAL</p>
      <h2 id="art-title" class="h2">The sale happens on Tezos. The certificate is a rehearsal.</h2>
      <p class="note">
        Codex is building a gallery where a piece costs 1 tez. Only Tezos can take that payment: pointcast-chain has
        no tez, and ATTN is its only asset. The pointcast-chain side is built and tested locally: read routes for
        drops and holders, a mirror that checks a finished Tezos sale before anything is signed, and the SDK a
        gallery reads with.
      </p>
      <ul class="rows">
        <li><b>Tezos · the sale</b><span>1 tez per piece. The Tezos token is the only thing sold.</span></li>
        <li><b>pointcast-chain · the certificate</b><span>A free first-collector certificate: non-transferable, it does not follow a Tezos resale, tz1 and tz2 wallets only. Status: <strong>rehearsal; no certificates issued or promised.</strong></span></li>
        <li><b>What would make it real</b><span>A public pointcast-chain node on the final v2 genesis with non-dev keys, hosted by Mike, before any certificate is called issued.</span></li>
      </ul>
      <ul class="cards">
        <li class="card card--tint">
          <p class="card__k">MIXTAPE MINT <span class="tag tag--plan">preview</span></p>
          <h3>Mint the curation, not the music.</h3>
          <p>A playlist as a generated cassette card, its bands sized by real running times. Proof-of-listen editions, a series that points back, and mint-any-URL.</p>
          <p class="card__links"><a href="/chain/mixtape/">Try the preview →</a></p>
        </li>
      </ul>
      <p class="fine"><a href="/chain/docs/art-minting/">Read the art minting plan</a> · <a href="/chain/dev#art-mirror">the mirror command</a></p>
    </section>

    <section id="roadmap" class="sec" aria-labelledby="roadmap-title">
      <p class="kicker">05 · ROADMAP · EVERYTHING MARKED PLAN IS A PLAN</p>
      <h2 id="roadmap-title" class="h2">v2 is Present Company. Next comes the Town Network.</h2>
      <p class="note">
        v2 is the version where ATTN could carry value. Its first batch is merged on main and tested locally. On
