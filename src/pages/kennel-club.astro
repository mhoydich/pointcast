---
import BlockLayout from '../layouts/BlockLayout.astro';
import KennelClubClaim from '../components/KennelClubClaim.astro';
import KennelClubHolding from '../components/KennelClubHolding.astro';
import KennelClubMint from '../components/KennelClubMint.astro';
import KennelTodayLive from '../components/KennelTodayLive.astro';
import {
  KENNEL_CLUB,
  KENNEL_CLUB_CANONICAL,
  calendar,
  imageUrl,
  losAngelesDate,
  sittingOfTheDay,
} from '../lib/kennel-club';

const todayDate = losAngelesDate();
const today = sittingOfTheDay(todayDate);
const days = calendar(todayDate);
const title = 'Kennel Club · The September Sitting';
const description = 'Claim today’s original Kennel Club dog free with a PointCast account. No Tezos wallet is required; PointCast can hold it until you link one.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': KENNEL_CLUB_CANONICAL,
  name: title,
  description,
  image: imageUrl(today, 'png'),
  numberOfItems: KENNEL_CLUB.sittings.length,
  hasPart: KENNEL_CLUB.sittings.map((sitting) => ({
    '@type': 'VisualArtwork',
    name: sitting.tokenMetadata.name,
    image: imageUrl(sitting, 'png'),
    url: `${KENNEL_CLUB_CANONICAL}/${sitting.slug}`,
  })),
};
---

<BlockLayout title={title} description={description} image="/og/kennel-club/today.png" imageWidth={1200} imageHeight={630} themeColor="#8A2432" jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/kennel-club.json', title: 'Kennel Club calendar JSON' }]}>
  <main class="kennel" data-kennel-club data-kennel-claimed-surface data-today={todayDate}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>Kennel Club</span><a href="/kennel-club.json">JSON</a>
    </nav>

    <header class="mast">
      <p class="kicker">Kennel Club · September 2026 · one free dog each day</p>
      <h1>Today&apos;s dog.<br /><em>Yours to claim.</em></h1>
      <p>Thirty original portrait plates from El Segundo. The club opened two days late; the first two dogs were already waiting. Sign in, claim today’s sitting, and keep moving—we pay the 1 ꜩ mint and the gas.</p>
    </header>

    <section class="hero" aria-labelledby="today-title">
      <figure class="hero__plate">
        <img src={today.image.webp} alt={today.alt} width="1024" height="1280" fetchpriority="high" data-kennel-today="image" />
        <span class="hero__stamp" data-kennel-went-home-stamp hidden></span>
        <figcaption data-kennel-today="text" data-kennel-text="Sitting {day} · {date} · America/Los_Angeles">Sitting {String(today.day).padStart(2, '0')} · {today.mintDate} · America/Los_Angeles</figcaption>
      </figure>
      <div class="hero__desk">
        <p class="kicker" data-kennel-today="text" data-kennel-text="Today · token {tokenId}">Today · token {today.tokenId}</p>
        <h2 id="today-title" data-kennel-today="text" data-kennel-text="{name}">{today.name}</h2>
        <p class="hero__breed" data-kennel-today="text" data-kennel-text="{breed}">{today.breed}</p>
        <p class="hero__title" data-kennel-today="text" data-kennel-text="{title}">{today.title}</p>
        <p class="hero__wardrobe" data-kennel-today="text" data-kennel-text="{wardrobe}">{today.wardrobe}</p>
        <div class="hero__claim" data-kennel-unclaimed>
          <KennelClubClaim tokenId={today.tokenId} sitting={today.name} live />
        </div>
        <div class="hero__wallet-mint" data-kennel-unclaimed>
          <KennelClubMint tokenId={today.tokenId} label="I have a Tezos wallet · mint for 1 ꜩ" live />
        </div>
        <p class="hero__kukai" data-kennel-unclaimed>Want to hold it yourself? <a href="/me?link=wallet">Kukai gives you a wallet with your Google login →</a></p>
        <KennelClubHolding />
        <a class="hero__open" href={`/kennel-club/${today.slug}`} data-kennel-today="href text" data-kennel-href="/kennel-club/{slug}" data-kennel-text="Open {name}’s full sitting →">Open {today.name}’s full sitting →</a>
      </div>
    </section>

    <section class="calendar" aria-labelledby="calendar-title">
      <div class="calendar__head">
        <div><p class="kicker">The September Sitting</p><h2 id="calendar-title">Thirty plates, <em>one at a time.</em></h2></div>
        <a href="/k/today">/k/today →</a>
      </div>
      <ol class="calendar__grid" aria-label="September 2026 Kennel Club calendar">
        {days.map((day) => (
          <li class:list={['calendar__day', `calendar__day--${day.status}`]} data-sitting-date={day.date} data-kennel-claimed-tile data-kennel-day={day.day}>
            <a href={`/kennel-club/${day.slug}`}>
              <img src={day.image.webp.replace('https://pointcast.xyz', '')} alt={day.status === 'today' ? day.image.alt : ''} width="1024" height="1280" loading={day.status === 'today' ? 'eager' : 'lazy'} />
              <span><b>{String(day.day).padStart(2, '0')}</b><em>Today</em></span>
            </a>
            <span class="calendar__future"><b>{String(day.day).padStart(2, '0')}</b><small>Held</small></span>
            <span class="calendar__mine" data-kennel-owner-mark hidden></span>
          </li>
        ))}
      </ol>
    </section>

    <section class="club-live" aria-labelledby="live-title">
      <header class="club-live__head">
        <div><p class="kicker">Live claim desk</p><h2 id="live-title">The room is <em>bringing dogs home.</em></h2></div>
        <a href="/api/kennel-club/mint">Live JSON →</a>
      </header>
      <dl class="club-live__counts">
        <div data-people-claimed-row hidden><dt>People claimed today</dt><dd data-claim-count>—</dd></div>
        <div><dt>On-chain minted today</dt><dd data-minted-count>—</dd></div>
      </dl>
      <div class="ticker">
        <p class="kicker">Last 10 claims · dog + first name only</p>
        <ol data-claim-ticker><li>Waiting for the claim desk…</li></ol>
      </div>
    </section>
  </main>
  <KennelTodayLive />
</BlockLayout>

<script>
  type LiveClaim = { sitting: string; firstName: string };
  type LiveState = {
    today: { minted: number };
    claims: { claimed: number; recent: LiveClaim[] };
  };

  async function refreshKennelLive(root: HTMLElement): Promise<void> {
    try {
      const response = await fetch('/api/kennel-club/mint', { cache: 'no-store' });
      if (!response.ok) throw new Error('live-state');
      const state = await response.json() as LiveState;
      const claimed = root.querySelector<HTMLElement>('[data-claim-count]');
      const minted = root.querySelector<HTMLElement>('[data-minted-count]');
      if (claimed) claimed.textContent = String(state.claims.claimed);
      if (minted) minted.textContent = String(state.today.minted);
      const claimedRow = root.querySelector<HTMLElement>('[data-people-claimed-row]');
      if (claimedRow) claimedRow.hidden = state.claims.claimed < 3;
      const ticker = root.querySelector<HTMLOListElement>('[data-claim-ticker]');
      if (ticker) {
        const entries = state.claims.recent.map((claim) => {
          const row = document.createElement('li');
          const dog = document.createElement('strong');
          const person = document.createElement('span');
          dog.textContent = claim.sitting;
          person.textContent = claim.firstName;
          row.append(dog, person);
          return row;
        });
        if (!entries.length) {
          const empty = document.createElement('li');
          empty.textContent = 'The first free claim is waiting.';
          entries.push(empty);
        }
        ticker.replaceChildren(...entries);
      }
    } catch {
      const ticker = root.querySelector<HTMLOListElement>('[data-claim-ticker]');
      if (ticker) ticker.replaceChildren(Object.assign(document.createElement('li'), { textContent: 'Live counts are taking a breath.' }));
    }
  }

  function initializeKennel(root: HTMLElement): void {
    const la = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    root.querySelectorAll<HTMLElement>('[data-sitting-date]').forEach((cell) => {
      const date = cell.dataset.sittingDate || '';
      cell.classList.toggle('calendar__day--past', date < la);
      cell.classList.toggle('calendar__day--today', date === la);
      cell.classList.toggle('calendar__day--future', date > la);
    });
    void refreshKennelLive(root);
  }

  document.querySelectorAll<HTMLElement>('[data-kennel-club]').forEach(initializeKennel);
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-kennel-club]').forEach(initializeKennel));
  window.addEventListener('pc:kennel-claim', () => document.querySelectorAll<HTMLElement>('[data-kennel-club]').forEach((root) => void refreshKennelLive(root)));
</script>

<style>
  .kennel { width: min(1180px, calc(100vw - 28px)); margin: 0 auto; padding: 22px 0 90px; --club: #8a2432; --club-wash: #fbf1f1; }
  .kennel[data-kennel-claimed-state] [data-kennel-unclaimed] { display: none !important; }
  .crumb, .kicker, figcaption, .hero__open, .hero__kukai, .calendar__future, .calendar__day span, .club-live dt, .ticker { font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; color: var(--pc-ink-muted); }
  .crumb a:last-child { margin-left: auto; }
  .mast { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, .55fr); gap: 24px; align-items: end; border-top: 2px solid var(--pc-ink); padding: 20px 0 26px; }
  .kicker { margin: 0 0 10px; color: var(--club); }
  h1, h2 { margin: 0; font-weight: 400; letter-spacing: -.055em; line-height: .88; }
  h1 { grid-column: 1; font-size: clamp(52px, 9vw, 116px); }
  h1 em, h2 em { color: var(--club); font-style: normal; }
  .mast > p:last-child { grid-column: 2; margin: 0; color: var(--pc-ink-soft); font-size: 16px; line-height: 1.5; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(330px, .82fr); border: 1.5px solid var(--pc-ink); }
  .hero__plate { position: relative; min-height: 680px; margin: 0; background: var(--club); }
  .hero__plate img { width: 100%; height: 100%; object-fit: cover; }
  .hero__plate figcaption { position: absolute; right: 10px; bottom: 10px; left: 10px; padding: 7px 9px; background: rgba(255,255,255,.94); }
  .hero__stamp { position: absolute; top: 14px; right: 14px; max-width: calc(100% - 28px); padding: 7px 9px; border: 1.5px solid #fff; background: var(--club); color: #fff; font: 500 9px/1.2 var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; transform: rotate(2deg); }
  .hero__desk { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: clamp(24px, 5vw, 60px); border-left: 1.5px solid var(--pc-ink); background: var(--club); color: #fff; }
  .hero__desk .kicker { color: rgba(255,255,255,.72); }
  .hero__desk h2 { font-size: clamp(56px, 8vw, 100px); }
  .hero__breed { margin: 16px 0 0; font-size: 18px; font-weight: 500; }
  .hero__title { margin: 8px 0 0; font-size: 26px; letter-spacing: -.03em; }
  .hero__wardrobe { max-width: 44ch; margin: 12px 0 0; color: rgba(255,255,255,.76); font-size: 13px; line-height: 1.45; }
  .hero__claim { margin-top: 28px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.36); }
  .hero__wallet-mint { margin-top: 12px; }
  .hero__wallet-mint :global(.kennel-mint) { margin: 0; padding: 0; border: 0; }
  .hero__wallet-mint :global(.kennel-mint__button) { border-color: rgba(255,255,255,.62); background: transparent; color: #fff; }
  .hero__wallet-mint :global(.kennel-mint__state), .hero__wallet-mint :global(.kennel-mint__state a) { color: rgba(255,255,255,.72); }
  .hero__wallet-mint :global(.kennel-mint__wallet) { border-color: rgba(255,255,255,.4); color: #fff; }
  .hero__kukai { margin: 14px 0 0; color: rgba(255,255,255,.72); line-height: 1.5; text-transform: none; letter-spacing: .02em; }
  .hero__kukai a, .hero__open { color: #fff; }
  .hero__open { margin-top: 18px; }
  .hero__desk :global(.kennel-holding) { margin-top: 28px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.36); color: #fff; }
  .calendar { margin-top: 46px; }
  .calendar__head, .club-live__head { display: flex; align-items: end; justify-content: space-between; gap: 18px; padding-bottom: 14px; border-bottom: 2px solid var(--pc-ink); }
  .calendar__head h2, .club-live__head h2 { font-size: clamp(38px, 6vw, 72px); }
  .calendar__head > a, .club-live__head > a { flex: 0 0 auto; color: var(--club); font: 400 10px var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .calendar__grid { display: grid; grid-template-columns: repeat(6, 1fr); margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--pc-ink); }
  .calendar__day { position: relative; min-height: 146px; overflow: hidden; border-right: 1px solid var(--pc-ink); border-bottom: 1px solid var(--pc-ink); }
  .calendar__day a { display: block; height: 100%; color: var(--pc-ink); }
  .calendar__day img { width: 100%; height: 100%; object-fit: cover; }
  .calendar__day span { position: absolute; top: 6px; left: 6px; display: flex; gap: 4px; align-items: center; padding: 3px 5px; background: #fff; color: var(--pc-ink); }
  .calendar__day span b { font-weight: 400; }
  .calendar__day span em { color: var(--club); font-style: normal; }
  .calendar__day--today { z-index: 1; box-shadow: inset 0 0 0 4px var(--club); }
  .calendar__day--future a { display: none; }
  .calendar__day:not(.calendar__day--future) .calendar__future { display: none; }
  .calendar__future { display: grid !important; height: 100%; place-content: center; gap: 7px; background: #fff; color: var(--pc-ink-muted); text-align: center; }
  .calendar__future b { color: var(--pc-ink); font-size: 25px; }
  .calendar__mine { top: auto !important; right: 6px; bottom: 6px; left: auto !important; z-index: 2; width: 24px; height: 24px; justify-content: center; border: 1px solid var(--club); border-radius: 50%; background: var(--club) !important; color: #fff !important; font-size: 10px; }
  .calendar__day[data-kennel-yours] { box-shadow: inset 0 0 0 3px var(--club); }
  .calendar__day--today[data-kennel-yours] { box-shadow: inset 0 0 0 5px var(--club); }
  .club-live { margin-top: 46px; }
  .club-live__counts { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-left: 1px solid var(--pc-ink); }
  .club-live__counts div { min-height: 128px; padding: 14px; border-right: 1px solid var(--pc-ink); border-bottom: 1px solid var(--pc-ink); background: var(--club-wash); }
  .club-live dt { color: var(--club); }
  .club-live dd { margin: 20px 0 0; font-size: 54px; line-height: 1; }
  .ticker { padding: 18px 0; border-bottom: 1px solid var(--pc-ink); }
  .ticker ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .ticker li { display: flex; gap: 7px; padding: 7px 9px; border: 1px solid #d5b8bd; background: #fff; }
  .ticker strong { color: var(--club); font-weight: 500; }
  .ticker span::before { content: '→ '; color: var(--pc-ink-muted); }
  @media (max-width: 760px) {
    .kennel { width: min(100% - 20px, 1180px); }
    .mast { grid-template-columns: 1fr; }
    .mast > p:last-child { grid-column: 1; }
    .hero { grid-template-columns: 1fr; }
    .hero__plate { min-height: min(128vw, 620px); }
    .hero__desk { border-top: 1.5px solid var(--pc-ink); border-left: 0; }
    .calendar__grid { grid-template-columns: repeat(3, 1fr); }
    .calendar__day { min-height: 128px; }
    .club-live__head { align-items: start; flex-direction: column; }
    .club-live__counts { grid-template-columns: 1fr; }
    .club-live__counts div { min-height: 92px; }
    .club-live dd { margin-top: 10px; font-size: 42px; }
  }
</style>
