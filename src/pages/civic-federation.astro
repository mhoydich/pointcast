---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FOUR_CANONICAL_FORMS, HISTORICAL_PRECEDENTS, HOW_TO_FORK_A_FEDERATION, HOW_TO_RECOGNIZE_A_FEDERATION, PAPER_META, PAPER_NOTES, REFERENCES, STRUCTURAL_INNOVATIONS, THE_CIVIC_FEDERATION, THE_FOUNDING_DECLARATION, TWENTY_FIRST_CENTURY_PROBLEMS, WHAT_THIS_PAPER_DOES_NOT_CLAIM } from '../lib/civicFederationPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/civic-federation', name: PAPER_META.title, description, url: 'https://pointcast.xyz/civic-federation', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/civic-federation.json', title: 'The Civic Federation (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">UES</a><span aria-hidden="true">/</span><span>civic-federation</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY · {PAPER_META.classification}</p>
      <h1>THE / CIVIC / FEDERATION.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="declaration"><p class="kicker">FOUNDING DECLARATION</p><h2>What is being declared here.</h2>
      <p class="oneliner">{THE_FOUNDING_DECLARATION.oneSentence}</p>
      <h3 class="sh">Five propositions</h3>
      <ol class="prop-list">{THE_FOUNDING_DECLARATION.fivePropositions.map((p, i) => (
        <li><span class="prop__num">{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
      <p class="signed"><em>{THE_FOUNDING_DECLARATION.signed}</em></p>
    </section>

    <section class="forms"><p class="kicker">FOUR CANONICAL 20TH-CENTURY FORMS</p><h2>The form-space the federation occupies.</h2>
      <ol class="form-list">{FOUR_CANONICAL_FORMS.map((f, i) => (
        <li>
          <div class="form__head"><span class="form__num">{String(i+1).padStart(2,'0')}</span><h3>{f.name}</h3></div>
          <dl class="form-dl">
            <div><dt>Emerged</dt><dd>{f.emergedAround}</dd></div>
            <div><dt>Primary unit</dt><dd>{f.primaryUnit}</dd></div>
            <div><dt>Funding source</dt><dd>{f.fundingSource}</dd></div>
            <div><dt>Decision rule</dt><dd>{f.decisionRule}</dd></div>
            <div><dt>Commitment horizon</dt><dd>{f.durationOfCommitment}</dd></div>
            <div><dt>Growth mechanism</dt><dd>{f.growthMechanism}</dd></div>
            <div><dt>Failure mode</dt><dd>{f.failureMode}</dd></div>
            <div><dt>Examples</dt><dd>{f.precedentExamples}</dd></div>
          </dl>
          <p class="form__limits"><strong>Known limits:</strong> {f.knownLimits}</p>
        </li>
      ))}</ol>
    </section>

    <section class="cf"><p class="kicker">THE FIFTH FORM · CIVIC FEDERATION</p><h2>What the corridor has been building.</h2>
      <div class="form__head form__head--cf"><span class="form__num">05</span><h3>{THE_CIVIC_FEDERATION.name}</h3></div>
      <dl class="form-dl form-dl--cf">
        <div><dt>Emerged</dt><dd>{THE_CIVIC_FEDERATION.emergedAround}</dd></div>
        <div><dt>Primary unit</dt><dd>{THE_CIVIC_FEDERATION.primaryUnit}</dd></div>
        <div><dt>Funding source</dt><dd>{THE_CIVIC_FEDERATION.fundingSource}</dd></div>
        <div><dt>Decision rule</dt><dd>{THE_CIVIC_FEDERATION.decisionRule}</dd></div>
        <div><dt>Commitment horizon</dt><dd>{THE_CIVIC_FEDERATION.durationOfCommitment}</dd></div>
        <div><dt>Growth mechanism</dt><dd>{THE_CIVIC_FEDERATION.growthMechanism}</dd></div>
        <div><dt>Failure mode</dt><dd>{THE_CIVIC_FEDERATION.failureMode}</dd></div>
        <div><dt>Precedent examples</dt><dd>{THE_CIVIC_FEDERATION.precedentExamples}</dd></div>
      </dl>
      <p class="form__limits form__limits--cf"><strong>Known limits:</strong> {THE_CIVIC_FEDERATION.knownLimits}</p>
    </section>

    <section class="hist"><p class="kicker">HISTORICAL PRECEDENTS · 6 LINEAGES</p><h2>The form is not new. It is re-emerging.</h2>
      <ol class="hist-list">{HISTORICAL_PRECEDENTS.map((h) => (
        <li>
          <div class="hist__head">
            <h3>{h.name}</h3>
            <span class="hist__period">{h.period}</span>
          </div>
          <p class="hist__geo"><strong>Geography:</strong> {h.geography}</p>
          <h4 class="hist-sh">Structural features</h4>
          <ul class="hist-feat">{h.structuralFeatures.map((s) => (<li>{s}</li>))}</ul>
          <p class="hist__what"><strong>What it prefigures:</strong> {h.whatItPrefigures}</p>
          <p class="hist__lesson"><strong>Longevity lesson:</strong> {h.longevityLesson}</p>
        </li>
      ))}</ol>
    </section>

    <section class="innov"><p class="kicker">STRUCTURAL INNOVATIONS · 10</p><h2>What the form does that the four canonical forms cannot.</h2>
      <ol class="innov-list">{STRUCTURAL_INNOVATIONS.map((s, i) => (
        <li>
          <div class="innov__head"><span class="innov__num">{String(i+1).padStart(2,'0')}</span><h3>{s.innovation}</h3></div>
          <p class="innov__desc">{s.description}</p>
          <p class="innov__row"><strong>Precedent:</strong> {s.precedent}</p>
          <p class="innov__solves"><strong>What it solves:</strong> {s.whatItSolves}</p>
        </li>
      ))}</ol>
    </section>

    <section class="problems"><p class="kicker">21ST-CENTURY COORDINATION PROBLEMS · 7</p><h2>Why the form is re-emerging now.</h2>
      <ol class="prob-list">{TWENTY_FIRST_CENTURY_PROBLEMS.map((p) => (
        <li>
          <h3>{p.problem}</h3>
          <p class="prob__why-not"><strong>Why the four forms struggle:</strong> {p.whyTheFourFormsStruggle}</p>
          <p class="prob__why-fits"><strong>Why the federation fits:</strong> {p.whyTheFederationFits}</p>
        </li>
      ))}</ol>
    </section>

    <section class="recognize"><p class="kicker">HOW TO RECOGNIZE A FEDERATION · 10 SIGNS</p><h2>What to look for.</h2>
      <ol class="rec-list">{HOW_TO_RECOGNIZE_A_FEDERATION.map((r, i) => (
        <li><span class="rec__num">{String(i+1).padStart(2,'0')}</span><p>{r}</p></li>
      ))}</ol>
    </section>

    <section class="fork"><p class="kicker">HOW TO FORK A FEDERATION · 10 STEPS</p><h2>If you want to build one.</h2>
      <ol class="fork-list">{HOW_TO_FORK_A_FEDERATION.map((f, i) => (
        <li><span class="fork__num">{String(i+1).padStart(2,'0')}</span><p>{f}</p></li>
      ))}</ol>
    </section>

    <section class="not"><p class="kicker">WHAT THIS PAPER DOES NOT CLAIM · 7</p><h2>The honest scope.</h2>
      <ul class="not-list">{WHAT_THIS_PAPER_DOES_NOT_CLAIM.map((n) => (<li>{n}</li>))}</ul>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · POLITICAL SCIENTISTS · ORGANIZERS · FUNDERS · JOURNALISTS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/forkable-radius">The Forkable Radius · UES-WP-2026-11</a>
      <a href="/federation-council">Federation Council Charter · UES-Federation-05</a>
      <a href="/forkable-template">Forkable Template · how to start</a>
      <a href="/corridor-strengths">Corridor Strengths · 11 cities</a>
      <a href="/giant-works">Giant Works · Tier D</a>
      <a href="/marine-layer">Marine Layer · cohort precedent</a>
      <a href="/living-body">Living Body · body-energy traditions</a>
      <a href="/time">Time · time-fluency</a>
      <a href="/civic-federation.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --cf-ink:#1a1a1a; --cf-paper:#fdf9ee; --cf-mustard:#d4a534; --cf-rust:#b85a3a; --cf-sage:#2d6a3d; --cf-violet:#5b3d7a; --cf-navy:#3a4a8a; --cf-fog:#d8d2c4; --cf-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--cf-paper); color: var(--cf-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--cf-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 40px; }
  .hero__bar { height: 18px; background: var(--cf-navy); margin: 0 -28px 32px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cf-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--cf-navy); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 100px; line-height: .9; font-weight: 700; letter-spacing: -.025em; margin: 8px 0 16px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 16px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 14px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--cf-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-navy); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--cf-navy); }
  h4.hist-sh { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-navy); margin: 10px 0 6px; }

  .declaration { background: linear-gradient(135deg, #fff, var(--cf-paper)); }
  .oneliner { font-size: 19px; line-height: 1.55; font-style: italic; margin: 0 0 18px; padding: 16px 18px; background: #fff; border-left: 6px solid var(--cf-navy); max-width: 72ch; font-family: Georgia, serif; }
  .prop-list { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 6px; }
  .prop-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--cf-ink); border-left: 6px solid var(--cf-navy); align-items: baseline; }
  .prop__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--cf-navy); }
  .prop-list p { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }
  .signed { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; color: var(--cf-slate); margin: 14px 0 0; }

  .form-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .form-list li { padding: 14px; background: #fff; border: 2px solid var(--cf-ink); border-left: 8px solid var(--cf-slate); }
  .form__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 2px solid var(--cf-slate); }
  .form__head--cf { border-bottom-color: var(--cf-navy); }
  .form__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--cf-slate); }
  .form__head--cf .form__num { color: var(--cf-navy); }
  .form__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; flex: 1; }
  .form-dl { display: grid; gap: 4px; margin: 0 0 10px; }
  .form-dl > div { display: grid; grid-template-columns: 180px 1fr; gap: 12px; padding: 8px 10px; background: var(--cf-paper); border-left: 3px solid var(--cf-fog); }
  .form-dl dt { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--cf-slate); padding-top: 2px; }
  .form-dl dd { margin: 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  .form-dl--cf > div { border-left-color: var(--cf-navy); }
  .form-dl--cf dt { color: var(--cf-navy); }
  .form__limits { padding: 10px 12px; background: var(--cf-paper); border-left: 4px solid var(--cf-rust); font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; margin: 0; }
  .form__limits--cf { border-left-color: var(--cf-navy); border-left-width: 6px; background: linear-gradient(90deg, #f0f4ff, #fff); }
  .form__limits strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-rust); margin-right: 4px; }
  .form__limits--cf strong { color: var(--cf-navy); }
  .cf { background: linear-gradient(180deg, var(--cf-paper), #f0f4ff); border-top: 8px solid var(--cf-navy); }
  .cf .kicker { background: var(--cf-navy); }

  .hist-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .hist-list li { padding: 14px; background: #fff; border: 2px solid var(--cf-ink); border-left: 8px solid var(--cf-violet); }
  .hist__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 2px solid var(--cf-violet); }
  .hist__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; flex: 1; }
  .hist__period { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .12em; padding: 3px 8px; background: var(--cf-violet); color: #fff; }
  .hist__geo, .hist__what, .hist__lesson { padding: 8px 12px; background: var(--cf-paper); margin: 6px 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; border-left: 3px solid var(--cf-fog); }
  .hist__what { border-left-color: var(--cf-sage); }
  .hist__lesson { border-left-color: var(--cf-mustard); }
  .hist-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-violet); margin-right: 4px; }
  .hist-feat { list-style: square; padding-left: 22px; margin: 0 0 10px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .hist-feat li { padding: 2px 0; }

  .innov-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .innov-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--cf-ink); border-left: 6px solid var(--cf-mustard); }
  .innov__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 2px solid var(--cf-mustard); }
  .innov__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--cf-mustard); }
  .innov__head h3 { font-family: var(--pc-font-mono); font-size: 14.5px; margin: 0; flex: 1; }
  .innov__desc { font-size: 13.5px; line-height: 1.6; margin: 0 0 6px; font-family: Georgia, serif; }
  .innov__row, .innov__solves { padding: 6px 10px; background: var(--cf-paper); margin: 6px 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--cf-fog); }
  .innov__solves { border-left-color: var(--cf-sage); }
  .innov-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-mustard); margin-right: 4px; }

  .prob-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .prob-list li { padding: 14px; background: #fff; border: 2px solid var(--cf-ink); border-left: 8px solid var(--cf-rust); }
  .prob-list h3 { font-family: var(--pc-font-mono); font-size: 15px; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 2px solid var(--cf-rust); }
  .prob__why-not, .prob__why-fits { padding: 8px 12px; background: var(--cf-paper); margin: 6px 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; border-left: 3px solid var(--cf-rust); }
  .prob__why-fits { border-left-color: var(--cf-sage); }
  .prob-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--cf-rust); margin-right: 4px; }
  .prob__why-fits strong { color: var(--cf-sage); }

  .rec-list, .fork-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .rec-list li, .fork-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--cf-ink); border-left: 6px solid var(--cf-sage); align-items: baseline; }
  .fork-list li { border-left-color: var(--cf-mustard); }
  .rec__num, .fork__num { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--cf-sage); }
  .fork__num { color: var(--cf-mustard); }
  .rec-list p, .fork-list p { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .not-list { list-style: square; padding-left: 22px; margin: 0; font-size: 14px; line-height: 1.65; font-family: Georgia, serif; }
  .not-list li { padding: 4px 0; color: var(--cf-ink); }
  .not-list li::marker { color: var(--cf-rust); }

  .invitation { background: var(--cf-navy); color: var(--cf-paper); border-top-color: var(--cf-navy); }
  .invitation .kicker { background: var(--cf-mustard); color: var(--cf-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--cf-mustard); color: var(--cf-ink); border-left: 4px solid var(--cf-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .9; padding: 12px 14px; background: rgba(255,255,255,0.08); border-left: 4px solid var(--cf-mustard); }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--cf-navy); color: var(--cf-paper); text-decoration: none; }
  .links a:hover { background: var(--cf-rust); }

  @media (max-width: 800px) { h1 { font-size: 68px; } .form-dl > div, .prop-list li, .rec-list li, .fork-list li { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 50px; } }
</style>
