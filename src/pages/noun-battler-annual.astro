---
import BlockLayout from "../layouts/BlockLayout.astro";
import {
  NOUN_BATTLER_ANNUAL_META,
  NOUN_BATTLER_FIELDS,
  NOUN_BATTLER_GANGS,
  NOUN_BATTLER_HISTORY,
  NOUN_BATTLER_ROLES,
  NOUN_BATTLER_ROUTES,
} from "../lib/noun-battler-annual";

const meta = NOUN_BATTLER_ANNUAL_META;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${meta.canonical}#article`,
      headline: meta.title,
      alternativeHeadline: meta.issue,
      description: meta.description,
      url: meta.canonical,
      datePublished: meta.publishedAt,
      dateModified: meta.publishedAt,
      image: `https://pointcast.xyz${meta.plates[0].path}`,
      author: [
        { "@type": "Person", name: "Michael Hoydich" },
        { "@type": "Organization", name: "PointCast" },
      ],
      publisher: { "@type": "Organization", name: "PointCast", url: "https://pointcast.xyz" },
      about: {
        "@type": "VideoGame",
        name: "Noun Battler",
        gamePlatform: "Web browser",
        isAccessibleForFree: true,
      },
    },
    {
      "@type": "ItemList",
      name: "Noun Battler public rooms",
      numberOfItems: NOUN_BATTLER_ROUTES.length,
      itemListElement: NOUN_BATTLER_ROUTES.map((route, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "WebPage",
          name: route.label,
          description: route.note,
          url: `https://pointcast.xyz${route.path}`,
        },
      })),
    },
  ],
};
---

<BlockLayout
  title={`${meta.title} · ${meta.issue}`}
  description={meta.description}
  image={meta.plates[0].path}
  imageWidth={1536}
  imageHeight={1024}
  jsonLd={jsonLd}
  alternates={[
    {
      type: "application/json",
      href: "/noun-battler-annual.json",
      title: "The Battle Record machine edition",
    },
  ]}
>
  <article class="nbr" data-noun-battler-annual>
    <nav class="nbr__rail" aria-label="Annual navigation">
      <a class="nbr__rail-brand" href="/">POINTCAST</a>
      <div class="nbr__rail-links">
        <a href="#origin">Origin</a>
        <a href="#history">History</a>
        <a href="#league">League</a>
        <a href="#lab">Matchup lab</a>
        <a href="#rooms">Rooms</a>
      </div>
      <a class="nbr__rail-json" href="/noun-battler-annual.json">JSON ↗</a>
      <span class="nbr__progress" data-progress aria-hidden="true"></span>
    </nav>

    <header class="nbr__cover">
      <img
        src={meta.plates[0].path}
        alt={meta.plates[0].alt}
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="nbr__cover-screen" aria-hidden="true"></div>
      <div class="nbr__cover-edition">
        <span>VOL. 01 · JULY 27, 2026</span>
        <span>EL SEGUNDO / CH.BTL</span>
      </div>
      <div class="nbr__cover-copy">
        <p class="nbr__eyebrow">THE COMPLETE HISTORY OF A SPORT INVENTED IN PUBLIC</p>
        <h1><span>THE BATTLE</span> RECORD</h1>
        <p class="nbr__cover-dek">
          From three deterministic choices to sixty Nouns under the lights:
          the strange, fast institutional life of PointCast’s browser league.
        </p>
        <div class="nbr__cover-actions">
          <a href="#origin">Read the annual</a>
          <a href="/games/nouns-nation-battler/">Watch a match</a>
        </div>
      </div>
      <div class="nbr__cover-sell">
        <strong>INSIDE</strong>
        <span>8 GANGS</span>
        <span>14 LEAGUE DAYS</span>
        <span>60 NOUNS</span>
        <span>1 VERY LONG SCOREBOOK</span>
      </div>
      <p class="nbr__credit">Original PointCast generator-made plate · “The First Box Score”</p>
    </header>

    <aside class="nbr__ticker" aria-label="Annual headlines">
      <span class="nbr__ticker-live">THE DESK</span>
      <div class="nbr__ticker-window">
        <div class="nbr__ticker-track">
          <span>STRIKE BEATS FOCUS</span>
          <span>FOCUS BEATS GUARD</span>
          <span>GUARD BEATS STRIKE</span>
          <span>TOP FOUR ADVANCE</span>
          <span>THE TABLE LIVES IN YOUR BROWSER</span>
          <span>NO ODDS · NO WAGERS · JUST NOUNS</span>
          <span>STRIKE BEATS FOCUS</span>
          <span>FOCUS BEATS GUARD</span>
          <span>GUARD BEATS STRIKE</span>
          <span>TOP FOUR ADVANCE</span>
          <span>THE TABLE LIVES IN YOUR BROWSER</span>
          <span>NO ODDS · NO WAGERS · JUST NOUNS</span>
        </div>
      </div>
    </aside>

    <main class="nbr__paper">
      <section class="nbr__front" id="origin">
        <div class="nbr__front-lead">
          <p class="nbr__folio">EDITOR’S NOTE / PAGE 003</p>
          <h2>A sport born with an archive already attached.</h2>
          <p class="nbr__standfirst">
            Most games spend years accumulating a league office, a television language, a
            statistics department, folklore, and administrative clutter. Noun Battler did
            it in weeks—because each new idea was published as another room anybody could open.
          </p>
        </div>
        <div class="nbr__columns">
          <p>
            <span class="nbr__dropcap">O</span>n April 17, Noun Battler was small enough to
            describe in one sentence: two Nouns, three rounds, three stances, deterministic
            math. A seed became a fighter. Strike beat Focus, Focus beat Guard, Guard beat
            Strike. The result could be replayed because the inputs were the record.
          </p>
          <p>
            Eleven days later the scale changed completely. The numbered portrait stopped
            standing alone on a teletext card and joined fifty-nine other bodies on a field.
            Eight gangs acquired colors, chants, roles, schedules, streaks, fans, rivalries,
            and a path toward something called the Nouns Bowl. The duel had become a league.
          </p>
          <p>
            Then came the surrounding profession: scorebugs and directors, Desk Wall reports,
            a mobile cast, scouts, recap writers, producers, sponsors, agents, a wiki, a claim
            board, a moon tournament, and a Pacific card set. In conventional software terms,
            this looks like scope expansion. In magazine terms, it looks like history.
          </p>
        </div>
        <aside class="nbr__contents">
          <p class="nbr__folio">IN THIS ANNUAL</p>
          <ol>
            <li><a href="#rulebook"><b>01</b><span>The three-button constitution</span></a></li>
            <li><a href="#history"><b>02</b><span>Eight dates that built the institution</span></a></li>
            <li><a href="#league"><b>03</b><span>The eight-gang scouting book</span></a></li>
            <li><a href="#lab"><b>04</b><span>Interactive press-box projection</span></a></li>
            <li><a href="#rooms"><b>05</b><span>Every public room in the complex</span></a></li>
          </ol>
          <img src="/games/nouns-nation-battler/assets/noun-12.svg" alt="" width="136" height="136" />
        </aside>
      </section>

      <section class="nbr__rulebook" id="rulebook" aria-labelledby="rulebook-title">
        <div class="nbr__section-head">
          <p class="nbr__folio">THE CONSTITUTION / PAGE 006</p>
          <p class="nbr__section-no">01</p>
          <h2 id="rulebook-title">Three buttons were enough to start a civilization.</h2>
        </div>
        <div class="nbr__rule-grid">
          <div class="nbr__triangle" aria-label="Strike beats Focus, Focus beats Guard, Guard beats Strike">
            <div class="nbr__triangle-node nbr__triangle-node--strike">
              <b>STRIKE</b>
              <span>aggression</span>
            </div>
            <div class="nbr__triangle-node nbr__triangle-node--focus">
              <b>FOCUS</b>
              <span>patience</span>
            </div>
            <div class="nbr__triangle-node nbr__triangle-node--guard">
              <b>GUARD</b>
              <span>defense</span>
            </div>
            <svg viewBox="0 0 600 430" role="img" aria-label="A triangular loop connecting the three stances">
              <defs>
                <marker id="nbr-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z"></path>
                </marker>
              </defs>
              <path d="M300 70 C470 80 530 180 465 315" marker-end="url(#nbr-arrow)"></path>
              <path d="M430 335 C330 405 195 402 110 325" marker-end="url(#nbr-arrow)"></path>
              <path d="M85 280 C44 160 128 82 255 68" marker-end="url(#nbr-arrow)"></path>
            </svg>
          </div>
          <div class="nbr__rule-copy">
            <p>
              The founding duel was not “rock-paper-scissors with Nouns” so much as a compact
              argument about inheritance and choice. A Noun inherited type and stats from its
              seed. The player chose a stance. Type affected the magnitude; stance was meant
              to remain the decisive read.
            </p>
            <p>
              That distinction explains the project’s durability. A Noun could arrive with a
              bad matchup and still receive a meaningful human decision. The math was pure,
              the replay was portable, and a completed match could collapse into a permanent
              PointCast block. The box score was not commentary after the fact. It was the game’s
              most compact form.
            </p>
            <blockquote>
              “The result is the same for everyone because the math is pure.”
              <cite>— founding design document, April 17</cite>
            </blockquote>
          </div>
          <div class="nbr__stat-card">
            <p class="nbr__folio">ORIGINAL FIGHTER CARD</p>
            <img src="/games/nouns-nation-battler/assets/noun-7.svg" alt="A blue Noun player from the local Battler sprite set." width="180" height="180" />
            <h3>NOUN / SEED</h3>
            <dl>
              <div><dt>TYPE</dt><dd>head + glasses</dd></div>
              <div><dt>ATK</dt><dd>attack</dd></div>
              <div><dt>DEF</dt><dd>defense</dd></div>
              <div><dt>SPD</dt><dd>initiative</dd></div>
              <div><dt>FOC</dt><dd>read quality</dd></div>
              <div><dt>HP</dt><dd>staying power</dd></div>
            </dl>
            <a href="/battle">Play the original duel →</a>
          </div>
        </div>
      </section>

      <section class="nbr__history" id="history" aria-labelledby="history-title">
        <div class="nbr__section-head nbr__section-head--dark">
          <p class="nbr__folio">ARCHIVE DESK / PAGE 012</p>
          <p class="nbr__section-no">02</p>
          <h2 id="history-title">Eight dates in the life of an overnight institution.</h2>
        </div>
        <div class="nbr__history-list">
          {NOUN_BATTLER_HISTORY.map((entry, index) => (
            <article class="nbr__history-card">
              <div class="nbr__history-date">
                <span>{entry.date}</span>
                <b>{String(index + 1).padStart(2, "0")}</b>
              </div>
              <div class="nbr__history-copy">
                <p>{entry.label}</p>
                <h3>{entry.title}</h3>
                <p>{entry.body}</p>
              </div>
              <div class="nbr__history-routes">
                {entry.routes.map((route) => (
                  <a href={route} target={route.startsWith("http") ? "_blank" : undefined} rel={route.startsWith("http") ? "noreferrer" : undefined}>
                    {route.replace(/^https:\/\/[^/]+/, "") || "standalone"} ↗
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
        <p class="nbr__history-note">
          Editorial chronology reconstructed from checked-in design notes, PRDs, route manifests,
          and repository history. Version numbers differ by room because the field, desks, and agent
          surfaces evolved on separate clocks.
        </p>
      </section>

      <figure class="nbr__plate">
        <img src={meta.plates[1].path} alt={meta.plates[1].alt} width="1536" height="1024" loading="lazy" />
        <figcaption>
          <span>PLATE 02 / CENTER SPREAD</span>
          <strong>Thirty Against Thirty</strong>
          <p>Original generator-made PointCast plate. The eight gang colors come from the playable field.</p>
        </figcaption>
      </figure>

      <section class="nbr__league" id="league" aria-labelledby="league-title">
        <div class="nbr__section-head">
          <p class="nbr__folio">LEAGUE BOOK / PAGE 022</p>
          <p class="nbr__section-no">03</p>
          <h2 id="league-title">Eight gangs, five jobs, fourteen days, one Bowl.</h2>
        </div>
        <div class="nbr__league-lede">
          <p>
            The Nouns Nation turn made a decisive choice: the visitor would mostly watch.
            Thirty bodies per side move, attack, heal, rally, and collapse without requiring
            sixty manual inputs. The player’s work is closer to fandom—root, scout, understand
            the field, advance the slate, and care when a table row moves.
          </p>
          <dl>
            <div><dt>Gangs</dt><dd>8</dd></div>
            <div><dt>Regular season</dt><dd>14 days</dd></div>
            <div><dt>Matches per day</dt><dd>4</dd></div>
            <div><dt>Standard field</dt><dd>30 v 30</dd></div>
            <div><dt>Playoff cut</dt><dd>Top 4</dd></div>
          </dl>
        </div>

        <div class="nbr__gang-grid">
          {NOUN_BATTLER_GANGS.map((gang, index) => (
            <article class="nbr__gang" style={`--gang:${gang.color};--gang-accent:${gang.accent};`}>
              <div class="nbr__gang-rank">{String(index + 1).padStart(2, "0")}</div>
              <img src={`/games/nouns-nation-battler/assets/noun-${gang.noun}.svg`} alt={`A local Battler Noun representing ${gang.name}.`} width="150" height="150" loading="lazy" />
              <div class="nbr__gang-copy">
                <p>{gang.short} · {gang.mark}</p>
                <h3>{gang.name}</h3>
                <blockquote>“{gang.cry}”</blockquote>
                <p>{gang.scouting}</p>
              </div>
              <dl class="nbr__gang-ratings">
                <div><dt>ATK</dt><dd><i style={`width:${gang.attack}%`}></i><span>{gang.attack}</span></dd></div>
                <div><dt>GRD</dt><dd><i style={`width:${gang.guard}%`}></i><span>{gang.guard}</span></dd></div>
                <div><dt>SPD</dt><dd><i style={`width:${gang.speed}%`}></i><span>{gang.speed}</span></dd></div>
                <div><dt>WRD</dt><dd><i style={`width:${gang.weird}%`}></i><span>{gang.weird}</span></dd></div>
              </dl>
            </article>
          ))}
        </div>

        <div class="nbr__roles">
          <div>
            <p class="nbr__folio">THE FIVE JOBS</p>
            <h3>A team is not sixty copies of the same joke.</h3>
          </div>
          {NOUN_BATTLER_ROLES.map((role) => (
            <article>
              <span>{role.name.slice(0, 1)}</span>
              <h4>{role.name}</h4>
              <b>{role.line}</b>
              <p>{role.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="nbr__lab" id="lab" aria-labelledby="lab-title">
        <div class="nbr__lab-head">
          <div>
            <p class="nbr__folio">INTERACTIVE PRESS BOX / PAGE 034</p>
            <p class="nbr__section-no">04</p>
            <h2 id="lab-title">Put two clubs on tomorrow’s front page.</h2>
          </div>
          <p>
            This annual-only projection uses the scouting ratings printed above. It is deterministic,
            browser-local, and does not write to the real league table. For an actual result, open the field.
          </p>
        </div>

        <div class="nbr__matchup" data-matchup-lab>
          <div class="nbr__team-picker nbr__team-picker--left">
            <label for="nbr-left">HOME DESK</label>
            <select id="nbr-left" data-team-left>
              {NOUN_BATTLER_GANGS.map((gang, index) => (
                <option
                  value={gang.id}
                  selected={index === 0}
                  data-name={gang.name}
                  data-short={gang.short}
                  data-color={gang.color}
                  data-accent={gang.accent}
                  data-noun={gang.noun}
                  data-attack={gang.attack}
                  data-guard={gang.guard}
                  data-speed={gang.speed}
                  data-weird={gang.weird}
                >{gang.name}</option>
              ))}
            </select>
            <img data-left-image src={`/games/nouns-nation-battler/assets/noun-${NOUN_BATTLER_GANGS[0].noun}.svg`} alt="" width="190" height="190" />
            <strong data-left-short>{NOUN_BATTLER_GANGS[0].short}</strong>
          </div>

          <div class="nbr__scoreboard" aria-live="polite">
            <div class="nbr__scoreboard-top">
              <span data-field-label>OPEN FIELD</span>
              <span>PRESS PROJECTION</span>
            </div>
            <div class="nbr__score-main">
              <strong data-left-score>24</strong>
              <span>FINAL</span>
              <strong data-right-score>21</strong>
            </div>
            <div class="nbr__quarters">
              <span>Q1 <b data-quarter="0">7–3</b></span>
              <span>Q2 <b data-quarter="1">3–7</b></span>
              <span>Q3 <b data-quarter="2">7–4</b></span>
              <span>Q4 <b data-quarter="3">7–7</b></span>
            </div>
            <p data-call>Tomato Noggles turns the center lane into tomorrow’s headline.</p>
            <div class="nbr__projection-controls">
              <label for="nbr-field">FIELD</label>
              <select id="nbr-field" data-field>
                {NOUN_BATTLER_FIELDS.map((field) => (
                  <option value={field.id} data-modifier={field.modifier} data-note={field.note}>{field.name}</option>
                ))}
              </select>
              <button type="button" data-run-tape>RUN THE TAPE</button>
            </div>
            <small>Editorial projection · no saved state · no wagering</small>
          </div>

          <div class="nbr__team-picker nbr__team-picker--right">
            <label for="nbr-right">VISITING DESK</label>
            <select id="nbr-right" data-team-right>
              {NOUN_BATTLER_GANGS.map((gang, index) => (
                <option
                  value={gang.id}
                  selected={index === 1}
                  data-name={gang.name}
                  data-short={gang.short}
                  data-color={gang.color}
                  data-accent={gang.accent}
                  data-noun={gang.noun}
                  data-attack={gang.attack}
                  data-guard={gang.guard}
                  data-speed={gang.speed}
                  data-weird={gang.weird}
                >{gang.name}</option>
              ))}
            </select>
            <img data-right-image src={`/games/nouns-nation-battler/assets/noun-${NOUN_BATTLER_GANGS[1].noun}.svg`} alt="" width="190" height="190" />
            <strong data-right-short>{NOUN_BATTLER_GANGS[1].short}</strong>
          </div>
        </div>

        <div class="nbr__field-notes">
          {NOUN_BATTLER_FIELDS.map((field) => (
            <article>
              <b>{field.name}</b>
              <span>{field.note}</span>
            </article>
          ))}
        </div>
        <a class="nbr__watch-real" href="/games/nouns-nation-battler/">OPEN THE REAL FIELD →</a>
      </section>

      <section class="nbr__institution" aria-labelledby="institution-title">
        <div class="nbr__section-head">
          <p class="nbr__folio">MEDIA STUDIES / PAGE 040</p>
          <p class="nbr__section-no">05</p>
          <h2 id="institution-title">The game got interesting when the rooms around it became the game.</h2>
        </div>
        <div class="nbr__institution-grid">
          <div class="nbr__institution-main">
            <p class="nbr__big-lede">
              A league is an agreement to remember one match after the animation ends.
            </p>
            <div class="nbr__columns nbr__columns--two">
              <p>
                The most consequential Battler features are not attacks. They are acts of
                transmission: a Desk Wall link that freezes a local table without overwriting
                somebody else’s save; a report card a host can print; a TV interstitial that
                tells a late viewer why the next fixture matters; a mobile drawer that turns the
                same field into a pocket scorebug.
              </p>
              <p>
                The agent surfaces extend the same principle to machines. A manifest explains
                the routes. A result tracker accepts snapshot JSON or recap text. A claim board
                separates a task from proof that it happened. None of this makes the league
                officially sanctioned or globally persistent. It makes the local-first object
                legible enough to collaborate around.
              </p>
            </div>
          </div>
          <aside class="nbr__version-box">
            <p class="nbr__folio">VERSION WEATHER</p>
            <h3>Why does one page say v39 and another say v42?</h3>
            <p>
              Because Battler is a complex of surfaces, not one bundled release. The embedded
              field, public desk, federation room, agent bench, and operational ledgers kept
              their own labels. The mismatch is not a live-score claim; it is visible archaeology.
            </p>
          </aside>
          <div class="nbr__room-types">
            <article><b>WATCH</b><span>field · TV · mobile · Bowl · Moon</span></article>
            <article><b>REMEMBER</b><span>recap · Desk Wall · reports · archive</span></article>
            <article><b>EXPLAIN</b><span>wiki · prompts · JSON · results desk</span></article>
            <article><b>OPERATE</b><span>production · claims · agents · sponsors</span></article>
          </div>
        </div>
      </section>

      <section class="nbr__pacific" aria-labelledby="pacific-title">
        <div class="nbr__pacific-stamp">P48</div>
        <div>
          <p class="nbr__folio">EXPANSION PAPER / PAGE 046</p>
          <h2 id="pacific-title">The Pacific 48 is not a sequel. It is a different sport in the same newspaper.</h2>
        </div>
        <div class="nbr__pacific-copy">
          <p>
            July’s Pacific edition returned to the intimacy of two cards and a called stat,
            but changed the ritual: five rounds, a set of forty-eight, a browser-local stamp
            book, and a portable Passport card. It could be played without a wallet. Its cards
            and stamps remained receipts rather than minted tokens.
          </p>
          <p>
            That distinction matters. “Noun Battler” now names a family resemblance rather
            than a single ruleset: numbered figures, readable attributes, portable records,
            bright civic graphics, and a recurring urge to turn the score into publishing.
          </p>
          <div>
            <a href="/noun-battler">Read the Pacific 48 launch</a>
            <a href="https://noun-battler.mhoydich.chatgpt.site" target="_blank" rel="noreferrer">Play standalone ↗</a>
          </div>
        </div>
      </section>

      <figure class="nbr__plate nbr__plate--closing">
        <img src={meta.plates[2].path} alt={meta.plates[2].alt} width="1536" height="1024" loading="lazy" />
        <blockquote>
          “The league remembers because somebody built a room for remembering.”
        </blockquote>
        <figcaption>
          <span>PLATE 03 / CLOSING SPREAD</span>
          <strong>The League Remembers</strong>
          <p>Original generator-made PointCast plate.</p>
        </figcaption>
      </figure>

      <section class="nbr__rooms" id="rooms" aria-labelledby="rooms-title">
        <div class="nbr__section-head">
          <p class="nbr__folio">THE COMPLEX / PAGE 052</p>
          <p class="nbr__section-no">06</p>
          <h2 id="rooms-title">Seven doors into the same improbable institution.</h2>
        </div>
        <div class="nbr__route-list">
          {NOUN_BATTLER_ROUTES.map((route, index) => (
            <a href={route.path}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><strong>{route.label}</strong><p>{route.note}</p></div>
              <b>OPEN ↗</b>
            </a>
          ))}
        </div>
        <div class="nbr__colophon">
          <p>
            <b>THE BATTLE RECORD / NOUN BATTLER ANNUAL 2026</b><br />
            Editorial direction: Michael Hoydich + PointCast. Research, design, and implementation:
            PointCast with Codex. Visual plates: original generator-made art, planned and preserved
            through the local poster-image series workflow. Game captures and Noun sprites come from
            the checked-in PointCast browser surfaces.
          </p>
          <p>
            This issue describes a fictional, local-first browser sport. Projections are editorial,
            not official results or betting products. Browser-local league state and shared snapshot
            links do not imply a global live database.
