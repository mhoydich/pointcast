<script>
  const root = document.querySelector("[data-noun-battler-annual]");
  const progress = root?.querySelector("[data-progress]");
  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? window.scrollY / max : 0;
    progress.style.transform = `scaleX(${Math.max(0, Math.min(1, ratio))})`;
  };
  updateProgress();
  window.addEventListener("scroll", updateProgress, { passive: true });

  const lab = root?.querySelector("[data-matchup-lab]");
  if (lab) {
    const leftSelect = lab.querySelector("[data-team-left]");
    const rightSelect = lab.querySelector("[data-team-right]");
    const fieldSelect = lab.querySelector("[data-field]");
    const runButton = lab.querySelector("[data-run-tape]");
    const leftImage = lab.querySelector("[data-left-image]");
    const rightImage = lab.querySelector("[data-right-image]");
    const leftShort = lab.querySelector("[data-left-short]");
    const rightShort = lab.querySelector("[data-right-short]");
    const leftScore = lab.querySelector("[data-left-score]");
    const rightScore = lab.querySelector("[data-right-score]");
    const fieldLabel = lab.querySelector("[data-field-label]");
    const call = lab.querySelector("[data-call]");
    const quarters = [...lab.querySelectorAll("[data-quarter]")];

    const selected = (select) => select?.selectedOptions?.[0];
    const number = (option, key) => Number(option?.dataset?.[key] || 0);
    const hash = (value) => [...value].reduce((total, character, index) => total + character.charCodeAt(0) * (index + 3), 0);
    const splitScore = (score, seed) => {
      const weights = [0.24, 0.21, 0.27, 0.28];
      const values = weights.map((weight, index) => Math.max(0, Math.floor(score * weight + ((seed >> index) % 3) - 1)));
      let delta = score - values.reduce((sum, value) => sum + value, 0);
      let cursor = seed % 4;
      while (delta !== 0) {
        if (delta > 0) {
          values[cursor] += 1;
          delta -= 1;
        } else if (values[cursor] > 0) {
          values[cursor] -= 1;
          delta += 1;
        }
        cursor = (cursor + 1) % 4;
      }
      return values;
    };

    const runProjection = () => {
      const left = selected(leftSelect);
      const right = selected(rightSelect);
      const field = selected(fieldSelect);
      if (!left || !right || !field) return;

      const modifier = field.dataset.modifier || "speed";
      const scoreTeam = (team, opponent) => {
        const base =
          number(team, "attack") * 0.33 +
          number(team, "guard") * 0.25 +
          number(team, "speed") * 0.2 +
          number(team, "weird") * 0.12 +
          number(team, modifier) * 0.1;
        const resistance = number(opponent, "guard") * 0.08;
        return base - resistance;
      };
      const seed = hash(`${left.value}:${right.value}:${field.value}`);
      let leftFinal = Math.round(9 + scoreTeam(left, right) * 0.31 + ((seed % 9) - 4));
      let rightFinal = Math.round(9 + scoreTeam(right, left) * 0.31 + (((seed >> 3) % 9) - 4));
      leftFinal = Math.max(7, Math.min(48, leftFinal));
      rightFinal = Math.max(7, Math.min(48, rightFinal));
      if (leftFinal === rightFinal) {
        if (number(left, modifier) >= number(right, modifier)) leftFinal += 1;
        else rightFinal += 1;
      }

      const leftQuarters = splitScore(leftFinal, seed);
      const rightQuarters = splitScore(rightFinal, seed >> 2);
      quarters.forEach((quarter, index) => {
        quarter.textContent = `${leftQuarters[index]}–${rightQuarters[index]}`;
      });

      const leftWins = leftFinal > rightFinal;
      const winner = leftWins ? left : right;
      const loser = leftWins ? right : left;
      const fieldNote = field.dataset.note || "";
      const verbs = ["outlasts", "edits down", "runs past", "turns back", "reframes"];
      const verb = verbs[seed % verbs.length];

      leftScore.textContent = String(leftFinal);
      rightScore.textContent = String(rightFinal);
      leftShort.textContent = left.dataset.short || "";
      rightShort.textContent = right.dataset.short || "";
      leftImage.src = `/games/nouns-nation-battler/assets/noun-${left.dataset.noun}.svg`;
      rightImage.src = `/games/nouns-nation-battler/assets/noun-${right.dataset.noun}.svg`;
      fieldLabel.textContent = field.textContent?.toUpperCase() || "";
      call.textContent = `${winner.dataset.name} ${verb} ${loser.dataset.name}. ${fieldNote}`;
      lab.style.setProperty("--left", left.dataset.color || "#b63d32");
      lab.style.setProperty("--right", right.dataset.color || "#2865aa");
    };

    runButton?.addEventListener("click", runProjection);
    leftSelect?.addEventListener("change", runProjection);
    rightSelect?.addEventListener("change", runProjection);
    fieldSelect?.addEventListener("change", runProjection);
    runProjection();
  }
</script>

