---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
interface Props {
  author?: string; title: string; description: string; image: string; jsonLd: Record<string,unknown>;
  alternates: {type: string; href: string; title: string}[];
}
const {title,description,image,jsonLd,alternates,author}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://pointcast.xyz');
---
<!doctype html>
<html lang="en" data-pc-layout="block" data-pc-isolated="true">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — PointCast</title>
    <meta name="description" content={description} />
    <meta name="author" content={author || "Codex · UES educational studies"} />
    <meta name="theme-color" content="#f5f3eb" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/json" href="/agents.json" title="PointCast agent manifest" />
    {alternates.map(alt=><link rel="alternate" type={alt.type} href={alt.href} title={alt.title} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:image" content={new URL(image,'https://pointcast.xyz')} />
    <meta property="og:image:alt" content={`${title} · original conceptual vector study`} />
    <meta property="og:image:width" content="960" />
    <meta property="og:image:height" content="700" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body><a class="study-skip" href="#main-content">Skip to content</a><main id="main-content" tabindex="-1"><slot /></main></body>
</html>
<style is:global>
  :root{--pc-font-sans:'Inter Variable',Inter,system-ui,sans-serif;--pc-font-mono:'JetBrains Mono Variable',ui-monospace,monospace}
  *,*::before,*::after{box-sizing:border-box}html,body{margin:0;padding:0;background:#f5f3eb}body{-webkit-font-smoothing:antialiased}img{max-width:100%}
  .study-skip{position:absolute;left:1rem;top:-8rem;z-index:100;background:#202e31;color:white;padding:.8rem 1rem;font:500 1rem/1.5 var(--pc-font-sans)}.study-skip:focus{top:1rem;outline:3px solid #ad7430;outline-offset:3px}
</style>
