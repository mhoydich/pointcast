---
import BlockLayout from './BlockLayout.astro';
import '../styles/nouns-money-studio.css';
const { title, description, edition, active, image } = Astro.props;
const canonical = `https://pointcast.xyz/nouns-money/${active}/`;
const machine = `/nouns-money/${active}.json`;
const nav = [['Art room','/nouns-money/'],['Community','/nouns-money/community/'],['Marketplace','/nouns-money/marketplace/'],['Collect','/nouns-money/collect/'],['Developer workshop','/nouns-money/developers/']];
---
<BlockLayout title={title} description={description} image={image} imageWidth={1200} imageHeight={630} themeColor="#f5edd8" immersive hideAds showNetworkStrip={false} jsonLd={{'@context':'https://schema.org','@type':'CreativeWork',name:title,url:canonical,description,datePublished:'2026-10-02',isAccessibleForFree:true,creator:{'@type':'Organization',name:'Hoydich Astra Advertising'},genre:'Independent art and community concept'}} alternates={[{type:'application/json',href:machine,title:'Read-only concept data'}]}>
<main class="nms" id="main-content">
  <div class="nms-top"><a href="/">POINTCAST ↗</a><span>CH.ESC · {edition}</span><a href={machine}>READ-ONLY JSON ↗</a></div>
  <nav class="nms-nav" aria-label="Nouns Money"><a class="nms-brand" href="/nouns-money/">⌐◨-◨ &nbsp; NOUNS MONEY</a><div>{nav.map(([label,url])=><a href={url} aria-current={url===`/nouns-money/${active}/`?'page':undefined}>{label}</a>)}</div></nav>
  <slot />
  <footer class="nms-footer"><div><strong>Collect something.<br/>Start something.</strong><p>Hoydich Astra Advertising · PointCast</p></div><p>Independent collectible art and community planning. No official Nouns, city, café, bank or postal endorsement. Original Nouns art is CC0; using it conveys no NFT ownership. <a href="/images/nouns-money/nordic-100/provenance.json">Artwork provenance ↗</a></p><a href="#main-content">Back to the top ↑</a></footer>
</main>
</BlockLayout>
