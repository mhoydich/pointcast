---
/**
 * BlockLayout — the single PointCast site-chrome owner.
 *
 * Deliberately minimal: white background, self-hosted Inter + JetBrains
 * Mono (via @fontsource-variable), no serif, no warm palette, no v1 Footer.
 * BLOCKS.md compliance is easier when the layout has fewer opinions to
 * override.
 *
 * Older pages opt into `legacy` to retain their warm palette, fonts, and
 * utility CSS while sharing this layout's dock, room, and burst clients.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import FooterBar from '../components/FooterBar.astro';
import SpellLayer from '../components/SpellLayer.astro';
import CursorRoom from '../components/CursorRoom.astro';
import FreshnessChip from '../components/FreshnessChip.astro';
import TugRope from '../components/TugRope.astro';
import FirstSee from '../components/FirstSee.astro';
import OpenAdRail from '../components/OpenAdRail.astro';
import TezosSessionBridge from '../components/TezosSessionBridge.astro';
import { DISCOVERY_LINKS, SITE_DESCRIPTION, SITE_KEYWORDS, buildIdentityJsonLd } from '../lib/seo';
import legacyStylesheet from '../styles/global.css?url';
import { ClientRouter } from 'astro:transitions';

interface FrameButton {
  label: string;
  action?: 'link' | 'post' | 'post_redirect' | 'mint' | 'tx';
  target?: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  themeColor?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Remove global chrome and networked cursor presence for quiet, self-contained pages. */
  immersive?: boolean;
  /** Keep the sitewide First 100 strip by default; focused landing pages may provide their own live signal bar. */
  showNetworkStrip?: boolean;
  /** Keep confirmation and utility pages out of search results. */
  noindex?: boolean;
  /** JSON-LD blob for agent-legible metadata. Pass null to skip. */
  jsonLd?: Record<string, unknown> | null;
  /** Extra <link rel="alternate"> entries — per-block JSON, RSS per channel, etc. */
  alternates?: { type: string; href: string; title?: string }[];
  /** Preserve the original BaseLayout palette, type, utilities, and body shell. */
  legacy?: boolean;
  /** Suppress only the ad rail. The shared dock remains mounted. */
  hideAds?: boolean;
  /** BaseLayout compatibility no-op; its old implementation never hid navigation. */
  hideNav?: boolean;
  /**
   * Farcaster Frame — if provided, this page renders as a Frame when
   * embedded in Warpcast / any Farcaster client. Up to 4 buttons.
   * Omit to opt out (home feed stays as a normal unfurl, not a Frame).
   *
   * Spec: https://docs.farcaster.xyz/developers/frames/spec
   */
  frame?: {
    /** Frame image (1.91:1 or 1:1). Defaults to the page's og:image. */
    image?: string;
    /** Image aspect ratio — default "1.91:1" (wide) matches our OG cards. */
    aspectRatio?: '1.91:1' | '1:1';
    /** Up to 4 buttons. Most common: single "link" button to the block URL. */
    buttons?: FrameButton[];
  };
}

const {
  title,
  description = SITE_DESCRIPTION,
  image: imageProp,
  themeColor = '#ffffff',
  imageWidth = 1200,
  imageHeight = 630,
  immersive = false,
  showNetworkStrip = true,
  noindex = false,
  jsonLd,
  alternates = [],
  legacy = false,
  hideAds = false,
  hideNav = false,
  frame,
} = Astro.props;

const image = imageProp ?? (legacy ? '/images/og-home-v3.png' : '/images/og/og-home-v5.png');
const siteBase = Astro.site || new URL('https://pointcast.xyz');
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImage = image.startsWith('http') ? image : new URL(image, siteBase).href;
const ogImagePath = new URL(ogImage).pathname.toLowerCase();
const ogImageType = ogImagePath.endsWith('.jpg') || ogImagePath.endsWith('.jpeg')
  ? 'image/jpeg'
  : ogImagePath.endsWith('.webp')
    ? 'image/webp'
    : ogImagePath.endsWith('.gif')
      ? 'image/gif'
      : ogImagePath.endsWith('.svg')
        ? 'image/svg+xml'
        : 'image/png';
const siteTitle = title === 'Home' || title === ''
  ? 'PointCast'
  : legacy
    ? `${title} | PointCast`
    : `${title} — PointCast`;
const identityJsonLd = buildIdentityJsonLd();
---

<!doctype html>
<html lang="en" data-pc-layout={legacy ? 'legacy' : 'block'} data-hide-nav={hideNav ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content="Mike Hoydich" />
    <meta name="creator" content="Mike Hoydich" />
    <meta name="publisher" content="PointCast" />
    <meta name="keywords" content={SITE_KEYWORDS.join(', ')} />
    <meta name="application-name" content="PointCast" />
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="El Segundo, California" />
    <meta name="geo.position" content="33.9192;-118.4165" />
    <meta name="ICBM" content="33.9192, -118.4165" />
    {legacy ? (
      <>
        <meta name="theme-color" content="#f5efe4" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#12110e" media="(prefers-color-scheme: dark)" />
      </>
    ) : (
      <meta name="theme-color" content={themeColor} />
    )}
    <meta name="pc-version" content="v2.1" />
    <meta name="pc-agents-manifest" content="https://pointcast.xyz/agents.json" />
    <meta name="pc-llms" content="https://pointcast.xyz/llms.txt" />
    <meta name="llm:manifest" content="https://pointcast.xyz/agents.json" />
    <meta name="llm:summary" content="https://pointcast.xyz/llms.txt" />
    <meta name="llm:context" content="https://pointcast.xyz/llms-full.txt" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en-US" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    {DISCOVERY_LINKS.map((link) => (
      <link rel={link.rel} type={link.type} href={link.href} title={link.title} />
    ))}

    <!-- Open Graph + Twitter — keep parity with v1 so unfurls don't regress -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={siteTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteTitle} />
    <meta name="twitter:site" content="@mhoydich" />

    {alternates.map((alt) => (
      <link rel="alternate" type={alt.type} href={alt.href} title={alt.title} />
    ))}

    {/* Farcaster Frame — opt-in per page via the `frame` prop. Every
        block gets a single "Open on PointCast" link button by default;
        editionable blocks (MINT/FAUCET) can override with a mint action
        once Frame v2 wallet signing lands in the wild. */}
    {frame && (
      <>
        <meta property="fc:frame" content="vNext" />
        <meta property="fc:frame:image" content={frame.image ?? ogImage} />
        <meta property="fc:frame:image:aspect_ratio" content={frame.aspectRatio ?? '1.91:1'} />
        <meta property="of:accepts:xmtp" content="2024-02-09" />
        {(frame.buttons ?? []).slice(0, 4).map((btn, i) => (
          <>
            <meta property={`fc:frame:button:${i + 1}`} content={btn.label} />
            {btn.action && <meta property={`fc:frame:button:${i + 1}:action`} content={btn.action} />}
            {btn.target && <meta property={`fc:frame:button:${i + 1}:target`} content={btn.target} />}
          </>
        ))}
      </>
    )}

    <slot name="head" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(identityJsonLd)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <title>{siteTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {legacy && <link rel="alternate" type="application/rss+xml" title="PointCast" href="/rss.xml" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    {legacy && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,500&family=Outfit:wght@400&family=Syne:wght@700&family=JetBrains+Mono:wght@400;600;700&display=swap"
          rel="stylesheet"
        />
        <link rel="stylesheet" href={legacyStylesheet} />
      </>
    )}
    <!-- Mood persistence — read pc:mood before paint so the page
         renders tinted from the first frame. Per Mike 2026-04-20 13:55
         PT: "rolling thru the site in that mood." -->
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem('pc:mood');
          if (m) document.documentElement.setAttribute('data-pc-mood', m);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      html[data-pc-mood="chill"]   body { background: linear-gradient(180deg, #f2f8f4 0%, transparent 260px); }
      html[data-pc-mood="hype"]    body { background: linear-gradient(180deg, #fff1f1 0%, transparent 260px); }
      html[data-pc-mood="focus"]   body { background: linear-gradient(180deg, #eef4fa 0%, transparent 260px); }
      html[data-pc-mood="flow"]    body { background: linear-gradient(180deg, #f5f0ff 0%, transparent 260px); }
      html[data-pc-mood="curious"] body { background: linear-gradient(180deg, #fff4ed 0%, transparent 260px); }
      html[data-pc-mood="quiet"]   body { background: linear-gradient(180deg, #f5f5f2 0%, transparent 260px); }
      body.pc-block-shell { padding-bottom: 56px; }
      body.pc-legacy-shell { padding-bottom: 88px; }
      @media (max-width: 680px) {
        body.pc-block-shell { padding-bottom: 64px; }
        body.pc-legacy-shell { padding-bottom: 112px; }
      }
    </style>
    {legacy && <ClientRouter />}
  </head>
  <body class:list={[
    legacy ? 'pc-legacy-shell min-h-screen flex flex-col bg-paper text-ink font-body' : 'pc-block-shell',
  ]}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content" class:list={{ 'flex-1': legacy }} role="main">
      <slot />
    </main>
    {!immersive && (
      <>
        {!hideAds && <OpenAdRail />}
        <FooterBar />
        <TugRope />
        <SpellLayer />
        <CursorRoom />
        <FreshnessChip />
        <FirstSee />
      </>
    )}
    <TezosSessionBridge />
    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>

<style is:global>
  /* v2 tokens — deliberately small. Everything else lives in component-scoped
     styles to avoid global leak across the v1/v2 boundary during rebuild. */
  :root {
    --pc-bg: #ffffff;
    --pc-ink: #12110E;
    --pc-ink-soft: #38373A;
    --pc-ink-muted: #5F5E5A;
    --pc-rule: #C4C2BC;
    --pc-rule-soft: #E5E3DE;
    --pc-accent: #185FA5;
    --pc-font-sans: 'Inter Variable', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --pc-font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html[data-pc-layout='block'],
  html[data-pc-layout='block'] body {
    margin: 0;
    padding: 0;
    background: var(--pc-bg);
    color: var(--pc-ink);
    font-family: var(--pc-font-sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body.pc-block-shell { min-height: 100vh; display: flex; flex-direction: column; }
  body.pc-block-shell > main { flex: 1; }

  /* Two weights only per BLOCKS.md. No 600/700 overrides anywhere in v2. */
  body.pc-block-shell strong, body.pc-block-shell b { font-weight: 500; }

  body.pc-block-shell a { color: var(--pc-accent); text-decoration: none; }
  body.pc-block-shell a:hover { text-decoration: underline; }

  body.pc-block-shell img { max-width: 100%; display: block; }

  body.pc-block-shell .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--pc-ink);
    color: #fff;
    padding: 8px 12px;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  body.pc-block-shell .skip-link:focus { top: 0; }

  body.pc-block-shell ::selection { background: var(--pc-accent); color: #fff; }
</style>
