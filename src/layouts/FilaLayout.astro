---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
interface Props { title: string; description: string; image?: string; imageAlt?: string; imageWidth?: number; imageHeight?: number; published?: string; modified?: string; dataHref?: string; creditsHref?: string; footerNote?: string; }
const { title, description, image: customImage, imageAlt = 'Original interpretive artwork: clay tennis court, cream knit and suspended tennis ball', imageWidth = 1600, imageHeight = 900, published = '2026-10-02', modified = '2026-10-02', dataHref = '/fila.json', creditsHref = '/fila/#credits', footerNote = 'Independent PointCast editorial study · researched 2 October 2026.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://pointcast.xyz');
const image = new URL(customImage || '/images/fila/court-material-study.webp', 'https://pointcast.xyz').href;
const current = Astro.url.pathname.replace(/\/$/, '');
const jsonLd = { '@context':'https://schema.org', '@type':'Article', headline:title, description, url:canonical.href, datePublished:published, dateModified:modified, author:{'@type':'Organization',name:'PointCast editorial'}, publisher:{'@type':'Organization',name:'PointCast'}, image, about:{'@type':'Brand',name:'FILA'}, isAccessibleForFree:true };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — PointCast</title><meta name="description" content={description} /><meta name="theme-color" content="#efeade" /><meta name="author" content="PointCast editorial / Codex" />
    <link rel="canonical" href={canonical} /><link rel="alternate" type="application/json" href={dataHref} title="FILA study, sources and concept data" />
    <meta property="og:type" content="article" /><meta property="og:title" content={`${title} — PointCast`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={image} /><meta property="og:image:type" content="image/webp" /><meta property="og:image:width" content={imageWidth} /><meta property="og:image:height" content={imageHeight} /><meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={image} /><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to exhibition</a>
    <header class="exhibition-nav"><a class="pointcast" href="/">POINTCAST <span> / STUDIES</span></a><nav aria-label="FILA exhibition"><a href="/fila/#history">History</a><a href="/fila/2027/" aria-label="2027 lookbook" aria-current={current === '/fila/2027' ? 'page' : undefined}>2027<span class="nav-long"> lookbook</span></a><a href="/fila/el-segundo/" aria-current={current === '/fila/el-segundo' ? 'page' : undefined}>El Segundo<span class="nav-long"> v2</span></a><a href="/fila/#sources">Sources</a></nav></header>
    <main id="main"><slot /></main>
    <footer class="study-footer"><a href="/fila/">FILA / From thread to court to culture</a><p>{footerNote}<br />FILA is a trademark of its respective owner. No affiliation or endorsement.</p><div><a href={creditsHref}>Image credits</a><a href={dataHref}>Study data ↗</a><a href="/fila/el-segundo/">El Segundo v2 ↗</a><a href="/">Back to PointCast ↗</a></div></footer>
  </body>
</html>
<style is:global>
  .exhibition-nav [aria-current=page]{text-decoration:underline;text-underline-offset:5px}@media(max-width:700px){.exhibition-nav nav[aria-label]{gap:10px}.exhibition-nav .pointcast span,.nav-long{display:none}}
  .archive-room :focus-visible,.study-footer :focus-visible{outline-color:var(--cream)}
  :root{--cream:#efeade;--navy:#12223b;--red:#af3039;--gutter:5vw;color-scheme:light}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:70px}body{margin:0;background:var(--cream);color:var(--navy);font-family:'Inter Variable',Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}button,select{font-family:inherit}img{max-width:100%}figure{margin:0}p{line-height:1.6}h1,h2,h3{font-weight:600}::selection{background:var(--red);color:var(--cream)}[hidden]{display:none!important}:focus-visible{outline:3px solid var(--red);outline-offset:5px}.skip{position:fixed;left:12px;top:-80px;z-index:20;padding:14px;background:var(--navy);color:var(--cream)}.skip:focus{top:12px}.exhibition-nav{height:64px;padding:0 var(--gutter);display:flex;justify-content:space-between;gap:20px;align-items:center;border-bottom:1px solid #12223b55;position:sticky;top:0;z-index:10;background:#efeadef2;backdrop-filter:blur(10px)}.pointcast{text-decoration:none;font-family:'JetBrains Mono Variable',monospace;font-size:12px;letter-spacing:.045em;font-weight:600;white-space:nowrap}.pointcast span{font-weight:400;color:#4f5b6e}.exhibition-nav nav{display:flex;gap:25px;font-family:'JetBrains Mono Variable',monospace;font-size:10px}.exhibition-nav nav a{text-decoration:none;min-height:44px;display:flex;align-items:center}.exhibition-nav nav a:hover{text-decoration:underline;text-underline-offset:5px}.study-footer{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding:45px var(--gutter);background:var(--navy);color:var(--cream)}.study-footer>a{font-size:20px;text-decoration:none;letter-spacing:-.04em}.study-footer p{font-size:10px;margin:0;line-height:1.8}.study-footer>div{grid-column:1/-1;display:flex;gap:25px;font-family:'JetBrains Mono Variable',monospace;font-size:10px}.eyebrow{font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:.055em}.section-label{display:flex;justify-content:space-between;gap:20px;font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:.04em}.reveal{animation:plate-enter .8s both}@keyframes plate-enter{from{opacity:.6;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}@media(max-width:600px){:root{--gutter:5vw}.exhibition-nav{height:58px;gap:10px}.pointcast{font-size:10px}.pointcast span{display:none}.exhibition-nav nav{font-size:9px;gap:15px}.study-footer{grid-template-columns:1fr;padding:32px var(--gutter);gap:20px}.study-footer>div{flex-wrap:wrap;gap:20px}.section-label,.eyebrow{font-size:9px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{animation:none}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
