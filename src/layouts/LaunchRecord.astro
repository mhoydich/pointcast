---
import { labelLaunchTables } from '../lib/loom/launch-record-table.mjs';

const { frontmatter } = Astro.props;
const records = labelLaunchTables(await Astro.slots.render('default'));
const page = Astro.url.pathname.replace(/\/$/, '');
const pages = [
  { href: '/loom/receipts', title: 'Receipts' },
  { href: '/loom/receipts/routing', title: 'Routing' },
  { href: '/loom/receipts/tally', title: 'Tally' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} · The Loom</title>
    <meta name="description" content={frontmatter.description} />
  </head>
  <body>
    <header><a href="/loom">The Loom</a><nav aria-label="Launch records">
      {pages.map(({ href, title }) => (
        <a href={href} aria-current={page === href ? 'page' : undefined}>{title}</a>
      ))}
    </nav></header>
    <main class:list={{ tally: page.endsWith('/tally') }} set:html={records} />
  </body>
</html>
<style is:global>
  :root { font: 17px/1.55 system-ui, sans-serif; color: #212723; background: #faf9f5; }
  body { max-width: 68rem; margin: auto; padding: 1rem clamp(1rem, 4vw, 3rem) 4rem; }
  header, nav { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem; }
  header { border-bottom: 1px solid #91998d; padding: .6rem 0 1rem; justify-content: space-between; }
  header > a, h1, h2 { font-family: Georgia, serif; }
  header > a { font-size: 1.5rem; }
  a { color: #235943; text-underline-offset: .16em; }
  h1 { font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.1; margin-bottom: 1rem; }
  p, li { max-width: 78ch; }
  table { border-collapse: collapse; font-size: .94rem; }
  th, td { text-align: left; vertical-align: top; border-bottom: 1px solid #c4c9c2; padding: .65rem .8rem .65rem 0; overflow-wrap: anywhere; }
  th { color: #435448; }
  code { overflow-wrap: anywhere; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; }
  nav a[aria-current] { color: inherit; font-weight: 700; text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid #235943; outline-offset: 3px; }

  @media screen and (max-width: 45rem) {
    table[role="table"], tbody[role="rowgroup"], tr[role="row"], th[scope="row"], td[role="cell"] { display: block; }
    table { margin-block: 1.5rem; }
    thead[role="rowgroup"] { position: absolute; clip-path: inset(50%); width: 1px; height: 1px; overflow: hidden; }
    tbody tr { border-top: 1px solid #91998d; padding: 1rem 0 1.3rem; }
    th[scope="row"], td { border: 0; padding: 0; }
    th[scope="row"] { color: #212723; font: bold 1.35rem/1.25 Georgia, serif; }
    td { margin-top: .85rem; }
    td[data-field]::before {
      display: block; color: #435448; font-size: .875rem; font-weight: 650;
      content: attr(data-field);
      content: attr(data-field) / "";
    }
    .tally td { display: flex; gap: 1rem; align-items: baseline; justify-content: space-between; text-align: right; }
    .tally td::before { text-align: left; }
  }
</style>
