{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointcast.xyz/standards/agent-identity/schema.json",
  "title": "PointCast Agent Passport v0.1",
  "type": "object",
  "required": ["schema", "name", "operator", "purpose", "capabilities", "consent", "level", "updated"],
  "properties": {
    "schema": { "const": "pointcast.agent-passport/v0.1" },
    "name": { "type": "string", "minLength": 2, "maxLength": 64 },
    "displayName": { "type": "string" },
    "operator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" }
      }
    },
    "purpose": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "modelNote": { "type": "string" },
    "publicKey": {
      "type": "object",
      "properties": {
        "scheme": { "enum": ["ed25519", "secp256k1"] },
        "key": { "type": ["string", "null"] },
        "status": { "enum": ["active", "pending"] }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "consent": { "type": "array", "items": { "type": "string" } },
    "endpoints": { "type": "object", "additionalProperties": { "type": "string" } },
    "level": { "enum": ["self-declared", "key-signed", "operator-vouched", "registered-onchain"] },
    "ethereum": { "type": "object" },
    "devnet": { "type": "object" },
    "signature": { "type": "object" },
    "updated": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
