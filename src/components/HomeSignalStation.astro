---
import { getHomeSignalStation, type HomeSignalStation } from '../lib/bell-signal-home';

interface Props {
  station: HomeSignalStation['id'];
}

const { station: stationId } = Astro.props;
const station = getHomeSignalStation(stationId);
if (!station) throw new Error(`Unknown Bell & Signal homepage station: ${stationId}`);
---

<aside
  class:list={['home-signal', `home-signal--${station.tone}`]}
  id={`bell-signal-${station.id}`}
  data-home-signal-station
  aria-labelledby={`bell-signal-${station.id}-title`}
>
  <div class="home-signal__identity">
    <p class="home-signal__catalog">BELL &amp; SIGNAL · CATALOG No. 2</p>
    <h2 id={`bell-signal-${station.id}-title`}>{station.label}</h2>
    <p>{station.note}</p>
  </div>

  <div class="home-signal__keys" role="group" aria-label={`${station.label} castings`}>
    {station.castings.map((casting) => (
      <button
        class="home-signal__key"
        type="button"
        data-home-casting={casting.id}
        data-home-casting-name={casting.name}
        data-home-casting-duration={casting.durationMs}
        aria-label={`Strike ${casting.id} ${casting.name}. ${casting.note}`}
      >
        <span class="home-signal__id">{casting.id}</span>
        <strong>{casting.name}</strong>
        <span class="home-signal__note">{casting.note}</span>
        <span class="home-signal__state" aria-hidden="true">{casting.wet ? 'WET' : 'DRY'} · STRIKE</span>
      </button>
    ))}
  </div>

  <div class="home-signal__foot">
    <span class="home-signal__status" data-home-signal-status aria-live="polite">quiet floor · choose one</span>
    <a href="/bell-and-signal">visit the foundry →</a>
  </div>
</aside>

<script>
  import { playHomeCasting, quietHomeCastings } from '../lib/bell-signal-home-audio';

  type SignalWindow = Window & typeof globalThis & { __pointcastHomeSignalsBound?: boolean };
  const signalWindow = window as SignalWindow;

  if (!signalWindow.__pointcastHomeSignalsBound) {
    signalWindow.__pointcastHomeSignalsBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>('[data-home-casting]');
      if (!button) return;

      const id = button.dataset.homeCasting;
      const name = button.dataset.homeCastingName || 'casting';
      const duration = Number(button.dataset.homeCastingDuration || 1200);
      const station = button.closest<HTMLElement>('[data-home-signal-station]');
      const status = station?.querySelector<HTMLElement>('[data-home-signal-status]');
      if (!id) return;

      document.querySelectorAll('[data-home-casting].is-sounding').forEach((item) => item.classList.remove('is-sounding'));
      document.querySelectorAll<HTMLElement>('[data-home-signal-status]').forEach((item) => {
        item.textContent = 'quiet floor · choose one';
      });

      try {
        playHomeCasting(id);
        button.classList.add('is-sounding');
        if (status) status.textContent = `${id} · ${name} · sounding`;
        window.setTimeout(() => {
          button.classList.remove('is-sounding');
          if (status?.textContent?.includes(id)) status.textContent = 'rest restored · choose another';
        }, duration);
      } catch {
        if (status) status.textContent = 'audio unavailable in this browser';
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) quietHomeCastings();
    });
  }
</script>

<style>
  .home-signal {
    --signal: #b36b19;
    --signal-soft: #fff1d4;
    --signal-dark: #3b240d;
    display: grid;
    grid-template-columns: minmax(150px, .72fr) minmax(420px, 2.2fr);
    gap: 8px 14px;
    margin: 12px 0;
    padding: 9px;
    border: 1px solid color-mix(in srgb, var(--signal) 74%, #111);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--signal-soft) 86%, white), #fff 52%, color-mix(in srgb, var(--signal-soft) 62%, white));
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--signal) 18%, transparent);
    color: var(--signal-dark);
  }

  .home-signal--green { --signal: #0f6e56; --signal-soft: #dff4e9; --signal-dark: #123f34; }
  .home-signal--blue { --signal: #185fa5; --signal-soft: #dfedfa; --signal-dark: #143b62; }
  .home-signal--violet { --signal: #6b4ba5; --signal-soft: #eee6fb; --signal-dark: #3e285f; }
  .home-signal--ink { --signal: #393731; --signal-soft: #eeece4; --signal-dark: #1f1e1a; }

  .home-signal__identity {
    padding: 8px 10px;
    border-left: 5px solid var(--signal);
  }

  .home-signal__catalog,
  .home-signal__identity > p,
  .home-signal__foot,
  .home-signal__key {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
  }

  .home-signal__catalog {
    margin: 0 0 4px;
    color: var(--signal);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .home-signal h2 {
    margin: 0;
    font-family: var(--pc-font-sans, Inter, sans-serif);
    font-size: clamp(18px, 2vw, 27px);
    font-weight: 650;
    letter-spacing: -.025em;
  }

  .home-signal__identity > p:last-child {
    margin: 4px 0 0;
    color: color-mix(in srgb, var(--signal-dark) 67%, transparent);
    font-size: 10px;
    line-height: 1.35;
  }

  .home-signal__keys {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
  }

  .home-signal__key {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3px 8px;
    min-width: 0;
    min-height: 82px;
    padding: 9px 10px;
    border: 1px solid color-mix(in srgb, var(--signal) 36%, #777);
    border-radius: 0;
    background: rgba(255,255,255,.78);
    color: var(--signal-dark);
    text-align: left;
    cursor: pointer;
    transition: transform 110ms ease, background 110ms ease, box-shadow 110ms ease;
  }

  .home-signal__key:hover,
  .home-signal__key:focus-visible {
    background: #fff;
    box-shadow: inset 0 -3px 0 var(--signal);
    outline: none;
  }

  .home-signal__key:active { transform: translateY(2px); }
  .home-signal__key.is-sounding {
    background: var(--signal);
    color: white;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--signal) 32%, transparent);
  }

  .home-signal__id {
    color: var(--signal);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .is-sounding .home-signal__id { color: white; }
  .home-signal__key strong { min-width: 0; font-size: 11px; line-height: 1; }
  .home-signal__note {
    grid-column: 1 / -1;
    color: color-mix(in srgb, currentColor 68%, transparent);
    font-size: 8.5px;
    line-height: 1.28;
  }

  .home-signal__state {
    grid-column: 1 / -1;
    align-self: end;
    color: var(--signal);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .is-sounding .home-signal__state { color: white; }

  .home-signal__foot {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 0 5px;
    color: color-mix(in srgb, var(--signal-dark) 64%, transparent);
    font-size: 8px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .home-signal__foot a { color: var(--signal); font-weight: 700; }

  @media (max-width: 760px) {
    .home-signal { grid-template-columns: 1fr; }
    .home-signal__keys { grid-template-columns: 1fr; }
    .home-signal__key { min-height: 68px; }
    .home-signal__foot { grid-column: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-signal__key { transition: none; }
  }
</style>
