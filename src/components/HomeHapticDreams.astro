---
/**
 * HomeHapticDreams — front-door lead for the Haptic Dreams release
 * (Signal Run + Open Studio, PR #977, 2026-08-15). Block 0573.
 */
import { signalActionLabel, SIGNAL_RUN_DURATION_SECONDS } from '../lib/pointcast-haptic-dreams-signal-run';

const gestures = [
  { key: 'R', name: 'RUN', label: signalActionLabel.advance },
  { key: 'P', name: 'PASS / KICK', label: signalActionLabel.arc },
  { key: 'X', name: 'TURNOVER', label: signalActionLabel.reverse },
  { key: 'T', name: 'TOUCHDOWN', label: signalActionLabel.chorus },
  { key: 'M', name: 'MISS / FINAL', label: signalActionLabel.settle },
];
const minutes = Math.round(SIGNAL_RUN_DURATION_SECONDS / 60);
---

<section class="haptic-lead" aria-labelledby="haptic-lead-title">
  <div class="haptic-lead__flag">
    <span>NEW · BLOCK 0573 · CH.SPN</span>
    <span>HAPTIC DREAMS / SIGNAL RUN + OPEN STUDIO</span>
  </div>
  <div class="haptic-lead__grid">
    <a class="haptic-lead__art" href="/haptic-dreams/play" aria-label="Play Signal Run">
      <img
        src="/images/pointcast-haptic-dreams/social-card.png"
        alt="Saturday Kingdom title over Jon Snow's Art Deco KansasDAO lion and train"
        width="1200"
        height="630"
        loading="eager"
      />
      <span>KEEP THE SIGNAL CLEAR ↗</span>
    </a>
    <div class="haptic-lead__copy">
      <p>MICHIGAN 13 · OHIO STATE 10 · NOV 30 2024 · FROZEN</p>
      <h2 id="haptic-lead-title">Feel the <em>game.</em></h2>
      <p class="haptic-lead__dek">
        Signal Run turns one archival football game into a {minutes}-minute gesture test:
        swipe with the run, hold and release the arc, reverse the turnover, answer the
        touchdown in chorus. Your fidelity changes the signal, never the history.
      </p>
      <div class="haptic-lead__actions">
        <a href="/haptic-dreams/play">Play Signal Run <span aria-hidden="true">↗</span></a>
        <a href="/haptic-dreams/build">Open Studio ledger</a>
        <a href="/haptic-dreams">Saturday Kingdom</a>
      </div>
      <p class="haptic-lead__boundary">SOURCED REPLAY · NOT LIVE · BEST RUN SAVED IN YOUR BROWSER · NO ACCOUNT</p>
    </div>
  </div>
  <ol aria-label="Signal Run gesture grammar">
    {gestures.map((g) => (
      <li><span>{g.key}</span><strong>{g.name}</strong><small>{g.label}</small></li>
    ))}
  </ol>
</section>

<style>
  .haptic-lead {
    --hd-navy: #0b1730;
    --hd-gold: #e2b842;
    --hd-cream: #f3ecd8;
    --hd-red: #b8322e;
    margin-top: 16px;
    border: 2px solid var(--hd-navy);
    color: var(--hd-cream);
    background: var(--hd-navy);
    box-shadow: 7px 7px 0 var(--hd-gold);
    overflow: hidden;
  }
  .haptic-lead__flag {
    display: flex; justify-content: space-between; gap: 16px; padding: 9px 12px;
    border-bottom: 1px solid rgba(243,236,216,.3);
    font: 700 9px/1.2 var(--pc-font-mono); letter-spacing: .1em;
  }
  .haptic-lead__flag span:first-child { color: var(--hd-gold); }
  .haptic-lead__grid { display: grid; grid-template-columns: minmax(460px, 1.15fr) minmax(320px, .85fr); min-height: 480px; }
  .haptic-lead__art { position: relative; display: flex; align-items: center; min-width: 0; padding: clamp(16px, 3vw, 36px); background: #101f40; border-right: 1px solid rgba(243,236,216,.3); }
  .haptic-lead__art img { width: 100%; height: auto; border: 1px solid var(--hd-gold); box-shadow: 12px 12px 0 rgba(0,0,0,.35); }
  .haptic-lead__art span { position: absolute; left: clamp(24px, 4vw, 50px); bottom: clamp(24px, 4vw, 50px); padding: 10px 12px; border: 1px solid var(--hd-navy); background: var(--hd-gold); color: var(--hd-navy); font: 800 9px var(--pc-font-mono); letter-spacing: .08em; }
  .haptic-lead__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 5vw, 66px); }
  .haptic-lead__copy > p:first-child { margin: 0 0 18px; color: var(--hd-gold); font: 700 9px var(--pc-font-mono); letter-spacing: .13em; }
  .haptic-lead h2 { margin: 0; font-size: clamp(60px, 7.6vw, 112px); font-weight: 730; line-height: .8; letter-spacing: -.07em; }
  .haptic-lead h2 em { color: var(--hd-gold); font-style: normal; }
  .haptic-lead__dek { max-width: 520px; margin: 28px 0 0; font-size: clamp(17px, 1.8vw, 22px); line-height: 1.32; }
  .haptic-lead__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .haptic-lead__actions a { padding: 12px 14px; border: 1px solid var(--hd-cream); color: var(--hd-cream); font: 700 9px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .haptic-lead__actions a:first-child { border-color: var(--hd-gold); color: var(--hd-navy); background: var(--hd-gold); }
  .haptic-lead__actions a:hover { border-color: var(--hd-red); color: var(--hd-cream); background: var(--hd-red); text-decoration: none; }
  .haptic-lead__boundary { margin: 20px 0 0; color: rgba(243,236,216,.55); font: 8px var(--pc-font-mono); letter-spacing: .1em; }
  .haptic-lead ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; padding: 0; border-top: 1px solid rgba(243,236,216,.3); list-style: none; }
  .haptic-lead li { min-height: 70px; display: grid; align-content: center; gap: 4px; padding: 10px 12px; border-right: 1px solid rgba(243,236,216,.16); }
  .haptic-lead li:last-child { border-right: 0; }
  .haptic-lead li span { color: var(--hd-gold); font: 800 12px var(--pc-font-mono); }
  .haptic-lead li strong { font-size: 11px; line-height: 1.2; letter-spacing: .04em; }
  .haptic-lead li small { color: rgba(243,236,216,.6); font: 8px var(--pc-font-mono); letter-spacing: .08em; }
  @media (max-width: 880px) {
    .haptic-lead__grid { grid-template-columns: 1fr; }
    .haptic-lead__art { border-right: 0; border-bottom: 1px solid rgba(243,236,216,.3); }
    .haptic-lead ol { grid-template-columns: repeat(3, 1fr); }
    .haptic-lead li:nth-child(3n) { border-right: 0; }
    .haptic-lead li:nth-child(-n+3) { border-bottom: 1px solid rgba(243,236,216,.16); }
  }
  @media (max-width: 560px) {
    .haptic-lead { box-shadow: 4px 4px 0 var(--hd-gold); }
    .haptic-lead__flag { flex-direction: column; }
    .haptic-lead__grid { min-height: 0; }
    .haptic-lead__copy { padding: 34px 18px; }
    .haptic-lead__art { padding: 14px; }
    .haptic-lead__art span { left: 22px; bottom: 22px; }
    .haptic-lead ol { grid-template-columns: repeat(2, 1fr); }
    .haptic-lead li:nth-child(3n) { border-right: 1px solid rgba(243,236,216,.16); }
    .haptic-lead li:nth-child(2n) { border-right: 0; }
    .haptic-lead li:nth-child(-n+4) { border-bottom: 1px solid rgba(243,236,216,.16); }
  }
</style>
