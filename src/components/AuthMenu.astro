---
interface Props {
  autoOpen?: boolean;
}

const { autoOpen = false } = Astro.props;
---

<div
  class="auth-menu"
  data-auth-menu
  data-auth-auto-open={autoOpen ? 'true' : undefined}
>
  <button
    type="button"
    class="auth-menu__trigger"
    aria-haspopup="menu"
    aria-expanded="false"
    data-auth-trigger
  >
    <svg class="auth-menu__signal" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
      <circle cx="6" cy="6" r="3"></circle>
    </svg>
    <span data-auth-trigger-label>sign in</span>
  </button>

  <div
    class="auth-menu__panel hidden"
    role="menu"
    data-auth-panel
  >
    <div class="auth-menu__account hidden" data-auth-account>
      <p class="auth-menu__eyebrow">signed in as</p>
      <p class="auth-menu__account-name" data-auth-user-name>—</p>
      <p class="auth-menu__account-meta" data-auth-user-meta>—</p>
      <button
        type="button"
        class="auth-menu__logout"
        data-auth-logout
      >
        Logout
      </button>
    </div>

    <div class="auth-menu__providers">
      <button
        data-provider="passkey"
        type="button"
        class="auth-menu__provider auth-menu__provider--wide"
        role="menuitem"
      >
        <span class="auth-menu__provider-code">key</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Passkey</p>
          <p class="auth-menu__provider-detail">Face ID / Touch ID · no browser memory required</p>
        </div>
        <span class="auth-menu__badge auth-menu__badge--live">live</span>
      </button>

      <form class="auth-menu__email auth-menu__provider--wide" data-auth-email-form role="none">
        <span class="auth-menu__provider-code" aria-hidden="true">@</span>
        <label class="auth-menu__email-body">
          <span class="auth-menu__provider-name">Email me a link</span>
          <span class="auth-menu__provider-detail">Single use · expires in 15 minutes</span>
          <span class="auth-menu__email-controls">
            <input
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder="you@example.com"
              required
              data-auth-email
            />
            <button type="submit" data-auth-email-submit>send</button>
          </span>
        </label>
      </form>

      <button
        data-provider="kukai"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
      >
        <span class="auth-menu__provider-code">tz</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Kukai</p>
          <p class="auth-menu__provider-detail">Tezos · then choose Use Browser</p>
        </div>
      </button>

      <button
        data-provider="google"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
      >
        <span class="auth-menu__provider-code">id</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Google</p>
          <p class="auth-menu__provider-detail">Verified PointCast account</p>
        </div>
        <span class="auth-menu__badge auth-menu__badge--live">live</span>
      </button>

      <button
        data-provider="apple"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
      >
        <span class="auth-menu__provider-code">id</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Apple</p>
          <p class="auth-menu__provider-detail">OAuth redirect</p>
        </div>
        <span class="auth-menu__badge">soon</span>
      </button>

      <button
        data-provider="metamask"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
      >
        <span class="auth-menu__provider-code">eth</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">MetaMask</p>
          <p class="auth-menu__provider-detail">SIWE · EVM</p>
        </div>
        <span class="auth-menu__badge">soon</span>
      </button>

      <button
        data-provider="phantom"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
      >
        <span class="auth-menu__provider-code">sol</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Phantom</p>
          <p class="auth-menu__provider-detail">SIWS · Solana</p>
        </div>
        <span class="auth-menu__badge">soon</span>
      </button>

      <button
        data-provider="temple"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
        disabled
      >
        <span class="auth-menu__provider-code">tz</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Temple</p>
          <p class="auth-menu__provider-detail">Tezos wallet</p>
        </div>
        <span class="auth-menu__badge">soon</span>
      </button>

      <button
        data-provider="umami"
        type="button"
        class="auth-menu__provider"
        role="menuitem"
        disabled
      >
        <span class="auth-menu__provider-code">tz</span>
        <div class="auth-menu__provider-body">
          <p class="auth-menu__provider-name">Umami</p>
          <p class="auth-menu__provider-detail">Tezos wallet</p>
        </div>
        <span class="auth-menu__badge">soon</span>
      </button>
    </div>

    <div class="auth-menu__footer">
      <p class="auth-menu__status" data-auth-status>
        passkey, email, kukai + google are live. other providers remain previews.
      </p>
    </div>
  </div>
</div>

<style>
  .auth-menu {
    position: relative;
    display: inline-flex;
    color: #20242a;
    font-family: var(--pc-font-sans, Inter, system-ui, sans-serif);
  }

  .auth-menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 7px 11px;
    border: 1px solid #c8cdd2;
    border-radius: 4px;
    background: #fff;
    color: #303941;
    font: 700 10px/1 var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: 0;
    text-transform: uppercase;
    cursor: pointer;
  }

  .auth-menu__trigger:hover,
  .auth-menu__trigger[aria-expanded='true'] {
    border-color: #181818;
    background: #181818;
    color: #fff;
  }

  .auth-menu__signal { width: 12px; height: 12px; color: #d19a2a; }

  .auth-menu__panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 90;
    width: min(320px, calc(100vw - 32px));
    max-height: min(440px, calc(100vh - 96px));
    overflow: auto;
    border: 1px solid #bcc3ca;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(24, 30, 36, 0.22);
  }

  .auth-menu__panel.hidden,
  .auth-menu__account.hidden { display: none !important; }

  .auth-menu__account { padding: 14px; border-bottom: 1px solid #d9dde2; background: #f5f7f9; }
  .auth-menu__eyebrow,
  .auth-menu__account-meta,
  .auth-menu__provider-code,
  .auth-menu__provider-detail,
  .auth-menu__badge,
  .auth-menu__status {
    margin: 0;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .auth-menu__eyebrow { color: #6a747e; font-size: 8px; }
  .auth-menu__account-name { margin: 4px 0 0; font-size: 15px; font-weight: 700; }
  .auth-menu__account-meta { margin-top: 3px; color: #6a747e; font-size: 8px; }
  .auth-menu__logout {
    width: 100%;
    margin-top: 12px;
    padding: 8px 10px;
    border: 1px solid #c8cdd2;
    border-radius: 4px;
    background: #fff;
    color: #303941;
    font: 700 9px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
    cursor: pointer;
  }

  .auth-menu__providers { display: grid; grid-template-columns: 1fr 1fr; }
  .auth-menu__provider {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px;
    min-width: 0;
    min-height: 74px;
    padding: 12px;
    border: 0;
    border-right: 1px solid #e0e3e6;
    border-bottom: 1px solid #e0e3e6;
    background: #fff;
    color: #20242a;
    text-align: left;
    cursor: pointer;
  }
  .auth-menu__provider:nth-child(2n) { border-right: 0; }
  .auth-menu__provider--wide { grid-column: 1 / -1; border-right: 0; }
  .auth-menu__provider:hover:not(:disabled) { background: #f3f7fa; }
  .auth-menu__provider:disabled { color: #7d858d; cursor: not-allowed; opacity: 0.58; }
  .auth-menu__provider-code {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 1px solid #ccd2d7;
    border-radius: 3px;
    color: #145aa4;
    font-size: 9px;
    font-weight: 800;
  }
  .auth-menu__provider-body { min-width: 0; }
  .auth-menu__provider-name { margin: 1px 0 0; font-size: 12px; font-weight: 700; line-height: 1.15; }
  .auth-menu__provider-detail { margin-top: 4px; color: #6b7680; font-size: 7px; line-height: 1.35; }
  .auth-menu__badge {
    padding: 3px 4px;
    border: 1px solid #e2c17f;
    border-radius: 3px;
    background: #fff8e9;
    color: #8a6420;
    font-size: 7px;
  }
  .auth-menu__badge--live {
    border-color: #9bc9ad;
    background: #edf9f1;
    color: #246941;
  }
  .auth-menu__email {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 8px;
    padding: 12px;
    border-bottom: 1px solid #e0e3e6;
    background: #fff;
  }
  .auth-menu__email-body { display: grid; min-width: 0; }
  .auth-menu__email-controls { display: flex; gap: 5px; margin-top: 8px; }
  .auth-menu__email-controls input {
    min-width: 0;
    width: 100%;
    padding: 7px 8px;
    border: 1px solid #c8cdd2;
    border-radius: 3px;
    font: 500 10px/1 var(--pc-font-mono, ui-monospace, monospace);
  }
  .auth-menu__email-controls button {
    padding: 7px 9px;
    border: 1px solid #181818;
    border-radius: 3px;
    background: #181818;
    color: #fff;
    font: 700 8px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
    cursor: pointer;
  }
  .auth-menu__footer { padding: 10px 12px; background: #f5f7f9; }
  .auth-menu__status { min-height: 12px; color: #68737e; font-size: 8px; line-height: 1.45; }

  @media (max-width: 460px) {
    .auth-menu__panel { position: fixed; top: auto; right: 12px; bottom: 52px; left: 12px; width: auto; }
  }
</style>

<script>
  import type { AuthProvider, PointCastUser } from '../lib/auth/types';
  import {
    getSession,
    loginWithApple,
    loginWithGoogle,
    loginWithKukai,
    loginWithMetaMask,
    loginWithPasskey,
    loginWithPhantom,
    logout,
    requestEmailMagicLink,
  } from '../lib/auth/client';

  type AuthMenuWindow = Window & {
    __pointCastAuthMenuAbort?: AbortController;
    __pointCastAuthMenuPageLoadInstalled?: boolean;
  };

  const actions: Partial<Record<AuthProvider, () => Promise<PointCastUser | null>>> = {
    passkey: loginWithPasskey,
    kukai: loginWithKukai,
    google: loginWithGoogle,
    apple: loginWithApple,
    metamask: loginWithMetaMask,
    phantom: loginWithPhantom,
    temple: async () => {
      throw new Error('Temple sign-in is not scaffolded yet.');
    },
    umami: async () => {
      throw new Error('Umami sign-in is not scaffolded yet.');
    },
  };

  const providerLabels: Record<AuthProvider, string> = {
    passkey: 'Passkey',
    email: 'Email',
    kukai: 'Kukai',
    google: 'Google',
    apple: 'Apple',
    metamask: 'MetaMask',
    phantom: 'Phantom',
    temple: 'Temple',
    umami: 'Umami',
  };

  function closeMenu(root: HTMLElement): void {
    const trigger = root.querySelector('[data-auth-trigger]') as HTMLButtonElement | null;
    const panel = root.querySelector('[data-auth-panel]') as HTMLElement | null;
    panel?.classList.add('hidden');
    trigger?.setAttribute('aria-expanded', 'false');
  }

  function openMenu(root: HTMLElement): void {
    const trigger = root.querySelector('[data-auth-trigger]') as HTMLButtonElement | null;
    const panel = root.querySelector('[data-auth-panel]') as HTMLElement | null;
    panel?.classList.remove('hidden');
    trigger?.setAttribute('aria-expanded', 'true');
  }

  function setStatus(root: HTMLElement, message: string): void {
    const status = root.querySelector('[data-auth-status]');
    if (status) status.textContent = message;
  }

  function renderSession(
    root: HTMLElement,
    user: PointCastUser | null,
    announce = true,
  ): void {
    const triggerLabel = root.querySelector('[data-auth-trigger-label]');
    const account = root.querySelector('[data-auth-account]') as HTMLElement | null;
    const userName = root.querySelector('[data-auth-user-name]');
    const userMeta = root.querySelector('[data-auth-user-meta]');

    if (user) {
      if (triggerLabel) triggerLabel.textContent = user.preferredName || 'account';
      account?.classList.remove('hidden');
      if (userName) userName.textContent = user.preferredName;
      if (userMeta) userMeta.textContent = `${user.identities.length} linked provider${user.identities.length === 1 ? '' : 's'}`;
      if (announce) {
        window.dispatchEvent(new CustomEvent('pc:auth-change', {
          detail: { user, source: 'auth-menu' },
        }));
      }
      return;
    }

    if (triggerLabel) triggerLabel.textContent = 'sign in';
    account?.classList.add('hidden');
    if (userName) userName.textContent = '—';
    if (userMeta) userMeta.textContent = '—';
    if (announce) {
      window.dispatchEvent(new CustomEvent('pc:auth-change', {
        detail: { user: null, source: 'auth-menu' },
      }));
    }
  }

  async function refreshSession(root: HTMLElement): Promise<PointCastUser | null> {
    try {
      const user = await getSession();
      renderSession(root, user);
      return user;
    } catch {
      renderSession(root, null);
      setStatus(root, 'Sign-in requires the live session service.');
      return null;
    }
  }

  function initAuthMenu(root: HTMLElement, signal: AbortSignal): void {
    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest('[data-auth-trigger]')) {
        const panel = root.querySelector('[data-auth-panel]');
        if (panel?.classList.contains('hidden')) openMenu(root);
        else closeMenu(root);
        return;
      }

      if (target.closest('[data-auth-logout]')) {
        event.preventDefault();
        setStatus(root, 'logging out…');
        void logout()
          .then(() => refreshSession(root))
          .then(() => {
            setStatus(root, 'session cleared');
            closeMenu(root);
          })
          .catch((error) => {
            setStatus(root, error instanceof Error ? error.message : 'logout failed');
          });
        return;
      }

      const button = target.closest<HTMLButtonElement>('[data-provider]');
      if (!button || button.disabled) return;
      event.preventDefault();
      const provider = button.dataset.provider as AuthProvider;
      const action = actions[provider];
      if (!action) return;
      setStatus(
        root,
        provider === 'kukai'
          ? 'Choose Kukai, then Use Browser.'
          : `${providerLabels[provider]}…`,
      );

      void action()
        .then((user) => {
          if (user) {
            renderSession(root, user);
            setStatus(root, `${providerLabels[provider]} ready`);
            closeMenu(root);
            return;
          }
          setStatus(root, `${providerLabels[provider]} redirecting…`);
        })
        .catch((error) => {
          setStatus(root, error instanceof Error ? error.message : `${providerLabels[provider]} failed`);
        });
    }, { signal });

    root.addEventListener('submit', (event) => {
      const form = (event.target instanceof Element ? event.target : null)
        ?.closest<HTMLFormElement>('[data-auth-email-form]');
      if (!form) return;
      event.preventDefault();
      const input = form.elements.namedItem('email');
      const email = input instanceof HTMLInputElement ? input.value.trim() : '';
      if (!email || !form.reportValidity()) return;
      const submit = form.querySelector<HTMLButtonElement>('[data-auth-email-submit]');
      if (submit) submit.disabled = true;
      setStatus(root, 'Sending a one-time sign-in link…');
      void requestEmailMagicLink(email)
        .then((message) => {
          setStatus(root, message || 'Check your email for a sign-in link.');
        })
        .catch((error) => {
          setStatus(root, error instanceof Error ? error.message : 'Email sign-in failed.');
        })
        .finally(() => {
          if (submit) submit.disabled = false;
        });
    }, { signal });

    window.addEventListener('pc:open-auth-menu', () => openMenu(root), { signal });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!root.contains(target)) closeMenu(root);
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu(root);
    }, { signal });

    void refreshSession(root).then((user) => {
      if (!user && root.dataset.authAutoOpen === 'true') openMenu(root);
    });
  }

  function initializeAuthMenus(): void {
    const authWindow = window as AuthMenuWindow;
    authWindow.__pointCastAuthMenuAbort?.abort();
    const listeners = new AbortController();
    authWindow.__pointCastAuthMenuAbort = listeners;

    document.querySelectorAll('[data-auth-menu]').forEach((root) => {
      initAuthMenu(root as HTMLElement, listeners.signal);
    });

    window.addEventListener('pc:auth-change', (event) => {
      const detail = (event as CustomEvent).detail;
      document.querySelectorAll('[data-auth-menu]').forEach((root) => {
        renderSession(root as HTMLElement, detail?.user ?? null, false);
      });
    }, { signal: listeners.signal });
  }

  const authWindow = window as AuthMenuWindow;
  if (!authWindow.__pointCastAuthMenuPageLoadInstalled) {
    authWindow.__pointCastAuthMenuPageLoadInstalled = true;
    document.addEventListener('astro:page-load', initializeAuthMenus);
  }
  initializeAuthMenus();
</script>
