<label class="bp-theme">Display <select data-blueprint-theme aria-label="Blueprint color theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
<script>
function setupBlueprintTheme(){
 const control=document.querySelector<HTMLSelectElement>('[data-blueprint-theme]');
 const page=document.querySelector<HTMLElement>('.blueprint');
 if(!control||!page||control.dataset.bound)return;
 control.dataset.bound='true';
 control.addEventListener('change',()=>{page.dataset.theme=control.value;});
}
setupBlueprintTheme();document.addEventListener('astro:page-load',setupBlueprintTheme);
</script>
