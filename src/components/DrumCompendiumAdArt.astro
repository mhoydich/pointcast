---
interface Props {
  sequence: number;
  label: string;
}

const { sequence, label } = Astro.props as Props;
const number = String(sequence).padStart(2, '0');
const bars = [34, 58, 82, 48, 70, 28, 64, 88, 52, 76, 40, 60];
const nodes = [
  [42, 64], [76, 38], [112, 70], [148, 32], [182, 62], [216, 42],
] as const;
---

<svg
  class="drum-ad-art"
  viewBox="0 0 260 104"
  role="img"
  aria-label={`Drum Compendium campaign ${number}: ${label}`}
  preserveAspectRatio="none"
>
  <rect class="drum-ad-art__paper" width="260" height="104" />
  <path class="drum-ad-art__rule" d="M12 18H248M12 87H248" />

  {sequence === 1 && (
    <g class="drum-ad-art__bars">
      {bars.map((height, index) => (
        <rect x={18 + index * 18.5} y={82 - height * 0.63} width="11" height={height * 0.63} rx="1" />
      ))}
    </g>
  )}

  {sequence === 2 && (
    <g class="drum-ad-art__orbit">
      <circle cx="130" cy="53" r="31" />
      <circle cx="130" cy="53" r="21" />
      <circle cx="130" cy="53" r="10" />
      <path d="M24 53H236M130 22V84" />
      <circle class="drum-ad-art__fill" cx="187" cy="53" r="5" />
    </g>
  )}

  {sequence === 3 && (
    <g class="drum-ad-art__wire">
      <path d="M18 37C40 18 56 18 78 37S116 56 138 37 176 18 198 37 222 56 242 37" />
      <path d="M18 53C40 34 56 34 78 53S116 72 138 53 176 34 198 53 222 72 242 53" />
      <path d="M18 69C40 50 56 50 78 69S116 88 138 69 176 50 198 69 222 88 242 69" />
    </g>
  )}

  {sequence === 4 && (
    <g class="drum-ad-art__network">
      <path d="M42 64L76 38 112 70 148 32 182 62 216 42M76 38L182 62M112 70L216 42" />
      {nodes.map(([cx, cy], index) => (
        <circle class:list={[{ 'drum-ad-art__fill': index === 0 || index === 5 }]} cx={cx} cy={cy} r="7" />
      ))}
    </g>
  )}

  {sequence === 5 && (
    <g class="drum-ad-art__pads">
      {Array.from({ length: 16 }, (_, index) => (
        <rect
          class:list={[{ 'drum-ad-art__fill': [0, 3, 5, 8, 10, 12, 15].includes(index) }]}
          x={58 + (index % 8) * 18}
          y={31 + Math.floor(index / 8) * 25}
          width="12"
          height="16"
          rx="2"
        />
      ))}
    </g>
  )}

  {sequence === 6 && (
    <g class="drum-ad-art__index">
      {Array.from({ length: 6 }, (_, index) => (
        <g>
          <text x={24 + index * 38} y="40">{String(index + 1).padStart(2, '0')}</text>
          <path d={`M${24 + index * 38} 48V76M${31 + index * 38} 48V${62 + (index % 3) * 7}`} />
        </g>
      ))}
    </g>
  )}

  <text class="drum-ad-art__brand" x="13" y="13">POINTCAST · DRUM COMPENDIUM</text>
  <text class="drum-ad-art__number" x="247" y="99" text-anchor="end">{number}/06</text>
</svg>

<style>
  .drum-ad-art {
    display: block;
    width: 100%;
    height: clamp(86px, 10vw, 116px);
    color: var(--tone);
    border: 1px solid currentColor;
  }
  .drum-ad-art__paper { fill: color-mix(in srgb, var(--tone) 8%, #fffaf0); }
  .drum-ad-art__rule,
  .drum-ad-art__orbit circle,
  .drum-ad-art__orbit path,
  .drum-ad-art__wire path,
  .drum-ad-art__network path,
  .drum-ad-art__network circle,
  .drum-ad-art__pads rect,
  .drum-ad-art__index path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .drum-ad-art__bars rect,
  .drum-ad-art__fill { fill: currentColor !important; }
  .drum-ad-art__wire path:nth-child(2) { stroke-width: 3; }
  .drum-ad-art__brand,
  .drum-ad-art__number,
  .drum-ad-art__index text {
    fill: currentColor;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 6px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .drum-ad-art__number { font-size: 8px; }
  .drum-ad-art__index text { font-size: 7px; letter-spacing: 0; }
</style>
