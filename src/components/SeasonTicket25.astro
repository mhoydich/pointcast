---
import { POINTCAST_25 } from '../lib/pointcast-25';

interface Props {
  context?: string;
}

const { context = 'This work is funded by readers.' } = Astro.props;
---

<aside class="pc25-ticket" aria-label="PointCast 25 Founding Season Ticket">
  <p class="pc25-ticket__stub" aria-hidden="true">
    <span>PC25</span>
    <span>2026</span>
    <strong>$25</strong>
  </p>
  <div class="pc25-ticket__body">
    <p class="pc25-ticket__label">Founding Season Ticket · one payment, not a subscription</p>
    <p class="pc25-ticket__copy">
      {context} Tuesday boards publish on <a href="/25">/25</a>, every prior board stays on the
      <a href="/25/season">season ledger</a>, and the end-of-season autopsy grades every claim.
      Card entry stays on Stripe&rsquo;s hosted checkout.
    </p>
    <p class="pc25-ticket__actions">
      <a
        class="pc25-ticket__buy"
        href={POINTCAST_25.sale.checkout}
        target="_blank"
        rel="noopener sponsored"
        data-checkout-link
      >
        Buy the $25 Season Ticket ↗
      </a>
      <a class="pc25-ticket__terms" href="/25/terms">Plain-language terms</a>
    </p>
  </div>
</aside>

<style>
  .pc25-ticket {
    background: #10100f;
    border: 1.5px solid #10100f;
    color: #f5f4ec;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin: 46px 0 0;
    padding: 26px;
  }

  .pc25-ticket__stub {
    align-items: flex-start;
    border-right: 1.5px dashed rgba(245, 244, 236, 0.35);
    display: flex;
    flex-direction: column;
    font-family: var(--pc-font-mono);
    gap: 4px;
    letter-spacing: 0.12em;
    margin: 0;
    min-width: 86px;
    padding-right: 22px;
  }

  .pc25-ticket__stub span {
    color: rgba(245, 244, 236, 0.6);
    font-size: 10px;
  }

  .pc25-ticket__stub strong {
    color: #f4ff3f;
    font-size: 30px;
    letter-spacing: -0.02em;
  }

  .pc25-ticket__body {
    flex: 1;
    min-width: 260px;
  }

  .pc25-ticket__label {
    color: #f4ff3f;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.13em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .pc25-ticket__copy {
    font-size: 15px;
    line-height: 1.55;
    margin: 0 0 16px;
    max-width: 620px;
  }

  .pc25-ticket__copy a {
    color: inherit;
  }

  .pc25-ticket__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0;
  }

  .pc25-ticket__buy {
    background: #f4ff3f;
    color: #10100f;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    padding: 14px 18px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .pc25-ticket__buy:hover,
  .pc25-ticket__buy:focus-visible {
    background: #ffffff;
  }

  .pc25-ticket__terms {
    color: rgba(245, 244, 236, 0.75);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
