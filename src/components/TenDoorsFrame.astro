---
/**
 * The shared frame for the Ten Doors (2026-11-02): page meta and JSON-LD,
 * breadcrumb, header, a slot for the door's toy, how it works, the agent
 * line and the hallway to the other nine. Each door page supplies only the
 * stage and its script. Data lives in src/lib/ten-doors.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { DOORS, doorBySlug, doorJsonLd } from '../lib/ten-doors.mjs';

interface Props {
  slug: string;
  quiet?: boolean;
  isolated?: boolean;
}

const { slug, quiet = false, isolated = false } = Astro.props;
const door = doorBySlug(slug);
const index = DOORS.findIndex((d) => d.slug === slug);
const others = DOORS.filter((d) => d.slug !== slug);
const description = `${door.pitch} One of PointCast's Ten Doors: free, in the browser, nothing to sign in to.`;
---

<BlockLayout
  title={door.name}
  description={description}
  themeColor={door.color}
  immersive={quiet}
  isolated={isolated}
  jsonLd={doorJsonLd(slug)}
  alternates={[{ type: 'application/json', href: `/${slug}.json`, title: `${door.name} (JSON)` }]}
  frame={{ buttons: [{ label: `Open ${door.name}`, action: 'link', target: `https://pointcast.xyz/${slug}` }] }}
>
  <article class="td" style={`--td-bg:${door.color};--td-ink:${door.ink}`} data-door={slug}>
    <nav class="td-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/ten-doors">Ten Doors</a><span aria-hidden="true">/</span><span>{door.name}</span>
    </nav>

    <header class="td-head">
      <p class="td-kicker">Door {index + 1} of 10 · {door.kicker}</p>
      <h1>{door.name}</h1>
      <p class="td-pitch">{door.pitch}</p>
    </header>

    <section class="td-stage" aria-label={`${door.name}, playable`}>
      <slot />
    </section>

    <section class="td-notes">
      <div>
        <h2>How it works</h2>
        <ol>{door.how.map((line) => <li>{line}</li>)}</ol>
      </div>
      <div>
        <h2>The place</h2>
        <p>{door.place}</p>
        <h2>For agents</h2>
        <p>{door.agents} <a href={`/${slug}.json`}>/{slug}.json</a></p>
      </div>
    </section>

    <nav class="td-hall" aria-label="The other nine doors">
      <h2>Down the hall</h2>
      <ul>
        {others.map((d) => (
          <li><a href={`/${d.slug}`} style={`--c:${d.color};--i:${d.ink}`}><strong>{d.name}</strong><span>{d.kicker}</span></a></li>
        ))}
      </ul>
      <p class="td-fine">Ten Doors opened 2026-11-02. Original rules, art drawn in code, sound made in your browser. Room content is not uploaded.{!quiet && ' Site Room presence shares cursors and chat when you turn it on.'} <a href="/ten-doors">All ten doors</a> · <a href="/ten-doors.json">hub JSON</a></p>
    </nav>
  </article>
</BlockLayout>

<style is:global>
  .td-btn {
    font: 600 0.85rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.7rem 0.9rem;
    min-height: 44px;
    border-radius: 999px;
    border: 2px solid var(--td-ink);
    background: transparent;
    color: var(--td-ink);
    cursor: pointer;
    touch-action: manipulation;
  }
  .td-btn[aria-pressed='true'], .td-btn.is-on { background: var(--td-ink); color: var(--td-bg); }
  .td-btn:focus-visible, .td-canvas:focus-visible { outline: 3px solid var(--td-ink); outline-offset: 3px; box-shadow: 0 0 0 3px var(--td-bg); }
  .td-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: center; margin-top: 0.75rem; }
  .td-readout { font: 600 0.95rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--td-ink); text-align: center; margin: 0.6rem 0 0; min-height: 1.4em; }
  .td-canvas { display: block; width: 100%; height: auto; border-radius: 14px; touch-action: none; user-select: none; -webkit-user-select: none; }
  .td-canvas[hidden] { display: none; }
  .td-canvas-notice { padding: 1rem; border: 1px solid currentColor; border-radius: 8px; line-height: 1.5; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<style>
  .td { max-width: 980px; margin: 0 auto; padding: 1rem 1rem 3rem; color: #1b1b1b; }
  .td-crumb { display: flex; gap: 0.45rem; font: 0.8rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: #666; margin-bottom: 1rem; flex-wrap: wrap; }
  .td-crumb a { color: inherit; }
  .td-head h1 { font-size: clamp(2.2rem, 7vw, 3.6rem); line-height: 1; margin: 0.2rem 0 0.6rem; letter-spacing: -0.02em; }
  .td-kicker { font: 600 0.78rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: 0.08em; color: #555; margin: 0; }
  .td-pitch { font-size: 1.15rem; line-height: 1.45; max-width: 44rem; margin: 0 0 1.2rem; }
  .td-stage { background: var(--td-bg); color: var(--td-ink); border-radius: 22px; padding: clamp(0.75rem, 2.5vw, 1.5rem); box-shadow: 0 18px 40px rgb(0 0 0 / 0.16); }
  .td-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
  .td-notes h2, .td-hall h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.5rem; }
  .td-notes ol { margin: 0 0 1rem; padding-left: 1.2rem; line-height: 1.5; }
  .td-notes p { line-height: 1.5; margin: 0 0 1rem; }
  .td-hall { margin-top: 2rem; }
  .td-hall ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 0.6rem; }
  .td-hall li a { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.8rem 0.9rem; border-radius: 14px; background: var(--c); color: var(--i); text-decoration: none; min-height: 4.2rem; }
  .td-hall li a:focus-visible { outline: 3px solid #262626; outline-offset: 3px; }
  .td-hall li a span { font: 0.72rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; opacity: 0.85; }
  .td-fine { font-size: 0.85rem; color: #555; margin-top: 1rem; line-height: 1.5; }
  @media (max-width: 720px) { .td-notes { grid-template-columns: 1fr; } }
</style>
