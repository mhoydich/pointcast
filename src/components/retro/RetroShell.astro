---
import '../../styles/retro.css';
import {experiences} from '../../lib/retro-catalog.mjs';
import RetroArt from './RetroArt.astro';
const {room='hub',title='The Retro Room',tag='PointCast / after school',description='Six doors into one PointCast. Turn a channel, make a reading tape, find your next small world.'}=Astro.props;
const index=experiences.findIndex(x=>x.id===room);
const accent=experiences[index]?.color??'#ffca71';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#13172c"/><title>{title} · PointCast</title><link rel="canonical" href={`https://pointcast.xyz/retro/${room==='hub'?'':room+'/'}`}/></head><body style={`--accent:${accent}`} data-room={room}><a class="skip" href="#main">Skip to room</a><div class="frame"><header class="mast"><a class="brand" href="/">POINTCAST</a><a href="/retro/">RETRO ROOM / DIRECTORY</a></header><section class="hero"><div><p class="eyebrow">{tag}</p><h1>{title}</h1><p>{description}</p></div><RetroArt variant={Math.max(index,0)}/></section><nav class="room-nav" aria-label="Retro experiences">{experiences.map(x=><a href={`/retro/${x.id}/`} aria-current={x.id===room?'page':undefined}>{x.number} {x.short}</a>)}</nav><main id="main"><slot/></main><footer class="footer">Original pixel artwork & station bumpers. A reading and play directory, built for PointCast.<br/>The catalog admits published destinations. Report timestamps and local progress belong to their own pages.<br/><a href="/retro/">Return to directory</a> · <a href="/">PointCast home</a></footer></div></body></html>
