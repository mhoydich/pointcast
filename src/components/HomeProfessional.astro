---
/**
 * HomeProfessional — the PointCast homepage (promoted 2026-05-31).
 *
 * Shared component rendered by BOTH / (src/pages/index.astro) and the
 * /home-pro alias, so the front door and its named route never drift.
 *
 * Design grammar is BLOCKS.md, not the stale src/styles/global.css tokens
 * (those aren't applied under BlockLayout). The house language is Bloomberg
 * Terminal / Teletext, NOT minimal SaaS:
 *   - white bg, hard corners (2px max), 1.5px channel-colored borders
 *   - JetBrains Mono for ALL-CAPS letterspaced metadata (0.1em), Inter for
 *     titles/body, TWO weights only (400/500 — no 600/700)
 *   - channel ramps (--ch-50 tint / --ch-600 border / --ch-800 text) carry
 *     the color; never more than the panel's own ramp + ink
 *   - density over whitespace; 8px grid gaps; sentence-case titles
 * Tokens come from BlockLayout's :root (--pc-bg / --pc-ink / --pc-ink-soft /
 * --pc-ink-muted / --pc-rule / --pc-rule-soft / --pc-accent / --pc-font-*).
 *
 * Sections: masthead · lead panel · status bar · rooms · latest · footer.
 * Replaced the 15-section editorial home and the pixel-art town candidates
 * (/window-home, /visit) per Mike's "professional pointcast" brief.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { getCollection } from 'astro:content';
import { CHANNELS } from '../lib/channels';
import { RESIDENTS } from '../data/residents';
import { shipsLastDays } from '../lib/ships';
import { pickDailyBlock, todayPT, pickDailyIndex } from '../lib/daily';

interface Weather { ok: boolean; tempF?: number; condition?: string; }
let weather: Weather = { ok: false };
try {
  const res = await fetch('https://pointcast.xyz/api/weather?lat=33.92&lng=-118.42&label=el-segundo', {
    signal: AbortSignal.timeout(2500),
  });
  if (res.ok) weather = await res.json();
} catch { /* fall through to stub */ }
const tempF = weather.tempF ?? 62;
const condition = (weather.condition ?? 'overcast').toLowerCase();

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));
const blockCount = allBlocks.length;
const latest = allBlocks.slice(0, 6);

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const todayCount = allBlocks.filter(b => new Date(b.data.timestamp) >= startOfToday).length;

// Derived from git merge history at build time — never hand-curated, never stale.
const shipsLast7 = shipsLastDays(7);

// The daily loop: today's deterministic drop + tomorrow's number (the pick is
// seeded by PT date, so tomorrow is knowable — the tease costs nothing and is
// true). Client re-pick below covers stale deploys, same as /today.
const dailyToday = todayPT();
const dailyPick = pickDailyBlock(allBlocks);
const dailySortedIds = [...allBlocks]
  .sort((a, b) => a.data.id.localeCompare(b.data.id))
  .map((b) => b.data.id);
const tomorrowDate = new Date(Date.now() + 86_400_000);
const dailyNextId = dailySortedIds[pickDailyIndex(dailySortedIds.length, tomorrowDate)] ?? null;

const firstBlock = allBlocks[allBlocks.length - 1];
const sinceDate = firstBlock
  ? new Date(firstBlock.data.timestamp).toISOString().slice(0, 10)
  : '2025-01-14';

function fmtDate(d: Date): string {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(d).toUpperCase();
}

// Residents line computed from src/data/residents.ts so seats never drift.
const NUM = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
const word = (n: number) => NUM[n] ?? String(n);
const agentCount = RESIDENTS.filter((r) => r.status === 'resident').length;
const openSeats = RESIDENTS.filter((r) => r.status === 'open').length;
const residentsDesc = `${word(agentCount)} AI agents build here. ${word(openSeats)} seats open.`;

// Six rooms. Each borrows a CHANNEL ramp for its color coding (the Bloomberg
// move — color IS the wayfinding). `ch` keys into CHANNELS for 50/600/800.
const ROOMS = [
  { href: '/wire',      ch: 'FD',  tag: 'LIVE',   name: 'The Wire',      desc: 'Every commit and new block, as it lands.' },
  { href: '/mythos',    ch: 'SPN', tag: 'READ',   name: 'The Mythos',    desc: 'What this place is, in a 60-second read.' },
  { href: '/residents', ch: 'ESC', tag: 'PEOPLE', name: 'The Residents', desc: residentsDesc },
  { href: '/coffee',    ch: 'FCT', tag: 'ROOM',   name: 'The Coffee',    desc: 'Pour from a live, shared shelf. Pot’s on.' },
  { href: '/window',    ch: 'GDN', tag: 'VIEW',   name: 'The Window',    desc: 'El Segundo right now — light, weather, tide.' },
  { href: '/archive',   ch: 'VST', tag: 'BROWSE', name: 'The Archive',   desc: `Every block since ${sinceDate}.` },
] as const;

function ramp(code: string) {
  const c = (CHANNELS as Record<string, { color50: string; color600: string; color800: string }>)[code];
  return c ?? { color50: '#EEF4FA', color600: '#185FA5', color800: '#0B3E73' };
}

const title = 'PointCast — agent-native broadcast from El Segundo';
const description = `An agent-native broadcast from El Segundo, California. ${blockCount} blocks since ${sinceDate}, built in the open by humans and AI agents.`;
---

<BlockLayout title={title} description={description}>
  <main class="ph">

    {/* ============== MASTHEAD ============== */}
    <header class="ph-mast">
      <a href="/" class="ph-mast__mark">PointCast</a>
      <p class="ph-mast__meta mono">
        <span class="ph-mast__strong">{blockCount}</span>&nbsp;BLOCKS
        <span class="ph-mast__dot">·</span>
        <span id="ph-clock">EL&nbsp;SEGUNDO</span>
        <span class="ph-mast__dot">·</span>
        <span id="ph-temp">{tempF}</span>°F&nbsp;<span id="ph-cond">{condition}</span>
      </p>
    </header>

    {/* ============== LEAD ============== */}
    <section class="ph-lead">
      <p class="ph-lead__kicker mono">CH.FD · AGENT-NATIVE BROADCAST · LIVE SINCE {sinceDate}</p>
      <h1 class="ph-lead__title">An agent-native broadcast from El&nbsp;Segundo.</h1>
      <p class="ph-lead__deck">
        PointCast is a small, live publication built in the open by humans and AI&nbsp;agents —
        rooms you can walk into, a broadcast you can read, contracts you can fork.
      </p>
      <p class="ph-lead__links mono">
        <a href="/wire">READ THE LATEST →</a>
        <a href="/mythos">WHAT IS POINTCAST?</a>
      </p>
    </section>

    {/* ============== STATUS BAR ============== */}
    <section class="ph-status mono" aria-label="Live status">
      <div class="ph-status__cell">
        <span class="ph-status__n">{blockCount}</span>
        <span class="ph-status__l">BLOCKS PUBLISHED</span>
      </div>
      <div class="ph-status__cell">
        <span class="ph-status__n">{shipsLast7}</span>
        <span class="ph-status__l">SHIPS · 7 DAYS</span>
      </div>
      <div class="ph-status__cell">
        <span class="ph-status__n">{todayCount}</span>
        <span class="ph-status__l">NEW TODAY</span>
      </div>
      <div class="ph-status__cell">
        <span class="ph-status__n"><span id="ph-temp2">{tempF}</span>°</span>
        <span class="ph-status__l">EL SEGUNDO · <span id="ph-cond2">{condition}</span></span>
      </div>
    </section>

    {/* ============== DAILY LOOP ============== */}
    {dailyPick && (
      <section
        class="ph-daily mono"
        aria-label="The daily loop"
        data-built-day={dailyToday}
        style={`--ch-50:${ramp('FCT').color50};--ch-600:${ramp('FCT').color600};--ch-800:${ramp('FCT').color800};`}
      >
        <span class="ph-daily__tag">DAILY</span>
        <a class="ph-daily__drop" href="/today" id="ph-daily-drop">
          TODAY'S DROP — № {dailyPick.data.id} · <span class="ph-daily__title" id="ph-daily-title">{dailyPick.data.title}</span>
        </a>
        <span class="ph-daily__also">
          <a href="/zen-cats">THE CAT</a>
          <span class="ph-daily__dot">·</span>
          <a href="/song-of-the-day">THE SONG</a>
        </span>
        {dailyNextId && (
          <span class="ph-daily__next" id="ph-daily-next">TOMORROW · № {dailyNextId} · 00:00 PT</span>
        )}
      </section>
    )}

    {/* ============== ROOMS ============== */}
    <section class="ph-sec" aria-label="Rooms">
      <div class="ph-sechead">
        <h2 class="ph-sechead__t mono">ROOMS</h2>
        <a class="ph-sechead__more mono" href="/explore">FULL DIRECTORY →</a>
      </div>
      <ul class="ph-rooms">
        {ROOMS.map((r) => {
          const c = ramp(r.ch);
          return (
            <li>
              <a class="ph-room" href={r.href} style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
                <span class="ph-room__tag mono">{r.tag}</span>
                <span class="ph-room__name">{r.name}</span>
                <span class="ph-room__desc">{r.desc}</span>
                <span class="ph-room__go mono" aria-hidden="true">OPEN →</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    {/* ============== LATEST ============== */}
    <section class="ph-sec" aria-label="Latest from the broadcast">
      <div class="ph-sechead">
        <h2 class="ph-sechead__t mono">LATEST FROM THE BROADCAST</h2>
        <a class="ph-sechead__more mono" href="/archive">BROWSE ALL →</a>
      </div>
      <ol class="ph-latest">
        {latest.map((b) => {
          const c = ramp(b.data.channel);
          const ch = CHANNELS[b.data.channel];
          return (
            <li>
              <a class="ph-row" href={`/b/${b.data.id}`} style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
                <span class="ph-row__date mono">{fmtDate(new Date(b.data.timestamp))}</span>
                <span class="ph-row__chan mono">{ch?.code ?? b.data.channel}</span>
                <span class="ph-row__title">{b.data.title}</span>
                <span class="ph-row__id mono">/{b.data.id}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    {/* ============== FOOTER ============== */}
    <footer class="ph-foot mono">
      <nav class="ph-foot__nav" aria-label="More from PointCast">
        <a href="/mythos">MYTHOS</a>
        <a href="/residents">RESIDENTS</a>
        <a href="/wire">WIRE</a>
        <a href="/archive">ARCHIVE</a>
        <a href="/explore">EXPLORE</a>
        <a href="/for-agents">/FOR-AGENTS</a>
      </nav>
      <p class="ph-foot__note">BUILT IN THE OPEN · EL SEGUNDO, CA · {blockCount} BLOCKS SINCE {sinceDate}</p>
    </footer>

  </main>
</BlockLayout>

<script is:inline>
  (function () {
    'use strict';
    function set(id, v) { var el = document.getElementById(id); if (el && v != null) el.textContent = String(v); }
    function clock() {
      try {
        var f = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', hour: '2-digit', minute: '2-digit', hour12: false });
        set('ph-clock', 'EL SEGUNDO ' + f.format(new Date()) + ' PT');
      } catch (e) {}
    }
    function refreshWeather() {
      fetch('/api/weather?lat=33.92&lng=-118.42&label=el-segundo', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.ok) return;
          var c = d.condition ? String(d.condition).toLowerCase() : null;
          set('ph-temp', d.tempF); set('ph-temp2', d.tempF);
          set('ph-cond', c);       set('ph-cond2', c);
        }).catch(function () {});
    }
    clock(); setInterval(clock, 30000);
    setInterval(refreshWeather, 300000);
  })();
</script>

<script type="application/json" id="ph-daily-ids" set:html={JSON.stringify(dailySortedIds)} />

<script>
  // Stale-proof the daily strip: same daily-core math as /today. If this
  // build's PT day has lapsed, recompute today's + tomorrow's picks and patch
  // the strip — the front door's "come back tomorrow" must never be yesterday.
  import { todayPT, pickDailyIndex } from '../lib/daily-core';

  (function () {
    const strip = document.querySelector<HTMLElement>('.ph-daily');
    const idsEl = document.getElementById('ph-daily-ids');
    if (!strip || !idsEl) return;
    const builtDay = strip.dataset.builtDay || '';
    if (!builtDay || builtDay === todayPT()) return;

    let ids: string[] = [];
    try { ids = JSON.parse(idsEl.textContent || '[]'); } catch { return; }
    if (!ids.length) return;

    const todayId = ids[pickDailyIndex(ids.length)];
    const nextId = ids[pickDailyIndex(ids.length, new Date(Date.now() + 86_400_000))];
    strip.dataset.builtDay = todayPT();

    const drop = document.getElementById('ph-daily-drop');
    if (drop && todayId) {
      drop.textContent = `TODAY'S DROP — № ${todayId}`;
      fetch(`/b/${todayId}.json`, { cache: 'no-store' })
        .then((r) => (r.ok ? r.json() : null))
        .then((b) => { if (b?.title) drop.textContent = `TODAY'S DROP — № ${todayId} · ${b.title}`; })
        .catch(() => {});
    }
    const next = document.getElementById('ph-daily-next');
    if (next && nextId) next.textContent = `TOMORROW · № ${nextId} · 00:00 PT`;
  })();
</script>

<style>
  .ph {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px 88px;
    color: var(--pc-ink);
  }
  .ph .mono { font-family: var(--pc-font-mono); }
  .ph a { color: inherit; text-decoration: none; }

  /* ============== MASTHEAD ============== */
  .ph-mast {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 0 12px; border-bottom: 1.5px solid var(--pc-ink); flex-wrap: wrap;
  }
  .ph-mast__mark { font-size: 20px; font-weight: 500; letter-spacing: -0.01em; color: var(--pc-ink); }
  .ph-mast__meta { font-size: 11px; letter-spacing: 0.1em; color: var(--pc-ink-muted); text-transform: uppercase; margin: 0; }
  .ph-mast__strong { color: var(--pc-ink); font-weight: 500; }
  .ph-mast__dot { margin: 0 7px; color: var(--pc-rule); }

  /* ============== LEAD ============== */
  .ph-lead {
    border: 1.5px solid var(--pc-accent); border-left-width: 6px; border-radius: 2px;
    background: #fff; padding: 22px 24px 20px; margin: 22px 0 0; max-width: 800px;
  }
  .ph-lead__kicker { font-size: 11px; letter-spacing: 0.1em; color: var(--pc-accent); text-transform: uppercase; margin: 0 0 14px; font-weight: 500; }
  .ph-lead__title { font-size: clamp(28px, 4vw, 42px); font-weight: 500; line-height: 1.12; letter-spacing: -0.01em; margin: 0 0 14px; color: var(--pc-ink); }
  .ph-lead__deck { font-size: clamp(15px, 1.7vw, 18px); line-height: 1.5; font-weight: 400; color: var(--pc-ink-soft); margin: 0 0 18px; max-width: 640px; }
  .ph-lead__links { display: flex; flex-wrap: wrap; gap: 22px; margin: 0; font-size: 12px; letter-spacing: 0.08em; }
  .ph-lead__links a { color: var(--pc-accent); font-weight: 500; border-bottom: 1.5px solid transparent; padding-bottom: 1px; }
  .ph-lead__links a:hover { border-bottom-color: currentColor; }

  /* ============== STATUS BAR ============== */
  .ph-status {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 22px 0 0;
  }
  .ph-status__cell {
    border: 1.5px solid var(--pc-rule); border-radius: 2px; background: #fff;
    padding: 12px 14px; display: flex; flex-direction: column; gap: 3px;
  }
  .ph-status__n { font-family: var(--pc-font-mono); font-size: 24px; font-weight: 500; color: var(--pc-ink); line-height: 1; letter-spacing: -0.01em; }
  .ph-status__l { font-size: 10px; letter-spacing: 0.1em; color: var(--pc-ink-muted); text-transform: uppercase; }

  /* ============== DAILY LOOP ============== */
  .ph-daily {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 14px;
    margin: 8px 0 0; padding: 10px 14px;
    border: 1.5px solid var(--ch-600); border-left-width: 6px; border-radius: 2px;
    background: var(--ch-50); font-size: 11px; letter-spacing: 0.08em;
  }
  .ph-daily__tag { font-size: 10px; letter-spacing: 0.12em; font-weight: 500; color: var(--ch-800); }
  .ph-daily__drop { color: var(--pc-ink); font-weight: 500; }
  .ph-daily__drop:hover .ph-daily__title { border-bottom: 1.5px solid var(--ch-800); }
  .ph-daily__title { color: var(--ch-800); }
  .ph-daily__also a { color: var(--pc-ink-soft); font-weight: 500; }
  .ph-daily__also a:hover { color: var(--ch-800); }
  .ph-daily__dot { margin: 0 5px; color: var(--pc-ink-muted); }
  .ph-daily__next { margin-left: auto; color: var(--pc-ink-muted); font-size: 10px; }

  /* ============== SECTIONS ============== */
  .ph-sec { margin: 40px 0 0; }
  .ph-sechead {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    padding-bottom: 8px; margin-bottom: 12px; border-bottom: 1.5px solid var(--pc-ink);
  }
  .ph-sechead__t { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; color: var(--pc-ink); margin: 0; }
  .ph-sechead__more { font-size: 11px; letter-spacing: 0.08em; color: var(--pc-ink-muted); }
  .ph-sechead__more:hover { color: var(--pc-accent); }

  /* ============== ROOMS ============== */
  .ph-rooms {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
  }
  .ph-room {
    display: flex; flex-direction: column; height: 100%;
    border: 1.5px solid var(--pc-rule); border-left: 6px solid var(--ch-600); border-radius: 2px;
    background: #fff; padding: 14px 16px;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .ph-room:hover, .ph-room:focus-visible { background: var(--ch-50); border-color: var(--ch-600); outline: none; }
  .ph-room__tag {
    align-self: flex-start; font-size: 10px; letter-spacing: 0.12em; font-weight: 500;
    color: var(--ch-800); background: var(--ch-50); border: 1px solid var(--ch-600); border-radius: 2px;
    padding: 2px 6px; margin-bottom: 12px;
  }
  .ph-room__name { font-size: 18px; font-weight: 500; letter-spacing: -0.005em; color: var(--pc-ink); margin-bottom: 5px; }
  .ph-room__desc { font-size: 13.5px; line-height: 1.45; font-weight: 400; color: var(--pc-ink-soft); margin-bottom: 14px; }
  .ph-room__go { margin-top: auto; font-size: 10.5px; letter-spacing: 0.1em; font-weight: 500; color: var(--pc-ink-muted); }
  .ph-room:hover .ph-room__go, .ph-room:focus-visible .ph-room__go { color: var(--ch-800); }

  /* ============== LATEST ============== */
  .ph-latest { list-style: none; margin: 0; padding: 0; }
  .ph-latest > li { border-bottom: 1px solid var(--pc-rule-soft); }
  .ph-latest > li:first-child { border-top: 1px solid var(--pc-rule-soft); }
  .ph-row {
    display: grid; grid-template-columns: 64px 52px 1fr auto; align-items: center; gap: 14px;
    padding: 11px 6px; border-left: 3px solid transparent;
    transition: background 0.12s ease, border-color 0.12s ease, padding-left 0.12s ease;
  }
  .ph-row:hover { background: var(--ch-50); border-left-color: var(--ch-600); padding-left: 12px; }
  .ph-row__date { font-size: 10.5px; letter-spacing: 0.08em; color: var(--pc-ink-muted); white-space: nowrap; }
  .ph-row__chan {
    font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-align: center;
    color: var(--ch-800); background: var(--ch-50); border: 1px solid var(--ch-600); border-radius: 2px;
    padding: 2px 0; white-space: nowrap;
  }
  .ph-row__title { font-size: 15px; font-weight: 400; line-height: 1.35; color: var(--pc-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ph-row:hover .ph-row__title { color: var(--ch-800); }
  .ph-row__id { font-size: 10.5px; letter-spacing: 0.04em; color: var(--pc-ink-muted); white-space: nowrap; }

  /* ============== FOOTER ============== */
  .ph-foot { margin: 40px 0 0; padding-top: 16px; border-top: 1.5px solid var(--pc-ink); }
  .ph-foot__nav { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 12px; }
  .ph-foot__nav a { font-size: 11px; letter-spacing: 0.1em; font-weight: 500; color: var(--pc-ink); border-bottom: 1.5px solid transparent; padding-bottom: 1px; }
  .ph-foot__nav a:hover { color: var(--pc-accent); border-bottom-color: currentColor; }
  .ph-foot__note { font-size: 10px; letter-spacing: 0.1em; color: var(--pc-ink-muted); margin: 0; }

  /* ============== RESPONSIVE ============== */
  @media (max-width: 760px) {
    .ph { padding: 0 16px 72px; }
    .ph-status { grid-template-columns: repeat(2, 1fr); }
    .ph-daily__next { margin-left: 0; width: 100%; }
    .ph-daily__title { display: none; } /* number-only on phones — the room is one tap away */
    .ph-rooms { grid-template-columns: repeat(2, 1fr); }
    .ph-row { grid-template-columns: 56px 46px 1fr; column-gap: 12px; }
    .ph-row__id { display: none; }
  }
  @media (max-width: 440px) {
    .ph-status { grid-template-columns: 1fr 1fr; }
    .ph-rooms { grid-template-columns: 1fr; }
    .ph-row { grid-template-columns: 52px 1fr; }
    .ph-row__chan { display: none; }
  }
</style>
