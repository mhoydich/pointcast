---
/**
 * HomeProfessional — the PointCast homepage (promoted 2026-05-31).
 *
 * Shared component rendered by BOTH / (src/pages/index.astro) and the
 * /home-pro alias, so the front door and its named route never drift.
 *
 * Design grammar is BLOCKS.md, not the stale src/styles/global.css tokens
 * (those aren't applied under BlockLayout). The house language is Bloomberg
 * Terminal / Teletext, NOT minimal SaaS:
 *   - white bg, hard corners (2px max), 1.5px channel-colored borders
 *   - JetBrains Mono for ALL-CAPS letterspaced metadata (0.1em), Inter for
 *     titles/body, TWO weights only (400/500 — no 600/700)
 *   - channel ramps (--ch-50 tint / --ch-600 border / --ch-800 text) carry
 *     the color; never more than the panel's own ramp + ink
 *   - density over whitespace; 8px grid gaps; sentence-case titles
 * Tokens come from BlockLayout's :root (--pc-bg / --pc-ink / --pc-ink-soft /
 * --pc-ink-muted / --pc-rule / --pc-rule-soft / --pc-accent / --pc-font-*).
 *
 * Sections: masthead · teletext ticker · verb-door lead · arcade marquee ·
 * alive strip · shipped-today hero · directory strip · daily loop · latest ·
 * footer.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { getCollection } from 'astro:content';
import { CHANNELS } from '../lib/channels';
import { shipsLastDays, shipsForHero } from '../lib/ships';
import { pickDailyBlock, todayPT, pickDailyIndex } from '../lib/daily';
import { CATEGORIES, FEATURES } from '../lib/explore';
import { RETRO_ARCADE_GAMES } from '../lib/retro-arcade';
import { readFileSync } from 'node:fs';

// Season Two heartbeat — HEARTBEAT.log at the repo root, one line per daily
// pulse ("<ISO> · season two · pulse N · the pot, still on"). Build-time read
// here; a client refresh from the raw GitHub file below keeps the count true
// between deploys. If the log is missing the cell falls back to block count.
interface Pulse { n: number; at: string }
let pulse: Pulse | null = null;
try {
  const lines = readFileSync('HEARTBEAT.log', 'utf8').trim().split('\n').filter(Boolean);
  const last = lines[lines.length - 1] ?? '';
  const at = last.split(' · ')[0]?.trim();
  if (lines.length > 0 && at) pulse = { n: lines.length, at };
} catch { /* no log yet — cell falls back */ }

interface Weather { ok: boolean; tempF?: number; condition?: string; }
let weather: Weather = { ok: false };
try {
  const res = await fetch('https://pointcast.xyz/api/weather?lat=33.92&lng=-118.42&label=el-segundo', {
    signal: AbortSignal.timeout(2500),
  });
  if (res.ok) weather = await res.json();
} catch { /* fall through to stub */ }
const tempF = weather.tempF ?? 62;
const condition = (weather.condition ?? 'overcast').toLowerCase();

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));
const blockCount = allBlocks.length;
const latest = allBlocks.slice(0, 4);
const tickerBlocks = allBlocks.slice(0, 3);

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const todayCount = allBlocks.filter(b => new Date(b.data.timestamp) >= startOfToday).length;

// Derived from git merge history at build time — never hand-curated, never stale.
const shipsLast7 = shipsLastDays(7);

// SHIPPED TODAY hero — slides derived from today's merged PRs (shipsForHero,
// git-derived so the list can't go stale). SHIP_DOORS enriches known PRs with
// a real door + copy; anything unlisted still renders from its commit subject
// and links to /wire, so future ships appear with zero curation.
const SHIP_DOORS: Record<number, { href: string; ch: string; name: string; desc: string; cta?: string }> = {
  761: { href: '/grey-hour', ch: 'GDN', name: 'The Grey Hour joins the app shelf',
         desc: 'A wizard-meditation satellite — sit with the grey hour, straight from the shelf.' },
  760: { href: '/win95-games', ch: 'ESC', name: 'Crush v2 special combos + arcade shelves',
         desc: 'Striped/bomb/rainbow combo pieces land in Noggle Crush v2, and the arcade hub reorganizes into labeled category shelves.' },
  759: { href: '/win95-games', ch: 'ESC', name: 'Ten mobile games hit the Retro Arcade',
         desc: 'Flappy, stacker, wordsearch, Simon, lights-out, TriPeaks, golf, runner, pipes, bubble pop — all touch-first, built for phones.' },
  758: { href: '/drum', ch: 'SPN', name: 'Seven more games at the Drum House',
         desc: 'Quickdraw, steps, fill, runner, catch, steady, split — the ten-drum-games set is complete, all live WebAudio.' },
  757: { href: '/noggle-crush-v2', ch: 'ESC', name: 'Match-3 campaigns: Crush, Jam & Jelly v2',
         desc: 'Level campaigns land on the match-3 trio — bombs from cross matches, tappable power-ups, double-layer jelly.' },
  756: { href: '/b/0486', ch: 'FD', name: 'On the wire: six new games in the arcade',
         desc: 'The broadcast note for the arcade expansion, block № 0486.', cta: 'READ THE BLOCK →' },
  755: { href: '/noggle-crush', ch: 'ESC', name: 'The match-3 trio arrives',
         desc: 'Noggle Crush, Nouns Jam, Nouns Jelly — a whole new match category with cascade achievements.' },
  754: { href: '/win95-games', ch: 'ESC', name: 'Six Win95 Nouns games',
         desc: 'Noggle Drop, 2048, Snake, Slide, Reversi and Breakout join the Retro Arcade.' },
};
function prettySubject(s: string): string {
  const t = s.replace(/\s*\(#\d+\)\s*$/, '').replace(/^[a-z]+(\([^)]*\))?:\s*/, '');
  return t.charAt(0).toUpperCase() + t.slice(1);
}
const heroData = shipsForHero();
const heroShips = (heroData?.ships ?? [])
  .map((s) => {
    const door = SHIP_DOORS[s.num];
    return {
      num: s.num,
      href: door?.href ?? '/wire',
      ch: door?.ch ?? 'FD',
      name: door?.name ?? prettySubject(s.subject),
      desc: door?.desc ?? 'Fresh off the wire — merged to main today.',
      cta: door?.cta ?? 'VISIT →',
    };
  });
const heroDay = heroData?.day ?? '';
const heroIsToday = heroDay === new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());

// The daily loop: today's deterministic drop + tomorrow's number (the pick is
// seeded by PT date, so tomorrow is knowable — the tease costs nothing and is
// true). Client re-pick below covers stale deploys, same as /today.
const dailyToday = todayPT();
const dailyPick = pickDailyBlock(allBlocks);
const dailySortedIds = [...allBlocks]
  .sort((a, b) => a.data.id.localeCompare(b.data.id))
  .map((b) => b.data.id);
const tomorrowDate = new Date(Date.now() + 86_400_000);
const dailyNextId = dailySortedIds[pickDailyIndex(dailySortedIds.length, tomorrowDate)] ?? null;

const firstBlock = allBlocks[allBlocks.length - 1];
const sinceDate = firstBlock
  ? new Date(firstBlock.data.timestamp).toISOString().slice(0, 10)
  : '2025-01-14';

function fmtDate(d: Date): string {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(d).toUpperCase();
}

function ramp(code: string) {
  const c = (CHANNELS as Record<string, { color50: string; color600: string; color800: string }>)[code];
  return c ?? { color50: '#EEF4FA', color600: '#185FA5', color800: '#0B3E73' };
}

const arcadeCount = RETRO_ARCADE_GAMES.filter((game) => game.status === 'live').length;
const drumGameCount = 10;
const featuredSeeds = {
  'noun-flappy': 428,
  'swipe-golf': 214,
  'nouns-2048': 711,
  'noggle-crush-v2': 998,
  'noun-runner': 83,
  'solitaire-v2': 1194,
} as const;
const featuredArcade = Object.entries(featuredSeeds)
  .map(([slug, noun]) => {
    const game = RETRO_ARCADE_GAMES.find((g) => g.slug === slug);
    return game ? { ...game, noun } : null;
  })
  .filter((game): game is NonNullable<typeof game> => Boolean(game));

const verbDoors = [
  { href: '/win95-games', ch: 'ESC', verb: 'PLAY', note: `${arcadeCount} games`, arrow: '→' },
  { href: '/wire', ch: 'FD', verb: 'READ', note: 'latest wire', arrow: '→' },
  { href: '/coffee', ch: 'FCT', verb: 'VISIT', note: 'coffee pot', arrow: '→' },
] as const;

const tickerSegments = [
  ...tickerBlocks.map((b) => ({
    href: `/b/${b.data.id}`,
    ch: b.data.channel,
    label: `LATEST /${b.data.id} ${b.data.title}`,
  })),
  { href: '/win95-games', ch: 'ESC', label: `${arcadeCount} GAMES IN THE ARCADE` },
  { href: '/drum', ch: 'SPN', label: `${drumGameCount} DRUM GAMES LIVE` },
  { href: '/coffee', ch: 'FCT', label: 'COFFEE POT ON', id: 'ph-coffee-ticker' },
  { href: '/window', ch: 'GDN', label: `EL SEGUNDO ${tempF}F ${condition}` },
  { href: '/wire', ch: 'FD', label: `${shipsLast7} SHIPS IN 7 DAYS` },
];

const directoryChips = [
  { label: 'GAMES', ch: 'ESC' },
  { label: CATEGORIES.find((c) => c.key === 'drum')?.label ?? 'Drum Hub', ch: 'SPN' },
  { label: CATEGORIES.find((c) => c.key === 'music')?.label ?? 'Music & Casts', ch: 'SPN' },
  { label: CATEGORIES.find((c) => c.key === 'nouns')?.label ?? 'Nouns Battler', ch: 'BTL' },
  { label: CATEGORIES.find((c) => c.key === 'shrines')?.label ?? 'Shrines & Stillness', ch: 'GDN' },
  { label: CATEGORIES.find((c) => c.key === 'federation')?.label ?? 'Rooms & Federation', ch: 'FD' },
  { label: CATEGORIES.find((c) => c.key === 'collect')?.label ?? 'Collect & Drops', ch: 'FCT' },
  { label: CATEGORIES.find((c) => c.key === 'local')?.label ?? 'El Segundo & Local', ch: 'ESC' },
] as const;
const townTotal = FEATURES.length;

const title = 'PointCast — agent-native broadcast from El Segundo';
const description = `An agent-native broadcast from El Segundo, California. ${blockCount} blocks since ${sinceDate}, built in the open by humans and AI agents.`;
---

<BlockLayout title={title} description={description}>
  <main class="ph">

    {/* ============== MASTHEAD ============== */}
    <header class="ph-mast">
      <a href="/" class="ph-mast__mark">PointCast</a>
      <p class="ph-mast__meta mono">
        <span class="ph-mast__strong">{blockCount}</span>&nbsp;BLOCKS
        <span class="ph-mast__dot">·</span>
        <span id="ph-clock">EL&nbsp;SEGUNDO</span>
        <span class="ph-mast__dot">·</span>
        <span id="ph-temp">{tempF}</span>°F&nbsp;<span id="ph-cond">{condition}</span>
      </p>
    </header>

    {/* ============== TELETEXT TICKER ============== */}
    <section class="ph-ticker mono" aria-label="Live teletext ticker">
      <div class="ph-ticker__track">
        <div class="ph-ticker__run">
          {tickerSegments.map((seg) => {
            const c = ramp(seg.ch);
            return (
              <a class="ph-ticker__item" href={seg.href} style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
                <span class="ph-ticker__code">{seg.ch}</span>
                <span id={seg.id}>{seg.label}</span>
              </a>
            );
          })}
        </div>
        <div class="ph-ticker__run ph-ticker__run--copy" aria-hidden="true">
          {tickerSegments.map((seg) => {
            const c = ramp(seg.ch);
            return (
              <span class="ph-ticker__item" style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
                <span class="ph-ticker__code">{seg.ch}</span>
                <span>{seg.label}</span>
              </span>
            );
          })}
        </div>
      </div>
    </section>

    {/* ============== LEAD ============== */}
    <section class="ph-lead">
      <p class="ph-lead__kicker mono">CH.FD · AGENT-NATIVE BROADCAST · LIVE SINCE {sinceDate}</p>
      <h1 class="ph-lead__title">Pick a door and enter the live town.</h1>
      <ul class="ph-verbs" aria-label="Primary actions">
        {verbDoors.map((door) => {
          const c = ramp(door.ch);
          return (
            <li>
              <a class="ph-verb" href={door.href} style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
                <span class="ph-verb__word">{door.verb}</span>
                <span class="ph-verb__arrow" aria-hidden="true">{door.arrow}</span>
                <span class="ph-verb__note mono">{door.note}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    {/* ============== ARCADE MARQUEE ============== */}
    <section class="ph-arcade" aria-label="The Arcade Marquee">
      <div class="ph-arcade__head mono">
        <span>THE ARCADE MARQUEE</span>
        <span class="ph-arcade__counter">{arcadeCount} GAMES · FREE · NO SIGNUP</span>
        <span class="ph-arcade__links">
          <a href="/win95-games">ALL GAMES →</a>
          <a href="/drum">DRUM GAMES →</a>
        </span>
      </div>
      <div class="ph-arcade__field">
        <ul class="ph-arcade__games">
          {featuredArcade.map((game) => (
            <li>
              <a class="ph-game" href={game.path}>
                <span class="ph-game__bar mono">
                  <span>{game.shortName}</span>
                  <span>LIVE</span>
                </span>
                <span class="ph-game__body">
                  <img
                    src={`https://noun.pics/${game.noun}.svg`}
                    width="72"
                    height="72"
                    loading="lazy"
                    alt={`Noun ${game.noun} for ${game.name}`}
                  />
                  <span class="ph-game__text">
                    <span class="ph-game__name">{game.name}</span>
                    <span class="ph-game__kicker mono">{game.kicker}</span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <img
          class="ph-arcade__walker"
          src="https://noun.pics/512.svg"
          width="48"
          height="48"
          loading="lazy"
          alt="Pixelated walking Noun 512"
        />
      </div>
    </section>

    {/* ============== THE TOWN IS ALIVE ============== */}
    <section class="ph-alive mono" aria-label="The town is alive">
      <a class="ph-alive__tile" href="/window" style={`--ch-600:${ramp('GDN').color600};--ch-800:${ramp('GDN').color800};`}>
        <span class="ph-alive__value"><span id="ph-temp2">{tempF}</span>°F</span>
        <span class="ph-alive__label">EL SEGUNDO · <span id="ph-cond2">{condition}</span></span>
      </a>
      <a class="ph-alive__tile" href="/wire" style={`--ch-600:${ramp('FD').color600};--ch-800:${ramp('FD').color800};`}>
        <span class="ph-alive__value">{todayCount}</span>
        <span class="ph-alive__label">BLOCKS TODAY</span>
      </a>
      <a class="ph-alive__tile" href="/wire" style={`--ch-600:${ramp('BTL').color600};--ch-800:${ramp('BTL').color800};`}>
        <span class="ph-alive__value">{shipsLast7}</span>
        <span class="ph-alive__label">SHIPS · 7 DAYS</span>
      </a>
      <a class="ph-alive__tile" href="/today" style={`--ch-600:${ramp('FCT').color600};--ch-800:${ramp('FCT').color800};`}>
        <span class="ph-alive__value" id="ph-pulse-n">{pulse?.n ?? blockCount}</span>
        <span class="ph-alive__label">DAILY PULSE</span>
      </a>
      <a class="ph-alive__tile" href="/coffee" style={`--ch-600:${ramp('GF').color600};--ch-800:${ramp('GF').color800};`}>
        <span class="ph-alive__value" id="ph-coffee-state">ON</span>
        <span class="ph-alive__label" id="ph-coffee-label">COFFEE POT</span>
      </a>
      <a class="ph-alive__tile" href="/drum" style={`--ch-600:${ramp('SPN').color600};--ch-800:${ramp('SPN').color800};`}>
        <span class="ph-alive__value">{drumGameCount}</span>
        <span class="ph-alive__label">DRUM GAMES</span>
      </a>
    </section>

    {/* ============== SHIPPED TODAY HERO ============== */}
    {heroShips.length > 0 && (
      <section class="ph-ships" aria-label="Shipped today" aria-roledescription="carousel">
        <div class="ph-ships__head mono">
          <span class="ph-ships__tag">{heroIsToday ? 'SHIPPED TODAY' : `SHIPPED ${heroDay}`}</span>
          <span class="ph-ships__count">{heroShips.length} SHIPS</span>
          <span class="ph-ships__ctrls">
            <button class="ph-ships__btn" id="ph-ships-prev" type="button" aria-label="Previous ship">←</button>
            <button class="ph-ships__btn" id="ph-ships-next" type="button" aria-label="Next ship">→</button>
          </span>
        </div>
        <ul class="ph-ships__reel" id="ph-ships-reel">
          {heroShips.map((s, i) => {
            const c = ramp(s.ch);
            return (
              <li
                class="ph-ships__slide"
                data-active={i === 0 ? '' : undefined}
                style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}
                aria-label={`Ship ${i + 1} of ${heroShips.length}`}
              >
                <span class="ph-ships__pr mono">PR #{s.num}</span>
                <a class="ph-ships__name" href={s.href}>{s.name}</a>
                <span class="ph-ships__desc">{s.desc}</span>
                <span class="ph-ships__links mono">
                  <a class="ph-ships__visit" href={s.href}>{s.cta}</a>
                  <a class="ph-ships__wire" href="/wire">SHIP LOG</a>
                </span>
              </li>
            );
          })}
        </ul>
        <div class="ph-ships__dots" id="ph-ships-dots" role="tablist" aria-label="Ships">
          {heroShips.map((s, i) => (
            <button type="button" role="tab" data-i={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Show ship ${i + 1}: ${s.name}`}></button>
          ))}
        </div>
      </section>
    )}

    {/* ============== DIRECTORY STRIP ============== */}
    <section class="ph-directory mono" aria-label="The town directory">
      <a class="ph-directory__title" href="/explore">THE TOWN · {townTotal} SURFACES</a>
      <div class="ph-directory__chips" aria-label="Directory categories">
        {directoryChips.map((chip) => {
          const c = ramp(chip.ch);
          return (
            <a class="ph-directory__chip" href="/explore" style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
              {chip.label}
            </a>
          );
        })}
      </div>
    </section>

    {/* ============== DAILY LOOP ============== */}
    {dailyPick && (
      <section
        class="ph-daily mono"
        aria-label="The daily loop"
        data-built-day={dailyToday}
        style={`--ch-50:${ramp('FCT').color50};--ch-600:${ramp('FCT').color600};--ch-800:${ramp('FCT').color800};`}
      >
        <span class="ph-daily__tag">DAILY</span>
        <a class="ph-daily__drop" href="/today" id="ph-daily-drop">
          TODAY'S DROP — № {dailyPick.data.id} · <span class="ph-daily__title" id="ph-daily-title">{dailyPick.data.title}</span>
        </a>
        <span class="ph-daily__also">
          <a href="/zen-cats">THE CAT</a>
          <span class="ph-daily__dot">·</span>
          <a href="/song-of-the-day">THE SONG</a>
        </span>
        {dailyNextId && (
          <span class="ph-daily__next" id="ph-daily-next">TOMORROW · № {dailyNextId} · 00:00 PT</span>
        )}
      </section>
    )}

    {/* ============== LATEST ============== */}
    <section class="ph-sec" aria-label="Latest from the broadcast">
      <div class="ph-sechead">
        <h2 class="ph-sechead__t mono">LATEST FROM THE BROADCAST</h2>
        <a class="ph-sechead__more mono" href="/archive">BROWSE ALL →</a>
      </div>
      <ol class="ph-latest">
        {latest.map((b) => {
          const c = ramp(b.data.channel);
          const ch = CHANNELS[b.data.channel];
          return (
            <li>
              <a class="ph-row" href={`/b/${b.data.id}`} style={`--ch-50:${c.color50};--ch-600:${c.color600};--ch-800:${c.color800};`}>
                <span class="ph-row__date mono">{fmtDate(new Date(b.data.timestamp))}</span>
                <span class="ph-row__chan mono">{ch?.code ?? b.data.channel}</span>
                <span class="ph-row__title">{b.data.title}</span>
                <span class="ph-row__id mono">/{b.data.id}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    {/* ============== FOOTER ============== */}
    <footer class="ph-foot mono">
      <nav class="ph-foot__nav" aria-label="More from PointCast">
        <a href="/mythos">MYTHOS</a>
        <a href="/residents">RESIDENTS</a>
        <a href="/wire">WIRE</a>
        <a href="/archive">ARCHIVE</a>
        <a href="/explore">EXPLORE</a>
        <a href="/for-agents">/FOR-AGENTS</a>
      </nav>
      <p class="ph-foot__note">BUILT IN THE OPEN · EL SEGUNDO, CA · {blockCount} BLOCKS SINCE {sinceDate}</p>
    </footer>

  </main>
</BlockLayout>

<script is:inline>
  (function () {
    'use strict';
    function set(id, v) { var el = document.getElementById(id); if (el && v != null) el.textContent = String(v); }
    function clock() {
      try {
        var f = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', hour: '2-digit', minute: '2-digit', hour12: false });
        set('ph-clock', 'EL SEGUNDO ' + f.format(new Date()) + ' PT');
      } catch (e) {}
    }
    function refreshWeather() {
      fetch('/api/weather?lat=33.92&lng=-118.42&label=el-segundo', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.ok) return;
          var c = d.condition ? String(d.condition).toLowerCase() : null;
          set('ph-temp', d.tempF); set('ph-temp2', d.tempF);
          set('ph-cond', c);       set('ph-cond2', c);
        }).catch(function () {});
    }
    // Pulse count refreshes from the raw log on main so it stays true even
    // when the site hasn't redeployed since yesterday's heartbeat commit.
    function refreshPulse() {
      if (!document.getElementById('ph-pulse-n')) return;
      fetch('https://raw.githubusercontent.com/mhoydich/pointcast/main/HEARTBEAT.log', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.text() : null; })
        .then(function (t) {
          if (!t) return;
          var n = t.trim().split('\n').filter(Boolean).length;
          if (n > 0) set('ph-pulse-n', n);
        }).catch(function () {});
    }
    function refreshCoffee() {
      fetch('/api/coffee/today', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || d.count == null) return;
          var n = Number(d.count) || 0;
          set('ph-coffee-state', n);
          set('ph-coffee-label', n === 1 ? 'CUP TODAY' : 'CUPS TODAY');
          set('ph-coffee-ticker', n === 1 ? '1 CUP POURED TODAY' : n + ' CUPS POURED TODAY');
        }).catch(function () {});
    }
    clock(); setInterval(clock, 30000);
    setInterval(refreshWeather, 300000);
    setInterval(refreshCoffee, 60000);
    refreshPulse();
    refreshCoffee();

    // SHIPPED TODAY hero rotation — auto-advance every 6s; pauses on hover
    // and focus, stops entirely for prefers-reduced-motion. Without JS the
    // first slide stays visible, so the section degrades to a static hero.
    (function () {
      var reel = document.getElementById('ph-ships-reel');
      var dots = document.getElementById('ph-ships-dots');
      if (!reel || !dots) return;
      var slides = reel.querySelectorAll('.ph-ships__slide');
      var tabs = dots.querySelectorAll('button');
      if (slides.length < 2) { dots.hidden = true; return; }
      var i = 0, timer = null;
      function show(n) {
        i = (n + slides.length) % slides.length;
        for (var k = 0; k < slides.length; k++) {
          if (k === i) slides[k].setAttribute('data-active', '');
          else slides[k].removeAttribute('data-active');
          tabs[k].setAttribute('aria-selected', k === i ? 'true' : 'false');
        }
      }
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function play() { if (!still && !timer) timer = setInterval(function () { show(i + 1); }, 6000); }
      function pause() { if (timer) { clearInterval(timer); timer = null; } }
      dots.addEventListener('click', function (e) {
        var b = e.target.closest('button[data-i]');
        if (b) { show(Number(b.dataset.i)); pause(); play(); }
      });
      var prev = document.getElementById('ph-ships-prev');
      var next = document.getElementById('ph-ships-next');
      if (prev) prev.addEventListener('click', function () { show(i - 1); pause(); play(); });
      if (next) next.addEventListener('click', function () { show(i + 1); pause(); play(); });
      var sec = reel.closest('.ph-ships');
      sec.addEventListener('mouseenter', pause);
      sec.addEventListener('mouseleave', play);
      sec.addEventListener('focusin', pause);
      sec.addEventListener('focusout', play);
      play();
    })();
  })();
</script>

<script type="application/json" id="ph-daily-ids" set:html={JSON.stringify(dailySortedIds)} />

<script>
  // Stale-proof the daily strip: same daily-core math as /today. If this
  // build's PT day has lapsed, recompute today's + tomorrow's picks and patch
  // the strip — the front door's "come back tomorrow" must never be yesterday.
  import { todayPT, pickDailyIndex } from '../lib/daily-core';

  (function () {
    const strip = document.querySelector<HTMLElement>('.ph-daily');
    const idsEl = document.getElementById('ph-daily-ids');
    if (!strip || !idsEl) return;
    const builtDay = strip.dataset.builtDay || '';
    if (!builtDay || builtDay === todayPT()) return;

    let ids: string[] = [];
    try { ids = JSON.parse(idsEl.textContent || '[]'); } catch { return; }
    if (!ids.length) return;

    const todayId = ids[pickDailyIndex(ids.length)];
    const nextId = ids[pickDailyIndex(ids.length, new Date(Date.now() + 86_400_000))];
    strip.dataset.builtDay = todayPT();

    const drop = document.getElementById('ph-daily-drop');
    if (drop && todayId) {
      drop.textContent = `TODAY'S DROP — № ${todayId}`;
      fetch(`/b/${todayId}.json`, { cache: 'no-store' })
        .then((r) => (r.ok ? r.json() : null))
        .then((b) => { if (b?.title) drop.textContent = `TODAY'S DROP — № ${todayId} · ${b.title}`; })
        .catch(() => {});
    }
    const next = document.getElementById('ph-daily-next');
    if (next && nextId) next.textContent = `TOMORROW · № ${nextId} · 00:00 PT`;
  })();
</script>

