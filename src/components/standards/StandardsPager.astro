---
import { STANDARDS } from '../../lib/pointcast-standards';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const index = STANDARDS.findIndex((entry) => entry.slug === slug);
const current = index >= 0 ? STANDARDS[index] : null;
const prev = index > 0 ? STANDARDS[index - 1] : null;
const next = index >= 0 && index < STANDARDS.length - 1 ? STANDARDS[index + 1] : null;
---

{current && (
  <nav class="std-pager" aria-label="Standards series">
    {prev ? <a href={prev.humanPath}>No. {prev.number} · {prev.shortTitle}</a> : <span>First in the series</span>}
    <a href="/standards/">All standards</a>
    {next ? <a href={next.humanPath}>No. {next.number} · {next.shortTitle}</a> : <span>Last in the series</span>}
  </nav>
)}

<style>
  .std-pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .std-pager a { color: inherit; }
</style>
