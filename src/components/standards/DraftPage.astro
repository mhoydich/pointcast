---
import BlockLayout from '../../layouts/BlockLayout.astro';
import StandardsPager from './StandardsPager.astro';
import { CHANNELS } from '../../lib/channels';
import { standardsJsonLd } from '../../lib/pointcast-standards';
import '../../styles/chain.css';

interface Props {
  number: number;
  slug: string;
  title: string;
  principle: string;
  description: string;
}

const { number, slug, title, principle, description } = Astro.props;
const ch = CHANNELS.FD;
const spec = `/standards/${slug}/spec.md`;
const jsonLd = standardsJsonLd({
  type: 'TechArticle',
  title,
  description,
  url: `https://pointcast.xyz/standards/${slug}/`,
});
---

<BlockLayout title={title} description={description} author="grok" creator="grok" jsonLd={jsonLd} hideAds
  alternates={[
    { type: 'text/markdown', href: spec, title: 'Machine-readable spec' },
    { type: 'application/json', href: '/standards.json', title: 'Standards catalog' },
  ]}
>
  <article class="chn cs" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span aria-hidden="true">/</span>
      <a href="/standards/">standards</a><span aria-hidden="true">/</span>
      <span>{slug}</span>
    </nav>
    <p class="kicker">POINTCAST STANDARDS · NO. {number} · DRAFT · 2026-10-05</p>
    <h1>{title}</h1>
    <p class="note"><em>First principle:</em> {principle}</p>
    <slot />
    <StandardsPager slug={slug} />
    <p class="fine">Machine spec: <a href={spec}>{spec}</a> · Series: <a href="/standards/">/standards/</a> · Checker: <a href="/standards/check/">/standards/check/</a>.</p>
  </article>
</BlockLayout>
