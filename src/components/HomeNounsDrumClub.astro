---
/** A compact front-door invitation to the Nouns Drum Club. */
const nouns = [
  { id: 23, src: '/games/nouns-nation-battler/assets/noun-23.svg', label: 'Noun 23' },
  { id: 37, src: '/games/nouns-nation-battler/assets/noun-37.svg', label: 'Noun 37' },
  { id: 36, src: '/games/nouns-nation-battler/assets/noun-36.svg', label: 'Noun 36' },
];
---

<section class="shelf noun-club" id="nouns-drum-club" aria-labelledby="nouns-drum-club-title">
  <div class="noun-club__art" aria-hidden="true">
    <div class="noun-club__sun"></div>
    <div class="noun-club__nouns">
      {nouns.map((noun) => <img src={noun.src} alt={noun.label} width="84" height="84" loading="lazy" />)}
    </div>
    <div class="noun-club__keys"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </div>
  <div class="noun-club__copy">
    <p class="shelf__kicker">NOUNS DRUM CLUB · NEW ROOM · NO LOGIN</p>
    <h2 class="shelf__title" id="nouns-drum-club-title">Make some noise <em>together.</em></h2>
    <p class="shelf__dek">Play a full keyboard of drums beneath a reactive Noun band, build a loop, and drop into a shared room. Your browser makes the sound; the room keeps the beat moving between people.</p>
    <div class="shelf__actions">
      <a href="/nouns/drum-club/">Enter the Drum Club ↗</a>
      <a href="/nouns/drum-club/bandmates/">Meet the bandmates</a>
      <a href="/nouns/">Browse the Nouns shelf</a>
    </div>
    <p class="noun-club__note">Keyboard-friendly · shared live rooms · local loops · no account required</p>
  </div>
</section>

<style>
  .noun-club { --shelf-color:#e65a45; --shelf-color-2:#7256bd; display:grid; grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr); gap:clamp(20px,4vw,56px); align-items:center; overflow:hidden; background:#fbf2df; }
  .noun-club__copy { min-width:0; }
  .noun-club__art { position:relative; min-height:240px; display:grid; place-items:center; background:#f2c63e; border:2px solid #17151b; overflow:hidden; }
  .noun-club__sun { position:absolute; width:210px; height:210px; border-radius:50%; background:#f7e6b2; opacity:.72; }
  .noun-club__nouns { position:relative; z-index:1; display:flex; align-items:end; gap:4px; transform:translateY(-10px); }
  .noun-club__nouns img { display:block; width:clamp(64px,10vw,100px); height:auto; image-rendering:auto; }
  .noun-club__nouns img:nth-child(2) { transform:translateY(-18px) rotate(-3deg); }
  .noun-club__nouns img:nth-child(3) { transform:rotate(4deg); }
  .noun-club__keys { position:absolute; right:-4%; bottom:15px; width:110%; height:40px; display:flex; gap:3px; transform:rotate(-4deg); }
  .noun-club__keys i { flex:1; background:#fffaf0; border:2px solid #17151b; box-shadow:0 5px 0 #17151b; }
  .noun-club__keys i:nth-child(2), .noun-club__keys i:nth-child(4), .noun-club__keys i:nth-child(6) { background:#7256bd; }
  .noun-club .shelf__title { max-width:12ch; }
  .noun-club__note { margin:18px 0 0; color:#554b42; font:700 10px/1.4 'JetBrains Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
  @media (max-width:700px) { .noun-club { grid-template-columns:1fr; } .noun-club__art { min-height:190px; } .noun-club .shelf__title { max-width:none; } }
</style>
