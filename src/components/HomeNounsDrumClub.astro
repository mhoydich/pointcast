---
import { NOUNS_BANDMATES_RELEASE } from '../lib/nouns-bandmates-mint';
const bandmates = [
  { name: 'Pocket Captain', role: 'DRUMS', src: '/images/nouns-drum-club/bandmates/01-pocket-captain.webp' },
  { name: 'Sidewalk Bassline', role: 'BASS', src: '/images/nouns-drum-club/bandmates/05-sidewalk-bassline.webp' },
  { name: 'Glass Garden', role: 'MELODY', src: '/images/nouns-drum-club/bandmates/08-glass-garden.webp' },
  { name: 'Cloud Nine', role: 'CHORDS', src: '/images/nouns-drum-club/bandmates/10-cloud-nine.webp' },
];
const editionsLive = NOUNS_BANDMATES_RELEASE.status === 'live' && Boolean(NOUNS_BANDMATES_RELEASE.contract);
---

<section class="premiere" id="nouns-drum-club" aria-labelledby="nouns-drum-club-title">
  <div class="premiere__ribbon"><span><b aria-hidden="true">✳</b> POINTCAST PREMIERE / NOUNS DRUM CLUB</span><span>FOUR FRIENDS / ONE GROOVE / EVERYBODY’S IN</span></div>
  <div class="premiere__body">
    <div class="premiere__copy">
      <p class="premiere__eyebrow">A LITTLE BAND. A BIG OPEN DOOR.</p>
      <h2 id="nouns-drum-club-title">EVERYBODY’S<br /><em>IN THE BAND.</em></h2>
      <p class="premiere__dek">Pick your drummer, bass player, melody and chords. Make one of 81 bands, then play your own beat across the full keyboard. Invite a friend and trade live notes.</p>
      <div class="premiere__actions"><a class="premiere__primary" href="/nouns/drum-club/bandmates/#make-a-band">MAKE YOUR BAND <span aria-hidden="true">↗</span></a><a href="/nouns/drum-club/">PLAY THE KEYBOARD <span aria-hidden="true">↗</span></a></div>
      <p class="premiere__access">Free to play · keyboard and touch · live rooms · no account needed</p>
    </div>
    <div class="premiere__scene" role="img" aria-label="Pocket Captain, Sidewalk Bassline, Glass Garden, and Cloud Nine Bandmate artwork">
      <div class="premiere__sun" aria-hidden="true"></div>
      {bandmates.map((member, index) => <div class={`premiere__card premiere__card--${index}`} aria-hidden="true"><img src={member.src} alt="" width="800" height="800" loading="lazy" decoding="async" /><div><b>{member.name}</b><span>{member.role}</span></div></div>)}
      <span class="premiere__burst" aria-hidden="true">12<small>BANDMATES</small></span>
    </div>
  </div>
  <div class="premiere__foot"><p><strong>THE MUSIC IS EVERYONE’S.</strong> Twelve playable Bandmates and a collectible Tezos companion set.</p><div><a href="/nouns/drum-club/bandmates/">{editionsLive ? 'MEET & COLLECT THE BANDMATES' : 'MEET THE BANDMATES'} ↗</a><a href="/nouns/drum-club/campaign/">SEE THE CAMPAIGN ↗</a></div></div>
</section>

<style>
  .premiere{margin:20px 0 28px;background:#f0e94a;color:#171717;border:3px solid #171717;box-shadow:9px 9px 0 #171717;font-family:Inter,Arial,sans-serif;overflow:hidden}
  .premiere__ribbon{display:flex;justify-content:space-between;gap:16px;padding:13px 20px;border-bottom:3px solid #171717;background:#171717;color:#fff;font:800 11px/1.2 'JetBrains Mono',monospace;letter-spacing:.08em}.premiere__ribbon b{color:#f0e94a;font-size:20px;line-height:0;vertical-align:-2px}
  .premiere__body{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);min-height:490px}.premiere__copy{padding:clamp(30px,5vw,64px) clamp(24px,4vw,56px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.premiere__eyebrow{margin:0 0 26px;font:800 12px/1.4 'JetBrains Mono',monospace;letter-spacing:.13em}
  .premiere h2{margin:0;font:950 clamp(48px,6vw,91px)/.84 Inter,Arial,sans-serif;letter-spacing:-.085em;max-width:10ch;text-wrap:balance}.premiere h2 em{font-style:normal;color:#e5482a}.premiere__dek{max-width:43ch;margin:30px 0 26px;font-size:clamp(16px,1.7vw,19px);line-height:1.45;font-weight:570}
  .premiere__actions{display:flex;flex-wrap:wrap;gap:10px}.premiere__actions a{min-height:52px;display:inline-flex;align-items:center;justify-content:center;gap:15px;padding:12px 18px;border:2px solid #171717;background:#fffdf6;color:#171717;text-decoration:none;font:800 12px/1.3 'JetBrains Mono',monospace}.premiere__actions .premiere__primary{background:#171717;color:#fff;box-shadow:4px 4px 0 #e5482a}.premiere__actions a:hover,.premiere__foot a:hover{transform:translateY(-2px)}.premiere__access{margin:22px 0 0;font:700 10px/1.5 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.05em}
  .premiere__scene{position:relative;min-height:490px;background:#b9a4dc;border-left:3px solid #171717;overflow:hidden}.premiere__sun{position:absolute;width:70%;aspect-ratio:1;border-radius:50%;left:15%;top:8%;background:#f6b4a0;border:3px solid #171717}
  .premiere__card{position:absolute;width:36%;background:#fff;border:3px solid #171717;box-shadow:6px 6px 0 #171717;transform:rotate(var(--r));transition:transform .2s ease}.premiere__card:hover{transform:translateY(-7px) rotate(var(--r))}.premiere__card img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}.premiere__card>div{display:flex;justify-content:space-between;gap:6px;align-items:end;padding:8px 9px;border-top:2px solid #171717;font:800 10px/1.1 'JetBrains Mono',monospace}.premiere__card b{font-weight:800;overflow-wrap:anywhere}.premiere__card span{font-size:8px;color:#6754a2}.premiere__card--0{--r:-11deg;top:8%;left:8%}.premiere__card--1{--r:9deg;top:11%;right:8%}.premiere__card--2{--r:7deg;bottom:9%;left:11%}.premiere__card--3{--r:-8deg;bottom:7%;right:9%}
  .premiere__burst{position:absolute;z-index:2;left:42%;top:43%;width:83px;height:83px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#e5482a;color:#fff;border:3px solid #171717;box-shadow:4px 4px 0 #171717;font:950 35px/.9 Inter,Arial,sans-serif;transform:rotate(-7deg)}.premiere__burst small{font:800 7px/1 'JetBrains Mono',monospace;letter-spacing:.05em;margin-top:4px}
  .premiere__foot{border-top:3px solid #171717;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px 24px;background:#fffdf6}.premiere__foot p{margin:0;max-width:48ch;font-size:12px;line-height:1.5}.premiere__foot strong{font-weight:850}.premiere__foot>div{display:flex;gap:15px;flex-wrap:wrap}.premiere__foot a{font:800 10px/1.5 'JetBrains Mono',monospace;white-space:nowrap;text-underline-offset:3px}.premiere a:focus-visible{outline:3px solid #7256bd;outline-offset:4px}
  @media(max-width:900px){.premiere__body{grid-template-columns:1fr}.premiere__scene{border-left:0;border-top:3px solid #171717;min-height:490px}.premiere h2{font-size:clamp(52px,10vw,90px)}.premiere__ribbon span:last-child{display:none}}@media(max-width:600px){.premiere{margin-right:8px;box-shadow:6px 6px 0 #171717}.premiere__scene{min-height:365px}.premiere__card{width:39%;box-shadow:4px 4px 0 #171717}.premiere__card>div{padding:5px 6px;font-size:8px}.premiere__card span{font-size:7px}.premiere__burst{left:40%;top:40%;width:65px;height:65px;font-size:27px}.premiere__foot{align-items:flex-start;flex-direction:column}.premiere__foot a{white-space:normal}}@media(prefers-reduced-motion:reduce){.premiere__card{transition:none}.premiere__card:hover{transform:rotate(var(--r))}}
</style>
