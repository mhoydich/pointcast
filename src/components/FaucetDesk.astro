---
/**
 * FaucetDesk — the claim-and-deliver desk for one faucet.
 *
 * States, all spelled out in plain English rather than a contract explorer:
 *   signed out       → one button that sends you to Google sign-in and back
 *   signed in        → "Claim today's HELLO" (a ledger write, nothing on chain)
 *   receipt in hand  → "Keep this fish" (the same write, earned somewhere else)
 *   receipt needed   → a pointer at /rewards/start, because FISHCLUB has no
 *                      button of its own
 *   owed drips       → an address field and "Send my HELLO" (the spigot pays gas)
 *
 * A satellite sends people back to /faucet/{slug}#receipt=…. The fragment is
 * read once and stripped before anything else runs, and the receipt is kept in
 * this tab's sessionStorage so a sign-in on the way back does not lose it. It
 * never goes in a link, a query string or a log.
 *
 * Nobody signs anything on this desk. That is the design, not a gap.
 */
import type { FaucetToken } from '../lib/faucet';
import { rewardProgramsForFaucet } from '../lib/rewards';

interface Props { faucet: FaucetToken; returnTo?: string }
const { faucet, returnTo = `/faucet/${Astro.props.faucet.slug}` } = Astro.props;
/** The program that pays out of this faucet, when there is one. */
const program = rewardProgramsForFaucet(faucet.slug)[0] ?? null;
const startHref = program ? `/rewards/start?program=${encodeURIComponent(program.id)}` : '';
---

<section
  class="desk"
  data-faucet-desk
  data-faucet={faucet.slug}
  data-ticker={faucet.ticker}
  data-contract={faucet.contract}
  data-return-to={returnTo}
  data-claim-mode={faucet.claim}
  data-start-href={startHref}
>
  <div class="desk__claim">
    <button type="button" class="desk__button" data-faucet-claim>
      Claim today’s {faucet.ticker} — free
    </button>
    <p class="desk__state" data-faucet-state role="status" aria-live="polite">Checking your PointCast session…</p>
    <p class="desk__door" data-faucet-door hidden>
      Sign in with Google to claim. No wallet needed; PointCast keeps a ledger line for you.
    </p>
    <p class="desk__balances" data-faucet-balances hidden></p>
  </div>

  <div class="desk__owed" data-faucet-owed hidden>
    <p class="desk__owed-line">You are owed <b data-faucet-held>0</b> {faucet.ticker} · <span data-faucet-delivered-line>0 delivered</span></p>
    <form class="desk__send" data-faucet-send-form>
      <label class="desk__label" for={`faucet-address-${faucet.slug}`}>Send everything you are owed to this Ethereum address</label>
      <div class="desk__send-row">
        <input id={`faucet-address-${faucet.slug}`} name="address" class="desk__input" type="text" inputmode="text" autocomplete="off" spellcheck="false" placeholder="0x…" pattern="^0x[0-9a-fA-F]{40}$" data-faucet-address />
        <button type="submit" class="desk__button desk__button--send" data-faucet-send>Send my {faucet.ticker}</button>
      </div>
      <p class="desk__fine">The spigot wallet sends one transaction and pays the gas. You sign nothing. Any Ethereum address works: a hardware wallet, an exchange deposit address, a friend.</p>
      <p class="desk__state desk__state--send" data-faucet-send-state role="status" aria-live="polite"></p>
    </form>
  </div>

  <ol class="desk__ledger" data-faucet-ledger hidden></ol>
</section>

<script>
  import type { PointCastUser } from '../lib/auth/types';
  import { getSession } from '../lib/auth/client';

  type LedgerLine = {
    day: string;
    amount: number;
    status: 'held' | 'submitting' | 'delivered';
    txHash: string | null;
    deliveredTo: string | null;
    via: string | null;
    program: string | null;
  };
  type Balance = { slug: string; ticker: string; held: number; delivered: number };
  type DeskState = {
    ok: boolean;
    ledger: boolean;
    claims: { configured: boolean; cap: number; claimedToday: number; remainingToday: number };
    spigot: { address: string; tokenBalance: number; lowGas: boolean; lowGasWarning: boolean } | null;
    you: { today: { claimed: boolean }; held: number; delivered: number; linkedAddress: string | null; claims: LedgerLine[] } | null;
    balances: Balance[] | null;
  };
  type ClaimResponse = { ok: boolean; reason?: string; claim?: { day: string; amount: number } };
  type DeliverResponse = { ok: boolean; reason?: string; delivered: number; txHash?: string; deliveredTo?: string };

  /** Satellite ids to the names people actually use for them. */
  const VIA_NAMES: Record<string, string> = { industrynext: 'Industry Next', tonebloom: 'Tone Bloom' };

  const roots = (): HTMLElement[] => Array.from(document.querySelectorAll('[data-faucet-desk]'));
  const q = <T extends HTMLElement>(root: HTMLElement, sel: string): T | null => root.querySelector<T>(sel);
  const receiptKey = (slug: string): string => `pc:reward-receipt:${slug}`;

  function readStore(key: string): string {
    try { return window.sessionStorage.getItem(key) ?? ''; } catch { return ''; }
  }
  function writeStore(key: string, value: string): void {
    try { window.sessionStorage.setItem(key, value); } catch { /* private mode; the claim still works this tab */ }
  }
  function clearStore(key: string): void {
    try { window.sessionStorage.removeItem(key); } catch { /* nothing to do */ }
  }

  /**
   * Take the receipt out of the URL before anything else can see it. Fragments
   * never reach a server, but they do sit in the address bar, in history and in
   * anything that reads location later, so this runs first and once.
   */
  function captureReceipt(root: HTMLElement): string {
    const slug = root.dataset.faucet ?? '';
    const key = receiptKey(slug);
    const hash = window.location.hash;
    const match = /^#receipt=(.+)$/.exec(hash);
    if (match) {
      writeStore(key, decodeURIComponent(match[1]));
      history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
    }
    return readStore(key);
  }

  function etherscan(hash: string): HTMLAnchorElement {
    const link = document.createElement('a');
    link.href = `https://etherscan.io/tx/${hash}`;
    link.target = '_blank';
    link.rel = 'noopener';
    link.textContent = 'receipt ↗';
    return link;
  }

  function status(root: HTMLElement, sel: string, message: string, hash?: string): void {
    const node = q(root, sel);
    if (!node) return;
    node.replaceChildren(message);
    if (hash) node.append(' · ', etherscan(hash));
  }

  function shortAddr(address: string): string {
    return `${address.slice(0, 6)}…${address.slice(-4)}`;
  }

  /** Sending is closed for every faucet right now, so say so in the room's own words. */
  function heldHere(root: HTMLElement): string {
    return root.dataset.faucet === 'fishclub'
      ? 'Your fish is held here. Sending comes later.'
      : 'The spigot wallet is not funded yet. Your drips are safe in the ledger; sending opens once it is.';
  }

  /** "Keep this fish" for FISHCLUB, the plain thing for anything else. */
  function keepLabel(root: HTMLElement): string {
    return root.dataset.faucet === 'fishclub' ? 'Keep this fish' : `Keep this ${root.dataset.ticker}`;
  }

  async function readState(root: HTMLElement): Promise<DeskState> {
    const response = await fetch(`/api/faucet/${root.dataset.faucet}`, { cache: 'no-store', credentials: 'include' });
    if (!response.ok) throw new Error(`desk-state-${response.status}`);
    return await response.json() as DeskState;
  }

  function paintBalances(root: HTMLElement, state: DeskState): void {
    const node = q(root, '[data-faucet-balances]');
    if (!node) return;
    const balances = state.balances ?? [];
    // Both tokens together, or neither: the scope asked for them discoverable
    // in one place, and a row of zeroes is noise on a first visit.
    if (!balances.some((balance) => balance.held > 0 || balance.delivered > 0)) {
      node.hidden = true;
      node.textContent = '';
      return;
    }
    node.textContent = balances
      .map((balance) => `${balance.ticker} ${balance.held} held${balance.delivered ? ` · ${balance.delivered} sent` : ''}`)
      .join(' · ');
    node.hidden = false;
  }

  function paintLedger(root: HTMLElement, state: DeskState): void {
    const ticker = root.dataset.ticker ?? '';
    const owed = q(root, '[data-faucet-owed]');
    const ledger = q<HTMLOListElement>(root, '[data-faucet-ledger]');
    paintBalances(root, state);
    if (!owed || !ledger || !state.you) return;
    const held = q(root, '[data-faucet-held]');
    if (held) held.textContent = String(state.you.held);
    const deliveredLine = q(root, '[data-faucet-delivered-line]');
    if (deliveredLine) deliveredLine.textContent = `${state.you.delivered} delivered`;
    owed.hidden = state.you.held <= 0 && state.you.delivered <= 0;
    const input = q<HTMLInputElement>(root, '[data-faucet-address]');
    if (input && !input.value && state.you.linkedAddress) input.value = state.you.linkedAddress;
    const send = q<HTMLButtonElement>(root, '[data-faucet-send]');
    if (send) {
      send.disabled = state.you.held <= 0 || !state.claims.configured;
      send.textContent = state.you.held > 0 ? `Send my ${state.you.held} ${ticker}` : `Send my ${ticker}`;
    }
    if (!state.claims.configured) {
      status(root, '[data-faucet-send-state]', heldHere(root));
    } else if (state.spigot?.lowGas) {
      status(root, '[data-faucet-send-state]', 'The spigot is low on gas. Drips stay in the ledger until it is topped up.');
    } else if (state.spigot?.lowGasWarning) {
      status(root, '[data-faucet-send-state]', 'The spigot is getting low on gas. Sending still works.');
    } else {
      status(root, '[data-faucet-send-state]', '');
    }
    ledger.replaceChildren(...state.you.claims.map((line) => {
      const item = document.createElement('li');
      const day = document.createElement('b');
      day.textContent = line.day;
      const what = document.createElement('span');
      // A `submitting` line with a hash is already signed and on the wire: it
      // is settling against Ethereum, not waiting on us.
      const where = line.status === 'delivered'
        ? `sent to ${shortAddr(line.deliveredTo ?? '')}`
        : line.status === 'submitting'
          ? (line.txHash ? 'settling…' : 'sending…')
          : 'held for you';
      what.textContent = `${line.amount} ${ticker} · ${where}`;
      item.append(day, what);
      if (line.via) {
        const via = document.createElement('em');
        via.textContent = `via ${VIA_NAMES[line.via] ?? line.via}`;
        item.append(via);
      }
      if (line.txHash) item.append(etherscan(line.txHash));
      return item;
    }));
    ledger.hidden = state.you.claims.length === 0;
  }

  function signedOut(root: HTMLElement): void {
    root.dataset.session = 'signed-out';
    q(root, '[data-faucet-door]')?.removeAttribute('hidden');
    const button = q<HTMLButtonElement>(root, '[data-faucet-claim]');
    const receipt = readStore(receiptKey(root.dataset.faucet ?? ''));
    if (button) {
      button.disabled = false;
      button.textContent = receipt ? `Sign in to keep this ${root.dataset.ticker}` : `Sign in to claim today’s ${root.dataset.ticker}`;
    }
    status(
      root,
      '[data-faucet-state]',
      receipt
        ? 'Sign in with the account that started the run. It is waiting in this tab.'
        : 'Google sign-in is the claim ticket. No wallet.',
    );
  }

  /** The FISHCLUB desk with nothing in hand: point at the run, do not pretend. */
  function needsRun(root: HTMLElement, button: HTMLButtonElement): void {
    root.dataset.mode = 'needs-run';
    button.disabled = false;
    button.textContent = root.dataset.faucet === 'fishclub' ? 'Start and keep a fish' : 'Start a run';
    status(root, '[data-faucet-state]', 'Five quiet minutes on Tone Bloom earn one. Start there.');
  }

  async function signedIn(root: HTMLElement, _user: PointCastUser): Promise<void> {
    root.dataset.session = 'signed-in';
    q(root, '[data-faucet-door]')?.setAttribute('hidden', '');
    const button = q<HTMLButtonElement>(root, '[data-faucet-claim]');
    if (!button) return;
    const receipt = readStore(receiptKey(root.dataset.faucet ?? ''));
    try {
      const state = await readState(root);
      paintLedger(root, state);
      if (!state.ledger) {
        button.disabled = true;
        status(root, '[data-faucet-state]', 'The ledger is not bound on this deploy. Try again shortly.');
        return;
      }
      if (state.you?.today.claimed) {
        button.disabled = true;
        button.textContent = 'Claimed today';
        // A receipt kept past its own redemption is just clutter in the tab.
        if (receipt) clearStore(receiptKey(root.dataset.faucet ?? ''));
        status(
          root,
          '[data-faucet-state]',
          root.dataset.faucet === 'fishclub'
            ? 'Today’s fish is already here. The room is still open.'
            : `Today’s ${root.dataset.ticker} is in your ledger. The spigot resets at midnight Pacific.`,
        );
        return;
      }
      if (state.claims.remainingToday <= 0) {
        button.disabled = true;
        status(root, '[data-faucet-state]', 'Today’s drips are all spoken for. Tomorrow at midnight Pacific.');
        return;
      }
      if (receipt) {
        root.dataset.mode = 'receipt';
        button.disabled = false;
        button.textContent = keepLabel(root);
        status(root, '[data-faucet-state]', 'Your run came back with you. Keep it.');
        return;
      }
      if (root.dataset.claimMode === 'receipt' && root.dataset.startHref) {
        needsRun(root, button);
        return;
      }
      root.dataset.mode = 'claim';
      button.disabled = false;
      button.textContent = `Claim today’s ${root.dataset.ticker} — free`;
      status(root, '[data-faucet-state]', `${state.claims.claimedToday} claimed today · ${state.claims.remainingToday} left`);
    } catch {
      button.disabled = true;
      status(root, '[data-faucet-state]', 'The desk is unavailable. Try again shortly.');
    }
  }

  function claimReason(root: HTMLElement, reason: string | undefined): string {
    if (reason === 'already-claimed') {
      return root.dataset.faucet === 'fishclub'
        ? 'Today’s fish is already here. The room is still open.'
        : 'Today’s HELLO is already here.';
    }
    if (reason === 'daily-cap-reached') return 'Today’s drips are all spoken for.';
    if (reason === 'claim-database-not-bound') return 'The ledger is not bound on this deploy.';
    if (reason === 'account-mismatch') return 'This fish was started by a different account. Sign in with that one to keep it.';
    if (reason === 'receipt-required') return 'Five quiet minutes on Tone Bloom earn one. Start there.';
    if (reason === 'receipt-expired') return 'That run took too long to come back. Start a fresh one and it will keep.';
    if (reason === 'receipt-invalid' || reason === 'receipt-program-mismatch') return 'That run did not check out. Start a fresh one.';
    if (reason === 'receipt-too-short') return 'The run did not reach five credited minutes. The room is still open.';
    if (reason === 'run-not-found' || reason === 'run-expired') return 'PointCast has no open run for that. Start a fresh one.';
    if (reason === 'rewards-not-configured') return 'This reward is not switched on yet. Nothing was written.';
    if (reason === 'claim-unavailable') return 'The desk could not reach the ledger. Nothing was written; try again shortly.';
    return 'The claim did not go through. Try again shortly.';
  }

  function deliverReason(reason: string | undefined): string {
    if (reason === 'address-required') return 'That is not an Ethereum address. It starts with 0x and is 42 characters long.';
    if (reason === 'nothing-held') return 'Nothing is owed right now.';
    if (reason === 'delivery-busy') return 'The spigot is mid-send. Give it a minute and try again; a stalled send settles itself against Ethereum.';
    if (reason === 'spigot-not-configured') return 'The spigot wallet is not funded yet. Your drips stay in the ledger.';
    if (reason === 'spigot-low-gas') return 'The spigot is low on gas. Your drips stay in the ledger until it is topped up.';
    if (reason === 'spigot-empty') return 'The spigot is out of tokens. Your drips stay in the ledger until it is refilled.';
    if (reason === 'spigot-unavailable') return 'The spigot can’t reach Ethereum right now. Your drips are safe; try again shortly.';
    if (reason === 'delivery-unavailable') return 'The desk could not reach the ledger. Nothing was sent; try again shortly.';
    if (reason === 'delivery-failed') return 'Ethereum did not accept the send. Nothing was lost; try again shortly.';
    if (reason === 'delivery-uncertain') return 'Ethereum didn’t confirm the send yet. Nothing was lost and nothing will be sent twice; this settles itself. Check back in a few minutes.';
    return 'The send did not go through. Nothing was lost; try again shortly.';
  }

  async function claim(root: HTMLElement): Promise<void> {
    const button = q<HTMLButtonElement>(root, '[data-faucet-claim]');
    if (!button || button.disabled) return;
    const slug = root.dataset.faucet ?? '';
    const key = receiptKey(slug);
    if (root.dataset.session !== 'signed-in') {
      window.location.assign(`/api/auth/google?returnTo=${encodeURIComponent(root.dataset.returnTo || `/faucet/${slug}`)}`);
      return;
    }
    if (root.dataset.mode === 'needs-run' && root.dataset.startHref) {
      window.location.assign(root.dataset.startHref);
      return;
    }
    const receipt = readStore(key);
    const label = receipt ? keepLabel(root) : `Claim today’s ${root.dataset.ticker} — free`;
    button.disabled = true;
    button.textContent = 'Writing the ledger line…';
    try {
      const response = await fetch(`/api/faucet/${slug}/claim`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(receipt ? { receipt } : {}),
      });
      const payload = await response.json() as ClaimResponse;
      if (!response.ok || !payload.ok) {
        // A receipt that will never work again is cleared; one that only needs
        // a different account, or a retry, stays where it is.
        if (receipt && payload.reason !== 'account-mismatch' && payload.reason !== 'claim-unavailable') clearStore(key);
        if (payload.reason === 'receipt-required' && root.dataset.startHref) {
          needsRun(root, button);
          return;
        }
        button.textContent = payload.reason === 'already-claimed' ? 'Claimed today' : label;
        button.disabled = payload.reason === 'already-claimed' || payload.reason === 'daily-cap-reached';
        status(root, '[data-faucet-state]', claimReason(root, payload.reason));
        return;
      }
      clearStore(key);
      button.textContent = 'Claimed today';
      status(
        root,
        '[data-faucet-state]',
        receipt
          ? `One ${root.dataset.ticker} is in your ledger. Leave it here. Come back when you like.`
          : `${payload.claim?.amount ?? 1} ${root.dataset.ticker} is in your ledger. Send it anywhere below, or let it stack.`,
      );
      window.dispatchEvent(new CustomEvent('pc:faucet-claim', { detail: payload.claim }));
      const state = await readState(root).catch(() => null);
      if (state) paintLedger(root, state);
    } catch {
      button.disabled = false;
      button.textContent = label;
      status(root, '[data-faucet-state]', 'The desk lost the connection. Check your ledger before trying again.');
    }
  }

  async function deliver(root: HTMLElement): Promise<void> {
    const send = q<HTMLButtonElement>(root, '[data-faucet-send]');
    const input = q<HTMLInputElement>(root, '[data-faucet-address]');
    if (!send || send.disabled || !input) return;
    const address = input.value.trim();
    if (!/^0x[0-9a-fA-F]{40}$/.test(address)) {
      status(root, '[data-faucet-send-state]', deliverReason('address-required'));
      return;
    }
    const lower = address.toLowerCase();
    if (lower === `0x${'0'.repeat(40)}` || lower === (root.dataset.contract ?? '').toLowerCase()) {
      status(root, '[data-faucet-send-state]', 'That address would burn the drips — it is the token’s own contract or the zero address. Use a wallet you control.');
      return;
    }
    send.disabled = true;
    const label = send.textContent;
    send.textContent = 'Sending…';
    status(root, '[data-faucet-send-state]', 'The spigot is signing and broadcasting. Ethereum takes about twelve seconds per block.');
    try {
      const response = await fetch(`/api/faucet/${root.dataset.faucet}/deliver`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ address }),
      });
      const payload = await response.json() as DeliverResponse;
      if (!response.ok || !payload.ok) {
        send.disabled = false;
        send.textContent = label;
        status(root, '[data-faucet-send-state]', deliverReason(payload.reason), payload.txHash);
        return;
      }
      status(root, '[data-faucet-send-state]', `${payload.delivered} ${root.dataset.ticker} sent to ${shortAddr(payload.deliveredTo ?? address)}.`, payload.txHash);
      window.dispatchEvent(new CustomEvent('pc:faucet-deliver', { detail: payload }));
      const state = await readState(root).catch(() => null);
      if (state) paintLedger(root, state);
    } catch {
      send.disabled = false;
      send.textContent = label;
      status(root, '[data-faucet-send-state]', 'The desk lost the connection. Check your ledger before trying again.');
    }
  }

  async function initialize(root: HTMLElement): Promise<void> {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    captureReceipt(root);
    const user = await getSession().catch(() => null);
    if (user) await signedIn(root, user);
    else signedOut(root);
  }

  roots().forEach((root) => void initialize(root));
  document.addEventListener('astro:page-load', () => roots().forEach((root) => void initialize(root)));
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest('[data-faucet-claim]');
    const root = button?.closest<HTMLElement>('[data-faucet-desk]');
    if (root) void claim(root);
  });
  document.addEventListener('submit', (event) => {
    const form = (event.target as Element | null)?.closest('[data-faucet-send-form]');
    const root = form?.closest<HTMLElement>('[data-faucet-desk]');
    if (!root) return;
    event.preventDefault();
    void deliver(root);
  });
</script>

<style>
  .desk { display: grid; gap: 18px; }
  .desk__button { width: 100%; min-height: 58px; border: 1.5px solid #fff; border-radius: 2px; background: #fff; color: var(--spigot, #185FA5); padding: 15px 18px; cursor: pointer; font: 500 14px var(--pc-font-mono); letter-spacing: .04em; text-transform: uppercase; box-shadow: 5px 5px 0 rgba(0,0,0,.22); }
  .desk__button:disabled { cursor: not-allowed; opacity: .62; box-shadow: none; }
  .desk__button--send { width: auto; min-height: 46px; padding: 10px 16px; font-size: 12px; white-space: nowrap; }
  .desk__state, .desk__door, .desk__fine, .desk__label, .desk__owed-line { margin: 8px 0 0; font-size: 12px; line-height: 1.45; color: #fff; }
  .desk__door { color: rgba(255,255,255,.82); }
  .desk__balances { margin: 10px 0 0; font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.82); }
  .desk__state a, .desk__ledger a { color: #fff; }
  .desk__owed { padding-top: 16px; border-top: 1px solid rgba(255,255,255,.36); }
  .desk__owed-line { margin: 0 0 12px; font-size: 15px; }
  .desk__owed-line b { font-size: 22px; }
  .desk__label { display: block; margin: 0 0 8px; font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.82); }
  .desk__send-row { display: flex; gap: 8px; }
