<section class="wpm" id="wpm-root" aria-label="Wing pulse module">
  <a class="wpm__pill" href="/drum">
    <span class="wpm__brass">●</span>
    <span class="wpm__label">WING</span>
    <span class="wpm__sep">·</span>
    <span class="wpm__total">open lobby</span>
    <span class="wpm__cta">enter →</span>
  </a>
  <div class="wpm__lights" aria-hidden="true">
    <span class="wpm__light"></span>
    <span class="wpm__light"></span>
    <span class="wpm__light"></span>
    <span class="wpm__light"></span>
    <span class="wpm__light"></span>
  </div>
</section>

<style>
  .wpm {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    margin: 6px 0;
    flex-wrap: wrap;
    --wpm-velvet: #1a0820;
    --wpm-brass: #d4a437;
    --wpm-brass-deep: #6b4d12;
    --wpm-flame: #f6c15e;
    --wpm-cream: #f4e7c8;
  }
  .wpm__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border: 1.5px solid var(--wpm-brass-deep);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, Menlo, monospace);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wpm-cream);
    background: linear-gradient(180deg, rgba(26, 8, 32, 0.95) 0%, rgba(12, 4, 16, 0.95) 100%);
    box-shadow: 0 4px 16px rgba(212, 164, 55, 0.16);
  }
  .wpm__brass { color: var(--wpm-flame); font-size: 9px; }
  .wpm__label { color: var(--wpm-brass); font-weight: 800; letter-spacing: 0.30em; }
  .wpm__sep { color: var(--wpm-brass-deep); }
  .wpm__total { color: var(--wpm-cream); font-weight: 600; opacity: 0.85; }
  .wpm__cta { color: var(--wpm-flame); font-weight: 700; margin-left: 4px; }
  .wpm__lights { display: inline-flex; gap: 5px; }
  .wpm__light {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(246, 193, 94, 0.22);
    box-shadow: 0 0 6px rgba(246, 193, 94, 0.22);
  }
  @media (max-width: 720px) {
    .wpm__pill { font-size: 11px; padding: 7px 14px; gap: 8px; }
  }
</style>
