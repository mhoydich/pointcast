    will-change: transform, top, opacity;
  }
  @keyframes spell-confetti-fall {
    0%   { top: -12px; opacity: 1; transform: translateX(0) rotate(0deg); }
    80%  { opacity: 1; }
    100% {
      top: 105vh;
      opacity: 0;
      transform: translateX(var(--spell-drift-x, 0)) rotate(var(--spell-rotate-end, 360deg));
    }
  }

  /* ── cat (companion) ─────────────────────────────────────── */
  .spell-cat {
    position: fixed;
