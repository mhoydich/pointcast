---
/**
 * SpellLayer — the page-wide overlay where spells render.
 *
 * Mike 2026-05-01: Peach-inspired magic words. Type `+confetti` in the
 * omnibox or click a chip in slot 06 CAST → a `pc:spell:cast` event
 * fires with the spell id → this layer paints accordingly.
 *
 * Why a single layer (not per-spell components):
 *   - bursts/companions/ambient are all DOM-light effects
 *   - one fixed overlay = predictable z-stacking, single pointer-events
 *     boundary, easy global "clear all"
 *   - new spells = new case in the dispatch switch + a row in spells.ts
 *
 * Pointer-events:
 *   layer = none (clicks pass through to the page)
 *   ambient surfaces (breath/candle) re-enable pointer-events: auto
 *     on themselves so they can be clicked to dismiss
 *
 * A11y:
 *   layer is aria-hidden (decorative)
 *   bursts/companions are role=presentation
 *   reduced-motion suppresses animations — bursts skip, companions
 *     teleport-walk, ambient becomes static
 *
 * Mount: BlockLayout.astro renders the one site-wide <SpellLayer />.
 * once near the closing </body>, alongside the FooterBar.
 */
---

<div class="spell-layer" data-pc-ref="pc-spell-layer" aria-hidden="true"></div>


<style is:global>
  .spell-layer {
    position: fixed;
    inset: 0;
    z-index: 30; /* under footer (40) + trays (49) but above page content */
    pointer-events: none;
    overflow: hidden;
  }

  .spell-burst-pulse {
    position: fixed;
    left: 50%;
    bottom: 20px;
    width: 22px;
    height: 22px;
    border: 3px solid var(--spell-burst-color, #185fa5);
    border-radius: 50%;
    opacity: .9;
    transform: translateX(-50%) scale(.25);
    box-shadow: 0 0 18px color-mix(in srgb, var(--spell-burst-color, #185fa5), transparent 30%);
    animation: spell-burst-pulse 900ms cubic-bezier(.16,.72,.28,1) forwards;
  }
  @keyframes spell-burst-pulse {
    to { opacity: 0; transform: translateX(-50%) scale(34); }
  }

  /* ── confetti ────────────────────────────────────────────── */
  .spell-confetti {
    position: absolute;
    border-radius: 1px;
    pointer-events: none;
    will-change: transform, top, opacity;
  }
  @keyframes spell-confetti-fall {
    0%   { top: -12px; opacity: 1; transform: translateX(0) rotate(0deg); }
    80%  { opacity: 1; }
    100% {
      top: 105vh;
      opacity: 0;
      transform: translateX(var(--spell-drift-x, 0)) rotate(var(--spell-rotate-end, 360deg));
    }
  }

  /* ── cat (companion) ─────────────────────────────────────── */
  .spell-cat {
    position: fixed;
    bottom: 56px;     /* sit above the dock */
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 32px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    image-rendering: pixelated;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
  }
  .spell-cat[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-cat-walk-ltr {
    0%   { left: -40px; }
    48%  { left: calc(50vw - 18px); }
    52%  { left: calc(50vw - 18px); } /* tiny pause mid-screen */
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-cat-walk-rtl {
    0%   { left: calc(100vw + 40px); }
    48%  { left: calc(50vw - 18px); }
    52%  { left: calc(50vw - 18px); }
    100% { left: -40px; }
  }

  /* ── breath (ambient) ────────────────────────────────────── */
  .spell-breath {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 240px;
    height: 240px;
    border: 0;
    background: none;
    pointer-events: auto;
    cursor: pointer;
    z-index: 31;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .spell-breath__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(74, 158, 255, 0.4);
    background: radial-gradient(circle at center, rgba(74, 158, 255, 0.18) 0%, rgba(74, 158, 255, 0) 70%);
    animation: spell-breath-cycle 19s ease-in-out infinite;
  }
  .spell-breath__inner {
    position: absolute;
    inset: 24px;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(253, 242, 214, 0.6) 0%, rgba(253, 242, 214, 0) 70%);
    animation: spell-breath-cycle-inner 19s ease-in-out infinite;
  }
  .spell-breath__cue {
    position: relative;
    z-index: 1;
    color: #fdf2d6;
    background: rgba(26, 18, 8, 0.7);
    padding: 6px 10px;
    border-radius: 2px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  /* Inhale 4s → expand. Hold 7s → stay. Exhale 8s → contract. */
  @keyframes spell-breath-cycle {
    0%               { transform: scale(0.7); }   /* start small */
    21%  /* +4s */   { transform: scale(1); }     /* inhale done */
    57%  /* +7s */   { transform: scale(1); }     /* hold */
    100% /* +8s */   { transform: scale(0.7); }   /* exhale done */
  }
  @keyframes spell-breath-cycle-inner {
    0%               { transform: scale(0.55); opacity: 0.7; }
    21%              { transform: scale(0.95); opacity: 1; }
    57%              { transform: scale(0.95); opacity: 1; }
    100%             { transform: scale(0.55); opacity: 0.7; }
  }

  /* ── candle (ambient) ────────────────────────────────────── */
  .spell-candle {
    position: fixed;
    right: 24px;
    bottom: 60px;
    width: 44px;
    height: 64px;
    background: none;
    border: 0;
    padding: 0;
    pointer-events: auto;
    cursor: pointer;
    z-index: 31;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-shadow: 0 0 12px rgba(255, 180, 80, 0.7);
  }
  .spell-candle__flame {
    font-size: 18px;
    line-height: 18px;
    animation: spell-candle-flicker 1.6s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .spell-candle__body {
    font-size: 32px;
    line-height: 32px;
    margin-top: -4px;
  }
  @keyframes spell-candle-flicker {
    0%, 100% { transform: translateY(0) scale(1) rotate(-1deg); opacity: 1; }
    25%      { transform: translateY(-1px) scale(1.05) rotate(2deg); opacity: 0.95; }
    50%      { transform: translateY(0) scale(0.97) rotate(-2deg); opacity: 1; }
    75%      { transform: translateY(-1px) scale(1.03) rotate(1deg); opacity: 0.92; }
  }

  /* ── pup (companion) ─────────────────────────────────────── */
  .spell-pup {
    position: fixed;
    bottom: 56px;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 30px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
  }
  .spell-pup[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-pup-walk-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-pup-walk-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  @keyframes spell-pup-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
  .spell-pup[data-dir='rtl'] { /* Compose flip with the bounce. */
    animation-name: spell-pup-walk-rtl, spell-pup-bounce-rtl !important;
  }
  @keyframes spell-pup-bounce-rtl {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    50%      { transform: scaleX(-1) translateY(-6px); }
  }

  /* ── penguin (companion) ─────────────────────────────────── */
  .spell-penguin {
    position: fixed;
    bottom: 56px;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 30px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
  }
  .spell-penguin[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-penguin-walk-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-penguin-walk-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  /* Wobble — small left/right tilt, applied as the second animation. */
  @keyframes spell-penguin-wobble {
    0%, 100% { transform: rotate(-4deg); }
    50%      { transform: rotate(4deg); }
  }
  .spell-penguin[data-dir='rtl'] {
    animation-name: spell-penguin-walk-rtl, spell-penguin-wobble-rtl !important;
  }
  @keyframes spell-penguin-wobble-rtl {
    0%, 100% { transform: scaleX(-1) rotate(-4deg); }
    50%      { transform: scaleX(-1) rotate(4deg); }
  }

  /* ── rain (ambient) ──────────────────────────────────────── */
  .spell-rain {
    position: fixed;
    inset: 0;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-rain__drop {
    position: absolute;
    top: -20px;
    width: 1.5px;
    background: linear-gradient(180deg, rgba(74, 158, 255, 0.05) 0%, rgba(74, 158, 255, 0.55) 70%, rgba(74, 158, 255, 0.85) 100%);
    border-radius: 1px;
    animation: spell-rain-fall linear infinite;
  }
  @keyframes spell-rain-fall {
    0%   { top: -20px; }
    100% { top: 105vh; }
  }

  /* ── starfield (ambient) ─────────────────────────────────── */
  .spell-starfield {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(167, 139, 250, 0.08) 0%, rgba(167, 139, 250, 0) 60%);
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-starfield__star {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.7), 0 0 8px rgba(167, 139, 250, 0.4);
    animation: spell-star-twinkle ease-in-out infinite;
  }
  @keyframes spell-star-twinkle {
    0%, 100% { opacity: 0.3; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1.2); }
  }

  /* ── firework (burst) ───────────────────────────────────── */
  .spell-firework-spark {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
  }
  @keyframes spell-firework-spark-fly {
    0% {
      transform: translate(-50%, -50%);
      opacity: 1;
    }
    75% { opacity: 0.75; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      );
      opacity: 0;
    }
  }

  /* ── fish (companion) ────────────────────────────────────── */
  .spell-fish {
    position: fixed;
    bottom: 72px;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 28px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 1px 3px rgba(74, 158, 255, 0.3));
  }
  .spell-fish[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-fish-swim-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-fish-swim-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  @keyframes spell-fish-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
  }
  .spell-fish[data-dir='rtl'] {
    animation-name: spell-fish-swim-rtl, spell-fish-bob-rtl !important;
  }
  @keyframes spell-fish-bob-rtl {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    50%      { transform: scaleX(-1) translateY(-4px); }
  }

  /* ── moth (companion) ────────────────────────────────────── */
  /* Hovers at 35vh — mid-screen, not bottom — and flutters erratically
     as if drawn toward a light source just out of frame. */
  .spell-moth {
    position: fixed;
    bottom: 35vh;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 26px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 0 4px rgba(255, 210, 120, 0.4));
  }
  .spell-moth[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-moth-fly-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-moth-fly-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  /* Erratic vertical flutter — asymmetric timing evokes moth-like energy. */
  @keyframes spell-moth-flutter {
    0%   { transform: translateY(0) scale(1); }
    18%  { transform: translateY(-18px) scale(0.94); }
    33%  { transform: translateY(6px) scale(1.03); }
    55%  { transform: translateY(-24px) scale(0.92); }
    72%  { transform: translateY(10px) scale(1.02); }
    88%  { transform: translateY(-12px) scale(0.96); }
    100% { transform: translateY(0) scale(1); }
  }
  .spell-moth[data-dir='rtl'] {
    animation-name: spell-moth-fly-rtl, spell-moth-flutter-rtl !important;
  }
  @keyframes spell-moth-flutter-rtl {
    0%   { transform: scaleX(-1) translateY(0); }
    18%  { transform: scaleX(-1) translateY(-18px); }
    33%  { transform: scaleX(-1) translateY(6px); }
    55%  { transform: scaleX(-1) translateY(-24px); }
    72%  { transform: scaleX(-1) translateY(10px); }
    88%  { transform: scaleX(-1) translateY(-12px); }
    100% { transform: scaleX(-1) translateY(0); }
  }

  /* ── snow (ambient) ──────────────────────────────────────── */
  .spell-snow {
    position: fixed;
    inset: 0;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-snow__flake {
    position: absolute;
    top: -10px;
    background: rgba(220, 235, 255, 0.88);
    border-radius: 50%;
    box-shadow: 0 0 5px rgba(200, 220, 255, 0.5);
    animation: spell-snow-fall linear infinite;
  }
  @keyframes spell-snow-fall {
    0%   { top: -10px; transform: translateX(0); }
    100% { top: 105vh;  transform: translateX(var(--spell-snow-drift, 0px)); }
  }

  /* ── shout (burst) ───────────────────────────────────────── */
  .spell-shout-char {
    position: absolute;
    font-family: monospace;
    font-weight: 700;
    color: #fdf2d6;
    text-shadow: 0 0 8px rgba(212, 164, 55, 0.9);
    pointer-events: none;
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }
  @keyframes spell-shout-fly {
    0% {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 1;
    }
    60% { opacity: 1; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      ) scale(1.3);
      opacity: 0;
    }
  }

  /* ── wave (burst) ─────────────────────────────────────────── */
  .spell-wave-hand {
    position: absolute;
    font-size: 28px;
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }
  @keyframes spell-wave-appear {
    0%   { opacity: 0; transform: translateY(12px) rotate(-25deg); }
    20%  { opacity: 1; transform: translateY(-14px) rotate(18deg); }
    45%  { opacity: 1; transform: translateY(-6px) rotate(-12deg); }
    70%  { opacity: 1; transform: translateY(-10px) rotate(14deg); }
    100% { opacity: 0; transform: translateY(-22px) rotate(0deg); }
  }

  /* ── firefly (companion) ─────────────────────────────────── */
  .spell-firefly {
    position: fixed;
    left: -20px;
    width: 20px;
    height: 20px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 31;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spell-firefly__glow {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d4ff80;
    box-shadow: 0 0 8px 4px rgba(180, 240, 60, 0.8), 0 0 20px 8px rgba(180, 240, 60, 0.35);
    animation: spell-firefly-pulse 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes spell-firefly-pulse {
    0%, 100% { opacity: 0.15; box-shadow: 0 0 4px 2px rgba(180, 240, 60, 0.2); }
    50%      { opacity: 1; box-shadow: 0 0 14px 7px rgba(180, 240, 60, 0.9), 0 0 28px 12px rgba(180, 240, 60, 0.4); }
  }
  @keyframes spell-firefly-drift-ltr {
    0%   { left: -20px; }
    100% { left: calc(100vw + 20px); }
  }
  @keyframes spell-firefly-drift-rtl {
    0%   { left: calc(100vw + 20px); }
    100% { left: -20px; }
  }

  /* ── chimes (ambient) ────────────────────────────────────── */
  .spell-chimes {
    position: fixed;
    top: 0;
    right: 48px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 7px;
    padding: 0 8px;
    background: none;
    border: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 31;
  }
  .spell-chimes__pipe {
    display: block;
    width: 4px;
    background: linear-gradient(180deg, #b8d4f0 0%, #6aacdf 55%, #2f6faf 100%);
    border-radius: 0 0 2px 2px;
    transform-origin: 50% 0;
    animation: spell-chimes-sway ease-in-out infinite alternate;
  }
  @keyframes spell-chimes-sway {
    0%   { transform: rotate(-9deg); }
    100% { transform: rotate(9deg); }
  }

  /* ── bloom (burst) ───────────────────────────────────────── */
  .spell-bloom-petal {
    position: absolute;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
    line-height: 1;
  }
  @keyframes spell-bloom-fly {
    0% {
      transform: translate(-50%, -50%) scale(0.2) rotate(0deg);
      opacity: 1;
    }
    55% { opacity: 1; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      ) scale(1.1) rotate(var(--spell-bloom-rot, 180deg));
      opacity: 0;
    }
  }

  /* ── aurora (ambient) ────────────────────────────────────── */
  /* Two pseudo-element gradient bands shift at different speeds —
     no canvas, no SVG. Top-viewport height (45vh) keeps it subtle. */
  .spell-aurora {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 45vh;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-aurora::before,
  .spell-aurora::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .spell-aurora::before {
    background: linear-gradient(
      180deg,
      rgba(47, 143, 95, 0.0) 0%,
      rgba(47, 143, 95, 0.20) 28%,
      rgba(74, 158, 255, 0.16) 55%,
      rgba(167, 139, 250, 0.10) 75%,
      rgba(0, 0, 0, 0) 100%
    );
    animation: spell-aurora-wave 10s ease-in-out infinite alternate;
  }
  .spell-aurora::after {
    background: linear-gradient(
      180deg,
      rgba(167, 139, 250, 0.0) 0%,
      rgba(167, 139, 250, 0.14) 22%,
      rgba(47, 143, 95, 0.18) 50%,
      rgba(74, 158, 255, 0.09) 72%,
      rgba(0, 0, 0, 0) 100%
    );
    animation: spell-aurora-wave 14s ease-in-out infinite alternate-reverse;
  }
  @keyframes spell-aurora-wave {
    0%   { transform: translateX(-8%) scaleY(0.82); opacity: 0.65; }
    50%  { transform: translateX(5%) scaleY(1.12); opacity: 1; }
    100% { transform: translateX(-3%) scaleY(0.90); opacity: 0.75; }
  }

  /* ── here (ambient) ──────────────────────────────────────── */
  .spell-here {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    background: none;
    border: 0;
    padding: 0;
    pointer-events: auto;
    cursor: pointer;
    z-index: 31;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spell-here__pin {
    position: relative;
    z-index: 1;
    font-size: 40px;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgba(138, 36, 50, 0.65));
  }
  .spell-here__ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgba(138, 36, 50, 0.55);
    top: 50%;
    left: 50%;
    width: 80px;
    height: 80px;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
