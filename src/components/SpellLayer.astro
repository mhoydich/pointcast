    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(167, 139, 250, 0.08) 0%, rgba(167, 139, 250, 0) 60%);
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-starfield__star {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.7), 0 0 8px rgba(167, 139, 250, 0.4);
    animation: spell-star-twinkle ease-in-out infinite;
  }
  @keyframes spell-star-twinkle {
    0%, 100% { opacity: 0.3; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1.2); }
  }

  /* ── firework (burst) ───────────────────────────────────── */
  .spell-firework-spark {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
  }
  @keyframes spell-firework-spark-fly {
    0% {
      transform: translate(-50%, -50%);
      opacity: 1;
    }
    75% { opacity: 0.75; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      );
      opacity: 0;
    }
  }

  /* ── fish (companion) ────────────────────────────────────── */
  .spell-fish {
    position: fixed;
    bottom: 72px;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 28px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 1px 3px rgba(74, 158, 255, 0.3));
  }
  .spell-fish[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-fish-swim-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-fish-swim-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  @keyframes spell-fish-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
  }
  .spell-fish[data-dir='rtl'] {
    animation-name: spell-fish-swim-rtl, spell-fish-bob-rtl !important;
  }
  @keyframes spell-fish-bob-rtl {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    50%      { transform: scaleX(-1) translateY(-4px); }
  }

  /* ── moth (companion) ────────────────────────────────────── */
  /* Hovers at 35vh — mid-screen, not bottom — and flutters erratically
     as if drawn toward a light source just out of frame. */
  .spell-moth {
    position: fixed;
    bottom: 35vh;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 26px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 0 4px rgba(255, 210, 120, 0.4));
  }
  .spell-moth[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-moth-fly-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-moth-fly-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  /* Erratic vertical flutter — asymmetric timing evokes moth-like energy. */
  @keyframes spell-moth-flutter {
    0%   { transform: translateY(0) scale(1); }
    18%  { transform: translateY(-18px) scale(0.94); }
    33%  { transform: translateY(6px) scale(1.03); }
    55%  { transform: translateY(-24px) scale(0.92); }
    72%  { transform: translateY(10px) scale(1.02); }
    88%  { transform: translateY(-12px) scale(0.96); }
    100% { transform: translateY(0) scale(1); }
  }
  .spell-moth[data-dir='rtl'] {
    animation-name: spell-moth-fly-rtl, spell-moth-flutter-rtl !important;
  }
  @keyframes spell-moth-flutter-rtl {
    0%   { transform: scaleX(-1) translateY(0); }
    18%  { transform: scaleX(-1) translateY(-18px); }
    33%  { transform: scaleX(-1) translateY(6px); }
    55%  { transform: scaleX(-1) translateY(-24px); }
    72%  { transform: scaleX(-1) translateY(10px); }
    88%  { transform: scaleX(-1) translateY(-12px); }
    100% { transform: scaleX(-1) translateY(0); }
  }

  /* ── snow (ambient) ──────────────────────────────────────── */
  .spell-snow {
    position: fixed;
    inset: 0;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-snow__flake {
    position: absolute;
    top: -10px;
    background: rgba(220, 235, 255, 0.88);
    border-radius: 50%;
    box-shadow: 0 0 5px rgba(200, 220, 255, 0.5);
    animation: spell-snow-fall linear infinite;
  }
  @keyframes spell-snow-fall {
    0%   { top: -10px; transform: translateX(0); }
    100% { top: 105vh;  transform: translateX(var(--spell-snow-drift, 0px)); }
  }

  /* ── shout (burst) ───────────────────────────────────────── */
  .spell-shout-char {
    position: absolute;
    font-family: monospace;
    font-weight: 700;
    color: #fdf2d6;
    text-shadow: 0 0 8px rgba(212, 164, 55, 0.9);
    pointer-events: none;
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }
  @keyframes spell-shout-fly {
    0% {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 1;
    }
    60% { opacity: 1; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      ) scale(1.3);
      opacity: 0;
    }
  }

  /* ── wave (burst) ─────────────────────────────────────────── */
  .spell-wave-hand {
    position: absolute;
    font-size: 28px;
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }
  @keyframes spell-wave-appear {
    0%   { opacity: 0; transform: translateY(12px) rotate(-25deg); }
    20%  { opacity: 1; transform: translateY(-14px) rotate(18deg); }
    45%  { opacity: 1; transform: translateY(-6px) rotate(-12deg); }
    70%  { opacity: 1; transform: translateY(-10px) rotate(14deg); }
    100% { opacity: 0; transform: translateY(-22px) rotate(0deg); }
  }

  /* ── firefly (companion) ─────────────────────────────────── */
  .spell-firefly {
    position: fixed;
    left: -20px;
    width: 20px;
    height: 20px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 31;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spell-firefly__glow {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d4ff80;
    box-shadow: 0 0 8px 4px rgba(180, 240, 60, 0.8), 0 0 20px 8px rgba(180, 240, 60, 0.35);
    animation: spell-firefly-pulse 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes spell-firefly-pulse {
    0%, 100% { opacity: 0.15; box-shadow: 0 0 4px 2px rgba(180, 240, 60, 0.2); }
    50%      { opacity: 1; box-shadow: 0 0 14px 7px rgba(180, 240, 60, 0.9), 0 0 28px 12px rgba(180, 240, 60, 0.4); }
  }
  @keyframes spell-firefly-drift-ltr {
    0%   { left: -20px; }
    100% { left: calc(100vw + 20px); }
  }
  @keyframes spell-firefly-drift-rtl {
    0%   { left: calc(100vw + 20px); }
    100% { left: -20px; }
  }

  /* ── chimes (ambient) ────────────────────────────────────── */
  .spell-chimes {
    position: fixed;
    top: 0;
    right: 48px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 7px;
    padding: 0 8px;
    background: none;
    border: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 31;
  }
  .spell-chimes__pipe {
    display: block;
    width: 4px;
    background: linear-gradient(180deg, #b8d4f0 0%, #6aacdf 55%, #2f6faf 100%);
    border-radius: 0 0 2px 2px;
    transform-origin: 50% 0;
    animation: spell-chimes-sway ease-in-out infinite alternate;
  }
  @keyframes spell-chimes-sway {
    0%   { transform: rotate(-9deg); }
    100% { transform: rotate(9deg); }
  }

  /* ── bloom (burst) ───────────────────────────────────────── */
  .spell-bloom-petal {
    position: absolute;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
    line-height: 1;
  }
  @keyframes spell-bloom-fly {
    0% {
      transform: translate(-50%, -50%) scale(0.2) rotate(0deg);
      opacity: 1;
    }
    55% { opacity: 1; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      ) scale(1.1) rotate(var(--spell-bloom-rot, 180deg));
      opacity: 0;
    }
  }

  /* ── aurora (ambient) ────────────────────────────────────── */
  /* Two pseudo-element gradient bands shift at different speeds —
     no canvas, no SVG. Top-viewport height (45vh) keeps it subtle. */
  .spell-aurora {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 45vh;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
  }
  .spell-aurora::before,
  .spell-aurora::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .spell-aurora::before {
    background: linear-gradient(
      180deg,
      rgba(47, 143, 95, 0.0) 0%,
      rgba(47, 143, 95, 0.20) 28%,
      rgba(74, 158, 255, 0.16) 55%,
      rgba(167, 139, 250, 0.10) 75%,
      rgba(0, 0, 0, 0) 100%
    );
    animation: spell-aurora-wave 10s ease-in-out infinite alternate;
  }
  .spell-aurora::after {
    background: linear-gradient(
      180deg,
      rgba(167, 139, 250, 0.0) 0%,
      rgba(167, 139, 250, 0.14) 22%,
      rgba(47, 143, 95, 0.18) 50%,
      rgba(74, 158, 255, 0.09) 72%,
      rgba(0, 0, 0, 0) 100%
    );
    animation: spell-aurora-wave 14s ease-in-out infinite alternate-reverse;
  }
  @keyframes spell-aurora-wave {
    0%   { transform: translateX(-8%) scaleY(0.82); opacity: 0.65; }
    50%  { transform: translateX(5%) scaleY(1.12); opacity: 1; }
    100% { transform: translateX(-3%) scaleY(0.90); opacity: 0.75; }
  }

  /* ── here (ambient) ──────────────────────────────────────── */
  .spell-here {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    background: none;
    border: 0;
    padding: 0;
    pointer-events: auto;
    cursor: pointer;
    z-index: 31;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spell-here__pin {
    position: relative;
    z-index: 1;
    font-size: 40px;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgba(138, 36, 50, 0.65));
  }
  .spell-here__ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgba(138, 36, 50, 0.55);
    top: 50%;
    left: 50%;
    width: 80px;
    height: 80px;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
  .spell-here__ring--1 { animation: spell-here-ripple 2.4s ease-out infinite; }
  .spell-here__ring--2 { animation: spell-here-ripple 2.4s ease-out 1.2s infinite; }
  @keyframes spell-here-ripple {
    0%   { transform: translate(-50%, -50%) scale(0.35); opacity: 0.9; }
    100% { transform: translate(-50%, -50%) scale(2.4); opacity: 0; }
  }

  /* ── mood (ambient) ──────────────────────────────────────── */
  .spell-mood {
    position: fixed;
    bottom: 72px;
    left: 24px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.5) 0%, rgba(212, 164, 55, 0.9) 100%);
    border: 0;
    padding: 0;
    pointer-events: auto;
    cursor: pointer;
    z-index: 31;
    box-shadow: 0 0 20px 6px rgba(212, 164, 55, 0.4);
    animation: spell-mood-hue 20s linear infinite;
  }
  @keyframes spell-mood-hue {
    0%   { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }

  /* ── bubble (burst) ─────────────────────────────────────── */
  .spell-bubble {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(
      circle at 35% 30%,
      rgba(255, 255, 255, 0.75) 0%,
      rgba(74, 158, 255, 0.22) 45%,
      rgba(167, 139, 250, 0.18) 70%,
      rgba(74, 158, 255, 0.08) 100%
    );
    border: 1px solid rgba(74, 158, 255, 0.35);
    box-shadow: inset 0 -2px 4px rgba(74, 158, 255, 0.15);
    will-change: transform, opacity, bottom;
  }
  @keyframes spell-bubble-rise {
    0%   { transform: translateX(0) scale(1); opacity: 0.9; }
    70%  { opacity: 0.85; }
    88%  { transform: translateX(var(--spell-bubble-drift, 0px)) scale(1.12); opacity: 0.6; }
    100% { transform: translateX(var(--spell-bubble-drift, 0px)) scale(1.4) translateY(-55vh); opacity: 0; }
  }

  /* ── dice (burst) ────────────────────────────────────────── */
  .spell-dice-face {
    position: absolute;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }
  @keyframes spell-dice-tumble {
    0% {
      transform: translate(-50%, -50%) scale(0.3) rotate(0deg);
      opacity: 1;
    }
    60% { opacity: 0.9; }
    100% {
      transform: translate(
        calc(-50% + var(--spell-fw-dx, 0px)),
        calc(-50% + var(--spell-fw-dy, 0px))
      ) scale(1.05) rotate(var(--spell-dice-rot, 270deg));
      opacity: 0;
    }
  }

  /* ── bee (companion) ─────────────────────────────────────── */
  .spell-bee {
    position: fixed;
    bottom: 45vh;
    left: -40px;
    width: 36px;
    height: 36px;
    line-height: 36px;
    font-size: 26px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 0 3px rgba(212, 164, 55, 0.5));
  }
  .spell-bee[data-dir='rtl'] { transform: scaleX(-1); }
  @keyframes spell-bee-fly-ltr {
    0%   { left: -40px; }
    100% { left: calc(100vw + 40px); }
  }
  @keyframes spell-bee-fly-rtl {
    0%   { left: calc(100vw + 40px); }
    100% { left: -40px; }
  }
  /* Rapid zigzag — asymmetric heights mimic the real thing. */
  @keyframes spell-bee-zigzag {
    0%   { transform: translateY(0); }
    25%  { transform: translateY(-14px); }
    75%  { transform: translateY(10px); }
    100% { transform: translateY(0); }
  }
  .spell-bee[data-dir='rtl'] {
    animation-name: spell-bee-fly-rtl, spell-bee-zigzag-rtl !important;
  }
  @keyframes spell-bee-zigzag-rtl {
    0%   { transform: scaleX(-1) translateY(0); }
    25%  { transform: scaleX(-1) translateY(-14px); }
    75%  { transform: scaleX(-1) translateY(10px); }
    100% { transform: scaleX(-1) translateY(0); }
  }

  /* ── fog (ambient) ───────────────────────────────────────── */
  .spell-fog {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40vh;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    z-index: 30;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .spell-fog__wisp {
    position: absolute;
    bottom: 0;
    left: -20%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 80%,
      rgba(220, 232, 248, 0.9) 0%,
      rgba(200, 218, 240, 0.5) 40%,
      rgba(180, 200, 230, 0) 100%
    );
    filter: blur(18px);
    pointer-events: none;
  }
  @keyframes spell-fog-drift-ltr {
    0%   { transform: translateX(-8%); }
    100% { transform: translateX(12%); }
  }
  @keyframes spell-fog-drift-rtl {
    0%   { transform: translateX(8%); }
    100% { transform: translateX(-12%); }
  }

  /* ── balloon (burst) ─────────────────────────────────────── */
  .spell-balloon {
    position: fixed;
    bottom: -60px;
    pointer-events: none;
    will-change: transform, opacity;
    animation: spell-balloon-rise ease-out forwards;
    line-height: 1;
  }
  @keyframes spell-balloon-rise {
    0%   { transform: translateY(0) translateX(0); opacity: 1; }
    70%  { opacity: 1; }
    100% {
      transform: translateY(-120vh) translateX(var(--spell-balloon-drift, 0px));
      opacity: 0;
    }
  }

  /* ── turtle (companion) ──────────────────────────────────── */
  .spell-turtle {
    position: fixed;
    bottom: 56px;
    left: -44px;
    width: 40px;
    height: 40px;
    line-height: 40px;
    font-size: 28px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }
  @keyframes spell-turtle-walk-ltr {
    0%   { left: -44px; }
    100% { left: calc(100vw + 44px); }
  }
  @keyframes spell-turtle-walk-rtl {
    0%   { left: calc(100vw + 44px); }
    100% { left: -44px; }
  }
  @keyframes spell-turtle-nod {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }
  @keyframes spell-turtle-nod-rtl {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    50%      { transform: scaleX(-1) translateY(-3px); }
  }

  /* ── ghost (companion) ───────────────────────────────────── */
  /* Floats mid-screen (35–65vh) at ~58px/s. Translucent, soft. */
  .spell-ghost {
    position: fixed;
    left: -44px;
    width: 40px;
    height: 40px;
    line-height: 40px;
    font-size: 32px;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    z-index: 31;
    opacity: 0.85;
    filter: drop-shadow(0 0 10px rgba(167, 139, 250, 0.55));
  }
  @keyframes spell-ghost-fly-ltr {
    0%   { left: -44px; }
    100% { left: calc(100vw + 44px); }
  }
  @keyframes spell-ghost-fly-rtl {
    0%   { left: calc(100vw + 44px); }
    100% { left: -44px; }
  }
  @keyframes spell-ghost-float {
    0%, 100% { transform: translateY(0); }
    28%      { transform: translateY(-16px); }
    72%      { transform: translateY(12px); }
  }
  @keyframes spell-ghost-float-rtl {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    28%      { transform: scaleX(-1) translateY(-16px); }
    72%      { transform: scaleX(-1) translateY(12px); }
  }

  /* ── campfire (ambient) ──────────────────────────────────── */
  /* Bottom-left corner — distinct from candle (bottom-right). */
  .spell-campfire {
    position: fixed;
    left: 24px;
    bottom: 60px;
    width: 56px;
    height: 68px;
    background: none;
    border: 0;
    padding: 0;
    pointer-events: auto;
    cursor: pointer;
    z-index: 31;
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
  }
  .spell-campfire__glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 72px;
    height: 36px;
    background: radial-gradient(ellipse at 50% 100%, rgba(255, 130, 20, 0.45) 0%, rgba(255, 80, 10, 0) 70%);
    border-radius: 50%;
    transform: translateX(-50%);
    animation: spell-campfire-glow 2.4s ease-in-out infinite;
    pointer-events: none;
  }
  .spell-campfire__log {
    font-size: 22px;
    line-height: 1;
    z-index: 1;
  }
  .spell-campfire__flame--main {
    font-size: 28px;
    line-height: 1;
    animation: spell-campfire-flicker 0.85s ease-in-out infinite;
    transform-origin: 50% 100%;
    z-index: 2;
  }
  .spell-campfire__flame--side {
    font-size: 18px;
    line-height: 1;
    position: absolute;
    bottom: 22px;
    left: 4px;
    opacity: 0.72;
    animation: spell-campfire-flicker 1.25s ease-in-out infinite;
    transform-origin: 50% 100%;
    z-index: 1;
  }
  @keyframes spell-campfire-flicker {
    0%, 100% { transform: scale(1) rotate(-4deg); }
    22%      { transform: scale(1.07) rotate(5deg); }
    50%      { transform: scale(0.93) rotate(-6deg); }
    76%      { transform: scale(1.05) rotate(3deg); }
  }
  @keyframes spell-campfire-glow {
    0%, 100% { opacity: 0.6; transform: translateX(-50%) scaleX(1); }
