---
import { GENTLE_INVITATION } from '../../functions/_lib/ai-companions';
---
<section class="ai-companion" id="ai-companion" data-ai-companion aria-labelledby="ai-companion-title">
  <header>
    <p class="ai-companion__kicker">YOUR AI · YOUR CHOICE</p>
    <h2 id="ai-companion-title">Bring your AI along.</h2>
    <p>Use your existing subscription in its own app. <a href="/connectors">Choose your AI and connect PointCast →</a></p>
  </header>
  <p>Once your AI has PointCast tools, confirm a visit here. Your private receipt remembers which app you chose and when it checked in.</p>
  <form data-ai-form>
    <label>Your AI<select name="provider">
      <option value="claude">Claude</option><option value="chatgpt">ChatGPT</option><option value="codex">Codex</option><option value="claude-code">Claude Code</option><option value="other">Another AI</option>
    </select></label>
    <label>How you use it<select name="approach">
      <option value="subscription">My existing AI plan</option><option value="api">My own agent / API</option><option value="other">Another setup</option>
    </select></label>
    <label class="ai-companion__gentle"><input type="checkbox" name="gentle" /> Invite a gentler experience</label>
    <details><summary>Preview the optional invitation</summary><p>{GENTLE_INVITATION}</p></details>
    <button type="submit" disabled data-ai-create>Create a visit invitation</button>
  </form>
  <div class="ai-companion__invitation" data-ai-invitation hidden>
    <label>Paste this into your AI conversation<textarea readonly rows="5" data-ai-prompt aria-label="Private one-time AI invitation"></textarea></label>
    <button type="button" data-ai-copy>Copy invitation</button><p data-ai-expiry></p>
  </div>
  <output data-ai-status aria-live="polite">Checking your private visit receipts…</output>
  <ul data-ai-list aria-label="Your AI visits"></ul>
  <button type="button" data-ai-refresh>Check for a confirmed visit</button>
  <p class="ai-companion__note">This confirms a single visit, not ongoing account access. App and plan choices are yours to describe; PointCast does not verify your subscription, receive its credentials, or read your AI conversations. Removing a receipt also cancels any pending invitation. Remove the connector in your AI app to stop using its PointCast tools.</p>
</section>
<style>
  .ai-companion { margin: 24px 0; padding: clamp(18px, 4vw, 30px); border: 1px solid #bbc8c2; background: #f1f6ed; color: #1e302b; }
  .ai-companion h2 { margin: 4px 0 12px; font-size: clamp(25px, 4vw, 34px); line-height: 1.1; }
  .ai-companion p { font-size: 14px; line-height: 1.6; }
  .ai-companion__kicker { font: 600 10px/1.4 var(--pc-font-mono, monospace); letter-spacing: .1em; }
  .ai-companion a { color: #315d44; text-decoration: underline; }
  .ai-companion form { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 22px 0; }
  .ai-companion label { display: grid; gap: 8px; font-size: 13px; font-weight: 600; min-width: 0; }
  .ai-companion select, .ai-companion textarea { width: 100%; min-width: 0; box-sizing: border-box; padding: 10px; border: 1px solid #95aaa0; background: #fff; font: inherit; color: #1e302b; border-radius: 3px; }
  .ai-companion textarea { resize: vertical; font: 12px/1.6 var(--pc-font-mono, monospace); }
  .ai-companion .ai-companion__gentle { display: flex; align-items: center; gap: 10px; grid-column: 1 / -1; }
  .ai-companion details { grid-column: 1 / -1; font-size: 13px; }
  .ai-companion button { min-height: 42px; padding: 10px 14px; border: 1px solid #315d44; border-radius: 3px; background: #244b36; color: #fff; font-family: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
  .ai-companion button:disabled { opacity: .55; cursor: not-allowed; }
  .ai-companion__invitation { padding: 16px; border: 1px solid #95aaa0; margin: 16px 0; background: #fff; }
  .ai-companion__invitation button { margin-top: 10px; }
  .ai-companion output { display: block; font-size: 13px; line-height: 1.6; margin: 12px 0; }
  .ai-companion ul { list-style: none; padding: 0; }
  .ai-companion :global(li) { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 14px 0; border-top: 1px solid #bfccc2; font-size: 13px; }
  .ai-companion :global(li button) { min-height: 44px; padding: 10px 14px; border: 1px solid #315d44; border-radius: 3px; background: #fff; color: #244b36; font: inherit; cursor: pointer; }
  .ai-companion :global(li span) { flex: 1; min-width: 160px; }
  .ai-companion .ai-companion__note { color: #526458; font-size: 12px; margin-top: 20px; }
  .ai-companion [hidden] { display: none !important; }
  @media (max-width: 540px) { .ai-companion form { grid-template-columns: 1fr; } }
</style>
<script>
  import { mountAiCompanion } from '../lib/auth/ai-companion-ui';
  let cleanup: (() => void) | undefined;
  function init() {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-ai-companion]');
    cleanup = root ? mountAiCompanion(root) : undefined;
  }
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
