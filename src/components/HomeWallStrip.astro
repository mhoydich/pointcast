---
/**
 * HomeWallStrip — recent addable artifacts inline on the homepage.
 *
 * 2026-05-16 evolution. The /r/wall page surfaces all artifacts;
 * this component pulls the 3 freshest ones into a slim band on /
 * so visitors see the broadcast as INHABITED — actual notes pinned
 * by other people/agents — without leaving the home.
 *
 * Inserted between the Applications Gallery and the editorial LEAD.
 * Mobile collapses to a single-column flow.
 */
import { seedArtifacts, type Artifact } from '../data/artifacts/seed';
import { formatCreator } from '../lib/artifact-contract';

const artifacts: Artifact[] = seedArtifacts()
  .slice()
  .sort((a, b) => +new Date(b.createdAt) - +new Date(a.createdAt))
  .slice(0, 3);

function fmtAt(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleString('en-US', {
    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true,
  });
}
---

{artifacts.length > 0 && (
  <section class="wall-strip" aria-label="Recent on the walls">
    <header class="wall-strip__head">
      <p class="wall-strip__kicker mono">FRESH ON THE WALLS</p>
      <a class="wall-strip__cta mono" href="/r/wall">see the whole wall →</a>
    </header>
    <ul class="wall-strip__cards">
      {artifacts.map((a) => (
        <li class={`wall-strip__card wall-strip__card--${a.kind}`}>
          <a class="wall-strip__link" href={`/r/${a.roomId}`}>
            <header class="wall-strip__card-head">
              <span class={`wall-strip__kind wall-strip__kind--${a.kind}`}>{a.kind}</span>
              <span class="wall-strip__room mono">/r/{a.roomId}</span>
              <span class="wall-strip__when mono">{fmtAt(a.createdAt)}</span>
            </header>
            <h3 class="wall-strip__title">{a.title}</h3>
            <div class="wall-strip__body">
              {a.kind === 'svg' && a.content.kind === 'svg' && (
                <div class="wall-strip__svg" set:html={a.content.svg} />
              )}
              {a.kind === 'one-liner' && a.content.kind === 'one-liner' && (
                <blockquote class="wall-strip__quote">{a.content.text}</blockquote>
              )}
              {a.kind === 'polaroid' && a.content.kind === 'polaroid' && (
                <img class="wall-strip__polaroid" src={a.content.image} alt={a.content.alt} loading="lazy"/>
              )}
              {a.kind === 'link' && a.content.kind === 'link' && (
                <span class="wall-strip__linkout">{a.content.preview ?? a.content.url} ↗</span>
              )}
            </div>
            <p class="wall-strip__by mono">by {formatCreator(a)}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .wall-strip {
    margin: 0 0 36px;
  }
  .wall-strip__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--color-rule, #ddd9cc);
  }
  .wall-strip__kicker {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-warm, #c4952e);
    text-transform: uppercase;
    margin: 0;
  }
  .wall-strip__cta {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft, #6a6154);
    text-decoration: none;
    text-transform: uppercase;
  }
  .wall-strip__cta:hover { color: var(--color-ink, #1f1b15); }

  .wall-strip__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .wall-strip__card {
    background: #fff;
    border: 1px solid var(--color-rule, #ddd9cc);
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .wall-strip__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(31, 27, 21, 0.12);
  }
  .wall-strip__card--svg       { border-top: 3px solid #1b3a5b; }
  .wall-strip__card--one-liner { border-top: 3px solid #c4952e; }
  .wall-strip__card--polaroid  { border-top: 3px solid #874c1d; }
  .wall-strip__card--link      { border-top: 3px solid #1f5b48; }

  .wall-strip__link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px;
    text-decoration: none;
    color: var(--color-ink, #1f1b15);
    height: 100%;
  }
  .wall-strip__card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 10px;
    color: var(--color-ink-soft, #6a6154);
  }
  .wall-strip__kind {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    padding: 2px 6px;
    border-radius: 2px;
    text-transform: uppercase;
  }
  .wall-strip__kind--svg       { background: #e1ebed; color: #1b3a5b; }
  .wall-strip__kind--one-liner { background: #f3eccd; color: #7a5d18; }
  .wall-strip__kind--polaroid  { background: #f5e6d4; color: #874c1d; }
  .wall-strip__kind--link      { background: #d6e6e1; color: #1f5b48; }
  .wall-strip__room {
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft, #6a6154);
  }
  .wall-strip__when {
    margin-left: auto;
    font-size: 10px;
    color: var(--color-ink-soft, #6a6154);
  }
  .wall-strip__title {
    font-family: var(--font-serif, 'Lora', Georgia, serif);
    font-style: italic;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.25;
    margin: 0;
    color: var(--color-ink, #1f1b15);
  }
  .wall-strip__body { margin: 0; min-height: 56px; }
  .wall-strip__svg {
    background: #f7f5ef;
    border-radius: 3px;
    overflow: hidden;
    line-height: 0;
  }
  .wall-strip__svg svg { display: block; width: 100%; height: auto; max-height: 80px; }
  .wall-strip__quote {
    margin: 0;
    padding: 8px 10px;
    background: #fbf7eb;
    border-left: 3px solid var(--color-warm, #c4952e);
    border-radius: 2px;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: #2a2418;
  }
  .wall-strip__polaroid {
    display: block;
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 3px;
    background: #1f1b15;
  }
  .wall-strip__linkout {
    display: inline-block;
    padding: 6px 10px;
    background: #f0f6f3;
    border: 1px solid #c4d8cd;
    border-radius: 3px;
    color: #1f5b48;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
  }
  .wall-strip__by {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft, #6a6154);
  }

  @media (max-width: 720px) {
    .wall-strip__cards { grid-template-columns: 1fr; gap: 10px; }
    .wall-strip__when { display: none; }
  }
</style>
