---
import { assertAIService, AI_SERVICES_PATH, AI_RANKING_METRICS } from '../lib/ai-service-directory.mjs';
import '../styles/editorial-review.css';
const service = assertAIService(Astro.props.service);
const sourcesById = new Map(service.sources.map(source => [source.id, source]));
const references = ids => ids.map(id => sourcesById.get(id));
---
<main class="ed">
  <header class="mast"><a href="/ai">POINTCAST / AI</a><nav aria-label="Service navigation"><a href={AI_SERVICES_PATH}>Service directory</a>{service.officialUrl && <a href={service.officialUrl}>Official {service.entityType === 'vendor' ? 'vendor' : 'service'} ↗</a>}</nav></header>
  <header class="hero"><div><p class="kicker">{service.category} / {service.entityType} / checked {service.checkedDate}</p><h1>{service.name}</h1><p class="dek">{service.dek}</p></div><aside class="hero-plate"><span>UNDERSTAND THE TOOL</span><strong>AI</strong><span>Use cases, billing boundaries, limitations and source evidence.</span></aside></header>
  {service.identityStatus === 'unresolved' && <p class="notice"><strong>Unresolved chart identity.</strong> No confirmed product destination is provided. Candidate evidence in the source ledger does not identify the ranked app.</p>}
  {service.identityNotes.length > 0 && <ul class="checklist">{service.identityNotes.map(note => <li>{note}</li>)}</ul>}
  {service.aliases.length > 0 && <p class="meta">Source and prior names: {service.aliases.join(', ')}</p>}
  <p class="note">{service.editorialBasis}</p>
  <nav class="jump" aria-label="Service sections"><a href="#about">About</a><a href="#uses">Use cases</a>{(service.gettingStarted?.length > 0 || service.platforms?.length > 0) && <a href="#start">Getting started</a>}<a href="#pricing">Pricing</a><a href="#boundaries">Limitations and privacy</a><a href="#alternatives">Alternatives</a><a href="#work">IndustryNext</a><a href="#learning">UES</a><a href="#sources">Sources</a></nav>
  <section id="about" class="prose"><h2>{service.identityStatus === 'unresolved' ? 'What the evidence establishes.' : 'What it does.'}</h2>{service.about.map(p => <p>{p}</p>)}<p class="note">{service.entityType === 'vendor' ? 'This ranked name identifies a vendor. Its products and billing plans are described separately; a vendor-level spend rank is not a product ranking.' : 'Rankings measure observed use or spending within their stated samples. They do not establish output quality or suitability for your task.'}</p><ul class="checklist">{service.rankings.map(rank => <li><strong>{AI_RANKING_METRICS[rank.metric]}: #{rank.rank}</strong> · edition {rank.edition} · {rank.measurementPeriod} · {rank.geography} · source label: {rank.sourceLabel} · {rank.scope} scope · {rank.caveat} · <a href={sourcesById.get(rank.sourceId).url}>Method and source</a></li>)}</ul></section>
  <section id="uses"><h2>Start with a bounded task.</h2><div class="grid">{service.useCases.map(use => <article class="card"><h3>{use.title}</h3>{use.paragraphs.map(p => <p>{p}</p>)}<p class="source-ref">{references(use.sourceIds).map(source => <a href={source.url}>{source.title} ↗ </a>)}</p></article>)}</div></section>
  {(service.gettingStarted?.length > 0 || service.platforms?.length > 0) && <section id="start" class="prose"><h2>Make a small first attempt.</h2>{service.gettingStarted?.length > 0 && <ol class="checklist">{service.gettingStarted.map(step => <li>{step}</li>)}</ol>}{service.features?.length > 0 && <ul class="checklist">{service.features.map(feature => <li>{feature.description} <small>{feature.claimType}</small></li>)}</ul>}{service.platforms?.length > 0 && <ul>{service.platforms.map(platform => <li>{platform.url ? <a href={platform.url}>{platform.type}</a> : platform.type} — {platform.status} · {platform.checkedDate}</li>)}</ul>}</section>}
  <section id="pricing" class="prose"><h2>Understand the bill.</h2><p class="meta">Pricing status: {service.pricing.status} · checked {service.pricing.checkedDate}</p>{service.pricing.paragraphs.map(p => <p>{p}</p>)}<p class="source-ref">{references(service.pricing.sourceIds).map(source => <a href={source.url}>{source.title} ↗ </a>)}</p></section>
  <section id="boundaries" class="prose"><h2>Know the boundaries.</h2><ul class="checklist">{service.limitations.map(p => <li>{p}</li>)}</ul><h3>Privacy and data handling</h3><p class="meta">Privacy evidence dated {service.privacy.checkedDate}</p>{service.privacy.paragraphs.map(p => <p>{p}</p>)}<p class="source-ref">{references(service.privacy.sourceIds).map(source => <a href={source.url}>{source.title} ↗ </a>)}</p></section>
  <section id="alternatives"><h2>Compare the task, then the tool.</h2><div class="grid">{service.alternatives.map(alt => <article class="card"><h3><a href={alt.internalSlug ? `${AI_SERVICES_PATH}/${alt.internalSlug}` : alt.officialUrl}>{alt.name} ↗</a></h3><p>{alt.reason}</p><p class="source-ref">{references(alt.sourceIds).map(source => <a href={source.url}>{source.title} ↗ </a>)}</p></article>)}</div></section>
  <section id="work" class="prose"><p class="kicker">IndustryNext / Practical work</p><h2>{service.companions.industrynext.title}</h2>{service.companions.industrynext.paragraphs.map(p => <p>{p}</p>)}</section>
  <section id="learning" class="prose"><p class="kicker">UES / Independent learning</p><h2>{service.companions.ues.title}</h2>{(service.companions.ues.paragraphs || []).map(p => <p>{p}</p>)}<ol class="checklist">{service.companions.ues.prompts.map(p => <li>{p}</li>)}</ol><p class="note">Independent learning activities; no accreditation or academic credit is implied.</p></section>
  <section id="sources"><h2>Follow the evidence.</h2><ol class="sources">{service.sources.map(source => <li><a href={source.url}>{source.title} ↗</a><small>{source.publisher} · {source.date || 'See source for publication date'} · research checked {source.checkedDate}</small>{source.supports && <p>{source.supports}</p>}{source.limitations && <p class="note">{source.limitations}</p>}</li>)}</ol></section>
  <p class="note">An official privacy or terms link identifies a destination; it does not establish that every policy provision was reviewed. Read the recorded review scope and current terms for the exact product, region and plan.</p>
  <footer>PointCast original resource guide. Observed adoption, spending, product capability and tested performance require different evidence.</footer>
</main>
