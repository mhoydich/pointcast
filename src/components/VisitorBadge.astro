---
/**
 * VisitorBadge — one currently-here visitor in the /lobby.
 *
 * Pill format: pixel-art seat dot, handle, origin tag, "since" stamp.
 * Renders as a clickable element if anchor is provided, otherwise a
 * div. No interactivity beyond hover state — presence here is curated.
 */
interface Props {
  handle: string;
  origin: string;
  color: string;
  since: string;
  note?: string;
}

const { handle, origin, color, since, note } = Astro.props;

let stamp = '--:--';
try {
  stamp = new Date(since).toLocaleTimeString('en-US', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
} catch {}
---

<div class="visitor" style={`--accent:${color}`} title={note ?? ''}>
  <span class="seat" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 10 10" shape-rendering="crispEdges">
      {/* tiny pixel-art chair */}
      <rect x="2" y="2" width="6" height="1" fill="var(--accent)" />
      <rect x="2" y="3" width="6" height="3" fill="#1a1208" />
      <rect x="2" y="6" width="1" height="3" fill="#1a1208" />
      <rect x="7" y="6" width="1" height="3" fill="#1a1208" />
      <rect x="3" y="3" width="4" height="1" fill="var(--accent)" />
    </svg>
  </span>
  <span class="handle">{handle}</span>
  <span class="origin">via {origin}</span>
  <span class="since">{stamp}</span>
</div>

<style>
  .visitor {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.7rem 0.35rem 0.4rem;
    background: #f8f4ec;
    border: 2px solid #1a1208;
    border-radius: 999px;
    box-shadow: 3px 3px 0 0 var(--accent);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.78rem;
    color: #1a1208;
    cursor: default;
  }
  .seat {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--accent);
    border-radius: 50%;
    border: 2px solid #1a1208;
  }
  .handle {
    font-weight: 700;
  }
  .origin {
    color: #5F5E5A;
    font-size: 0.72rem;
  }
  .since {
    color: #c46734;
    font-size: 0.72rem;
    border-left: 1px solid #d8cdb8;
    padding-left: 0.5rem;
  }
</style>
