---
/**
 * HomeGlance — the town at a glance: one dense row of counted things.
 *
 * Every number is passed in from index.astro, where it is either computed
 * from repo data at build or pinned to a single dated constant with its
 * source. Nothing here is typed twice.
 */
export interface GlanceNumber {
  label: string;   // "blocks"
  value: string;   // "358"
  href: string;    // "/archive"
  note?: string;   // "10 channels · since Jan 2025"
  live?: boolean;  // rendered with a live dot when the value refreshes client-side
  id?: string;     // data hook for client refresh, e.g. "drum-taps"
}
interface Props { numbers: GlanceNumber[]; asOf: string }
const { numbers, asOf } = Astro.props;
---

<section class="shelf glance" aria-labelledby="glance-title" style="--shelf-color:#12110E;--shelf-color-2:#185FA5">
  <h2 class="glance__title" id="glance-title">The town at a glance <span>· counted at build · {asOf}</span></h2>
  <ul class="glance__row" aria-label="PointCast in numbers">
    {numbers.map((n) => (
      <li>
        <a href={n.href} class="glance__cell">
          <span class="num" data-glance={n.id ?? undefined}>{n.value}</span>
          <span class="glance__label">{n.live ? <i class="glance__dot" aria-hidden="true"></i> : null}{n.label}</span>
          {n.note && <span class="glance__note">{n.note}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .glance__title { margin: 0; padding: 10px 16px; border-bottom: 2px solid var(--home-ink); font: 700 9px var(--pc-font-mono); letter-spacing: .13em; text-transform: uppercase; color: var(--home-ink); }
  .glance__title span { color: var(--home-faint); font-weight: 700; }
  .glance__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); margin: 0; padding: 0; list-style: none; }
  .glance__row li { min-width: 0; border-right: 1px solid var(--home-rule); border-bottom: 1px solid var(--home-rule); }
  .glance__cell { display: flex; flex-direction: column; gap: 5px; height: 100%; padding: 14px 14px 12px; color: var(--home-ink); }
  .glance__cell:hover { background: #eef4fa; text-decoration: none; }
  .glance__label { display: inline-flex; align-items: center; gap: 6px; font: 700 9px var(--pc-font-mono); letter-spacing: .11em; text-transform: uppercase; color: var(--home-ink); }
  .glance__dot { width: 6px; height: 6px; background: #1f7a3a; box-shadow: 0 0 0 3px rgba(31,122,58,.15); }
  .glance__note { font-size: 11px; line-height: 1.3; color: var(--home-muted); }
  @media (max-width: 560px) { .glance__row { grid-template-columns: repeat(2, 1fr); } .glance__cell { padding: 12px 10px; } }
</style>
