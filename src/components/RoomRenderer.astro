---
/**
 * RoomRenderer — render any RoomSpec the same way on every surface.
 *
 * Sprint 2 of the live-artifacts arc. Consumes a v1 room contract and
 * draws the meditation-artifact layout: top status chyron, big title,
 * centerpiece visualizer, program cards, controls, verb buttons,
 * receipt line, foot attribution.
 *
 * Used by:
 *   - pointcast.xyz pages that want to render a room without writing UI
 *   - the embed web component (Sprint 5) — same DOM, dropped into
 *     someone else's site via <pointcast-room id="meditate">
 *   - the Claude artifact bridge — server-renders the static shell, the
 *     artifact host attaches verb wiring + presence polling
 *
 * The renderer is intentionally style-only + minimal client JS. Live
 * polling, verb wiring, and presence updates are layered on by the
 * embed/artifact host — keeping this file SSR-safe and cacheable.
 */
import type { RoomSpec } from '../lib/room-contract';

interface Props { room: RoomSpec }
const { room } = Astro.props;

// First program is selected by default; first duration option likewise.
const activeProgramId = room.programs[0]?.id ?? '';
const durationControl = room.controls.find((c) => c.type === 'duration');
const activeDurationId = durationControl?.defaultId ?? durationControl?.options[0]?.id ?? '';
const activeProgram = room.programs.find((p) => p.id === activeProgramId) ?? room.programs[0];

// Pick the first prompt of the active program as the visible caption.
const visibleCaption = activeProgram?.prompts?.[0] ?? activeProgram?.tone ?? '';
---

<article class="room" data-room-id={room.id} aria-labelledby={`room-${room.id}-title`}>

  {/* ─── Status chyron — top of the room ─── */}
  {room.status.length > 0 && (
    <ul class="room__status" aria-label="Room status">
      {room.status.map((s) => (
        <li class="room__badge">
          <span class="room__badge-label mono">{s.label}</span>
          <span class="room__badge-value">{s.value}</span>
        </li>
      ))}
    </ul>
  )}

  {/* ─── Identity ─── */}
  <header class="room__head">
    <h2 class="room__title" id={`room-${room.id}-title`}>{room.title}</h2>
    <p class="room__dek">{room.description}</p>
  </header>

  {/* ─── Visualizer (centerpiece) ─── */}
  {room.visualizer && (
    <div class={`room__viz room__viz--${room.visualizer.type}`} aria-hidden="true">
      {room.visualizer.type === 'breath' && (
        <div class="viz-breath">
          <span class="viz-breath__ring viz-breath__ring--3"></span>
          <span class="viz-breath__ring viz-breath__ring--2"></span>
          <span class="viz-breath__ring viz-breath__ring--1"></span>
          <span class="viz-breath__sphere"></span>
          <span class="viz-breath__caption">hold</span>
        </div>
      )}
      {room.visualizer.type === 'pour' && (
        <div class="viz-pour">
          <span class="viz-pour__kettle"></span>
          <span class="viz-pour__stream"></span>
          <span class="viz-pour__cup"></span>
        </div>
      )}
      {room.visualizer.type === 'tap' && (
        <div class="viz-tap">
          <span class="viz-tap__disc"></span>
        </div>
      )}
      {room.visualizer.type === 'wave' && (
        <svg class="viz-wave" viewBox="0 0 320 80" aria-hidden="true">
          <rect x="0" y="0" width="320" height="40" fill="#c8d8e3"/>
          <rect x="0" y="40" width="320" height="40" fill="#3d6a89"/>
          <g fill="none" stroke="#fdf2d6" stroke-width="2">
            {Array.from({ length: 11 }).map((_, i) => (
              <path d={`M${i * 32 - 8} 50 q 8 -6 16 0 q 8 6 16 0`}/>
            ))}
          </g>
        </svg>
      )}
      {room.visualizer.type === 'lantern' && (
        <div class="viz-lantern">
          <span class="viz-lantern__cord"></span>
          <span class="viz-lantern__shade"></span>
          <span class="viz-lantern__glow"></span>
        </div>
      )}
    </div>
  )}

  {/* ─── Caption under the visualizer ─── */}
  {visibleCaption && (
    <p class="room__caption" data-program-caption>{visibleCaption}</p>
  )}

  {/* ─── Program cards ─── */}
  <ul class="room__programs" role="tablist" aria-label="Programs">
    {room.programs.map((p) => (
      <li class={`room__program${p.id === activeProgramId ? ' room__program--active' : ''}`}
          role="tab"
          aria-selected={p.id === activeProgramId ? 'true' : 'false'}
          data-program-id={p.id}>
        <span class="room__program-name">{p.name}</span>
        {p.pattern && (
          <span class="room__program-pattern mono">
            {p.pattern.join(' · ')}
          </span>
        )}
        <span class="room__program-purpose">{p.purpose}</span>
      </li>
    ))}
  </ul>

  {/* ─── Controls ─── */}
  {durationControl && (
    <div class="room__controls">
      <div class="room__duration" role="radiogroup" aria-label="Session duration">
        {durationControl.options.map((opt) => (
          <button class={`room__duration-btn${opt.id === activeDurationId ? ' room__duration-btn--active' : ''}`}
                  type="button"
                  role="radio"
                  aria-checked={opt.id === activeDurationId ? 'true' : 'false'}
                  data-duration-id={opt.id}
                  data-duration-seconds={opt.value}>
            {opt.label}
          </button>
        ))}
      </div>
      <button type="button" class="room__end" data-end-session>End early</button>
    </div>
  )}

  {/* ─── Verbs (write-back actions) ─── */}
  {room.verbs.map((vb) => (
    <div class="room__verb" data-verb-id={vb.id}>
      <div class="room__verb-copy">
        <p class="room__verb-label">{vb.label}</p>
        {vb.description && <p class="room__verb-desc">{vb.description}</p>}
      </div>
      <button type="button"
              class="room__verb-btn"
              data-verb-endpoint={vb.endpoint}
              data-verb-method={vb.method}
              data-verb-payload={JSON.stringify(vb.payload ?? {})}
              data-verb-receipt={vb.receipt.template}>
        {vb.id === 'sing' ? 'Ring the room' : vb.label}
      </button>
    </div>
  ))}

  {/* ─── Receipt feed (filled in by the embed/artifact host) ─── */}
  <p class="room__receipt mono" data-receipt-target></p>

  {/* ─── Foot attribution ─── */}
  {room.sources && room.sources.length > 0 && (
    <p class="room__sources mono">
      {room.sources.map((s, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={s.url}>{s.label}</a>
        </>
      ))}
    </p>
  )}
</article>

<style>
  .room {
    --paper: #fafaf7;
    --paper-soft: #f0eee5;
    --ink: #1f1b15;
    --ink-soft: #5a5648;
    --rule: #ddd9cc;
    --accent: #1b3a5b;
    --warm: #c4952e;
    --coral: #b85a3e;

    max-width: 880px;
    margin: 0 auto;
    padding: 0 12px;
    color: var(--ink);
    font-family: var(--font-body, ui-sans-serif, system-ui);
  }

  /* ─── Status chyron ─── */
  .room__status {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  .room__badge {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .room__badge-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .room__badge-value {
    font-size: 15px;
    line-height: 1.3;
    color: var(--ink);
    font-weight: 500;
  }

  /* ─── Head ─── */
  .room__head { margin: 0 0 32px; }
  .room__title {
    font-family: var(--font-serif, 'Lora', Georgia, serif);
    font-size: clamp(28px, 3.4vw, 38px);
    font-style: italic;
    font-weight: 500;
    margin: 0 0 6px;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .room__dek {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
    font-style: italic;
    max-width: 640px;
    line-height: 1.5;
  }

  /* ─── Visualizer wrapper ─── */
  .room__viz {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 0 8px;
    min-height: 220px;
  }

  /* breath sphere */
  .viz-breath {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 240px;
    height: 240px;
  }
  .viz-breath__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(31, 27, 21, 0.18);
  }
  .viz-breath__ring--1 { width: 180px; height: 180px; }
  .viz-breath__ring--2 { width: 210px; height: 210px; }
  .viz-breath__ring--3 { width: 240px; height: 240px; }
  .viz-breath__sphere {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 32%, #ffffff 0%, #d8e3eb 55%, #a8c2d4 100%);
    box-shadow:
      0 12px 30px rgba(168, 194, 212, 0.45),
      inset -10px -14px 24px rgba(50, 80, 100, 0.18);
    animation: breath-scale 13s ease-in-out infinite;
  }
  .viz-breath__caption {
    position: absolute;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 13px;
    color: rgba(31, 27, 21, 0.62);
  }
  @keyframes breath-scale {
    0%, 100% { transform: scale(0.78); }
    20%      { transform: scale(1); }
    50%      { transform: scale(1); }
    80%      { transform: scale(0.78); }
  }

  /* pour, tap, wave, lantern — minimal placeholders, polish per-room */
  .viz-pour, .viz-tap, .viz-lantern {
    width: 200px; height: 160px;
    position: relative;
  }
  .viz-pour__kettle { position: absolute; top: 0; left: 60px; width: 80px; height: 60px; background: #1f1b15; border-radius: 8px; }
  .viz-pour__stream { position: absolute; top: 60px; left: 96px; width: 6px; height: 50px; background: linear-gradient(180deg, #1f1b15 0%, #c4952e 100%); }
  .viz-pour__cup    { position: absolute; top: 110px; left: 70px; width: 60px; height: 40px; background: var(--paper); border: 2px solid var(--ink); border-radius: 0 0 8px 8px; }
  .viz-tap__disc    { display: block; margin: 0 auto; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle at 35% 32%, #fef3e1, #c4952e); animation: tap-pulse 1.8s ease-in-out infinite; }
  .viz-wave         { display: block; width: 320px; height: 80px; border-radius: 4px; }
  .viz-lantern__cord  { position: absolute; left: 50%; top: 0; width: 1px; height: 36px; background: var(--ink); }
  .viz-lantern__shade { position: absolute; left: 50%; top: 32px; width: 80px; height: 60px; background: var(--ink); border-radius: 0 0 40px 40px; transform: translateX(-50%); }
  .viz-lantern__glow  { position: absolute; left: 50%; top: 92px; width: 64px; height: 64px; background: radial-gradient(circle, rgba(245,198,107,0.95) 0%, rgba(245,198,107,0) 70%); transform: translateX(-50%); animation: lantern-glow 4.2s ease-in-out infinite; }
  @keyframes tap-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(0.94); } }
  @keyframes lantern-glow { 0%, 100% { opacity: 0.7; } 50% { opacity: 1; } }

  /* ─── Caption ─── */
  .room__caption {
    text-align: center;
    margin: 0 0 24px;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 17px;
    color: var(--ink);
    line-height: 1.4;
  }

  /* ─── Programs ─── */
  .room__programs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }
  .room__program {
    padding: 16px 18px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
  }
  .room__program--active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .room__program--active .room__program-purpose { color: rgba(255,255,255,0.78); }
  .room__program-name {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 16px;
    font-weight: 500;
  }
  .room__program-pattern {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
  }
  .room__program--active .room__program-pattern { color: rgba(255,255,255,0.6); }
  .room__program-purpose {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* ─── Controls ─── */
  .room__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin: 6px 0 22px;
  }
  .room__duration {
    display: inline-flex;
    gap: 6px;
  }
  .room__duration-btn {
    padding: 8px 18px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    border-radius: 999px;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .room__duration-btn--active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .room__end {
    padding: 8px 18px;
    background: var(--coral);
    color: #fff;
    border: 1px solid var(--coral);
    border-radius: 999px;
    font-size: 13px;
    cursor: pointer;
  }
  .room__end:hover { filter: brightness(1.06); }

  /* ─── Verbs ─── */
  .room__verb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    margin: 0 0 8px;
  }
  .room__verb-copy { flex: 1 1 auto; min-width: 0; }
  .room__verb-label {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .room__verb-desc {
    margin: 0;
    font-size: 12.5px;
    color: var(--ink-soft);
    font-style: italic;
    line-height: 1.4;
  }
  .room__verb-btn {
    padding: 8px 18px;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
    flex: 0 0 auto;
  }
  .room__verb-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* ─── Receipt + sources ─── */
  .room__receipt {
    margin: 4px 0 18px;
    min-height: 14px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .room__sources {
    margin: 22px 0 0;
    padding-top: 16px;
    font-size: 11px;
    color: var(--ink-soft);
    text-align: center;
    border-top: 1px solid var(--rule);
  }
  .room__sources a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .room__sources a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .viz-breath__sphere, .viz-tap__disc, .viz-lantern__glow {
      animation: none !important;
    }
  }

  @media (max-width: 720px) {
    .room__verb { flex-direction: column; align-items: stretch; }
    .room__verb-btn { width: 100%; }
  }
</style>

<script is:inline>
/**
 * Minimal client wiring:
 *  - Program tab switching (visual only)
 *  - Duration tab switching (visual only)
 *  - Verb buttons: POST/GET the endpoint, render receipt
 *
 * Cross-surface state (presence, true session timer, choir state) is
 * layered on by the embed/artifact host. This script handles the
 * surface-local interactivity so a plain SSR page is usable.
 */
(() => {
  document.querySelectorAll('[data-room-id]').forEach((room) => {
    const programs = room.querySelectorAll('[data-program-id]');
    const captionEl = room.querySelector('[data-program-caption]');

    programs.forEach((p) => {
      p.addEventListener('click', () => {
        programs.forEach((q) => {
          q.classList.toggle('room__program--active', q === p);
          q.setAttribute('aria-selected', q === p ? 'true' : 'false');
        });
        const purpose = p.querySelector('.room__program-purpose')?.textContent;
        if (captionEl && purpose) captionEl.textContent = purpose;
      });
    });

    const durBtns = room.querySelectorAll('[data-duration-id]');
    durBtns.forEach((b) => {
      b.addEventListener('click', () => {
        durBtns.forEach((c) => {
          c.classList.toggle('room__duration-btn--active', c === b);
          c.setAttribute('aria-checked', c === b ? 'true' : 'false');
        });
      });
    });

    const verbs = room.querySelectorAll('[data-verb-endpoint]');
    const receiptEl = room.querySelector('[data-receipt-target]');
    verbs.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const endpoint = btn.getAttribute('data-verb-endpoint');
        const method = btn.getAttribute('data-verb-method') || 'POST';
        const payload = JSON.parse(btn.getAttribute('data-verb-payload') || '{}');
        const template = btn.getAttribute('data-verb-receipt') || 'done';
        const verbId = btn.closest('[data-verb-id]')?.getAttribute('data-verb-id') || 'action';

        // Best-effort fire-and-render. We don't depend on a real
        // endpoint for the receipt — the surface-local action is
        // optimistic; the host (embed/artifact) overrides this with
        // real server confirmation.
        try {
          if (method === 'POST') {
            await fetch(endpoint, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }).catch(() => null);
          } else {
            await fetch(endpoint, { method }).catch(() => null);
          }
        } catch (_) { /* network optional */ }

        const firstArg = Object.values(payload)[0];
        const ctx = {
          actor: 'you',
          action: verbId,
          arg: firstArg !== undefined ? String(firstArg) : '',
          target: endpoint.replace(/^https?:\/\/[^/]+/, ''),
          time: new Date().toLocaleTimeString('en-US', { hour12: true }),
        };
        if (receiptEl) {
          receiptEl.textContent = template.replace(/\{(\w+)\}/g, (_, k) => ctx[k] ?? '{' + k + '}');
        }
      });
    });
  });
})();
</script>
