---
const pathname = Astro.url.pathname;
const hidden = pathname.startsWith('/admin') || pathname.startsWith('/network-el-segundo');
const destination = '/network-el-segundo?utm_source=pointcast&utm_medium=first-100-strip&utm_campaign=pc-network-el-segundo-2026';
const signalMetricId = 'PC-NETWORK-EL-SEGUNDO-SIGNAL';
---

{!hidden && (
  <aside class="first100-strip" data-network-first100 data-first100-metric={signalMetricId} aria-label="Network El Segundo first 100 wallet invitation">
    <a href={destination} class="first100-strip__link">
      <span class="first100-strip__signal" aria-hidden="true"></span>
      <span class="first100-strip__label">TEZOS SIGNAL</span>
      <strong data-first100-count aria-live="polite">— / 100</strong>
      <span class="first100-strip__message" data-first100-message>
        Seat 2 is open · one free signature · zero tez.
      </span>
      <span class="first100-strip__cta" data-first100-cta>TAKE THE NEXT SEAT →</span>
    </a>
  </aside>
)}

{!hidden && (
  <script>
    const PARTICIPANT_ENDPOINT = '/api/network-el-segundo/participants';
    const SIGNAL_METRIC_ID = 'PC-NETWORK-EL-SEGUNDO-SIGNAL';
    const METRIC_ENDPOINT = '/api/ad-metrics';

    function hasSharedWallet(): boolean {
      try {
        return Boolean(localStorage.getItem('pc:wallet-active') || localStorage.getItem('pc:wallet'));
      } catch {
        return false;
      }
    }

    let liveCount = 1;
    let liveTarget = 100;

    function renderWalletState(): void {
      const ready = hasSharedWallet();
      const nextSeat = Math.min(liveTarget, liveCount + 1);
      const complete = liveCount >= liveTarget;
      document.querySelectorAll<HTMLElement>('[data-first100-message]').forEach((element) => {
        element.textContent = complete
          ? 'The founding 100 is complete. Open the public roster.'
          : ready
            ? `Wallet ready · take founding seat ${nextSeat} with one free signature.`
            : `Seat ${nextSeat} is open · one free signature · zero tez.`;
      });
      document.querySelectorAll<HTMLElement>('[data-first100-cta]').forEach((element) => {
        element.textContent = complete
          ? 'VIEW THE FOUNDING 100 →'
          : ready
            ? `TAKE SEAT ${nextSeat} →`
            : 'JOIN FREE →';
      });
    }

    async function refreshFirst100Count(): Promise<void> {
      try {
        const response = await fetch(PARTICIPANT_ENDPOINT, {
          headers: { accept: 'application/json' },
          cache: 'no-store',
        });
        if (!response.ok) return;
        const payload = await response.json() as { count?: number; target?: number };
        if (!Number.isInteger(payload.count) || !Number.isInteger(payload.target)) return;
        liveCount = payload.count;
        liveTarget = payload.target;
        document.querySelectorAll<HTMLElement>('[data-first100-count]').forEach((element) => {
          element.textContent = `${payload.count} / ${payload.target}`;
        });
        renderWalletState();
      } catch {
        // The invitation remains useful if the public counter is temporarily unavailable.
      }
    }

    function first100MetricsDisabled(): boolean {
      try {
        return navigator.doNotTrack === '1' || localStorage.getItem('pc:no-track') === '1';
      } catch {
        return navigator.doNotTrack === '1';
      }
    }

    function sendFirst100Metric(event: 'impression' | 'click'): void {
      if (first100MetricsDisabled()) return;
      const payload = JSON.stringify({ event, adId: SIGNAL_METRIC_ID });
      if (navigator.sendBeacon) {
        const queued = navigator.sendBeacon(METRIC_ENDPOINT, new Blob([payload], { type: 'application/json' }));
        if (queued) return;
      }
      void fetch(METRIC_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: payload,
        keepalive: true,
      });
    }

    function initializeFirst100Metrics(): void {
      const strip = document.querySelector<HTMLElement>('[data-first100-metric]');
      if (!strip || strip.dataset.first100MetricReady === '1' || first100MetricsDisabled()) return;
      strip.dataset.first100MetricReady = '1';

      strip.querySelector('a')?.addEventListener('click', () => sendFirst100Metric('click'), { once: true });

      const impressionKey = `pc:first100-impression:${location.pathname}`;
      try {
        if (sessionStorage.getItem(impressionKey) === '1') return;
      } catch {
        // Storage can be unavailable; the aggregate event can still be sent.
      }

      let timer: number | undefined;
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry) return;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (timer) return;
          timer = window.setTimeout(() => {
            try { sessionStorage.setItem(impressionKey, '1'); } catch { /* no-op */ }
            sendFirst100Metric('impression');
            observer.disconnect();
            timer = undefined;
          }, 1000);
        } else if (timer) {
          window.clearTimeout(timer);
          timer = undefined;
        }
      }, { threshold: [0.5] });
      observer.observe(strip);
    }

    function initializeFirst100Strip(): void {
      renderWalletState();
      void refreshFirst100Count();
      initializeFirst100Metrics();
    }

    window.addEventListener('pc:wallet-change', renderWalletState);
    document.addEventListener('astro:page-load', initializeFirst100Strip);
    initializeFirst100Strip();
  </script>
)}

<style>
  .first100-strip {
    --signal-yellow: #efff55;
    --signal-ink: #121212;
    position: relative;
    z-index: 40;
    margin: 0;
    color: var(--signal-ink);
    background: var(--signal-yellow);
    border-bottom: 1px solid var(--signal-ink);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
  }

  .first100-strip__link {
    min-height: 38px;
    display: grid;
    grid-template-columns: auto auto auto minmax(18ch, 1fr) auto;
    align-items: center;
    gap: 9px 16px;
    width: min(100% - 24px, 1440px);
    margin: 0 auto;
    padding: 7px 0;
    color: inherit;
    text-decoration: none;
  }

  .first100-strip__link:hover .first100-strip__cta,
  .first100-strip__link:focus-visible .first100-strip__cta {
    background: var(--signal-ink);
    color: var(--signal-yellow);
  }

  .first100-strip__link:focus-visible {
    outline: 2px solid var(--signal-ink);
    outline-offset: -3px;
  }

  .first100-strip__signal {
    width: 10px;
    height: 10px;
    border: 2px solid var(--signal-ink);
    border-radius: 50%;
    background: #ff69b4;
    box-shadow: 0 0 0 3px color-mix(in srgb, #ff69b4 28%, transparent);
  }

  .first100-strip__label,
  .first100-strip__message,
  .first100-strip__cta,
  .first100-strip strong {
    font-size: 9px;
    line-height: 1.25;
    letter-spacing: 0.08em;
  }

  .first100-strip__label { font-weight: 700; }
  .first100-strip strong { white-space: nowrap; font-size: 11px; }
  .first100-strip__message { letter-spacing: 0.02em; }
  .first100-strip__cta {
    white-space: nowrap;
    padding: 4px 7px;
    border: 1px solid var(--signal-ink);
    font-weight: 700;
    transition: background 120ms ease, color 120ms ease;
  }

  @media (max-width: 760px) {
    .first100-strip__link {
      grid-template-columns: auto auto 1fr auto;
      gap: 7px 10px;
      width: min(100% - 18px, 1440px);
    }
    .first100-strip__label { display: none; }
    .first100-strip__message {
      grid-column: 2 / -1;
      grid-row: 2;
      font-size: 8px;
    }
    .first100-strip__cta { grid-column: 4; grid-row: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .first100-strip__cta { transition: none; }
  }
</style>
