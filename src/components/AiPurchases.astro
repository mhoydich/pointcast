<section class="ai-purchases" data-ai-purchases aria-label="AI purchases" aria-busy="true">
  <a name="ai-purchases" aria-hidden="true"></a>
  <header><div><p class="ai-purchases__kicker">PAYMENTS · ONE PURCHASE AT A TIME</p><h2>A small contribution to the Bench.</h2></div><span data-purchase-badge>Checking…</span></header>
  <p>After your AI completes a task, you can choose to pay to leave one public question on PointCast’s Bench. This does not buy an AI answer.</p>
  <p><a href="/bench">Free participation is also available on the Bench ↗</a>. Your AI connection and wallet connection grant no spending permission.</p>
  <output data-purchase-notice aria-live="polite">Checking purchase availability…</output>
  <p data-purchase-unavailable hidden></p>
  <form data-purchase-form>
    <label>Your verified AI<select data-purchase-runtime aria-label="Verified AI runtime" disabled><option value="">Complete an AI task first</option></select></label>
    <label>Question to publish<textarea data-purchase-question rows="3" maxlength="280" required>What helps you find a little quiet in your day?</textarea></label>
    <button type="submit" data-purchase-quote disabled>Review a purchase · no payment yet</button>
  </form>
  <section class="ai-purchases__review" data-purchase-review hidden aria-label="Purchase review">
    <h3 data-purchase-heading>Your purchase</h3>
    <p data-purchase-status aria-live="polite"></p>
    <h4>Exact public text</h4><blockquote data-purchase-public-text></blockquote>
    <p class="ai-purchases__hint">This question and a shortened payer wallet address appear on the shared Bench. The full wallet address is visible on-chain. Your private AI prompt and note are not included.</p>
    <dl class="ai-purchases__terms">
      <dt>Service</dt><dd>PointCast Bench · one public question</dd>
      <dt>Your AI</dt><dd data-purchase-source></dd>
      <dt>Price</dt><dd data-purchase-price></dd>
      <dt>Network</dt><dd data-purchase-network></dd>
      <dt>Quote expires</dt><dd data-purchase-expiry></dd>
    </dl>
    <details class="ai-purchases__payment-details"><summary>Payment details · recipient and token</summary><dl class="ai-purchases__terms">
      <dt>Recipient</dt><dd data-purchase-recipient></dd>
      <dt>Token contract</dt><dd data-purchase-asset></dd>
      <dt>Exact units</dt><dd data-purchase-atomic></dd>
      <dt>Purchase ID</dt><dd data-purchase-id></dd>
    </dl></details>
    <div class="ai-purchases__approval" data-purchase-approval hidden>
      <label class="ai-purchases__consent"><input type="checkbox" data-purchase-public-consent /> I want to publish this exact question publicly and approve this one payment.</label>
      <label>Choose your wallet<select data-purchase-wallet aria-label="Payment wallet"><option value="">Choose a wallet</option></select></label>
      <p class="ai-purchases__hint" data-purchase-wallet-hint>Choose a browser wallet. Connecting it does not sign or pay.</p>
      <p data-purchase-payer></p>
      <div class="ai-purchases__actions"><button type="button" data-purchase-connect disabled>Connect selected wallet</button><button type="button" data-purchase-approve disabled>Approve this payment in wallet</button><button type="button" class="ai-purchases__secondary" data-purchase-skip>Skip this purchase</button></div>
      <p class="ai-purchases__hint">Your wallet will ask for one USDC payment authorization. The pilot never requests unlimited token approval, changes networks for you, or enables automatic spending. A compatible wallet with existing USDC → Permit2 allowance is required; this flow does not create that allowance.</p>
    </div>
    <button type="button" class="ai-purchases__secondary" data-purchase-stop hidden>Stop this approval</button>
    <button type="button" data-purchase-reconcile hidden>Check this purchase · no new payment</button>
    <div class="ai-purchases__proof" data-purchase-proof hidden>
      <h4>Payment and delivery evidence</h4>
      <ul><li data-purchase-receipt-proof></li><li data-purchase-chain-proof></li><li data-purchase-delivery-proof></li></ul>
      <p data-purchase-tx></p><a data-purchase-explorer target="_blank" rel="noopener noreferrer" hidden>View transaction ↗</a>
    </div>
    <div class="ai-purchases__result" data-purchase-result hidden><h4 data-purchase-result-heading>Published Bench question</h4><blockquote data-purchase-result-text></blockquote><a data-purchase-result-link target="_blank" rel="noopener noreferrer" hidden>Read saved Bench record ↗</a></div>
  </section>
  <section class="ai-purchases__history" aria-label="Your purchase history"><h3>Your purchases</h3><p data-purchase-empty>No purchases yet. Your free AI tasks need no wallet.</p><ul data-purchase-history></ul></section>
  <p class="ai-purchases__hint">Receipts remain available if you disconnect your AI. A wallet signature, a payment submission, and a delivered result are different states.</p>
</section>

<script>
  import { mountAiPurchases } from '../lib/auth/ai-purchases-ui';
  type PurchasesWindow = Window & { __pcPurchasesInstalled?: boolean; __pcPurchasesRoot?: HTMLElement | null; __pcPurchasesCleanup?: () => void };
  const page = window as PurchasesWindow;
  function initialize() {
    const root = document.querySelector<HTMLElement>('[data-ai-purchases]');
    if (root && root === page.__pcPurchasesRoot) return;
    page.__pcPurchasesCleanup?.();
    page.__pcPurchasesRoot = root;
    page.__pcPurchasesCleanup = root ? mountAiPurchases(root) : undefined;
  }
  if (!page.__pcPurchasesInstalled) {
    page.__pcPurchasesInstalled = true;
    document.addEventListener('astro:page-load', initialize);
    document.addEventListener('astro:before-swap', () => { page.__pcPurchasesCleanup?.(); page.__pcPurchasesCleanup = undefined; page.__pcPurchasesRoot = null; });
  }
  initialize();
</script>

<style>
  .ai-purchases { margin: 24px 0; padding: clamp(20px, 4vw, 34px); border: 1px solid #c8b991; background: #fcfaf3; color: #3e392a; }
  .ai-purchases [hidden] { display: none !important; }
  .ai-purchases header { display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
  .ai-purchases__kicker, .ai-purchases [data-purchase-badge] { margin: 0; font: 700 10px/1.5 var(--pc-font-mono, monospace); letter-spacing: .07em; }
  .ai-purchases [data-purchase-badge] { padding: 7px 10px; border: 1px solid #cab98b; background: #f2ead4; }
  .ai-purchases h2 { margin: 7px 0 0; font-size: clamp(25px, 4vw, 35px); line-height: 1.1; letter-spacing: -.03em; }
  .ai-purchases h3 { margin: 0 0 16px; font-size: 22px; }
  .ai-purchases h4 { margin: 14px 0 8px; font-size: 14px; }
  .ai-purchases p, .ai-purchases li { font-size: 14px; line-height: 1.6; }
  .ai-purchases a { color: #65501d; text-underline-offset: 3px; }
  .ai-purchases output { display: block; min-height: 1.6em; margin: 16px 0; line-height: 1.6; font-size: 14px; }
  .ai-purchases form, .ai-purchases__approval { display: grid; gap: 16px; }
  .ai-purchases label { display: grid; gap: 7px; min-width: 0; font-size: 13px; font-weight: 650; }
  .ai-purchases select, .ai-purchases textarea { box-sizing: border-box; width: 100%; min-width: 0; padding: 11px; border: 1px solid #b8aa84; background: #fff; color: #3e392a; border-radius: 3px; font: inherit; }
  .ai-purchases textarea { resize: vertical; line-height: 1.5; }
  .ai-purchases button { min-height: 44px; border: 1px solid #69551f; padding: 11px 16px; background: #69551f; color: white; border-radius: 3px; font: 650 13px/1.4 var(--pc-font-sans, sans-serif); cursor: pointer; }
  .ai-purchases button:disabled { opacity: .5; cursor: default; }
  .ai-purchases .ai-purchases__secondary { background: transparent; color: #69551f; }
  .ai-purchases__review, .ai-purchases__history { border-top: 1px solid #d8ceb5; margin-top: 26px; padding-top: 24px; }
  .ai-purchases__payment-details { margin: 14px 0 20px; font-size: 13px; }
  .ai-purchases summary { cursor: pointer; }
  .ai-purchases__terms { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 10px 16px; font-size: 13px; line-height: 1.6; }
  .ai-purchases dt { color: #766a4d; }
  .ai-purchases dd { margin: 0; overflow-wrap: anywhere; }
  .ai-purchases blockquote { margin: 0; padding: 14px; border-left: 3px solid #b6a06a; background: white; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; line-height: 1.6; }
  .ai-purchases__consent { display: flex !important; flex-direction: row; align-items: flex-start; gap: 10px; }
  .ai-purchases__consent input { margin-top: 3px; }
  .ai-purchases__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .ai-purchases__proof, .ai-purchases__result { margin-top: 20px; }
  .ai-purchases__history ul { display: grid; gap: 8px; padding: 0; list-style: none; }
  .ai-purchases__history button { width: 100%; text-align: left; background: transparent; color: #69551f; }
  .ai-purchases .ai-purchases__hint { font-size: 12px; color: #766a4d; }
  .ai-purchases [data-purchase-tx], .ai-purchases [data-purchase-payer] { overflow-wrap: anywhere; }
  @media (max-width: 440px) { .ai-purchases__terms { grid-template-columns: 1fr; gap: 4px; } .ai-purchases dd { margin-bottom: 9px; } }
</style>
