---
import '../posters.css';

export const ad = {
  slug: "concrete",
  title: "Concrete",
  description: "Concrete for the garage. El Segundo · Los Angeles.",
  art: "/ad-department/art/wall.svg",
};
---

<article class="campaign-ad" style="background: #e1d7d5" aria-labelledby="ad-concrete">
  <div class="ad-folio">Advertisement</div>
  <div class="ad-inner ad-plate">
    <h2 id="ad-concrete" class="ad-plate-title">
      Concrete
    </h2>
    <p class="ad-plate-sub">for the garage</p>
    <div class="ad-visual" style="width: 100%; margin-top: 4cqw">
      <img
        src="/ad-department/art/wall.svg"
        alt="A Noun with a brick wall for a head, wearing smoke-grey square glasses"
        class="noun"
        style="position: absolute; bottom: 0; left: 50%; height: 100%; transform: translateX(-50%)"
      />
    </div>
    <p class="ad-plate-small" style="margin-top: 5cqw">
      El Segundo &middot; Los Angeles
    </p>
  </div>
</article>
