---
import '../posters.css';
import AdFooter from '../AdFooter.astro';

export const ad = {
  slug: "how-to-look",
  title: "How to look at a building.",
  description: "Stand across the street. Buildings, like oil paintings and relatives, improve with distance.",
  art: "/ad-department/art/noggles.svg",
};
---

<article class="campaign-ad" aria-labelledby="ad-howto">
  <div class="ad-folio">Advertisement</div>
  <div class="ad-inner">
    <div class="ad-visual" style="display: flex; align-items: center; justify-content: center">
      <img
        src="/ad-department/art/noggles.svg"
        alt="A pair of square red Nouns glasses"
        class="noun"
        style="width: 92%"
      />
    </div>
    <h2 id="ad-howto" class="ad-headline">
      How to look at a building.
    </h2>
    <div class="ad-copy cols-2">
      <ol>
        <li>
          Stand across the street. Buildings, like oil paintings and relatives, improve with
          distance.
        </li>
        <li>
          Find the oldest sign. Read it aloud. If it says AUTO REPAIR you are in the right place.
        </li>
        <li>
          Ignore the car. This is the hard one. The car was put there to be looked at; the wall
          was not, and is better for it.
        </li>
        <li>
          Count the colours. If you get past four, somebody has been enjoying themselves.
        </li>
        <li>
          Put on square glasses. They will not help you see. They will make it clear that you
          meant to look.
        </li>
      </ol>
    </div>
    <AdFooter>Glasses: Nouns, CC0.<br />Building: not for sale.</AdFooter>
  </div>
</article>
