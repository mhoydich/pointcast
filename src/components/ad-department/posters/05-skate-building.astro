---
import '../posters.css';
import AdFooter from '../AdFooter.astro';

export const ad = {
  slug: "skate-building",
  title: "How to skate a building.",
  description: "The ledge was poured in one go. So was he.",
  art: "/ad-department/art/skate.svg",
};
---

<article class="campaign-ad" aria-labelledby="ad-skate">
  <div class="ad-folio">Concrete Sessions &middot; No. 1</div>
  <div class="ad-inner">
    <div class="ad-visual" style="background: #d5d7e1">
      <!-- A concrete ledge: one long block on two piers. -->
      <div style="position: absolute; left: 8%; right: 8%; bottom: 14%; height: 13%; background: #9ca3af; border-top: 0.8cqw solid #000; border-bottom: 0.8cqw solid #000"></div>
      <div style="position: absolute; left: 16%; bottom: 0; width: 10%; height: 14%; background: #6b7280"></div>
      <div style="position: absolute; right: 16%; bottom: 0; width: 10%; height: 14%; background: #6b7280"></div>
      <img
        src="/ad-department/art/skate.svg"
        alt="A Noun with a green skateboard for a head, wearing square black glasses and a Gnars shirt, standing on a concrete ledge"
        class="noun"
        style="position: absolute; bottom: 27%; left: 50%; height: 64%; transform: translateX(-50%)"
      />
    </div>
    <p class="ad-caption">The ledge was poured in one go. So was he.</p>
    <h2 id="ad-skate" class="ad-headline">
      How to skate a building.
    </h2>
    <div class="ad-copy cols-2">
      <ol>
        <li>
          Ask nobody. A building that wanted permission slips would have been built with a front
          desk.
        </li>
        <li>
          Find the edge. Architects call it a parapet. You may call it whatever you like, once
          you are on it.
        </li>
        <li>
          Wax is a conversation with concrete. Keep it short. Concrete has heard it all before.
        </li>
        <li>
          Fall off properly. The building will not notice, and that is the nicest thing about
          buildings.
        </li>
        <li>
          Leave a line. Not paint. The grey stripe a truck leaves on a ledge is the only
          signature a wall will accept.
        </li>
      </ol>
    </div>
    <AdFooter>For the Gnars.<br />Shirt and glasses: CC0.</AdFooter>
  </div>
</article>
