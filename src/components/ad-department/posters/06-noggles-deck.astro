---
import '../posters.css';

export const ad = {
  slug: "noggles-deck",
  title: "Noggles, now in seven-ply maple",
  description: "Now in seven-ply maple. For Noggles Board · Not for the nine stair.",
  art: "/ad-department/art/noggles-deck.svg",
};
---

<article class="campaign-ad" style="background: #111; color: #f6f1e7" aria-labelledby="ad-deck">
  <div class="ad-folio">Concrete Sessions &middot; No. 2</div>
  <div class="ad-inner ad-plate">
    <h2 id="ad-deck" class="ad-plate-title" style="font-size: 12cqw">
      Noggles
    </h2>
    <p class="ad-plate-sub">now in seven-ply maple</p>
    <div class="ad-visual" style="width: 100%; margin-top: 4cqw; display: flex; justify-content: center">
      <!-- A deck seen from above, with the glasses as its graphic. -->
      <div
        role="img"
        aria-label="A cream skateboard deck with square red Nouns glasses as its graphic"
        style="height: 100%; aspect-ratio: 1 / 3.6; background: #f6f1e7; border-radius: 999px; position: relative; box-shadow: 1.6cqw 1.6cqw 0 0 #f43f2f"
      >
        {[9, 13, 87, 91].map((top) => (
          <span style={`--bolt-top: ${top}%`}>
            <span style="position: absolute; top: var(--bolt-top); left: 30%; width: 7%; aspect-ratio: 1; border-radius: 50%; background: #111"></span>
            <span style="position: absolute; top: var(--bolt-top); right: 30%; width: 7%; aspect-ratio: 1; border-radius: 50%; background: #111"></span>
          </span>
        ))}
        <img
          src="/ad-department/art/noggles.svg"
          alt=""
          class="noun"
          style="position: absolute; top: 50%; left: 50%; width: 235%; max-width: none; transform: translate(-50%, -50%) rotate(90deg)"
        />
      </div>
    </div>
    <p class="ad-plate-small" style="margin-top: 5cqw">
      For Noggles Board &middot; Not for the nine stair
    </p>
  </div>
</article>
