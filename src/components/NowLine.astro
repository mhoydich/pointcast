---
import type { CollectionEntry } from 'astro:content';
import { CHANNELS } from '../lib/channels';

interface Props {
  blocks: CollectionEntry<'blocks'>[];
  blockCount: number;
}

const { blocks, blockCount } = Astro.props;
const latest = blocks[0] ?? null;
const recent = blocks.slice(0, 6);

const channelCounts = recent.reduce<Record<string, number>>((acc, block) => {
  acc[block.data.channel] = (acc[block.data.channel] ?? 0) + 1;
  return acc;
}, {});

const dominantChannel = Object.entries(channelCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([channel]) => channel)[0];

const dominant = dominantChannel ? CHANNELS[dominantChannel] : null;

const latestTime = latest
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Los_Angeles',
      timeZoneName: 'short',
    }).format(latest.data.timestamp)
  : 'no blocks yet';
---

<aside class="now-line" aria-label="PointCast now line">
  <div class="now-line__pulse" aria-hidden="true"></div>
  <div class="now-line__copy">
    <p class="now-line__kicker">FRONT DOOR</p>
    <h2>
      Start with one good thing.
    </h2>
    <p>
      {blockCount} blocks live
      {latest && <> · newest: {latest.data.title} · {latestTime}</>}
      {dominant && <> · recent center: {dominant.name}</>}
    </p>
  </div>
  <nav class="now-line__links" aria-label="Now line links">
    <a href="/app">app</a>
    <a href="/drum">drum</a>
    <a href="/win95-games">arcade</a>
    {latest && <a href={`/b/${latest.data.id}`}>latest</a>}
  </nav>
</aside>

<style>
  .now-line {
    margin: 18px 0;
    border: 1px solid #d7c9a2;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.9)),
      linear-gradient(135deg, rgba(250, 188, 80, 0.26), rgba(65, 151, 132, 0.14));
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 14px;
  }

  .now-line__pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2f8f75;
    box-shadow: 0 0 0 4px #dff3ea;
  }

  .now-line__copy {
    min-width: 0;
  }

  .now-line__kicker {
    margin: 0 0 4px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }

  .now-line h2 {
    margin: 0;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--pc-ink);
    overflow-wrap: anywhere;
  }

  .now-line p {
    margin: 4px 0 0;
    color: var(--pc-ink-soft);
    font-size: 13px;
    line-height: 1.4;
  }

  .now-line__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .now-line__links a {
    border: 1px solid #c8b98f;
    background: #fff;
    color: #195f52;
    padding: 7px 9px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .now-line {
      grid-template-columns: 12px minmax(0, 1fr);
    }

    .now-line__links {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .now-line__links a {
      padding: 7px 8px;
    }
  }
</style>
