---
import type { CollectionEntry } from 'astro:content';
import { CHANNELS } from '../lib/channels';

interface Props {
  blocks: CollectionEntry<'blocks'>[];
  blockCount: number;
}

const { blocks, blockCount } = Astro.props;
const latest = blocks[0] ?? null;
const recent = blocks.slice(0, 6);

const channelCounts = recent.reduce<Record<string, number>>((acc, block) => {
  acc[block.data.channel] = (acc[block.data.channel] ?? 0) + 1;
  return acc;
}, {});

const dominantChannel = Object.entries(channelCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([channel]) => channel)[0];

const dominant = dominantChannel ? CHANNELS[dominantChannel] : null;

const latestTime = latest
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Los_Angeles',
      timeZoneName: 'short',
    }).format(latest.data.timestamp)
  : 'no blocks yet';
---

<aside class="now-line" aria-label="PointCast now line">
  <div class="now-line__pulse" aria-hidden="true"></div>
  <div class="now-line__copy">
    <p class="now-line__kicker">NOW LINE</p>
    <h2>
      {latest ? latest.data.title : 'PointCast is ready.'}
    </h2>
    <p>
      {blockCount} blocks live
      {latest && <> · latest {latestTime}</>}
      {dominant && <> · recent center: {dominant.name}</>}
    </p>
    <p class="now-line__live" id="now-line-live" data-state="idle" aria-live="polite">
      <span class="now-line__live-dot" aria-hidden="true"></span>
      <span id="now-line-live-text">checking the wing…</span>
    </p>
  </div>
  <nav class="now-line__links" aria-label="Now line links">
    {latest && <a href={`/b/${latest.data.id}`}>latest block</a>}
    <a href="/status">status</a>
    <a href="/wire">wire</a>
  </nav>
</aside>

<script>
  // NowLine live pulse — Mike 2026-05-07 overnight sprint 2.
  // Polls /api/chamber?kind=lobby + ?kind=now every 8s. Surfaces a tiny live
  // line so the homepage feels current even when SSR'd content is stale.
  const liveEl = document.getElementById('now-line-live');
  const liveTextEl = document.getElementById('now-line-live-text');
  const pulseEl = document.querySelector('.now-line__pulse');

  function ago(ms: number): string {
    const s = Math.max(1, Math.round(ms / 1000));
    if (s < 60) return `${s}s ago`;
    const m = Math.round(s / 60);
    if (m < 60) return `${m}m ago`;
    return `${Math.round(m / 60)}h ago`;
  }

  let prev = '';
  async function refresh() {
    if (!liveEl || !liveTextEl) return;
    try {
      const [lobbyRes, nowRes] = await Promise.all([
        fetch('/api/chamber?kind=lobby', { cache: 'no-store' }).catch(() => null),
        fetch('/api/chamber?kind=now', { cache: 'no-store' }).catch(() => null),
      ]);
      const lobby = lobbyRes && lobbyRes.ok ? await lobbyRes.json() : null;
      const now = nowRes && nowRes.ok ? await nowRes.json() : null;

      const visitors = now?.state?.visitors?.length ?? lobby?.state?.visitors?.length ?? 0;
      const rings = Array.isArray(lobby?.state?.rings) ? lobby.state.rings : [];
      const lastRingT = rings.reduce((m: number, r: any) => Math.max(m, Number(r.t) || 0), 0);
      const ringAge = lastRingT ? Date.now() - lastRingT : Infinity;

      let line = '';
      let state = 'idle';
      if (visitors > 0 && lastRingT && ringAge < 5 * 60 * 1000) {
        line = `${visitors} in the wing · last ring ${ago(ringAge)}`;
        state = 'live';
      } else if (visitors > 0) {
        line = `${visitors} ${visitors === 1 ? 'visitor' : 'visitors'} in the wing`;
        state = 'live';
      } else if (lastRingT && ringAge < 30 * 60 * 1000) {
        line = `wing quiet · last ring ${ago(ringAge)}`;
        state = 'soft';
      } else {
        line = 'wing is still · tap the brass pad to ring';
        state = 'idle';
      }

      if (line !== prev) {
        liveTextEl.textContent = line;
        liveEl.dataset.state = state;
        if (pulseEl) (pulseEl as HTMLElement).dataset.state = state;
        prev = line;
      }
    } catch {}
  }
  if (liveEl) {
    refresh();
    setInterval(refresh, 8000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  }
</script>

<style>
  .now-line {
    margin: 18px 0;
    border: 1px solid var(--pc-rule);
    background: #fbfbf8;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 14px;
  }

  .now-line__pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c95c2e;
    box-shadow: 0 0 0 4px #fbe7dc;
    animation: now-line-throb 2.4s ease-in-out infinite;
  }
  .now-line__pulse[data-state='live'] {
    animation-duration: 1.2s;
    background: #d2542a;
  }
  .now-line__pulse[data-state='soft'] {
    animation-duration: 3.6s;
  }
  .now-line__pulse[data-state='idle'] {
    animation: none;
    opacity: 0.55;
  }
  @keyframes now-line-throb {
    0%, 100% { transform: scale(1);    box-shadow: 0 0 0 4px #fbe7dc; }
    50%      { transform: scale(1.18); box-shadow: 0 0 0 6px #fbe7dc; }
  }

  .now-line__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0 !important;
    color: var(--pc-ink-muted, #6a6970);
    font-family: var(--pc-font-mono);
    font-size: 11px !important;
    letter-spacing: 0.04em;
    line-height: 1.3;
    transition: color 240ms;
  }
  .now-line__live[data-state='live'] {
    color: #c95c2e;
  }
  .now-line__live[data-state='soft'] {
    color: #88715a;
  }
  .now-line__live-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.65;
    flex: none;
  }

  .now-line__copy {
    min-width: 0;
  }

  .now-line__kicker {
    margin: 0 0 4px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }

  .now-line h2 {
    margin: 0;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--pc-ink);
    overflow-wrap: anywhere;
  }

  .now-line p {
    margin: 4px 0 0;
    color: var(--pc-ink-soft);
    font-size: 13px;
    line-height: 1.4;
  }

  .now-line__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .now-line__links a {
    border: 1px solid var(--pc-rule);
    background: #fff;
    color: var(--pc-accent);
    padding: 7px 9px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .now-line {
      grid-template-columns: 12px minmax(0, 1fr);
    }

    .now-line__links {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .now-line__links a {
      padding: 7px 8px;
    }
  }
</style>
