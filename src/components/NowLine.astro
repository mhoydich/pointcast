---
/**
 * NowLine — a one-line "right now" strip under the masthead.
 *
 * Goal: give the homepage a delta on every reload, even on the 25th
 * visit of the day. The site builds statically, so visit-time facts
 * (now, ages, today bucket) are computed client-side from inputs the
 * server embeds. Day-stable facts (channel mix, try nudges) are
 * pre-computed at build.
 *
 * Mike 2026-04-30 chat: *"i'd like things to read or do or whatevs
 * even if i visit 25 times in a day."*
 *
 * v1 (codex, b9243bd) was static. v2 adds visit-time rotation.
 *
 * Author: cc. Reviewed by codex 2026-04-30.
 */
import type { CollectionEntry } from 'astro:content';
import { CHANNELS } from '../lib/channels';

interface Props {
  blocks: CollectionEntry<'blocks'>[];
  blockCount: number;
}

const { blocks, blockCount } = Astro.props;

const latest = blocks[0] ?? null;
const leadIso = latest?.data.timestamp.toISOString() ?? null;
const leadTitle = latest?.data.title ?? null;
const leadHref = latest ? `/b/${latest.data.id}` : null;

// Embed up to 30 recent ship timestamps so the client can bucket
// "today in PT" against the visitor's actual now.
const recentShipIsos = blocks.slice(0, 30).map((b) => b.data.timestamp.toISOString());

// Channel mix is day-stable enough to compute at build.
const channelCounts = blocks.slice(0, 12).reduce<Record<string, number>>((acc, b) => {
  acc[b.data.channel] = (acc[b.data.channel] ?? 0) + 1;
  return acc;
}, {});
const dominantCode = Object.entries(channelCounts).sort((a, b) => b[1] - a[1])[0]?.[0];
const dominant = dominantCode ? CHANNELS[dominantCode as keyof typeof CHANNELS] : null;
const topChannel = dominant && dominantCode
  ? { name: dominant.name, slug: dominant.slug, count: channelCounts[dominantCode] }
  : null;

const doNudges = [
  { kicker: 'try', body: 'tap a pad in the drum room', href: '/drum' },
  { kicker: 'try', body: 'open /tide for a five-scene break', href: '/tide' },
  { kicker: 'try', body: 'see who is in /here right now', href: '/here' },
  { kicker: 'try', body: 'browse the federation preview', href: '/federation/preview' },
  { kicker: 'try', body: 'pick a noun in nouns nation', href: '/nouns-nation/' },
  { kicker: 'try', body: 'read /for-agents — the machine path', href: '/for-agents' },
];

const inputs = {
  blockCount,
  leadIso,
  leadTitle,
  leadHref,
  recentShipIsos,
  topChannel,
  doNudges,
};
const inputsJson = JSON.stringify(inputs);
---

<aside class="now-line" aria-label="Right now on PointCast" data-inputs={inputsJson}>
  <span class="now-line__dot" aria-hidden="true"></span>
  <span class="now-line__kicker mono" data-kicker>right now</span>
  <span class="now-line__sep" aria-hidden="true">·</span>
  <span class="now-line__body" data-body>{blockCount} blocks live in el segundo</span>
  <button type="button" class="now-line__pager mono" data-pager aria-label="Show next now-line fact">— / —</button>
</aside>

<script is:inline>
(function () {
  'use strict';
  var root = document.querySelector('.now-line');
  if (!root) return;
  var raw = root.getAttribute('data-inputs') || '{}';
  var inputs;
  try { inputs = JSON.parse(raw); } catch (e) { return; }

  var kickerEl = root.querySelector('[data-kicker]');
  var bodyEl = root.querySelector('[data-body]');
  var pagerEl = root.querySelector('[data-pager]');

  // PT projection: deterministic, no Intl tz dependency. Some Node
  // builds use small-icu and silently ignore timeZone option, so we
  // compute the offset by hand. DST: 2nd Sun in March → 1st Sun in Nov.
  function ptDateFor(d) {
    var y = d.getUTCFullYear();
    var marSecondSun = new Date(Date.UTC(y, 2, 8));
    marSecondSun.setUTCDate(8 + ((7 - marSecondSun.getUTCDay()) % 7));
    var novFirstSun = new Date(Date.UTC(y, 10, 1));
    novFirstSun.setUTCDate(1 + ((7 - novFirstSun.getUTCDay()) % 7));
    var dstStart = Date.UTC(y, 2, marSecondSun.getUTCDate(), 10);
    var dstEnd = Date.UTC(y, 10, novFirstSun.getUTCDate(), 9);
    var t = d.getTime();
    var off = (t >= dstStart && t < dstEnd) ? -7 : -8;
    return new Date(t + off * 3600 * 1000);
  }
  function ptKey(d) {
    var p = ptDateFor(d);
    return p.getUTCFullYear() + '-' + String(p.getUTCMonth() + 1).padStart(2, '0') + '-' + String(p.getUTCDate()).padStart(2, '0');
  }
  function timeOfDay(h) {
    if (h < 5) return 'late night';
    if (h < 11) return 'morning';
    if (h < 14) return 'midday';
    if (h < 18) return 'afternoon';
    if (h < 21) return 'evening';
    return 'night';
  }
  function relAge(d, now) {
    var mins = Math.max(0, Math.round((now.getTime() - d.getTime()) / 60000));
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + ' min ago';
    var hrs = Math.round(mins / 60);
    if (hrs < 24) return hrs + ' hr ago';
    return Math.round(hrs / 24) + 'd ago';
  }

  function buildFacts() {
    var now = new Date();
    var ptNow = ptDateFor(now);
    var hour = ptNow.getUTCHours();
    var todayKey = ptKey(now);

    var facts = [];
    facts.push({
      kicker: 'right now',
      body: timeOfDay(hour) + ' in el segundo · ' + inputs.blockCount + ' blocks live',
    });

    if (inputs.leadIso && inputs.leadTitle && inputs.leadHref) {
      facts.push({
        kicker: 'last ship',
        body: relAge(new Date(inputs.leadIso), now) + ' — ' + inputs.leadTitle,
        href: inputs.leadHref,
      });
    }

    var shipsToday = (inputs.recentShipIsos || []).filter(function (iso) {
      return ptKey(new Date(iso)) === todayKey;
    }).length;
    if (shipsToday > 0) {
      facts.push({
        kicker: 'today',
        body: shipsToday + ' ship' + (shipsToday === 1 ? '' : 's') + ' landed since midnight pt',
        href: '/status',
      });
    }

    if (inputs.topChannel) {
      facts.push({
        kicker: 'channel mix',
        body: inputs.topChannel.name + ' is hot — ' + inputs.topChannel.count + ' of the last 12 blocks',
        href: '/c/' + inputs.topChannel.slug,
      });
    }

    var doy = Math.floor((Date.UTC(ptNow.getUTCFullYear(), ptNow.getUTCMonth(), ptNow.getUTCDate()) - Date.UTC(ptNow.getUTCFullYear(), 0, 0)) / 86400000);
    var nudges = inputs.doNudges || [];
    if (nudges.length) {
      var first = nudges[doy % nudges.length];
      facts.push(first);
      var second = nudges[(doy + 3) % nudges.length];
      if (second.body !== first.body) facts.push(second);
    }
    return facts;
  }

  function render(idx) {
    var f = facts[idx];
    if (!f) return;
    root.classList.add('now-line--fading');
    setTimeout(function () {
      kickerEl.textContent = f.kicker;
      var nextEl;
      if (f.href) {
        nextEl = document.createElement('a');
        nextEl.setAttribute('href', f.href);
      } else {
        nextEl = document.createElement('span');
      }
      nextEl.className = 'now-line__body';
      nextEl.setAttribute('data-body', '');
      nextEl.textContent = f.body;
      bodyEl.replaceWith(nextEl);
      bodyEl = nextEl;
      pagerEl.textContent = (idx + 1) + ' / ' + facts.length;
      root.classList.remove('now-line--fading');
    }, 180);
    i = idx;
  }

  var facts = buildFacts();
  var i = 0;
  render(0);

  if (facts.length > 1) {
    setInterval(function () { render((i + 1) % facts.length); }, 6000);
    pagerEl.addEventListener('click', function () { render((i + 1) % facts.length); });
  } else {
    pagerEl.style.display = 'none';
  }
})();
</script>

<style>
  .now-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 10px;
    padding: 8px 14px;
    border: 1px solid rgba(196, 149, 46, 0.24);
    border-top: none;
    background:
      linear-gradient(90deg, rgba(255, 244, 203, 0.55), rgba(255, 255, 255, 0.42) 50%, rgba(248, 223, 228, 0.32)),
      #fffdf7;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    line-height: 1.4;
    color: #1f160c;
    transition: opacity 0.18s ease;
    box-shadow: 0 6px 18px rgba(61, 39, 18, 0.04);
    min-height: 32px;
  }
  .now-line--fading { opacity: 0.35; }

  .now-line__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c4952e;
    box-shadow: 0 0 0 3px rgba(196, 149, 46, 0.18);
    animation: nowLinePulse 2.2s ease-in-out infinite;
    flex-shrink: 0;
    transform: translateY(-1px);
  }
  @keyframes nowLinePulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }

  .now-line__kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #8a2e62;
    font-size: 10px;
    flex-shrink: 0;
  }
  .now-line__sep { color: rgba(138, 46, 98, 0.32); flex-shrink: 0; }

  .now-line__body {
    color: #1f160c;
    text-decoration: none;
    border-bottom: 1px dotted transparent;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.now-line__body:hover { border-bottom-color: rgba(47, 95, 159, 0.6); color: #2f5f9f; }

  .now-line__pager {
    margin-left: auto;
    color: #756249;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    user-select: none;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid rgba(196, 149, 46, 0.28);
    padding: 2px 8px;
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
  }
  .now-line__pager:hover { border-color: rgba(47, 95, 159, 0.5); color: #2f5f9f; }
  .now-line__pager:focus-visible { outline: 2px solid #2f5f9f; outline-offset: 2px; }

  @media (max-width: 640px) {
    .now-line {
      flex-wrap: wrap;
      gap: 6px 8px;
      min-height: 48px;
    }
    .now-line__body {
      flex-basis: 100%;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .now-line__pager { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-line__dot { animation: none; }
    .now-line { transition: none; }
  }
</style>
