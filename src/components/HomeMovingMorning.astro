---
const bloomHref = 'https://tonebloom.xyz/daily/2026-07-29';
const playlistHref = 'https://open.spotify.com/playlist/6Oat4B39aGzpv9EYu13KpT';
const cover = '/images/tone-bloom/airy-garden-mix.png';
---

<section class="moving-morning" aria-labelledby="moving-morning-title">
  <a
    class="moving-morning__cover"
    href={bloomHref}
    aria-label="Open The Moving Morning on Tone Bloom"
  >
    <img
      src={cover}
      alt="Airy Garden Mix cover with a black wind bell, cream ribbons, coral flowers, and a cobalt vase against a clear blue sky"
      width="1024"
      height="1024"
      loading="eager"
    />
  </a>

  <div class="moving-morning__copy">
    <header class="moving-morning__wire">
      <span>TONE BLOOM DAILY 003</span>
      <span>NOW PUBLIC</span>
      <span>WED · JUL 29</span>
    </header>

    <p class="moving-morning__eyebrow">A SMALL OPENING FOR THE DAY</p>
    <h2 id="moving-morning-title">The Moving <em>Morning</em></h2>
    <p class="moving-morning__dek">
      Eight wind shrines, four flower interludes, and seventy-two seconds of
      original browser sound. Then Airy Garden Mix keeps the air moving.
    </p>

    <div class="moving-morning__actions">
      <a href={bloomHref}>Open today’s Bloom ↗</a>
      <a href={playlistHref}>Play the public mix ↗</a>
    </div>

    <footer class="moving-morning__foot">
      <span>NO LOGIN</span>
      <span>NO STREAK</span>
      <span>ORIGINAL WEB AUDIO</span>
      <span>30-TRACK COMPANION</span>
    </footer>
  </div>
</section>

<style>
  .moving-morning {
    --mm-ink: #151511;
    --mm-paper: #f1e5bf;
    --mm-sky: #7ab4df;
    --mm-coral: #f36e38;
    display: grid;
    grid-template-columns: minmax(240px, .78fr) minmax(0, 1.22fr);
    margin-top: 16px;
    border: 2px solid var(--mm-ink);
    background: var(--mm-paper);
    color: var(--mm-ink);
    overflow: hidden;
  }

  .moving-morning a { color: inherit; }

  .moving-morning__cover {
    display: block;
    min-width: 0;
    border-right: 2px solid var(--mm-ink);
    background: var(--mm-sky);
    overflow: hidden;
  }

  .moving-morning__cover img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 430px;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(.2, .8, .2, 1), filter 180ms ease;
  }

  .moving-morning__cover:hover img,
  .moving-morning__cover:focus-visible img {
    filter: saturate(1.08);
    transform: scale(1.018);
  }

  .moving-morning__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 430px;
    padding: clamp(24px, 4vw, 54px);
    background:
      linear-gradient(150deg, transparent 0 64%, rgba(243, 110, 56, .9) 64.2% 65.2%, transparent 65.4%),
      linear-gradient(165deg, transparent 0 76%, rgba(255, 255, 255, .42) 76.2% 78%, transparent 78.2%),
      var(--mm-sky);
  }

  .moving-morning__wire,
  .moving-morning__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 950;
    letter-spacing: .1em;
  }

  .moving-morning__eyebrow {
    margin: auto 0 12px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: .12em;
  }

  .moving-morning h2 {
    max-width: 9ch;
    margin: 0;
    font-size: clamp(52px, 7vw, 102px);
    font-weight: 950;
    letter-spacing: -.075em;
    line-height: .78;
  }

  .moving-morning h2 em {
    color: #fff6d9;
    font-style: normal;
  }

  .moving-morning__dek {
    max-width: 46ch;
    margin: 24px 0;
    font-size: clamp(17px, 1.8vw, 24px);
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.08;
  }

  .moving-morning__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .moving-morning__actions a {
    padding: 13px 15px;
    border: 2px solid var(--mm-ink);
    background: var(--mm-ink);
    color: white;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 950;
    letter-spacing: .075em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .moving-morning__actions a:last-child {
    background: var(--mm-paper);
    color: var(--mm-ink);
  }

  .moving-morning__foot {
    justify-content: flex-start;
    margin-top: auto;
    padding-top: 26px;
  }

  .moving-morning__foot span::before {
    content: '●';
    margin-right: 5px;
    color: var(--mm-coral);
  }

  @media (max-width: 720px) {
    .moving-morning { grid-template-columns: 1fr; }
    .moving-morning__cover { border-right: 0; border-bottom: 2px solid var(--mm-ink); }
    .moving-morning__cover img { min-height: 0; aspect-ratio: 1; }
    .moving-morning__copy { min-height: 410px; }
    .moving-morning__wire span:nth-child(2) { color: #fff6d9; }
    .moving-morning h2 { font-size: clamp(50px, 16vw, 80px); }
    .moving-morning__actions { flex-direction: column; }
    .moving-morning__actions a { text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .moving-morning__cover img { transition: none; }
  }
</style>
