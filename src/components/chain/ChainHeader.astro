---
/**
 * The /chain section header: breadcrumb, section nav and the honest status
 * strip. Used by every /chain page so the wayfinding and the status line
 * never drift apart. Facts live in src/data/chain-home.ts.
 */
import { CHAIN_NAV, STATUS_LINE } from '../../data/chain-home';
import { CHAIN_APPS } from '../../data/chain-apps';

interface Props {
  /** Key of the current page in CHAIN_NAV (home, dev, docs, case-study, interns). */
  current: string;
  /** Extra breadcrumb trail after "chain", e.g. [{ label: 'docs', href: '/chain/docs/' }]. */
  trail?: { label: string; href?: string }[];
  block?: string;
  /** Quick links on the right of the status strip; defaults to the main doors. */
  quick?: { label: string; href: string }[];
}

const { current, trail = [], block = '0660', quick } = Astro.props;
// On any of the seven apps the Apps item is lit (aria-current="true": the section, not the page, because it links to /chain#apps) and a second row names the apps, where the app's own link is the one aria-current="page".
const onApp = CHAIN_APPS.some((a) => a.key === current);
const links = quick ?? [
  { label: 'Yard', href: '/chain/yard/?snapshot=./snapshot.json' },
  { label: 'Dev', href: '/chain/dev' },
  { label: 'Docs', href: '/chain/docs/' },
  { label: 'Case study', href: '/chain/case-study' },
  { label: 'Interns', href: '/chain/interns' },
];
---
<nav class="crumb" aria-label="Breadcrumb">
  <a href="/">PointCast</a><span aria-hidden="true">/</span><a href="/c/front-door">front door</a><span aria-hidden="true">/</span>
  {trail.length ? <a href="/chain">chain</a> : <span>chain</span>}
  {trail.map((t, i) => (
    <>
      <span aria-hidden="true">/</span>
      {t.href && i < trail.length - 1 ? <a href={t.href}>{t.label}</a> : <span>{t.label}</span>}
    </>
  ))}
  <a class="crumb__block" href={`/b/${block}`}>BLOCK {block}</a>
</nav>
<nav class="subnav" aria-label="PointCast Chain">
  {CHAIN_NAV.map((n) => (
    <a href={n.href} aria-current={n.key === current ? 'page' : n.key === 'apps' && onApp ? 'true' : undefined}>{n.label}</a>
  ))}
</nav>
{onApp && (
  <nav class="subnav subnav--apps" aria-label="PointCast Chain apps">
    {CHAIN_APPS.map((a) => (
      <a href={a.href} aria-current={a.key === current ? 'page' : undefined}>{a.short}</a>
    ))}
  </nav>
)}
<div class="strip" role="note" aria-label="Status">
  <p><b>STATUS</b> · {STATUS_LINE}</p>
  <nav aria-label="Quick links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</div>
