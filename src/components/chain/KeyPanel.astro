---
/**
 * The "your devnet key" panel shared by the writing apps (The Daily Mint, the
 * Notary, Time Capsules). public/chain/apps/key-panel.js wires it up. A key
 * made here is a free devnet account: 32 random bytes used as an ed25519 key,
 * which the devnet treats as a tz1 account. It signs in this browser and only
 * signatures leave it. It has no value and the devnet may reset.
 */
interface Props {
  /** Appears in the explanatory line: what the key will sign on this page. */
  signs: string;
  id?: string;
}
const { signs, id = 'kp' } = Astro.props;
---
<div class="ca-key" data-key-panel data-state="none">
  <h3>Your devnet key</h3>
  <p>
    A key made here is a free account on the devnet. It signs {signs} in this browser, and only the signatures leave it. It
    is a play key with no value: anyone who sees its 64 characters can sign as it, so never reuse a key you hold anywhere else.
  </p>
  <p class="ca-hint">
    One key, three apps: if you tick “Keep it on this device”, the Daily Mint, the Notary and Time Capsules all load this same key, so
    a stamp, a bid and a capsule signed here are linked to one account that anyone can read on the devnet. The 64 characters sit in
    this browser’s local storage, which every script on pointcast.xyz can read. Leave it unticked and the key lives in this tab only.
  </p>
  <p class="ca-status" data-kp-status role="status" aria-live="polite">No key yet. Make one: it is a new devnet account, free.</p>
  <code class="ca-hash" data-kp-address></code>
  <div class="ca-actions">
    <button class="btn" type="button" data-kp-make disabled>Make a key</button>
    <label class="ca-toggle"><input class="ca-checkbox" type="checkbox" data-kp-keep disabled /> <span>Keep it on this device</span></label>
    <button class="btn btn--ghost" type="button" data-kp-reveal disabled>Show the key</button>
    <button class="btn btn--ghost" type="button" data-kp-copy hidden>Copy</button>
    <button class="btn btn--ghost" type="button" data-kp-keepold hidden>Keep this key</button>
    <button class="btn btn--ghost" type="button" data-kp-forget disabled>Forget it</button>
  </div>
  <input class="ca-input ca-input--mono" data-kp-seed type="text" readonly hidden aria-label="Your key, 64 hex characters" spellcheck="false" autocomplete="off" />
  <details class="ca-own">
    <summary>Use a key you already have</summary>
    <div class="ca-controls">
      <div class="ca-field ca-field--grow">
        <label class="ca-label" for={id + '-own'}>A 64-character hex seed</label>
        <input id={id + '-own'} class="ca-input ca-input--mono" data-kp-own type="password" autocomplete="off" data-1p-ignore data-lpignore="true" spellcheck="false" maxlength="64" />
        <p class="ca-hint" data-kp-own-note>Only a devnet key. It stays in this tab unless you tick “Keep it on this device”.</p>
      </div>
      <button class="btn btn--ghost" type="button" data-kp-use disabled>Use this key</button>
    </div>
  </details>
</div>
