---
/**
 * IntercomWidget — global floating bug-report + chat-to-Mike button.
 *
 * Mike 2026-05-08: "have some type of bug report possibility, easy,
 * and maybe set up a chat that sends messages to me like an intercom."
 *
 * One floating button bottom-right (above FooterBar). Click opens a
 * panel with two tabs: REPORT A BUG / SAY HI TO MIKE. Both submit
 * to /api/intercom; Mike reads them at /intercom.
 *
 * Renders inline + uses local-only state. Doesn't poll. Pure HTML +
 * vanilla JS so it works on every page that uses BlockLayout.
 */
---

<div class="ico" id="ico-root" data-state="closed">
  <button class="ico__trigger" id="ico-trigger" type="button" aria-label="Report a bug or message Mike" aria-expanded="false">
    <span class="ico__trigger-icon" aria-hidden="true">💬</span>
    <span class="ico__trigger-label">message mike</span>
  </button>

  <div class="ico__panel" id="ico-panel" role="dialog" aria-label="Send message to Mike" aria-hidden="true">
    <header class="ico__head">
      <span class="ico__title">Send to Mike</span>
      <button class="ico__close" id="ico-close" type="button" aria-label="Close">✕</button>
    </header>
    <div class="ico__tabs" role="tablist">
      <button class="ico__tab ico__tab--active" data-kind="chat" role="tab" type="button" aria-selected="true">💬 Say hi</button>
      <button class="ico__tab" data-kind="bug" role="tab" type="button" aria-selected="false">🐛 Report bug</button>
    </div>
    <form class="ico__form" id="ico-form">
      <textarea class="ico__textarea" id="ico-body" rows="4" placeholder="say hi…" maxlength="2000" required></textarea>
      <input class="ico__contact" id="ico-contact" type="text" placeholder="optional · how Mike can reach you (email, handle)" maxlength="200"/>
      <div class="ico__meta">
        <span class="ico__page" id="ico-page">page: —</span>
      </div>
      <div class="ico__row">
        <button class="ico__send" type="submit" id="ico-send">SEND</button>
        <span class="ico__status" id="ico-status" aria-live="polite"></span>
      </div>
    </form>
  </div>
</div>

<style>
  .ico {
    position: fixed;
    right: 16px;
    bottom: 96px; /* sit above FooterBar */
    z-index: 90;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
  }
  @media (max-width: 680px) {
    .ico { bottom: 124px; right: 10px; }
  }

  .ico__trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 2px solid #1a0820;
    background: linear-gradient(180deg, #f6c15e 0%, #d4a437 100%);
    color: #1a0820;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 4px 4px 0 0 #1a0820;
    transition: transform 100ms, box-shadow 100ms;
    border-radius: 999px;
  }
  .ico__trigger:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 0 #1a0820; }
  .ico__trigger:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 #1a0820; }
  .ico__trigger-icon { font-size: 16px; line-height: 1; }
  .ico[data-state='open'] .ico__trigger { display: none; }

  .ico__panel {
    width: 320px;
    max-width: calc(100vw - 32px);
    border: 2.5px solid #1a0820;
    background: #fffaf0;
    box-shadow: 6px 6px 0 0 #1a0820;
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  .ico[data-state='open'] .ico__panel { display: flex; }

  .ico__head { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #1a0820; color: #f6c15e; }
  .ico__title { font-size: 11px; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; }
  .ico__close { background: transparent; border: none; color: #f6c15e; cursor: pointer; font-size: 14px; padding: 2px 6px; }
  .ico__close:hover { color: #fffaf0; }

  .ico__tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .ico__tab { padding: 10px 8px; border: none; border-bottom: 2px solid #1a0820; background: #f4e7c8; color: #5a3422; font-family: inherit; font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; transition: background 100ms, color 100ms; }
  .ico__tab:hover { background: #f6c15e; }
  .ico__tab--active { background: #fffaf0; color: #1a0820; border-bottom-color: transparent; }

  .ico__form { display: flex; flex-direction: column; gap: 8px; padding: 12px; background: #fffaf0; }
  .ico__textarea, .ico__contact { width: 100%; padding: 8px 10px; border: 2px solid #1a0820; background: #fffaf0; color: #1a0820; font-family: inherit; font-size: 12px; line-height: 1.4; resize: vertical; box-sizing: border-box; }
  .ico__textarea:focus, .ico__contact:focus { outline: none; border-color: #d4a437; box-shadow: 0 0 0 2px #f6c15e; }
  .ico__contact { font-size: 11px; }
  .ico__meta { font-size: 9px; letter-spacing: 0.12em; color: #5a3422; opacity: 0.75; }
  .ico__page { word-break: break-all; }

  .ico__row { display: flex; align-items: center; gap: 10px; }
  .ico__send { padding: 8px 16px; border: 2px solid #1a0820; background: #d4a437; color: #1a0820; font-family: inherit; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; box-shadow: 2px 2px 0 0 #1a0820; transition: transform 100ms, box-shadow 100ms; }
  .ico__send:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 0 #1a0820; }
  .ico__send:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 #1a0820; }
  .ico__send:disabled { opacity: 0.55; cursor: not-allowed; }
  .ico__status { font-size: 10px; letter-spacing: 0.10em; color: #5a3422; }
  .ico__status[data-kind='ok'] { color: #2a5a30; }
  .ico__status[data-kind='err'] { color: #b8431a; }

  @media (prefers-reduced-motion: reduce) {
    .ico__trigger, .ico__send { transition: none !important; }
  }
</style>

<script>
  (function () {
    const root = document.getElementById('ico-root');
    const trigger = document.getElementById('ico-trigger');
    const panel = document.getElementById('ico-panel');
    const closeBtn = document.getElementById('ico-close');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.ico__tab'));
    const bodyEl = document.getElementById('ico-body') as HTMLTextAreaElement | null;
    const contactEl = document.getElementById('ico-contact') as HTMLInputElement | null;
    const form = document.getElementById('ico-form') as HTMLFormElement | null;
    const sendBtn = document.getElementById('ico-send') as HTMLButtonElement | null;
    const statusEl = document.getElementById('ico-status');
    const pageEl = document.getElementById('ico-page');
    if (!root || !trigger || !panel || !form || !sendBtn || !bodyEl || !pageEl) return;

    let kind: 'chat' | 'bug' = 'chat';

    function open() {
      root!.dataset.state = 'open';
      trigger!.setAttribute('aria-expanded', 'true');
      panel!.setAttribute('aria-hidden', 'false');
      pageEl!.textContent = `page: ${location.pathname}${location.search}`;
      setTimeout(() => bodyEl!.focus(), 80);
    }
    function close() {
      root!.dataset.state = 'closed';
      trigger!.setAttribute('aria-expanded', 'false');
      panel!.setAttribute('aria-hidden', 'true');
    }
    function setKind(k: 'chat' | 'bug') {
      kind = k;
      tabs.forEach(t => {
        const on = t.dataset.kind === k;
        t.classList.toggle('ico__tab--active', on);
        t.setAttribute('aria-selected', String(on));
      });
      bodyEl!.placeholder = k === 'bug'
        ? 'what broke? where did it happen? what did you expect?'
        : 'say hi…';
    }
    trigger.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    tabs.forEach(t => t.addEventListener('click', () => setKind(t.dataset.kind as 'chat' | 'bug')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.state === 'open') close();
    });

    function sessionId(): string {
      try {
        let id = localStorage.getItem('pc-session-id');
        if (!id) {
          id = 'anon-' + Math.random().toString(36).slice(2, 12);
          localStorage.setItem('pc-session-id', id);
        }
        return id;
      } catch { return 'anon-' + Date.now(); }
    }

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const body = bodyEl!.value.trim();
      if (!body) return;
      sendBtn!.disabled = true;
      if (statusEl) { statusEl.textContent = 'sending…'; statusEl.dataset.kind = ''; }
      try {
        const r = await fetch('/api/intercom', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            kind,
            body,
            contact: contactEl?.value || '',
            page: location.pathname + location.search,
            sessionId: sessionId(),
          }),
        });
        const j = await r.json();
        if (j?.ok) {
          if (statusEl) { statusEl.textContent = '✓ sent · thank you'; statusEl.dataset.kind = 'ok'; }
          bodyEl!.value = '';
          if (contactEl) contactEl.value = '';
          setTimeout(() => { close(); if (statusEl) { statusEl.textContent = ''; statusEl.dataset.kind = ''; } }, 1400);
        } else {
          if (statusEl) { statusEl.textContent = `✕ ${j?.reason || 'error'}`; statusEl.dataset.kind = 'err'; }
        }
      } catch (err) {
        if (statusEl) { statusEl.textContent = '✕ network error'; statusEl.dataset.kind = 'err'; }
      } finally {
        sendBtn!.disabled = false;
      }
    });

    setKind('chat');
  })();
</script>
