---
/**
 * DeskCall — a court card's "call from the desk": a live air_calls question
 * on one of the court's own desk kinds (courts.sign, manhattan-heights.closes,
 * el-segundo.lights; build spec §4, §9 item 4). Hidden by default; the client
 * (src/scripts/pickleball-board.ts) unhides it and fills the head and belief
 * lines from BoardCourt.call (a CallView). The buttons are TapRow, reused
 * as-is: the same POST /api/air/<spotId> a normal on-site report already
 * takes, and an on-site answer is what resolves the call
 * (functions/_lib/air-store.ts, group M). TapRow's own hint already covers
 * "no on-site code yet" — an answer from away never resolves the call, the
 * same way it never counts a reading.
 *
 * Also used on the beach's own spot page (src/components/air/AirSpot.astro)
 * — a desk kind on a court is the only place a call can be live, but the
 * shell is spot-agnostic.
 */
import TapRow from '../courts/TapRow.astro';
import type { AirKind } from '../../lib/air';

interface Props {
  spotId: string;
  kind: string;
  cfg: AirKind;
}
const { spotId, kind, cfg } = Astro.props as Props;
---

<div class="pb-call" data-pb-call={`${spotId}:${kind}`} hidden>
  <p class="pb-call__head air-mono" data-pb-call-head>CALL FROM THE DESK</p>
  <p class="pb-call__belief" data-pb-call-belief></p>
  <TapRow spotId={spotId} kind={kind} cfg={cfg} />
</div>

<style>
  /* Scoped `display` rules below beat the browser's own [hidden] (see TapRow's own note). */
  [hidden] { display: none !important; }
  .pb-call { margin: 14px 0 0; padding: 12px; border: 1.5px solid var(--pc-accent, var(--pc-ink)); }
  .pb-call__head { margin: 0 0 6px; font-weight: 600; letter-spacing: .06em; color: var(--pc-accent, var(--pc-ink)); }
  .pb-call__belief { margin: 0 0 10px; font-size: 14px; line-height: 1.4; color: var(--pc-ink-soft); }
</style>
