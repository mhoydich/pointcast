---
/**
 * HomePlacesDirectory — Yahoo / Craigslist-style link tree.
 *
 * Mike 2026-05-08: "for the homepage, still need some type of yahoo,
 * craigslist type of link tree to visit places."
 *
 * The Home v2027 lead → operating mode → today/week is editorial; great
 * for narrative but does nothing for DISCOVERY. This band is the
 * complement: a dense, terse, scannable directory of every public
 * place on the site, organized by purpose. No images, no chrome,
 * just LINKS — the way Yahoo's portal looked in 1996 and Craigslist
 * still looks today.
 *
 * Hand-curated. Every link verified 200 in production at landing
 * time (2026-05-08). New routes get added by editing this file —
 * deliberately not auto-generated from the sitemap so the editorial
 * shape stays opinionated.
 *
 * Mounted on / between THIS WEEK and ARCHIVE TEASER.
 */

interface Place { href: string; label: string; blurb?: string; }
interface Section { id: string; label: string; sub: string; places: Place[]; }

const SECTIONS: Section[] = [
  {
    id: 'today', label: 'TODAY', sub: 'what is happening',
    places: [
      { href: '/now',       label: 'now',       blurb: 'right-now snapshot' },
      { href: '/wire',      label: 'wire',      blurb: 'recent activity' },
      { href: '/briefs',    label: 'briefs',    blurb: 'latest briefs' },
      { href: '/window',    label: 'window',    blurb: 'el segundo right now' },
      { href: '/residents', label: 'residents', blurb: 'meet the cast' },
    ],
  },
  {
    id: 'make', label: 'MAKE', sub: 'create something',
    places: [
      { href: '/studio',  label: 'studio',  blurb: 'block maker' },
      { href: '/drum',    label: 'drum',    blurb: 'tap, ring, sing' },
      { href: '/spells',  label: 'spells',  blurb: '+confetti, +cat, +rain' },
      { href: '/ues',     label: 'ues',     blurb: 'university of el segundo' },
      { href: '/bar-v6',  label: 'bar-v6',  blurb: 'walking bar preview' },
    ],
  },
  {
    id: 'rooms', label: 'ROOMS', sub: 'walk into one',
    places: [
      { href: '/lobby',    label: 'lobby',    blurb: 'public room' },
      { href: '/coffee',   label: 'coffee',   blurb: 'mugs + pours' },
      { href: '/kettle',   label: 'kettle',   blurb: 'make a pot' },
      { href: '/here',     label: 'here',     blurb: 'who is connected now' },
      { href: '/meetups',  label: 'meetups',  blurb: 'gather' },
    ],
  },
  {
    id: 'people', label: 'PEOPLE', sub: 'identity + community',
    places: [
      { href: '/me',         label: 'me',         blurb: 'your start experience' },
      { href: '/checkins',   label: 'checkins',   blurb: 'who checked in today' },
      { href: '/profile',    label: 'profile',    blurb: 'wallet pairings' },
      { href: '/residents',  label: 'residents',  blurb: 'agents + humans' },
      { href: '/here',       label: 'here',       blurb: 'live presence' },
    ],
  },
  {
    id: 'visit', label: 'VISIT', sub: 'el segundo + south bay',
    places: [
      { href: '/local',       label: 'local',       blurb: 'el segundo' },
      { href: '/nature',      label: 'nature',      blurb: 'field desk' },
      { href: '/walk',        label: 'walk',        blurb: 'daily walks' },
      { href: '/tide',        label: 'tide',        blurb: 'tides + surf' },
      { href: '/houseplants', label: 'houseplants', blurb: 'care log' },
      { href: '/beacon',      label: 'beacon',      blurb: 'local commerce' },
    ],
  },
  {
    id: 'play', label: 'PLAY', sub: 'fun + games',
    places: [
      { href: '/play',              label: 'play',              blurb: 'index of play' },
      { href: '/battle',            label: 'battle',            blurb: 'battler' },
      { href: '/agent-derby',       label: 'agent-derby',       blurb: 'race' },
      { href: '/nouns-cola-crush',  label: 'nouns-cola-crush',  blurb: 'arcade' },
      { href: '/drum-room',         label: 'drum-room',         blurb: 'jam' },
    ],
  },
  {
    id: 'agents', label: 'AGENTS', sub: 'machine-readable',
    places: [
      { href: '/for-agents',         label: 'for-agents',          blurb: 'manifest' },
      { href: '/agents.json',        label: 'agents.json',         blurb: 'discovery JSON' },
      { href: '/llms.txt',           label: 'llms.txt',            blurb: 'LLM-readable' },
      { href: '/mcps',               label: 'mcps',                blurb: 'MCP catalog' },
      { href: '/blocks.json',        label: 'blocks.json',         blurb: 'every block' },
      { href: '/operating-mode.json', label: 'operating-mode.json', blurb: 'in-flight work' },
    ],
  },
  {
    id: 'deep', label: 'DEEP', sub: 'docs + theory',
    places: [
      { href: '/manifesto',          label: 'manifesto',          blurb: 'why' },
      { href: '/mythos',             label: 'mythos',             blurb: 'the lore' },
      { href: '/protocol',           label: 'protocol',           blurb: 'how' },
      { href: '/investment-thesis',  label: 'investment-thesis',  blurb: 'commercial frame' },
      { href: '/BLOCKS.md',          label: 'BLOCKS.md',          blurb: 'block schema spec' },
      { href: '/archive',            label: 'archive',            blurb: 'every block, sortable' },
    ],
  },
];

const totalLinks = SECTIONS.reduce((n, s) => n + s.places.length, 0);
---

<section class="places" aria-label="Places to visit">
  <header class="places__head">
    <p class="kicker mono">PLACES · {totalLinks} LINKS · {SECTIONS.length} CATEGORIES</p>
    <h2 class="places__title">Map of the town.</h2>
    <p class="places__dek">
      Yahoo-style index of every public surface. Hand-curated, terse,
      no images. Use the channel filters on <a href="/archive">/archive</a>
      for a denser block-level view, or the agent-readable
      <a href="/agents.json">/agents.json</a> for the full manifest.
    </p>
  </header>

  <div class="places__grid">
    {SECTIONS.map((sec) => (
      <section class="places__col" aria-labelledby={`places-${sec.id}-h`}>
        <header class="places__col-head">
          <h3 id={`places-${sec.id}-h`} class="places__col-label mono">{sec.label}</h3>
          <p class="places__col-sub">{sec.sub}</p>
        </header>
        <ul class="places__list">
          {sec.places.map((p) => (
            <li class="places__item">
              <a class="places__link" href={p.href}>
                <span class="places__link-marker mono" aria-hidden="true">·</span>
                <span class="places__link-name">{p.label}</span>
                {p.blurb && <span class="places__link-blurb">{p.blurb}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <p class="places__foot mono">
    missing a place? edit <code>src/components/HomePlacesDirectory.astro</code> ·
    deliberately hand-curated, not auto-generated from sitemap
  </p>
</section>

<style>
  .places {
    margin: 48px 0;
    padding: 28px;
    background: #fbf7ee;
    border: 1.5px solid #d8cdb8;
    border-radius: 3px;
  }

  .places__head { margin: 0 0 24px; }
  .places .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #c4952e;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .places__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0 0 10px;
    color: #1f1b15;
  }
  .places__dek {
    font-size: 14px;
    line-height: 1.55;
    color: #6a6154;
    max-width: 640px;
    margin: 0;
  }
  .places__dek a { color: #c4952e; text-decoration: none; border-bottom: 1px solid currentColor; }
  .places__dek a:hover { color: #1f1b15; }

  .places__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px 28px;
    margin: 0 0 24px;
  }

  .places__col-head {
    margin: 0 0 10px;
    padding: 0 0 6px;
    border-bottom: 1.5px solid #1f1b15;
  }
  .places__col-label {
    display: block;
    font-size: 12px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: #1f1b15;
    margin: 0 0 2px;
  }
  .places__col-sub {
    font-size: 11px;
    color: #6a6154;
    margin: 0;
    font-style: italic;
  }

  .places__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .places__item { margin: 0 0 6px; }
  .places__link {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 6px;
    align-items: baseline;
    padding: 1px 0;
    text-decoration: none;
    color: #1f1b15;
    line-height: 1.35;
  }
  .places__link-marker {
    color: #c4952e;
    font-size: 12px;
    line-height: 1;
  }
  .places__link-name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(196, 149, 46, 0.35);
    text-underline-offset: 2px;
  }
  .places__link:hover .places__link-name {
    color: #c4952e;
    text-decoration-color: currentColor;
  }
  .places__link-blurb {
    grid-column: 2;
    display: block;
    font-size: 11px;
    color: #6a6154;
    line-height: 1.35;
    margin-top: 1px;
  }
  .places__link:hover .places__link-blurb { color: #1f1b15; }

  .places__foot {
    font-size: 10px;
    color: #6a6154;
    letter-spacing: 0.06em;
    margin: 0;
    padding-top: 16px;
    border-top: 1px dashed #d8cdb8;
  }
  .places__foot code {
    background: rgba(0,0,0,0.06);
    padding: 1px 4px;
    border-radius: 2px;
    font-size: 10px;
  }

  @media (max-width: 600px) {
    .places { padding: 20px 18px; margin: 36px 0; }
    .places__grid { grid-template-columns: 1fr 1fr; gap: 14px 18px; }
  }
</style>
