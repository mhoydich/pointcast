// ─── Auto-discovery: glob src/pages/ at build time, diff against the
// curated href set, and surface anything new at the bottom in UNFILED.
// import.meta.glob enumerates path keys without bundling the modules.
const allPageFiles = import.meta.glob('/src/pages/**/*.{astro,md,ts}', { eager: false });

function fileToRoute(file: string): string | null {
  // Drop the prefix.
  let route = file.replace(/^\/src\/pages\//, '/');
  // Strip page suffixes. Order matters: .astro / .md fall away cleanly;
  // .ts is for endpoint files like agents.json.ts → /agents.json.
  route = route.replace(/\.(astro|md)$/, '');
  route = route.replace(/\.ts$/, '');
  // /foo/index → /foo. /index → /.
  route = route.replace(/\/index$/, '');
  if (!route) route = '/';
  return route;
}

// Build the curated href set (handles both flat sections and nested groups).
const curatedHrefs = new Set<string>();
for (const sec of SECTIONS) {
  if (sec.places) for (const p of sec.places) curatedHrefs.add(p.href);
  if (sec.groups) for (const g of sec.groups) for (const p of g.places) curatedHrefs.add(p.href);
}

const unfiledRoutes = Object.keys(allPageFiles)
  .map(fileToRoute)
  .filter((r): r is string => !!r)
  // Hide internal/operator/dynamic routes.
  .filter((r) => !r.includes('['))             // dynamic [slug], [id]
  .filter((r) => !r.startsWith('/admin'))      // operator-only
  .filter((r) => !r.startsWith('/api'))        // shouldn't be in src/pages, but defensive
  .filter((r) => !r.startsWith('/data/'))      // data fixtures, not browseable routes
  .filter((r) => r !== '/')                    // home itself
  .filter((r) => r !== '/404')                 // error route
  // Hide machine-readable endpoints (.json, .txt, .xml). If a JSON endpoint
  // is worth surfacing for agents, add it to AGENTS by hand — the per-page
  // .json companions (one per /foo) just bury the real new pages otherwise.
  .filter((r) => !/\.(json|txt|xml|rss)$/.test(r))
  // Exclude already-curated.
  .filter((r) => !curatedHrefs.has(r))
  // Stable order so ship diffs are readable.
  .sort();

const UNFILED_SECTION: Section | null = unfiledRoutes.length === 0 ? null : {
  id: 'unfiled',
  label: 'NEW · UNFILED',
  sub: 'auto-discovered routes',
  places: unfiledRoutes.map((r) => ({
    href: r,
    label: r.replace(/^\//, ''),
  })),
};

const RENDERED_SECTIONS: Section[] = UNFILED_SECTION
  ? [...SECTIONS, UNFILED_SECTION]
  : SECTIONS;

const totalLinks = RENDERED_SECTIONS.reduce(
  (n, s) => n + (s.places?.length ?? 0) + (s.groups?.reduce((m, g) => m + g.places.length, 0) ?? 0),
  0
);
---

<section class="places" aria-label="Places to visit">
  <header class="places__head">
    <p class="kicker mono">PLACES · {totalLinks} LINKS · {RENDERED_SECTIONS.length} CATEGORIES{unfiledRoutes.length > 0 ? ` · ${unfiledRoutes.length} UNFILED` : ''}</p>
    <h2 class="places__title">Map of the town.</h2>
    <p class="places__dek">
      Yahoo-style index of every public surface. The 14 categories below
      are hand-curated; anything new ships into the auto-discovered
      <strong>NEW · UNFILED</strong> section at the bottom until someone
      moves it into a proper category. Use the channel filters on
      <a href="/archive">/archive</a> for a denser block-level view, or
      the agent-readable <a href="/agents.json">/agents.json</a> for the
      full manifest.
    </p>
  </header>

  <div class="places__grid">
    {RENDERED_SECTIONS.map((sec) => (
      <section class={`places__col${sec.id === 'unfiled' ? ' places__col--unfiled' : ''}`} aria-labelledby={`places-${sec.id}-h`}>
        <header class="places__col-head">
          <h3 id={`places-${sec.id}-h`} class="places__col-label mono">{sec.label}</h3>
          <p class="places__col-sub">{sec.sub}</p>
        </header>

        {sec.places && (
          <ul class="places__list">
            {sec.places.map((p) => (
              <li class="places__item">
                <a class="places__link" href={p.href}>
                  <span class="places__link-marker mono" aria-hidden="true">·</span>
                  <span class="places__link-name">{p.label}</span>
                  {p.blurb && <span class="places__link-blurb">{p.blurb}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}

        {sec.groups && sec.groups.map((g) => (
          <div class="places__group">
            {g.sub && <p class="places__group-sub mono">{g.sub}</p>}
            <ul class="places__list">
              {g.places.map((p) => (
                <li class="places__item">
                  <a class="places__link" href={p.href}>
                    <span class="places__link-marker mono" aria-hidden="true">·</span>
                    <span class="places__link-name">{p.label}</span>
                    {p.blurb && <span class="places__link-blurb">{p.blurb}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>

  <p class="places__foot mono">
    new routes auto-land in <strong>NEW · UNFILED</strong> ·
    move them into a proper category by editing
    <code>src/components/HomePlacesDirectory.astro</code> ·
    14 hand-curated categories + 1 auto-discovered
  </p>
</section>

