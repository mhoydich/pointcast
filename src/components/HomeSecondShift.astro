---
import { SECOND_SHIFT_ORDERS } from '../lib/second-shift';
---

<section class="second-shift-lead" aria-labelledby="second-shift-home-title">
  <div class="second-shift-lead__flag">
    <span>NEW · BLOCK 0571 · CH.ESC</span>
    <span>EL SEGUNDO / NIGHT ORDER / PUBLIC GAME</span>
  </div>
  <div class="second-shift-lead__grid">
    <div class="second-shift-lead__copy">
      <p>02:17 · THE LAST TRUCK MISSED ITS WINDOW</p>
      <h2 id="second-shift-home-title">Make the <em>morning.</em></h2>
      <p class="second-shift-lead__dek">Six useful things. Seven minutes. Build a shop that no longer needs you to hold the button.</p>
      <div class="second-shift-lead__actions">
        <a href="/second-shift">Play on PointCast <span aria-hidden="true">↗</span></a>
        <a href="/second-shift.json">Open game JSON</a>
      </div>
      <p class="second-shift-lead__boundary">FINITE GAME · BROWSER-LOCAL PROGRESS · SIMULATED RECEIPT</p>
    </div>
    <a class="second-shift-lead__art" href="/second-shift" aria-label="Open Second Shift">
      <img src="/images/second-shift/social-card.png" alt="Second Shift industrial night-order game card" width="1200" height="630" loading="eager" />
      <span>ROLL UP THE DOOR ↑</span>
    </a>
  </div>
  <ol aria-label="Second Shift local orders">
    {SECOND_SHIFT_ORDERS.map((order, index) => (
      <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{order.name}</strong></li>
    ))}
  </ol>
</section>

<style>
  .second-shift-lead {
    --ss-night: #071f2a;
    --ss-paper: #f0eadb;
    --ss-electric: #d9ff38;
    --ss-orange: #ff7040;
    margin-top: 16px;
    border: 2px solid var(--ss-night);
    color: var(--ss-paper);
    background: var(--ss-night);
    box-shadow: 7px 7px 0 var(--ss-orange);
    overflow: hidden;
  }
  .second-shift-lead__flag {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 12px;
    border-bottom: 1px solid rgba(240,234,219,.32);
    font: 700 9px/1.2 var(--pc-font-mono);
    letter-spacing: .1em;
  }
  .second-shift-lead__flag span:first-child { color: var(--ss-electric); }
  .second-shift-lead__grid { display: grid; grid-template-columns: minmax(320px, .82fr) minmax(460px, 1.18fr); min-height: 510px; }
  .second-shift-lead__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 5vw, 66px); border-right: 1px solid rgba(240,234,219,.32); }
  .second-shift-lead__copy > p:first-child { margin: 0 0 18px; color: var(--ss-electric); font: 700 9px var(--pc-font-mono); letter-spacing: .13em; }
  .second-shift-lead h2 { margin: 0; font-size: clamp(62px, 8vw, 118px); font-weight: 730; line-height: .78; letter-spacing: -.075em; }
  .second-shift-lead h2 em { color: var(--ss-orange); font-style: normal; }
  .second-shift-lead__dek { max-width: 530px; margin: 30px 0 0; font-size: clamp(18px, 2vw, 25px); line-height: 1.3; }
  .second-shift-lead__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .second-shift-lead__actions a { padding: 12px 14px; border: 1px solid var(--ss-paper); color: var(--ss-paper); font: 700 9px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .second-shift-lead__actions a:first-child { border-color: var(--ss-electric); color: var(--ss-night); background: var(--ss-electric); }
  .second-shift-lead__actions a:hover { border-color: var(--ss-orange); color: var(--ss-night); background: var(--ss-orange); text-decoration: none; }
  .second-shift-lead__boundary { margin: 20px 0 0; color: rgba(240,234,219,.57); font: 8px var(--pc-font-mono); letter-spacing: .1em; }
  .second-shift-lead__art { position: relative; display: flex; align-items: center; min-width: 0; padding: clamp(16px, 3vw, 36px); color: var(--ss-night); background: #0d3442; }
  .second-shift-lead__art img { width: 100%; height: auto; border: 1px solid var(--ss-paper); box-shadow: 12px 12px 0 rgba(0,0,0,.3); }
  .second-shift-lead__art span { position: absolute; right: clamp(24px, 4vw, 50px); bottom: clamp(24px, 4vw, 50px); padding: 10px 12px; border: 1px solid var(--ss-night); background: var(--ss-electric); font: 800 9px var(--pc-font-mono); letter-spacing: .08em; }
  .second-shift-lead ol { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; padding: 0; border-top: 1px solid rgba(240,234,219,.32); list-style: none; }
  .second-shift-lead li { min-height: 66px; display: grid; align-content: center; gap: 4px; padding: 10px; border-right: 1px solid rgba(240,234,219,.18); }
  .second-shift-lead li:last-child { border-right: 0; }
  .second-shift-lead li span { color: var(--ss-orange); font: 700 8px var(--pc-font-mono); }
  .second-shift-lead li strong { font-size: 11px; line-height: 1.25; }
  @media (max-width: 880px) {
    .second-shift-lead__grid { grid-template-columns: 1fr; }
    .second-shift-lead__copy { border-right: 0; border-bottom: 1px solid rgba(240,234,219,.32); }
    .second-shift-lead ol { grid-template-columns: repeat(3, 1fr); }
    .second-shift-lead li:nth-child(3n) { border-right: 0; }
    .second-shift-lead li:nth-child(-n+3) { border-bottom: 1px solid rgba(240,234,219,.18); }
  }
  @media (max-width: 560px) {
    .second-shift-lead { box-shadow: 4px 4px 0 var(--ss-orange); }
    .second-shift-lead__flag { flex-direction: column; }
    .second-shift-lead__grid { min-height: 0; }
    .second-shift-lead__copy { padding: 34px 18px; }
    .second-shift-lead__art { padding: 14px; }
    .second-shift-lead__art span { right: 22px; bottom: 22px; }
    .second-shift-lead ol { grid-template-columns: repeat(2, 1fr); }
    .second-shift-lead li:nth-child(3n) { border-right: 1px solid rgba(240,234,219,.18); }
    .second-shift-lead li:nth-child(2n) { border-right: 0; }
    .second-shift-lead li:nth-child(-n+4) { border-bottom: 1px solid rgba(240,234,219,.18); }
  }
</style>
