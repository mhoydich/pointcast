---
import atlas from '../data/ues-coffee-atlas.json';
import economics from '../data/ues-coffee-economics.json';
import contracts from '../data/contracts.json';
import '../styles/pantry.css';
const {guide}=Astro.props;
const coffee=guide.slug==='coffee';
const places=coffee?atlas.records.map(r=>({name:r.name,area:r.area,kind:r.type,text:r.summary,url:r.sources?.[0]?.url||r.website,observed:atlas.editionDate,tags:r.tags})):guide.places;
const mugSlugs=['ceramic','espresso','latte','paper','bistro'];
const fields=coffee?[['price','Bag price · USD',18,0,0.01],['weight','Roasted bag weight · g',340,1,1],['dose','Dose per serving · g',18,.1,.1],['waste','Unused coffee · %',0,0,1],['shipping','Shipping per bag · USD',0,0,.01],['tax','Tax per bag · USD',0,0,.01],['equipment','Equipment cost · USD',0,0,.01],['lifetime','Equipment life · brews',500,1,1],['filter','Filter per brew · USD',.03,0,.01],['milk','Milk per brew · USD',0,0,.01],['waterEnergy','Water & energy per brew · USD',.02,0,.01]]:[['flourPrice','Flour package price · USD',5,0,.01],['flourWeight','Flour package weight · g',2268,1,1],['flourGrams','Flour used in batch · g',1000,0,1],['extras','Other ingredients · USD / batch',1,0,.01],['energy','Energy · USD / batch',1.5,0,.01],['minutes','Active labor · minutes / batch',40,0,1],['hourly','Active labor · USD / hour',20,0,.01],['loaves','Finished loaves per batch',2,1,1],['waste','Unusable yield · %',0,0,1]];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{guide.title} · PointCast field guide</title><meta name="description" content={guide.intro}/><link rel="canonical" href={`https://pointcast.xyz/${guide.slug}/`}/><meta name="theme-color" content="#333c31"/><meta property="og:title" content={`${guide.title} · PointCast`}/><meta property="og:description" content={guide.intro}/><meta property="og:image" content={`https://pointcast.xyz${guide.hero.src}`}/><link rel="alternate" type="application/json" href={`/${guide.slug}/guide.json`} title={`${guide.title} guide and sources`}/></head>
<body class:list={['pantry',guide.slug]} data-guide={guide.slug}>
<a class="skip" href="#main">Skip to the guide</a><header class="masthead"><a class="brand" href="/">POINTCAST<span>THE EVERYDAY DESK</span></a><nav aria-label="PointCast destinations"><a aria-current={coffee?'page':undefined} href="/coffee/">Coffee</a><a aria-current={!coffee?'page':undefined} href="/bread/">Bread</a><a href="/university-of-el-segundo/">UES ↗</a></nav></header><div class="edition"><span>FIELD GUIDE / {coffee?'01':'02'}</span><span>FIRST EDITION · OCTOBER 5, 2026</span></div>
<main id="main"><section class="hero" aria-labelledby="title"><div class="hero-copy"><p class="eyebrow">{guide.eyebrow}</p><h1 id="title">{guide.title}<span>.</span></h1><p class="headline">{guide.headline.split('\n').map(l=><span>{l}</span>)}</p><p class="intro">{guide.intro}</p><a class="button" href="#places">Begin in the neighborhood ↘</a></div><figure class="hero-photo"><img src={guide.hero.src} alt={guide.hero.alt} width={coffee?1048:2700} height={coffee?1400:1800} fetchpriority="high"/><figcaption>{coffee?'COFFEE CHERRIES · THE BEGINNING OF THE CUP':'FLOUR, GRAIN, LOAF · THE EVERYDAY TABLE'}<span>Archival photograph · credit below</span></figcaption></figure></section>
<nav class="section-nav" aria-label="Guide sections"><a href="#places">Neighborhood</a><a href="#prices">Price desk</a><a href="#gear">Gear</a><a href="#reading">Read & learn</a><a href="#calculator">Work the numbers</a><a href="#circle">Friends’ circle</a>{coffee&&<a href="#mugs">Mug collection</a>}<a href="#team">The team</a></nav><p class="lead wrap">{guide.lead}</p>
<section id="places" class="wrap section"><div class="section-heading"><p class="eyebrow">01 / NEIGHBORHOOD</p><h2>{guide.connectionTitle}</h2><p>{guide.connectionText}</p></div><div class="links-grid">{guide.connections.map(c=><a class="link-card" href={c.href}><span aria-hidden="true">↗</span><h3>{c.title}</h3><p>{c.text}</p></a>)}</div><div class="filterbar" data-filter="places"><label>Find a {coffee?'café or roaster':'baker'}<input type="search" data-query placeholder="Name, place or style"/></label><label>Area<select data-area><option value="">All areas</option>{[...new Set(places.map(p=>p.area))].map(a=><option>{a}</option>)}</select></label><label>Kind<select data-kind><option value="">All kinds</option>{[...new Set(places.map(p=>p.kind))].map(k=><option>{k}</option>)}</select></label></div><p class="count" data-count="places" role="status" aria-live="polite">{places.length} documented places</p><div class="places-grid">{places.map(p=><article class="place" data-row="places" data-area={p.area} data-kind={p.kind} data-search={[p.name,p.area,p.text,...(p.tags||[])].join(' ')}><p class="eyebrow">{p.area} / {p.kind}</p><h3>{p.name}</h3><p>{p.text}</p><p class="note">Source edition {p.observed}. Current hours, stock and accessibility unverified.</p>{p.url&&<a href={p.url}>Merchant source ↗</a>}</article>)}</div><p hidden data-empty="places" class="empty">No places match. Clear the search or choose another area.</p></section>
<section id="prices" class="price-section"><div class="wrap section"><div class="section-heading"><p class="eyebrow">02 / PRICE DESK</p><h2>First, compare the units.</h2><p>{guide.priceIntro}</p></div><div class="filterbar" data-filter="prices"><label>Find a price<input type="search" data-query placeholder="Product, seller or benchmark"/></label><label>Comparison<select data-kind><option value="">All comparisons</option>{[...new Set(guide.prices.map(p=>p.kind))].map(k=><option>{k}</option>)}</select></label></div><p class="count" data-count="prices" role="status" aria-live="polite">{guide.prices.length} dated observations</p><div class="price-grid">{guide.prices.map(p=><article class="price-card" data-row="prices" data-kind={p.kind} data-area={p.area||''} data-search={[p.title,p.seller,p.kind,p.detail].join(' ')}><p class="eyebrow">{p.kind}</p><h3>{p.title}</h3><p class="price">{p.display}</p><p class="unit">{p.unit}</p><p>{p.seller}</p><p class="note">{p.detail}</p><p class="note">{p.period&&<>Report period: {p.period}<br/></>}Observed {p.observed} · {p.status||'listed, availability unconfirmed'}</p><a href={p.url}>Source ↗</a></article>)}</div><p hidden data-empty="prices" class="empty">No observations match. Clear the search or choose another comparison.</p><p class="note">Dated listings do not establish checkout totals, local stock or merchant endorsement. Tax, shipping and additions are unknown unless specified.</p>{coffee&&<details class="source-detail"><summary>Keep the existing UES economic context</summary><div class="facts">{economics.facts.map(f=><article><h3>{f.title}</h3><strong>{f.display_value}</strong><p>{f.period} · original observation 2026-10-03</p><p>{f.limitations}</p><a href={f.url}>Original source ↗</a></article>)}</div><p>These existing figures retain their original report periods and review date. They are not freshly verified live readings.</p></details>}</div></section>
<section id="gear" class="wrap section"><div class="section-heading"><p class="eyebrow">03 / COUNTER SPACE</p><h2>Buy for the question<br/>you want to answer.</h2><p>Start with the method you will use, then compare upkeep, capacity and total cost. Source-based choices, with no claim of hands-on testing.</p></div><div class="gear-grid">{guide.gear.map(g=><article class="gear"><p class="eyebrow">{g.tier}</p><h3>{g.title}</h3>{g.price&&<p class="gear-price">{g.price}</p>}<p>{g.text}</p><p class="note">{g.source}</p><a href={g.url}>Product or learning source ↗</a></article>)}</div></section>
{!coffee&&<section class="wrap section" id="styles"><div class="section-heading"><p class="eyebrow">STYLE & INGREDIENTS</p><h2>Seven ways to read a loaf.</h2><p>A style is a starting question. Obtain ingredients and cross-contact information from the actual maker; the name alone is not an allergen guarantee.</p></div><div class="gear-grid">{guide.researchModels.style_cards.map(s=><article class="gear"><h3>{s.name}</h3><p>{s.look_for}</p><p>{s.learning}</p>{s.caution&&<p class="note">{s.caution}</p>}</article>)}</div></section>}
{coffee&&guide.kits&&<section class="wrap section" id="kits"><div class="section-heading"><p class="eyebrow">GEAR TOGETHER</p><h2>Five possible benches.</h2><p>Dated, derived gear subtotals from the source listings above. These are shopping comparisons, not seller bundles, recommendations based on testing or available checkout offers.</p></div><div class="gear-grid">{guide.kits.map(k=><article class="gear"><h3>{k.name}</h3><p class="gear-price">${k.subtotal.toFixed(2)} gear subtotal</p><p>{k.itemNames.join(' + ')}</p><p class="note">{k.notes}</p></article>)}</div></section>}
<section id="reading" class="reading-section"><div class="wrap section"><div class="section-heading"><p class="eyebrow">04 / READ & LEARN</p><h2>Ordinary things.<br/>Interesting systems.</h2><p>Source-grounded readings, practical questions and activities for curious people.</p></div><div class="contents">{guide.articles.map(a=><a href={`#${a.id}`}><span>{a.label}</span>{a.title}<b aria-hidden="true">↓</b></a>)}</div>{guide.feature&&<article class="feature"><p class="eyebrow">RESEARCH FEATURE / {guide.feature.author}</p><h3>{guide.feature.title}</h3>{guide.feature.sections.map(s=><section><h4>{s.heading}</h4>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}<div class="article-sources">{guide.feature.sources?.map(s=><a href={s.url}>{s.title} ↗</a>)}</div><p class="note">Prepared for this guide. No fabricated visits or tasting claims.</p></article>}{guide.articles.map(a=><article id={a.id} class="reading"><p class="eyebrow">{a.label}</p><h3>{a.title}</h3><p class="dek">{a.dek}</p>{a.paragraphs.map(p=><p>{p}</p>)}<div class="article-sources">{a.sources.map(s=><a href={s.url}>{s.title} ↗</a>)}</div></article>)}<div class="activity-grid">{guide.activities.map((a,i)=><article><span class="activity-number">0{i+1}</span><h3>{a.title}</h3><p>{a.text}</p></article>)}</div><aside class="safety"><h3>Make the activity safe.</h3><p>{guide.safety}</p>{!coffee&&<a href="https://www.fda.gov/consumers/consumer-updates/flour-raw-food-and-other-safety-facts">FDA flour safety ↗</a>}</aside></div></section>
<section id="calculator" class="wrap section"><div class="section-heading"><p class="eyebrow">05 / WORK THE NUMBERS</p><h2>{coffee?'What does your home cup cost?':'What goes into a loaf?'}</h2><p>Adjust a teaching scenario. Every default is invented, not a local quote. Inputs stay on this page and are never submitted or saved.</p></div><div class="calculator"><div role="group" data-calculator={guide.slug} aria-label={`${guide.title} cost scenario`}><div class="input-grid">{fields.map(([name,label,value,min,step])=><label>{label}<input name={name} type="number" value={value} min={min} max={name==='waste'?99:undefined} step={step} required/></label>)}</div><button type="button" data-reset class="button secondary">Reset assumptions</button></div><div class="results"><p class="eyebrow">YOUR SCENARIO</p><output data-cost aria-live="polite"></output><p class="note">{coffee?'Bean cost includes entered bag tax and shipping. Total adds entered equipment amortization, filters, milk, water and energy. Excludes labor, maintenance and any unentered costs. Fractional servings describe theoretical yield; whole servings round down.':'Cash includes entered flour, other ingredients and energy only. Labor adds entered active time. Excludes equipment, packaging, occupancy, selling fees, permits and tax. Yield adjusts for waste.'}</p><noscript><p>Enable JavaScript to calculate. All readings remain available.</p></noscript></div></div>{coffee&&<p class="further"><a href="/ues/coffee/#economics">Use the existing café business scenario at UES ↗</a></p>}</section>
<section id="circle" class="circle-section"><div class="wrap section"><div class="section-heading"><p class="eyebrow">06 / A FRIENDS’ CIRCLE · PROPOSAL</p><h2>{coffee?'One bag. A few friends.':'One bake. A few neighbors.'}</h2><p>A voluntary physical-delivery idea to discuss. No supplier agreement, orders, payment collection or checkout exists here.</p></div><ol class="circle-steps"><li><strong>Define the product</strong><span>Named maker, package or loaf, size, ingredients and allergen information.</span></li><li><strong>Compare the full quote</strong><span>Unit cost, delivery, coordination, deadline, cancellation, refunds and substitutions.</span></li><li><strong>Assign a human organizer</strong><span>Verify food handling, applicable rules, privacy and the supplier’s written terms.</span></li><li><strong>Review before a pilot</strong><span>Friends decide voluntarily; no automatic repeat orders, wallets or investment claims.</span></li></ol><div class="calculator group"><div role="group" data-calculator="group" aria-label="Physical group purchase teaching scenario"><div class="input-grid">{[['units','Identical physical units',10,1,1],['unitPrice','Quoted unit price · USD',coffee?16:7,0,.01],['shipping','Shared delivery · USD',15,0,.01],['coordination','Coordination cost · USD',0,0,.01],['retail','Retail per same unit · USD',coffee?18:8,0,.01]].map(([name,label,value,min,step])=><label>{label}<input name={name} type="number" value={value} min={min} step={step} required/></label>)}</div><button type="button" data-reset class="button secondary">Reset assumptions</button></div><div class="results"><p class="eyebrow">ILLUSTRATIVE, NOT A QUOTE</p><output data-group aria-live="polite"></output><p class="note">Assumes equal units and a complete shipment. Includes only entered costs; tax, loss, storage and refunds are unmodeled. Savings can be negative.</p></div></div><p class="note">Agents may prepare public comparisons for human review. No authority to purchase, collect orders or use a wallet is granted.</p></div></section>
{coffee&&<section id="mugs" class="wrap section"><div class="section-heading"><p class="eyebrow">07 / THE EXISTING MUG COLLECTION</p><h2>Small art. Specific provenance.</h2><p>The Coffee Mugs collection has source-declared Tezos provenance. A token is a collectible record; it does not promise a physical mug, coffee, delivery, copyright or financial return.</p></div><div class="mug-grid">{Object.entries(contracts.coffee_mugs.tokens).map(([id,name])=><a class="mug" href={`/token/coffee-mugs/${id}/`}><img src={`/images/coffee-mugs/${mugSlugs[Number(id)]}.svg`} alt={`Pixel artwork for ${name}`} width="160" height="160" loading="lazy"/><h3>{name}</h3><p>Token #{id} · declared cap {contracts.coffee_mugs.edition_caps[id]}</p><span>Existing token page ↗</span></a>)}</div><dl class="provenance"><div><dt>Art catalog</dt><dd>Five existing pixel-art designs linked to their PointCast token pages. Source metadata attributes the creator wallet tz2FjJhB1gb9Xc2qNB7QgFkdBZkGCCRMxdFw and states “No License / All Rights Reserved.” Display here does not grant reuse rights.</dd></div><div><dt>Token contract</dt><dd><a href={`https://tzkt.io/${contracts.coffee_mugs.mainnet}`}>{contracts.coffee_mugs.mainnet}</a><br/>PCMUG · source registry reports mainnet origination April 25, 2026.</dd></div><div><dt>Edition status</dt><dd>333 / 144 / 64 / 21 / 8 are declared caps, not minted counts. Current supply and remaining editions unverified.</dd></div><div><dt>Claim receipt</dt><dd>The legacy room has browser-local eligibility and banked receipt logic. A local receipt alone is not an on-chain token or a physical redemption right.</dd></div><div><dt>Live mint</dt><dd>Source defines mint_mug with caps and self-minting. Public indexer reads were rate-limited October 5. This guide has no wallet or mint control; current mint availability is unverified.</dd></div></dl><a class="button secondary" href="/coffee/room/">Open the existing coffee room ↗</a><p class="note">The original coffee room remains available. It may request a wallet action. This task has not connected a wallet, signed, minted or tested redemption.</p></section>}
<section id="team" class="wrap section"><div class="section-heading"><p class="eyebrow">{coffee?'08':'07'} / PEOPLE & AGENTS</p><h2>A desk to tend,<br/>together.</h2><p>Proposed participation scopes, not openings or approved internship terms. Compensation, supervision, eligibility, time commitment and program arrangements remain unresolved.</p></div><div class="roles-grid">{guide.roles.map(r=><article><span class="status">PROPOSED / NOT OPEN</span><h3>{r.title}</h3><p>{r.text}</p></article>)}</div><p class="note">A human editor would supervise evidence and decide what is published. Proposed interns would work within agreed learning and compensation terms. No applications are accepted here. PointCast hosts the guide, UES supports learning, and business-model work can inform IndustryNext. The shared opportunities catalog owns any future role listing.</p></section>
<section id="sources" class="sources-section"><div class="wrap section"><div class="section-heading"><p class="eyebrow">THE READING SHELF & EVIDENCE</p><h2>Keep the trail visible.</h2><p>Observation dates say when evidence was read, not when it remains available. Missing details stay missing.</p></div><div class="reading-links">{guide.readingLinks.map(l=><a href={l.href}>{l.title} ↗</a>)}</div><details class="source-detail"><summary>Open the source ledger ({guide.sources.length} records)</summary><ol>{guide.sources.map(s=><li><a href={s.url}>{s.title} ↗</a><p>{s.note}</p></li>)}</ol></details><details class="source-detail"><summary>Photograph credit and reuse terms</summary><p><a href={guide.hero.url}>{guide.hero.credit}</a> · <a href={guide.hero.licenseUrl}>{guide.hero.license}</a></p><p>{guide.hero.changes}</p></details><a href={`/${guide.slug}/guide.json`}>Structured guide & sources JSON ↗</a></div></section>
</main><footer class="wrap"><a class="brand" href="/">POINTCAST</a><p>{guide.title} · First field-guide draft · {guide.edition}<br/>Source-linked learning, local places and everyday economics.</p><a href="#title">Back to the beginning ↑</a></footer></body></html>
<script>
import {coffeeCost,breadCost,groupCost} from '../lib/pantry.mjs';
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n);
document.querySelectorAll<HTMLElement>('[data-calculator]').forEach(form=>{
 const output=form.closest('.calculator')?.querySelector('output');
 function update(){const values=Object.fromEntries(Array.from(form.querySelectorAll<HTMLInputElement>('input')).map(i=>[i.name,i.value.trim()===''?NaN:Number(i.value)]));const kind=form.dataset.calculator;const result=Array.from(form.querySelectorAll<HTMLInputElement>('input')).every(i=>i.checkValidity())?(kind==='coffee'?coffeeCost(values):kind==='bread'?breadCost(values):groupCost(values)):null;if(!output)return;if(!result){output.textContent='Enter valid non-negative inputs. Weights and yield must be positive; waste must be below 100%. Use whole numbers for loaves and group units.';return;}if(kind==='coffee')output.textContent=`${money(result.totalPerServing)} total entered cost per brew · ${money(result.perServing)} landed beans; ${money(result.equipmentPerServing)} equipment. ${result.servings.toFixed(1)} theoretical servings (${result.wholeServings} whole); retail beans ${money(result.per100g)} per 100 g.`;else if(kind==='bread')output.textContent=`${money(result.cashPerLoaf)} cash per usable loaf · ${money(result.fullPerLoaf)} including entered active labor. Batch cash ${money(result.cash)}; labor ${money(result.labor)}.`;else output.textContent=`${money(result.perUnit)} landed per unit · ${money(result.total)} total. ${result.savingPerUnit>=0?'Saving':'Extra cost'} versus entered retail: ${money(Math.abs(result.savingPerUnit))} per unit.`;}
 form.addEventListener('input',update);form.querySelector('[data-reset]')?.addEventListener('click',()=>{form.querySelectorAll<HTMLInputElement>('input').forEach(i=>i.value=i.defaultValue);update();});update();
});
const normalize=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
document.querySelectorAll<HTMLElement>('[data-filter]').forEach(bar=>{const key=bar.dataset.filter;const query=bar.querySelector<HTMLInputElement>('[data-query]');const area=bar.querySelector<HTMLSelectElement>('[data-area]');const kind=bar.querySelector<HTMLSelectElement>('[data-kind]');const rows=Array.from(document.querySelectorAll<HTMLElement>(`[data-row="${key}"]`));function filter(){let count=0;for(const row of rows){const show=(!query?.value||normalize(row.dataset.search||'').includes(normalize(query.value.trim())))&&(!area?.value||row.dataset.area===area.value)&&(!kind?.value||row.dataset.kind===kind.value);row.hidden=!show;if(show)count++;}const status=document.querySelector(`[data-count="${key}"]`);if(status)status.textContent=`${count} of ${rows.length} ${key==='places'?'documented places':'dated observations'}`;const empty=document.querySelector<HTMLElement>(`[data-empty="${key}"]`);if(empty)empty.hidden=count!==0;}bar.addEventListener('input',filter);bar.addEventListener('change',filter);filter();});
</script>
