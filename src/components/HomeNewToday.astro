---
import { isFresh, shortDay, type NewTodayItem } from '../lib/new-today.ts';
import { historyUrl } from '../lib/merged-today.mjs';
interface Props { items: NewTodayItem[] }
const now = new Date();
const fresh = Astro.props.items.filter(item => isFresh(item, now));
---
<section class="merged" id="new-today" data-merged-today aria-labelledby="new-today-title">
  <header>
    <h2 id="new-today-title">What’s new today</h2>
    <p>Pull requests merged into PointCast’s main branch.</p>
  </header>
  <p data-status role="status"></p>
  <ul data-merges hidden></ul>
  <a class="history" href={historyUrl}>View merge history on GitHub <span aria-hidden="true">↗</span></a>
  {fresh.length > 0 && (
    <details id="recent-launches">
      <summary>Recent launches · past seven Pacific calendar days</summary>
      <ul>{fresh.map(item => (
        <li data-new-cell data-date={item.date} data-until={item.until}>
          <a href={item.link}>{item.title}</a> <time datetime={item.date}>{shortDay(item.date)}</time>
          {item.block && <a href={`/b/${item.block}`}>Block {item.block}</a>}
        </li>
      ))}</ul>
    </details>
  )}
</section>
<script>
  import { asOf, dayKey, readMergedToday } from '../lib/merged-today.mjs';
  import { isFresh } from '../lib/new-today.ts';
  const root = document.querySelector<HTMLElement>('[data-merged-today]');
  if (root) {
    const list = root.querySelector<HTMLUListElement>('[data-merges]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    let checkedHour = -1;
    const details = root.querySelector<HTMLDetailsElement>('#recent-launches');
    const launchesLink = document.querySelector<HTMLAnchorElement>('[data-recent-launches]');
    let loading = false;
    function updateLaunches(now: Date) {
      if (!details) return;
      details.querySelectorAll<HTMLElement>('[data-new-cell]').forEach(cell => {
        cell.hidden = !isFresh({ date: cell.dataset.date ?? '', until: cell.dataset.until }, now);
      });
      details.hidden = !details.querySelector('[data-new-cell]:not([hidden])');
      if (launchesLink) {
        launchesLink.href = details.hidden ? '/archive' : '#recent-launches';
        const count = launchesLink.querySelector('strong');
        if (count) count.textContent = String(details.querySelectorAll('[data-new-cell]:not([hidden])').length);
      }
    }
    function openLaunches() {
      if (details && !details.hidden) details.open = true;
    }
    async function refresh() {
      const now = new Date(), day = dayKey(now);
      updateLaunches(now);
      const hour = Math.floor(now.getTime() / 3600000);
      if (loading || checkedHour === hour) return;
      loading = true;
      list.replaceChildren();
      list.hidden = true;
      status.textContent = 'Checking today’s merges…';
      try {
        const { items, complete } = await readMergedToday(now);
        if (dayKey(new Date()) !== day) return;
        for (const item of items) {
          const li = document.createElement('li'), a = document.createElement('a');
          a.href = item.href;
          a.textContent = item.title;
          const number = document.createElement('small');
          number.textContent = '#' + item.number;
          a.append(' ', number);
          li.append(a);
          list.append(li);
        }
        list.hidden = !items.length;
        const checked = asOf(now);
        status.textContent = items.length ? 'Checked ' + checked
          : complete ? 'No merges found as of ' + checked + '.'
          : 'No merges found in the checked pages as of ' + checked + '.';
        checkedHour = hour;
      } catch {
        status.textContent = 'Today’s merges are unavailable. You can check GitHub directly.';
      } finally {
        loading = false;
        if (dayKey(new Date()) !== day) void refresh();
      }
    }
    void refresh();
    if (location.hash === '#recent-launches') openLaunches();
    launchesLink?.addEventListener('click', openLaunches);
    // A tab can stay open overnight. Clear the old date on return or the next
    // hour boundary (Pacific midnight always falls on a UTC hour boundary).
    function nextHour() {
      window.setTimeout(() => { if (!document.hidden) void refresh(); nextHour(); }, 3600000 - Date.now() % 3600000 + 25);
    }
    nextHour();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) void refresh(); });
    window.addEventListener('hashchange', () => { if (location.hash === '#recent-launches') openLaunches(); });
  }
</script>
<style>
  .merged { padding: 1rem clamp(1rem, 4vw, 2rem); background: #fffdf7; color: #14201c; border-block: 2px solid #14201c; }
  .merged h2 { font-size: clamp(1.2rem, 3vw, 1.8rem); line-height: 1.15; margin: 0; }
  .merged p { margin: .3rem 0; font-size: .9rem; }
  .merged ul { padding: 0; margin: .4rem 0; list-style: none; }
  .merged :global([data-merges] li) { border-top: 1px solid #d6d8ca; }
  .merged :global(a), summary { color: #164634; overflow-wrap: anywhere; }
  .merged :global([data-merges] a), .history, summary { display: flex; align-items: center; justify-content: space-between; gap: .8rem; min-height: 44px; }
  .merged :global([data-merges] a) { font-weight: 650; }
  .merged :global(small) { font-variant-numeric: tabular-nums; font-weight: 400; white-space: nowrap; }
  .merged :global(a:focus-visible), summary:focus-visible { outline: 3px solid #176397; outline-offset: 2px; }
  .history { width: fit-content; }
  summary { cursor: pointer; display: list-item; align-content: center; }
  details { border-top: 1px solid #d6d8ca; }
  details a { display: inline-block; padding: .75rem 0; }
  time { margin: 0 .5rem; }
  [hidden] { display: none !important; }
</style>
