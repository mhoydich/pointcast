---
/**
 * HomeNewToday — a compact strip right under the Shortwave hero that names
 * what shipped in the last seven town days, one tap each, with the blocks that
 * filed it. Data: src/data/new-today.json through src/lib/new-today.ts; no ids
 * or copy live in this component.
 *
 * Renders nothing when nothing is fresh at build. On load the script checks
 * each cell again against the visitor's clock, so the strip ages out (and a
 * cell past its `until` drops) without waiting for the next deploy. While the
 * strip shows, the hero's "What's new in town" link lands here; once it hides,
 * the link goes back to the drop deck (#new).
 */
import { isFresh, shortDay, stripHeading, type NewTodayItem } from '../lib/new-today.ts';

interface Props { items: NewTodayItem[] }

const now = new Date();
const fresh = Astro.props.items.filter((item) => isFresh(item, now));
const newest = fresh.map((item) => item.date).sort().at(-1) ?? '';
const blocks = [...new Set(fresh.map((item) => item.block).filter((id): id is string => Boolean(id)))];
---

{fresh.length > 0 && (
  <section class="nt" id="new-today" data-new-today aria-labelledby="new-today-title">
    <div class="nt__head">
      <h2 id="new-today-title"><span class="nt__dot" aria-hidden="true"></span><span data-new-heading>{stripHeading(fresh.map((item) => item.date), now)}</span></h2>
      <p class="nt__meta">
        <time datetime={newest}>{shortDay(newest)}</time>
        {blocks.length > 0 && (
          <span class="nt__blocks">Blocks <span class="nt__ids">{blocks.map((id) => <a href={`/b/${id}`}>{id}</a>)}</span></span>
        )}
      </p>
    </div>
    <ol class="nt__cells">
      {fresh.map((item) => (
        <li data-new-cell data-date={item.date} data-until={item.until}>
          <a href={item.link}>
            <span class="nt__kicker">{item.kicker}</span>
            <span class="nt__title">{item.title}</span>
            <span class="nt__go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<script>
  import { isFresh, stripHeading } from '../lib/new-today.ts';

  function mount() {
    const root = document.querySelector<HTMLElement>('[data-new-today]');
    if (!root) return;
    const now = new Date();
    const shown: string[] = [];
    root.querySelectorAll<HTMLElement>('[data-new-cell]').forEach((cell) => {
      const date = cell.dataset.date ?? '';
      const fresh = isFresh({ date, until: cell.dataset.until }, now);
      cell.hidden = !fresh;
      if (fresh) shown.push(date);
    });
    root.hidden = shown.length === 0;
    document.querySelectorAll<HTMLAnchorElement>('a[data-swh-new]').forEach((link) => {
      link.setAttribute('href', root.hidden ? '#new' : '#new-today');
    });
    const heading = root.querySelector('[data-new-heading]');
    if (heading && shown.length) heading.textContent = stripHeading(shown, now);
  }

  mount();
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .nt { --nt-ink: #111; --nt-night: #14201c; --nt-glow: #ffb547; --nt-rule: rgba(0, 0, 0, .18);
    display: grid; grid-template-columns: 168px minmax(0, 1fr); margin-top: 16px; overflow: hidden;
    border: 2px solid var(--nt-ink); background: #fffdf7; box-shadow: 5px 5px 0 var(--nt-glow); color: var(--nt-ink); }
  .nt[hidden], .nt li[hidden] { display: none; }

  .nt__head { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 12px 14px; background: var(--nt-night); color: #f4eed9; }
  .nt h2 { display: flex; align-items: center; gap: 8px; margin: 0; font: 500 11px/1.2 var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--nt-glow); }
  .nt__dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: #e0452b; }
  .nt__meta { display: flex; flex-wrap: wrap; gap: 4px 10px; margin: 0; font: 500 9px/1.5 var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; color: #b9c2a8; }
  .nt__ids { white-space: nowrap; }
  .nt__blocks a { color: #ffe2b0; text-decoration: underline; text-underline-offset: 3px; }
  .nt__blocks a + a::before { content: '·'; display: inline-block; margin: 0 5px; color: #b9c2a8; text-decoration: none; }
  .nt__blocks a:hover { color: var(--nt-glow); }

  .nt__cells { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); margin: 0; padding: 0; list-style: none; }
  /* Dividers on every cell's right and bottom edge; the section clips the outer ones, so any count lays out clean. */
  .nt__cells li { min-width: 0; box-shadow: 1px 0 0 var(--nt-rule), 0 1px 0 var(--nt-rule); }
  .nt__cells a { position: relative; display: flex; flex-direction: column; gap: 5px; height: 100%; min-height: 68px; padding: 12px 30px 12px 14px; color: var(--nt-ink); text-decoration: none; }
  .nt__cells a:hover { background: #fff4dc; }
  .nt__cells a:hover .nt__title, .nt__cells a:hover .nt__go { color: #c2410c; }
  .nt__cells a:focus-visible { outline: 3px solid var(--nt-glow); outline-offset: -3px; }
  .nt__kicker { font: 500 9px/1.4 var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: #9a5a12; }
  .nt__title { font-size: 15px; font-weight: 500; line-height: 1.2; letter-spacing: -.02em; }
  .nt__go { position: absolute; right: 12px; bottom: 11px; font: 500 13px/1 var(--pc-font-mono); color: #5f5e5a; }

  @media (max-width: 760px) {
    .nt { grid-template-columns: 1fr; box-shadow: 4px 4px 0 var(--nt-glow); }
    .nt__head { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; padding: 9px 12px; }
    .nt__cells { grid-auto-flow: row; grid-template-columns: 1fr 1fr; }
    .nt__cells a { min-height: 64px; padding: 10px 26px 10px 12px; }
    .nt__title { font-size: 14px; }
    .nt__go { right: 10px; bottom: 10px; }
  }
</style>
