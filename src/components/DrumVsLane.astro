---
/**
 * <DrumVsLane /> — homepage strip pointing at /drum-vs.
 *
 * Per Mike 2026-04-30: 1v1 drum games for friends should surface from
 * the homepage so visitors see "oh I can challenge a friend" without
 * needing to dig into the Drum Press catalog.
 *
 * Compact card with:
 *   - Two Nouns facing off across a tiny rope/lane glyph
 *   - Tagline: "tap-vs-tap · room-scoped · WebRTC P2P"
 *   - Two CTAs: open a tug duel · open a race duel
 *
 * Distinct from <BirthdayLane /> (4 birthday surfaces) and
 * <DrumPressMarquee /> (catalog) — this one is purely about head-to-head.
 *
 * Self-contained: scoped CSS, no presence polling. The /drum-vs page
 * handles all live state. Strip is just the doorway.
 */
---

<aside class="dvl" aria-labelledby="dvl-title">
  <div class="dvl__head">
    <p class="dvl__kicker mono">★ DRUM HUB · 1v1 · SEND-A-LINK GAMES ★</p>
    <h2 class="dvl__title" id="dvl-title">
      tap <em>vs</em> tap
    </h2>
    <p class="dvl__strap mono">room-scoped · WebRTC peer-to-peer · sub-50ms when both phones are in</p>
  </div>

  <div class="dvl__board" aria-hidden="true">
    <div class="dvl__face dvl__face--p1">
      <img class="dvl__noun" src="https://noun.pics/156.svg" alt="" width="56" height="56" loading="lazy" />
      <span class="dvl__face-tag mono">P1</span>
    </div>
    <div class="dvl__rope">
      <span class="dvl__rope-line"></span>
      <span class="dvl__rope-mid">VS</span>
    </div>
    <div class="dvl__face dvl__face--p2">
      <img class="dvl__noun" src="https://noun.pics/805.svg" alt="" width="56" height="56" loading="lazy" />
      <span class="dvl__face-tag mono">P2</span>
    </div>
  </div>

  <div class="dvl__row">
    <a class="dvl__btn dvl__btn--magenta" href="/drum-vs">
      ▸ open a tug duel
      <span class="dvl__btn-sub mono">rope · first to 50</span>
    </a>
    <a class="dvl__btn" href="/drum-vs?mode=race">
      ▸ open a race duel
      <span class="dvl__btn-sub mono">side-by-side · sprint to 50</span>
    </a>
  </div>

  <p class="dvl__foot mono">
    no signup · the URL is the invite · share via iMessage / WhatsApp
  </p>
</aside>

<style>
  .dvl {
    --dvl-paper: #fff5d8;
    --dvl-deep: #f8e8c0;
    --dvl-ink: #11100c;
    --dvl-mute: #5b5347;
    --dvl-magenta: #d6346a;
    --dvl-yellow: #f0c431;
    --dvl-cyan: #3aa9c4;

    display: block;
    padding: 18px clamp(14px, 3vw, 24px);
    margin: 0 0 18px;
    background: var(--dvl-paper);
    border: 2px solid var(--dvl-ink);
    color: var(--dvl-ink);
    font-family: 'Iowan Old Style', 'Palatino', 'Times New Roman', Times, serif;
    line-height: 1.45;
    box-shadow: 5px 5px 0 0 var(--dvl-cyan), 10px 10px 0 0 var(--dvl-magenta);
  }
  .dvl .mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
  }

  .dvl__head { text-align: center; margin: 0 0 14px; }
  .dvl__kicker {
    font-size: 9px;
    letter-spacing: 0.28em;
    color: var(--dvl-magenta);
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .dvl__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    margin: 0 0 4px;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .dvl__title em { font-style: italic; color: var(--dvl-magenta); font-weight: 500; }
  .dvl__strap {
    font-size: 10px;
    color: var(--dvl-mute);
    margin: 0;
    letter-spacing: 0.14em;
    text-transform: lowercase;
  }

  /* Visual board: two nouns + a rope between them */
  .dvl__board {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    max-width: 520px;
    margin: 14px auto;
    padding: 10px 14px;
    background: #fffaef;
    border: 1.5px solid var(--dvl-ink);
  }
  .dvl__face {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .dvl__noun {
    width: 56px;
    height: 56px;
    border: 2px solid var(--dvl-ink);
    background: #fff;
    image-rendering: pixelated;
    border-radius: 4px;
  }
  .dvl__face-tag {
    font-size: 9px;
    letter-spacing: 0.22em;
    color: var(--dvl-mute);
    font-weight: 700;
  }
  .dvl__rope {
    position: relative;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dvl__rope-line {
    position: absolute;
    inset: 50% 0 auto 0;
    height: 6px;
    background: repeating-linear-gradient(
      90deg,
      var(--dvl-ink) 0 12px,
      var(--dvl-magenta) 12px 24px
    );
    border-radius: 3px;
    transform: translateY(-50%);
  }
  .dvl__rope-mid {
    position: relative;
    z-index: 1;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
    background: #fff;
    border: 2px solid var(--dvl-ink);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--dvl-ink);
  }

  /* CTA row */
  .dvl__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0 0 10px;
  }
  .dvl__btn {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: #fffaef;
    border: 2.5px solid var(--dvl-ink);
    color: var(--dvl-ink);
    text-decoration: none;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    box-shadow: 4px 4px 0 0 var(--dvl-ink);
    transition: transform 80ms, box-shadow 80ms, background 120ms;
  }
  .dvl__btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 0 var(--dvl-ink);
    text-decoration: none;
    background: #fff;
  }
  .dvl__btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 0 var(--dvl-ink);
  }
  .dvl__btn--magenta {
    background: var(--dvl-magenta);
    color: #fff5d8;
  }
  .dvl__btn--magenta:hover { background: var(--dvl-ink); color: #fff5d8; }
  .dvl__btn-sub {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    opacity: 0.75;
    font-weight: 500;
  }
  .dvl__btn--magenta .dvl__btn-sub { color: #fff5d8; }

  .dvl__foot {
    font-size: 10px;
    color: var(--dvl-mute);
    text-align: center;
    margin: 0;
    letter-spacing: 0.06em;
  }

  @media (max-width: 480px) {
    .dvl__row { grid-template-columns: 1fr; }
    .dvl { box-shadow: 4px 4px 0 0 var(--dvl-magenta); }
    .dvl__noun { width: 48px; height: 48px; }
    .dvl__board { padding: 8px 10px; gap: 8px; }
  }
</style>
