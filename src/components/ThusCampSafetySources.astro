---
interface Props { sources: { title: string; url: string }[]; reviewedAt: string; }
const { sources, reviewedAt } = Astro.props;
---
<details class="tc-section tc-sources">
  <summary>Safety references</summary>
  <p>Heat, lightning, water and food-safety guidance checked on <time datetime={reviewedAt}>{reviewedAt}</time>.</p>
  <ul>{sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}</ul>
</details>
<style>
  summary { cursor: pointer; font-weight: 600; min-height: 44px; }
  summary:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  p, li { font-size: 14px; line-height: 1.6; }
  li + li { margin-top: 8px; }
</style>
