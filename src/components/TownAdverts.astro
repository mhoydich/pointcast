---
/**
 * <TownAdverts /> — the back-pages advertising section.
 *
 * Per Mike 2026-07-19: "make sure there are like ads on the home page
 * for bell and sound and last tag."
 *
 * Two quarter-page house ads and one art-led house signal in the
 * old-newspaper tradition, under a centered — ADVERTISEMENT — rule the
 * way the classifieds always ran.
 * Left: Bell & Signal, the sound foundry (ink and gold, engraved-
 * catalog voice). Right: Last Tag, the playground game (chase-poster
 * voice, tag-yellow). Below: Allworthy Nine Lives, a view-only Tezos
 * distribution experiment (field-poster voice, cobalt and persimmon).
 * All three are self-contained: scoped CSS, no polling, just doorways.
 */
---

<aside class="ads" aria-label="Town advertisements">
  <p class="ads__rule mono"><span>— ADVERTISEMENT —</span></p>

  <div class="ads__row">
    <a class="ad ad--bell" href="/bell-and-signal">
      <span class="ad__glyph" aria-hidden="true">
        <svg viewBox="0 0 48 52" width="34" height="37">
          <g class="ad__bellswing">
            <path d="M 10 38 Q 8 14 20 5 Q 24 2 28 5 Q 40 14 38 38 L 43 38 L 43 43 L 5 43 L 5 38 Z" fill="#c4a35a"/>
            <circle cx="24" cy="47" r="4" fill="#ffd76a"/>
          </g>
        </svg>
      </span>
      <span class="ad__body">
        <span class="ad__kicker mono">BELL &amp; SIGNAL · A SMALL SOUND FOUNDRY</span>
        <span class="ad__line">Seventeen castings. <em>No samples.</em></span>
        <span class="ad__sub">Bells voiced like real towers — hum, prime, tierce. Polite signals for honest machines. All CC0.</span>
      </span>
      <span class="ad__cta mono">visit the foundry →</span>
    </a>

    <a class="ad ad--tag" href="/last-tag">
      <span class="ad__glyph ad__glyph--tag" aria-hidden="true">IT</span>
      <span class="ad__body">
        <span class="ad__kicker mono">AT THE PLAYGROUND · SIX RUNNERS · ONE CLOCK</span>
        <span class="ad__line">Don't be it <em>at zero.</em></span>
        <span class="ad__sub">Pass the tag. Spend your dash wisely. The yard is shrinking and the clock does not care.</span>
      </span>
      <span class="ad__cta mono">play last tag →</span>
    </a>

    <a
      class="ad ad--nine"
      href="https://allworthy.xyz/nine-lives?utm_source=pointcast&amp;utm_medium=house-ad&amp;utm_campaign=nine-lives"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="ad__art">
        <img
          src="https://allworthy.xyz/nine-lives-og.png"
          alt=""
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
        />
      </span>
      <span class="ad__body">
        <span class="ad__kicker mono">HOUSE SIGNAL · ALLWORTHY</span>
        <span class="ad__line">One tez. Nine doors. <em>One giant kitty.</em></span>
        <span class="ad__sub">A view-only Tezos distribution experiment. One demo tez opens nine fictional peer doors while a simulated reservoir sends a 5% Weekly Purr.</span>
      </span>
      <span class="ad__boundary mono">VIEW ONLY · NO WALLET · NO FUNDS MOVE</span>
      <span class="ad__cta mono">enter nine lives →</span>
      <span class="sr-only">Opens Allworthy Nine Lives in a new tab.</span>
    </a>
  </div>
</aside>

<style>
  .ads { margin: 0 0 18px; }
  .ads .mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
  }

  .ads__rule {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 8px;
    font-size: 8px;
    letter-spacing: 0.34em;
    color: #8a8177;
    text-transform: uppercase;
  }
  .ads__rule::before,
  .ads__rule::after {
    content: '';
    flex: 1;
    border-top: 1px solid #d8d0c2;
  }

  .ads__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .ad {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    gap: 6px 14px;
    align-items: center;
    padding: 14px 16px 12px;
    border: 1.5px solid #1a1610;
    text-decoration: none;
    min-width: 0;
    transition: transform 100ms ease, box-shadow 120ms ease;
  }
  .ad:hover { text-decoration: none; transform: translateY(-1px); }
  .ad:focus-visible { outline: 3px solid #1647cf; outline-offset: 3px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ad__glyph { grid-row: 1 / 3; display: grid; place-items: center; }
  .ad__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ad__kicker { font-size: 8px; letter-spacing: 0.26em; text-transform: uppercase; font-weight: 600; }
  .ad__line {
    font-family: 'Iowan Old Style', 'Palatino', 'Times New Roman', Times, serif;
    font-size: clamp(17px, 2vw, 22px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .ad__line em { font-style: italic; font-weight: 500; }
  .ad__sub {
    font-family: 'Iowan Old Style', 'Palatino', 'Times New Roman', Times, serif;
    font-size: 11.5px;
    line-height: 1.4;
  }
  .ad__cta {
    grid-column: 2;
    justify-self: start;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 5px 9px;
    border: 1.25px solid currentColor;
    transition: background 120ms, color 120ms;
  }

  /* Bell & Signal — ink and gold, the engraved catalog */
  .ad--bell {
    background: #14121f;
    color: #f2ead9;
    box-shadow: 4px 4px 0 0 rgba(196, 163, 90, 0.25);
  }
  .ad--bell .ad__kicker { color: #c4a35a; }
  .ad--bell .ad__line em { color: #ffd76a; }
  .ad--bell .ad__sub { color: rgba(242, 234, 217, 0.72); }
  .ad--bell .ad__cta { color: #ffd76a; }
  .ad--bell:hover .ad__cta { background: #ffd76a; color: #14121f; }
  .ad__bellswing { transform-origin: 24px 3px; animation: ad-swing 3.2s ease-in-out infinite; }
  @keyframes ad-swing {
    0%, 100% { transform: rotate(-9deg); }
    50% { transform: rotate(9deg); }
  }
  @media (prefers-reduced-motion: reduce) { .ad__bellswing { animation: none; } }

  /* Last Tag — chase poster, tag yellow */
  .ad--tag {
    background: #ffdd33;
    color: #14110a;
    box-shadow: 4px 4px 0 0 rgba(20, 17, 10, 0.2);
  }
  .ad--tag .ad__kicker { color: #a33409; }
  .ad--tag .ad__line em { color: #c4351c; }
  .ad--tag .ad__sub { color: rgba(20, 17, 10, 0.72); }
  .ad--tag .ad__cta { color: #14110a; }
  .ad--tag:hover .ad__cta { background: #14110a; color: #ffdd33; }
  .ad__glyph--tag {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #c4351c;
    color: #ffdd33;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    animation: ad-tag-pulse 1.6s ease-in-out infinite;
  }
  @keyframes ad-tag-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }
  @media (prefers-reduced-motion: reduce) { .ad__glyph--tag { animation: none; } }

  /* Nine Lives — field poster, cobalt and persimmon */
  .ad--nine {
    grid-column: 1 / -1;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: auto 1fr auto;
    gap: 0;
    padding: 0;
    overflow: hidden;
    border-color: #11120f;
    background: #f4eedf;
    color: #11120f;
    box-shadow: 4px 4px 0 0 rgba(22, 71, 207, 0.28);
  }
  .ad--nine:hover { box-shadow: 7px 7px 0 0 rgba(22, 71, 207, 0.34); }
  .ad--nine .ad__art {
    grid-row: 1 / 4;
    min-height: 210px;
    display: block;
    overflow: hidden;
    border-right: 1.5px solid #11120f;
    background: #1647cf;
  }
  .ad--nine .ad__art img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .ad--nine .ad__body {
    gap: 9px;
    padding: 24px 24px 10px;
  }
  .ad--nine .ad__kicker { color: #b8321c; }
  .ad--nine .ad__line {
    max-width: 15ch;
    font-size: clamp(27px, 3.7vw, 48px);
    line-height: 0.94;
    letter-spacing: -0.04em;
  }
  .ad--nine .ad__line em { color: #d94727; }
  .ad--nine .ad__sub {
    max-width: 60ch;
    color: rgba(17, 18, 15, 0.72);
    font-size: 12.5px;
  }
  .ad--nine .ad__boundary {
    grid-column: 2;
    margin: 2px 24px 14px;
    padding-top: 9px;
    border-top: 1px solid rgba(17, 18, 15, 0.24);
    color: #1647cf;
    font-size: 8px;
    letter-spacing: 0.16em;
  }
  .ad--nine .ad__cta {
    margin: 0 24px 22px;
    color: #f4eedf;
    border-color: #11120f;
    background: #11120f;
  }
  .ad--nine:hover .ad__cta { color: #11120f; background: #bfd500; }

  @media (max-width: 720px) {
    .ads__row { grid-template-columns: 1fr; }
    .ad--nine {
      grid-column: auto;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .ad--nine .ad__art {
      grid-column: 1;
      grid-row: auto;
      min-height: 0;
      aspect-ratio: 1200 / 630;
      border-right: 0;
      border-bottom: 1.5px solid #11120f;
    }
    .ad--nine .ad__body,
    .ad--nine .ad__boundary,
    .ad--nine .ad__cta { grid-column: 1; }
    .ad--nine .ad__line { max-width: 13ch; }
  }
</style>
