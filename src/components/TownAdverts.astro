---
import AdSlot from './AdSlot.astro';
---

<aside class="town-ads" aria-label="Town advertisements">
  <div class="town-ads__heading">
    <p>— POINTCAST AD NETWORK · HOUSE ROTATION —</p>
    <a href="/ad-network">How these ads work →</a>
  </div>

  <div class="town-ads__grid">
    <AdSlot
      format="medium-rectangle"
      placement="home-town-left"
      fallbackCampaignId="bell-and-signal-001"
    />
    <AdSlot
      format="medium-rectangle"
      placement="home-town-right"
      fallbackCampaignId="last-tag-001"
    />
    <AdSlot
      format="leaderboard"
      placement="home-town-wide"
      fallbackCampaignId="nine-lives-001"
      stackOnMobile
    />
  </div>
</aside>

<style>
  .town-ads { margin: 0 0 18px; }
  .town-ads__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    border-bottom: 1px solid #d8d0c2;
    color: #70685e;
    font: 700 8px/1.4 var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .town-ads__heading p { margin: 0 0 7px; }
  .town-ads__heading a { margin: 0 0 7px; color: inherit; letter-spacing: .08em; }
  .town-ads__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 300px));
    justify-content: center;
    gap: 16px;
  }
  .town-ads__grid > :global(.pc-ad-slot--leaderboard) { grid-column: 1 / -1; justify-self: center; }
  @media (max-width: 680px) {
    .town-ads__heading { align-items: flex-start; flex-direction: column; gap: 0; }
    .town-ads__grid { grid-template-columns: minmax(0, 300px); }
    .town-ads__grid > :global(.pc-ad-slot--leaderboard) { grid-column: 1; }
  }
</style>
