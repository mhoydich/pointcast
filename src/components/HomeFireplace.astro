<section class="home-fireplace" id="home-fireplace" aria-label="Home fireplace">
  <div class="home-fireplace__panel">
    <p class="home-fireplace__kicker">HOME FIREPLACE</p>
    <h2>Warm front door.</h2>
    <p>
      PointCast is a stack of live rooms, featured routes, and archive signals.
      Start with the app shell, the now view, or the drum room.
    </p>
    <div class="home-fireplace__links">
      <a href="/app">/app</a>
      <a href="/now">/now</a>
      <a href="/drum">/drum</a>
      <a href="/for-agents">/for-agents</a>
    </div>
  </div>
</section>

<style>
  .home-fireplace {
    margin: 24px 0;
    padding: 18px;
    background: linear-gradient(180deg, #f7efe4 0%, #efe2ce 100%);
    border: 1px solid #e1d1bd;
    border-radius: 8px;
  }
  .home-fireplace__panel {
    display: grid;
    gap: 10px;
    max-width: 62ch;
  }
  .home-fireplace__kicker {
    margin: 0;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a2432;
  }
  .home-fireplace h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 0.95;
  }
  .home-fireplace p {
    margin: 0;
    color: #5f5e5a;
    line-height: 1.55;
  }
  .home-fireplace__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .home-fireplace__links a {
    color: #8a2432;
    text-decoration: none;
  }
</style>
