---
/**
 * DockBurstTicker keeps burst copy + dock analytics out of FooterBar's large
 * inline script. Astro bundles this script, so Phase 1 does not add inline JS
 * bytes to the persistent dock.
 */
---

<p class="fb-burst" data-pc-ref="fb-burst" role="status" aria-live="polite" hidden></p>


<style>
  .fb-burst {
    position: fixed;
    right: 8px;
    bottom: 46px;
    z-index: 41;
    max-width: min(520px, calc(100vw - 16px));
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--pc-ink, #12110e), transparent 55%);
    background: rgba(253, 246, 226, .96);
    color: var(--pc-ink, #12110e);
    padding: 5px 8px;
    font: 400 10px/1.35 var(--pc-font-mono, monospace);
    letter-spacing: .035em;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 180ms ease, transform 180ms ease;
    pointer-events: none;
  }
  .fb-burst[data-show='true'] { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .fb-burst { transition: none; } }
</style>
