---
/**
 * NowHero — THE PICKLEBALL BOARD's one channel-colored card: the best bet and
 * why (build spec §9 item 2, Fable design §2 item 2).
 *
 * Static at build time (rule 5: no editor guess, so the shell says only that
 * it's checking). src/scripts/pickleball-board.ts fills the line from
 * GET /api/air/board's `best: {court, reason, line} | null` and links into
 * that court's card. `reason` ('live'|'dropin'|'open'|'next') only changes
 * the small kicker word; the hero never shows a bucket the API didn't send.
 */
---

<section class="pb-hero" data-pb-hero data-pb-hero-reason="">
  <p class="pb-hero__kicker air-mono">
    <span>NOW</span>
    <span class="pb-hero__reason" data-pb-hero-reason-label hidden></span>
  </p>
  <p class="pb-hero__line" data-pb-hero-line>Checking the board…</p>
  <p class="pb-hero__prov air-mono" data-pb-hero-prov hidden></p>
  <a class="pb-hero__link" data-pb-hero-link href="#" hidden>See this court <span aria-hidden="true">→</span></a>
</section>

<style>
  /* `.pb-hero__link` sets display, which would beat the browser's own [hidden]. */
  [hidden] { display: none !important; }
  .pb-hero { --pb-channel: #3B6D11; margin: 0 0 18px; padding: 18px 16px; border: 2px solid var(--pc-ink); background: var(--pc-bg); }
  .pb-hero[data-pb-hero-reason]:not([data-pb-hero-reason=""]) { border-color: var(--pb-channel); }
  .pb-hero__kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 8px; color: var(--pc-ink-muted); }
  .pb-hero__reason { color: var(--pb-channel); }
  .pb-hero__line { margin: 0; font: 600 24px/1.32 var(--pc-font-sans); letter-spacing: -.01em; color: var(--pc-ink); overflow-wrap: anywhere; }
  .pb-hero__prov { margin: 8px 0 0; color: var(--pc-ink-muted); }
  .pb-hero__link { display: inline-block; margin-top: 12px; color: var(--pc-accent); font-size: 14px; font-weight: 600; text-decoration: none; }
  .pb-hero__link:hover { text-decoration: underline; }

  @media (max-width: 380px) { .pb-hero__line { font-size: 21px; line-height: 1.3; } }
</style>
