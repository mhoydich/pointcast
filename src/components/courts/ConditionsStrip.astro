---
/**
 * ConditionsStrip — KLAX wind/temp/marine-layer/sunset/next-3h, one line of
 * mono, horizontal scroll at 375px (build spec §9 item 3, §8; Fable design
 * §2 item 3). Every field may be null (a feed down still answers 200), so
 * the shell renders dashes and src/scripts/pickleball-board.ts fills only
 * what GET /api/air/board's `conditions` actually sent — never a guess.
 */
---

<div class="pb-cond" data-pb-conditions aria-label="Conditions at KLAX">
  <p class="pb-cond__label air-mono">KLAX</p>
  <div class="pb-cond__row air-mono" role="list">
    <span role="listitem" data-pb-cond-wind>WIND —</span>
    <span role="listitem" data-pb-cond-temp>— °F</span>
    <span role="listitem" data-pb-cond-marine hidden></span>
    <span role="listitem" data-pb-cond-sunset>SUNSET —</span>
    <span role="listitem" data-pb-cond-next3h hidden></span>
  </div>
  <p class="pb-cond__words" data-pb-cond-words hidden></p>
</div>

<style>
  [hidden] { display: none !important; }
  .pb-cond { margin: 0 0 18px; padding: 10px 0; border-top: 1px solid var(--pc-rule); border-bottom: 1px solid var(--pc-rule); }
  .pb-cond__label { margin: 0 0 6px; color: var(--pc-ink-muted); }
  .pb-cond__row { display: flex; gap: 16px; overflow-x: auto; white-space: nowrap; color: var(--pc-ink); -webkit-overflow-scrolling: touch; }
  .pb-cond__row::-webkit-scrollbar { display: none; }
  .pb-cond__words { margin: 8px 0 0; font-size: 13px; line-height: 1.4; color: var(--pc-ink-soft); white-space: normal; }
</style>
