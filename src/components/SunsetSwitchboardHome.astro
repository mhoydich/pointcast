---
import card from '../assets/sunset-switchboard/og.png';
---

<section class="sunset-home" aria-labelledby="sunset-home-title">
  <a class="sunset-home__image" href="/sunset-switchboard" aria-label="Open Sunset Switchboard">
    <img src={card.src} width={card.width} height={card.height} alt="Geometric signal tower broadcasting over a fluorescent coastal sunset" />
  </a>
  <div class="sunset-home__copy">
    <p class="sunset-home__eyebrow">NEW PUBLIC INSTRUMENT · CH.ESC · № 0487</p>
    <h2 id="sunset-home-title">Route one good signal before dark.</h2>
    <p>Tune the sky, choose a band, set the reach, and let the tower compose a small broadcast for the city.</p>
    <a class="sunset-home__cta" href="/sunset-switchboard">
      <span>OPEN THE SWITCHBOARD</span>
      <small>NO ACCOUNT · LOCAL LOG · SAVE A CARD ↗</small>
    </a>
  </div>
</section>

<style>
  .sunset-home {
    --sunset-ink: #080a16;
    --sunset-paper: #f3eee1;
    --sunset-signal: #dfff00;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr);
    min-height: min(720px, calc(100svh - 46px));
    border-block: 1px solid #080a16;
    color: var(--sunset-paper);
    background: #271954;
  }
  .sunset-home__image { min-height: 520px; display: block; overflow: hidden; background: #271954; }
  .sunset-home__image img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 56% center; transition: transform 700ms cubic-bezier(.2,.8,.2,1); }
  .sunset-home__image:hover img { transform: scale(1.025); }
  .sunset-home__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(32px,5vw,76px); border-left: 1px solid rgba(243,238,225,.35); background: radial-gradient(circle at 100% 0%, rgba(223,255,0,.14), transparent 36%), #271954; }
  .sunset-home__eyebrow { margin: 0 0 24px; color: var(--sunset-signal); font: 700 10px/1 var(--pc-font-mono); letter-spacing: .09em; }
  .sunset-home h2 { max-width: 630px; margin: 0; font-size: clamp(52px,6.6vw,104px); line-height: .85; letter-spacing: -.075em; font-weight: 650; }
  .sunset-home__copy > p:not(.sunset-home__eyebrow) { max-width: 520px; margin: 34px 0; color: rgba(243,238,225,.76); font-size: clamp(16px,1.7vw,22px); line-height: 1.42; }
  .sunset-home__cta { display: flex; flex-direction: column; gap: 10px; align-self: flex-start; padding: 17px 20px; color: var(--sunset-ink); background: var(--sunset-signal); border: 1px solid var(--sunset-signal); text-decoration: none; }
  .sunset-home__cta span { font: 800 15px/1 var(--pc-font-mono); letter-spacing: .05em; }
  .sunset-home__cta small { font: 700 8px/1 var(--pc-font-mono); letter-spacing: .08em; }
  .sunset-home__cta:hover { color: var(--sunset-paper); background: transparent; text-decoration: none; }
  @media (max-width: 800px) {
    .sunset-home { grid-template-columns: 1fr; min-height: 0; }
    .sunset-home__image { min-height: min(72svh,600px); }
    .sunset-home__copy { min-height: 620px; border-left: 0; border-top: 1px solid rgba(243,238,225,.35); padding: 48px 22px; }
    .sunset-home h2 { font-size: clamp(54px,15vw,88px); }
  }
</style>
