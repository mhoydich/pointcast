---
/**
 * PageviewBeacon — one path-only event per page load to /api/analytics.
 * Sends { event: 'pageview', meta: { path } } and nothing else: no referrer,
 * no user-agent, no wallet, no id. The endpoint keeps events 90 days.
 * Purpose: give every room a real USE number for the project scoreboard
 * (scripts/score-projects.mjs). Skips obvious bots and localhost.
 *
 * History: shipped 2026-08-17, pulled 2026-08-21 because every pageview was a KV write, and
 * the endpoint was then made cheap on 2026-09-02 (#1012: sampled 1-in-10, batched per isolate
 * every ten seconds). It was never mounted again until 2026-09-21. `data-astro-rerun` makes it
 * fire on view-transition navigations too, not only on the first page of a visit.
 *
 * It also fills any [data-page-views] slot with the open estimate from /api/views (one cached read).
 */
---
<script is:inline data-astro-rerun>
  (function () {
    try {
      if (!location.hostname.endsWith('pointcast.xyz')) return;
      if (navigator.webdriver || /bot|crawl|spider|slurp|headless|lighthouse/i.test(navigator.userAgent)) return;
      var path = location.pathname.replace(/\/+$/, '') || '/';
      var body = JSON.stringify({ event: 'pageview', meta: { path: path.slice(0, 120) } });
      if (navigator.sendBeacon) navigator.sendBeacon('/api/analytics', new Blob([body], { type: 'application/json' }));
      else fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true }).catch(function () {});
      var slots = document.querySelectorAll('[data-page-views]');
      if (slots.length && window.fetch) {
        fetch('/api/views?path=' + encodeURIComponent(path)).then(function (r) { return r.json(); }).then(function (d) {
          if (!d || d.status !== 'ok' || typeof d.views !== 'number' || d.views < 1) return;
          var text = '· about ' + d.views + (d.views === 1 ? ' view' : ' views') + ' of this page this week';
          slots.forEach(function (el) { el.textContent = text; el.hidden = false; });
        }).catch(function () {});
      }
    } catch (e) {}
  })();
</script>
