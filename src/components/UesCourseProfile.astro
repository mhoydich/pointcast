---
const { courseCode = null, coursePath = '/me' } = Astro.props;
const authHref = `/auth?returnTo=${encodeURIComponent(coursePath)}`;
---
<section class="ues-profile" data-ues-profile data-course={courseCode ?? ''} aria-label="Private UES course profile">
  <h3>{courseCode ? 'Optional account copy' : 'Your UES courses'}</h3>
  <p>Keep a private copy of a course checklist in your PointCast account. Only the course code, completion choices and dates are saved. Coursework and receipts stay with you. Each save is your choice.</p>
  <p>Checklists are self-attested. They are not grades, academic credit, verified qualifications or voting rights.</p>
  <p data-ues-profile-status role="status">{courseCode ? 'Nothing from this checklist is sent to your account until you choose Save.' : 'Load the course checklists you chose to save to this account.'}</p>
  <div class="ues-profile__actions">
    <button type="button" data-ues-profile-load>Check private profile</button>
    {courseCode && <>
      <button type="button" data-ues-profile-save hidden>Save this checklist to account</button>
      <button type="button" data-ues-profile-restore hidden>Use the saved checklist here</button>
      <button type="button" data-ues-profile-remove hidden>Remove account copy</button>
    </>}
    <a href={authHref}>Sign in or manage account</a>
    {courseCode && <a href="/me">View saved courses</a>}
  </div>
  {!courseCode && <ul data-ues-profile-list></ul>}
</section>
<script>
  import { mountProfileShelf } from '../scripts/ues-course-profile.mjs';
  const mount = () => document.querySelectorAll<HTMLElement>('[data-ues-profile][data-course=""]').forEach(root => mountProfileShelf(root));
  mount();
  document.addEventListener('astro:page-load', mount);
</script>
<style>
  .ues-profile { margin-block: 24px; padding: clamp(16px, 3vw, 28px); border: 1px solid #677369; background: #f4f2e9; color: #17241c; }
  .ues-profile h3 { margin: 0 0 12px; font-size: 24px; }
  .ues-profile p, .ues-profile :global(li) { max-width: 70ch; font-size: 14px; line-height: 1.6; }
  .ues-profile__actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .ues-profile :global(button) { min-height: 44px; padding: 10px 14px; font: inherit; border: 1px solid #17241c; background: #17241c; color: #fff; cursor: pointer; }
  .ues-profile :global(a) { color: #174a82; text-decoration: underline; }
  .ues-profile :global(li) { margin-block: 16px; }
  .ues-profile :global(li button) { margin-inline-start: 12px; }
  .ues-profile :global(:is(a, button):focus-visible) { outline: 3px solid #174a82; outline-offset: 3px; }
  .ues-profile :global(button:disabled) { opacity: .6; cursor: wait; }
  .ues-profile [hidden] { display: none !important; }
  @media print { .ues-profile { display: none; } }
</style>
