---
import { Image } from 'astro:assets';
import { JULY22_DECK_WORKS } from '../../lib/todays-art-july22';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['poster-deck', compact && 'poster-deck--compact']} data-poster-deck tabindex="0" aria-label="Interactive poster rack. Use left and right arrow keys to rotate the selection.">
  <div class="poster-deck__stage" aria-live="polite">
    {JULY22_DECK_WORKS.map((work, index) => (
      <button
        class="poster-deck__card"
        type="button"
        data-poster-card
        data-index={index}
        data-title={work.title}
        data-room={work.room}
        style={`--offset:${index === 0 ? 0 : index <= 3 ? index : index - JULY22_DECK_WORKS.length};--abs:${index <= 3 ? index : JULY22_DECK_WORKS.length - index};--order:${JULY22_DECK_WORKS.length - (index <= 3 ? index : JULY22_DECK_WORKS.length - index)}`}
        aria-label={`Show ${work.title}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
      >
        <Image
          src={work.image}
          alt=""
          widths={[260, 420, 640]}
          sizes={compact ? '(max-width: 700px) 58vw, 24vw' : '(max-width: 700px) 64vw, 30vw'}
          format="webp"
          loading={index < 3 ? 'eager' : 'lazy'}
        />
        <span class="poster-deck__number">{String(index + 1).padStart(2, '0')}</span>
      </button>
    ))}
    <span class="poster-deck__floor" aria-hidden="true"></span>
  </div>

  <div class="poster-deck__controls">
    <button type="button" data-poster-prev aria-label="Previous poster">←</button>
    <p><strong data-poster-title>{JULY22_DECK_WORKS[0].title}</strong><span data-poster-room>{JULY22_DECK_WORKS[0].room}</span></p>
    <span class="poster-deck__counter"><b data-poster-current>01</b> / {String(JULY22_DECK_WORKS.length).padStart(2, '0')}</span>
    <button type="button" data-poster-next aria-label="Next poster">→</button>
  </div>
</div>

<script>
  const deckRoots = document.querySelectorAll<HTMLElement>('[data-poster-deck]');

  deckRoots.forEach((deck) => {
    const cards = Array.from(deck.querySelectorAll<HTMLButtonElement>('[data-poster-card]'));
    const previous = deck.querySelector<HTMLButtonElement>('[data-poster-prev]');
    const next = deck.querySelector<HTMLButtonElement>('[data-poster-next]');
    const title = deck.querySelector<HTMLElement>('[data-poster-title]');
    const room = deck.querySelector<HTMLElement>('[data-poster-room]');
    const current = deck.querySelector<HTMLElement>('[data-poster-current]');
    let active = 0;
    let pointerStart = 0;

    const signedDistance = (index: number) => {
      const raw = index - active;
      const wrapped = raw > cards.length / 2 ? raw - cards.length : raw < -cards.length / 2 ? raw + cards.length : raw;
      return wrapped;
    };

    const select = (index: number, focus = false) => {
      active = (index + cards.length) % cards.length;
      cards.forEach((card, cardIndex) => {
        const offset = signedDistance(cardIndex);
        const distance = Math.abs(offset);
        card.style.setProperty('--offset', String(offset));
        card.style.setProperty('--abs', String(distance));
        card.style.setProperty('--order', String(cards.length - distance));
        card.setAttribute('aria-pressed', String(cardIndex === active));
        card.tabIndex = cardIndex === active ? 0 : -1;
      });
      const selected = cards[active];
      if (title) title.textContent = selected.dataset.title ?? '';
      if (room) room.textContent = selected.dataset.room ?? '';
      if (current) current.textContent = String(active + 1).padStart(2, '0');
      if (focus) selected.focus({ preventScroll: true });
    };

    cards.forEach((card, index) => card.addEventListener('click', () => select(index)));
    previous?.addEventListener('click', () => select(active - 1, true));
    next?.addEventListener('click', () => select(active + 1, true));
    deck.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(active - 1, true); }
      if (event.key === 'ArrowRight') { event.preventDefault(); select(active + 1, true); }
      if (event.key === 'Home') { event.preventDefault(); select(0, true); }
      if (event.key === 'End') { event.preventDefault(); select(cards.length - 1, true); }
    });
    deck.addEventListener('pointerdown', (event) => { pointerStart = event.clientX; });
    deck.addEventListener('pointerup', (event) => {
      const travel = event.clientX - pointerStart;
      if (Math.abs(travel) > 42) select(active + (travel < 0 ? 1 : -1));
    });
    select(0);
  });
</script>

<style>
  .poster-deck { --card-width: clamp(210px, 25vw, 360px); color: #f3f0df; touch-action: pan-y; user-select: none; }
  .poster-deck:focus-visible { outline: 2px solid #d6ff45; outline-offset: 5px; }
  .poster-deck__stage { position: relative; min-height: clamp(390px, 56vw, 650px); perspective: 1250px; transform-style: preserve-3d; }
  .poster-deck__card { position: absolute; top: 2%; left: calc(50% - var(--card-width) / 2); z-index: var(--order); width: var(--card-width); margin: 0; padding: 6px; cursor: pointer; border: 1px solid rgba(243, 240, 223, .7); border-radius: 0; background: #f3f0df; box-shadow: 0 28px 55px rgba(0, 0, 0, calc(.16 + var(--abs) * .03)); transform: translate3d(calc(var(--offset) * clamp(56px, 8.6vw, 132px)), calc(var(--abs) * 14px), calc(var(--abs) * -105px)) rotateY(calc(var(--offset) * -13deg)) rotateZ(calc(var(--offset) * 1.8deg)); transform-origin: center bottom; transition: transform 520ms cubic-bezier(.2,.75,.2,1), filter 420ms ease, opacity 420ms ease; filter: saturate(calc(1 - var(--abs) * .08)) brightness(calc(1 - var(--abs) * .07)); opacity: calc(1 - var(--abs) * .14); -webkit-tap-highlight-color: transparent; }
  .poster-deck__card[aria-pressed="true"] { cursor: grab; box-shadow: 0 38px 80px rgba(0, 0, 0, .42), 0 0 0 1px #d6ff45; }
  .poster-deck__card:focus-visible { outline: 3px solid #d6ff45; outline-offset: 4px; }
  .poster-deck__card :global(img) { display: block; width: 100%; height: auto; max-height: clamp(340px, 49vw, 570px); object-fit: cover; object-position: top; }
  .poster-deck__number { position: absolute; right: 9px; bottom: 9px; padding: 5px 7px; color: #f3f0df; background: #11120f; font-family: var(--pc-font-mono); font-size: 8px; letter-spacing: .12em; }
  .poster-deck__floor { position: absolute; left: 8%; right: 8%; bottom: 3%; height: 22%; background: radial-gradient(ellipse, rgba(0,0,0,.45), transparent 65%); transform: rotateX(68deg) translateZ(-100px); filter: blur(10px); pointer-events: none; }
  .poster-deck__controls { position: relative; z-index: 20; display: grid; grid-template-columns: 38px minmax(0, 1fr) auto 38px; align-items: center; gap: 10px; padding: 10px; border: 1px solid rgba(243, 240, 223, .35); background: rgba(12, 13, 11, .78); backdrop-filter: blur(12px); }
  .poster-deck__controls > button { width: 38px; height: 38px; padding: 0; cursor: pointer; color: #11120f; border: 0; border-radius: 0; background: #d6ff45; font: 18px/1 var(--pc-font-mono); }
  .poster-deck__controls > button:hover { background: #f472b6; }
  .poster-deck__controls p { display: flex; min-width: 0; flex-direction: column; gap: 3px; margin: 0; }
  .poster-deck__controls strong { overflow: hidden; font: 500 14px/1.1 var(--pc-font-sans); text-overflow: ellipsis; white-space: nowrap; }
  .poster-deck__controls p span, .poster-deck__counter { color: #a9a99f; font: 7px/1.2 var(--pc-font-mono); letter-spacing: .13em; }
  .poster-deck__counter b { color: #d6ff45; font-weight: 500; }
  .poster-deck--compact { --card-width: clamp(180px, 20vw, 290px); }
  .poster-deck--compact .poster-deck__stage { min-height: clamp(330px, 43vw, 520px); }
  .poster-deck--compact .poster-deck__card :global(img) { max-height: clamp(286px, 37vw, 445px); }
  @media (max-width: 700px) {
    .poster-deck { --card-width: min(58vw, 270px); }
    .poster-deck__stage { min-height: min(102vw, 470px); }
    .poster-deck__card { transform: translate3d(calc(var(--offset) * 15vw), calc(var(--abs) * 10px), calc(var(--abs) * -80px)) rotateY(calc(var(--offset) * -10deg)) rotateZ(calc(var(--offset) * 1.6deg)); }
    .poster-deck__card :global(img) { max-height: min(88vw, 410px); }
    .poster-deck__controls { grid-template-columns: 38px minmax(0, 1fr) 38px; }
    .poster-deck__counter { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .poster-deck__card { transition: none; }
  }
</style>
