---
import { Image } from 'astro:assets';
import BlockLayout from '../../layouts/BlockLayout.astro';
import PosterDeck from './PosterDeck.astro';
import { JULY22_ROOMS, JULY22_WORKS } from '../../lib/todays-art-july22';
import { todaysGalleryManifest } from '../../lib/todays-gallery';

const description = 'PointCast Today’s Art for July 22, 2026: fifteen speculative civic posters turn El Segundo into a local operating system.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: todaysGalleryManifest.title,
  description,
  url: 'https://pointcast.xyz/gallery/2026-07-22',
  creator: { '@type': 'Person', name: 'Michael Hoydich' },
  datePublished: '2026-07-22',
  numberOfItems: JULY22_WORKS.length,
};
---

<BlockLayout
  title="The City Is a Poster"
  description={description}
  themeColor="#11120f"
  image={`https://pointcast.xyz${JULY22_WORKS[6].image.src}`}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/gallery/today.json', title: 'The City Is a Poster manifest' }]}
>
  <article class="poster-edition">
    <nav class="edition-nav mono" aria-label="Gallery navigation">
      <a href="/">POINTCAST</a><span>/</span><a href="/gallery">GALLERY</a><span>/</span><b>EDIT 003</b>
      <a class="edition-nav__editions" href="/gallery/editions">ALL EDITIONS</a>
      <a href="/gallery/today.json">JSON ↗</a>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="mono">TODAY'S ART · 22 JUL 2026 · EDIT 003</p>
        <h1>The city is<br /><i>a poster.</i></h1>
        <p class="hero__dek">Fifteen speculative broadsides turn El Segundo into a civic operating system: days of the week, water, sports, machines, weather, and myth all demanding a wall.</p>
        <div class="hero__meta mono"><span>15 WORKS</span><span>4 ROOMS</span><span>1 HUMAN EDIT</span></div>
        <p class="hero__hint mono">DRAG · SWIPE · ARROW KEYS</p>
      </div>
      <PosterDeck />
      <div class="hero__rail mono"><span>LOCAL FUTURE</span><span>SOUVENIR DESK</span><span>NOT MINTED</span></div>
    </header>

    <section class="thesis" aria-label="Curatorial note">
      <p class="mono">CURATORIAL NOTE</p>
      <blockquote>“A city becomes legible when it starts making signs for the version of itself that has not arrived yet.”</blockquote>
      <p>The local batch is hung as posters, not predictions. Repeated brands and broken words are part of the synthetic street texture. PointCast does not assert which generation tool made the source files; it records what was actually supplied and what was selected.</p>
    </section>

    <main class="rooms">
      {JULY22_ROOMS.map((room, roomIndex) => {
        const works = room.workIds.map((id) => JULY22_WORKS.find((work) => work.id === id)).filter(Boolean);
        return (
          <section class:list={['room', `room--${roomIndex + 1}`]} id={room.id} aria-labelledby={`${room.id}-title`}>
            <header class="room__head">
              <p class="mono">{room.label} · {String(works.length).padStart(2, '0')} WORKS</p>
              <h2 id={`${room.id}-title`}>{room.title}</h2>
              <p>{room.note}</p>
            </header>
            <div class="room__grid">
              {works.map((work, index) => work && (
                <figure class:list={[index === 0 && 'room__anchor']}>
                  <Image
                    src={work.image}
                    alt={work.alt}
                    widths={index === 0 ? [540, 860, 1200] : [360, 620, 900]}
                    sizes={index === 0 ? '(max-width: 720px) 100vw, 45vw' : '(max-width: 720px) 100vw, 28vw'}
                    format="webp"
                    loading={roomIndex === 0 && index < 2 ? 'eager' : 'lazy'}
                  />
                  <figcaption>
                    <b>{work.title}</b>
                    <span>{work.note}</span>
                    <small class="mono">{work.id} · {work.room}</small>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        );
      })}
    </main>

    <footer class="colophon">
      <div><p class="mono">POINTCAST TODAY'S ART · EDIT 003</p><h2>Keep the wall<br /><i>moving.</i></h2></div>
      <p>All fifteen files came from the local batch supplied for this edition. Their original filenames and exact dimensions are preserved in the public manifest. Curated and published does not mean minted.</p>
      <nav class="mono"><a href="/gallery/editions">ALL EDITIONS</a><a href="/gallery/today.json">PUBLIC MANIFEST</a><a href="/">BACK TO POINTCAST</a></nav>
    </footer>
  </article>
</BlockLayout>

<style>
  .poster-edition { --ink: #11120f; --paper: #f0ead8; --acid: #d6ff45; --pink: #f472b6; overflow: hidden; color: var(--ink); background: var(--paper); }
  .mono { font-family: var(--pc-font-mono); }
  .edition-nav { display: flex; align-items: center; gap: 9px; padding: 11px clamp(14px, 3vw, 48px); color: #f3f0df; background: var(--ink); font-size: 8px; letter-spacing: .14em; }
  .edition-nav a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .edition-nav__editions { margin-left: auto; }
  .hero { position: relative; display: grid; grid-template-columns: minmax(280px, .78fr) minmax(500px, 1.22fr); align-items: center; gap: clamp(20px, 4vw, 70px); min-height: calc(100svh - 35px); padding: clamp(34px, 6vw, 88px) clamp(16px, 4vw, 64px) 48px; color: #f3f0df; background: var(--ink); }
  .hero::before { position: absolute; inset: 0; content: ''; pointer-events: none; background: radial-gradient(circle at 82% 34%, rgba(56,189,248,.17), transparent 33%), radial-gradient(circle at 90% 82%, rgba(244,114,182,.13), transparent 28%), repeating-linear-gradient(90deg, transparent 0 99px, rgba(255,255,255,.025) 100px); }
  .hero__copy, .hero :global(.poster-deck) { position: relative; z-index: 1; }
  .hero__copy > .mono:first-child { margin: 0 0 20px; color: var(--acid); font-size: 8px; letter-spacing: .17em; }
  h1, h2, blockquote { margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-weight: 400; letter-spacing: -.065em; }
  h1 { font-size: clamp(68px, 9vw, 140px); line-height: .72; }
  h1 i, .colophon h2 i { color: var(--pink); font-weight: 400; }
  .hero__dek { max-width: 45ch; margin: 36px 0 24px; color: #cccac0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(18px, 1.8vw, 25px); line-height: 1.38; }
  .hero__meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .hero__meta span { padding: 7px 9px; color: var(--ink); background: var(--acid); font-size: 7px; letter-spacing: .14em; }
  .hero__hint { margin: 18px 0 0; color: #77796e; font-size: 7px; letter-spacing: .14em; }
  .hero__rail { position: absolute; right: 0; bottom: 0; left: 0; z-index: 2; display: flex; justify-content: space-between; padding: 9px 14px; color: var(--ink); background: var(--pink); font-size: 7px; letter-spacing: .14em; }
  .thesis { display: grid; grid-template-columns: .3fr 1.05fr .65fr; gap: clamp(24px, 4vw, 70px); align-items: start; padding: clamp(60px, 9vw, 138px) clamp(16px, 5vw, 80px); border-bottom: 1px solid var(--ink); }
  .thesis > .mono { color: #b13a73; font-size: 8px; letter-spacing: .16em; }
  blockquote { font-size: clamp(38px, 5.8vw, 84px); line-height: .9; }
  .thesis > p:last-child { max-width: 48ch; margin: 0; font-size: 13px; line-height: 1.65; }
  .room { padding: clamp(60px, 9vw, 132px) clamp(16px, 4vw, 64px); border-bottom: 1px solid var(--ink); }
  .room--2 { background: #bfeee7; }
  .room--3 { background: #d8ff59; }
  .room--4 { color: #eeeadd; background: #2d2d31; }
  .room__head { display: grid; grid-template-columns: 1fr .5fr; gap: 16px 55px; align-items: end; margin-bottom: clamp(34px, 6vw, 82px); }
  .room__head > .mono { grid-column: 1 / -1; margin: 0; color: #b13a73; font-size: 8px; letter-spacing: .16em; }
  .room--4 .room__head > .mono { color: var(--acid); }
  .room__head h2 { font-size: clamp(50px, 8vw, 118px); line-height: .8; }
  .room__head > p:last-child { max-width: 48ch; margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(17px, 1.7vw, 23px); line-height: 1.4; }
  .room__grid { display: grid; grid-template-columns: 1.35fr repeat(2, 1fr); gap: 12px; align-items: start; }
  figure { min-width: 0; margin: 0; padding: 7px; color: var(--ink); border: 1px solid var(--ink); background: #f7f1df; box-shadow: 7px 7px 0 rgba(17,18,15,.95); }
  .room--4 figure { border-color: #eeeadd; box-shadow: 7px 7px 0 var(--pink); }
  .room__anchor { grid-column: span 2; }
  figure :global(img) { display: block; width: 100%; height: auto; }
  figcaption { display: grid; gap: 7px; padding: 13px 5px 6px; }
  figcaption b { font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: 21px; font-weight: 500; }
  figcaption span { color: #58584f; font-size: 11px; line-height: 1.45; }
  figcaption small { color: #8d3861; font-size: 7px; letter-spacing: .11em; }
  .colophon { display: grid; grid-template-columns: 1fr .65fr .42fr; gap: clamp(28px, 5vw, 80px); align-items: end; padding: clamp(56px, 9vw, 130px) clamp(16px, 4vw, 64px); color: #f3f0df; background: var(--ink); }
  .colophon .mono { color: var(--acid); font-size: 8px; letter-spacing: .15em; }
  .colophon h2 { margin-top: 16px; font-size: clamp(58px, 7vw, 104px); line-height: .78; }
  .colophon > p { max-width: 48ch; margin: 0; color: #b8b8ae; font-size: 12px; line-height: 1.65; }
  .colophon nav { display: flex; align-items: flex-start; flex-direction: column; gap: 14px; }
  .colophon a { color: #f3f0df; text-decoration: none; border-bottom: 1px solid currentColor; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__copy { display: grid; grid-template-columns: 1fr .68fr; gap: 0 24px; }
    .hero__copy > .mono:first-child { grid-column: 1 / -1; }
    .hero__copy h1 { grid-row: span 4; }
    .hero__dek { margin: 0 0 20px; }
    .thesis, .room__head, .colophon { grid-template-columns: 1fr; }
    .room__grid { grid-template-columns: repeat(2, 1fr); }
    .room__anchor { grid-column: 1 / -1; }
  }
  @media (max-width: 650px) {
    .edition-nav span { display: none; }
    .hero { padding-inline: 14px; }
    .hero__copy { display: block; }
    h1 { font-size: clamp(66px, 22vw, 96px); }
    .hero__dek { margin: 26px 0 20px; }
    .thesis { gap: 24px; }
    blockquote { font-size: 46px; }
    .room__grid { grid-template-columns: 1fr; }
    .room__head h2 { font-size: 58px; }
    .hero__rail span:nth-child(2) { display: none; }
  }
</style>
