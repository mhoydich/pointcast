---
import { Image } from 'astro:assets';
import BlockLayout from '../../layouts/BlockLayout.astro';
import bicycleShrine from '../../assets/todays-art/2026-07-21/midjourney/bicycle-repair-shrine.webp';
import communityTable from '../../assets/todays-art/2026-07-21/midjourney/community-table.webp';
import blueCanopy from '../../assets/todays-art/2026-07-21/midjourney/blue-canopy.webp';
import gardenKiosk from '../../assets/todays-art/2026-07-21/midjourney/garden-kiosk.webp';
import busShelter from '../../assets/todays-art/2026-07-21/midjourney/bus-shelter-garden.webp';
import starMap from '../../assets/todays-art/2026-07-21/midjourney/neighborhood-star-map.webp';
import abundanceOne from '../../assets/todays-art/2026-07-21/ideogram/abundance-flows-01.webp';
import abundanceTwo from '../../assets/todays-art/2026-07-21/ideogram/abundance-flows-02.webp';
import abundanceThree from '../../assets/todays-art/2026-07-21/ideogram/abundance-flows-03.webp';
import abundanceFour from '../../assets/todays-art/2026-07-21/ideogram/abundance-flows-04.webp';
import revePositive from '../../assets/todays-art/2026-07-21/reve/the-positive-index.webp';
import moneyOcean from '../../assets/todays-art/imageapp/money-ocean.png';
import soTired from '../../assets/todays-art/imageapp/so-tired.png';
import pacificOne from '../../assets/todays-art/imageapp/color-field-01.png';
import pacificTwo from '../../assets/todays-art/imageapp/color-field-02.png';
import { POSITIVE_INDEX_REVE_ADS, todaysGalleryManifest } from '../../lib/todays-gallery';

const midjourneyWorks = [
  [bicycleShrine, 'Bicycle Repair Shrine', 'A civic repair object treated like a rare devotional artifact.'],
  [communityTable, 'The Long Table', 'Dinner as infrastructure beneath a translucent blue sky.'],
  [blueCanopy, 'Blue Canopy Supper', 'A public meal becomes its own weather system.'],
  [gardenKiosk, 'Garden Kiosk', 'The bus-stop scale is exactly large enough for a garden.'],
  [busShelter, 'Bus Shelter Conservatory', 'One ordinary shelter, revised toward abundance.'],
  [starMap, 'Neighborhood Star Map', 'Children draw the sky back into the local archive.'],
] as const;

const ideogramWorks = [
  [abundanceOne, 'Abundance Flows I', 'The ocean curls into a diagram for receiving.'],
  [abundanceTwo, 'Abundance Flows II', 'A wide atmospheric band with the instruction: align, embody, receive.'],
  [abundanceThree, 'Abundance Flows III', 'The softest spiral carries the most direct proposition.'],
  [abundanceFour, 'Abundance Flows IV', 'The series closes with the horizon still moving.'],
] as const;

const imageappWorks = [
  [moneyOcean, 'Money Ocean', 'A preserved profile export where wealth becomes weather.'],
  [soTired, 'So Tired', 'A bright, exhausted wall of tires: literal, funny, and severe.'],
  [pacificOne, 'Pacific Bands I', 'Four bands held together by the pressure of paint.'],
  [pacificTwo, 'Pacific Bands II', 'The same coast after blue begins to dominate.'],
] as const;

const description = 'PointCast Today’s Art for July 21, 2026: fourteen works from Midjourney, Ideogram, and a preserved ImageApp export, plus a three-poster Reve house-ad campaign.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: todaysGalleryManifest.title,
  description,
  url: 'https://pointcast.xyz/gallery/2026-07-21',
  creator: { '@type': 'Person', name: 'Michael Hoydich' },
  datePublished: '2026-07-21',
};
---

<BlockLayout
  title="The Positive Index"
  description={description}
  themeColor="#eee6d4"
  image={`https://pointcast.xyz${revePositive.src}`}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/gallery/today.json', title: 'The Positive Index manifest' }]}
>
  <div class="positive-index">
    <nav class="edition-nav mono" aria-label="Gallery navigation">
      <a href="/">POINTCAST</a><span>/</span><a href="/gallery">GALLERY</a><span>/</span><b>EDIT 002</b>
      <a class="edition-nav__editions" href="/gallery/editions">ALL EDITIONS</a>
      <a href="/gallery/today.json">JSON ↗</a>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="mono">TODAY'S ART · 21 JUL 2026 · EDIT 002</p>
        <h1>The Positive<br /><i>Index.</i></h1>
        <p class="hero__dek">Ordinary public things pictured as evidence that a generous California future is already trying to arrive.</p>
        <p class="hero__count mono">14 WORKS · 3 ART TOOLS · 1 HUMAN EDIT<br />+ 3 REVE HOUSE-AD PROOFS</p>
      </div>
      <Image src={revePositive} alt="The Positive Index Reve poster: a bicycle shrine flowering at dusk" widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 40vw" format="webp" loading="eager" />
    </header>

    <section class="room room--public" aria-labelledby="public-title">
      <header class="room__head">
        <p class="mono">ROOM 01 / MIDJOURNEY / FRESH TODAY</p>
        <h2 id="public-title">Small public<br /><i>miracles.</i></h2>
        <p>Six recent works from the signed-in Midjourney desk. Repair stands, shared tables, shelters, and a child-made sky: civic life rendered as desirable design history.</p>
      </header>
      <div class="public-grid">
        {midjourneyWorks.map(([src, title, note], index) => (
          <figure class:list={[index === 0 && 'public-grid__anchor']}>
            <Image src={src} alt={title} widths={index === 0 ? [720, 1100, 1500] : [420, 720, 960]} sizes={index === 0 ? '(max-width: 800px) 100vw, 52vw' : '(max-width: 800px) 50vw, 25vw'} format="webp" loading={index < 2 ? 'eager' : 'lazy'} />
            <figcaption><b>{String(index + 1).padStart(2, '0')} · {title}</b><span>{note}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="room room--abundance" aria-labelledby="abundance-title">
      <header class="room__head">
        <p class="mono">ROOM 02 / IDEOGRAM PROFILE DEEP DIVE</p>
        <h2 id="abundance-title">Abundance<br /><i>flows.</i></h2>
        <p>A four-poster Ideogram run found below the familiar “Everything Is Possible” suite. The text is earnest enough to risk embarrassment; the images earn it back.</p>
      </header>
      <div class="poster-grid">
        {ideogramWorks.map(([src, title, note], index) => (
          <figure>
            <Image src={src} alt={title} widths={[420, 720, 1000]} sizes="(max-width: 760px) 100vw, 25vw" format="webp" loading="lazy" />
            <figcaption><b>{String(index + 7).padStart(2, '0')} · {title}</b><span>{note}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="room room--imageapp" aria-labelledby="imageapp-title">
      <header class="room__head room__head--dark">
        <p class="mono">ROOM 03 / IMAGEAPP.XYZ / PRESERVED PROFILE EXPORT</p>
        <h2 id="imageapp-title">The local bucket,<br /><i>revisited.</i></h2>
        <p>ImageApp was checked again today and still returned Site Maintenance. The deep dive therefore stays honest: four preserved <b>mikeimageapp</b> profile exports, re-hung around weather, fatigue, and the Pacific.</p>
      </header>
      <div class="imageapp-grid">
        {imageappWorks.map(([src, title, note], index) => (
          <figure class:list={[index === 0 && 'imageapp-grid__anchor']}>
            <Image src={src} alt={title} widths={index === 0 ? [720, 1100, 1400] : [420, 720, 960]} sizes={index === 0 ? '(max-width: 800px) 100vw, 55vw' : '(max-width: 800px) 50vw, 30vw'} format="webp" loading="lazy" />
            <figcaption><b>{String(index + 11).padStart(2, '0')} · {title}</b><span>{note}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="ad-proofs" aria-labelledby="ad-proofs-title">
      <header>
        <p class="mono">CAMPAIGN DESK / REVE / HOUSE ADS</p>
        <h2 id="ad-proofs-title">The show<br /><i>advertises itself.</i></h2>
        <p>Three Reve posters created for this edition. They are clearly labeled PointCast house ads, use contextual placement only, and are not counted among the fourteen artworks.</p>
      </header>
      <div>
        {POSITIVE_INDEX_REVE_ADS.map(([id, title, image]) => (
          <figure>
            <img src={image} alt={`${title} Reve house-ad poster`} width="1200" height="1457" loading="lazy" />
            <figcaption><b>{title}</b><span class="mono">HOUSE AD · {id} · REVE</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <footer class="colophon">
      <p class="mono">POINTCAST TODAY'S ART · EDIT 002 · EL SEGUNDO, CALIFORNIA</p>
      <p>Source/profile provenance remains visible. A live ImageApp review was attempted and maintenance was observed. Curated and published does not mean minted.</p>
      <nav><a href="/gallery/editions">ALL EDITIONS</a><a href="/gallery/today.json">PUBLIC MANIFEST</a><a href="/ads">AD RECEIPTS</a></nav>
    </footer>
  </div>
</BlockLayout>

<style>
  .positive-index { --paper: #eee6d4; --ink: #171814; --blue: #173a58; --orange: #df5f2c; overflow: hidden; color: var(--ink); background: var(--paper); }
  .mono { font-family: var(--pc-font-mono); }
  .edition-nav { display: flex; align-items: center; gap: 9px; padding: 12px clamp(16px, 4vw, 64px); color: #f2ead9; background: #141a1b; font-size: 8px; letter-spacing: .14em; }
  .edition-nav a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .edition-nav__editions { margin-left: auto; }
  .hero { min-height: 82vh; display: grid; grid-template-columns: 1.05fr .72fr; gap: clamp(24px, 5vw, 78px); align-items: center; padding: clamp(28px, 6vw, 90px) clamp(16px, 4vw, 64px); background: #eee8d9; border-bottom: 1px solid var(--ink); }
  .hero__copy > .mono:first-child, .room__head > .mono, .ad-proofs header > .mono { color: var(--orange); font-size: 8px; letter-spacing: .16em; }
  h1, h2 { margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-weight: 400; letter-spacing: -.065em; }
  h1 { font-size: clamp(62px, 10vw, 148px); line-height: .76; }
  h1 i, h2 i { color: var(--orange); font-weight: 400; }
  .hero__dek { max-width: 48ch; margin: 36px 0 22px; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(18px, 2vw, 27px); line-height: 1.38; }
  .hero__count { font-size: 8px; line-height: 1.7; letter-spacing: .13em; }
  .hero > img { width: 100%; max-height: 74vh; object-fit: contain; border: 1px solid var(--ink); box-shadow: 16px 16px 0 #173a58; }
  .room, .ad-proofs { padding: clamp(48px, 8vw, 118px) clamp(16px, 4vw, 64px); }
  .room__head, .ad-proofs > header { display: grid; grid-template-columns: 1.15fr .58fr; gap: 14px 50px; align-items: end; margin-bottom: clamp(30px, 5vw, 70px); }
  .room__head > .mono, .ad-proofs header > .mono { grid-column: 1 / -1; margin: 0; }
  h2 { font-size: clamp(50px, 8vw, 116px); line-height: .8; }
  .room__head > p:last-child, .ad-proofs header > p:last-child { max-width: 50ch; margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(16px, 1.7vw, 22px); line-height: 1.45; }
  figure { min-width: 0; margin: 0; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; flex-direction: column; gap: 5px; padding: 10px 2px 22px; }
  figcaption b { font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: 18px; font-weight: 500; }
  figcaption span { color: #605b50; font-size: 9px; line-height: 1.45; }
  .public-grid { display: grid; grid-template-columns: 1.5fr repeat(2, 1fr); gap: 10px 16px; }
  .public-grid__anchor { grid-row: span 2; }
  .public-grid img { aspect-ratio: 4 / 5; object-fit: cover; }
  .public-grid__anchor img { min-height: 660px; height: 100%; }
  .room--abundance { background: #dfe7e4; }
  .poster-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .poster-grid figure { padding: 7px; background: #f8f2e4; border: 1px solid var(--ink); }
  .poster-grid figcaption { padding: 12px 4px 4px; }
  .room--imageapp { color: #f0e9db; background: #132b39; }
  .room--imageapp .room__head > .mono { color: #ff8c5b; }
  .room--imageapp .room__head p:last-child, .room--imageapp figcaption span { color: #b9c5c8; }
  .imageapp-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 10px 16px; }
  .imageapp-grid__anchor { grid-row: span 2; }
  .imageapp-grid img { aspect-ratio: 1 / 1; object-fit: cover; }
  .imageapp-grid__anchor img { min-height: 650px; height: 100%; }
  .ad-proofs { background: #f3eee2; }
  .ad-proofs > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ad-proofs figure { padding: 8px; background: #fffaf0; border: 1px solid var(--ink); box-shadow: 6px 6px 0 #173a58; }
  .ad-proofs figcaption { padding: 12px 4px 4px; }
  .colophon { display: grid; grid-template-columns: .7fr 1fr .7fr; gap: 30px; padding: 32px clamp(16px, 4vw, 64px) 60px; color: #eee7d7; background: #141a1b; font-size: 11px; line-height: 1.6; }
  .colophon p { margin: 0; }
  .colophon .mono { font-size: 8px; letter-spacing: .13em; }
  .colophon nav { display: flex; flex-wrap: wrap; align-content: start; gap: 10px 16px; }
  .colophon a { color: inherit; font-family: var(--pc-font-mono); font-size: 8px; letter-spacing: .1em; text-decoration: none; border-bottom: 1px solid currentColor; }
  @media (max-width: 900px) {
    .hero, .room__head, .ad-proofs > header { grid-template-columns: 1fr; }
    .public-grid, .imageapp-grid { grid-template-columns: repeat(2, 1fr); }
    .public-grid__anchor, .imageapp-grid__anchor { grid-column: 1 / -1; grid-row: auto; }
    .public-grid__anchor img, .imageapp-grid__anchor img { min-height: 0; height: auto; }
    .poster-grid { grid-template-columns: repeat(2, 1fr); }
    .colophon { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .edition-nav span { display: none; }
    .public-grid, .poster-grid, .imageapp-grid, .ad-proofs > div, .colophon { grid-template-columns: 1fr; }
    .hero > img { box-shadow: 8px 8px 0 #173a58; }
  }
</style>
