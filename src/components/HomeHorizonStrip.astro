---
/**
 * HomeHorizonStrip — woodblock horizon panel.
 *
 * Bridges the editorial top half (Morning Hero / Front Door / Ask /
 * Operating Mode / Recent Ships / Learnings / Today / Week / Arcade)
 * and the directory bottom half. Without this, the homepage hits a
 * tonal cliff between editorial narrative and 14-column taxonomy.
 *
 * Visual register from mhoydich Midjourney spotlight (waves, horizon
 * strips, flat-color woodblock). Sky → sea bands, terracotta sun,
 * refinery silhouette pinned to El Segundo.
 */
const now = new Date();
const hours = now.getHours();
// Light-mode hero stays blue-hour even at night — the strip is a
// chrome element, not a literal weather panel.
const todayStr = now.toISOString().slice(0, 10);

function phase(h: number): string {
  if (h < 5) return 'OVERNIGHT';
  if (h < 11) return 'MORNING';
  if (h < 17) return 'AFTERNOON';
  if (h < 21) return 'EVENING';
  return 'NIGHT';
}
const kicker = `${phase(hours)} · ${todayStr}`;
---

<section class="horizon" aria-label="El Segundo horizon">
  <svg
    class="horizon__svg"
    viewBox="0 0 1200 220"
    preserveAspectRatio="xMidYMid slice"
    role="img"
    aria-labelledby="horizon-title"
  >
    <title id="horizon-title">A flat-color woodblock view of El Segundo: sky bands, ocean waves, refinery on the right.</title>

    {/* sky bands — top to horizon, flat color, no gradients */}
    <rect x="0" y="0"   width="1200" height="50"  fill="#cbd9e3"/>
    <rect x="0" y="50"  width="1200" height="32"  fill="#a9c3d4"/>
    <rect x="0" y="82"  width="1200" height="26"  fill="#f0c6b1"/>
    <rect x="0" y="108" width="1200" height="14"  fill="#e89d7a"/>

    {/* sun — terracotta circle, asymmetric */}
    <circle cx="940" cy="78" r="22" fill="#d8624a"/>

    {/* distant mountain silhouette — Santa Monicas */}
    <path d="M0 122 L120 96 L180 110 L260 86 L340 108 L420 92 L520 116 L600 100 L700 118 L800 110 L900 122 L1000 116 L1100 120 L1200 118 L1200 130 L0 130 Z"
          fill="#5e6f7d"/>

    {/* sea band */}
    <rect x="0" y="122" width="1200" height="98" fill="#3d6a89"/>

    {/* wave crests — three offset rows of repeating arcs (woodblock register) */}
    <g fill="none" stroke="#cfe2ec" stroke-width="2.5" stroke-linecap="round">
      {Array.from({ length: 40 }).map((_, i) => (
        <path d={`M${i * 32 - 8} 152 q 8 -7 16 0 q 8 7 16 0`} />
      ))}
    </g>
    <g fill="none" stroke="#9cc1d3" stroke-width="2" stroke-linecap="round">
      {Array.from({ length: 40 }).map((_, i) => (
        <path d={`M${i * 32 + 8} 174 q 8 -6 16 0 q 8 6 16 0`} />
      ))}
    </g>
    <g fill="none" stroke="#76a5bd" stroke-width="2" stroke-linecap="round">
      {Array.from({ length: 40 }).map((_, i) => (
        <path d={`M${i * 32 - 4} 196 q 8 -5 16 0 q 8 5 16 0`} />
      ))}
    </g>

    {/* refinery silhouette — far right, El Segundo Chevron */}
    <g fill="#1f1b15">
      <rect x="1018" y="98" width="6" height="24"/>
      <rect x="1040" y="86" width="8" height="36"/>
      <rect x="1064" y="104" width="5" height="18"/>
      <rect x="1082" y="92" width="10" height="30"/>
      <rect x="1106" y="106" width="6" height="16"/>
      <rect x="1126" y="100" width="7" height="22"/>
      <rect x="1148" y="110" width="4" height="12"/>
      {/* flare stack */}
      <rect x="1044" y="66" width="2" height="20"/>
      <circle cx="1045" cy="64" r="3" fill="#e89d7a"/>
    </g>

    {/* sail — tiny boat, far left */}
    <g>
      <path d="M120 138 L120 122 L132 138 Z" fill="#fbf7ee"/>
      <rect x="119" y="138" width="14" height="2.5" fill="#1f1b15"/>
    </g>
  </svg>

  <div class="horizon__overlay">
    <p class="horizon__kicker mono">{kicker}</p>
    <p class="horizon__title">From the desk · El Segundo, looking west.</p>
    <p class="horizon__dek">
      The town below the broadcast — a directory of every room, mesh, and surface.
    </p>
  </div>
</section>

<style>
  .horizon {
    position: relative;
    margin: 48px 0 0;
    border-radius: 4px 4px 0 0;
    overflow: hidden;
    line-height: 0;
    box-shadow: 0 6px 28px rgba(31, 27, 21, 0.12);
  }
  .horizon__svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 220;
  }
  .horizon__overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 14px 22px 16px;
    background: linear-gradient(180deg, rgba(31, 27, 21, 0) 0%, rgba(31, 27, 21, 0.55) 100%);
    color: #fdf2d6;
    line-height: 1.3;
  }
  .horizon__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #f3eccd;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .horizon__title {
    font-family: var(--font-heading);
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 4px;
  }
  .horizon__dek {
    font-family: var(--font-serif);
    font-size: 14px;
    color: rgba(253, 242, 214, 0.86);
    margin: 0;
    max-width: 580px;
  }

  @media (max-width: 600px) {
    .horizon__overlay { padding: 10px 14px 12px; }
    .horizon__dek { font-size: 12.5px; }
  }
</style>
