<section class="profile-connections" data-profile-connections data-state="checking" aria-label="Your X connection" aria-busy="true">
  <header class="profile-connections__head">
    <div>
      <p class="profile-connections__kicker">YOUR CONNECTIONS</p>
      <h2>X</h2>
    </div>
    <span class="profile-connections__badge" data-x-badge>CHECKING</span>
  </header>
  <p data-x-status>Checking X sign-in availability…</p>
  <a class="profile-connections__handle" data-x-handle hidden target="_blank" rel="noopener noreferrer"></a>
  <p class="profile-connections__boundary">Link X as a sign-in method for this PointCast account. This does not authorize PointCast or your AI to post or send direct messages.</p>
  <div class="profile-connections__actions">
    <button type="button" data-x-action="connect" disabled>Checking X…</button>
    <button type="button" data-x-action="disconnect" hidden disabled>Disconnect X</button>
    <a href="/auth">Manage sign-in methods →</a>
  </div>
  <p class="profile-connections__hint" data-x-disconnect-hint></p>
  <output class="profile-connections__notice" data-x-notice aria-live="polite"></output>
</section>

<script>
  import { getSession, getXAuthAvailability, loginWithX, disconnectX } from '../lib/auth/client';
  import { mountProfileConnections } from '../scripts/profile-connections.mjs';
  type ConnectionWindow = Window & {
    __pointCastConnectionsCleanup?: () => void;
    __pointCastConnectionsInstalled?: boolean;
  };
  const connectionWindow = window as ConnectionWindow;
  function initializeConnections() {
    connectionWindow.__pointCastConnectionsCleanup?.();
    const cleanups = [...document.querySelectorAll<HTMLElement>('[data-profile-connections]')]
      .map((root) => mountProfileConnections(root, { getSession, getXAuthAvailability, loginWithX, disconnectX }));
    connectionWindow.__pointCastConnectionsCleanup = () => cleanups.forEach((cleanup) => cleanup());
  }
  if (!connectionWindow.__pointCastConnectionsInstalled) {
    connectionWindow.__pointCastConnectionsInstalled = true;
    document.addEventListener('astro:page-load', initializeConnections);
  }
  initializeConnections();
</script>

<style>
  .profile-connections { margin-top: 24px; padding: clamp(20px, 4vw, 32px); border: 1px solid #c4c9bc; background: #fffdf4; color: #20251d; }
  .profile-connections [hidden] { display: none !important; }
  .profile-connections__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .profile-connections__kicker, .profile-connections__badge { margin: 0; font: 700 10px/1.5 var(--pc-font-mono, ui-monospace, monospace); letter-spacing: .08em; }
  .profile-connections__kicker { color: #456831; }
  .profile-connections h2 { margin: 6px 0 0; font-size: 32px; line-height: 1; }
  .profile-connections__badge { padding: 5px 9px; border: 1px solid #c4c9bc; }
  .profile-connections[data-state='connected'] .profile-connections__badge { background: #e6f0d9; }
  .profile-connections p { max-width: 720px; line-height: 1.5; }
  .profile-connections__boundary, .profile-connections__hint { color: #5f665a; font-size: 13px; }
  .profile-connections__handle { color: #254f82; font-weight: 700; }
  .profile-connections__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 20px; }
  .profile-connections__actions button { min-height: 44px; padding: 10px 16px; border: 1px solid #293d22; border-radius: 3px; background: #293d22; color: white; font-family: inherit; font-size: 13px; font-weight: 700; line-height: 1.3; cursor: pointer; }
  .profile-connections__actions button:disabled { opacity: .55; cursor: default; }
  .profile-connections__actions a { color: #254f82; font-size: 13px; }
  .profile-connections__notice { display: block; min-height: 1.5em; margin-top: 10px; font-size: 13px; line-height: 1.5; }
</style>
