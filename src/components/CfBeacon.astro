---
/**
 * Cloudflare Web Analytics. Renders nothing until PUBLIC_CF_BEACON_TOKEN
 * is set for the build. The token is a public site token, not a secret:
 * create a Web Analytics site for pointcast.xyz and pass its token in.
 * Headless Chrome, navigator.webdriver, ?nobeacon=1, and localStorage
 * nobeacon skip the script. See src/lib/cf-beacon.mjs.
 */
const token = String(import.meta.env.PUBLIC_CF_BEACON_TOKEN || '').trim();
---

{token && (
  <>
    <meta name="pc-cf-beacon" content={token} />
    <script>
      import { mountCfBeacon } from '../lib/cf-beacon.mjs';
      mountCfBeacon();
    </script>
  </>
)}
