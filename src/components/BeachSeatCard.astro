---
import { shoppingLabel } from '../lib/shopping';
import type { SeatPick } from '../lib/beach-commons-v19';
interface Props { seat: SeatPick; number: number; pocket?: boolean }
const { seat, number, pocket = false } = Astro.props;
const extras = seat.sourceUrls?.filter((url) => url !== seat.url) ?? [];
---
<article class="seat-card" id={seat.id} data-pocket-seat={pocket ? '' : undefined} data-tags={seat.tags.join(' ')}>
  <div class="card-top"><span class="number">{String(number).padStart(2, '0')}</span><span class="role">{seat.role}</span></div>
  <figure class="seat-photo">
    <img src={`/beach-commons/v19/assets/seats/${seat.id}.webp`} width="800" height="650" alt={`${seat.maker} ${seat.name} — ${seat.id === 'campwell' ? 'REI product video thumbnail' : 'manufacturer product photograph'}`} loading="lazy" decoding="async" />
    <figcaption>{seat.id === 'campwell' ? 'Product video image: ' : 'Photo: '}<a href={seat.url}>{seat.maker}</a>{seat.id === 'numanu' ? ' · accessories shown; stool-only price below' : ' · color shown may vary'}</figcaption>
  </figure>
  <p class="maker">{seat.maker}</p>
  <h3>{seat.name}</h3>
  <p class="price">{seat.priceLabel}</p>
  <dl>
    {seat.packed !== 'Not verified' && <div class="packed"><dt>Packed</dt><dd>{seat.packed}</dd></div>}
    <div><dt>Carry weight</dt><dd>{seat.weight}</dd></div>
    <div><dt>Seat height</dt><dd>{seat.seatHeight}</dd></div>
    <div><dt>Capacity</dt><dd>{seat.capacity}</dd></div>
  </dl>
  <p class="description">{seat.description}</p>
  <div class="tradeoff"><span>Before you choose</span><p>{seat.caveat}</p></div>
  <div class="sources"><a href={seat.url} target="_blank" rel="noopener noreferrer" data-shop-link={seat.id}>{shoppingLabel(seat.id)} <span aria-hidden="true">↗</span></a>
    <button type="button" hidden data-pocket-save={seat.id} aria-pressed="false">Save</button>
    {extras.map((url) => <a class="extra-source" href={url}>{url.includes('guides.helinox') ? 'Handling guide ↗' : 'Packed-weight source ↗'}</a>)}
  </div>
</article>
<style>
  .seat-photo{margin:0 0 25px}.seat-photo img{display:block;width:100%;height:clamp(240px,30vw,350px);object-fit:contain;background:#fff;padding:20px}.seat-photo figcaption{font-size:10px;line-height:1.5;color:var(--muted);padding-top:9px}.seat-photo figcaption a{font-weight:600}

  .sources button{font:inherit;padding:12px 18px;border:1px solid currentColor;border-radius:24px;color:var(--ink);background:transparent;cursor:pointer}.sources button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.sources button[hidden]{display:none}.sources button:focus-visible{outline:3px solid var(--rust);outline-offset:4px}
  .seat-card{border-top:2px solid var(--ink);padding:24px 0 0;display:flex;flex-direction:column;min-width:0;scroll-margin-top:90px}.seat-card[hidden]{display:none}.card-top{display:flex;align-items:center;gap:12px;margin-bottom:27px}.number{background:var(--ink);color:var(--paper);width:34px;height:34px;display:grid;place-items:center;border-radius:50%;font-size:12px;font-weight:800}.role{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:800}.maker{font-size:12px;text-transform:uppercase;letter-spacing:.12em;margin:0 0 7px;color:var(--muted)}h3{font-size:clamp(26px,3vw,37px);line-height:1.05;letter-spacing:-.035em;margin:0 0 12px}.price{font-weight:700;color:var(--rust);margin:0 0 24px;font-size:18px}dl{margin:0 0 24px;border-top:1px solid var(--line)}dl>div{display:grid;grid-template-columns:105px 1fr;gap:15px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.45}dt{color:var(--muted)}dd{margin:0;font-weight:600}.packed dd{color:var(--teal)}.description{font-size:16px;line-height:1.7;margin:0 0 20px}.tradeoff{background:var(--tint);padding:17px 19px;margin-top:auto;font-size:13px;line-height:1.65}.tradeoff>span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.tradeoff p{margin:8px 0 0}.sources{display:flex;align-items:center;flex-wrap:wrap;gap:14px;padding:20px 0;font-size:13px;font-weight:700}.sources a{color:var(--ink);text-underline-offset:4px}.sources .extra-source{font-size:11px;color:var(--muted)}a:focus-visible{outline:3px solid var(--rust);outline-offset:5px}
</style>
