---
/**
 * HomeCheckinHint — small one-line band that surfaces /me state on the
 * homepage for visitors who already have local-first identity.
 *
 * Renders nothing for first-time visitors (zero-state stays clean).
 * For returning visitors:
 *   - "✓ checked in today · EL SEGUNDO · FOCUS · 3-day streak" + manage link
 *   - "you haven't checked in today" + check in link
 *
 * Reads localStorage `pc:me:v1` and `pc_streak` on the client. The
 * server side renders a placeholder that JS swaps once state is
 * known — same pattern as StreakBadge.
 *
 * Mounted on /` just below the editorial lead. Compact (~36px tall) so
 * it doesn't disturb the v2027 lead → operating mode → today flow.
 */
---

<aside class="checkin-hint" id="checkin-hint" data-state="hidden" aria-hidden="true">
  <span class="checkin-hint__glyph" id="checkin-hint-glyph" aria-hidden="true">·</span>
  <span class="checkin-hint__body" id="checkin-hint-body">—</span>
  <a class="checkin-hint__cta" id="checkin-hint-cta" href="/me">
    <span id="checkin-hint-cta-label">manage on /me →</span>
  </a>
</aside>

<script is:inline>
(() => {
  const root = document.getElementById('checkin-hint');
  const glyph = document.getElementById('checkin-hint-glyph');
  const body  = document.getElementById('checkin-hint-body');
  const cta   = document.getElementById('checkin-hint-cta');
  const label = document.getElementById('checkin-hint-cta-label');
  if (!root || !body || !cta || !label) return;

  // Mood + area label maps mirror /me.
  const AREAS = {
    'el-segundo': 'EL SEGUNDO', 'manhattan-beach': 'MANHATTAN BEACH',
    'hermosa-beach': 'HERMOSA BEACH', 'redondo-beach': 'REDONDO BEACH',
    'venice': 'VENICE', 'palos-verdes': 'PALOS VERDES',
    'santa-monica': 'SANTA MONICA', 'culver-city': 'CULVER CITY',
    'lax': 'NEAR LAX', 'long-beach': 'LONG BEACH',
    'downtown-la': 'DOWNTOWN LA', 'elsewhere': 'ELSEWHERE',
  };
  const MOODS = {
    chill:'CHILL', hype:'HYPE', focus:'FOCUS',
    flow:'FLOW', curious:'CURIOUS', quiet:'QUIET',
  };

  const todayStr = () => new Date().toISOString().slice(0, 10);
  function fmtDay(iso) {
    if (!iso) return '';
    return new Date(iso).toISOString().slice(0, 10);
  }

  let state = null;
  try {
    const raw = localStorage.getItem('pc:me:v1');
    state = raw ? JSON.parse(raw) : null;
  } catch (e) {}

  // First-time visitors with NO state at all stay quiet on the homepage.
  // The footer dock already advertises onboarding via its YOU chip.
  if (!state || !state.firstVisitAt) return;

  let streak = null;
  try {
    const raw = localStorage.getItem('pc_streak');
    streak = raw ? JSON.parse(raw) : null;
  } catch (e) {}

  const today = todayStr();
  const checkedInToday = state.lastCheckinAt && fmtDay(state.lastCheckinAt) === today;
  const name = (state.name || '').trim();

  if (checkedInToday) {
    const a = AREAS[state.area]   || state.area || '—';
    const m = MOODS[state.mood]   || state.mood || '—';
    const streakText = (streak && streak.current >= 1) ? ` · ${streak.current}-DAY STREAK` : '';
    glyph.textContent = '✓';
    body.innerHTML = `<strong>${name ? 'hey ' + escapeHtml(name) + ', ' : ''}you're checked in today</strong> · ${escapeHtml(a)} · ${escapeHtml(m)}${escapeHtml(streakText)}`;
    label.textContent = 'manage on /me →';
    root.dataset.state = 'checked-in';
  } else {
    glyph.textContent = '○';
    const greet = name ? `welcome back, <strong>${escapeHtml(name)}</strong>` : 'welcome back';
    body.innerHTML = `${greet} — you haven't checked in today yet.`;
    label.textContent = 'check in →';
    root.dataset.state = 'pending';
  }
  root.setAttribute('aria-hidden', 'false');

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
})();
</script>

<style>
  .checkin-hint {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    margin: 0 0 24px;
    border: 1.5px solid var(--color-rule);
    border-radius: 3px;
    background: var(--color-card);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-ink-soft);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .checkin-hint[data-state='hidden'] {
    display: none;
  }
  .checkin-hint[data-state='checked-in'] {
    border-color: var(--color-live, #2f8f5f);
    background: var(--color-live-bg, #e4efe5);
    border-left-width: 4px;
  }
  .checkin-hint[data-state='pending'] {
    border-color: var(--color-warm);
    background: var(--color-card-hover);
    border-left-width: 4px;
  }
  .checkin-hint__glyph {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    background: #fff;
    color: var(--color-ink-soft);
  }
  .checkin-hint[data-state='checked-in'] .checkin-hint__glyph {
    background: var(--color-live, #2f8f5f);
    color: #fff;
  }
  .checkin-hint[data-state='pending'] .checkin-hint__glyph {
    background: var(--color-warm);
    color: #fff;
  }
  .checkin-hint__body {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .checkin-hint__body strong {
    color: var(--color-ink);
    font-weight: 500;
  }
  .checkin-hint__cta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-ink);
    text-transform: uppercase;
    text-decoration: none;
    padding: 4px 10px;
    border: 1px solid var(--color-ink);
    border-radius: 2px;
    transition: background 0.12s, color 0.12s;
    white-space: nowrap;
  }
  .checkin-hint__cta:hover {
    background: var(--color-ink);
    color: #fff;
  }

  @media (max-width: 600px) {
    .checkin-hint { flex-wrap: wrap; }
    .checkin-hint__body { flex-basis: 100%; order: 2; }
    .checkin-hint__cta  { order: 3; margin-left: auto; }
  }
</style>
