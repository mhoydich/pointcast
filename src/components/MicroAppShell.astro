---
import type { PointcastApp } from '../lib/pointcast-apps';

interface Props {
  app: PointcastApp;
  headline: string;
  dek: string;
  images?: { src: string; alt: string }[];
  stats?: { label: string; value: string | number }[];
  links?: { href: string; label: string }[];
}

const { app, headline, dek, images = [], stats = [], links = [] } = Astro.props;
---

<main class="micro-app">
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/apps">apps</a>
    <span aria-hidden="true">/</span>
    <span>{app.slug}</span>
  </nav>

  <header class="micro-hero">
    <div class="micro-hero__copy">
      <p class="kicker">{app.channel} · {app.kicker}</p>
      <h1>{headline}</h1>
      <p>{dek}</p>
      <div class="micro-actions" aria-label={`${app.name} routes`}>
        <a href={app.path}>App</a>
        <a href="/apps">Index</a>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>

    <figure class="micro-hero__visual" aria-label={`${app.name} preview`}>
      {images.length > 0 ? (
        <div class="micro-mosaic" data-count={Math.min(images.length, 6)}>
          {images.slice(0, 6).map((image, index) => (
            <img
              src={image.src}
              alt={image.alt}
              width="1024"
              height="1024"
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      ) : (
        <div class="micro-signal" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      )}
    </figure>
  </header>

  {stats.length > 0 && (
    <section class="micro-stats" aria-label={`${app.name} stats`}>
      {stats.map((stat) => (
        <article>
          <span>{stat.label}</span>
          <strong>{stat.value}</strong>
        </article>
      ))}
    </section>
  )}

  <slot />
</main>

<style>
  .micro-app {
    width: min(1160px, calc(100vw - 28px));
    margin: 0 auto;
    padding: 22px 0 86px;
  }
  .crumb,
  .kicker,
  .micro-actions a,
  .micro-stats span {
    font-family: var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 10px;
    color: var(--pc-ink-muted);
  }
  .micro-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 20px;
    align-items: stretch;
    border-top: 1.5px solid var(--pc-ink);
    border-bottom: 1px solid var(--pc-rule-soft);
    padding: 18px 0 20px;
  }
  .micro-hero__copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .kicker {
    margin: 0 0 12px;
    color: #8A2432;
    font-size: 10px;
  }
  h1 {
    margin: 0;
    max-width: 820px;
    font-size: clamp(42px, 8vw, 92px);
    line-height: 0.94;
    font-weight: 500;
    letter-spacing: 0;
  }
  .micro-hero__copy > p:not(.kicker) {
    max-width: 760px;
    margin: 16px 0 0;
    color: var(--pc-ink-soft);
    font-size: 18px;
    line-height: 1.5;
  }
  .micro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .micro-actions a {
    border: 1px solid var(--pc-ink);
    color: var(--pc-ink);
    padding: 9px 11px;
    font-size: 10px;
  }
  .micro-actions a:hover {
    background: var(--pc-ink);
    color: #fff;
    text-decoration: none;
  }
  .micro-hero__visual {
    margin: 0;
    min-height: 360px;
    border: 1px solid var(--pc-rule-soft);
    background:
      linear-gradient(90deg, rgba(18, 17, 14, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(18, 17, 14, 0.05) 1px, transparent 1px),
      #f8f7f2;
    background-size: 28px 28px;
    overflow: hidden;
  }
  .micro-mosaic {
    height: 100%;
    min-height: 360px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 1px;
    background: var(--pc-ink);
  }
  .micro-mosaic img {
    width: 100%;
    height: 100%;
    min-height: 170px;
    object-fit: cover;
    background: #f5f1e8;
  }
  .micro-mosaic img:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }
  .micro-signal {
    min-height: 360px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--pc-ink);
  }
  .micro-signal span {
    background:
      radial-gradient(circle at 35% 30%, rgba(214, 177, 74, 0.7), transparent 26%),
      linear-gradient(135deg, #eef4f7, #f6eee0 52%, #d7e8de);
  }
  .micro-signal span:nth-child(2) { background: linear-gradient(135deg, #173345, #6a95a8); }
  .micro-signal span:nth-child(3) { background: linear-gradient(135deg, #f2d6c5, #b9493e); }
  .micro-signal span:nth-child(4) { background: linear-gradient(135deg, #f5f2df, #2d8a59); }
  .micro-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 14px 0;
  }
  .micro-stats article {
    min-width: 0;
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 12px;
  }
  .micro-stats span {
    display: block;
    margin-bottom: 8px;
    font-size: 9px;
    color: var(--pc-ink-muted);
  }
  .micro-stats strong {
    display: block;
    overflow-wrap: anywhere;
    font-size: 24px;
    line-height: 1;
    font-weight: 500;
  }
  :global(.app-section) {
    margin-top: 14px;
    border-top: 1px solid var(--pc-rule-soft);
    padding-top: 14px;
  }
  :global(.app-section h2) {
    margin: 0 0 10px;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    font-weight: 500;
  }
  :global(.tool-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  :global(.tool-panel) {
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 14px;
    min-width: 0;
  }
  :global(.tool-panel--ink) {
    background: #171510;
    border-color: #171510;
    color: #f6f1e4;
  }
  :global(.tool-panel p) {
    color: var(--pc-ink-soft);
    line-height: 1.5;
  }
  :global(.tool-panel--ink p) {
    color: rgba(246, 241, 228, 0.78);
  }
  :global(.field-stack) {
    display: grid;
    gap: 10px;
  }
  :global(label) {
    display: grid;
    gap: 6px;
    color: var(--pc-ink-muted);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  :global(input),
  :global(select),
  :global(textarea) {
    width: 100%;
    border: 1px solid var(--pc-rule);
    border-radius: 0;
    background: #fff;
    color: var(--pc-ink);
    font: inherit;
    letter-spacing: 0;
    padding: 10px;
  }
  :global(textarea) {
    min-height: 92px;
    resize: vertical;
  }
  :global(button),
  :global(.app-button) {
    border: 1px solid var(--pc-ink);
    background: #fff;
    color: var(--pc-ink);
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 9px 11px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  :global(button:hover),
  :global(.app-button:hover) {
    background: var(--pc-ink);
    color: #fff;
    text-decoration: none;
  }
  :global(button:disabled) {
    cursor: not-allowed;
    opacity: 0.55;
  }
  :global(.button-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  :global(.mono-note) {
    font-family: var(--pc-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 10px;
  }
  :global(.ledger-list) {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.ledger-list li) {
    border: 1px solid rgba(18, 17, 14, 0.12);
    padding: 10px;
    background: rgba(255, 255, 255, 0.72);
  }
  @media (max-width: 840px) {
    .micro-app {
      width: min(100% - 20px, 1160px);
      padding-top: 16px;
    }
    .micro-hero,
    :global(.tool-grid) {
      grid-template-columns: 1fr;
    }
    .micro-hero__visual,
    .micro-mosaic,
    .micro-signal {
      min-height: 260px;
    }
    .micro-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    h1 {
      font-size: clamp(38px, 13vw, 68px);
    }
  }
  @media (max-width: 520px) {
    .micro-stats {
      grid-template-columns: 1fr;
    }
    .micro-mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .micro-mosaic img:first-child {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
