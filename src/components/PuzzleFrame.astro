---
import BlockLayout from '../layouts/BlockLayout.astro';
import '../styles/puzzles.css';
interface Props { title: string; description: string; active?: string; image?: string; }
const {title, description, active = 'world', image = '/images/puzzles/01-tidepool-atlas.webp'} = Astro.props;
const links = [['world','/puzzles/','The puzzle world'],['make','/puzzles/make/','Make a puzzle'],['shop','/shop/puzzles/','The puzzle shelf'],['business','/puzzles/business/','Business lab'],['studio','/puzzles/studio/','Design school']];
---
<BlockLayout title={`${title} · PointCast`} description={description} image={image} hideAds immersive isolated jsonLd={{'@context':'https://schema.org','@type':'WebPage',name:title,description,url:`https://pointcast.xyz${Astro.url.pathname}`,isPartOf:{'@type':'WebSite',name:'PointCast',url:'https://pointcast.xyz'}}} alternates={[{type:'application/json',href:'/puzzles.json',title:'Puzzle concepts, sources and study data'}]}>
  <div class="p-world">
    <a class="p-skip" href="#p-content">Skip to content</a>
    <header class="p-mast"><a class="p-mark" href="/">POINTCAST <span>PUZZLES</span></a><a href="/shop/front">PointCast Store ↗</a></header>
    <nav class="p-nav" aria-label="Puzzle feature">{links.map(([id,href,label])=><a href={href} aria-current={active===id?'page':undefined}>{label}</a>)}</nav>
    <div id="p-content"><slot /></div>
    <footer class="p-footer"><div><p class="eyebrow">A POINTCAST FIELD OF PLAY · 2027 CONCEPT COLLECTION</p><p>Ten original AI-generated artwork studies for a proposed 2027 collection. Research and supplier observations are dated October 3, 2026. Proposed physical products, with no inventory or orders available. External shops handle their own purchases and terms.</p></div><div><a href="/puzzles/#sources">Sources & method</a><a href="/puzzles.json">Read the data</a><a href="/ues">University of El Segundo</a><a href="/communications-lab/">Industry Next Communications Lab</a></div></footer>
  </div>
</BlockLayout>
