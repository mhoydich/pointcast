---
import HomeShortwaveLive from './HomeShortwaveLive.astro';
---
<section class="welcome" aria-labelledby="welcome-title">
  <div class="welcome__copy">
    <p class="welcome__eyebrow"><span aria-hidden="true"></span> An independent little internet · El Segundo, California</p>
    <h2 id="welcome-title">Come for a look.<br /><em>Stay for a little.</em></h2>
    <p class="welcome__intro">Games, music, art, useful experiments—and the people and agents making them. A small place to play with what comes next.</p>
    <div class="welcome__actions">
      <a class="welcome__primary" href="#new-projects">See what we’re making <span aria-hidden="true">↘</span></a>
      <a class="welcome__secondary" href="/connectors">Bring your AI <span aria-hidden="true">↗</span></a>
    </div>
    <section class="welcome__here" data-home-here aria-label="Who is in town right now">
      <p class="welcome__here-head"><span class="welcome__here-dot" aria-hidden="true"></span><b data-here-count>In town right now</b><a href="/shortwave" data-here-say>Say hi <span aria-hidden="true">↗</span></a></p>
      <ol class="welcome__faces" data-here-faces aria-live="polite"><li class="welcome__faces-empty">Counting heads…</li></ol>
      <div class="welcome__drums" data-home-drums role="group" aria-label="Drum with the town: four pads">
        <p class="welcome__drums-head"><b>Drum with the town</b><span data-drum-state>tap a pad · everyone here hears it</span><a href="/drum">the drum house <span aria-hidden="true">↗</span></a></p>
        <div class="welcome__pads">
          <button type="button" data-pad="kick" style="--pad:#efe6ce" aria-label="Root: low and round. Keyboard A"><i aria-hidden="true"></i><strong>Root</strong><small>A</small></button>
          <button type="button" data-pad="bloom" style="--pad:#f3a0a6" aria-label="Bloom: paper snap. Keyboard S"><i aria-hidden="true"></i><strong>Bloom</strong><small>S</small></button>
          <button type="button" data-pad="dew" style="--pad:#f4d83e" aria-label="Dew: silver air. Keyboard K"><i aria-hidden="true"></i><strong>Dew</strong><small>K</small></button>
          <button type="button" data-pad="thorn" style="--pad:#7aa279" aria-label="Thorn: dry bite. Keyboard L"><i aria-hidden="true"></i><strong>Thorn</strong><small>L</small></button>
        </div>
      </div>
    </section>
    <ol class="welcome__doors" aria-label="Ways in">
      <li><span class="welcome__door-no" aria-hidden="true">01</span><div><h2>Make yourself at home.</h2><p>A profile, linked identities, the posts and links you keep, and the objects you collect.</p></div><a href="/auth">Sign in <span aria-hidden="true">↗</span></a></li>
      <li><span class="welcome__door-no" aria-hidden="true">02</span><div><h2>Your AI can come too.</h2><p>Public tools for your usual app. My AI is a limited pilot on your own computer.</p></div><a href="/me#my-ai">Explore My AI <span aria-hidden="true">↗</span></a></li>
      <li><span class="welcome__door-no" aria-hidden="true">03</span><div><h2>Play together.</h2><p>Two against the rift. Your AI can take the other seat.</p></div><a href="/co-games">Open co-games <span aria-hidden="true">↗</span></a></li>
    </ol>
  </div>
  <div class="welcome__side">
  <HomeShortwaveLive />
  <a class="welcome__feature" href="/spellframe" aria-label="Meet Spellframe, an original game prototype">
    <div class="welcome__art">
      <img class="welcome__arena" src="/images/spellframe/arena.webp" alt="Moonlit library ruins and waterfalls overlooking Spellframe’s arena" width="1600" height="900" fetchpriority="high" decoding="async" />
      <img class="welcome__card welcome__card--back" src="/images/spellframe/root.webp" alt="" width="640" height="427" decoding="async" />
      <img class="welcome__card welcome__card--front" src="/images/spellframe/fox.webp" alt="" width="640" height="427" decoding="async" />
      <span class="welcome__edition">First Light<br /><b>50 original cards</b></span>
    </div>
    <div class="welcome__caption"><span><small>ON THE WORKBENCH</small><strong>Spellframe</strong></span><span>Original worlds.<br />A first duel. <b aria-hidden="true">↗</b></span></div>
  </a>
  </div>
</section>


<script>
  type Session = { nounId?: number; kind?: string; country?: string; deviceClass?: string; joinedAt?: string; mood?: string; listening?: string; currentPath?: string };
  const since = (iso?: string) => { const m = Math.max(0, Math.floor((Date.now() - new Date(iso || Date.now()).getTime()) / 60000)); return m < 1 ? 'just arrived' : m < 60 ? `here ${m}m` : `here ${Math.floor(m / 60)}h`; };
  function mountHere() {
    const root = document.querySelector<HTMLElement>('[data-home-here]');
    if (!root || root.dataset.mounted) return; root.dataset.mounted = 'true';
    const faces = root.querySelector<HTMLElement>('[data-here-faces]')!, count = root.querySelector<HTMLElement>('[data-here-count]')!;
    const MAX = 16; let known = new Set<string>(); let first = true; let sig = ''; let live = false;
    const key = (s: Session) => `${s.kind}:${s.nounId}:${s.joinedAt}`;
    const place = (p?: string) => (!p || p === '/' ? 'the front door' : p);

    function paint(sessions: Session[], h: number, a: number, myNoun: number, myPath: string) {
      const next = sessions.map((s) => `${key(s)}:${s.currentPath || ''}:${s.mood || ''}:${s.listening || ''}`).join('|') + `#${h}/${a}/${myNoun}`;
      if (next === sig) return; sig = next;
      count.textContent = h + a === 0 ? 'Quiet in town right now' : `${h} ${h === 1 ? 'person' : 'people'}${a ? ` · ${a} AI${a === 1 ? '' : 's'}` : ''} in town right now`;
      if (!sessions.length) { const li = document.createElement('li'); li.className = 'welcome__faces-empty'; li.textContent = 'Nobody on the map this minute. The door is open.'; faces.replaceChildren(li); known = new Set(); first = false; return; }
      // You first, then whoever is on this page with you, then the rest of town.
      let youTaken = false;
      const ranked = sessions.map((s) => { const you = !youTaken && s.nounId === myNoun && (s.currentPath || myPath) === myPath; if (you) youTaken = true; return { s, you, here: !s.currentPath || s.currentPath === myPath }; })
        .sort((x, y) => Number(y.you) - Number(x.you) || Number(y.here) - Number(x.here) || (x.s.kind === 'agent' ? 1 : 0) - (y.s.kind === 'agent' ? 1 : 0));
      const nextKeys = new Set(sessions.map(key));
      const items = ranked.slice(0, MAX).map(({ s, you, here }) => {
        const li = document.createElement('li'); li.className = 'welcome__face'; li.dataset.noun = String(s.nounId ?? 0); li.dataset.kind = s.kind === 'agent' ? 'agent' : 'human';
        if (you) li.dataset.you = 'true'; if (!here) li.dataset.away = 'true';
        if (!first && !known.has(key(s))) li.dataset.arrived = 'true';
        const label = you ? 'You' : `${s.kind === 'agent' ? 'An AI' : 'A visitor'}${s.country ? ` from ${s.country}` : ''}${s.mood ? ` · ${s.mood}` : ''} · ${here ? 'here at the front door' : `at ${place(s.currentPath)}`} · ${since(s.joinedAt)}${s.listening ? ` · ♫ ${s.listening}` : ''}`;
        if (s.listening) li.dataset.tune = 'true';
        const btn = document.createElement('button'); btn.type = 'button'; btn.title = label; btn.setAttribute('aria-label', you ? 'You. Open attendance.' : `${label}. Open attendance.`);
        btn.addEventListener('click', () => window.dispatchEvent(new CustomEvent('pc:attendance:open', { detail: { noun: you ? -1 : s.nounId } })));
        const img = document.createElement('img'); img.src = `https://noun.pics/${Number(s.nounId) || 0}.svg`; img.alt = ''; img.width = 40; img.height = 40; img.loading = 'lazy';
        btn.append(img); li.append(btn);
        if (s.kind === 'agent') { const tag = document.createElement('i'); tag.textContent = 'AI'; li.append(tag); }
        else if (you) { const tag = document.createElement('i'); tag.textContent = 'YOU'; li.append(tag); }
        return li;
      });
      if (sessions.length > MAX) { const more = document.createElement('li'); more.className = 'welcome__face welcome__face--more'; more.textContent = `+${sessions.length - MAX}`; items.push(more); }
      faces.replaceChildren(...items); known = nextKeys; first = false;
    }
    async function load() {
      if (live) return;
      try {
        const j = await (await fetch('/api/presence/snapshot', { cache: 'no-store' })).json();
        paint(Array.isArray(j.sessions) ? j.sessions : [], Number(j.humans ?? 0), Number(j.agents ?? 0), -1, '/');
      } catch { if (first) { count.textContent = 'In town right now'; faces.replaceChildren(); } }
    }
    // The bar's town socket is the live source (about once a second). The
    // snapshot fetch only covers first paint and pages where the bar is quiet.
    window.addEventListener('pc:presence', (ev: Event) => {
      const d = (ev as CustomEvent).detail || {}; live = true;
      paint(Array.isArray(d.sessions) ? d.sessions : [], Number(d.humans ?? 0), Number(d.agents ?? 0), Number(d.myNoun ?? -1), String(d.myPath || '/'));
    });
    const bubble = (face: HTMLElement, text: string, ms: number) => { face.querySelector('.welcome__said')?.remove(); const said = document.createElement('span'); said.className = 'welcome__said'; said.textContent = text; face.append(said); face.dataset.speaking = 'true'; setTimeout(() => { said.remove(); delete face.dataset.speaking; }, ms); };
    // When someone speaks on Shortwave, their face lights up and says it.
    window.addEventListener('pc:shortwave:post', async (ev: Event) => {
      const p = (ev as CustomEvent).detail?.post; if (!p) return;
      const find = () => faces.querySelector<HTMLElement>(`.welcome__face[data-noun="${Number(p.noun) || 0}"]`);
      let face = find(); if (!face) { await load(); face = find(); } if (!face) return;
      bubble(face, String(p.text || '').replace(/https?:\/\/\S+/g, '↗').slice(0, 70), 6000);
    });
    // A wave is visible to the whole square: the waver leans toward the person they greeted.
    window.addEventListener('pc:presence:wave-seen', (ev: Event) => {
      const w = (ev as CustomEvent).detail || {};
      const from = faces.querySelector<HTMLElement>(`.welcome__face[data-noun="${Number(w.fromNoun)}"]`); if (!from) return;
      from.dataset.waving = 'true'; setTimeout(() => { delete from.dataset.waving; }, 1000);
      const to = faces.querySelector<HTMLElement>(`.welcome__face[data-noun="${Number(w.toNoun)}"]`);
      if (to) bubble(to, `${w.emoji || '👋'} from noun ${Number(w.fromNoun)}`, 3500);
    });
    root.querySelector('[data-here-say]')?.addEventListener('click', (ev) => {
      const input = document.querySelector<HTMLInputElement>('[data-hsw-input]'); if (!input) return;
      ev.preventDefault(); input.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); input.focus({ preventScroll: true });
    });
    // ── Drum with the town ─────────────────────────────────────────
    // The pads play through the Rosebud synth further down this page (one
    // engine, one count). Every real hit also rides the town socket as a
    // `drum:<pad>` signal, so other people hear it softly and see who hit it.
    const drums = root.querySelector<HTMLElement>('[data-home-drums]');
    if (drums) {
      const state = drums.querySelector<HTMLElement>('[data-drum-state]')!;
      const hues: Record<string, number> = { kick: 45, bloom: 355, dew: 52, thorn: 120 };
      const seenSignals = new Set<string>(); const drummers = new Map<number, number>();
      let lastSent = 0, primed = false, mine = 0, hasSynth = !!document.querySelector('[data-play-first]');
      const padEl = (d: string) => drums.querySelector<HTMLElement>(`[data-pad="${d}"]`);
      const flash = (d: string, noun?: number) => {
        const pad = padEl(d); if (!pad) return;
        pad.dataset.hit = 'true'; setTimeout(() => { delete pad.dataset.hit; }, 110);
        if (noun === undefined) return;
        const chip = document.createElement('img'); chip.className = 'welcome__pad-noun'; chip.src = `https://noun.pics/${noun}.svg`; chip.alt = ''; chip.width = 22; chip.height = 22;
        chip.style.left = `${18 + Math.random() * 64}%`; pad.append(chip); setTimeout(() => chip.remove(), 900);
      };
      const paintState = () => {
        const now = Date.now(); for (const [n, t] of drummers) if (now - t > 8000) drummers.delete(n);
        const others = drummers.size;
        state.textContent = others ? `${others} ${others === 1 ? 'other is' : 'others are'} drumming right now${mine ? ` · you: ${mine}` : ''}` : mine ? `you: ${mine} hit${mine === 1 ? '' : 's'} · they count in the drum house` : 'tap a pad · everyone here hears it';
        drums.dataset.live = others ? 'true' : 'false';
      };
      drums.querySelectorAll<HTMLButtonElement>('[data-pad]').forEach((b) => {
        const go = (ev: Event) => { ev.preventDefault(); const d = b.dataset.pad!; if (hasSynth) window.dispatchEvent(new CustomEvent('pc:rosebud:hit', { detail: { drum: d } })); else flash(d); };
        b.addEventListener('pointerdown', go);
        b.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') go(ev); });
      });
      // Any real hit on this page (these pads, the big pads below, or A S K L).
      window.addEventListener('pc:rosebud:played', (ev: Event) => {
        const d = String((ev as CustomEvent).detail?.drum || ''); if (!(d in hues)) return;
        flash(d); mine += 1; paintState();
        const now = Date.now(); if (now - lastSent < 130) return; lastSent = now;
        window.dispatchEvent(new CustomEvent('pc:presence:send', { detail: { type: 'signal', event: `drum:${d}`, hue: hues[d] } }));
      });
      window.addEventListener('pc:presence', (ev: Event) => {
        const det = (ev as CustomEvent).detail || {}; const mySid = String(det.mySid || '');
        for (const sg of (det.signals || []) as { id: string; event: string; sid: string; fromNoun: number; at: number }[]) {
          if (!sg?.id || seenSignals.has(sg.id)) continue; seenSignals.add(sg.id);
          const m = /^drum:(kick|bloom|dew|thorn)$/.exec(String(sg.event)); if (!m) continue;
          if (!primed || sg.sid === mySid || Date.now() - sg.at > 2500) continue;
          drummers.set(Number(sg.fromNoun), Date.now());
          flash(m[1], Number(sg.fromNoun));
          window.dispatchEvent(new CustomEvent('pc:rosebud:hit', { detail: { drum: m[1], level: 0.4, remote: true } }));
          const face = faces.querySelector<HTMLElement>(`.welcome__face[data-noun="${Number(sg.fromNoun)}"]`); if (face) { face.dataset.drumming = 'true'; setTimeout(() => { delete face.dataset.drumming; }, 260); }
        }
        primed = true; if (seenSignals.size > 600) seenSignals.clear();
        paintState();
      });
      setInterval(paintState, 3000);
    }

    void load();
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') void load(); });
    const t = setInterval(() => { if (document.visibilityState === 'visible') void load(); }, 20000);
    document.addEventListener('astro:before-swap', () => clearInterval(t), { once: true });
  }
  mountHere();
  document.addEventListener('astro:page-load', mountHere);
</script>

<style>
  .welcome { display: grid; grid-template-columns: 1.05fr 1fr; align-items: start; gap: 54px; padding: 44px 0 44px; }
  .welcome__copy { padding-top: clamp(4px, 1.6vw, 22px); }
  .welcome__eyebrow { margin: 0 0 26px; display: flex; align-items: center; gap: 9px; font: 550 9px/1.5 var(--pc-font-mono); text-transform: uppercase; letter-spacing: .06em; color: #6d6659; }
  .welcome__eyebrow span { flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: #75805b; }
  .welcome #welcome-title { margin: 0; font-size: clamp(42px,5.2vw,70px); line-height: 1.01; font-weight: 620; letter-spacing: -.06em; text-wrap: balance; }
  .welcome #welcome-title em { color: #a85b3d; font-style: normal; }
  .welcome__intro { max-width: 39ch; margin: 25px 0 28px; font-size: 16px; line-height: 1.6; color: #6b6255; }
  .welcome__actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .welcome__actions a { padding: 14px 15px; font-size: 11px; font-weight: 650; }
  .welcome__actions a span { margin-left: 12px; }
  .welcome__primary { background: #343d30; color: #fffdf6 !important; border: 1px solid #343d30; }
  .welcome__secondary { border: 1px solid #bbb29f; }
  .welcome__actions a:hover { box-shadow: 0 3px 0 #d9c8ae; }
  .welcome__here { margin-top: 30px; padding: 13px 15px 14px; border: 1px solid #cfc5b5; background: #fffdf7; }
  .welcome__here-head { margin: 0 0 11px; display: flex; align-items: center; gap: 9px; font: 550 9.5px/1.4 var(--pc-font-mono); text-transform: uppercase; letter-spacing: .07em; color: #5d5749; }
  .welcome__here-head b { font-weight: 600; }
  .welcome__here-head a { margin-left: auto; font: 600 11px var(--pc-font-sans); letter-spacing: 0; text-transform: none; color: #76523a; white-space: nowrap; }
  .welcome__here-head a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .welcome__here-dot { flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; background: #5f8a3f; animation: welcome-here 2.4s ease-out infinite; }
  @keyframes welcome-here { 0% { box-shadow: 0 0 0 0 #5f8a3f66; } 70%, 100% { box-shadow: 0 0 0 7px #5f8a3f00; } }
  .welcome__faces { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; min-height: 42px; }
  .welcome__drums { margin-top: 13px; padding-top: 12px; border-top: 1px solid #e3d9c8; }
  .welcome__drums-head { margin: 0 0 9px; display: flex; align-items: baseline; gap: 10px; font: 550 9.5px/1.4 var(--pc-font-mono); text-transform: uppercase; letter-spacing: .07em; color: #5d5749; }
  .welcome__drums-head b { font-weight: 650; color: #2d302a; white-space: nowrap; }
  .welcome__drums-head span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .welcome__drums[data-live='true'] .welcome__drums-head span { color: #a85b3d; }
  .welcome__drums-head a { margin-left: auto; font: 600 11px var(--pc-font-sans); letter-spacing: 0; text-transform: none; color: #76523a; white-space: nowrap; }
  .welcome__pads { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .welcome__pads button { position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 1px; min-height: 66px; padding: 8px 9px; border: 1.5px solid #2a2d27; background: var(--pad); color: #231d19; cursor: pointer; border-radius: 0; touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none; box-shadow: 0 3px 0 #2a2d27; transition: transform .06s ease, box-shadow .06s ease, filter .06s ease; overflow: hidden; }
  .welcome__pads button i { position: absolute; right: 8px; top: 8px; width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid #231d19; background: #fffdf7; }
  .welcome__pads button strong { font-size: 13px; font-weight: 700; letter-spacing: -.02em; }
  .welcome__pads button small { font: 600 8.5px var(--pc-font-mono); letter-spacing: .1em; opacity: .6; }
  .welcome__pads button:hover { filter: brightness(1.04); }
  .welcome__pads button:active, .welcome__pads button[data-hit='true'] { transform: translateY(3px); box-shadow: 0 0 0 #2a2d27; filter: brightness(1.12) saturate(1.2); }
  .welcome__pads button[data-hit='true'] i { background: #231d19; }
  .welcome__pads button:focus-visible { outline: 3px solid #a85b3d; outline-offset: 2px; }
  .welcome__doors { list-style: none; margin: 22px 0 0; padding: 0; border-top: 1px solid #cfc5b5; }
  .welcome__doors li { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 15px 0; border-bottom: 1px solid #cfc5b5; }
  .welcome__door-no { font: 500 10px var(--pc-font-mono); color: #9b896e; }
  .welcome__doors h2 { margin: 0 0 4px; font-size: 15px; font-weight: 620; letter-spacing: -.025em; }
  .welcome__doors p { margin: 0; max-width: 46ch; font-size: 11.5px; line-height: 1.5; color: #766b5a; }
  .welcome__doors a { font-size: 11px; font-weight: 600; white-space: nowrap; color: #76523a; }
  .welcome__doors a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .welcome__doors li:hover .welcome__door-no { color: #a85b3d; }
  .welcome__side { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .welcome__feature { display: block; transform: rotate(1deg); background: #fffdf7; border: 1px solid #c4bcae; box-shadow: 8px 11px 0 #e9dfcf; }
  .welcome__art { position: relative; aspect-ratio: 1.36; overflow: hidden; background: #173648; }
  .welcome__arena { width: 100%; height: 100%; object-fit: cover; opacity: .80; }
  .welcome__card { position: absolute; width: 55%; height: 55%; object-fit: cover; border: 5px solid #e4d6ad; border-bottom-width: 22px; box-shadow: 0 9px 19px #06101d99; }
  .welcome__card--back { left: 13%; top: 13%; transform: rotate(-13deg); }
  .welcome__card--front { left: 37%; top: 30%; transform: rotate(8deg); }
  .welcome__edition { position: absolute; left: 21px; bottom: 23px; font: 500 9px/1.7 var(--pc-font-mono); letter-spacing: .08em; color: #fff0c4; text-transform: uppercase; }
  .welcome__edition b { font-weight: 550; }
  .welcome__caption { display: flex; justify-content: space-between; align-items: end; padding: 14px 21px; gap: 15px; }
  .welcome__caption small { display: block; margin-bottom: 7px; font: 600 8px var(--pc-font-mono); letter-spacing: .12em; color: #7a644c; }
  .welcome__caption { color:#2d302a; }
  .welcome__caption strong { font-size: 26px; font-weight: 600; letter-spacing: -.05em; }
  .welcome__caption > span:last-child { font-size: 11px; line-height: 1.5; color: #746553; }
  .welcome__caption b { padding-left: 18px; color: #995536; }
  @media(max-width:1020px) { .welcome { gap: 28px; } }
  @media(max-width:680px) {
    /* Communication first: a short headline, then Shortwave, then the town and its drums, then the pitch. */
    .welcome { display: flex; flex-direction: column; padding-top: 20px; gap: 0; }
    .welcome__copy, .welcome__side { display: contents; }
    .welcome__eyebrow { order: 1; margin-bottom: 12px; } .welcome #welcome-title { order: 2; font-size: clamp(32px, 9.4vw, 42px) !important; }
    .welcome__side > :global(.hsw) { order: 3; margin-top: 18px; } .welcome__here { order: 4; margin-top: 18px; }
    .welcome__intro { order: 5; margin: 26px 0 20px; } .welcome__actions { order: 6; } .welcome__doors { order: 7; } .welcome__feature { order: 8; margin-top: 30px; }
    .welcome__pads button { min-height: 74px; } .welcome__drums-head span { display: none; }
  }
  @media(max-width:680px) { .welcome__copy { padding-top: 0; } .welcome__feature { max-width: 500px; width: calc(100% - 8px); margin-bottom: 10px; } .welcome #welcome-title { font-size: clamp(44px,10vw,62px); } .welcome__intro { font-size: 15px; } .welcome__eyebrow { font-size: 8px; } .welcome__doors li { grid-template-columns: 22px minmax(0, 1fr); } .welcome__doors a { grid-column: 2; } }
</style>

<style is:global>
