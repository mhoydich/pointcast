---
/**
 * HomeStartHere — orientation for a first-time visitor.
 * One paragraph, six evergreen doors from the back catalog, four utility links.
 * Every door is a long-lived room, not a dated edition. Ordered by the scoreboard: the drum leads because it is the room strangers actually use.
 */
interface Props { blockCount: number }
const { blockCount } = Astro.props;

const doors = [
  { href: '/coffee', tag: 'CAFE', title: 'Pour a cup', note: 'The town coffee pot. Pour, count cups, claim a mug on Tezos if you like.', noun: 12, color: '#7a4b1c' },
  { href: '/window', tag: 'WINDOW', title: 'Look outside', note: 'A window onto live El Segundo weather, sky, and marine layer.', noun: 105, color: '#185FA5' },
  { href: '/race', tag: 'RACE', title: 'Run the daily race', note: 'A short race at the front door. New every day, no account.', noun: 271, color: '#993C1D' },
  { href: '/bell-choir', tag: 'BELLS', title: 'Ring with strangers', note: 'A multiplayer bell wall. Whoever else is here rings back.', noun: 496, color: '#3B6D11' },
  { href: '/win95-games', tag: 'ARCADE', title: 'Play the arcade', note: 'A Win95 desktop of small games. Double-click an icon.', noun: 486, color: '#0B3E73' },
  { href: '/drum', tag: 'DRUM', title: 'Hit the drum', note: 'The most-used room in town: 26,000+ public hits. Rhythm games, a shared beat, bells, trophies.', noun: 115, color: '#6B2139' },
];

const utilities = [
  { href: '/rooms', label: 'All rooms' },
  { href: '/apps', label: 'App shelf' },
  { href: '/25/magazine', label: 'The magazine' },
  { href: '/for-agents', label: 'For agents' },
];
---

<section class="start-here" aria-labelledby="start-here-title">
  <div class="start-here__intro">
    <p class="start-here__eyebrow">First time here? · Start here</p>
    <h2 id="start-here-title">A small internet town, <em>broadcasting from El Segundo.</em></h2>
    <p class="start-here__body">
      PointCast is {blockCount} numbered blocks and a few dozen rooms, made in public by
      Mike and three resident agents. Some of it is a magazine, some of it is a game,
      some of it is a bell you can ring. Nothing needs an account. Pick a door.
    </p>
    <ul class="start-here__utilities" aria-label="More ways in">
      {utilities.map((u) => <li><a href={u.href}>{u.label} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  </div>
  <ol class="start-here__doors" aria-label="Six evergreen doors">
    {doors.map((d, i) => (
      <li>
        <a href={d.href} style={`--door-color:${d.color}`}>
          <span class="start-here__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <img src={`https://noun.pics/${d.noun}.svg`} alt="" width="96" height="96" loading="lazy" decoding="async" />
          <span class="start-here__tag">{d.tag}</span>
          <strong>{d.title}</strong>
          <small>{d.note}</small>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .start-here {
    --sh-paper: #fffdf6;
    --sh-ink: #111;
    display: grid;
    grid-template-columns: minmax(280px, .9fr) minmax(0, 1.6fr);
    margin-top: 16px;
    border: 2px solid var(--sh-ink);
    background: var(--sh-paper);
    color: var(--sh-ink);
    box-shadow: 7px 7px 0 #185FA5;
  }
  .start-here__intro { padding: clamp(24px, 4vw, 44px); border-right: 2px solid var(--sh-ink); display: flex; flex-direction: column; gap: 16px; }
  .start-here__eyebrow { margin: 0; font: 700 9px var(--pc-font-mono); letter-spacing: .13em; text-transform: uppercase; color: #185FA5; }
  .start-here h2 { margin: 0; font-size: clamp(28px, 3vw, 40px); font-weight: 730; line-height: .98; letter-spacing: -.04em; }
  .start-here h2 em { font-style: normal; color: #993C1D; }
  .start-here__body { margin: 0; max-width: 46ch; font-size: 15px; line-height: 1.5; }
  .start-here__utilities { display: flex; flex-wrap: wrap; gap: 6px; margin: auto 0 0; padding: 0; list-style: none; }
  .start-here__utilities a { display: inline-block; padding: 8px 10px; border: 1px solid var(--sh-ink); font: 700 9px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--sh-ink); }
  .start-here__utilities a:hover { background: var(--sh-ink); color: var(--sh-paper); text-decoration: none; }
  .start-here__doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .start-here__doors li { border-right: 1px solid rgba(0,0,0,.18); border-bottom: 1px solid rgba(0,0,0,.18); }
  .start-here__doors li:nth-child(3n) { border-right: 0; }
  .start-here__doors li:nth-child(n+4) { border-bottom: 0; }
  .start-here__doors a { position: relative; display: grid; grid-template-columns: 56px 1fr; grid-template-rows: auto auto auto; align-content: start; column-gap: 12px; row-gap: 3px; height: 100%; padding: 18px 16px 16px; color: var(--sh-ink); background: transparent; transition: background .15s; }
  .start-here__doors a:hover { background: color-mix(in srgb, var(--door-color) 12%, var(--sh-paper)); text-decoration: none; }
  .start-here__doors img { grid-row: 1 / span 3; width: 56px; height: 56px; image-rendering: pixelated; border: 1px solid var(--sh-ink); background: #fff; }
  .start-here__num { position: absolute; top: 8px; right: 10px; font: 700 8px var(--pc-font-mono); color: rgba(0,0,0,.45); }
  .start-here__tag { font: 700 8px var(--pc-font-mono); letter-spacing: .12em; color: var(--door-color); }
  .start-here__doors strong { font-size: 16px; line-height: 1.15; letter-spacing: -.02em; }
  .start-here__doors small { font-size: 11.5px; line-height: 1.35; color: rgba(0,0,0,.72); }
  @media (max-width: 880px) {
    .start-here { grid-template-columns: 1fr; }
    .start-here__intro { border-right: 0; border-bottom: 2px solid var(--sh-ink); }
    .start-here__doors { grid-template-columns: repeat(2, 1fr); }
    .start-here__doors li:nth-child(3n) { border-right: 1px solid rgba(0,0,0,.18); }
    .start-here__doors li:nth-child(2n) { border-right: 0; }
    .start-here__doors li:nth-child(n+4) { border-bottom: 1px solid rgba(0,0,0,.18); }
    .start-here__doors li:nth-child(n+5) { border-bottom: 0; }
  }
  @media (max-width: 560px) {
    .start-here { box-shadow: 4px 4px 0 #185FA5; }
    .start-here__doors { grid-template-columns: 1fr; }
    .start-here__doors li { border-right: 0 !important; border-bottom: 1px solid rgba(0,0,0,.18) !important; }
    .start-here__doors li:last-child { border-bottom: 0 !important; }
  }
</style>
