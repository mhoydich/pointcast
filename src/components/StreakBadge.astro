---
/**
 * StreakBadge — consecutive-days visit counter.
 *
 * Reads/writes localStorage key `pc_streak` as JSON:
 *   { current, longest, lastVisit }   // lastVisit is YYYY-MM-DD
 *
 * On load:
 *   - lastVisit === today           → no change
 *   - lastVisit === yesterday       → current += 1
 *   - lastVisit older / missing     → current = 1
 * Then longest = max(longest, current). All client-side — no SSR.
 *
 * Two render variants:
 *   variant="compact"  → masthead pill, "DAY n"
 *   variant="full"     → /profile card, current + longest
 */
interface Props {
  variant?: 'compact' | 'full';
}
const { variant = 'compact' } = Astro.props;
---

{variant === 'compact' && (
  <span class="pc-streak pc-streak--compact" id="pc-streak-compact" data-initial="off">
    <span class="pc-streak__sep" aria-hidden="true">·</span>
    <span class="pc-streak__pill">
      <span class="pc-streak__label">DAY</span>
      <span class="pc-streak__value" id="pc-streak-current">—</span>
    </span>
  </span>
)}

{variant === 'full' && (
  <section class="pc-streak pc-streak--full" id="pc-streak-full" aria-label="Visit streak" data-initial="off">
    <p class="pc-streak__kicker">VISIT STREAK · CONSECUTIVE DAYS</p>
    <div class="pc-streak__stats">
      <div class="pc-streak__stat">
        <span class="pc-streak__stat-label">CURRENT</span>
        <strong class="pc-streak__stat-value" id="pc-streak-current">—</strong>
        <span class="pc-streak__stat-unit">DAYS</span>
      </div>
      <div class="pc-streak__stat">
        <span class="pc-streak__stat-label">LONGEST</span>
        <strong class="pc-streak__stat-value" id="pc-streak-longest">—</strong>
        <span class="pc-streak__stat-unit">DAYS</span>
      </div>
    </div>
    <p class="pc-streak__note" id="pc-streak-note">Stored in this browser only · localStorage key <code>pc_streak</code></p>
  </section>
)}

<script>
  (() => {
    const KEY = 'pc_streak';

    function todayYMD(): string {
      // Local-date YYYY-MM-DD so the "calendar day" matches the visitor's wall clock.
      const d = new Date();
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    }

    function daysBetween(aYMD: string, bYMD: string): number {
      const [ay, am, ad] = aYMD.split('-').map(Number);
      const [by, bm, bd] = bYMD.split('-').map(Number);
      const a = Date.UTC(ay, am - 1, ad);
      const b = Date.UTC(by, bm - 1, bd);
      return Math.round((b - a) / 86_400_000);
    }

    type State = { current: number; longest: number; lastVisit: string };

    function readState(): State | null {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (
          parsed &&
          typeof parsed.current === 'number' &&
          typeof parsed.longest === 'number' &&
          typeof parsed.lastVisit === 'string'
        ) {
          return parsed as State;
        }
      } catch {}
      return null;
    }

    function writeState(state: State) {
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
    }

    function updateStreak(): State {
      const today = todayYMD();
      const prev = readState();
      let current: number;
      let longest: number;

      if (!prev) {
        current = 1;
        longest = 1;
      } else if (prev.lastVisit === today) {
        current = prev.current;
        longest = prev.longest;
      } else {
        const gap = daysBetween(prev.lastVisit, today);
        current = gap === 1 ? prev.current + 1 : 1;
        longest = Math.max(prev.longest, current);
      }

      const next: State = { current, longest, lastVisit: today };
      writeState(next);
      return next;
    }

    function paint(state: State) {
      document.querySelectorAll<HTMLElement>('#pc-streak-current').forEach((el) => {
        el.textContent = String(state.current);
      });
      document.querySelectorAll<HTMLElement>('#pc-streak-longest').forEach((el) => {
        el.textContent = String(state.longest);
      });
      document.querySelectorAll<HTMLElement>('.pc-streak').forEach((el) => {
        el.dataset.initial = 'on';
      });
    }

    try {
      paint(updateStreak());
    } catch {
      // localStorage unavailable (private mode, SSR sanity, etc.) — leave the
      // dash placeholder rather than crashing the page.
    }
  })();
</script>

<style>
  /* ---------- compact (masthead) ---------- */
  .pc-streak--compact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }

  .pc-streak--compact[data-initial="off"] {
    visibility: hidden;
  }

  .pc-streak__sep {
    color: var(--pc-rule);
  }

  .pc-streak__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border: 1px solid #C95C2E;
    border-radius: 2px;
    background: color-mix(in srgb, #C95C2E 6%, #fff);
    color: #7a2e0d;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .pc-streak__label {
    font-weight: 500;
  }

  .pc-streak__value {
    font-variant-numeric: tabular-nums;
  }

  .pc-streak__value::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 9px;
    margin: 0 6px -1px 2px;
    background: currentColor;
    opacity: 0.35;
    vertical-align: middle;
  }

  @media (max-width: 620px) {
    .pc-streak__pill {
      padding: 2px 6px;
      font-size: 9.5px;
    }
  }

  /* ---------- full (profile) ---------- */
  .pc-streak--full {
    display: block;
    border: 1px solid var(--pc-rule);
    border-left: 3px solid #C95C2E;
    background: color-mix(in srgb, #C95C2E 4%, #fff);
    padding: 18px 20px;
    margin: 24px 0;
    font-family: var(--pc-font-sans);
    color: var(--pc-ink);
  }

  .pc-streak--full[data-initial="off"] .pc-streak__stat-value {
    opacity: 0.4;
  }

  .pc-streak__kicker {
    margin: 0 0 14px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7a2e0d;
  }

  .pc-streak__stats {
    display: flex;
    gap: 32px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .pc-streak__stat {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }

  .pc-streak__stat-label {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }

  .pc-streak__stat-value {
    font-family: var(--pc-font-mono);
    font-size: 32px;
    font-weight: 500;
    line-height: 1;
    color: #7a2e0d;
    font-variant-numeric: tabular-nums;
  }

  .pc-streak__stat-unit {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }

  .pc-streak__note {
    margin: 12px 0 0;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }

  .pc-streak__note code {
    font-family: var(--pc-font-mono);
    background: color-mix(in srgb, #C95C2E 8%, transparent);
    padding: 1px 4px;
    border-radius: 2px;
  }
</style>
