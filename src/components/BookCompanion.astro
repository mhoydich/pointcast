---
import BlockLayout from '../layouts/BlockLayout.astro';
import { buildBookStructuredData } from '../lib/book-companion.mjs';
import type { ExpansionBook } from '../lib/book-companion-types';

interface Props { book: ExpansionBook }
const { book } = Astro.props;
const palette: Record<string, string> = { oxblood: '#35151c', sage: '#e8eee3', winter: '#e5e9ec', sea: '#e6ece5', indigo: '#172544', ash: '#23272a' };
const sourceFor = (id: string) => book.sources.find((source) => source.id === id);
const sourcesFor = (ids: string[]) => book.sources.filter((source) => ids.includes(source.id));
const readingRoom = book.resourceType === 'reading-room';
const attribution = book.attributionLine || book.authors.join(' & ');
const routeLabel = (type: string) => (({ 'public-domain': 'Public-domain route', 'historical-digital-text': 'Historical text · rights below', 'library-directory': 'Library directory', 'dictionary-resource': 'Related word-study resource', 'author-resource': 'Author context', 'authorized-summary': 'Author’s summary', 'authorized-source-interview': 'Original interview', 'official-author-essay': 'Author’s essay' } as Record<string, string>)[type] || 'Authorized reading');
const copyCount = book.editions.length + book.digitalRoutes.length;
const metadataPath = `/books/${book.id}.json`;
---

<BlockLayout title={`${book.title} — ${readingRoom ? 'reading room' : 'bookshop & companion'}`} description={book.dek} image={book.art.src} imageWidth={book.art.width} imageHeight={book.art.height} themeColor={palette[book.theme] || '#e5e9ec'} isolated={true} showNetworkStrip={false} jsonLd={buildBookStructuredData(book)} alternates={[{ type: 'application/json', href: metadataPath, title: `${book.title} editions and sources` }]}>
  <article class:list={['companion', `theme-${book.theme}`, `layout-${book.layout}`]} data-book-companion data-book-id={book.id}>
    <div class="shell">
      <nav class="masthead" aria-label="Book companion navigation"><a class="wordmark" href="/">pointcast<span>reading shelf</span></a><div class="masthead-links"><a href="/books/">All books</a><a href="#copies">{readingRoom ? 'Reading routes' : 'Find a copy'} <span aria-hidden="true">↓</span></a></div></nav>

      <header class="opening">
        <div class="opening-meta"><p class="label">{readingRoom ? 'Room' : 'Book'} {book.shelfNumber} / {book.kind}</p><p class="label">{book.firstPublished} · {attribution}</p></div>
        <div class="opening-title"><p class="tagline">{book.tagline}</p><h1>{book.title}</h1>{book.subtitle && <p class="subtitle">{book.subtitle}</p>}</div>
        <div class="opening-dek"><p class="author-line">{attribution}</p><p>{book.dek}</p><a class="text-link" href="#begin">Begin reading <span aria-hidden="true">↗</span></a></div>
        <figure class="opening-art"><img src={book.art.src} alt={book.art.alt} width={book.art.width} height={book.art.height} fetchpriority="high" decoding="async" /><figcaption><span>{book.art.caption}</span><span>Original AI-generated atmosphere · an imagined scene, not a book cover</span></figcaption></figure>
      </header>

      <section id="begin" class="section context" aria-labelledby="context-title">
        <div class="section-label"><p class="label">01 / A place to begin</p><p class="aside">A spoiler-light introduction.</p></div>
        <div class="context-prose"><h2 id="context-title">{book.context.heading}</h2>{book.context.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<p class="citations">Sources: {sourcesFor(book.context.sourceIds).map((source, index, sources) => <><a href={source.url}>{source.label}</a>{index < sources.length - 1 && <span> · </span>}</>)}</p>
          <div class="author-note"><p class="label">The author’s work</p><p>{book.authorNote.text}</p><p class="citations">{sourcesFor(book.authorNote.sourceIds).map((source, index, sources) => <><a href={source.url}>{source.label}</a>{index < sources.length - 1 && <span> · </span>}</>)}</p></div>
          {book.readerNote && <div class="reader-note" role="note" aria-label="Reader note"><p class="label">Reader note</p><p>{book.readerNote}</p></div>}
        </div>
        <dl class="work-facts"><div><dt class="label">First publication</dt><dd>{book.firstPublished}</dd></div><div><dt class="label">Form</dt><dd>{book.kind}</dd></div><div><dt class="label">Original language</dt><dd>English</dd></div><div><dt class="label">Publication note</dt><dd>{book.firstPublicationNote}</dd></div></dl>
      </section>

      <section id="lenses" class="section reading-lenses" aria-labelledby="lens-title">
        <div class="section-heading"><p class="label">02 / Ways of looking</p><h2 id="lens-title">Choose a reading lens.</h2><p>Three original prompts. Pick the question you want to carry into the book.</p></div>
        <div class="lens-controls" data-lens-controls hidden role="group" aria-label="Choose a reading lens">{book.entryPoints.map((lens, index) => <button type="button" data-lens-choice={lens.id} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`${book.id}-lens-panel`}>{lens.label}</button>)}</div>
        <div class="lens-panel" id={`${book.id}-lens-panel`} data-lens-panel hidden><p class="label">Your reading prompt</p><h3 data-active-lens-title></h3><p data-active-lens-prompt></p></div>
        <p class="sr-only" data-lens-status role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="lens-list" data-lens-list>{book.entryPoints.map((lens) => <article data-reading-lens={lens.id}><p class="label">{lens.label}</p><h3 data-lens-title>{lens.title}</h3><p data-lens-prompt>{lens.prompt}</p></article>)}</div>
      </section>

      <section id="copies" class="section copy-desk" aria-labelledby="copy-title">
        <div class="section-heading"><p class="label">03 / The copy desk</p><h2 id="copy-title">{book.copyHeading || 'Find the edition for you.'}</h2><p>{book.copyIntro || 'Outside sellers and libraries handle purchases and loans.'} They determine stock, prices, condition, eligibility, and waits. Routes and bibliographic details checked <time datetime={book.checkedAt}>{book.checkedAt}</time>.</p></div>
        <div class="copy-filters" data-copy-filters hidden role="group" aria-label="Filter edition and reading routes">{['all', 'new', 'used', 'borrow', 'online'].map((filter) => <button type="button" data-copy-filter={filter} aria-pressed={filter === 'all' ? 'true' : 'false'} aria-controls={`${book.id}-copies`}>{filter.charAt(0).toUpperCase() + filter.slice(1)}</button>)}</div>
        <p class="filter-status" data-copy-status role="status" aria-live="polite" aria-atomic="true">All {copyCount} reading routes shown.</p>
        <div class="edition-grid" id={`${book.id}-copies`}>
          {book.editions.map((edition, index) => <article class="edition" data-copy-card data-copy-kinds={[...new Set(edition.links.map((link) => link.kind))].join(' ')} aria-labelledby={`edition-${book.id}-${edition.id}`}><div class="edition-top"><span class="label">{String(index + 1).padStart(2, '0')}</span><p class="label">{edition.label}</p></div><h3 id={`edition-${book.id}-${edition.id}`}>{edition.format}</h3><p class="edition-why">{edition.why}</p><dl class="edition-facts"><div><dt>Publisher</dt><dd>{edition.publisher}</dd></div><div><dt>ISBN</dt><dd class="isbn">{edition.isbn || 'Not verified'}</dd></div><div><dt>Edition date</dt><dd>{edition.publicationDate || 'Not verified'}</dd></div><div><dt>Pages</dt><dd>{edition.pages ?? 'Not verified'}</dd></div><div><dt>Extra material</dt><dd>{edition.extras}</dd></div></dl>{sourceFor(edition.sourceId) && <a class="source-link" href={sourceFor(edition.sourceId)!.url}>Edition source <span aria-hidden="true">↗</span></a>}<div class="route-list">{edition.links.map((link) => <div data-route-kind={link.kind}><a class="route-link" href={link.url}><span>{link.label}</span><span aria-hidden="true">↗</span></a>{link.note && <p>{link.note}</p>}</div>)}</div></article>)}
          {book.digitalRoutes.map((route) => <article class="edition digital-route" data-copy-card data-copy-kinds="online" aria-labelledby={`online-${book.id}-${route.id}`}><div class="edition-top"><span class="label">Online</span><p class="label">{routeLabel(route.type)}</p></div><h3 id={`online-${book.id}-${route.id}`}>{route.label}</h3><p>{route.description}</p><p class="route-rights">{route.rights}</p>{sourceFor(route.sourceId) && <a class="source-link" href={sourceFor(route.sourceId)!.url}>Reading source <span aria-hidden="true">↗</span></a>}<div class="route-list"><a class="route-link" href={route.url}><span>{route.label}</span><span aria-hidden="true">↗</span></a></div></article>)}
        </div>
        <p class="rights-note">{book.rightsNote}</p>
      </section>

      <section class="section pathways" aria-labelledby="pathways-title"><div class="section-heading"><p class="label">04 / Alongside the book</p><h2 id="pathways-title">Keep a thread.</h2></div><div class="pathway-list">{book.pathways.map((pathway, index) => <article><p class="label">{String(index + 1).padStart(2, '0')} / {pathway.label}</p><h3>{pathway.title}</h3><p>{pathway.text}</p></article>)}</div></section>

      <section id="deeper" class="section deeper" aria-labelledby="deeper-title"><div class="section-heading"><p class="label">05 / After reading</p><h2 id="deeper-title">Let the questions stay.</h2><p>Optional deeper reading. The panels below may discuss later events or the ending. They begin closed so you can choose when to continue.</p></div>
        <details><summary><span><span class="label">Deeper themes · possible spoilers</span><span class="summary-title">Look beneath the surface.</span></span><span class="details-mark" aria-hidden="true">+</span></summary><div class="details-content"><p class="spoiler-note">Original PointCast interpretations and prompts, rather than the author’s stated meaning. Open after reading if you want to preserve the discovery.</p><div class="theme-list">{book.deeper.themes.map((theme) => <article><h3>{theme.title}</h3><p>{theme.text}</p></article>)}</div></div></details>
        <details><summary><span><span class="label">Reading group · discussion spoilers</span><span class="summary-title">Bring it into conversation.</span></span><span class="details-mark" aria-hidden="true">+</span></summary><div class="details-content"><p class="spoiler-note">These questions concern the whole work. Return to the edition you are reading for examples and compare passages rather than page numbers.</p><ol class="questions">{book.deeper.questions.map((question) => <li>{question}</li>)}</ol></div></details>
      </section>

      {(book.series || book.related.length > 0) && <section class="section nearby" aria-labelledby="nearby-title"><div class="section-heading"><p class="label">06 / The next door</p><h2 id="nearby-title">Nearby readings.</h2></div>{book.series && <div class="series"><h3>Continue the series.</h3><p>{book.series.intro}</p><ol>{book.series.items.map((item) => <li>{item.url ? <a href={item.url}>{item.title}<span aria-hidden="true">↗</span></a> : <span>{item.title}</span>}<p>{item.note}</p>{sourceFor(item.sourceId) && <p class="citations"><a href={sourceFor(item.sourceId)!.url}>{sourceFor(item.sourceId)!.label}</a></p>}</li>)}</ol></div>}<div class="related-list">{book.related.map((item) => <article><h3><a href={item.url}>{item.title}<span aria-hidden="true">↗</span></a></h3><p>{item.why}</p></article>)}</div></section>}

      <section id="sources" class="section sources" aria-labelledby="sources-title"><div class="section-label"><p class="label">Sources / Follow the evidence</p><p class="aside">The reading is personal.<br />The references are inspectable.</p></div><div><h2 id="sources-title">A companion with its sources.</h2><ul class="source-list">{book.sources.map((source) => <li id={`source-${book.id}-${source.id}`}><p class="label">{source.type}</p><h3><a href={source.url}>{source.label}<span aria-hidden="true">↗</span></a></h3><p>{source.note}</p></li>)}</ul><div class="publication-notes"><p>Introductions, reading lenses, pathways, and discussion prompts are original editorial copy. No book text is reproduced on this page.</p><p>The artwork was generated as an original editorial atmosphere. It is not an official cover, archival evidence, an author’s artwork, or a publisher endorsement.</p><div class="publication-links"><a href={metadataPath}>Editions and source metadata <span aria-hidden="true">↗</span></a><a href="/images/bookshelf/provenance.json">Artwork provenance <span aria-hidden="true">↗</span></a></div></div></div></section>
      <footer class="footer"><p>Keep a book.<br />Keep a question.</p><a href="/books/">Return to the reading shelf <span aria-hidden="true">↗</span></a><span class="label">PointCast / Book {book.shelfNumber}</span></footer>
    </div>
  </article>
</BlockLayout>

<script>
  import { mountBookCompanion } from '../lib/book-companion.mjs';
  document.querySelectorAll<HTMLElement>('[data-book-companion]').forEach((root) => mountBookCompanion(root));
</script>

<style>
  .companion { --paper:#35151c; --ink:#f6ede2; --muted:#d4bdba; --accent:#e6bb80; --line:#a5807f; --panel:#412028; background:var(--paper); color:var(--ink); font:400 1rem/1.65 var(--pc-font-sans); min-height:100vh; }
  .theme-sage { --paper:#e8eee3; --ink:#25382b; --muted:#536653; --accent:#315b40; --line:#9caa98; --panel:#dde7d6; }
  .theme-winter { --paper:#e5e9ec; --ink:#25303a; --muted:#52606a; --accent:#3f586d; --line:#a1adb5; --panel:#dbe1e5; }
  .theme-sea { --paper:#e6ece5; --ink:#173e40; --muted:#4d6461; --accent:#8a4229; --line:#9aaea5; --panel:#dce5dc; }
  .theme-indigo { --paper:#172544; --ink:#f7eedf; --muted:#c3cede; --accent:#f0c776; --line:#8794ad; --panel:#213251; }
  .theme-ash { --paper:#23272a; --ink:#eeeae1; --muted:#c3c5c5; --accent:#c8d1d8; --line:#899195; --panel:#2d3337; }
  .shell { width:min(1400px,calc(100% - 96px)); margin-inline:auto; }
  p,h1,h2,h3,figure,dl,dd { margin:0; }
  .companion :global(a) { color:inherit; text-decoration:none; }
  .companion :global(a:hover) { text-decoration:underline; text-underline-offset:.2em; }
  .companion :global(a:focus-visible),button:focus-visible,summary:focus-visible { outline:3px solid var(--accent); outline-offset:5px; }
  .companion :global([hidden]) { display:none !important; }
  .companion :global(::selection) { color:var(--paper); background:var(--accent); }
  button,summary,a { touch-action:manipulation; }
  button { font:inherit; cursor:pointer; }
  .label { font:400 .875rem/1.5 var(--pc-font-mono); letter-spacing:.035em; text-transform:uppercase; }
  .masthead { display:flex; align-items:center; justify-content:space-between; gap:24px; border-bottom:1px solid var(--line); padding-block:24px; }
  .wordmark { display:flex; align-items:center; flex-wrap:wrap; gap:12px 22px; min-height:44px; font-size:1.5rem; letter-spacing:-.06em; }
  .wordmark span { padding-left:22px; border-left:1px solid var(--line); font:400 .875rem/1.5 var(--pc-font-mono); text-transform:uppercase; letter-spacing:.035em; }
  .masthead-links { display:flex; align-items:center; gap:26px; font-size:.875rem; }
  .masthead-links a { min-height:44px; display:flex; align-items:center; gap:14px; }
  .opening { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:32px; padding-block:28px 0; }
  .opening-meta { grid-column:1/-1; display:flex; align-items:start; justify-content:space-between; gap:24px; color:var(--muted); }
  .opening-title { grid-column:1/9; grid-row:2; }
  .opening-dek { grid-column:9/-1; grid-row:2; align-self:end; color:var(--muted); padding-bottom:5px; }
  .tagline { color:var(--accent); margin-bottom:20px; }
  h1 { font:400 clamp(3.7rem,7.4vw,7.25rem)/.98 Georgia,'Times New Roman',serif; letter-spacing:-.045em; overflow-wrap:anywhere; }
  .subtitle { font:400 1.375rem/1.35 Georgia,'Times New Roman',serif; margin-top:18px; max-width:42ch; }
  .author-line { color:var(--ink); font-size:1.25rem; margin-bottom:15px; }
  .text-link { display:inline-flex; align-items:center; justify-content:space-between; gap:24px; min-height:44px; margin-top:18px; border-bottom:1px solid var(--accent); color:var(--accent) !important; }
  .opening-art { grid-column:1/-1; grid-row:3; min-width:0; }
  .opening-art img { width:100%; height:auto; aspect-ratio:3/2; object-fit:cover; }
  .opening-art figcaption { display:flex; justify-content:space-between; gap:24px; padding-block:15px; font-size:.875rem; color:var(--muted); border-bottom:1px solid var(--line); }
  .opening-art figcaption span:first-child { color:var(--accent); }
  .layout-gate .opening-title { border-left:5px solid var(--accent); padding-left:26px; }
  .layout-gate h1 { font-family:var(--pc-font-sans); font-weight:500; letter-spacing:-.065em; }
  .layout-gate .opening-art { border-top:4px double var(--accent); padding-top:12px; }
  .layout-network .opening-title { grid-column:8/-1; grid-row:2; align-self:end; }
  .layout-network .opening-dek { grid-column:8/-1; grid-row:3; align-self:start; }
  .layout-network .opening-art { grid-column:1/8; grid-row:2/4; }
  .layout-network .opening-art img { aspect-ratio:1/1; }
  .layout-network h1 { font-size:clamp(3.2rem,5vw,5.25rem); }
  .layout-network .opening-meta { border-bottom:1px solid var(--line); padding-bottom:24px; }
  .layout-winter .opening-title { grid-column:7/-1; grid-row:2; align-self:end; padding-left:4%; }
  .layout-winter .opening-dek { grid-column:7/-1; grid-row:3; align-self:start; max-width:35ch; padding-left:4%; }
  .layout-winter .opening-art { grid-column:1/7; grid-row:2/4; }
  .layout-winter .opening-art img { aspect-ratio:4/5; }
  .layout-winter h1 { font-size:clamp(3.7rem,7vw,7rem); }
  .layout-winter .context-prose { max-width:48ch; }
  .layout-chart .opening-title { grid-column:2/8; grid-row:3; align-self:end; margin-bottom:112px; padding:28px; background:var(--paper); z-index:1; border:1px solid var(--accent); }
  .layout-chart .opening-title h1 { font-size:clamp(3.2rem,6vw,5.5rem); }
  .layout-chart .opening-dek { grid-column:1/9; grid-row:2; max-width:75ch; }
  .layout-chart .opening-art { grid-column:1/-1; grid-row:3; }
  .layout-chart .opening-art img { aspect-ratio:3/2; }
  .layout-chart .opening-meta { border-bottom:3px double var(--line); padding-bottom:23px; }
  .layout-sky .opening-title { grid-column:2/12; grid-row:2; text-align:center; padding-top:10px; }
  .layout-sky h1 { font-size:clamp(4rem,9vw,8rem); }
  .layout-sky .opening-dek { grid-column:4/10; grid-row:3; text-align:center; }
  .layout-sky .opening-art { grid-row:4; }
  .layout-sky .opening-art img { aspect-ratio:3/2; }
  .layout-ash .opening-title { grid-column:1/-1; grid-row:2; padding-block:15px; border-block:1px solid var(--line); }
  .layout-ash h1 { font-family:var(--pc-font-sans); font-size:clamp(4rem,10.5vw,9rem); letter-spacing:-.065em; }
  .layout-ash .opening-art { grid-column:1/9; grid-row:3; }
  .layout-ash .opening-dek { grid-column:9/-1; grid-row:3; align-self:center; padding-left:10px; }
  .section { padding-block:62px; border-bottom:1px solid var(--line); scroll-margin-top:24px; }
  h2 { font:400 clamp(2rem,3.4vw,3.25rem)/1.15 Georgia,'Times New Roman',serif; letter-spacing:-.035em; margin-bottom:25px; }
  h3 { font:500 1.25rem/1.35 var(--pc-font-sans); letter-spacing:-.02em; margin-bottom:13px; }
  .section-label .label,.section-heading > .label { color:var(--accent); }
  .aside { color:var(--muted); margin-top:14px; }
  .section-heading { max-width:82ch; margin-bottom:28px; }
  .section-heading h2 { margin-top:14px; margin-bottom:19px; }
  .section-heading > p:not(.label) { color:var(--muted); }
  .context { display:grid; grid-template-columns:minmax(150px,.7fr) minmax(0,1.9fr) minmax(170px,.8fr); gap:44px; }
  .context-prose > p { margin-top:19px; }
  .citations { font-size:.875rem; color:var(--muted); }
  .citations a { text-decoration:underline; text-underline-offset:3px; }
  .author-note { border-top:1px solid var(--line); padding-top:23px; margin-top:31px; }
  .author-note > .label { color:var(--accent); }
  .author-note > p:not(.label) { margin-top:12px; }
  .reader-note { border-left:2px solid var(--accent); padding-left:18px; margin-top:28px; }
  .reader-note > .label { color:var(--accent); margin-bottom:10px; }
  .work-facts > div + div { margin-top:24px; }
  .work-facts dt { color:var(--muted); }
  .work-facts dd { margin-top:7px; }
  .lens-controls,.copy-filters { display:flex; gap:9px; flex-wrap:wrap; }
  .lens-controls button,.copy-filters button { min-width:76px; min-height:46px; padding:10px 18px; color:var(--ink); background:transparent; border:1px solid var(--line); }
  .lens-controls button[aria-pressed='true'],.copy-filters button[aria-pressed='true'] { color:var(--paper); background:var(--accent); border-color:var(--accent); }
  .lens-panel { margin-top:22px; padding:28px; background:var(--panel); border-left:3px solid var(--accent); max-width:90ch; }
  .lens-panel > .label { color:var(--accent); margin-bottom:13px; }
  .lens-panel p:last-child { font-size:1.125rem; }
  .lens-list,.pathway-list,.theme-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:36px; }
  .lens-list > article,.pathway-list > article { border-top:1px solid var(--line); padding-top:22px; }
  .lens-list .label,.pathway-list .label { color:var(--accent); margin-bottom:17px; }
  .lens-list p:not(.label),.pathway-list p:not(.label),.theme-list p { color:var(--muted); }
  .filter-status { margin:18px 0 24px; font-size:.875rem; color:var(--muted); }
  .edition-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr)); gap:20px; align-items:start; }
  .edition { padding:25px; background:var(--panel); border:1px solid var(--line); min-width:0; }
  .edition-top { display:flex; justify-content:space-between; gap:20px; margin-bottom:25px; color:var(--accent); }
  .edition-top .label:last-child { text-align:right; }
  .edition-facts { font-size:.875rem; padding-block:17px; margin-top:24px; border-block:1px solid var(--line); }
  .edition-facts > div { display:grid; grid-template-columns:minmax(80px,.8fr) minmax(0,1.5fr); gap:12px; padding-block:7px; }
  .edition-facts dt { color:var(--muted); overflow-wrap:anywhere; }
  .edition-facts dd { overflow-wrap:anywhere; }
  .isbn { font-family:var(--pc-font-mono); }
  .source-link { display:inline-flex; align-items:center; gap:18px; min-height:44px; margin-top:12px; color:var(--accent) !important; font-size:.875rem; }
  .route-list { margin-top:19px; }
  .route-list > div + div { margin-top:16px; }
  .route-link { display:flex; align-items:center; justify-content:space-between; gap:15px; min-height:48px; padding:10px 14px; border:1px solid var(--accent); color:var(--accent) !important; }
  .route-link > span:last-child { flex-shrink:0; }
  .route-list p { font-size:.875rem; color:var(--muted); margin-top:9px; }
  .route-rights { border-left:2px solid var(--accent); padding-left:15px; margin-top:24px; font-size:.875rem; color:var(--muted); }
