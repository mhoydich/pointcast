---
type PixelIconName = 'cabinet' | 'joystick' | 'drum' | 'trophy' | 'dice' | 'sparkle-new';

interface Props {
  name: PixelIconName;
  title?: string;
  size?: number;
  class?: string;
}

const { name, title, size = 20, class: className = '' } = Astro.props;
const titleId = title ? `pixel-icon-${name}` : undefined;
---

<svg
  class:list={['pixel-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  aria-labelledby={titleId}
  role={title ? 'img' : undefined}
  focusable="false"
  shapeRendering="crispEdges"
>
  {title && <title id={titleId}>{title}</title>}

  {name === 'cabinet' && (
    <>
      <rect x="5" y="2" width="14" height="3" fill="currentColor" />
      <rect x="4" y="5" width="16" height="16" fill="currentColor" />
      <rect x="7" y="7" width="10" height="6" fill="#fff" />
      <rect x="8" y="8" width="8" height="4" fill="currentColor" opacity="0.28" />
      <rect x="7" y="15" width="3" height="2" fill="#fff" />
      <rect x="12" y="15" width="2" height="2" fill="#fff" />
      <rect x="15" y="15" width="2" height="2" fill="#fff" />
      <rect x="6" y="21" width="4" height="1" fill="currentColor" />
      <rect x="14" y="21" width="4" height="1" fill="currentColor" />
    </>
  )}

  {name === 'joystick' && (
    <>
      <rect x="5" y="15" width="14" height="5" fill="currentColor" />
      <rect x="7" y="13" width="10" height="2" fill="currentColor" />
      <rect x="11" y="7" width="2" height="7" fill="currentColor" />
      <rect x="9" y="4" width="6" height="4" fill="currentColor" />
      <rect x="8" y="17" width="3" height="1" fill="#fff" />
      <rect x="14" y="17" width="2" height="1" fill="#fff" />
      <rect x="17" y="17" width="2" height="1" fill="#fff" />
    </>
  )}

  {name === 'drum' && (
    <>
      <rect x="6" y="5" width="12" height="3" fill="currentColor" />
      <rect x="5" y="8" width="14" height="10" fill="currentColor" />
      <rect x="6" y="18" width="12" height="2" fill="currentColor" />
      <rect x="7" y="9" width="10" height="2" fill="#fff" opacity="0.9" />
      <rect x="8" y="13" width="2" height="2" fill="#fff" />
      <rect x="14" y="13" width="2" height="2" fill="#fff" />
      <rect x="4" y="3" width="2" height="8" fill="currentColor" />
      <rect x="18" y="3" width="2" height="8" fill="currentColor" />
    </>
  )}

  {name === 'trophy' && (
    <>
      <rect x="7" y="4" width="10" height="8" fill="currentColor" />
      <rect x="5" y="5" width="2" height="5" fill="currentColor" />
      <rect x="17" y="5" width="2" height="5" fill="currentColor" />
      <rect x="9" y="12" width="6" height="3" fill="currentColor" />
      <rect x="10" y="15" width="4" height="3" fill="currentColor" />
      <rect x="7" y="18" width="10" height="2" fill="currentColor" />
      <rect x="9" y="6" width="6" height="2" fill="#fff" opacity="0.9" />
    </>
  )}

  {name === 'dice' && (
    <>
      <rect x="5" y="5" width="14" height="14" fill="currentColor" />
      <rect x="7" y="7" width="10" height="10" fill="#fff" />
      <rect x="9" y="9" width="2" height="2" fill="currentColor" />
      <rect x="13" y="13" width="2" height="2" fill="currentColor" />
      <rect x="13" y="9" width="2" height="2" fill="currentColor" />
      <rect x="9" y="13" width="2" height="2" fill="currentColor" />
    </>
  )}

  {name === 'sparkle-new' && (
    <>
      <rect x="11" y="3" width="2" height="5" fill="currentColor" />
      <rect x="11" y="16" width="2" height="5" fill="currentColor" />
      <rect x="3" y="11" width="5" height="2" fill="currentColor" />
      <rect x="16" y="11" width="5" height="2" fill="currentColor" />
      <rect x="9" y="9" width="6" height="6" fill="currentColor" />
      <rect x="5" y="5" width="2" height="2" fill="currentColor" />
      <rect x="17" y="5" width="2" height="2" fill="currentColor" />
      <rect x="5" y="17" width="2" height="2" fill="currentColor" />
      <rect x="17" y="17" width="2" height="2" fill="currentColor" />
    </>
  )}
</svg>
