---
import { PRESS_KIND_LABELS, PRESS_RELEASES, formatPressDate } from '../lib/press-wire';

const latest = PRESS_RELEASES.slice(0, 3);
---

<section class="press-strip" id="press-wire-home" aria-labelledby="press-strip-title">
  <div class="press-strip__head">
    <div>
      <p class="press-strip__kicker mono">POINTCAST PRESS WIRE · OWNED SOURCE DESK</p>
      <h2 id="press-strip-title">Five products, flowing now.</h2>
    </div>
    <div class="press-strip__routes mono">
      <a href="/press">ALL {PRESS_RELEASES.length} FILINGS →</a>
      <a href="/press.json">JSON</a>
      <a href="/press.xml">RSS</a>
    </div>
  </div>

  <p class="press-strip__dek">
    A different lane from the house ads: app, data, archive, game, and engineering filings,
    each with primary sources and a machine-readable twin.
  </p>

  <ol class="press-strip__list">
    {latest.map((release) => (
      <li style={`--release-paper:${release.palette.paper};--release-ink:${release.palette.ink};--release-accent:${release.palette.accent};`}>
        <a href={`/press/${release.slug}`}>
          <span class="press-strip__meta mono">
            <span>{PRESS_KIND_LABELS[release.kind]}</span>
            <span>{release.id}</span>
            <time datetime={release.publishedAt}>{formatPressDate(release.publishedAt)}</time>
          </span>
          <strong>{release.headline}</strong>
          <span class="press-strip__arrow mono">FILING →</span>
        </a>
      </li>
    ))}
  </ol>

  <div class="press-strip__flow mono" aria-label="All products currently on the Press Wire">
    <div>
      {PRESS_RELEASES.map((release) => <span>{PRESS_KIND_LABELS[release.kind]} · {release.product} ·</span>)}
      <span aria-hidden="true">
        {PRESS_RELEASES.map((release) => `${PRESS_KIND_LABELS[release.kind]} · ${release.product} ·`).join(' ')}
      </span>
    </div>
  </div>

  <p class="press-strip__disclosure mono">
    OFFICIAL POINTCAST PRODUCT FILINGS · OWNED ANNOUNCEMENTS · NOT INDEPENDENT COVERAGE
  </p>
</section>

<style>
  .press-strip {
    margin: 18px 0 22px;
    padding: clamp(20px, 3vw, 34px);
    border: 2px solid #17140f;
    background: #f4efe3;
    color: #17140f;
  }
  .press-strip .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .press-strip__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .press-strip__kicker { margin: 0 0 5px; color: #9b3c26; font-size: 8px; letter-spacing: 0.15em; }
  .press-strip h2 { margin: 0; font-family: 'Lora', Georgia, serif; font-size: clamp(30px, 4.6vw, 55px); font-weight: 400; line-height: 0.95; letter-spacing: -0.035em; }
  .press-strip__routes { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; font-size: 8px; letter-spacing: 0.1em; }
  .press-strip__routes a { padding: 7px 9px; border: 1px solid #17140f; color: inherit; text-decoration: none; }
  .press-strip__routes a:first-child { color: #f4efe3; background: #17140f; }
  .press-strip__dek { max-width: 75ch; margin: 14px 0 20px; font-family: 'Lora', Georgia, serif; font-size: 13px; line-height: 1.5; }
  .press-strip__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .press-strip__list li { min-width: 0; color: var(--release-ink); background: var(--release-paper); border: 1px solid var(--release-ink); }
  .press-strip__list a { height: 100%; display: flex; flex-direction: column; gap: 12px; padding: 14px; color: inherit; text-decoration: none; }
  .press-strip__list a:hover { box-shadow: inset 0 -5px 0 var(--release-accent); }
  .press-strip__meta { display: flex; flex-wrap: wrap; gap: 5px 10px; color: var(--release-accent); font-size: 7px; letter-spacing: 0.08em; text-transform: uppercase; }
  .press-strip__list strong { font-family: 'Lora', Georgia, serif; font-size: clamp(16px, 2vw, 23px); font-weight: 400; line-height: 1.12; }
  .press-strip__arrow { margin-top: auto; font-size: 7px; letter-spacing: 0.12em; }
  .press-strip__flow { margin-top: 9px; overflow: hidden; border-block: 1px solid #17140f; font-size: 7px; letter-spacing: 0.11em; }
  .press-strip__flow > div { display: flex; width: max-content; gap: 12px; padding: 8px 0; animation: pc-press-flow 32s linear infinite; }
  .press-strip__flow span { display: inline-block; white-space: nowrap; }
  @keyframes pc-press-flow { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .press-strip__flow > div { animation: none; } }
  .press-strip__disclosure { margin: 10px 0 0; color: #70675c; font-size: 7px; letter-spacing: 0.1em; }
  @media (max-width: 720px) {
    .press-strip__head { align-items: flex-start; flex-direction: column; }
    .press-strip__routes { justify-content: flex-start; }
    .press-strip__list { grid-template-columns: 1fr; }
  }
</style>
