---
/**
 * GuestbookEntry — one signature on the lobby's guestbook wall.
 *
 * Vintage geocities-style entry: ASCII frame, handle in monospace,
 * date stamp, message in serif-ish system font. Stacks vertically.
 */
interface Props {
  handle: string;
  origin: string;
  at: string;
  message: string;
}

const { handle, origin, at, message } = Astro.props;

let dateStamp = at;
try {
  const d = new Date(at);
  dateStamp = d.toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
} catch {}
---

<div class="entry">
  <div class="entry-head">
    <span class="quote-mark">&ldquo;</span>
    <p class="message">{message}</p>
  </div>
  <div class="entry-foot">
    <span class="sig">— <strong>{handle}</strong></span>
    <span class="origin">[{origin}]</span>
    <span class="dot">·</span>
    <time>{dateStamp}</time>
  </div>
</div>

<style>
  .entry {
    background: #fffbf2;
    border: 1px dashed #1a1208;
    padding: 0.85rem 1rem 0.7rem;
    border-radius: 4px;
    box-shadow: 2px 2px 0 0 #d8cdb8;
  }
  .entry-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .quote-mark {
    font-size: 2rem;
    line-height: 0.6;
    color: #c46734;
    font-family: Georgia, 'Times New Roman', serif;
    flex-shrink: 0;
  }
  .message {
    margin: 0;
    color: #1a1208;
    font-size: 0.95rem;
    line-height: 1.45;
    font-family: 'Inter Variable', system-ui, sans-serif;
  }
  .entry-foot {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.75rem;
    color: #5F5E5A;
  }
  .sig strong {
    color: #1a1208;
  }
  .origin {
    color: #c46734;
  }
  .dot {
    color: #d8cdb8;
  }
</style>
