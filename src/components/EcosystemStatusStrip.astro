---
import { getCollection } from 'astro:content';
import {
  POINTCAST_MAIN_WALLET,
  POINTCAST_COLLECTIONS,
  pointcastWalletHref,
} from '../lib/collectibles';

const blocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

const latest = blocks[0];
const featuredRoom = {
  href: '/mint-studio',
  label: 'Mint Studio',
  note: 'Ship frames, metadata, and collectible scenes from one room.',
};
const featuredDrop = POINTCAST_COLLECTIONS.find((collection) => collection.slug === 'visit_nouns')
  ?? POINTCAST_COLLECTIONS.find((collection) => collection.live)
  ?? POINTCAST_COLLECTIONS[0];
const collectorSpotlight = {
  href: pointcastWalletHref(POINTCAST_MAIN_WALLET),
  label: 'Collector shelf',
  note: 'Mike’s public wallet view with PointCast holdings, listings, and share paths.',
};
---

<section class="eco-strip" aria-labelledby="ecosystem-status-title">
  <div class="eco-strip__head">
    <p class="eco-strip__kicker mono">LIVE ECOSYSTEM STATUS</p>
    <h2 id="ecosystem-status-title">Latest work, market lanes, and the next room.</h2>
  </div>

  <div class="eco-strip__grid">
    <a class="eco-strip__card eco-strip__card--latest" href={latest ? `/b/${latest.data.id}` : '/'}>
      <span class="mono">latest work</span>
      <strong>{latest ? `${latest.data.id} · ${latest.data.title}` : 'PointCast home'}</strong>
      <em>{latest?.data.dek ?? 'Newest block leads the front door and all machine-readable feeds.'}</em>
    </a>

    <a class="eco-strip__card eco-strip__card--market" href="/marketplace">
      <span class="mono">featured market activity</span>
      <strong>{featuredDrop?.name ?? 'Marketplace console'}</strong>
      <em>{featuredDrop ? `${featuredDrop.symbol} · royalty-aware, referral-ready, wallet-linked.` : 'Royalties, referral math, and live ask lanes.'}</em>
    </a>

    <a class="eco-strip__card eco-strip__card--collector" href={collectorSpotlight.href}>
      <span class="mono">collector spotlight</span>
      <strong>{collectorSpotlight.label}</strong>
      <em>{collectorSpotlight.note}</em>
    </a>

    <a class="eco-strip__card eco-strip__card--room" href={featuredRoom.href}>
      <span class="mono">featured room</span>
      <strong>{featuredRoom.label}</strong>
      <em>{featuredRoom.note}</em>
    </a>
  </div>
</section>

<style>
  .eco-strip {
    margin: 14px 0;
    padding: 14px;
    border: 1px solid rgba(18, 17, 14, 0.18);
    background:
      linear-gradient(135deg, rgba(24, 95, 165, 0.06), transparent 40%),
      linear-gradient(90deg, rgba(18, 17, 14, 0.03) 1px, transparent 1px),
      #fffdf6;
    background-size: auto, 22px 22px, auto;
  }
  .mono {
    font-family: var(--pc-font-mono, 'JetBrains Mono Variable', ui-monospace, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eco-strip__head {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .eco-strip__kicker {
    margin: 0;
    font-size: 10px;
    color: #5f5e5a;
  }
  .eco-strip h2 {
    margin: 0;
    font-size: clamp(18px, 3vw, 28px);
    line-height: 1.05;
    letter-spacing: 0;
  }
  .eco-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .eco-strip__card {
    min-width: 0;
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 1px solid rgba(18, 17, 14, 0.16);
    background: rgba(255, 255, 255, 0.86);
    color: var(--pc-ink);
    text-decoration: none;
  }
  .eco-strip__card:hover {
    border-color: #185fa5;
    text-decoration: none;
  }
  .eco-strip__card span {
    font-size: 9px;
    color: #5f5e5a;
  }
  .eco-strip__card strong {
    font-size: 16px;
    line-height: 1.08;
    letter-spacing: 0;
  }
  .eco-strip__card em {
    font-style: normal;
    color: var(--pc-ink-muted);
    line-height: 1.35;
  }
  .eco-strip__card--latest { border-left: 3px solid #185fa5; }
  .eco-strip__card--market { border-left: 3px solid #2f8f5f; }
  .eco-strip__card--collector { border-left: 3px solid #8a2432; }
  .eco-strip__card--room { border-left: 3px solid #b88722; }
  @media (max-width: 920px) {
    .eco-strip__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .eco-strip__grid { grid-template-columns: 1fr; }
  }
</style>
