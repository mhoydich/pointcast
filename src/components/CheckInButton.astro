---
/**
 * CheckInButton — affirmative "I'M HERE" check-in with optional note +
 * location tag. From the engagement plan §1.3 "Check-in mechanics":
 *
 *   "Active: tap a CHECK IN button for a location-tagged entry.
 *    Optional one-liner on check-in: 'at the courts' or 'morning coffee'."
 *
 * Local-first. Each check-in becomes a row in pc:checkins (capped at
 * 50). Last 5 are shown right under the button so the visitor sees
 * their recent trail at a glance.
 *
 * Shape:
 *   {
 *     ts: ISO 8601,
 *     mood: string | null,
 *     note: string | null,
 *     location: string | null
 *   }
 *
 * Suggested tags are quick-tap chips (courts, garden, beach, kitchen,
 * desk, road). Custom location goes through the prompt path.
 */

const QUICK_LOCATIONS = ['courts', 'garden', 'beach', 'kitchen', 'desk', 'road', 'studio'];
---

<aside class="checkin" aria-label="Check in here">
  <header class="checkin__head">
    <p class="checkin__kicker mono">CHECK IN · LOCAL-FIRST · LAST 50</p>
    <span class="checkin__total mono" data-checkin-total>0 logged</span>
  </header>

  <div class="checkin__row">
    <button class="checkin__btn mono" type="button" data-checkin-go>
      <span aria-hidden="true">●</span>
      <span>CHECK IN</span>
    </button>
    <ol class="checkin__chips" aria-label="Quick location tags">
      {QUICK_LOCATIONS.map((loc) => (
        <li>
          <button class="checkin__chip mono" type="button" data-checkin-loc={loc}>{loc}</button>
        </li>
      ))}
      <li>
        <button class="checkin__chip checkin__chip--custom mono" type="button" data-checkin-custom>+ custom</button>
      </li>
    </ol>
  </div>

  <ol class="checkin__feed" data-checkin-feed aria-live="polite">
    <li class="checkin__empty mono" data-checkin-empty>
      No check-ins yet. Tap CHECK IN to log a moment, or tap a location chip to log + tag in one move.
    </li>
  </ol>
</aside>

<script is:inline>
(function () {
  'use strict';
  var KEY = 'pc:checkins';
  var CAP = 50;

  function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  function readList() {
    try {
      var raw = lsGet(KEY);
      var arr = raw ? JSON.parse(raw) : [];
      return Array.isArray(arr) ? arr : [];
    } catch (e) { return []; }
  }
  function writeList(arr) { lsSet(KEY, JSON.stringify(arr || [])); }

  function recencyLabel(iso) {
    var t = Date.parse(iso);
    if (!t) return iso;
    var diffMs = Date.now() - t;
    if (diffMs < 60000) return 'just now';
    var mins = Math.round(diffMs / 60000);
    if (mins < 60) return mins + 'm ago';
    var hrs = Math.round(diffMs / 3600000);
    if (hrs < 24) return hrs + 'h ago';
    var days = Math.round(diffMs / 86400000);
    if (days === 1) return 'yesterday';
    if (days < 14) return days + 'd ago';
    try {
      return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(new Date(t));
    } catch (e) { return iso.slice(0, 10); }
  }

  function readMood() {
    // pc:mood is set by MoodChip if present; harmless fallback to null.
    var raw = lsGet('pc:mood');
    if (!raw) return null;
    try {
      var p = JSON.parse(raw);
      if (p && typeof p.id === 'string') return p.id;
      if (typeof p === 'string') return p;
    } catch (e) { return raw; }
    return null;
  }

  function render() {
    var list = readList();
    var feed = document.querySelector('[data-checkin-feed]');
    var total = document.querySelector('[data-checkin-total]');
    if (total) total.textContent = list.length + ' logged';
    if (!feed) return;
    feed.innerHTML = '';
    if (list.length === 0) {
      var empty = document.createElement('li');
      empty.className = 'checkin__empty mono';
      empty.dataset.checkinEmpty = '';
      empty.textContent = 'No check-ins yet. Tap CHECK IN to log a moment, or tap a location chip to log + tag in one move.';
      feed.appendChild(empty);
      return;
    }
    list.slice(0, 5).forEach(function (entry) {
      var li = document.createElement('li');
      li.className = 'checkin__row-item';
      var dot = document.createElement('span');
      dot.className = 'checkin__dot';
      li.appendChild(dot);
      var meta = document.createElement('div');
      meta.className = 'checkin__meta';
      var when = document.createElement('span');
      when.className = 'checkin__when mono';
      when.textContent = recencyLabel(entry.ts);
      meta.appendChild(when);
      var bits = [];
      if (entry.location) bits.push(entry.location);
      if (entry.mood) bits.push('mood: ' + entry.mood);
      if (entry.note) bits.push('"' + entry.note + '"');
      var line = document.createElement('span');
      line.className = 'checkin__line';
      line.textContent = bits.length ? bits.join(' · ') : 'here';
      meta.appendChild(line);
      li.appendChild(meta);
      feed.appendChild(li);
    });
    if (list.length > 5) {
      var more = document.createElement('li');
      more.className = 'checkin__more mono';
      more.textContent = '+ ' + (list.length - 5) + ' more on /profile';
      feed.appendChild(more);
    }
  }

  function logCheckIn(opts) {
    opts = opts || {};
    var entry = {
      ts: new Date().toISOString(),
      mood: opts.mood !== undefined ? opts.mood : readMood(),
      note: opts.note || null,
      location: opts.location || null,
    };
    var list = readList();
    list.unshift(entry);
    if (list.length > CAP) list = list.slice(0, CAP);
    writeList(list);
    render();
    // Pulse the button briefly.
    var btn = document.querySelector('[data-checkin-go]');
    if (btn) {
      btn.classList.add('checkin__btn--just');
      setTimeout(function () { btn.classList.remove('checkin__btn--just'); }, 1200);
    }
  }

  document.addEventListener('click', function (ev) {
    var t = ev.target;
    if (!(t instanceof Element)) return;
    var goEl = t.closest('[data-checkin-go]');
    if (goEl) {
      var raw = window.prompt('What\'s up? (optional, max 140 chars)');
      var note = raw ? String(raw).trim().slice(0, 140) : null;
      logCheckIn({ note: note });
      return;
    }
    var locEl = t.closest('[data-checkin-loc]');
    if (locEl) {
      var loc = locEl.getAttribute('data-checkin-loc');
      logCheckIn({ location: loc });
      return;
    }
    var customEl = t.closest('[data-checkin-custom]');
    if (customEl) {
      var rawLoc = window.prompt('Custom location? (e.g. "downtown ES", "bayou", "the jacuzzi")');
      var loc2 = rawLoc ? String(rawLoc).trim().slice(0, 40) : null;
      if (!loc2) return;
      var noteRaw = window.prompt('Note? (optional)');
      var note2 = noteRaw ? String(noteRaw).trim().slice(0, 140) : null;
      logCheckIn({ location: loc2, note: note2 });
      return;
    }
  });

  function init() { render(); }
  try { init(); } catch (e) {}
  document.addEventListener('astro:page-load', init);
  // Refresh recency every 60s.
  setInterval(render, 60000);
})();
</script>

<style is:global>
  .checkin {
    margin: 14px 0 18px;
    padding: 12px 14px;
    border: 2px solid var(--pc-ink, #1a1a1a);
    background:
      linear-gradient(180deg, #fff 0%, #fff5e1 100%),
      repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.03) 0 2px, transparent 2px 7px);
    box-shadow: 4px 4px 0 var(--pc-ink, #1a1a1a);
  }

  .checkin__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    border-bottom: 1.5px dashed var(--pc-ink, #1a1a1a);
    padding-bottom: 6px;
  }
  .checkin__kicker {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pc-ink, #1a1a1a);
    font-weight: 700;
  }
  .checkin__total {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--pc-ink-muted, #5b5b55);
    text-transform: uppercase;
  }

  .checkin__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
  }

  .checkin__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 2px solid var(--pc-ink, #1a1a1a);
    background: #ff7a3d;
    color: #1a1a1a;
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--pc-ink, #1a1a1a);
    cursor: pointer;
  }
  .checkin__btn:hover {
    background: #d11149;
    color: #fff5d6;
  }
  .checkin__btn--just {
    background: #2ec56b;
    color: #1a1a1a;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--pc-ink, #1a1a1a);
  }

  .checkin__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .checkin__chip {
    border: 1px solid var(--pc-ink, #1a1a1a);
    background: #fff;
    color: var(--pc-ink, #1a1a1a);
    padding: 4px 7px;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    cursor: pointer;
  }
  .checkin__chip:hover {
    background: #ffd166;
  }
  .checkin__chip--custom {
    background: #f3eee2;
    font-style: italic;
  }

  .checkin__feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .checkin__empty {
    padding: 8px 10px;
    background: #fff;
    border: 1px dashed var(--pc-rule, #d6d4cd);
    color: var(--pc-ink-soft, #5b5b55);
    font-size: 11px;
    line-height: 1.45;
  }
  .checkin__row-item {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    padding: 6px 9px;
    background: #fff;
    border: 1px solid var(--pc-ink, #1a1a1a);
  }
  .checkin__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2ec56b;
    margin-top: 5px;
    border: 1px solid var(--pc-ink, #1a1a1a);
  }
  .checkin__meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .checkin__when {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--pc-ink-muted, #5b5b55);
    text-transform: uppercase;
  }
  .checkin__line {
    font-size: 12px;
    color: var(--pc-ink, #1a1a1a);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .checkin__more {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--pc-ink-muted, #5b5b55);
    text-transform: uppercase;
    margin-top: 2px;
  }

  .checkin .mono {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
  }

  @media (max-width: 720px) {
    .checkin__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
