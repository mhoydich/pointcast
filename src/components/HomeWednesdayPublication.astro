---
import {
  GOOD_WORK,
  WEDNESDAY_ISSUES,
  WEDNESDAY_PUBLICATION,
} from '../lib/wednesday-publication';

const issue = GOOD_WORK;
const firstIssue = WEDNESDAY_ISSUES[0];
---

<section class="home-wed" aria-labelledby="home-wed-title">
  <header class="home-wed__wire mono">
    <span>WEDNESDAY / 9:34 PT</span>
    <span>A POINTCAST PLAYLIST PUBLICATION</span>
    <span>ISSUE 002 / BLOCK {issue.blockId}</span>
  </header>

  <div class="home-wed__main">
    <a class="home-wed__cover" href={issue.route} aria-label={`Open ${issue.displayTitle}`}>
      <img
        src={issue.cover}
        alt={issue.coverAlt}
        width="1536"
        height="1536"
        loading="eager"
        fetchpriority="high"
      />
      <span class="home-wed__stamp mono">PLAY<br />002</span>
    </a>

    <div class="home-wed__copy">
      <p class="home-wed__eyebrow mono">IT’S 9:34 / THE BOARD IS REAL</p>
      <h2 id="home-wed-title"><span>WEDNES</span><span>DAY</span></h2>
      <div class="home-wed__time">
        <strong>9:34</strong>
        <span>{issue.shortTitle}</span>
      </div>
      <p class="home-wed__dek">
        Eighteen tracks for clearing the board without treating life like a
        dashboard. Art-forward momentum for the good work.
      </p>
      <div class="home-wed__actions">
        <a href={issue.route}>Get me that Wednesday playlist ↗</a>
        <a href={WEDNESDAY_PUBLICATION.route}>Publication + calendar ↗</a>
      </div>
    </div>
  </div>

  <footer class="home-wed__footer">
    <div>
      <p class="mono">THE PUBLICATION PROMISE</p>
      <strong>{WEDNESDAY_PUBLICATION.cadence.label}</strong>
      <span>Human edited. Cover, sequence, page, JSON, Block, playback.</span>
    </div>
    <a class="home-wed__archive" href={firstIssue.route}>
      <img src={firstIssue.cover} alt="" width="1536" height="1536" loading="lazy" />
      <span>
        <small class="mono">ISSUE 001 / ALSO LIVE</small>
        <strong>{firstIssue.subtitle}</strong>
        <small>Porch-to-sky, picky, plucky, grateful.</small>
      </span>
    </a>
    <nav class="home-wed__participation" aria-label="WEDNESDAY 9:34 participation">
      <a href="/super-follow">follow locally</a>
      <a href="/ping">pitch a Wednesday</a>
      <a href={WEDNESDAY_PUBLICATION.jsonRoute}>publication JSON</a>
    </nav>
  </footer>
</section>

<style>
  .home-wed {
    --wed-ink: #11110e;
    --wed-acid: #d9ed00;
    --wed-blue: #1847d1;
    --wed-paper: #f4f0df;
    margin-top: 16px;
    border: 2px solid var(--wed-ink);
    background: var(--wed-paper);
    color: var(--wed-ink);
    overflow: hidden;
  }

  .home-wed a { color: inherit; }
  .mono { font-family: var(--pc-font-mono); }

  .home-wed__wire {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 13px;
    background: var(--wed-ink);
    color: var(--wed-paper);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .11em;
  }

  .home-wed__main {
    display: grid;
    grid-template-columns: minmax(340px, .96fr) minmax(0, 1.04fr);
    min-height: 670px;
  }

  .home-wed__cover {
    position: relative;
    display: block;
    min-width: 0;
    border-right: 2px solid var(--wed-ink);
    background: var(--wed-acid);
    overflow: hidden;
  }

  .home-wed__cover img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 670px;
    object-fit: cover;
    transition: filter 180ms ease, transform 360ms ease;
  }

  .home-wed__cover:hover img,
  .home-wed__cover:focus-visible img {
    filter: saturate(1.08);
    transform: scale(1.012);
  }

  .home-wed__stamp {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 78px;
    aspect-ratio: 1;
    border: 2px solid var(--wed-ink);
    border-radius: 50%;
    background: var(--wed-paper);
    font-size: 11px;
    font-weight: 950;
    letter-spacing: .08em;
    line-height: 1.05;
    text-align: center;
    transform: rotate(7deg);
  }

  .home-wed__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(28px, 4.8vw, 70px);
    background:
      linear-gradient(164deg, transparent 0 76%, rgba(24, 71, 209, .15) 76.2% 77.3%, transparent 77.5%),
      var(--wed-acid);
  }

  .home-wed__eyebrow {
    margin: 0 0 auto;
    font-size: 9px;
    font-weight: 950;
    letter-spacing: .12em;
  }

  .home-wed h2 {
    display: flex;
    flex-direction: column;
    margin: 40px 0 0;
    font-size: clamp(76px, 9.6vw, 152px);
    font-weight: 950;
    letter-spacing: -.095em;
    line-height: .7;
  }

  .home-wed h2 span:last-child {
    color: var(--wed-blue);
    transform: translateX(13%);
  }

  .home-wed__time {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-top: 38px;
  }

  .home-wed__time strong {
    font-size: clamp(56px, 7vw, 104px);
    letter-spacing: -.08em;
    line-height: .8;
  }

  .home-wed__time span {
    max-width: 9ch;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .home-wed__dek {
    max-width: 34ch;
    margin: 30px 0;
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 680;
    letter-spacing: -.025em;
    line-height: 1.08;
  }

  .home-wed__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .home-wed__actions a {
    padding: 13px 15px;
    border: 2px solid var(--wed-ink);
    background: var(--wed-blue);
    color: white;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 950;
    letter-spacing: .075em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .home-wed__actions a:last-child {
    background: var(--wed-paper);
    color: var(--wed-ink);
  }

  .home-wed__footer {
    display: grid;
    grid-template-columns: 1fr minmax(260px, .9fr) auto;
    gap: 18px;
    align-items: center;
    padding: 14px;
    border-top: 2px solid var(--wed-ink);
  }

  .home-wed__footer > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .home-wed__footer p,
  .home-wed__footer span,
  .home-wed__footer small {
    margin: 0;
    font-size: 9px;
    line-height: 1.3;
  }

  .home-wed__footer p {
    font-weight: 950;
    letter-spacing: .1em;
  }

  .home-wed__archive {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 10px;
    align-items: center;
    text-decoration: none;
  }

  .home-wed__archive img {
    display: block;
    width: 56px;
    aspect-ratio: 1;
    border: 1px solid var(--wed-ink);
    object-fit: cover;
  }

  .home-wed__archive span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .home-wed__participation {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--pc-font-mono);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .home-wed__wire span:nth-child(2) { display: none; }
    .home-wed__main {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .home-wed__cover { border-right: 0; border-bottom: 2px solid var(--wed-ink); }
    .home-wed__cover img { min-height: 0; aspect-ratio: 1; }
    .home-wed__copy { min-height: 610px; }
    .home-wed__footer { grid-template-columns: 1fr 1fr; }
    .home-wed__participation {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      padding-top: 10px;
      border-top: 1px solid var(--wed-ink);
    }
  }

  @media (max-width: 520px) {
    .home-wed__wire { font-size: 7px; }
    .home-wed__copy { min-height: 500px; padding: 25px 18px; }
    .home-wed h2 { font-size: clamp(66px, 23vw, 94px); }
    .home-wed__time { margin-top: 28px; }
    .home-wed__time strong { font-size: 58px; }
    .home-wed__footer { grid-template-columns: 1fr; }
    .home-wed__participation { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-wed__cover img { transition: none; }
  }
</style>
