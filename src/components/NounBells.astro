      #fffaf0;
    color: #1a1208;
    box-shadow: 8px 8px 0 rgba(26, 18, 8, 0.12);
  }

  .noun-bell-ladder__head {
    display: grid;
    grid-template-columns: minmax(140px, 0.24fr) minmax(0, 1fr) auto;
    gap: 12px;
