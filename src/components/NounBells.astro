---
/**
 * NounBells - a 100-rung playable ladder of uniquely tuned nouns.
 *
 * v1: deterministic 100-rung ladder.
 * v2: octave and chord filters.
 * v3: eight-rung phrase rail with replay.
 * v4: room-signal status and /api/sounds broadcast on every hit.
 * v5: Polygon Bell collectible unlock after five unique rungs.
 * v6: MetaMask publish lane for an on-chain Polygon proof.
 */
import { POLYGON_BELL_TOKEN } from '../lib/polygon-bell-token';

const count = 100;
const totalNouns = 1200;
const stride = Math.floor(totalNouns / count);
const scale = [
  130.81, 146.83, 164.81, 196.00, 220.00,
  261.63, 293.66, 329.63, 392.00, 440.00,
  523.25, 587.33, 659.25, 783.99, 880.00,
  1046.5,
];

const noteNames = new Map<number, string>([
  [130.81, 'C3'], [146.83, 'D3'], [164.81, 'E3'], [196.00, 'G3'], [220.00, 'A3'],
  [261.63, 'C4'], [293.66, 'D4'], [329.63, 'E4'], [392.00, 'G4'], [440.00, 'A4'],
  [523.25, 'C5'], [587.33, 'D5'], [659.25, 'E5'], [783.99, 'G5'], [880.00, 'A5'],
  [1046.5, 'C6'],
]);

const filters = [
  { id: 'all', label: 'All', note: '100' },
  { id: 'low', label: 'Low', note: 'C3-A3' },
  { id: 'mid', label: 'Mid', note: 'C4-A4' },
  { id: 'high', label: 'High', note: 'C5-C6' },
  { id: 'chord', label: 'Chord', note: '2-note' },
];

const token = POLYGON_BELL_TOKEN;
const phraseSlots = Array.from({ length: 8 }, (_, i) => i + 1);

function hashVoice(nounId: number, seed: number): number {
  const x = Math.sin(nounId * (seed * 1337.42 + 1) + seed * 97.31) * 43758.5453;
  return x - Math.floor(x);
}

function nounVoiceMeta(nounId: number): { baseFreq: number; secondFreq: number | null } {
  const baseIdx = Math.floor(hashVoice(nounId, 1) * scale.length);
  const baseFreq = scale[baseIdx];
  let secondFreq: number | null = null;

  if (hashVoice(nounId, 2) > 0.4) {
    const offsets = [2, 3, 4, 5, -2, -3];
    const off = offsets[Math.floor(hashVoice(nounId, 3) * offsets.length)];
    const secIdx = Math.max(0, Math.min(scale.length - 1, baseIdx + off));
    if (secIdx !== baseIdx) secondFreq = scale[secIdx];
  }

  return { baseFreq, secondFreq };
}

const rungs = [];
for (let i = 0; i < count; i++) {
  const lo = i * stride;
  const offset = (i * 7 + 3) % stride;
  const nounId = Math.min(totalNouns - 1, lo + offset);
  const voice = nounVoiceMeta(nounId);
  const note = noteNames.get(voice.baseFreq) ?? `${Math.round(voice.baseFreq)} hz`;
  const band = voice.baseFreq < 261.63 ? 'low' : voice.baseFreq < 523.25 ? 'mid' : 'high';
  const shape = voice.secondFreq ? 'chord' : 'single';
  const accent = `hsl(${(nounId * 47) % 360} 78% 46%)`;
  rungs.push({ index: i + 1, nounId, note, band, shape, accent });
}
---

<section class="noun-bell-ladder" id="noun-bells" aria-labelledby="noun-bell-ladder-title">
  <div class="noun-bell-ladder__head">
    <p class="noun-bell-ladder__kicker">PointCast.xyz &middot; lobby instrument</p>
    <div class="noun-bell-ladder__title-block">
      <h2 id="noun-bell-ladder-title">Nouns Bell Ladder</h2>
      <p>100 rungs &middot; deterministic Noun voices &middot; room broadcast</p>
    </div>
    <div class="noun-bell-ladder__meter" aria-label="100 rungs">
      <span>100</span>
      <small>rungs</small>
    </div>
  </div>

  <div class="noun-bell-ladder__versions" aria-label="Build versions">
    <span><strong>v1</strong> 100 rung ladder</span>
    <span><strong>v2</strong> octave filters</span>
    <span><strong>v3</strong> phrase replay</span>
    <span><strong>v4</strong> room signal</span>
    <span><strong>v5</strong> Polygon token</span>
    <span><strong>v6</strong> MetaMask publish</span>
  </div>

  <div class="noun-bell-ladder__controls" aria-label="Nouns bell ladder controls">
    <div class="noun-bell-ladder__filters" role="group" aria-label="Filter rungs">
      {filters.map((filter, index) => (
        <button
          type="button"
          class="noun-bell-filter"
          data-bell-filter={filter.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span>{filter.label}</span>
          <small>{filter.note}</small>
        </button>
      ))}
    </div>
    <div class="noun-bell-ladder__actions" role="group" aria-label="Phrase actions">
      <button type="button" class="noun-bell-action" data-bell-play-phrase>Play phrase</button>
      <button type="button" class="noun-bell-action" data-bell-clear-phrase>Clear</button>
    </div>
  </div>

  <div class="noun-bell-ladder__phrase" aria-label="Eight rung phrase rail">
    <p class="noun-bell-ladder__phrase-label">v3 phrase rail</p>
    <div class="noun-bell-ladder__phrase-slots">
      {phraseSlots.map((slot) => (
        <span class="noun-bell-ladder__phrase-slot" data-phrase-slot={slot}>
          <small>{String(slot).padStart(2, '0')}</small>
          <strong>empty</strong>
        </span>
      ))}
    </div>
  </div>

  <aside
    class="noun-bell-ladder__token"
    aria-labelledby="polygon-bell-title"
    data-polygon-bell
    data-polygon-bell-unlock={token.unlockRings}
  >
    <div class="noun-bell-token__art">
      <img src={token.imagePath} alt="" width="112" height="112" loading="lazy" />
    </div>
    <div class="noun-bell-token__copy">
      <p class="noun-bell-token__kicker">v6 collectible · {token.chain} · chain {token.chainId}</p>
      <h3 id="polygon-bell-title">{token.name}</h3>
      <p>{token.unlockRings} unique rungs unlock a local receipt and a MetaMask publish lane on Polygon.</p>
    </div>
    <div class="noun-bell-token__actions">
      <button type="button" class="noun-bell-action" data-polygon-bell-collect disabled>Collect receipt</button>
      <a class="noun-bell-action" href={token.publishHref}>Publish proof</a>
      <small data-polygon-bell-state>{`0/${token.unlockRings} rungs`}</small>
    </div>
  </aside>

  <p class="noun-bell-ladder__status" data-bell-status aria-live="polite">
    v4 room signal ready. Tap a rung to ring the lobby.
  </p>

  <div class="noun-bell-ladder__stage">
    <div class="noun-bell-ladder__plaque" aria-hidden="true">
      <span class="noun-bell-ladder__plaque-mark">PC</span>
      <span class="noun-bell-ladder__plaque-line"></span>
      <span>001-100</span>
      <span>NOUNS</span>
    </div>

    <ol class="noun-bell-ladder__rungs" aria-label="Nouns bell ladder with 100 playable rungs">
      {rungs.map((rung) => (
        <li
          class="noun-bell-rung"
          data-rung-band={rung.band}
          data-rung-shape={rung.shape}
          style={`--rung-accent: ${rung.accent};`}
        >
          <button
            type="button"
            class="noun-bell"
            data-bell-index={rung.index}
            data-bell-noun={rung.nounId}
            data-bell-note={rung.note}
            data-bell-band={rung.band}
            data-bell-shape={rung.shape}
            aria-label={`Play rung ${rung.index}, Noun ${rung.nounId}, ${rung.note}`}
          >
            <span class="noun-bell__number">{String(rung.index).padStart(3, '0')}</span>
            <span class="noun-bell__rail-dot" aria-hidden="true"></span>
            <span class="noun-bell__art">
              <img
                src={`https://noun.pics/${rung.nounId}.svg`}
                alt=""
                aria-hidden="true"
                width="56"
                height="56"
                loading={rung.index <= 12 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={rung.index <= 12 ? 'high' : 'low'}
              />
            </span>
            <span class="noun-bell__copy">
              <span class="noun-bell__noun">Noun #{rung.nounId}</span>
              <span class="noun-bell__tone">{rung.note} &middot; {rung.band} &middot; {rung.shape}</span>
            </span>
            <span class="noun-bell__bar" aria-hidden="true"></span>
            <span class="noun-bell__ping" aria-hidden="true"></span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { playNounVoice, broadcastSound } from '../lib/chimes';

  const root = document.getElementById('noun-bells');
  const phrase = [];
  const tokenRungs = new Set();
  const tokenStorageKey = 'pc:polygon-bell:001';
  const tokenLadderKey = 'pc:polygon-bell:ladder-rungs';
  const tokenUnlockRings = Number(root?.querySelector('[data-polygon-bell]')?.getAttribute('data-polygon-bell-unlock') || 5);
  let activeFilter = 'all';
  let replaying = false;

  function setStatus(message) {
    const status = root?.querySelector('[data-bell-status]');
    if (status) status.textContent = message;
  }

  function pulse(el) {
    el.classList.remove('noun-bell--ringing');
    void el.offsetWidth;
    el.classList.add('noun-bell--ringing');
    setTimeout(() => el.classList.remove('noun-bell--ringing'), 520);
  }

  function renderPhrase() {
    root?.querySelectorAll('[data-phrase-slot]').forEach((slot, i) => {
      const hit = phrase[i];
      const label = slot.querySelector('strong');
      slot.style.removeProperty('--slot-accent');
      slot.toggleAttribute('data-filled', Boolean(hit));
      if (!label) return;
      if (!hit) {
        label.textContent = 'empty';
        return;
      }
      label.textContent = `#${hit.nounId} ${hit.note}`;
      slot.style.setProperty('--slot-accent', `hsl(${(hit.nounId * 47) % 360} 78% 46%)`);
    });
  }

  function addToPhrase(hit) {
    phrase.push(hit);
    while (phrase.length > 8) phrase.shift();
    renderPhrase();
  }

  function readJson(key, fallback) {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch {
      return fallback;
    }
  }

  function shortAddress(address) {
    return address && address.length > 12 ? `${address.slice(0, 6)}...${address.slice(-4)}` : address || '';
  }

  function saveTokenRungs() {
    localStorage.setItem(tokenLadderKey, JSON.stringify([...tokenRungs]));
  }

  function renderTokenState() {
    const state = root?.querySelector('[data-polygon-bell-state]');
    const collect = root?.querySelector('[data-polygon-bell-collect]');
    const savedReceipt = readJson(tokenStorageKey, null);
    if (savedReceipt) {
      if (state) state.textContent = `collected ${savedReceipt.receiptId} · ${shortAddress(savedReceipt.address) || 'local visitor'}`;
      collect?.setAttribute('disabled', 'true');
      return;
    }

    const count = Math.min(tokenRungs.size, tokenUnlockRings);
    if (state) state.textContent = `${count}/${tokenUnlockRings} rungs`;
    collect?.toggleAttribute('disabled', count < tokenUnlockRings);
  }

  function hydrateTokenRungs() {
    const saved = readJson(tokenLadderKey, []);
    if (Array.isArray(saved)) {
      saved.forEach((value) => tokenRungs.add(String(value)));
    }
    renderTokenState();
  }

  function collectPolygonBell() {
    if (tokenRungs.size < tokenUnlockRings) {
      setStatus(`v5 Polygon Bell: ring ${tokenUnlockRings - tokenRungs.size} more unique rungs.`);
      renderTokenState();
      return;
    }

    const previous = readJson(tokenStorageKey, null);
    if (previous) {
      renderTokenState();
      setStatus(`v5 Polygon Bell already collected: ${previous.receiptId}.`);
      return;
    }

    let wallet = null;
    try { wallet = JSON.parse(localStorage.getItem('pc:wallet') || 'null'); } catch {}
    const receipt = {
      receiptId: `pcbell-${Date.now().toString(36)}`,
      tokenId: '1',
      chain: 'polygon',
      chainId: 137,
      address: wallet?.chain === 'eth' ? wallet.address : null,
      rungs: [...tokenRungs].slice(-8),
      phrase: phrase.slice(-8),
      collectedAt: new Date().toISOString(),
    };
    localStorage.setItem(tokenStorageKey, JSON.stringify(receipt));
    renderTokenState();
    setStatus(`v5 Polygon Bell collected: ${receipt.receiptId}. Publish lane is open on the token page.`);
  }

  function ring(btn, shouldAddToPhrase = true) {
    const nounId = Number(btn.dataset.bellNoun ?? 0);
    const index = Number(btn.dataset.bellIndex ?? 0);
    const note = btn.dataset.bellNote ?? '';
    const band = btn.dataset.bellBand ?? '';
    const shape = btn.dataset.bellShape ?? '';
    playNounVoice(nounId);
    broadcastSound('profile', nounId);
    pulse(btn);
    if (shouldAddToPhrase) addToPhrase({ index, nounId, note, band, shape });
    tokenRungs.add(String(index));
    saveTokenRungs();
    renderTokenState();
    setStatus(`v4 room signal: rung ${String(index).padStart(3, '0')} rang Noun #${nounId} at ${note}.`);
  }

  function applyFilter(nextFilter) {
    activeFilter = nextFilter;
    root?.querySelectorAll('[data-bell-filter]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.bellFilter === activeFilter));
    });

    let visible = 0;
    root?.querySelectorAll('.noun-bell-rung').forEach((rung) => {
      const matches =
        activeFilter === 'all' ||
        rung.dataset.rungBand === activeFilter ||
        rung.dataset.rungShape === activeFilter;
      rung.hidden = !matches;
      if (matches) visible += 1;
    });
    setStatus(`v2 filter: ${activeFilter} showing ${visible} rungs.`);
  }

  function replayPhrase() {
    if (replaying || phrase.length === 0) {
      if (phrase.length === 0) setStatus('v3 phrase rail is empty. Tap up to 8 rungs first.');
      return;
    }
    replaying = true;
    setStatus(`v3 replay: playing ${phrase.length} rung phrase.`);
    phrase.forEach((hit, i) => {
      setTimeout(() => {
        const btn = root?.querySelector(`.noun-bell[data-bell-noun="${hit.nounId}"]`);
        if (btn) ring(btn, false);
        if (i === phrase.length - 1) {
          setTimeout(() => {
            replaying = false;
            setStatus('v3 replay complete. Phrase rail is ready.');
          }, 220);
        }
      }, i * 220);
    });
  }

  root?.addEventListener('pointerdown', (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;

    const bell = target.closest('.noun-bell');
    if (bell) {
      ring(bell);
      return;
    }

    const filter = target.closest('[data-bell-filter]');
    if (filter) {
      applyFilter(filter.dataset.bellFilter ?? 'all');
      return;
    }

    if (target.closest('[data-bell-play-phrase]')) {
      replayPhrase();
      return;
    }

    if (target.closest('[data-bell-clear-phrase]')) {
      phrase.length = 0;
      renderPhrase();
      setStatus('v3 phrase rail cleared.');
      return;
    }

    if (target.closest('[data-polygon-bell-collect]')) {
      collectPolygonBell();
    }
  });

  renderPhrase();
  hydrateTokenRungs();
</script>

