<section class="playground" aria-label="Match replay">
  <div class="scoreboard"><strong id="left-score">LEFT · 12</strong><span id="arena-clock">READY WHEN YOU ARE</span><strong id="right-score">RIGHT · 12</strong></div>
  <canvas id="arena-canvas" width="1000" height="600" aria-label="Animated tactical exhibition replay">Match events are available in the text feed below.</canvas>
  <div class="replay-bar">
    <button id="arena-play" disabled>Play replay</button><button id="arena-restart" disabled>Restart</button>
    <label>Speed<select id="arena-speed"><option value="1">1×</option><option value="2">2×</option><option value="4">4×</option></select></label>
    <label class="scrub">Replay<input id="arena-scrub" type="range" min="0" max="1" value="0" disabled /></label>
    <button id="arena-download" disabled>Download record ↓</button>
  </div>
</section>
