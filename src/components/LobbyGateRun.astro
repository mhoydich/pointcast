<section class="lobby-gate-run" id="lobby-gates" aria-labelledby="lobby-gate-run-title">
  <div class="lobby-gate-run__head">
    <p class="lobby-gate-run__kicker">new side quest</p>
    <h2 id="lobby-gate-run-title"><span class="dot"></span> Lobby Gate Run</h2>
    <p>
      Click-count gates, tiny rituals, and little jumps around PointCast. Start at gate one and keep going.
    </p>
  </div>

  <div class="lobby-gate-run__meter" aria-label="Gate run progress">
    <span data-gate-run-count>0/5</span>
    <div class="lobby-gate-run__track" aria-hidden="true">
      <span data-gate-run-bar></span>
    </div>
  </div>

  <ol class="lobby-gate-run__list">
    <li data-gate-card="knock">
      <strong>01</strong>
      <span>knock five times</span>
      <em data-gate-card-status>ready</em>
    </li>
    <li data-gate-card="errands">
      <strong>02</strong>
      <span>do ten small things</span>
      <em data-gate-card-status>locked-ish</em>
    </li>
    <li data-gate-card="bells">
      <strong>03</strong>
      <span>ring eight notes</span>
      <em data-gate-card-status>locked-ish</em>
    </li>
    <li data-gate-card="routes">
      <strong>04</strong>
      <span>stamp six routes</span>
      <em data-gate-card-status>locked-ish</em>
    </li>
    <li data-gate-card="again">
      <strong>05</strong>
      <span>keep going</span>
      <em data-gate-card-status>locked-ish</em>
    </li>
  </ol>

  <div class="lobby-gate-run__actions">
    <a class="lobby-gate-run__start" href="/lobby/gate-one" data-gate-run-start>Start gate run</a>
    <button type="button" data-gate-run-reset>Reset wristband</button>
  </div>
</section>

<script>
  const gateIds = ['knock', 'errands', 'bells', 'routes', 'again'];
  const gateRoutes = ['/lobby/gate-one', '/lobby/gate-two', '/lobby/gate-three', '/lobby/gate-four', '/lobby/gate-five'];
  const storageKey = 'pc:lobby-gates:v1';

  function readRun() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || '{}');
    } catch {
      return {};
    }
  }

  function writeRun(state) {
    try {
      localStorage.setItem(storageKey, JSON.stringify(state));
    } catch {}
  }

  function initLobbyGateRun() {
    const runRoot = document.getElementById('lobby-gates');
    if (!runRoot || runRoot.hasAttribute('data-gate-run-bound')) return;
    runRoot.setAttribute('data-gate-run-bound', '');

    function paintRun() {
    const state = readRun();
    const completed = gateIds.filter((id) => state[id]?.complete).length;
    const count = runRoot?.querySelector('[data-gate-run-count]');
    const bar = runRoot?.querySelector('[data-gate-run-bar]');
    const start = runRoot?.querySelector('[data-gate-run-start]');
    if (count) count.textContent = `${completed}/5`;
    if (bar) bar.style.inlineSize = `${(completed / gateIds.length) * 100}%`;
    if (start) {
      const nextIndex = Math.min(completed, gateRoutes.length - 1);
      start.setAttribute('href', gateRoutes[nextIndex]);
      start.textContent = completed === 0 ? 'Start gate run' : completed === gateIds.length ? 'Run the last machine again' : `Continue gate ${nextIndex + 1}`;
    }

    gateIds.forEach((id, i) => {
      const card = runRoot?.querySelector(`[data-gate-card="${id}"]`);
      const status = card?.querySelector('[data-gate-card-status]');
      const done = Boolean(state[id]?.complete);
      const open = i === 0 || Boolean(state[gateIds[i - 1]]?.complete);
      card?.toggleAttribute('data-done', done);
      card?.toggleAttribute('data-open', open);
      if (status) status.textContent = done ? 'open' : open ? 'ready' : 'locked-ish';
    });
    }

    runRoot.querySelector('[data-gate-run-reset]')?.addEventListener('click', () => {
      writeRun({});
      paintRun();
    });

    paintRun();
  }

  initLobbyGateRun();
  document.addEventListener('astro:page-load', initLobbyGateRun);
</script>

<style>
  .lobby-gate-run {
    margin: 0 0 2rem;
    border: 2px solid #1a1208;
    background:
      repeating-linear-gradient(90deg, rgba(26, 18, 8, 0.04) 0 10px, transparent 10px 20px),
      #fffdf8;
    color: #1a1208;
    box-shadow: 7px 7px 0 rgba(26, 18, 8, 0.12);
  }

  .lobby-gate-run__head {
    padding: 1rem;
    border-bottom: 2px solid #1a1208;
    background:
      linear-gradient(90deg, rgba(74, 214, 255, 0.22), transparent 46%),
      #fffaf0;
  }

  .lobby-gate-run__kicker,
  .lobby-gate-run__head p,
  .lobby-gate-run__meter,
  .lobby-gate-run__list,
  .lobby-gate-run__actions {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lobby-gate-run__kicker {
    margin: 0 0 0.35rem;
    color: #8a2432;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .lobby-gate-run h2 {
    margin-bottom: 0.35rem;
  }

  .lobby-gate-run__head p {
    max-width: 720px;
    margin: 0;
    color: #5f5e5a;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .lobby-gate-run__meter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid rgba(26, 18, 8, 0.42);
    font-size: 0.75rem;
  }

  .lobby-gate-run__track {
    height: 10px;
    border: 1px solid #1a1208;
    background: #f1ead8;
  }

  .lobby-gate-run__track span {
    display: block;
    inline-size: 0;
    block-size: 100%;
    background: repeating-linear-gradient(90deg, #0f6e56 0 12px, #ffd24a 12px 18px);
    transition: inline-size 220ms ease;
  }

  .lobby-gate-run__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #1a1208;
    font-size: 0.62rem;
  }

  .lobby-gate-run__list li {
    display: grid;
    gap: 0.3rem;
    min-height: 86px;
    padding: 0.75rem;
    background: #f3eee0;
    color: #7b7265;
  }

  .lobby-gate-run__list li[data-open] {
    color: #1a1208;
    background: #fffdf8;
  }

  .lobby-gate-run__list li[data-done] {
    background: #dff4e8;
  }

  .lobby-gate-run__list strong {
    color: #8a2432;
    font-size: 0.8rem;
  }

  .lobby-gate-run__list em {
    align-self: end;
    font-style: normal;
    color: #0f6e56;
  }

  .lobby-gate-run__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding: 1rem;
  }

  .lobby-gate-run__actions a,
  .lobby-gate-run__actions button {
    border: 1px solid #1a1208;
    border-radius: 0;
    background: #ffd24a;
    color: #1a1208;
    cursor: pointer;
    font: inherit;
    padding: 0.75rem 0.9rem;
    text-decoration: none;
  }

  .lobby-gate-run__actions button {
    background: #fffdf8;
  }

  @media (max-width: 760px) {
    .lobby-gate-run__list {
      grid-template-columns: 1fr;
    }

    .lobby-gate-run__list li {
      min-height: 0;
    }
  }
</style>
