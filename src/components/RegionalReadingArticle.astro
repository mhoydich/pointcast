---
import { assertRegionalStory, REGIONAL_READING_PATH, regionalReadingMinutes } from '../lib/regional-reading.mjs';
import '../styles/editorial-review.css';
const story = assertRegionalStory(Astro.props.story);
const sourcesById = new Map(story.sources.map(source => [source.id, source]));
---
<main class="ed">
  <header class="mast"><a href="/">POINTCAST</a><nav aria-label="Reading navigation"><a href={REGIONAL_READING_PATH}>Regional reading shelf</a><a href="/ues">UES learning</a></nav></header>
  <header class="hero"><div><p class="kicker">Regional reading / {story.country} / checked {story.checkedDate}</p><h1>{story.title}</h1><p class="dek">{story.dek}</p></div><aside class="hero-plate"><span>READ AT YOUR OWN PACE</span><strong>{regionalReadingMinutes(story)} MIN</strong><span>Sources, dates and regional differences stay beside the story.</span></aside></header>
  <nav class="jump" aria-label="Story contents"><a href="#summary">Quick reading</a>{story.sections.map(section => <a href={`#${section.id}`}>{section.heading}</a>)}<a href="#work">IndustryNext perspective</a><a href="#learning">UES prompts</a><a href="#sources">Sources</a></nav>
  <section id="summary" class="prose"><h2>Before the long read.</h2><ul class="checklist">{story.summary.map(point => <li>{point}</li>)}</ul>{story.scopeNote && <p class="note">{story.scopeNote}</p>}</section>
  {story.sections.map(section => <section id={section.id} class="prose"><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.sourceIds?.length > 0 && <p class="source-ref">Sources: {section.sourceIds.map(id => { const source = sourcesById.get(id); return <a href={source.url}>{source.title} ↗ </a>; })}</p>}{section.limitations && <p class="note">{section.limitations}</p>}</section>)}
  <section id="work" class="prose"><p class="kicker">IndustryNext / Practical work and business</p><h2>{story.companions.industrynext.title}</h2>{(story.companions.industrynext.paragraphs || []).map(paragraph => <p>{paragraph}</p>)}{story.companions.industrynext.questions?.length > 0 && <ul class="checklist">{story.companions.industrynext.questions.map(question => <li>{question}</li>)}</ul>}{story.companions.industrynext.note && <p class="note">{story.companions.industrynext.note}</p>}</section>
  <section id="learning" class="prose"><p class="kicker">UES / History and learning</p><h2>{story.companions.ues.title}</h2>{(story.companions.ues.paragraphs || []).map(paragraph => <p>{paragraph}</p>)}<ol class="checklist">{(story.companions.ues.prompts || []).map(prompt => <li>{prompt}</li>)}</ol><p class="note">Independent learning prompts, not an accredited course or credential. Use public, appropriately licensed material and keep observations separate from interpretation.</p><a href="/ues/regional-reading">Explore all four regional learning companions →</a></section>
  {story.readingList?.length > 0 && <section class="prose"><h2>Keep reading.</h2><ul class="checklist">{story.readingList.map(item => <li><a href={item.url}>{item.title}</a> — {item.why_read}</li>)}</ul></section>}
  <section id="sources"><h2>Follow the source trail.</h2><ol class="sources">{story.sources.map(source => <li><a href={source.url}>{source.title} ↗</a><small>{source.publisher} · {source.date || 'See source for its publication date'} · checked {story.checkedDate}</small>{source.dataPeriod && <small>Reference period: {source.dataPeriod}</small>}{source.supports && <p>{source.supports}</p>}{source.limitation && <p class="note">{source.limitation}</p>}</li>)}</ol>{story.limitations && <p class="note">{story.limitations}</p>}</section>
  <footer>PointCast regional reading / Prepared with Codex from sourced research. Country summaries preserve the differences between places, periods and data definitions.</footer>
</main>
