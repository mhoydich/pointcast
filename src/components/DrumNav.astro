---
const { current = '' } = Astro.props as { current?: string };
const items = [
  ['drum', '/drum'],
  ['v2', '/drum-v2'],
  ['v3', '/drum-v3'],
  ['quintet', '/drum-quintet'],
  ['altars', '/drum-altars'],
  ['radio', '/drum-radio'],
  ['now', '/drum-now'],
];
---

<nav class="drum-nav" aria-label="Drum pages">
  {items.map(([label, href]) => (
    <a class:list={['drum-nav__item', { 'is-active': current === label }]} href={href}>
      {label}
    </a>
  ))}
</nav>

<style>
  .drum-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .drum-nav__item {
    padding: 6px 10px;
    border: 1px solid #d8ccba;
    border-radius: 999px;
    color: #5f5e5a;
    text-decoration: none;
    background: #fffaf0;
  }
  .drum-nav__item.is-active {
    color: #12110e;
    border-color: #12110e;
    background: #f0e6d8;
  }
</style>
