---
const {poster=false}=Astro.props;
const colors=['#ed7848','#d9e477','#d58da3','#89b7a6'];
---
<svg id={poster?'poster':undefined} class={poster?'poster':undefined} viewBox={poster?'0 0 1000 1400':'0 0 800 600'} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={poster?'General Electric poster with sixteen geometric flowers':'Colorful geometric flowers on dark paper'}>
<rect width="100%" height="100%" fill={poster?'#f2eddf':'#222923'} id={poster?'paper':undefined}/>
{poster&&<><text x="70" y="102" font-family="Arial,Helvetica,sans-serif" font-size="25" letter-spacing="4" fill="#252a23">POINTCAST / LOS ANGELES POSTER ART</text><text id="poster-title" x="70" y="245" font-family="Arial,Helvetica,sans-serif" font-size="76" font-weight="bold" letter-spacing="-3" fill="#252a23">GENERAL ELECTRIC</text><line x1="70" y1="290" x2="930" y2="290" stroke="#252a23"/></>}
<g id={poster?'flowers':undefined}>
{Array.from({length:16},(_,i)=>{const x=poster?175+(i%4)*215:100+(i%4)*200;const y=poster?435+Math.floor(i/4)*215:75+Math.floor(i/4)*150;const r=poster?77:52;return <g class="flower"><circle cx={x} cy={y} r={r} fill={colors[i%4]}/><circle cx={x} cy={y} r={r*.46} fill={colors[(i+2)%4]}/>{Array.from({length:6},(_,j)=><circle cx={x+Math.cos(j*Math.PI/3)*r*.72} cy={y+Math.sin(j*Math.PI/3)*r*.72} r={r*.13} fill={colors[(i+1)%4]}/>)}</g>})}
</g>
{poster&&<><image id="local-image" x="70" y="350" width="860" height="860" preserveAspectRatio="xMidYMid meet" visibility="hidden"/><line x1="70" y1="1240" x2="930" y2="1240" stroke="#252a23"/><text x="70" y="1295" font-family="Arial,Helvetica,sans-serif" font-size="23" fill="#252a23">A CREATIVE EDITION / MICHAEL HOYDICH</text><text x="70" y="1340" font-family="Arial,Helvetica,sans-serif" font-size="18" letter-spacing="2" fill="#252a23">EL SEGUNDO, CALIFORNIA · POINTCAST</text></>}
</svg>
