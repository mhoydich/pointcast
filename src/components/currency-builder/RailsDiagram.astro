---
/**
 * The four Nouns Money layers as one loop: connection → money →
 * communication → verification, and back to the next check-in. Plain HTML so
 * it reflows to a column on a phone; reads the same data as rails.json.
 */
import { LAYERS } from '../../lib/nouns-money-rails.mjs';

const SHORT = {
  connection: { what: 'Here check-in', how: 'Someone shows up, anywhere on the network.' },
  money: { what: 'Notes + points', how: 'Series 1, Desk Notes and passed notes land on one ledger.' },
  communication: { what: 'Loom + MCP', how: 'Agents post who earned what, and read it back.' },
  verification: { what: 'Hash chains', how: 'Anyone can re-hash a profile and spot an edit.' },
};
---
<figure class="rails" aria-labelledby="rails-cap">
  <ol class="rails-loop">
    {LAYERS.map((layer, i) => (
      <li class={`rails-step rails-${layer.id}`}>
        <span class="rails-n">{i + 1} · {layer.name}</span>
        <strong>{SHORT[layer.id].what}</strong>
        <span class="rails-how">{SHORT[layer.id].how}</span>
      </li>
    ))}
  </ol>
  <p class="rails-back" aria-hidden="true"><span>↺</span> A verified profile is what the next check-in, and the next site, can trust.</p>
  <figcaption id="rails-cap">Four layers, one loop. Each is a public, CC0 document you can fork on its own. No cash value anywhere in it.</figcaption>
</figure>

<style>
  .rails { margin: 0; display: grid; gap: 10px; }
  .rails-loop { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; counter-reset: rails; }
  .rails-step { position: relative; background: var(--cb-card); border: 2px solid var(--cb-ink); padding: 14px 14px 16px; display: grid; gap: 6px; align-content: start; }
  .rails-step + .rails-step::before { content: '→'; position: absolute; left: -24px; top: 50%; transform: translateY(-50%); font: 700 20px/1 var(--cb-mono); color: var(--cb-ink); }
  .rails-n { font: 600 11px/1.3 var(--cb-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--cb-red); }
  .rails-step strong { font-size: 22px; letter-spacing: -0.02em; line-height: 1.1; }
  .rails-how { font-size: 14px; line-height: 1.4; color: var(--cb-muted); }
  .rails-connection { border-top-width: 8px; border-top-color: var(--cb-teal); }
  .rails-money { border-top-width: 8px; border-top-color: var(--cb-red); }
  .rails-communication { border-top-width: 8px; border-top-color: var(--cb-mustard); }
  .rails-verification { border-top-width: 8px; border-top-color: var(--cb-ink); }
  .rails-back { margin: 0; border: 1px dashed var(--cb-line); padding: 8px 12px; font: 13px/1.4 var(--cb-mono); color: var(--cb-muted); }
  .rails-back span { font-size: 16px; color: var(--cb-ink); margin-right: 6px; }
  .rails figcaption { font-size: 13px; color: var(--cb-muted); }
  @media (max-width: 760px) {
    .rails-loop { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .rails-step + .rails-step::before { content: '↓'; left: 50%; top: -22px; transform: translateX(-50%); }
  }
</style>
