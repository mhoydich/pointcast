---
/** Currency Builder masthead, shared by the home page and every collection. */
interface Props { current?: 'home' | 'series-1' | 'desk-notes' | 'blue-note' | 'commons' | 'barter' | 'almanac' | 'security'; json?: string }
const { current = 'home', json } = Astro.props;
const links = [
  { id: 'series-1', href: '/currency-builder/series-1/', label: 'Series 1' },
  { id: 'desk-notes', href: '/currency-builder/desk-notes/', label: 'Desk Notes' },
  { id: 'blue-note', href: '/currency-builder/blue-note/', label: 'Blue Note' },
  { id: 'commons', href: '/currency-builder/commons/', label: 'Commons' },
  { id: 'barter', href: '/currency-builder/barter/', label: 'Global Barter' },
  { id: 'almanac', href: '/currency-builder/almanac/', label: 'Almanac' },
  { id: 'security', href: '/currency-builder/security/', label: 'Security Edition' },
];
---
<header class="cb-top">
  <a class="cb-mark" href="/currency-builder/" aria-current={current === 'home' ? 'page' : undefined}>CURRENCY <span>BUILDER</span></a>
  <nav class="cb-nav" aria-label="Currency Builder">
    {links.map((link) => <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>)}
    <a href="/nouns-money/">Nouns Money ↗</a>
    <a href="/currency/">Currency atlas ↗</a>
    {json && <a href={json}>JSON</a>}
  </nav>
</header>
