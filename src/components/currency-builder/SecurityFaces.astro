---
/** Security Edition (v2) faces for one note, shown on Commons, Global Barter and Almanac detail pages. */
import { securityFiles, SECURITY_BASE } from '../../lib/currency-builder/security-edition.mjs';

interface Props { collection: 'commons' | 'barter' | 'almanac'; entry: { slug: string; name: string; nounId: number } }
const { collection, entry } = Astro.props;
const files = securityFiles(collection, entry);
---
<section class="cb-v2" aria-labelledby="cb-v2-title">
  <div class="cb-v2-head">
    <h2 id="cb-v2-title">Security Edition <span>v2</span></h2>
    <p>The same note set like a banknote: full engraved portrait of Noun #{entry.nounId}, guilloche, watermark, thread, foil stripe and microtext, all printed art. <a href={`${SECURITY_BASE}/`}>What's on it</a></p>
  </div>
  <div class="cb-faces">
    <figure>
      <a href={files.front}><img src={files.front} width="1200" height="600" loading="lazy" alt={`Security Edition front of ${entry.name}: a line-engraved portrait of the full actual Noun #${entry.nounId} in a guilloche oval beside a watermark window, thread and holographic-look stripe`} /></a>
      <figcaption>Security Edition · front</figcaption>
    </figure>
    <figure>
      <a href={files.back}><img src={files.back} width="1200" height="600" loading="lazy" alt={`Security Edition back of ${entry.name}: a color medallion of Noun #${entry.nounId} in a guilloche rosette, with the note's story`} /></a>
      <figcaption>Security Edition · back</figcaption>
    </figure>
  </div>
  <div class="cb-actions">
    <a href={files.front} download>v2 front SVG ↓</a>
    <a href={files.back} download>v2 back SVG ↓</a>
  </div>
</section>
