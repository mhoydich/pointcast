---
import { assertRegionalShelf, regionalReadingMinutes, regionalStoryPath } from '../lib/regional-reading.mjs';
import '../styles/editorial-review.css';
const stories = assertRegionalShelf(Astro.props.stories);
const countries = [...new Set(stories.map(story => story.country))].sort();
---
<main class="ed">
  <header class="mast"><a href="/">POINTCAST</a><nav aria-label="Reading shelf navigation"><a href="/ues">UES learning</a><a href="/el-segundo">El Segundo</a></nav></header>
  <header class="hero"><div><p class="kicker">Regional reading / Culture, history and economies</p><h1>A place deserves<br/>a longer read.</h1><p class="dek">Substantial stories to return to: how regions became what they are, what daily culture reveals, and which economic questions deserve a closer look.</p></div><aside class="hero-plate"><span>POINTCAST / READING SHELF</span><strong>{stories.length}</strong><span>Read a summary now. Follow the complete story when you have time.</span></aside></header>
  <section id="stories"><h2>Choose a story.</h2><form class="controls" data-editorial-filter role="search"><label>Search story or theme<input type="search" name="query" placeholder="Cities, work, culture, history…" autocomplete="off" /></label><label>Destination<select name="group"><option value="">All destinations</option>{countries.map(country => <option value={country}>{country}</option>)}</select></label><button type="reset">Reset filters</button></form><p data-count aria-live="polite">{stories.length} of {stories.length} cards</p><div class="grid">{stories.map(story => <article class="card" data-card data-group={story.country}><p class="meta">{story.country} · {regionalReadingMinutes(story)} minute reading estimate · checked {story.checkedDate}</p><h3><a href={regionalStoryPath(story)}>{story.title}</a></h3><p>{story.dek}</p><ul>{story.summary.slice(0, 3).map(point => <li>{point}</li>)}</ul>{story.topics?.length > 0 && <p>{story.topics.join(' · ')}</p>}<a href={regionalStoryPath(story)}>Read the full story →</a></article>)}</div><p class="empty" data-empty hidden>No stories match. Try another theme or reset the filters.</p><noscript><p>Every story remains available below. Search and destination filters require JavaScript.</p></noscript></section>
  <section class="split"><article class="card"><h2>Work and business.</h2><p>IndustryNext companions turn a story into practical questions about production, services, market assumptions and the work around them. They distinguish a research lead from a measured business result.</p></article><article class="card"><h2>History and learning.</h2><p>UES companions give readers source comparisons, historical questions and small learning exercises. They are independent learning, with no accreditation or credential claim.</p></article></section>
  <footer>PointCast main reading / IndustryNext practical work / UES history and learning. Dates and source definitions matter; a national average does not describe every person or region.</footer>
</main>
<script>
import { setupEditorialReview } from '../lib/editorial-review-client.js';
setupEditorialReview(); document.addEventListener('astro:page-load', () => setupEditorialReview());
</script>
