---
/**
 * HomeShortwaveLive — the town status feed, live, top right of the front door.
 *
 * First paint loads the latest posts from /api/shortwave. After that it is
 * push, not poll: the bar re-emits every post the presence bus announces as
 * `pc:shortwave:post`, so a line said on any page lands here in about a
 * second. A slow poll stays as the fallback. The say box hands the text to
 * the dock bar, so it takes the same path as everything else (room bubble,
 * ticker, Shortwave). Lines are rendered with textContent only.
 */
---
<section class="hsw" data-home-shortwave aria-labelledby="hsw-title">
  <header class="hsw__head">
    <h2 id="hsw-title"><span class="hsw__dot" aria-hidden="true"></span>Shortwave <small>live</small></h2>
    <span class="hsw__here" data-hsw-here aria-live="polite"></span>
    <a href="/shortwave">All of it <span aria-hidden="true">↗</span></a>
  </header>
  <ol class="hsw__list" data-hsw-list aria-live="polite">
    <li class="hsw__empty">Tuning in…</li>
  </ol>
  <form class="hsw__say" data-hsw-form autocomplete="off">
    <input data-hsw-input type="text" maxlength="280" placeholder="Say something to the town…" aria-label="Say something on Shortwave" enterkeyhint="send" />
    <button type="submit">Say</button>
  </form>
  <p class="hsw__note" data-hsw-note role="status">Seen on every open page within a second, then kept on Shortwave.</p>
</section>

<script>
  const ES = { lat: 33.9192, lon: -118.4165 };
  const miles = (lat: number, lon: number) => { const r = Math.PI / 180, a = Math.sin(((lat - ES.lat) * r) / 2) ** 2 + Math.cos(ES.lat * r) * Math.cos(lat * r) * Math.sin(((lon - ES.lon) * r) / 2) ** 2; return 3958.8 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); };
  const ago = (iso: string) => { const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000); if (s < 45) return 'now'; if (s < 3600) return `${Math.max(1, Math.floor(s / 60))}m`; if (s < 86400) return `${Math.floor(s / 3600)}h`; return `${Math.floor(s / 86400)}d`; };
  const tidy = (text: string) => text
    .replace(/📍\s*(-?\d{1,2}\.\d+),\s*(-?\d{1,3}\.\d+)/g, (_m, la, lo) => { const mi = miles(Number(la), Number(lo)); return mi < 1 ? '📍 El Segundo' : `📍 ${Math.round(mi)} mi out`; })
    .replace(/https?:\/\/open\.spotify\.com\/\S+/g, 'spotify ↗')
    .replace(/https?:\/\/(\S{1,28})\S*/g, '$1…');
  type Post = { id: string; at: string; who: string; noun: number; text: string };

  function mount() {
    const root = document.querySelector<HTMLElement>('[data-home-shortwave]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = 'true';
    const list = root.querySelector<HTMLElement>('[data-hsw-list]')!, here = root.querySelector<HTMLElement>('[data-hsw-here]')!;
    const form = root.querySelector<HTMLFormElement>('[data-hsw-form]')!, input = root.querySelector<HTMLInputElement>('[data-hsw-input]')!, note = root.querySelector<HTMLElement>('[data-hsw-note]')!;
    const KEEP = 3;
    let posts: Post[] = [];

    function row(p: Post, fresh: boolean): HTMLElement {
      const li = document.createElement('li'); li.className = 'hsw__post'; if (fresh) li.dataset.fresh = 'true';
      const img = document.createElement('img'); img.src = `https://noun.pics/${Number(p.noun) || 0}.svg`; img.alt = ''; img.width = 26; img.height = 26; img.loading = 'lazy';
      const body = document.createElement('div');
      const meta = document.createElement('p'); meta.className = 'hsw__meta';
      const who = document.createElement('b'); who.textContent = p.who || 'visitor';
      const time = document.createElement('time'); time.dateTime = p.at; time.textContent = ago(p.at);
      meta.append(who, time);
      const text = document.createElement('p'); text.className = 'hsw__text'; text.textContent = tidy(p.text);
      body.append(meta, text); li.append(img, body);
      return li;
    }
    function render(freshId?: string) {
      if (!posts.length) { const li = document.createElement('li'); li.className = 'hsw__empty'; li.textContent = 'Quiet on the air. Say the first thing.'; list.replaceChildren(li); return; }
      list.replaceChildren(...posts.slice(0, KEEP).map((p) => row(p, p.id === freshId)));
    }
    function add(p: Post, fresh: boolean) {
      if (!p?.id || posts.some((x) => x.id === p.id)) return;
      posts = [p, ...posts].sort((a, b) => b.at.localeCompare(a.at)).slice(0, 12);
      render(fresh ? p.id : undefined);
    }
    async function load() {
      try {
        const res = await fetch('/api/shortwave?limit=8', { headers: { accept: 'application/json' } });
        const data = await res.json();
        if (!data?.ok || !Array.isArray(data.posts)) throw new Error('unavailable');
        const known = new Set(posts.map((p) => p.id));
        const incoming: Post[] = data.posts.filter((p: Post) => p?.id && !known.has(p.id));
        posts = [...incoming, ...posts].sort((a, b) => b.at.localeCompare(a.at)).slice(0, 12);
        render();
      } catch { if (!posts.length) { const li = document.createElement('li'); li.className = 'hsw__empty'; li.textContent = 'Shortwave is out of range right now.'; list.replaceChildren(li); } }
    }
    async function presence() {
      try {
        const j = await (await fetch('/api/presence/snapshot', { cache: 'no-store' })).json();
        const h = Number(j.humans ?? 0), a = Number(j.agents ?? 0);
        here.textContent = h + a > 0 ? `${h + a} here now${a ? ` · ${a} AI` : ''}` : '';
      } catch { here.textContent = ''; }
    }

    window.addEventListener('pc:shortwave:post', (ev: Event) => {
      const d = (ev as CustomEvent).detail || {};
      if (d.post) add(d.post as Post, true);
      if (d.own) note.textContent = d.live === false ? 'Said. It is on Shortwave.' : 'Said. Live across town, and kept on Shortwave.';
    });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const text = input.value.replace(/\s+/g, ' ').trim();
      if (!text) { input.focus(); return; }
      input.value = '';
      // The dock bar owns the say path (room bubble, ticker, Shortwave). Without it, post directly.
      if (document.querySelector('[data-pc-ref="fb-omni-form"]')) {
        window.dispatchEvent(new CustomEvent('pc:shortwave:say', { detail: { text } }));
        note.textContent = 'Sending…';
        return;
      }
      const safe = text;
      try {
        const res = await fetch('/api/shortwave', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: safe || text, via: 'page' }) });
        const data = await res.json();
        if (data?.ok && data.post) { add(data.post, true); note.textContent = 'Said. It is on Shortwave.'; }
        else note.textContent = data?.error || 'Could not send that. Try the bar at the bottom.';
      } catch { note.textContent = 'Could not send that. Try the bar at the bottom.'; }
    });

    void load(); void presence();
    const timers = [
      setInterval(() => { if (document.visibilityState === 'visible') void load(); }, 60000),
      setInterval(() => { if (document.visibilityState === 'visible') void presence(); }, 30000),
      setInterval(() => list.querySelectorAll<HTMLTimeElement>('time').forEach((t) => { t.textContent = ago(t.dateTime); }), 30000),
    ];
    document.addEventListener('astro:before-swap', () => timers.forEach(clearInterval), { once: true });
  }
  mount();
  document.addEventListener('astro:page-load', mount);
</script>

<style is:global>
  .hsw { background: #fffdf7; border: 1px solid #c4bcae; box-shadow: 5px 7px 0 #e9dfcf; padding: 14px 16px 12px; color: #2d302a; min-width: 0; }
  .hsw__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; }
  .hsw__head h2 { margin: 0; display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 620; letter-spacing: -.025em; }
  .hsw__head h2 small { font: 600 8px var(--pc-font-mono); letter-spacing: .14em; text-transform: uppercase; color: #4e5944; border: 1px solid #a9b394; padding: 2px 5px; }
  .hsw__dot { width: 7px; height: 7px; border-radius: 50%; background: #5f8a3f; box-shadow: 0 0 0 0 #5f8a3f66; animation: hsw-pulse 2.4s ease-out infinite; }
  @keyframes hsw-pulse { 0% { box-shadow: 0 0 0 0 #5f8a3f66; } 70%, 100% { box-shadow: 0 0 0 7px #5f8a3f00; } }
  .hsw__here { font: 500 9px var(--pc-font-mono); letter-spacing: .06em; text-transform: uppercase; color: #6d6659; }
  .hsw__head a { margin-left: auto; font-size: 11px; font-weight: 600; color: #76523a; white-space: nowrap; }
  .hsw__head a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hsw__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; min-height: 132px; }
  .hsw__post { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; padding: 7px 0; border-top: 1px solid #e6dccb; }
  .hsw__post img { width: 26px; height: 26px; border: 1px solid #d6cbbb; background: #efe7d8; image-rendering: pixelated; }
  .hsw__post[data-fresh='true'] { animation: hsw-in 1.6s ease-out; }
  @keyframes hsw-in { 0% { background: #f3e6b8; transform: translateY(-4px); opacity: 0; } 18% { opacity: 1; transform: none; } 100% { background: transparent; } }
  .hsw__meta { margin: 0; display: flex; gap: 8px; align-items: baseline; font: 500 9px var(--pc-font-mono); letter-spacing: .04em; color: #8a7d69; }
  .hsw__meta b { font-weight: 650; color: #4e5944; max-width: 20ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hsw__text { margin: 2px 0 0; font-size: 13px; line-height: 1.4; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .hsw__empty { padding: 14px 0; border-top: 1px solid #e6dccb; font-size: 12px; color: #766c5c; }
  .hsw__say { display: flex; gap: 8px; margin-top: 8px; padding-top: 10px; border-top: 1px solid #cfc5b5; }
  .hsw__say input { flex: 1; min-width: 0; font: inherit; font-size: 13px; padding: 9px 10px; border: 1px solid #bbb29f; background: #fff; color: inherit; border-radius: 0; }
  .hsw__say input:focus-visible { outline: 2px solid #a85b3d; outline-offset: 1px; }
  .hsw__say button { font: inherit; font-size: 11px; font-weight: 650; padding: 0 16px; border: 1px solid #343d30; background: #343d30; color: #fffdf6; cursor: pointer; border-radius: 0; }
  .hsw__say button:hover { box-shadow: 0 3px 0 #d9c8ae; }
  .hsw__note { margin: 8px 0 0; font-size: 10px; line-height: 1.5; color: #766c5c; }
  @media (prefers-reduced-motion: reduce) { .hsw__dot, .hsw__post[data-fresh='true'] { animation: none; } }
  @media (max-width: 680px) { .hsw { box-shadow: 4px 5px 0 #e9dfcf; } .hsw__say input { font-size: 16px; } }
</style>
