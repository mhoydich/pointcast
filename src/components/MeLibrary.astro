---
import '../styles/me-library.css';
---
<section class="ml" data-me-library aria-label="Your PointCast library">
  <header class="ml-head">
    <div><p class="ml-eyebrow">POINTCAST · YOUR CORNER</p><h1>Keep something good.</h1><p>A song, a page, a small discovery. Make a place for it.</p></div>
    <span class="ml-stamp" aria-hidden="true">ME<br/><span>↗</span></span>
  </header>
  <div class="ml-session"><p data-ml-mode role="status">Opening your shelf…</p><a data-ml-signin href="/auth?returnTo=%2Fme">Sign in to carry it with you →</a><button type="button" data-ml-retry hidden>Try again</button></div>
  <nav class="ml-nav" aria-label="Your space">
    <a href="#saved" data-ml-tab="saved" aria-current="page">Saved <span data-ml-count>0</span></a>
    <a href="#collections" data-ml-tab="collections">Collections</a>
    <a href="#profile" data-ml-tab="profile">Profile</a>
    <a href="#account">Account ↗</a>
  </nav>
  <p class="ml-notice" data-ml-notice role="status" aria-live="polite"></p>
  <section id="saved" data-ml-panel="saved" aria-label="Saved things">
    <form class="ml-save" data-ml-save>
      <label class="ml-url"><span class="ml-sr">Link to keep</span><input name="url" type="text" inputmode="url" required maxlength="600" placeholder="Paste a link or PointCast path…" autocomplete="url" /></label>
      <button type="submit" class="ml-primary">Keep link <span aria-hidden="true">＋</span></button>
      <details><summary>Add a title or private note</summary><div class="ml-fields"><label>Title<input name="title" maxlength="160" placeholder="What would you call it?" /></label><label>Private note<textarea name="note" rows="2" maxlength="140" placeholder="A thought for later. Only you can see this."></textarea></label></div></details>
    </form>
    <div class="ml-toolbar"><label class="ml-search"><span class="ml-sr">Search saved titles, domains and notes</span><input type="search" data-ml-search placeholder="Find something you kept" /></label><label><span class="ml-sr">Filter saved things</span><select data-ml-filter><option value="all">Everything</option><option value="link">Links</option><option value="post">Posts</option></select></label><button type="button" data-ml-export>Export</button></div>
    <div class="ml-grid" data-ml-keeps aria-live="polite"></div>
    <div class="ml-pagination"><p class="ml-muted" data-ml-showing role="status"></p><button type="button" data-ml-load-more hidden>Load more</button></div>
    <details class="ml-import"><summary>Bring things from this browser</summary><p>Review saves from Keeps, ShoppingPocket, Sparrow, and your dock. Choose what to copy. Original source lists stay in place.</p><div data-ml-import-sources></div></details>
  </section>
  <section id="collections" data-ml-panel="collections" aria-label="Your collections" hidden>
    <div class="ml-section-head"><div><h2>A few things, together.</h2><p>Arrange a private collection. Share only when you are ready.</p></div><button type="button" data-ml-new-collection class="ml-primary">New collection ＋</button></div>
    <div data-ml-collections class="ml-grid"></div>
    <form class="ml-editor" data-ml-collection-editor hidden>
      <div class="ml-section-head"><h3 data-ml-collection-heading>New collection</h3><button type="button" data-ml-close-collection>Close editor</button></div>
      <div class="ml-fields"><label>Collection title<input name="title" required maxlength="80" /></label><label>Introduction<textarea name="description" maxlength="500" rows="3"></textarea></label></div>
      <fieldset><legend>Choose and arrange your saved things</legend><p class="ml-muted">Selected cards appear in this order. Public captions are separate from your private notes.</p><div data-ml-members></div></fieldset>
      <div class="ml-actions"><button type="submit" class="ml-primary">Save private draft</button><button type="button" data-ml-preview-collection>Save &amp; preview</button><button type="button" data-ml-delete-collection class="ml-danger" hidden>Delete collection</button></div>
      <p data-ml-collection-status role="status"></p>
    </form>
  </section>
  <section id="profile" data-ml-panel="profile" aria-label="Your public profile draft" hidden>
    <div class="ml-section-head"><div><h2>A little introduction.</h2><p>Your profile starts private. A wallet is optional.</p></div><span data-ml-profile-state class="ml-badge">Private draft</span></div>
    <p data-ml-profile-gate></p>
    <form class="ml-editor" data-ml-profile-form hidden>
      <div class="ml-fields"><label>Display name<input name="name" required maxlength="64" autocomplete="nickname" /></label><label>Noun number<input name="noun" type="number" min="0" max="1199" step="1" /></label><label class="ml-wide">Bio<textarea name="bio" rows="3" maxlength="280" placeholder="A few words about you."></textarea></label></div>
      <fieldset><legend>Links</legend><div data-ml-profile-links></div><button type="button" data-ml-add-profile-link>Add a link</button></fieldset>
      <fieldset><legend>Featured public collections · up to six</legend><div data-ml-featured></div></fieldset>
      <div class="ml-actions"><button type="submit" class="ml-primary">Save private draft</button><button type="button" data-ml-preview-profile>Save &amp; preview</button><button type="button" data-ml-unpublish-profile hidden>Unpublish profile</button><a data-ml-profile-url hidden>View public page ↗</a></div>
      <p data-ml-profile-status role="status"></p>
    </form>
    <p class="ml-muted">Have a wallet-owned handle? Its existing page and editor are in <a href="#owned-handle">Owned handle →</a></p>
  </section>
  <dialog class="ml-dialog" data-ml-dialog aria-labelledby="ml-dialog-title"><div class="ml-dialog-top"><p class="ml-eyebrow" data-ml-dialog-eyebrow>VISITOR PREVIEW</p><button type="button" data-ml-dialog-close aria-label="Close preview">×</button></div><h2 id="ml-dialog-title"></h2><div data-ml-dialog-content></div><p data-ml-dialog-status role="status"></p><div class="ml-actions" data-ml-dialog-actions></div></dialog>
  <noscript><p>Enable JavaScript to open your saved things. <a href="/auth?returnTo=%2Fme">Sign in</a> to your PointCast account.</p></noscript>
</section>
<script>import '../scripts/me-library';</script>
