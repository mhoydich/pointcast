---
/**
 * FooterBarV6 — "The Walking Bar."
 *
 * Mike 2026-05-08: "let's try [The Walking Bar approach] yah, what's
 * different than before, companions are super interesting, explore
 * that angle and consider how they would interact with other visitors,
 * pets, etc."
 *
 * v6.0 (this file) ships the FOUNDATION:
 *   - horizontal pixel-art town strip at the bottom of the page
 *   - sky band + ground line + 5 building silhouettes
 *   - your noun walks left-to-right in a slow loop
 *   - hover a building → nameplate floats up; click → navigate
 *   - time-of-day sky (morning/midday/evening/night gradient)
 *   - small chevron at far right links to /me
 *
 * v6.1 (THIS PR) adds COMPANIONS:
 *   - 13 companion-kind spell ids (+cat/+pup/+penguin/+fish/+moth/+bee/
 *     +duck/+crab/+snail/+frog/+bird/+rabbit/+pet) reroute to spawn
 *     emoji sprites IN the bar that walk alongside your noun
 *   - each runs the same fbv6-walk loop with a staggered animation-
 *     delay so they trail the walker
 *   - cap of 3 simultaneous; oldest is evicted when full
 *   - auto-fade-out via .is-leaving class then DOM removal at durationMs
 *
 * v6.2 will add PET PERSISTENCE + CROSS-VISITOR:
 *   - "keep" right-click promotes a companion to a persistent PET in
 *     pc:pet:v1 with a name + bornAt + mood
 *   - other visitors' nouns + pets visible via CursorRoom WS
 *
 * v6.2 will add CROSS-VISITOR:
 *   - other visitors' nouns appear ghost-translucent when CursorRoom
 *     WS is connected
 *   - their pets visible too
 *   - pass-by emotes (👋, 🐾) when nouns get within ~40px
 *   - shared spell layer (your +confetti shows in their bar)
 *
 * For v6.0 this is purely visual + navigational. No state, no spells,
 * no presence — just the place. The intent is to swap this in for
 * FooterBar in BlockLayout once Mike approves the look. For now it
 * lives at /bar-v6 as a side-by-side preview.
 */
import { CHANNELS } from '../lib/channels';

// Hand-placed buildings along the bar. `x` is percent-from-left.
// Each is a kit slot — clicking navigates, hover shows the nameplate.
// Heights varied so the silhouette has rhythm. `chimney` adds an
// animated smoke puff (only on STUDIO and KETTLE — they're the
// "working" buildings).
const BUILDINGS = [
  { id: 'kettle',   label: 'KETTLE',   sub: '/coffee',  x: 14, w: 44, h: 50, color: '#c4952e', chimney: true  },
  { id: 'studio',   label: 'STUDIO',   sub: '/studio',  x: 31, w: 56, h: 64, color: '#1b3a5b', chimney: true  },
  { id: 'drum',     label: 'DRUM',     sub: '/drum',    x: 50, w: 50, h: 58, color: '#8a2432', chimney: false },
  { id: 'window',   label: 'WINDOW',   sub: '/window',  x: 68, w: 48, h: 54, color: '#0f6e56', chimney: false },
  { id: 'desk',     label: 'YOUR DESK', sub: '/me',     x: 85, w: 52, h: 60, color: '#534ab7', chimney: false },
];

// v11: Codex-crafted detailed pixel-art SVGs for each building. Multiple
// layered paths per building give them volume + character + LIT windows
// that glow at night (via the .lit-window class + --nightness in CSS).
// Replaces the previous CSS-rectangle treatment that Mike called "basic".
const BUILDING_SVGS: Record<string, string> = {
  kettle: `<svg viewBox="0 0 44 50" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path fill="#5a351b" d="M4 49 V14 H40 V49 Z"/><path fill="#c4952e" d="M7 46 V12 H37 V46 Z"/><path fill="#8b5c22" d="M32 14 H37 V46 H32 Z"/><path fill="#3a2416" d="M5 12 V9 H34 V12 Z M31 9 V3 H36 V9 Z"/><path fill="#ead9b0" d="M36 3 V1 H39 V3 H41 V6 H38 V8 H35 V6 H33 V4 H35 V3 Z"/><path fill="#f0c15a" d="M10 25 V20 H34 V25 Z"/><path fill="#9f6a21" d="M10 25 V20 H14 V25 Z M20 25 V20 H24 V25 Z M30 25 V20 H34 V25 Z"/><path fill="#201712" d="M17 46 V28 H27 V46 Z"/><path fill="#f7df91" class="lit-window" d="M20 36 H23 V39 H20 Z"/><path fill="#3d2618" d="M9 38 V28 H15 V38 Z M29 38 V28 H35 V38 Z"/><path fill="#fff2b8" class="lit-window" d="M10 37 V29 H14 V37 Z M30 37 V29 H34 V37 Z"/><path fill="#2b1b12" d="M20 19 V16 H24 V19 Z M16 17 V14 H28 V17 Z"/><path fill="#fff0c2" d="M18 16 V11 H25 V16 Z M25 12 H28 V15 H25 Z M20 17 H24 V18 H20 Z"/><path fill="#7d4f1f" d="M9 16 H14 V18 H9 Z M18 16 H23 V18 H18 Z M27 16 H31 V18 H27 Z M11 40 H16 V42 H11 Z M28 41 H32 V43 H28 Z M8 21 H12 V23 H8 Z M25 21 H29 V23 H25 Z"/></svg>`,
  studio: `<svg viewBox="0 0 56 64" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path fill="#0b1726" d="M5 63 V13 H51 V63 Z"/><path fill="#1b3a5b" d="M8 60 V10 H47 V60 Z"/><path fill="#10253e" d="M40 13 H47 V60 H40 Z"/><path fill="#07101b" d="M9 10 V7 H17 V5 H25 V3 H34 V5 H42 V7 H48 V10 Z"/><path fill="#8fbfe8" d="M18 8 V7 H25 V6 H34 V7 H40 V8 H34 V9 H25 V10 H18 Z"/><path fill="#08131f" d="M12 18 V49 H24 V18 Z"/><path fill="#b9e4ff" class="lit-window" d="M15 21 H21 V29 H15 Z M15 33 H21 V42 H15 Z"/><path fill="#10253e" d="M17 42 V34 H20 V42 Z M16 45 V42 H21 V45 H20 V48 H18 V45 Z"/><path fill="#07101b" d="M28 60 V43 H38 V60 Z"/><path fill="#4f86b7" d="M26 43 V38 H41 V43 Z"/><path fill="#b9e4ff" class="lit-window" d="M31 48 H35 V52 H31 Z"/><path fill="#f2c04d" d="M30 22 V19 H45 V22 Z"/><path fill="#f7e7bf" d="M45 22 V19 H49 V20 H51 V21 H49 V22 Z"/><path fill="#151018" d="M29 22 V19 H31 V22 Z"/><path fill="#d7f1ff" class="lit-window" d="M30 29 H35 V34 H30 Z M39 29 H44 V34 H39 Z M30 36 H35 V41 H30 Z M39 36 H44 V41 H39 Z"/><path fill="#2d557c" d="M10 15 H16 V17 H10 Z M31 15 H37 V17 H31 Z M13 53 H22 V55 H13 Z M41 48 H45 V50 H41 Z"/></svg>`,
  drum: `<svg viewBox="0 0 50 58" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path fill="#210b10" d="M4 57 V13 H46 V57 Z"/><path fill="#8a2432" d="M7 54 V10 H43 V54 Z"/><path fill="#5d1723" d="M36 12 H43 V54 H36 Z"/><path fill="#f0b45b" d="M9 18 V8 H41 V18 Z"/><path fill="#2a1117" d="M12 16 V10 H38 V16 Z"/><path fill="#fff0b8" class="lit-window" d="M22 15 V11 H26 V12 H28 V14 H26 V15 Z"/><path fill="#ff6b7f" d="M7 22 V20 H43 V22 Z M7 54 V52 H43 V54 Z M7 20 H9 V54 H7 Z M41 20 H43 V54 H41 Z"/><path fill="#3a0e17" d="M15 34 V29 H35 V34 Z"/><path fill="#c83a4b" d="M15 33 V30 H19 V33 Z M23 33 V30 H27 V33 Z M31 33 V30 H35 V33 Z"/><path fill="#12080b" d="M18 54 V35 H32 V54 Z"/><path fill="#5d1723" d="M21 39 H29 V42 H21 Z M21 45 H29 V48 H21 Z"/><path fill="#ffe29a" class="lit-window" d="M29 43 H31 V45 H29 Z"/><path fill="#220b10" d="M10 37 V27 H15 V37 Z M35 37 V27 H40 V37 Z"/><path fill="#ffcf83" class="lit-window" d="M11 35 V28 H14 V35 Z M36 35 V28 H39 V35 Z"/><path fill="#4b121c" d="M10 23 H16 V25 H10 Z M22 23 H28 V25 H22 Z M34 23 H39 V25 H34 Z M12 41 H17 V43 H12 Z M34 42 H39 V44 H34 Z M9 48 H15 V50 H9 Z M35 49 H41 V51 H35 Z"/></svg>`,
  window: `<svg viewBox="0 0 48 54" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path fill="#073326" d="M4 53 V13 H44 V53 Z"/><path fill="#0f6e56" d="M7 50 V10 H41 V50 Z"/><path fill="#0a4d3d" d="M36 12 H41 V50 H36 Z"/><path fill="#05271e" d="M8 10 V7 H40 V10 Z M11 7 V4 H13 V7 Z M20 7 V4 H22 V7 Z M29 7 V4 H31 V7 Z M38 7 V4 H40 V7 Z"/><path fill="#082820" d="M11 18 V38 H37 V18 Z"/><path fill="#a7f0df" class="lit-window" d="M13 20 H23 V36 H13 Z M25 20 H35 V36 H25 Z"/><path fill="#0f6e56" d="M23 19 H25 V37 H23 Z M12 28 H36 V30 H12 Z"/><path fill="#e8fff8" class="lit-window" d="M15 22 H19 V24 H15 Z M27 22 H32 V24 H27 Z"/><path fill="#073326" d="M27 34 V29 H31 V34 Z M26 29 V26 H32 V29 Z M28 26 V23 H31 V26 Z"/><path fill="#62c4a8" d="M9 42 V38 H39 V42 Z"/><path fill="#0a4d3d" d="M9 42 V40 H15 V42 Z M21 42 V40 H27 V42 Z M33 42 V40 H39 V42 Z"/><path fill="#041b15" d="M19 50 V42 H29 V50 Z"/><path fill="#d8fff4" class="lit-window" d="M23 45 H25 V47 H23 Z"/><path fill="#f7ffd2" class="lit-window" d="M10 13 H14 V15 H10 Z M21 13 H25 V15 H21 Z M32 13 H36 V15 H32 Z"/></svg>`,
  desk: `<svg viewBox="0 0 52 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path fill="#211c4d" d="M5 59 V23 H47 V59 Z"/><path fill="#151237" d="M3 24 V21 H8 V18 H13 V15 H18 V12 H23 V9 H29 V12 H34 V15 H39 V18 H44 V21 H49 V24 Z"/><path fill="#534ab7" d="M9 56 V24 H43 V56 Z"/><path fill="#3d3492" d="M36 26 H43 V56 H36 Z"/><path fill="#17143a" d="M13 35 V27 H23 V35 Z M29 35 V27 H39 V35 Z"/><path fill="#fff0b6" class="lit-window" d="M15 33 V29 H21 V33 Z M31 33 V29 H37 V33 Z"/><path fill="#7b72dc" d="M15 29 H17 V35 H15 Z M21 29 H23 V35 H21 Z M31 29 H33 V35 H31 Z M37 29 H39 V35 H37 Z"/><path fill="#8d83ee" d="M16 43 V39 H36 V43 Z"/><path fill="#332b80" d="M16 43 V41 H21 V43 Z M26 43 V41 H31 V43 Z"/><path fill="#120f2b" d="M21 56 V43 H31 V56 Z"/><path fill="#fff4c4" class="lit-window" d="M25 47 H27 V49 H25 Z"/><path fill="#f8e8ff" d="M26 53 V51 H27 V53 H29 V54 H27 V56 H26 V54 H24 V53 Z"/><path fill="#d9d5ff" d="M34 49 V46 H41 V49 Z"/><path fill="#211c4d" d="M36 46 V44 H39 V46 Z"/><path fill="#2b255f" d="M18 58 V56 H34 V58 Z"/><path fill="#746bd6" d="M10 26 H19 V28 H10 Z M33 26 H42 V28 H33 Z M10 38 H16 V40 H10 Z M36 38 H42 V40 H36 Z"/></svg>`,
};
---

<aside class="fbv6" id="fbv6" aria-label="PointCast walking bar (v6 preview)">

  {/* Sky band — gradient + clouds + sun + stars.
      Time-of-day phase computed continuously by JS (not bucketed) so
      sunset blends from gold → coral → magenta → indigo over real
      minutes. CSS reads --sky-top/mid/bot vars set by the JS. */}
  <div class="fbv6__sky" id="fbv6-sky">
    {/* v9: PARALLAX CLOUDS — three altitudes at three different drift
        speeds. High (small/fast/far), mid (standard), low (large/slow/
        near). With the static skyline this gives genuine depth. All
        respect --wind-mult so windy days drift proportionally faster. */}
    <span class="fbv6__cloud fbv6__cloud--high1" aria-hidden="true"></span>
    <span class="fbv6__cloud fbv6__cloud--high2" aria-hidden="true"></span>
    <span class="fbv6__cloud fbv6__cloud--mid1"  aria-hidden="true"></span>
    <span class="fbv6__cloud fbv6__cloud--mid2"  aria-hidden="true"></span>
    <span class="fbv6__cloud fbv6__cloud--low1"  aria-hidden="true"></span>
    <span class="fbv6__star fbv6__star--1" aria-hidden="true"></span>
    <span class="fbv6__star fbv6__star--2" aria-hidden="true"></span>
    <span class="fbv6__star fbv6__star--3" aria-hidden="true"></span>
    <span class="fbv6__star fbv6__star--4" aria-hidden="true"></span>
    <span class="fbv6__star fbv6__star--5" aria-hidden="true"></span>
    <span class="fbv6__sun" aria-hidden="true" id="fbv6-sun"></span>
    {/* Birds — JS-spawned occasional flyover. Container only. */}
    <div class="fbv6__birds" id="fbv6-birds" aria-hidden="true"></div>
  </div>

  {/* v10: EL SEGUNDO SKYLINE — hand-crafted (via Codex) pixel-art
      silhouette of the actual El Segundo. From left:
        x0-200   Chevron refinery (smokestacks + tanks)
        x200-360 low-rise residential + palms
        x360-520 aerospace/tech offices (Aerospace Corp belt)
        x520-640 more homes + palms
        x640-800 beach descent to Pacific horizon
      All-integer coords, pixel-art aesthetic, single path with
      currentColor fill — gets tinted via CSS for time-of-day. */}
  <div class="fbv6__skyline" aria-hidden="true">
    <svg viewBox="0 0 800 30" preserveAspectRatio="none" width="100%" height="30" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M0 30 V20 H8 V18 H16 V14 H19 V8 H22 V5 H28 V8 H31 V14 H35 V18 H44 V20 H53 V17 H58 V15 H64 V13 H73 V15 H80 V17 H86 V20 H95 V18 H101 V10 H104 V6 H111 V10 H115 V18 H123 V16 H130 V14 H137 V16 H145 V20 H153 V18 H160 V13 H164 V9 H167 V4 H175 V9 H179 V13 H183 V18 H191 V20 H199 V18 H207 V16 H214 V15 H223 V16 H231 V19 H238 V20 H245 V18 H250 V16 H257 V15 H264 V17 H271 V20 H279 V18 H284 V16 H289 V14 H296 V16 H301 V18 H309 V20 H316 V17 H321 V13 H324 V10 H327 V13 H331 V15 H335 V13 H339 V16 H345 V18 H351 V15 H359 V13 H368 V15 H375 V19 H383 V20 H391 V17 H397 V14 H405 V12 H414 V14 H421 V20 H429 V13 H437 V9 H449 V13 H457 V20 H465 V10 H477 V7 H491 V20 H499 V12 H510 V8 H524 V20 H532 V14 H541 V11 H553 V14 H562 V20 H570 V18 H576 V15 H583 V14 H591 V16 H598 V20 H606 V17 H611 V13 H614 V10 H617 V13 H621 V15 H625 V13 H629 V16 H637 V18 H646 V19 H656 V20 H666 V21 H676 V22 H688 V21 H695 V17 H699 V13 H702 V11 H706 V13 H710 V16 H714 V20 H724 V21 H738 V22 H754 V23 H800 V30 Z"/>
    </svg>
  </div>

  {/* v8: WEATHER OVERLAY — fetched from /api/weather on mount. Adds
      rain particles / fog wash / extra clouds based on real El Segundo
      conditions. Container; JS populates by data-condition. */}
  <div class="fbv6__weather" id="fbv6-weather" aria-hidden="true"></div>

  {/* v9: LIGHTNING — flashes in random pulses when weather is thunder.
      Single empty element; CSS animation. JS adds .is-active when
      weather.treatment === 'thunder'. */}
  <div class="fbv6__lightning" id="fbv6-lightning" aria-hidden="true"></div>

  {/* Buildings — positioned absolutely, sit on top of the ground line. */}
  <ul class="fbv6__buildings">
    {BUILDINGS.map((b) => (
      <li
        class="fbv6__building"
        style={`--bx: ${b.x}%; --bw: ${b.w}px; --bh: ${b.h}px; --bc: ${b.color};`}
        data-id={b.id}
      >
        <a class="fbv6__building-link" href={b.sub}>
          {/* v11: Codex-crafted detailed pixel-art SVG. The SVG itself
              has the shape/face/windows/sign/awning/door — see
              BUILDING_SVGS in the frontmatter. CSS handles the .lit-window
              glow at night via --nightness. The chimney + smoke for
              KETTLE/STUDIO stay as a separate animated layer on top. */}
          <span class="fbv6__building-shape" aria-hidden="true" set:html={BUILDING_SVGS[b.id] || ''}></span>
          {b.chimney && (
            <span class="fbv6__chimney" aria-hidden="true">
              <span class="fbv6__smoke fbv6__smoke--1"></span>
              <span class="fbv6__smoke fbv6__smoke--2"></span>
              <span class="fbv6__smoke fbv6__smoke--3"></span>
            </span>
          )}
          <span class="fbv6__building-plate mono" aria-hidden="false">
            <strong>{b.label}</strong>
            <span class="fbv6__building-sub">{b.sub}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  {/* Ground line + walking path. */}
  <div class="fbv6__ground" aria-hidden="true"></div>

  {/* v10: PALM TREES — Codex-crafted pixel silhouettes scattered between
      buildings as ground-level SoCal flavor. Three variants (tall /
      lean / small). currentColor so they tint at night. */}
  <div class="fbv6__palms" aria-hidden="true">
    <span class="fbv6__palm fbv6__palm--tall" style="left: 5%">
      <svg viewBox="0 0 18 20" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M8 20 V8 H10 V20 Z M7 8 V6 H11 V8 H12 V10 H10 V11 H8 V10 H6 V8 Z M8 7 H5 V6 H3 V5 H1 V4 H5 V5 H8 Z M10 7 H13 V6 H15 V5 H17 V4 H13 V5 H10 Z M8 6 H7 V4 H6 V2 H5 V1 H8 Z M10 6 H11 V4 H12 V2 H13 V1 H10 Z M7 9 H4 V10 H2 V12 H5 V11 H8 V10 H7 Z M11 9 H14 V10 H16 V12 H13 V11 H10 V10 H11 Z"/></svg>
    </span>
    <span class="fbv6__palm fbv6__palm--lean" style="left: 23%">
      <svg viewBox="0 0 18 19" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M6 19 V12 H8 V19 Z M7 12 V8 H9 V12 Z M8 8 V6 H10 V8 Z M8 6 V4 H12 V6 H13 V8 H11 V9 H9 V8 H7 V6 Z M9 5 H6 V4 H4 V3 H2 V2 H6 V3 H9 Z M11 5 H14 V4 H16 V3 H18 V2 H14 V3 H11 Z M10 4 H9 V2 H8 V0 H11 Z M12 5 H13 V3 H14 V1 H15 V4 H14 V6 H12 Z M8 7 H5 V8 H3 V10 H6 V9 H9 V8 H8 Z M12 7 H15 V8 H17 V10 H14 V9 H11 V8 H12 Z"/></svg>
    </span>
    <span class="fbv6__palm fbv6__palm--small" style="left: 41%">
      <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M6 14 V7 H8 V14 Z M5 7 V5 H9 V7 H10 V8 H8 V9 H6 V8 H4 V7 Z M6 5 H4 V4 H2 V3 H0 V2 H4 V3 H6 Z M8 5 H10 V4 H12 V3 H14 V2 H10 V3 H8 Z M6 5 H5 V3 H4 V1 H7 Z M8 5 H9 V3 H10 V1 H11 V4 H10 V6 H8 Z M5 8 H3 V9 H1 V11 H4 V10 H6 V9 H5 Z M9 8 H11 V9 H13 V11 H10 V10 H8 V9 H9 Z"/></svg>
    </span>
    <span class="fbv6__palm fbv6__palm--lean" style="left: 59%">
      <svg viewBox="0 0 18 19" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M6 19 V12 H8 V19 Z M7 12 V8 H9 V12 Z M8 8 V6 H10 V8 Z M8 6 V4 H12 V6 H13 V8 H11 V9 H9 V8 H7 V6 Z M9 5 H6 V4 H4 V3 H2 V2 H6 V3 H9 Z M11 5 H14 V4 H16 V3 H18 V2 H14 V3 H11 Z M10 4 H9 V2 H8 V0 H11 Z M12 5 H13 V3 H14 V1 H15 V4 H14 V6 H12 Z M8 7 H5 V8 H3 V10 H6 V9 H9 V8 H8 Z M12 7 H15 V8 H17 V10 H14 V9 H11 V8 H12 Z"/></svg>
    </span>
    <span class="fbv6__palm fbv6__palm--tall" style="left: 78%">
      <svg viewBox="0 0 18 20" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M8 20 V8 H10 V20 Z M7 8 V6 H11 V8 H12 V10 H10 V11 H8 V10 H6 V8 Z M8 7 H5 V6 H3 V5 H1 V4 H5 V5 H8 Z M10 7 H13 V6 H15 V5 H17 V4 H13 V5 H10 Z M8 6 H7 V4 H6 V2 H5 V1 H8 Z M10 6 H11 V4 H12 V2 H13 V1 H10 Z M7 9 H4 V10 H2 V12 H5 V11 H8 V10 H7 Z M11 9 H14 V10 H16 V12 H13 V11 H10 V10 H11 Z"/></svg>
    </span>
  </div>

  {/* v10: OCEAN — Pacific edge at the far right where the El Segundo
      skyline descends. Two wave layers slowly roll left to right at
      different speeds for parallax depth. */}
  <div class="fbv6__ocean" aria-hidden="true">
    <div class="fbv6__ocean-water"></div>
    <svg class="fbv6__wave fbv6__wave--front" viewBox="0 0 200 6" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M0 6 V4 H8 V3 H16 V2 H24 V3 H32 V4 H42 V5 H52 V4 H60 V3 H68 V2 H76 V3 H84 V4 H94 V5 H104 V4 H112 V3 H120 V2 H128 V3 H136 V4 H146 V5 H156 V4 H164 V3 H172 V2 H180 V3 H188 V4 H200 V6 Z"/>
    </svg>
    <svg class="fbv6__wave fbv6__wave--back" viewBox="0 0 200 6" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M0 6 V4 H8 V3 H16 V2 H24 V3 H32 V4 H42 V5 H52 V4 H60 V3 H68 V2 H76 V3 H84 V4 H94 V5 H104 V4 H112 V3 H120 V2 H128 V3 H136 V4 H146 V5 H156 V4 H164 V3 H172 V2 H180 V3 H188 V4 H200 V6 Z"/>
    </svg>
  </div>

  {/* v9: STREET LAMPS — small posts between buildings, glow warm at
      night. Almost invisible during the day. Lamp head opacity +
      shadow swell driven by --nightness. */}
  <div class="fbv6__lamps" aria-hidden="true">
    <span class="fbv6__lamp" style="left: 22.5%"></span>
    <span class="fbv6__lamp" style="left: 40.5%"></span>
    <span class="fbv6__lamp" style="left: 59%"></span>
    <span class="fbv6__lamp" style="left: 76.5%"></span>
  </div>

  {/* Your noun — animated walk loop. Image src set on mount from
      pc:currentNoun localStorage (falls back to random visit-noun). */}
  <div class="fbv6__walker" id="fbv6-walker" data-mood="">
    {/* v8: mood aura — radial glow tinted by pc:mood. JS sets the
        data-mood attribute on mount and on storage events. */}
    <span class="fbv6__walker-aura" aria-hidden="true"></span>
    <img id="fbv6-walker-noun" alt="" width="32" height="32" />
    <span class="fbv6__walker-shadow" aria-hidden="true"></span>
  </div>

  {/* v6.1: COMPANIONS layer. Spawned by `pc:spell:cast` events for
      companion-kind spells (cat / pup / penguin / fish / moth / bee /
      duck / etc.). Each runs the same walk animation as the main
      walker but with an animation-delay offset so they trail behind.
      Capped at 3 simultaneous. Right-click any companion to "keep"
      it as a persistent pet (v6.2). JS-managed. */}
  <div class="fbv6__companions" id="fbv6-companions" aria-hidden="true"></div>

  {/* v6.2: PET layer. A single persistent companion saved to
      pc:pet:v1 — name, kind, bornAt, mood. Walks alongside the main
      walker indefinitely. Right-click to release (with confirm). */}
  <div class="fbv6__pet" id="fbv6-pet" hidden aria-hidden="true">
    <span class="fbv6__pet-inner" id="fbv6-pet-inner"></span>
    <span class="fbv6__pet-plate mono" id="fbv6-pet-plate" aria-hidden="true">
      <strong id="fbv6-pet-name">pet</strong>
      <span class="fbv6__pet-sub" id="fbv6-pet-sub">your pet</span>
    </span>
  </div>

  {/* v6.2: PEERS layer. Other visitors' nouns walking ghost-translucent
      in your bar. Joins a global "/__bar__" room via the existing
      PresenceRoom Durable Object. Each peer walks the same 60s loop
      on a randomized phase (no per-frame position sync needed). */}
  <div class="fbv6__peers" id="fbv6-peers" aria-hidden="true"></div>

  {/* Pet adopt/release toast — appears briefly on adopt or release. */}
  <div class="fbv6__toast mono" id="fbv6-toast" role="status" aria-live="polite" hidden></div>

  {/* Right edge — chevron + ON AIR. Chevron links to /me for now;
      v6.1 will turn it into the omnibox modal trigger. */}
  <div class="fbv6__edge">
    <span class="fbv6__on-air" aria-label="On air">
      <span class="fbv6__on-air-dot" aria-hidden="true"></span>
      <span class="fbv6__on-air-label mono">ON AIR</span>
    </span>
    <a class="fbv6__chevron mono" href="/me" title="Your /me page">
      <span aria-hidden="true">⌘K</span>
      <span aria-hidden="true">›</span>
    </a>
  </div>

</aside>

<script is:inline>
(() => {
  // ─── Time-of-day sky (smooth, continuous) ────────────────────────────
  // Mike 2026-05-09: "still kinda basic, can it get to apple like tho".
  // Step 1: stop bucketing into 4 modes. Compute a 0..24 hour phase
  // continuously and lerp between 8 anchor color stops every minute.
  // Sky reads --sky-top / --sky-mid / --sky-bot CSS vars; sun reads
  // --sun-x / --sun-y / --sun-color. Result: gold dawn → blue noon →
  // coral sunset → magenta dusk → indigo night, all blending smoothly.
  const sky = document.getElementById('fbv6-sky');
  const sun = document.getElementById('fbv6-sun');
  const walkerLayer = null; // (placeholder; keeps the patch focused)

  // Sky anchors: hour → [topColor, midColor, botColor]. 8 stops cover
  // pre-dawn, sunrise, mid-morning, noon, golden, sunset, dusk, deep night.
  const SKY_STOPS = [
    [0,  ['#070418', '#150a26', '#241038']], // 00 — deep night
    [5,  ['#1f1538', '#3a1f3e', '#5b2630']], // 05 — pre-dawn
    [7,  ['#ffb56e', '#ff8a78', '#f3d8b8']], // 07 — sunrise
    [10, ['#a8d8f0', '#c5e6f4', '#f0e6cf']], // 10 — mid-morning
    [13, ['#7ec5ec', '#bde0f1', '#ede4cd']], // 13 — noon (slightly cooler)
    [17, ['#ffb05c', '#ff8e63', '#f4c4a4']], // 17 — golden hour
    [19, ['#ff7c4a', '#e84d6a', '#993556']], // 19 — sunset
    [21, ['#5a2e6b', '#321031', '#170a26']], // 21 — dusk
  ];
  // Sun anchors: hour → [xPercent, yPx, color]. xPercent tracks east→west
  // arc; y goes high at midday, low at edges.
  const SUN_STOPS = [
    [5,  [10, 50, '#ff8a4a']],
    [7,  [22, 36, '#ffb56e']],
    [11, [42, 14, '#ffe48a']],
    [13, [54, 12, '#fff48a']],
    [17, [78, 32, '#ff7a4a']],
    [19, [92, 50, '#e84d6a']],
  ];

  function hexToRgb(h) {
    const m = h.replace('#', '');
    return [parseInt(m.slice(0,2),16), parseInt(m.slice(2,4),16), parseInt(m.slice(4,6),16)];
  }
  function rgbToHex(r,g,b) {
    const c = (n) => Math.round(n).toString(16).padStart(2, '0');
    return '#' + c(r) + c(g) + c(b);
  }
  function lerpColor(a, b, t) {
    const [r1,g1,b1] = hexToRgb(a), [r2,g2,b2] = hexToRgb(b);
    return rgbToHex(r1 + (r2-r1)*t, g1 + (g2-g1)*t, b1 + (b2-b1)*t);
  }
  function lerpStops(stops, hourPhase) {
    // Find bracket; wrap around 24h for last → first.
    for (let i = 0; i < stops.length; i++) {
      const [h0, v0] = stops[i];
      const [h1, v1] = stops[(i + 1) % stops.length];
      const span = (h1 > h0) ? (h1 - h0) : (24 - h0 + h1);
      const cursor = (hourPhase >= h0 && (h1 > h0 ? hourPhase < h1 : true))
        ? (hourPhase >= h0 ? hourPhase - h0 : (24 - h0 + hourPhase))
        : null;
      if (cursor === null) continue;
      const t = Math.min(1, Math.max(0, cursor / span));
      // Easing: smoothstep so transitions feel less linear.
      const e = t * t * (3 - 2 * t);
      // Interpolate each component.
      if (Array.isArray(v0[0])) return v0; // shouldn't happen
      const out = [];
      for (let k = 0; k < v0.length; k++) {
        if (typeof v0[k] === 'number') out.push(v0[k] + (v1[k] - v0[k]) * e);
        else out.push(lerpColor(v0[k], v1[k], e));
      }
      return out;
    }
    return stops[0][1];
  }

  function paintSky() {
    const now = new Date();
    const hourPhase = now.getHours() + now.getMinutes() / 60;
    const [top, mid, bot] = lerpStops(SKY_STOPS, hourPhase);
    if (sky) {
      sky.style.setProperty('--sky-top', top);
      sky.style.setProperty('--sky-mid', mid);
      sky.style.setProperty('--sky-bot', bot);
      // Stars & sun visibility: night = sun.opacity 0, stars opacity 1.
      // Compute "nightness" 0..1 from hour: peaks at 23-04, fades 5-7 + 19-22.
      const h = hourPhase;
      let nightness = 0;
      if (h >= 22 || h < 5)      nightness = 1;
      else if (h >= 5 && h < 7)  nightness = (7 - h) / 2;
      else if (h >= 19 && h < 22) nightness = (h - 19) / 3;
      sky.style.setProperty('--nightness', String(nightness.toFixed(3)));
      // Keep data-mode for backwards-compat with selectors that branch
      // on it (companion slowdown at night, etc.).
      let mode = 'midday';
      if (h >= 5  && h < 11)  mode = 'morning';
      else if (h >= 11 && h < 17) mode = 'midday';
      else if (h >= 17 && h < 22) mode = 'evening';
      else mode = 'night';
      sky.dataset.mode = mode;
      // Walker shadow length scales with sun height: long at dawn/dusk,
      // short at midday. Ranges 1.0–2.4 multiplier.
      const sunHigh = Math.max(0, 1 - Math.abs(13 - h) / 8); // 0..1, peaks at noon
      const shadowScale = 1.0 + (1 - sunHigh) * 1.4;
      sky.style.setProperty('--shadow-scale', shadowScale.toFixed(2));
    }
    if (sun) {
      // Determine sun position via SUN_STOPS — only fire during daylight.
      const isDay = hourPhase >= 5 && hourPhase < 19;
      if (!isDay) {
        sun.style.opacity = '0';
      } else {
        const [sx, sy, sc] = lerpStops(SUN_STOPS, hourPhase);
        sun.style.opacity = '1';
        sun.style.left = sx + '%';
        sun.style.top  = sy + 'px';
        sun.style.background = sc;
      }
    }
  }
  paintSky();
  // Re-paint every minute so the bar keeps shifting through the day.
  setInterval(paintSky, 60000);

  // ─── Walker noun: load from pc:currentNoun (synced by /me) ────────────
  const walkerImg = document.getElementById('fbv6-walker-noun');
  if (walkerImg) {
    let seed = null;
    try {
      const raw = localStorage.getItem('pc:currentNoun');
      if (raw) {
        const n = parseInt(raw, 10);
        if (Number.isFinite(n) && n >= 0 && n <= 1199) seed = n;
      }
    } catch (e) {}
    if (seed === null) seed = Math.floor(Math.random() * 1200);
    walkerImg.src = 'https://noun.pics/' + seed + '.svg';
    walkerImg.alt = 'You · Noun #' + seed;
  }

  // ─── Listen for noun changes (e.g. SURPRISE on /me) ──────────────────
  window.addEventListener('storage', (e) => {
    if (e.key === 'pc:currentNoun' && walkerImg && e.newValue) {
      const n = parseInt(e.newValue, 10);
      if (Number.isFinite(n) && n >= 0 && n <= 1199) {
        walkerImg.src = 'https://noun.pics/' + n + '.svg';
        walkerImg.alt = 'You · Noun #' + n;
      }
    }
  });
  window.addEventListener('pc:noun-change', (e) => {
    if (walkerImg && e.detail && e.detail.seed != null) {
      walkerImg.src = 'https://noun.pics/' + e.detail.seed + '.svg';
      walkerImg.alt = 'You · Noun #' + e.detail.seed;
    }
  });

  // ─── v6.1: COMPANIONS ────────────────────────────────────────────────
  // Reroute existing companion-kind spells (cat/pup/penguin/...) to
  // spawn IN the bar instead of the global SpellLayer overlay. Each
  // companion is a small emoji sprite that walks alongside your noun
  // for `durationMs` then fades out.
  //
  // Pet persistence (pc:pet:v1) and "keep" interaction land in v6.2 —
  // for now everything is ephemeral. SpellLayer's existing renderers
  // still run for non-companion spells (confetti, breath, etc.).
  const COMPANION_KIND = {
    cat:     { emoji: '🐱', dur: 60000 },
    pup:     { emoji: '🐶', dur: 50000 },
    penguin: { emoji: '🐧', dur: 70000 },
    fish:    { emoji: '🐟', dur: 45000 },
    moth:    { emoji: '🦋', dur: 30000 },
    bee:     { emoji: '🐝', dur: 25000 },
    duck:    { emoji: '🦆', dur: 50000 },
    crab:    { emoji: '🦀', dur: 40000 },
    snail:   { emoji: '🐌', dur: 90000 },
    frog:    { emoji: '🐸', dur: 50000 },
    bird:    { emoji: '🐦', dur: 30000 },
    rabbit:  { emoji: '🐰', dur: 60000 },
    pet:     { emoji: '🐾', dur: 90000 }, // generic "+pet"
  };
  const MAX_COMPANIONS = 3;
  const companionsRoot = document.getElementById('fbv6-companions');

  function spawnCompanion(spellId) {
    const spec = COMPANION_KIND[spellId];
    if (!spec || !companionsRoot) return;
    // Cap at MAX_COMPANIONS — if full, remove the oldest to make room.
    while (companionsRoot.children.length >= MAX_COMPANIONS) {
      companionsRoot.removeChild(companionsRoot.firstChild);
    }
    const node = document.createElement('span');
    node.className = 'fbv6__companion';
    node.dataset.kind = spellId;
    node.title = '+' + spellId + ' · right-click to keep as pet';
    // Stagger animation-delay so multiple companions don't pile on the
    // same x-position. Negative delay = "started Xs ago" — pushes the
    // sprite further along its loop relative to the walker.
    const offset = -2 - (companionsRoot.children.length * 1.6);
    node.style.animationDelay = offset + 's';
    const inner = document.createElement('span');
    inner.className = 'fbv6__companion-inner';
    inner.textContent = spec.emoji;
    node.appendChild(inner);
    companionsRoot.appendChild(node);

    // v6.2: right-click → adopt as persistent pet.
    node.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      adoptPet(spellId);
      // Yank this companion since it's now embodied as the pet.
      if (node.parentNode === companionsRoot) companionsRoot.removeChild(node);
    });

    // Auto-remove after dur with a small fade-out window.
    const fade = Math.min(2400, spec.dur / 4);
    setTimeout(() => { node.classList.add('is-leaving'); }, spec.dur - fade);
    setTimeout(() => {
      if (node.parentNode === companionsRoot) companionsRoot.removeChild(node);
    }, spec.dur);
  }

  window.addEventListener('pc:spell:cast', (e) => {
    const id = e?.detail?.id;
    if (typeof id === 'string' && COMPANION_KIND[id]) {
      spawnCompanion(id);
      // v6.4: broadcast to other v6 bars so the cast appears in their
      // bar too. broadcastCast() is a no-op if the WS isn't open or
      // the visitor isn't opted into v6.
      broadcastCast(id);
    }
  });

  // pc:spell:clear sweeps the layer.
  window.addEventListener('pc:spell:clear', () => {
    if (companionsRoot) companionsRoot.innerHTML = '';
  });

  // ─── v6.2: PET PERSISTENCE ───────────────────────────────────────────
  // Right-click a companion → it's promoted to your pet, stored in
  // pc:pet:v1, and walks alongside your noun forever. Right-click the
  // pet itself → release (with confirm).
  const PET_KEY = 'pc:pet:v1';
  const PET_VERSION = 1;
  const PET_NAMES = [
    'Pebble', 'Cricket', 'Biscuit', 'Mochi', 'Sage', 'Juno', 'Pip',
    'Scout', 'Finch', 'Otto', 'Marbles', 'Basil', 'Pixel', 'Miso',
    'Pippin', 'Nori', 'Kiwi', 'Atlas', 'Beans', 'Doodle',
  ];
  function petLoad() {
    try {
      const raw = localStorage.getItem(PET_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || parsed.$v !== PET_VERSION || !parsed.pet) return null;
      return parsed.pet;
    } catch (e) { return null; }
  }
  function petSave(pet) {
    try {
      localStorage.setItem(PET_KEY, JSON.stringify({ $v: PET_VERSION, pet }));
    } catch (e) {}
  }
  function petClear() {
    try { localStorage.removeItem(PET_KEY); } catch (e) {}
  }
  function petName() {
    return PET_NAMES[Math.floor(Math.random() * PET_NAMES.length)];
  }

  const petRoot   = document.getElementById('fbv6-pet');
  const petInner  = document.getElementById('fbv6-pet-inner');
  const petNameEl = document.getElementById('fbv6-pet-name');
  const petSubEl  = document.getElementById('fbv6-pet-sub');

  function petRender(pet) {
    if (!petRoot || !petInner) return;
    if (!pet) {
      petRoot.hidden = true;
      petInner.textContent = '';
      return;
    }
    const spec = COMPANION_KIND[pet.kind] || { emoji: pet.emoji || '🐾' };
    petInner.textContent = pet.emoji || spec.emoji;
    if (petNameEl) petNameEl.textContent = pet.name;
    if (petSubEl) {
      const days = Math.max(0, Math.floor((Date.now() - new Date(pet.bornAt).getTime()) / 86400000));
      petSubEl.textContent = days === 0 ? 'adopted today' : 'with you for ' + days + (days === 1 ? ' day' : ' days');
    }
    petRoot.title = pet.name + ' (' + (pet.emoji || spec.emoji) + ') · double-click to rename · right-click to release';
    petRoot.hidden = false;
  }

  function adoptPet(kind) {
    // Replacement is allowed: adopting while a pet exists swaps it out.
    const spec = COMPANION_KIND[kind];
    if (!spec) return;
    const existing = petLoad();
    const pet = {
      id: 'pet-' + Date.now().toString(36),
      kind,
      emoji: spec.emoji,
      name: existing && existing.kind === kind ? existing.name : petName(),
      bornAt: new Date().toISOString(),
      mood: 'chill',
    };
    petSave(pet);
    petRender(pet);
    showToast(existing
      ? '🔄 ' + (existing.name || 'pet') + ' → ' + pet.name + ' (' + spec.emoji + ')'
      : '🐾 adopted ' + pet.name + ' (' + spec.emoji + ') · right-click to release');
  }

  function releasePet() {
    const cur = petLoad();
    if (!cur) return;
    if (!confirm('Release ' + cur.name + ' (' + cur.emoji + ')? They\'ll wander off but you can adopt a new pet anytime.')) return;
    petClear();
    petRender(null);
    showToast('🌬 released ' + cur.name + ' · they wandered off');
  }

  petRoot?.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    releasePet();
  });

  // v6.3: double-click pet → rename. Single click is reserved for the
  // hover-style nameplate (already shown on :hover via CSS).
  function renamePet() {
    const cur = petLoad();
    if (!cur) return;
    const next = window.prompt('Rename ' + cur.name + ' (' + cur.emoji + '). Type a new name (or cancel).', cur.name);
    if (!next || !next.trim() || next === cur.name) return;
    cur.name = next.trim().slice(0, 20);
    petSave(cur);
    petRender(cur);
    showToast('✎ renamed → ' + cur.name);
  }
  petRoot?.addEventListener('dblclick', (e) => {
    e.preventDefault();
    renamePet();
  });

  // Toast helper.
  const toastEl = document.getElementById('fbv6-toast');
  let toastTimer = null;
  function showToast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.hidden = false;
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toastEl.hidden = true; }, 3600);
  }

  // Initial pet paint.
  petRender(petLoad());

  // ─── v6.3: AMBIENT EMOTES ────────────────────────────────────────────
  // Periodically pop a small floating emoji above a random walker (you,
  // pet, companion, peer). Makes the bar feel socially alive even when
  // there's no actual interaction. Slower at night (sleepy mode).
  const EMOTES = ['👋', '✨', '🌊', '💭', '🌟', '🌸', '🍃', '☀️', '🫧'];
  const PET_EMOTES = ['🐾', '💕', '✨', '🐾', '🌟'];
  const NIGHT_EMOTES = ['💭', '🌙', '⭐', '✨', '🫧'];

  function fireEmote(parentEl, emoji) {
    if (!parentEl) return;
    const span = document.createElement('span');
    span.className = 'fbv6__emote';
    span.textContent = emoji;
    parentEl.appendChild(span);
    setTimeout(() => {
      if (span.parentNode === parentEl) parentEl.removeChild(span);
    }, 2400);
  }

  function pickAmbientTarget() {
    const candidates = [];
    const walker = document.getElementById('fbv6-walker');
    if (walker) candidates.push({ el: walker, kind: 'walker' });
    if (petRoot && !petRoot.hidden) candidates.push({ el: petRoot, kind: 'pet' });
    document.querySelectorAll('.fbv6__companion').forEach(c => candidates.push({ el: c, kind: 'companion' }));
    document.querySelectorAll('.fbv6__peer').forEach(p => candidates.push({ el: p, kind: 'peer' }));
    if (!candidates.length) return null;
    return candidates[Math.floor(Math.random() * candidates.length)];
  }

  function ambientEmote() {
    const target = pickAmbientTarget();
    if (!target) return;
    const isNight = !!document.querySelector('.fbv6__sky[data-mode="night"]');
    let pool;
    if (target.kind === 'pet') pool = PET_EMOTES;
    else if (isNight) pool = NIGHT_EMOTES;
    else pool = EMOTES;
    const emoji = pool[Math.floor(Math.random() * pool.length)];
    fireEmote(target.el, emoji);
  }

  function scheduleNextEmote() {
    const isNight = !!document.querySelector('.fbv6__sky[data-mode="night"]');
    const min = isNight ? 14000 : 7000;
    const max = isNight ? 26000 : 16000;
    const wait = min + Math.random() * (max - min);
    setTimeout(() => {
      // Only emit if the bar is actually visible (opted-in or /bar-v6).
      if (document.documentElement.classList.contains('bar-v6-on')) {
        ambientEmote();
      }
      scheduleNextEmote();
    }, wait);
  }
  // First emote ~3-5s after mount so the bar isn't silent on entry.
  setTimeout(() => {
    if (document.documentElement.classList.contains('bar-v6-on')) ambientEmote();
    scheduleNextEmote();
  }, 3000 + Math.random() * 2000);

  // ─── v7: BIRD FLYOVER ────────────────────────────────────────────────
  // Occasional 'v'-shaped silhouette glides across the sky from one
  // edge to the other. Rare ambient detail — fires every 45-120s.
  // Direction alternates so the sky doesn't always feel one-way.
  const birdsRoot = document.getElementById('fbv6-birds');
  let birdDir = 1;
  function spawnBird() {
    if (!birdsRoot) return;
    if (!document.documentElement.classList.contains('bar-v6-on')) return;
    // Don't add birds to the deepest hours of night.
    const h = new Date().getHours();
    if (h >= 22 || h < 5) return;
    const node = document.createElement('span');
    node.className = 'fbv6__bird' + (birdDir > 0 ? '' : ' fbv6__bird--rev');
    // Random altitude 6-22px from sky top.
    node.style.top = (6 + Math.random() * 16) + 'px';
    birdsRoot.appendChild(node);
    setTimeout(() => {
      if (node.parentNode === birdsRoot) birdsRoot.removeChild(node);
    }, 7600);
    birdDir = -birdDir;
  }
  function scheduleBird() {
    const wait = 45000 + Math.random() * 75000;
    setTimeout(() => { spawnBird(); scheduleBird(); }, wait);
  }
  // First bird ~10-25s after mount.
  setTimeout(() => { spawnBird(); scheduleBird(); }, 10000 + Math.random() * 15000);

  // ─── v8: REAL WEATHER ────────────────────────────────────────────────
  // Fetch /api/weather (Open-Meteo, El Segundo) and apply visual
  // treatments: extra clouds for partly-cloudy, dim wash for overcast,
  // fog overlay for fog, rain particles for drizzle/rain. WMO codes:
  //   0      clear · 1-2 mainly clear/partly cloudy · 3 overcast
  //   45-48  fog · 51-67 drizzle/rain · 71-86 snow · 95+ thunder
  const weatherEl = document.getElementById('fbv6-weather');
  function applyWeather(data) {
    if (!weatherEl || !data) return;
    const code = Number(data.conditionCode);
    weatherEl.dataset.condition = data.condition || '';
    weatherEl.dataset.code = String(code);
    weatherEl.innerHTML = '';
    // Bucket the WMO code into a visual treatment.
    let treatment = 'clear';
    if (code === 1) treatment = 'mainly-clear';
    else if (code === 2) treatment = 'partly-cloudy';
    else if (code === 3) treatment = 'overcast';
    else if (code >= 45 && code <= 48) treatment = 'fog';
    else if ((code >= 51 && code <= 57) || (code >= 80 && code <= 82)) treatment = 'drizzle';
    else if (code >= 61 && code <= 67) treatment = 'rain';
    else if (code >= 71 && code <= 77) treatment = 'snow';
    else if (code >= 85 && code <= 86) treatment = 'snow';
    else if (code >= 95) treatment = 'thunder';
    weatherEl.dataset.treatment = treatment;

    // Spawn rain particles for drizzle/rain/thunder.
    if (treatment === 'drizzle' || treatment === 'rain' || treatment === 'thunder') {
      const drops = treatment === 'drizzle' ? 12 : (treatment === 'rain' ? 22 : 28);
      for (let i = 0; i < drops; i++) {
        const drop = document.createElement('span');
        drop.className = 'fbv6__rain';
        drop.style.left = (Math.random() * 100) + '%';
        drop.style.animationDelay = (Math.random() * 1.4) + 's';
        drop.style.animationDuration = (0.7 + Math.random() * 0.5) + 's';
        weatherEl.appendChild(drop);
      }
    }
    // Spawn snowflakes for snow.
    if (treatment === 'snow') {
      for (let i = 0; i < 18; i++) {
        const flake = document.createElement('span');
        flake.className = 'fbv6__flake';
        flake.style.left = (Math.random() * 100) + '%';
        flake.style.animationDelay = (Math.random() * 4) + 's';
        flake.style.animationDuration = (3 + Math.random() * 3) + 's';
        weatherEl.appendChild(flake);
      }
    }
    // Set wind hint as CSS var so clouds drift faster on windy days.
    const wind = Number(data.windSpeed) || 3;
    if (sky) sky.style.setProperty('--wind-mult', String(Math.max(0.3, Math.min(2.5, wind / 6))));

    // v9: Toggle the lightning layer for thunder.
    const lightning = document.getElementById('fbv6-lightning');
    if (lightning) {
      lightning.classList.toggle('is-active', treatment === 'thunder');
    }
  }
  function fetchWeather() {
    if (!weatherEl) return;
    if (!document.documentElement.classList.contains('bar-v6-on')) return;
    fetch('/api/weather', { cache: 'default' })
      .then(r => r.ok ? r.json() : null)
      .then(applyWeather)
      .catch(() => {});
  }
  // First fetch ~2s after mount so it doesn't compete with initial paint.
  setTimeout(fetchWeather, 2000);
  // Refresh every 15 minutes — the API caches at the edge anyway.
  setInterval(fetchWeather, 15 * 60 * 1000);

  // ─── v8: WALKER MOOD AURA ─────────────────────────────────────────────
  // Reads pc:mood from localStorage and sets data-mood on the walker.
  // CSS handles the colored radial glow. Listens for storage events so
  // changing mood on /me updates the aura everywhere instantly.
  function paintMood() {
    const walker = document.getElementById('fbv6-walker');
    if (!walker) return;
    let mood = '';
    try {
      mood = localStorage.getItem('pc:mood') || '';
      // Fallback: read from pc:me:v1 (the /me identity blob).
      if (!mood) {
        const me = JSON.parse(localStorage.getItem('pc:me:v1') || '{}');
        if (me && typeof me.mood === 'string') mood = me.mood;
      }
    } catch (e) {}
    walker.dataset.mood = mood;
  }
  paintMood();
  window.addEventListener('storage', (e) => {
    if (e.key === 'pc:mood') paintMood();
  });
  // pc:me:v1 also stores mood (different key); refresh on changes there too.
  window.addEventListener('storage', (e) => {
    if (e.key === 'pc:me:v1') {
      try {
        const me = JSON.parse(e.newValue || '{}');
        if (me && me.mood) {
          const walker = document.getElementById('fbv6-walker');
          if (walker) walker.dataset.mood = me.mood;
        }
      } catch (err) {}
    }
  });

  // ─── v6.2: CROSS-VISITOR PEERS ───────────────────────────────────────
  // Other visitors' nouns walk in YOUR bar as ghost-translucent. We use
  // the existing PresenceRoom DO via /api/room with a synthetic key
  // "/__bar__" so the bar is global (independent of which page each
  // visitor is on). Position isn't synced per-frame — each peer just
  // joins with their nounId and we render them walking with a random
  // phase. The walk loop is identical on every client; offsets are
  // local-only. Cheap, effective, and there's no animation thrash.
  const peersRoot = document.getElementById('fbv6-peers');
  const MAX_PEERS = 4;

  function getCurrentNounSeed() {
    let seed = null;
    try {
      const raw = localStorage.getItem('pc:currentNoun');
      if (raw) {
        const n = parseInt(raw, 10);
        if (Number.isFinite(n) && n >= 0 && n <= 1199) seed = n;
      }
    } catch (e) {}
    return seed;
  }

  function getOrMakeBarSession() {
    const k = 'pc:bar:sid:v1';
    try {
      let sid = localStorage.getItem(k);
      if (!sid) {
        sid = 'sid_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);
        localStorage.setItem(k, sid);
      }
      return sid;
    } catch (e) {
      return 'sid_' + Math.random().toString(36).slice(2, 10);
    }
  }

  let peerWS = null;
  let peerSessions = new Map(); // sessionId -> { nounId, node, phaseDelay }
  // v6.4: cross-room spell casts. We piggyback on the existing chat
  // protocol — chat msg with prefix "__cast__:<spell-id>" is treated
  // as a cast broadcast. Sender's sid is excluded so we don't double-
  // spawn locally.
  const CAST_PREFIX = '__cast__:';
  const mySid = getOrMakeBarSession();
  let connectedAt = 0;          // set when WS opens; stale-cast guard
  const seenCastAt = new Set(); // dedupe replays

  function broadcastCast(spellId) {
    if (!peerWS || peerWS.readyState !== WebSocket.OPEN) return;
    if (typeof spellId !== 'string' || !COMPANION_KIND[spellId]) return;
    try {
      peerWS.send(JSON.stringify({ type: 'chat', msg: CAST_PREFIX + spellId }));
    } catch (e) {}
  }

  function onChat(chat) {
    if (!Array.isArray(chat)) return;
    for (const m of chat) {
      if (!m || typeof m.msg !== 'string') continue;
      if (!m.msg.startsWith(CAST_PREFIX)) continue;
      // Skip self.
      if (m.sid === mySid) continue;
      // Dedupe replays (DO sends recent chat history on connect/reconnect).
      const key = (m.sid || '?') + ':' + (m.at || '?');
      if (seenCastAt.has(key)) continue;
      seenCastAt.add(key);
      // Bound the dedupe set so it doesn't grow unbounded.
      if (seenCastAt.size > 256) {
        const first = seenCastAt.values().next().value;
        seenCastAt.delete(first);
      }
      // Stale-cast guard: ignore casts older than 8s before we connected
      // (= history dump on reconnect — we don't want a flood of fish/cats
      // appearing in someone's bar just because they reloaded).
      const at = m.at ? +new Date(m.at) : 0;
      if (at && connectedAt && at < connectedAt - 8000) continue;
      const spellId = m.msg.slice(CAST_PREFIX.length);
      if (COMPANION_KIND[spellId]) spawnCompanion(spellId);
    }
  }

  function renderPeer(sid, nounId) {
    if (!peersRoot) return;
    let entry = peerSessions.get(sid);
    if (!entry) {
      if (peerSessions.size >= MAX_PEERS) return; // soft cap
      const node = document.createElement('div');
      node.className = 'fbv6__peer';
      node.dataset.sid = sid;
      // Random phase so peers don't bunch up at the start.
      const phase = -1 - Math.random() * 60;
      node.style.animationDelay = phase + 's';
      const img = document.createElement('img');
      img.alt = '';
      img.width = 28;
      img.height = 28;
      img.src = 'https://noun.pics/' + nounId + '.svg';
      node.title = 'visitor · noun #' + nounId;
      node.appendChild(img);
      const shadow = document.createElement('span');
      shadow.className = 'fbv6__peer-shadow';
      node.appendChild(shadow);
      peersRoot.appendChild(node);
      entry = { nounId, node, phaseDelay: phase };
      peerSessions.set(sid, entry);
    } else if (entry.nounId !== nounId) {
      entry.nounId = nounId;
      const img = entry.node.querySelector('img');
      if (img) {
        img.src = 'https://noun.pics/' + nounId + '.svg';
      }
      entry.node.title = 'visitor · noun #' + nounId;
    }
  }

  function dropPeer(sid) {
    const entry = peerSessions.get(sid);
    if (!entry) return;
    entry.node.classList.add('is-leaving');
    setTimeout(() => {
      if (entry.node.parentNode === peersRoot) peersRoot.removeChild(entry.node);
    }, 800);
    peerSessions.delete(sid);
  }

  function onPeers(peers) {
    if (!Array.isArray(peers)) return;
    const seen = new Set();
    for (const p of peers) {
      if (!p || !p.sessionId || p.nounId == null) continue;
      const n = parseInt(p.nounId, 10);
      if (!Number.isFinite(n) || n < 0 || n > 1199) continue;
      seen.add(p.sessionId);
      renderPeer(p.sessionId, n);
    }
    // Drop peers that vanished from the broadcast.
    for (const sid of Array.from(peerSessions.keys())) {
      if (!seen.has(sid)) dropPeer(sid);
    }
  }

  function connectPeers() {
    if (typeof WebSocket === 'undefined') return;
    if (!peersRoot) return;
    // Don't open the WS until we know our own noun seed (it's set on
    // mount above).
    const ourSeed = getCurrentNounSeed();
    if (ourSeed === null) {
      setTimeout(connectPeers, 600);
      return;
    }
    const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const url = proto + '//' + location.host + '/api/room?url=' +
                encodeURIComponent('/__bar__') +
                '&sid=' + encodeURIComponent(mySid) +
                '&kind=human';
    let ws;
    try { ws = new WebSocket(url); } catch (e) { return; }
    peerWS = ws;
    let pingTimer = null;
    let nounChangeListener = null;

    ws.addEventListener('open', () => {
      connectedAt = Date.now();
      try {
        ws.send(JSON.stringify({
          type: 'identify',
          nounId: ourSeed,
          kind: 'human',
          tag: 'bar',
        }));
      } catch (e) {}
      pingTimer = setInterval(() => {
        try { ws.send(JSON.stringify({ type: 'ping' })); } catch (e) {}
      }, 25000);
      // Re-identify when the local noun changes so peers see our new sprite.
      nounChangeListener = (e) => {
        const n = e?.detail?.seed;
        if (typeof n === 'number' && ws.readyState === WebSocket.OPEN) {
          try {
            ws.send(JSON.stringify({ type: 'identify', nounId: n, kind: 'human', tag: 'bar' }));
          } catch (err) {}
        }
      };
      window.addEventListener('pc:noun-change', nounChangeListener);
    });

    ws.addEventListener('message', (e) => {
      try {
        const data = JSON.parse(e.data);
        if (data && Array.isArray(data.peers)) onPeers(data.peers);
        if (data && Array.isArray(data.chat))  onChat(data.chat);
      } catch (err) {}
    });

    ws.addEventListener('close', () => {
      if (pingTimer) clearInterval(pingTimer);
      if (nounChangeListener) window.removeEventListener('pc:noun-change', nounChangeListener);
      // Soft reconnect after 4–8s. Don't fight broken networks.
      const wait = 4000 + Math.random() * 4000;
      setTimeout(connectPeers, wait);
    });
    ws.addEventListener('error', () => {
      try { ws.close(); } catch (e) {}
    });
  }

  // Defer 1.2s so initial paint isn't competing with WebSocket overhead.
  setTimeout(connectPeers, 1200);
})();
</script>

<style>
  /* Bar shell — taller than v5 (~80px) so the scene has room to breathe.
     Fixed at the bottom with the same backdrop-blur trick as v5.
     Hidden by default — opt-in via localStorage pc:bar:v6 = 'on', which
     adds .bar-v6-on to <html>. /bar-v6 always shows it (the page sets
     the class via inline script). */
  .fbv6 {
    display: none;
    position: fixed; bottom: 0; left: 0; right: 0;
    height: 80px;
    z-index: 60;
    overflow: hidden;
    pointer-events: auto;
    user-select: none;
    border-top: 1px solid rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  :global(html.bar-v6-on) .fbv6 { display: block; }

  /* SKY — continuous gradient driven by --sky-* CSS vars set by JS
     every minute. Falls back to a neutral evening if vars not set
     (initial paint before JS runs). */
  .fbv6__sky {
    position: absolute; inset: 0;
    --sky-top: #ffe7a0;
    --sky-mid: #ffc97a;
    --sky-bot: #f3d8b8;
    --nightness: 0;
    --shadow-scale: 1;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 50%, var(--sky-bot) 100%);
    transition: background 1.2s ease;
  }
  /* Subtle horizon haze — denser warm band where sky meets ground. */
  .fbv6__sky::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 18px;
    background: linear-gradient(180deg, transparent, rgba(255, 220, 170, 0.18));
    pointer-events: none;
  }
  /* v9: PARALLAX CLOUDS — three altitudes drifting at three speeds.
     Speeds are inverse-related to size (high = small/fast, low = big/
     slow) which is how distance reads in 3D. All animations factor in
     --wind-mult so windy weather drifts faster. Night fades all
     clouds to opacity proportional to --nightness (i.e. clouds dim
     but don't vanish — fits a real night sky). */
  .fbv6__sky .fbv6__cloud {
    position: absolute;
    background: #fff8e5;
    border-radius: 5px;
    opacity: calc(0.85 - var(--nightness, 0) * 0.55);
    transition: opacity 1.2s ease;
  }
  /* HIGH layer: small, fast, slightly transparent (atmospheric haze) */
  .fbv6__cloud--high1, .fbv6__cloud--high2 {
    top: 6px;
    width: 18px; height: 5px;
    background: #fdf2d6;
    opacity: calc(0.55 - var(--nightness, 0) * 0.4);
    box-shadow: 4px -2px 0 #fdf2d6, -5px -1px 0 #fdf2d6;
    animation: fbv6-cloud-drift calc(40s / var(--wind-mult, 1)) linear infinite;
  }
  .fbv6__cloud--high1 { left: -10%; animation-delay: -5s; }
  .fbv6__cloud--high2 { left: 50%;  animation-delay: -22s; }
  /* MID layer: standard size, medium speed (the "main" clouds) */
  .fbv6__cloud--mid1, .fbv6__cloud--mid2 {
    top: 16px;
    width: 28px; height: 8px;
    box-shadow: 6px -3px 0 #fff8e5, -8px -2px 0 #fff8e5;
    animation: fbv6-cloud-drift calc(70s / var(--wind-mult, 1)) linear infinite;
  }
  .fbv6__cloud--mid1 { left: 12%; animation-delay: -10s; }
  .fbv6__cloud--mid2 { left: 64%; animation-delay: -36s; opacity: calc(0.75 - var(--nightness, 0) * 0.5); }
  /* LOW layer: large, slow (close to viewer) */
  .fbv6__cloud--low1 {
    top: 28px;
    width: 44px; height: 11px;
    background: #fff;
    box-shadow: 10px -5px 0 #fff, -14px -3px 0 #fff, 18px -1px 0 #fff;
    opacity: calc(0.72 - var(--nightness, 0) * 0.55);
    animation: fbv6-cloud-drift calc(110s / var(--wind-mult, 1)) linear infinite;
    animation-delay: -45s;
  }
  /* Clouds wrap continuously by translating out + back via long range. */
  @keyframes fbv6-cloud-drift {
    0%   { transform: translateX(0); }
    100% { transform: translateX(160px); }
  }

  /* Stars — fade in proportional to --nightness (0..1), with a subtle
     twinkle. Five stars now (was three) for a denser sky. */
  .fbv6__sky .fbv6__star {
    position: absolute; width: 2px; height: 2px;
    background: #fdf2d6; border-radius: 50%;
    opacity: calc(var(--nightness) * 0.95);
    box-shadow: 0 0 4px rgba(253, 242, 214, 0.7);
    transition: opacity 1.2s ease;
    animation: fbv6-twinkle 4s ease-in-out infinite;
  }
  .fbv6__star--1 { top: 10px;  left: 14%; animation-delay: -0.4s; }
  .fbv6__star--2 { top: 18px;  left: 32%; animation-delay: -1.2s; }
  .fbv6__star--3 { top: 8px;   left: 56%; animation-delay: -2.0s; }
  .fbv6__star--4 { top: 22px;  left: 71%; animation-delay: -2.8s; }
  .fbv6__star--5 { top: 12px;  left: 88%; animation-delay: -3.4s; }
  @keyframes fbv6-twinkle {
    0%, 100% { transform: scale(1);   filter: brightness(1); }
    50%      { transform: scale(1.4); filter: brightness(1.5); }
  }

  /* Sun — small dot in the sky, position by mode */
  .fbv6__sun {
    position: absolute;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: #fff8c0;
    box-shadow: 0 0 12px rgba(255, 240, 140, 0.6);
    transition: top 0.6s ease, left 0.6s ease, background 0.6s ease, opacity 0.6s ease;
    top: 30px; left: 50%;
  }
  .fbv6__sun[data-mode='morning'] { top: 30px; left: 18%; background: #ffce7a; }
  .fbv6__sun[data-mode='midday']  { top: 12px; left: 50%; background: #ffe48a; }
  .fbv6__sun[data-mode='evening'] { top: 36px; left: 78%; background: #ff7a4a; box-shadow: 0 0 18px rgba(255, 100, 60, 0.55); }
  .fbv6__sun[data-mode='night']   { opacity: 0; }

  /* v8: SKYLINE — distant pixel-silhouette buildings behind the
     foreground row. Color shifts with --nightness so distant buildings
     fade into the night sky. The wind multiplier doesn't apply here
     — distant skyline is static, parallax of the sky alone gives the
     depth illusion when clouds move.
     Sits at ~30px above the ground line, behind everything. */
  .fbv6__skyline {
    position: absolute;
    left: 0; right: 0;
    bottom: 14px;
    height: 30px;
    z-index: 0;
    pointer-events: none;
    /* Color: warm-grey by default, shifts darker at night. */
    color: rgba(60, 50, 38, calc(0.42 + var(--nightness, 0) * 0.45));
    transition: color 1.2s ease;
    /* Soft top edge so it blends into sky instead of cutting hard. */
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 25%, #000 100%);
            mask-image: linear-gradient(180deg, transparent 0%, #000 25%, #000 100%);
  }
  .fbv6__skyline svg { display: block; width: 100%; height: 100%; }

  /* v8: WEATHER OVERLAY */
  .fbv6__weather {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  /* Overcast: dim wash + saturate the sky downward. */
  .fbv6__weather[data-treatment='overcast']::before,
  .fbv6__weather[data-treatment='partly-cloudy']::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(180, 188, 195, 0.32) 0%, rgba(150, 160, 170, 0.18) 60%, transparent 100%);
    pointer-events: none;
  }
  .fbv6__weather[data-treatment='overcast']::after {
    /* Extra cloud bands for overcast. */
    content: '';
    position: absolute; top: 6px; left: 0; right: 0;
    height: 14px;
    background:
      radial-gradient(ellipse 30px 6px at 12% 50%, rgba(255, 255, 255, 0.6) 0%, transparent 70%),
      radial-gradient(ellipse 40px 7px at 38% 50%, rgba(255, 255, 255, 0.55) 0%, transparent 70%),
      radial-gradient(ellipse 36px 6px at 62% 50%, rgba(255, 255, 255, 0.5) 0%, transparent 70%),
      radial-gradient(ellipse 32px 7px at 88% 50%, rgba(255, 255, 255, 0.55) 0%, transparent 70%);
    animation: fbv6-overcast-drift 80s linear infinite;
  }
  @keyframes fbv6-overcast-drift {
    0%   { transform: translateX(0); }
    100% { transform: translateX(40px); }
  }
  /* Fog: low band of wash near the ground line. */
  .fbv6__weather[data-treatment='fog']::before {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 14px;
    height: 38px;
    background: linear-gradient(180deg, transparent, rgba(220, 220, 220, 0.55) 60%, rgba(220, 220, 220, 0.65));
    pointer-events: none;
    animation: fbv6-fog-drift 30s ease-in-out infinite alternate;
  }
  @keyframes fbv6-fog-drift {
    from { opacity: 0.85; transform: translateX(-3px); }
    to   { opacity: 1;    transform: translateX(3px);  }
  }
  /* Rain: many tiny streaks falling diagonally. */
  .fbv6__rain {
    position: absolute;
    top: -6px;
    width: 1px;
    height: 8px;
    background: linear-gradient(180deg, transparent, rgba(180, 200, 230, 0.7));
    transform: rotate(15deg);
    animation: fbv6-rain-fall 0.9s linear infinite;
  }
  @keyframes fbv6-rain-fall {
    from { transform: translateY(0)    rotate(15deg); opacity: 0; }
    8%   {                                            opacity: 1; }
    to   { transform: translateY(80px) rotate(15deg); opacity: 0; }
  }
  /* Snow: bigger soft flakes, slower. */
  .fbv6__flake {
    position: absolute;
    top: -6px;
    width: 3px; height: 3px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.6);
    animation: fbv6-flake-fall linear infinite;
  }
  @keyframes fbv6-flake-fall {
    from { transform: translateY(0)    translateX(0);    opacity: 0; }
    10%  {                                                opacity: 1; }
    50%  { transform: translateY(40px) translateX(6px);              }
    to   { transform: translateY(80px) translateX(0);    opacity: 0; }
  }

  /* v10: PALM TREES — pixel silhouettes scattered between buildings.
     Each palm uses currentColor so it tints with --nightness. The
     small fronds at the top read as foreground SoCal flavor. */
  .fbv6__palms {
    position: absolute;
    left: 0; right: 0; bottom: 14px;
    pointer-events: none;
    z-index: 1;
    color: rgba(40, 30, 18, calc(0.55 + var(--nightness, 0) * 0.35));
    transition: color 1.2s ease;
  }
  .fbv6__palm {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    display: block;
  }
  .fbv6__palm svg { display: block; }
  .fbv6__palm--tall  svg { width: 14px; height: 16px; }
  .fbv6__palm--lean  svg { width: 14px; height: 15px; }
  .fbv6__palm--small svg { width: 10px; height: 10px; }

  /* v10: OCEAN — Pacific edge at the far right. Two wave layers roll
     across each other for visual depth. Water reflects time-of-day:
     warmer at golden hour, deep navy at night. */
  .fbv6__ocean {
    position: absolute;
    right: 0; bottom: 14px;
    width: 14%;
    height: 6px;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    border-top-left-radius: 1px;
  }
  .fbv6__ocean-water {
    position: absolute; inset: 0;
    /* Pacific Ocean palette: shifts darker at night via --nightness */
    background:
      linear-gradient(180deg,
        hsl(206, calc(45% - var(--nightness, 0) * 25%), calc(52% - var(--nightness, 0) * 36%)) 0%,
        hsl(212, calc(50% - var(--nightness, 0) * 30%), calc(38% - var(--nightness, 0) * 26%)) 100%);
    transition: background 1.2s ease;
  }
  .fbv6__wave {
    position: absolute;
    bottom: 0;
    width: 200%;
    height: 100%;
    /* Wave crests slightly lighter than water; --nightness fades them */
    color: rgba(255, 255, 255, calc(0.45 - var(--nightness, 0) * 0.25));
    animation-name: fbv6-wave-roll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .fbv6__wave--front {
    left: -100%;
    animation-duration: calc(18s / var(--wind-mult, 1));
  }
  .fbv6__wave--back {
    left: -100%;
    color: rgba(255, 255, 255, calc(0.25 - var(--nightness, 0) * 0.15));
    animation-duration: calc(28s / var(--wind-mult, 1));
    animation-delay: -7s;
    transform: translateY(1px);
  }
  @keyframes fbv6-wave-roll {
    from { transform: translateX(0); }
    to   { transform: translateX(50%); }
  }

  /* GROUND line — single horizontal stroke at ~62% height */
  .fbv6__ground {
    position: absolute; left: 0; right: 0; bottom: 14px;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.45) 8%, rgba(0,0,0,0.45) 92%, transparent 100%);
  }

  /* BUILDINGS — positioned by --bx percent, sized by --bw/--bh. */
  .fbv6__buildings {
    position: absolute; inset: 0;
    list-style: none; margin: 0; padding: 0;
  }
  .fbv6__building {
    position: absolute;
    bottom: 14px;
    left: var(--bx);
    transform: translateX(-50%);
  }
  .fbv6__building-link {
    position: relative; display: block;
    text-decoration: none; color: inherit;
  }
  /* v11: building shape now hosts a Codex-crafted detailed SVG sprite
     instead of CSS rectangles. The SVG IS the building art. CSS just
     sizes the container, adds a subtle drop shadow under it, and
     applies hover lift. */
  .fbv6__building-shape {
    position: relative; display: block;
    width: var(--bw); height: var(--bh);
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, calc(0.18 + var(--nightness, 0) * 0.20)));
    transition:
      filter 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fbv6__building-shape svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The SVG sprites have .lit-window paths marking warm-glow elements
     (windows, signs). At night these glow warm-yellow via filter
     drop-shadow scaled by --nightness. By day they're flat colored
     squares within the building art. */
  .fbv6__building-shape svg .lit-window {
    transition: filter 1.2s ease, opacity 1.2s ease;
    opacity: calc(0.55 + var(--nightness, 0) * 0.45);
    filter: drop-shadow(0 0 calc(var(--nightness, 0) * 5px) rgba(255, 220, 130, calc(var(--nightness, 0) * 0.85)));
  }
  /* Stub for vitrine-scene — kept for backward compat; scene element
     is no longer rendered in markup but the class might be referenced
     elsewhere. */
  .fbv6__vitrine-scene {
    font-size: 10px;
    line-height: 1;
    /* brightness(0) = pure black silhouette regardless of source emoji.
       Visible in the lit window at night, completely invisible during
       the day (parent has 0 background). */
    filter: brightness(0);
    opacity: calc(var(--nightness, 0) * 0.85);
    transition: opacity 1.2s ease;
  }

  /* v9: STREET LAMPS — small posts between buildings. Lamp head glows
     warm at night via --nightness. Posts visible faintly during the
     day so the silhouette of the street is consistent. */
  .fbv6__lamps {
    position: absolute;
    left: 0; right: 0; bottom: 14px;
    height: 14px;
    pointer-events: none;
    z-index: 1;
  }
  .fbv6__lamp {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    width: 1.5px; height: 12px;
    background: rgba(40, 30, 18, calc(0.4 + var(--nightness, 0) * 0.3));
  }
  .fbv6__lamp::before {
    /* Lamp head — illuminated at night */
    content: '';
    position: absolute;
    top: -1px; left: 50%; transform: translateX(-50%);
    width: 5px; height: 4px;
    border-radius: 50%;
    background: rgba(255, 220, 140, calc(0.15 + var(--nightness, 0) * 0.85));
    box-shadow:
      0 0 calc(2px + var(--nightness, 0) * 12px) rgba(255, 200, 100, calc(var(--nightness, 0) * 0.7));
    transition: background 1.2s ease, box-shadow 1.2s ease;
  }
  .fbv6__lamp::after {
    /* Tiny ground pool of warm light at night */
    content: '';
    position: absolute;
    bottom: -2px; left: 50%; transform: translateX(-50%);
    width: calc(2px + var(--nightness, 0) * 16px);
    height: 2px;
    border-radius: 50%;
    background: rgba(255, 200, 100, calc(var(--nightness, 0) * 0.32));
    filter: blur(2px);
    transition: width 1.2s ease, background 1.2s ease;
  }

  /* v9: LIGHTNING — full-bar white flash, occasional, only when the
     thunder treatment is active. Two-stage flash + rumble pause feels
     more real than a constant strobe. */
  .fbv6__lightning {
    position: absolute; inset: 0;
    pointer-events: none;
    background: #fff;
    opacity: 0;
    z-index: 2;
  }
  .fbv6__lightning.is-active {
    animation: fbv6-lightning 11s steps(1, end) infinite;
  }
  @keyframes fbv6-lightning {
    0%, 9%   { opacity: 0; }
    10%      { opacity: 0.9; }   /* main flash */
    11%      { opacity: 0; }
    13%      { opacity: 0.6; }   /* secondary flicker */
    14%, 100% { opacity: 0; }
  }

  /* Chimney smoke — the v11 SVGs already include painted chimney
     details. We add three animated smoke puffs on top via CSS for
     continuous motion. The puffs anchor near the top of the building. */
  .fbv6__chimney {
    position: absolute;
    top: -2px; right: 8px;
    width: 5px; height: 8px;
    pointer-events: none;
  }
  .fbv6__smoke {
    position: absolute;
    bottom: 8px; left: 50%;
    width: 5px; height: 5px;
    background: rgba(245, 245, 245, 0.55);
    border-radius: 50%;
    transform: translate(-50%, 0) scale(0.4);
    opacity: 0;
    animation: fbv6-smoke 4.4s ease-out infinite;
    filter: blur(0.4px);
  }
  .fbv6__smoke--1 { animation-delay: 0s; }
  .fbv6__smoke--2 { animation-delay: 1.5s; }
  .fbv6__smoke--3 { animation-delay: 3s; }
  @keyframes fbv6-smoke {
    0%   { opacity: 0;    transform: translate(-50%, 0) scale(0.4); }
    20%  { opacity: 0.7;  }
    100% { opacity: 0;    transform: translate(calc(-50% + 6px), -22px) scale(2.2); }
  }
  /* Smoke is wisp-grey at night for visibility against dark sky. */
  .fbv6__sky[data-mode='night'] ~ * .fbv6__smoke,
  .fbv6:has(.fbv6__sky[data-mode='night']) .fbv6__smoke {
    background: rgba(220, 230, 240, 0.42);
  }
  .fbv6__building:hover .fbv6__building-shape {
    filter:
      brightness(1.12) saturate(1.08)
      drop-shadow(0 6px 8px rgba(0, 0, 0, calc(0.22 + var(--nightness, 0) * 0.26)));
    transform: translateY(-3px);
  }

  /* NAMEPLATE — floats above the building on hover */
  .fbv6__building-plate {
    position: absolute;
    bottom: calc(var(--bh) + 10px);
    left: 50%;
    transform: translate(-50%, 6px);
    background: rgba(26, 18, 8, 0.96);
    border: 1px solid rgba(255, 200, 120, 0.45);
    border-radius: 2px;
    padding: 4px 10px;
    color: #fdf2d6;
    font-size: 10px; letter-spacing: 0.16em;
    text-align: center;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.32);
  }
  .fbv6__building-plate strong { display: block; font-weight: 700; }
  .fbv6__building-sub {
    display: block; font-size: 9px;
    color: rgba(253, 242, 214, 0.65); letter-spacing: 0.1em;
    margin-top: 2px;
  }
  .fbv6__building:hover .fbv6__building-plate {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* WALKER — your noun moves along the ground in a 60s loop. */
  .fbv6__walker {
    position: absolute;
    bottom: 14px;
    left: 0;
    transform-origin: bottom center;
    animation: fbv6-walk 60s linear infinite;
    pointer-events: none;
  }
  .fbv6__walker img {
    display: block;
    width: 32px; height: 32px;
    image-rendering: pixelated;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.35));
    animation: fbv6-bob 0.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  /* Walker shadow — width scales with --shadow-scale (set by paintSky):
     ~22px at noon, up to ~50px at dawn/dusk. Faded color too. */
  /* v8: WALKER MOOD AURA — radial glow tinted by pc:mood. Sits behind
     the noun img; only visible when data-mood is set. Six moods, each
     a different color. Subtle by design — should feel like a halo,
     not a Pokeball. */
  .fbv6__walker-aura {
    position: absolute;
    top: -4px; left: 50%;
    width: 44px; height: 44px;
    margin-left: -22px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    filter: blur(4px);
    transition: opacity 0.6s ease, background 0.6s ease;
  }
  .fbv6__walker[data-mood='chill'] .fbv6__walker-aura   {
    background: radial-gradient(circle, rgba(140, 200, 230, 0.55) 0%, transparent 70%);
    opacity: 1;
  }
  .fbv6__walker[data-mood='hype'] .fbv6__walker-aura    {
    background: radial-gradient(circle, rgba(255, 140, 80, 0.6)  0%, transparent 70%);
    opacity: 1;
    animation: fbv6-aura-pulse 1.6s ease-in-out infinite;
  }
  .fbv6__walker[data-mood='focus'] .fbv6__walker-aura   {
    background: radial-gradient(circle, rgba(120, 200, 140, 0.55) 0%, transparent 70%);
    opacity: 1;
  }
  .fbv6__walker[data-mood='flow'] .fbv6__walker-aura    {
    background: radial-gradient(circle, rgba(180, 140, 220, 0.55) 0%, transparent 70%);
    opacity: 1;
    animation: fbv6-aura-pulse 3.2s ease-in-out infinite;
  }
  .fbv6__walker[data-mood='curious'] .fbv6__walker-aura {
    background: radial-gradient(circle, rgba(240, 210, 100, 0.55) 0%, transparent 70%);
    opacity: 1;
  }
  .fbv6__walker[data-mood='quiet'] .fbv6__walker-aura   {
    background: radial-gradient(circle, rgba(180, 180, 190, 0.45) 0%, transparent 70%);
    opacity: 1;
  }
  @keyframes fbv6-aura-pulse {
    0%, 100% { transform: scale(1);    filter: blur(4px); }
    50%      { transform: scale(1.18); filter: blur(5px); }
  }

  .fbv6__walker-shadow {
    position: absolute; bottom: -2px; left: 50%;
    width: calc(22px * var(--shadow-scale, 1));
    height: 4px;
    background: rgba(0, 0, 0, calc(0.20 - var(--nightness, 0) * 0.10));
    border-radius: 50%;
    transform: translateX(-50%);
    transition: width 1.2s ease, background 1.2s ease;
    filter: blur(calc(var(--shadow-scale, 1) - 0.5px));
  }
  /* fbv6-walk uses cubic-bezier easing so the loop has natural pacing
     instead of metronome-linear motion. The flip points stay at 49/50
     and 99/100 to keep the U-turn instant. */
  @keyframes fbv6-walk {
    0%   { left: -2%;   transform: scaleX(1); }
    49%  { left: 100%;  transform: scaleX(1); }
    50%  { left: 100%;  transform: scaleX(-1); }
    99%  { left: -2%;   transform: scaleX(-1); }
    100% { left: -2%;   transform: scaleX(1); }
  }
  /* The walker animation itself stays linear so position is predictable
     for cross-visitor sync. Bob uses a sinusoidal easing so it feels
     more like real walking. */
  @keyframes fbv6-bob {
    0%, 100% { transform: translateY(0)    rotate(0deg); }
    25%      { transform: translateY(-1px) rotate(-1deg); }
    50%      { transform: translateY(-2px) rotate(0deg); }
    75%      { transform: translateY(-1px) rotate(1deg); }
  }

  /* BIRDS — small 'v' silhouettes that drift across the sky. */
  .fbv6__birds {
    position: absolute; inset: 0;
    pointer-events: none;
  }
  .fbv6__bird {
    position: absolute;
    left: -20px;
    width: 9px; height: 5px;
    background:
      linear-gradient(135deg, transparent 45%, rgba(20, 14, 6, 0.55) 46%, rgba(20, 14, 6, 0.55) 54%, transparent 55%),
      linear-gradient( 45deg, transparent 45%, rgba(20, 14, 6, 0.55) 46%, rgba(20, 14, 6, 0.55) 54%, transparent 55%);
    background-size: 5px 5px;
    background-position: 0 0, 5px 0;
    background-repeat: no-repeat;
    animation:
      fbv6-bird-fly 7.2s linear forwards,
      fbv6-bird-wing 0.32s ease-in-out infinite;
  }
  .fbv6__bird--rev {
    animation:
      fbv6-bird-fly-rev 7.2s linear forwards,
      fbv6-bird-wing 0.32s ease-in-out infinite;
  }
  @keyframes fbv6-bird-fly {
    from { left: -20px; }
    to   { left: 110%;  }
  }
  @keyframes fbv6-bird-fly-rev {
    from { left: 110%; transform: scaleX(-1); }
    to   { left: -20px; transform: scaleX(-1); }
  }
  @keyframes fbv6-bird-wing {
    0%, 100% { background-size: 5px 5px;     }
    50%      { background-size: 5px 2.5px;   }
  }
  /* Slow walker at night so the bar feels sleepy */
  .fbv6__sky[data-mode='night'] ~ .fbv6__walker,
  .fbv6:has(.fbv6__sky[data-mode='night']) .fbv6__walker {
    animation-duration: 120s;
  }

  /* COMPANIONS — emoji sprites that share the noun's walk animation.
     Each gets its own animation-delay (set inline) so they trail the
     walker at staggered offsets. */
  .fbv6__companions {
    position: absolute; inset: 0;
    pointer-events: none;
  }
  .fbv6__companion {
    position: absolute;
    bottom: 14px;
    left: 0;
    width: 22px; height: 22px;
    transform-origin: bottom center;
    animation: fbv6-walk 60s linear infinite;
    pointer-events: auto;
    cursor: help;
  }
  .fbv6__companion-inner {
    display: inline-block;
    font-size: 18px;
    line-height: 1;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,0.4));
    animation: fbv6-companion-bob 0.5s ease-in-out infinite;
  }
  .fbv6__companion::before {
    /* shadow puff under the sprite */
    content: '';
    position: absolute;
    bottom: -3px; left: 50%;
    width: 16px; height: 3px;
    background: rgba(0,0,0,0.18); border-radius: 50%;
    transform: translateX(-50%);
  }
  @keyframes fbv6-companion-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-1.5px); }
  }
  .fbv6:has(.fbv6__sky[data-mode='night']) .fbv6__companion {
    animation-duration: 120s;
    opacity: 0.65;
  }
  /* Fade out when the companion's lifetime is ending */
  .fbv6__companion.is-leaving {
    transition: opacity 2.4s ease, transform 2.4s ease;
    opacity: 0;
  }

  /* PET (v6.2) — single persistent companion. Walks like a companion
     but never auto-fades; nameplate shows on hover; right-click releases. */
  .fbv6__pet {
    position: absolute;
    bottom: 14px;
    left: 0;
    width: 24px; height: 24px;
    transform-origin: bottom center;
    animation: fbv6-walk 60s linear infinite;
    animation-delay: -8s;
    pointer-events: auto;
    cursor: context-menu;
    z-index: 3;
  }
  .fbv6__pet-inner {
    display: inline-block;
    font-size: 20px;
    line-height: 1;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));
    animation: fbv6-companion-bob 0.55s ease-in-out infinite;
  }
  .fbv6__pet::before {
    content: '';
    position: absolute;
    bottom: -3px; left: 50%;
    width: 18px; height: 3px;
    background: rgba(0,0,0,0.22); border-radius: 50%;
    transform: translateX(-50%);
  }
  .fbv6__pet-plate {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 200, 120, 0.5);
    border-radius: 2px;
    color: #fdf2d6;
    font-size: 10px; letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .fbv6__pet-plate strong {
    display: block;
    font-size: 11px;
    color: #ffd97a;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .fbv6__pet-sub {
    display: block;
    font-size: 9px;
    color: rgba(253, 242, 214, 0.7);
    margin-top: 1px;
  }
  .fbv6__pet:hover .fbv6__pet-plate {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .fbv6:has(.fbv6__sky[data-mode='night']) .fbv6__pet { animation-duration: 120s; }

  /* PEERS (v6.2) — other visitors' nouns walking ghost-translucent.
     Each runs the same 60s walk loop with a randomized animation-delay
     (set inline). No per-frame position sync — phase offset is local
     and the loop is identical on every client. */
  .fbv6__peers {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .fbv6__peer {
    position: absolute;
    bottom: 12px;
    left: 0;
    width: 28px; height: 28px;
    opacity: 0;
    animation:
      fbv6-walk 60s linear infinite,
      fbv6-peer-fadein 1.2s ease forwards;
    pointer-events: auto;
    cursor: help;
  }
  .fbv6__peer img {
    width: 28px; height: 28px;
    filter: grayscale(0.15) brightness(1.05) drop-shadow(0 1px 2px rgba(0,0,0,0.35));
    opacity: 0.55;
  }
  .fbv6__peer-shadow {
    position: absolute;
    bottom: -3px; left: 50%;
    width: 18px; height: 3px;
    background: rgba(0,0,0,0.18); border-radius: 50%;
    transform: translateX(-50%);
  }
  .fbv6__peer.is-leaving { animation-play-state: paused; opacity: 0; transition: opacity 0.8s ease; }
  .fbv6:has(.fbv6__sky[data-mode='night']) .fbv6__peer { animation-duration: 120s, 1.2s; }
  @keyframes fbv6-peer-fadein {
    from { opacity: 0; }
    to   { opacity: 0.78; }
  }

  /* AMBIENT EMOTES (v6.3) — small floating emoji that pop above any
     walker/pet/companion/peer. Inherits the parent's transform (the
     walk animation) so the emote rides along with whoever it's on. */
  .fbv6__emote {
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    font-size: 16px;
    line-height: 1;
    pointer-events: none;
    z-index: 10;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
    animation: fbv6-emote 2.4s ease-out forwards;
  }
  @keyframes fbv6-emote {
    0%   { opacity: 0; transform: translate(-50%, 4px); }
    15%  { opacity: 1; transform: translate(-50%, 0); }
    70%  { opacity: 1; transform: translate(-50%, -10px); }
    100% { opacity: 0; transform: translate(-50%, -18px); }
  }

  /* PET ADOPT/RELEASE TOAST */
  .fbv6__toast {
    position: absolute;
    top: -42px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 14px;
    background: rgba(0,0,0,0.78);
    border: 1px solid rgba(255, 200, 120, 0.5);
    border-radius: 3px;
    color: #fdf2d6;
    font-size: 11px; letter-spacing: 0.06em;
    white-space: nowrap;
    z-index: 5;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    animation: fbv6-toast 0.32s ease;
  }
  @keyframes fbv6-toast {
    from { opacity: 0; transform: translate(-50%, 8px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }

  /* RIGHT EDGE — chevron + ON AIR */
  .fbv6__edge {
    position: absolute;
    right: 12px; top: 50%;
    transform: translateY(-50%);
    display: flex; align-items: center; gap: 12px;
    z-index: 2;
  }
  .fbv6__on-air {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid rgba(255, 200, 120, 0.4);
    border-radius: 2px;
    color: #fdf2d6;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
  }
  .fbv6__on-air-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #2f8f5f;
    box-shadow: 0 0 6px rgba(47, 143, 95, 0.7);
    animation: fbv6-pulse 1.6s ease-in-out infinite;
  }
  @keyframes fbv6-pulse {
    0%, 100% { opacity: 0.8; }
    50%      { opacity: 1; }
  }
  .fbv6__on-air-label { font-size: 10px; letter-spacing: 0.18em; }

  .fbv6__chevron {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 5px 10px;
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid rgba(255, 200, 120, 0.4);
    border-radius: 2px;
    color: #fdf2d6;
    font-size: 11px; letter-spacing: 0.14em;
    text-decoration: none;
    transition: background 0.12s, border-color 0.12s;
  }
  .fbv6__chevron:hover {
    background: rgba(255, 200, 120, 0.18);
    border-color: rgba(255, 200, 120, 0.7);
  }

  /* Mobile: scale the whole scene down */
  @media (max-width: 640px) {
    .fbv6 { height: 64px; }
    .fbv6__walker img { width: 24px; height: 24px; }
    .fbv6__on-air-label { display: none; }
  }
</style>
