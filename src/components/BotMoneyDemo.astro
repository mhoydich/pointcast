---
import { DEMO_OFFERS } from '../lib/bot-money-demo.mjs';
const sample = DEMO_OFFERS.earn;
---

<section class="bm-demo" data-bot-money-demo aria-labelledby="bm-demo-title">
  <header class="bm-demo-head">
    <div>
      <p class="bm-eyebrow">TRY THE IDEA / 01</p>
      <h3 id="bm-demo-title">The Offer Desk.</h3>
    </div>
    <p>Useful work. Clear terms. <br />The final say stays with you.</p>
  </header>

  <p class="bm-sandbox-label"><span aria-hidden="true">◈</span> Design sandbox · No real funds · Demo credits have no cash value</p>
  <p class="bm-intro">Try earning, buying, or giving. Review exactly what is proposed before you approve a fictional record. No payment, account, message, or work happens here.</p>
  <noscript><p class="bm-nojs">JavaScript is needed for this local demonstration. The sample below is readable without it. No purchase is available here; the real free kit is elsewhere on this page.</p></noscript>

  <div class="bm-desk-grid">
    <div class="bm-workspace">
      <fieldset class="bm-scenarios" data-bm-controls disabled>
        <legend class="bm-eyebrow">1 / CHOOSE A SAMPLE</legend>
        <div class="bm-scenario-grid">
          <label class="bm-scenario"><input type="radio" name="bm-scenario" value="earn" checked /><span><span class="bm-scenario-name">Earn</span><span class="bm-scenario-note">Do useful work</span></span></label>
          <label class="bm-scenario"><input type="radio" name="bm-scenario" value="buy" /><span><span class="bm-scenario-name">Buy</span><span class="bm-scenario-note">Get something useful</span></span></label>
          <label class="bm-scenario"><input type="radio" name="bm-scenario" value="gift" /><span><span class="bm-scenario-name">Gift</span><span class="bm-scenario-note">Give a little value</span></span></label>
        </div>
      </fieldset>

      <div class="bm-sample">
        <div class="bm-sample-line"><p class="bm-eyebrow">FICTIONAL EXAMPLE</p><p class="bm-sample-price" data-bm-sample-price>+18 demo credits</p></div>
        <h4 data-bm-sample-title>{sample.title}</h4>
        <p data-bm-sample-summary>{sample.summary}</p>
        <p class="bm-sample-footnote" data-bm-sample-delivery>{sample.delivery}</p>
        <button type="button" class="bm-button bm-button-primary" data-bm-prepare disabled>Prepare demo proposal <span aria-hidden="true">↗</span></button>
      </div>
    </div>

    <aside class="bm-permissions" aria-labelledby="bm-permissions-title">
      <div class="bm-balance">
        <p class="bm-eyebrow">YOUR DEMO BALANCE</p>
        <p><span data-bm-balance>30</span> <span class="bm-balance-unit">credits</span></p>
        <span class="bm-balance-note">Made-up units. No cash value.</span>
      </div>
      <fieldset data-bm-controls disabled>
        <legend id="bm-permissions-title" class="bm-eyebrow">2 / SET YOUR PERMISSIONS</legend>
        <label class="bm-limit" for="bm-limit">Limit per purchase or gift <span class="bm-input-row"><input id="bm-limit" data-bm-limit type="number" min="5" max="30" step="1" value="20" required aria-describedby="bm-limit-help" /><span>demo credits</span></span></label>
        <p class="bm-small" id="bm-limit-help">Whole numbers, 5–30. Earning is not spending.</p>
        <label class="bm-check"><input type="checkbox" data-bm-buy checked /><span>Allow buying for myself</span></label>
        <label class="bm-check"><input type="checkbox" data-bm-gift /><span>Allow giving a gift</span></label>
        <p class="bm-small">Each proposal still needs your approval. A permission change clears the proposal.</p>
      </fieldset>
    </aside>
  </div>

  <p class="bm-status" data-bm-status role="status" aria-live="polite" aria-atomic="true">Choose a sample, then review its terms. Every action here is fictional.</p>

  <section class="bm-review" data-bm-review aria-labelledby="bm-review-title" hidden>
    <div class="bm-review-head"><div><p class="bm-eyebrow">3 / YOUR FINAL SAY</p><h4 id="bm-review-title" data-bm-review-heading tabindex="-1">Review the demo proposal</h4></div><p class="bm-review-price" data-bm-review-price></p></div>
    <dl class="bm-terms">
      <div><dt>Offer</dt><dd data-bm-term="title"></dd></div>
      <div><dt>Maker / seller</dt><dd data-bm-term="seller"></dd></div>
      <div><dt>Buyer / giver</dt><dd data-bm-term="buyer"></dd></div>
      <div><dt>Recipient</dt><dd data-bm-term="recipient"></dd></div>
      <div><dt>Deliverable</dt><dd data-bm-term="deliverable"></dd></div>
      <div><dt>Scope &amp; revisions</dt><dd data-bm-term="scope"></dd></div>
      <div><dt>Use &amp; license</dt><dd data-bm-term="license"></dd></div>
      <div><dt>Actual delivery</dt><dd data-bm-term="delivery"></dd></div>
      <div><dt>Your permission</dt><dd data-bm-term="approval"></dd></div>
    </dl>
    <p class="bm-policy-summary" data-bm-policy-summary></p>
    <p class="bm-blocked" data-bm-blocked hidden></p>
    <p class="bm-small">Approval applies only to this fictional example. It cannot authorize a real purchase or payment.</p>
    <div class="bm-review-actions"><button type="button" class="bm-button bm-button-primary" data-bm-approve disabled>Record demo approval</button><button type="button" class="bm-button" data-bm-decline disabled>Decline proposal</button></div>
  </section>

  <section class="bm-records" aria-labelledby="bm-records-title">
    <div class="bm-records-head"><div><p class="bm-eyebrow">A RECORD YOU CAN READ</p><h4 id="bm-records-title">Your demo notebook</h4></div><button type="button" class="bm-text-button" data-bm-reset disabled>Reset sandbox ↺</button></div>
    <p class="bm-records-empty" data-bm-empty>No demo records yet. Preparing or declining a proposal never changes the balance.</p>
    <ol class="bm-ledger" data-bm-ledger aria-label="Fictional records in order"></ol>
    <template data-bm-record-template><li class="bm-record"><div><p class="bm-record-kind" data-bm-record-kind></p><p class="bm-record-title" data-bm-record-title></p></div><div class="bm-record-numbers"><p data-bm-record-change></p><p class="bm-record-after" data-bm-record-after></p></div></li></template>
    <div class="bm-records-footer"><p>Stays in this open page. Refreshing or resetting clears it. A downloaded JSON record is fictional, not proof of purchase or earnings.</p><button type="button" class="bm-button" data-bm-download disabled>Download latest demo record (.json)</button></div>
  </section>
</section>

<script>
  import '../scripts/bot-money-demo';
</script>

<style>
  .bm-demo { --bm-paper: #f4f0e7; --bm-ink: #183e32; --bm-rust: #b74625; --bm-rule: #b7c1b4; color: var(--bm-ink); background: var(--bm-paper); border: 1px solid var(--bm-ink); font-family: 'Inter Variable', Inter, sans-serif; font-weight: 400; }
  .bm-demo * { box-sizing: border-box; }
  .bm-demo [hidden] { display: none !important; }
  .bm-demo p, .bm-demo h3, .bm-demo h4 { margin: 0; }
  .bm-demo h3, .bm-demo h4, .bm-demo strong { font-weight: 500; }
  .bm-demo-head { display: flex; justify-content: space-between; align-items: end; gap: 28px; padding: 32px; }
  .bm-eyebrow { font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .08em; line-height: 1.5; font-weight: 500; }
  .bm-demo-head h3 { font-size: clamp(32px, 5vw, 54px); letter-spacing: -.055em; line-height: 1.05; margin-top: 12px; }
  .bm-demo-head > p { font-size: 14px; line-height: 1.55; }
  .bm-sandbox-label { display: flex; gap: 12px; background: var(--bm-ink); color: var(--bm-paper); padding: 13px 32px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace; font-size: 11px; line-height: 1.7; }
  .bm-intro { padding: 22px 32px; font-size: 15px; line-height: 1.7; max-width: 800px; }
  .bm-nojs { padding: 16px 32px; border-bottom: 1px solid var(--bm-rule); color: var(--bm-rust); font-size: 14px; line-height: 1.6; }
  .bm-desk-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(250px, 1fr); border-top: 1px solid var(--bm-rule); }
  .bm-workspace { padding: 28px 32px; }
  .bm-demo fieldset { padding: 0; margin: 0; min-width: 0; border: 0; }
  .bm-demo legend { margin-bottom: 16px; }
  .bm-scenario-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .bm-scenario { display: flex; gap: 8px; align-items: start; padding: 14px 10px; border: 1px solid var(--bm-rule); cursor: pointer; }
  .bm-scenario:has(input:checked) { border-color: var(--bm-ink); background: #e4e9dd; }
  .bm-scenario-name { display: block; font-size: 17px; font-weight: 500; }
  .bm-scenario-note { display: block; font-size: 10px; margin-top: 6px; line-height: 1.45; }
  .bm-demo input[type='radio'], .bm-demo input[type='checkbox'] { width: 17px; height: 17px; flex: 0 0 17px; margin: 3px 0 0; accent-color: var(--bm-ink); cursor: pointer; }
  .bm-sample { padding-top: 27px; }
  .bm-sample-line { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
  .bm-sample-price { font-size: 12px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace; white-space: nowrap; color: var(--bm-rust); }
  .bm-sample h4 { font-size: 26px; line-height: 1.18; letter-spacing: -.035em; max-width: 360px; }
  .bm-sample > p { font-size: 14px; line-height: 1.7; margin-top: 14px; }
  .bm-sample > .bm-sample-footnote { font-size: 12px; line-height: 1.55; margin-top: 13px; }
  .bm-button { display: inline-flex; justify-content: center; gap: 18px; align-items: center; min-height: 44px; padding: 12px 16px; border: 1px solid var(--bm-ink); border-radius: 0; background: transparent; color: var(--bm-ink); font: inherit; font-size: 12px; line-height: 1.5; cursor: pointer; text-align: center; }
  .bm-button-primary { background: var(--bm-ink); color: var(--bm-paper); }
  .bm-sample > .bm-button { margin-top: 23px; width: 100%; justify-content: space-between; }
  .bm-button:hover:not(:disabled) { background: #dbe3d4; color: var(--bm-ink); }
  .bm-button-primary:hover:not(:disabled) { background: #285a48; color: var(--bm-paper); }
  .bm-demo button:disabled { cursor: not-allowed; opacity: .55; }
  .bm-demo :is(button, input, [tabindex]):focus-visible { outline: 3px solid var(--bm-rust); outline-offset: 4px; }
  .bm-permissions { border-left: 1px solid var(--bm-rule); padding: 28px; background: #eaeadd; }
  .bm-balance { border-bottom: 1px solid var(--bm-rule); padding-bottom: 22px; margin-bottom: 24px; }
  .bm-balance > p:nth-child(2) { margin-top: 8px; font-size: 66px; letter-spacing: -.06em; font-weight: 500; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .bm-balance-unit { font-size: 16px; font-weight: 400; letter-spacing: -.02em; }
  .bm-balance-note { display: block; font-size: 11px; margin-top: 8px; }
  .bm-limit { display: block; font-size: 13px; line-height: 1.5; }
  .bm-input-row { display: flex; gap: 12px; align-items: center; margin-top: 9px; font-size: 12px; }
  .bm-input-row input { width: 80px; padding: 10px; min-height: 44px; border: 1px solid var(--bm-ink); border-radius: 0; font: inherit; font-size: 16px; color: var(--bm-ink); background: var(--bm-paper); }
  .bm-demo .bm-small { font-size: 11px; line-height: 1.6; margin-top: 10px; }
  .bm-check { display: flex; gap: 10px; align-items: start; min-height: 44px; padding-top: 13px; font-size: 13px; line-height: 1.6; cursor: pointer; }
  .bm-demo .bm-status { padding: 16px 32px; border-top: 1px solid var(--bm-rule); border-bottom: 1px solid var(--bm-rule); background: #e4e9dd; font-size: 13px; line-height: 1.65; min-height: 55px; }
  .bm-review { padding: 28px 32px; border-bottom: 1px solid var(--bm-rule); }
  .bm-review-head { display: flex; gap: 16px; align-items: end; justify-content: space-between; margin-bottom: 22px; }
  .bm-review-head h4, .bm-records h4 { font-size: 22px; line-height: 1.25; letter-spacing: -.035em; margin-top: 7px; }
  .bm-review-price { font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace; font-size: 13px; text-align: right; }
  .bm-terms { margin: 0; border-top: 1px solid var(--bm-rule); }
  .bm-terms > div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; padding: 13px 0; border-bottom: 1px solid var(--bm-rule); font-size: 12px; line-height: 1.65; }
  .bm-terms dt { font-weight: 500; }
  .bm-terms dd { margin: 0; }
  .bm-demo .bm-policy-summary { margin-top: 18px; font-size: 12px; line-height: 1.6; }
  .bm-demo .bm-blocked { margin-top: 14px; padding: 12px; border: 1px solid var(--bm-rust); color: var(--bm-rust); font-size: 13px; line-height: 1.6; }
  .bm-review-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .bm-records { padding: 28px 32px; }
  .bm-records-head { display: flex; gap: 20px; justify-content: space-between; align-items: start; }
  .bm-text-button { padding: 8px 0; min-height: 44px; background: transparent; border: 0; border-radius: 0; color: var(--bm-ink); font: inherit; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .bm-demo .bm-records-empty { font-size: 13px; line-height: 1.7; margin-top: 22px; }
  .bm-ledger { padding: 0; margin: 20px 0 0; list-style: none; }
  .bm-record { display: flex; justify-content: space-between; gap: 18px; padding: 14px 0; border-top: 1px solid var(--bm-rule); }
  .bm-record-kind { font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .03em; }
  .bm-demo .bm-record-title { font-size: 13px; line-height: 1.5; margin-top: 6px; }
  .bm-record-numbers { text-align: right; white-space: nowrap; font-size: 13px; font-variant-numeric: tabular-nums; }
  .bm-demo .bm-record-after { font-size: 10px; margin-top: 8px; }
  .bm-records-footer { display: flex; gap: 24px; align-items: center; justify-content: space-between; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--bm-rule); }
  .bm-records-footer > p { max-width: 350px; font-size: 11px; line-height: 1.65; }
  .bm-records-footer .bm-button { flex-shrink: 0; max-width: 270px; }
  @media (max-width: 740px) {
    .bm-demo-head { align-items: start; flex-direction: column; gap: 16px; padding: 24px; }
    .bm-demo-head > p br { display: none; }
    .bm-sandbox-label, .bm-intro, .bm-demo .bm-status { padding-left: 24px; padding-right: 24px; }
    .bm-desk-grid { grid-template-columns: 1fr; }
    .bm-workspace, .bm-permissions, .bm-review, .bm-records { padding: 24px; }
    .bm-permissions { border-left: 0; border-top: 1px solid var(--bm-rule); }
    .bm-balance { display: grid; grid-template-columns: 1fr auto; align-items: center; }
    .bm-balance > p:nth-child(2) { grid-column: 2; grid-row: 1 / 3; font-size: 50px; margin-top: 0; }
    .bm-balance-note { grid-column: 1; }
    .bm-terms > div { grid-template-columns: 110px minmax(0, 1fr); gap: 14px; }
    .bm-records-footer { align-items: start; flex-direction: column; gap: 16px; }
    .bm-records-footer .bm-button { max-width: none; width: 100%; }
  }
  @media (max-width: 420px) {
    .bm-workspace, .bm-permissions, .bm-review, .bm-records { padding: 20px 16px; }
    .bm-demo-head, .bm-sandbox-label, .bm-intro, .bm-demo .bm-status { padding-left: 16px; padding-right: 16px; }
    .bm-scenario { flex-direction: column; padding: 12px 9px; gap: 9px; }
    .bm-scenario-note { min-height: 29px; }
    .bm-sample-line { gap: 8px; align-items: start; flex-direction: column; }
    .bm-review-head { flex-direction: column; align-items: start; }
    .bm-terms > div { grid-template-columns: 1fr; gap: 4px; }
    .bm-records-head { flex-direction: column; gap: 8px; }
    .bm-balance { grid-template-columns: 1fr; }
    .bm-balance > p:nth-child(2) { grid-column: 1; grid-row: 2; margin-top: 8px; }
    .bm-review-actions > .bm-button { width: 100%; }
  }
</style>
