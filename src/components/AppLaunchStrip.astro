---

<section class="app-launch" aria-labelledby="app-launch-title">
  <div class="app-launch__head">
    <p class="app-launch__kicker">APP INDEX / NOW ON THE FRONT DOOR</p>
    <h2 id="app-launch-title">Open the room you came for.</h2>
  </div>

  <nav class="app-launch__board" aria-label="PointCast app shortcuts">
    {HOME_APPS.map((app) => (
      <a class="app-launch__pill" href={app.href}>
        <span class="app-launch__name">{app.name}</span>
        <span class="app-launch__detail">{app.detail}</span>
      </a>
    ))}
  </nav>
</section>

<style>
  .app-launch {
    margin: 18px 0 28px;
    padding: 6px 0 0;
    background: #fff;
  }

  .app-launch__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin: 0 0 14px;
    flex-wrap: wrap;
  }

  .app-launch__kicker,
  .app-launch__name,
  .app-launch__detail {
    font-family: var(--pc-font-mono, var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace));
    text-transform: uppercase;
  }

  .app-launch__kicker {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0;
    color: #8aa6cb;
  }

  .app-launch h2 {
    margin: 0;
    font-size: 30px;
    line-height: 1.05;
    font-weight: 500;
    color: #141414;
  }

  .app-launch__board {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 12px;
    align-items: center;
  }

  .app-launch__pill {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0 24px;
    border: 3px solid #171717;
    border-radius: 999px;
    background: #fff;
    color: #145aa4;
    text-decoration: none;
    box-sizing: border-box;
    box-shadow: 0 1px 0 rgba(20, 20, 20, 0.08);
    transition: transform 120ms ease, background-color 120ms ease, border-color 120ms ease;
  }

  .app-launch__pill:hover,
  .app-launch__pill:focus-visible {
    background: #f7fbff;
    border-color: #145aa4;
    transform: translateY(-1px);
    text-decoration: none;
    outline: none;
  }

  .app-launch__name {
    white-space: nowrap;
    font-size: 18px;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 800;
  }

  .app-launch__detail {
    min-width: 0;
    color: #95aed2;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .app-launch {
      margin-top: 12px;
    }

    .app-launch__board {
      gap: 10px;
    }

    .app-launch__pill {
      width: 100%;
      min-height: 46px;
      justify-content: space-between;
      padding: 0 16px;
      gap: 10px;
    }

    .app-launch__name {
      font-size: 15px;
      letter-spacing: 0;
    }

    .app-launch__detail {
      font-size: 11px;
      letter-spacing: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
