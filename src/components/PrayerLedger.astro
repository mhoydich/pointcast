---
interface Props {
  station: 'still-light' | 'remembering';
  label: string;
}
const { station, label } = Astro.props;
---
<section class="prayer-ledger" data-prayer-ledger data-station={station} aria-label="A shared moment">
  <p class="ledger-eyebrow">A shared moment</p>
  <h2>Held together, quietly.</h2>
  <p data-ledger-count role="status">Looking for the shared count…</p>
  <details>
    <summary>About these counts</summary>
    <p data-ledger-altar>The current week's drum altar count is loading.</p>
    <p>These are separate PointCast ledgers, not a count across all sites. Counts are approximate and may lag. The prayer count can include candle activity; the counts are not added together.</p>
  </details>
  <button type="button" data-ledger-offer disabled>{label}</button>
  <p class="ledger-privacy">Optional. Only the station and a temporary random session ID are sent; names and personal words stay on this page. One offering per visit.</p>
  <p data-ledger-status role="status" aria-live="polite"></p>
</section>
<script>
  import { initializePrayerLedgers } from '../lib/prayer-ledger-client';
  initializePrayerLedgers();
  document.addEventListener('astro:page-load', initializePrayerLedgers);
</script>
<style>
  .prayer-ledger { padding: clamp(1.3rem, 4vw, 2.4rem); border: 1px solid #d4c5ab; border-radius: 1rem; background: #f8f3e8; color: #342e26; overflow-wrap: anywhere; }
  .ledger-eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; font-weight: 700; }
  h2 { margin: .4rem 0 .7rem; font-size: clamp(1.55rem, 4vw, 2.2rem); line-height: 1.12; }
  p { line-height: 1.55; }
  details { margin: 1rem 0; font-size: .9rem; }
  summary { cursor: pointer; text-decoration: underline; text-underline-offset: .2em; }
  button { border: 0; border-radius: 999px; padding: .85rem 1.2rem; background: #493f32; color: #fffaf0; font: inherit; font-weight: 700; cursor: pointer; min-height: 44px; }
  button:focus-visible, summary:focus-visible { outline: 3px solid #9b672e; outline-offset: 3px; }
  button:disabled { opacity: .65; cursor: default; }
  .ledger-privacy, [data-ledger-status] { font-size: .85rem; }
</style>
