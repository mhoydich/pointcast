---
import { SHOPPING_ITEMS, shoppingLabel } from '../lib/shopping';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class="shopping-pocket" id="shopping-pocket" aria-labelledby="shopping-title" data-shopping-root data-shopping-default={compact ? "saved" : "all"}>
  <div class="shopping-intro"><div><p class="kicker">POINTCAST POCKET · THE EXTRA CHAIR</p><h2 id="shopping-title">A little room for your finds.</h2><p>Shop the study. Save a few possibilities. Come back when you’re ready.</p></div><a href={compact ? "/beach-commons/v19#shopping-pocket" : "/me#shopping-pocket"}>{compact ? "Explore the study ↗" : "My PointCast ↗"}</a></div>
  <p class="pocket-note" data-pocket-storage>Saved on this browser, shared across PointCast pages. No sign-in needed. This list is not synced to your profile.</p>
  <p class="pocket-status" role="status" data-pocket-status></p>
  <details open={compact} data-shopping-details>
    <summary>Shop this study <span data-pocket-count>· 0 saved</span></summary>
    <div class="shopping-tools" hidden data-shopping-tools role="group" aria-label="Shopping view"><button type="button" data-shopping-filter="all" aria-pressed="true">All 12</button><button type="button" data-shopping-filter="saved" aria-pressed="false">My saved finds</button><button type="button" data-pocket-clear>Clear saved list</button></div>
    <p class="pocket-note">USD prices checked September 15, 2026. Choose options and confirm current stock, tax and shipping with the merchant. Each link opens their store in a new tab.</p>
    <div class="shopping-grid">
      {SHOPPING_ITEMS.map(item => <article data-shopping-item={item.id}>
        <p class="maker">{item.maker} <span>{item.priceLabel}</span></p><h3>{item.name}</h3>
        <p>{item.role} · {item.weight}</p>
        <div class="shopping-actions"><a href={item.url} target="_blank" rel="noopener noreferrer" data-shop-link={item.id}>{shoppingLabel(item.id)} ↗</a><button type="button" hidden data-pocket-save={item.id} aria-label={`Save ${item.name}`} aria-pressed="false">Save</button></div>
        <a class="research" data-shopping-specs href={`/beach-commons/v19#${item.id}`}>Specs & things to know ↓</a>
      </article>)}
    </div>
    <p hidden data-pocket-empty>No saved finds yet. Tap Save on something you’d like to come back to.</p>
    <p class="pocket-note">Shopping links are direct, with no affiliate commission currently configured. PointCast counts outbound shopping clicks without storing your identity. Clicks do not confirm a purchase. <a href="/api/shopping-metrics">Attribution status ↗</a></p>
  </details>
  <noscript><p>Shopping links work without JavaScript. Enable it to save a list on this browser.</p></noscript>
</section>
<script>
  import { initShoppingPocket } from '../scripts/shopping-pocket';
  initShoppingPocket();
  document.addEventListener('astro:page-load', initShoppingPocket);
</script>
<style>
  .shopping-pocket{background:#f4f0e7;color:#183d46;padding:clamp(22px,4vw,48px);margin:32px auto;border:1px solid #183d4633;max-width:1130px;box-sizing:border-box;scroll-margin-top:30px;font-family:Arial,sans-serif}.shopping-intro{display:flex;justify-content:space-between;gap:24px;align-items:start}.shopping-intro>a{font-size:12px;white-space:nowrap}.kicker{font-size:10px;letter-spacing:.13em;font-weight:700}.shopping-pocket h2{font:400 clamp(28px,4vw,46px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:14px 0}.shopping-pocket p{line-height:1.6}.pocket-note{font-size:12px;max-width:820px}.pocket-status{font-size:13px;min-height:1.5em}.shopping-pocket a{color:inherit;text-underline-offset:4px}.shopping-pocket summary{font-size:18px;font-weight:700;cursor:pointer;padding:20px 0;border-block:1px solid #183d4633}.shopping-pocket summary span{font-size:13px;font-weight:400}.shopping-tools{display:flex;gap:10px;flex-wrap:wrap;padding:20px 0 0}.shopping-pocket button{font:inherit;font-size:12px;cursor:pointer;border:1px solid #183d4655;padding:12px 16px;background:transparent;color:inherit;border-radius:24px;min-height:44px}.shopping-pocket button[aria-pressed=true]{background:#183d46;color:#fff}.shopping-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.shopping-grid article{padding:22px;background:#fffcf5;border:1px solid #183d4622;min-width:0}.maker{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12px;font-weight:700}.maker span{color:#92452b}.shopping-grid h3{font-size:21px;margin:12px 0}.shopping-grid p:not(.maker){font-size:12px}.shopping-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:18px 0}.shopping-actions a{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;background:#183d46;color:#fff;font-size:13px;text-decoration:none;border-radius:4px}.research{font-size:12px}.shopping-pocket [hidden]{display:none!important}.shopping-pocket :focus-visible{outline:3px solid #ae5336;outline-offset:4px}@media(max-width:620px){.shopping-intro{display:block}.shopping-grid{grid-template-columns:1fr}.shopping-pocket{margin:20px 18px;padding:22px}.shopping-intro>a{display:inline-block;margin:8px 0}}
</style>
