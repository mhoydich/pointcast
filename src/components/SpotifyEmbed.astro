---
interface Props {
  kind: 'track' | 'playlist' | 'album' | 'artist' | 'episode' | 'show';
  spotifyId: string;
  height?: number;
  accent?: string;
  placeholderLabel?: string;
}

const {
  kind,
  spotifyId,
  height = 352,
  accent = '#c46734',
  placeholderLabel = 'Open in Spotify',
} = Astro.props;

const validKind = ['track', 'playlist', 'album', 'artist', 'episode', 'show'].includes(kind) ? kind : null;
const embedSrc = validKind ? `https://open.spotify.com/embed/${kind}/${spotifyId}?utm_source=generator` : null;
---

<figure class="spotify-embed" style={`--accent:${accent}`}>
  {embedSrc ? (
    <div class="spotify-embed__frame">
      <iframe
        src={embedSrc}
        width="100%"
        height={height}
        frameborder="0"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        title={`Spotify ${kind}`}
      ></iframe>
    </div>
  ) : (
    <div class="spotify-embed__placeholder">
      <p>{placeholderLabel}</p>
    </div>
  )}
</figure>

<style>
  .spotify-embed {
    margin: 0;
  }

  .spotify-embed__frame,
  .spotify-embed__placeholder {
    border: 2px solid #1a1208;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 6px 6px 0 0 var(--accent);
    background: #f8f4ec;
  }

  .spotify-embed__placeholder {
    min-height: 120px;
    display: grid;
    place-items: center;
    color: #5F5E5A;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    padding: 1rem;
    text-align: center;
  }

  iframe {
    display: block;
    width: 100%;
    border: 0;
  }
</style>
