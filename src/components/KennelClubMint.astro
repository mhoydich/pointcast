---
import { KENNEL_CLUB_CONTRACT, KENNEL_CLUB_PRICE_MUTEZ } from '../lib/kennel-club-mint';

interface Props { tokenId: number; }
const { tokenId } = Astro.props;
---

<section class="kennel-mint" data-kennel-mint data-contract={KENNEL_CLUB_CONTRACT} data-token-id={tokenId} data-price-mutez={KENNEL_CLUB_PRICE_MUTEZ}>
  <div class="kennel-mint__action">
    <button class="kennel-mint__button" type="button" data-kennel-mint-button data-kennel-mint-default="Mint today&apos;s sitting · 1 ꜩ">Mint today&apos;s sitting · 1 ꜩ</button>
    <span class="kennel-mint__wallet" data-kennel-mint-wallet hidden></span>
  </div>
  <p class="kennel-mint__state" data-kennel-mint-state role="status" aria-live="polite">Checking mint state…</p>
</section>

<script>
  type MintState = { paused: boolean; today: { tokenId: number; windowOpen: boolean; minted: number }; live?: boolean };
  const MINT_LIVE_URL = 'https://pointcast.xyz/api/kennel-club/mint';
  const POLL_MS = 5_000;
  const POLL_TRIES = 12;

  function describe(state: MintState): string {
    if (state.paused) return 'paused — opens when the admin unpauses';
    if (!state.today.windowOpen) return 'window closed';
    return `minting open · ${state.today.minted} minted`;
  }

  function sittingName(root: HTMLElement): string {
    return `Sitting ${String(Number(root.dataset.tokenId || 0) + 1).padStart(2, '0')}`;
  }

  function shortAddress(address: string): string {
    return `${address.slice(0, 6)}…${address.slice(-4)}`;
  }

  function setText(root: HTMLElement, text: string): void {
    root.querySelector<HTMLElement>('[data-kennel-mint-state]')?.replaceChildren(text);
  }

  function setTzktState(root: HTMLElement, text: string, href: string, linkText: string): void {
    const state = root.querySelector<HTMLElement>('[data-kennel-mint-state]');
    if (!state) return;
    const link = document.createElement('a');
    link.href = href;
    link.target = '_blank';
    link.rel = 'noopener';
    link.textContent = linkText;
    state.replaceChildren(text, ' · ', link);
  }

  function mintError(error: unknown): string {
    const raw = String((error as any)?.message || (error as any)?.errorType || error || 'mint failed');
    if (/reject|cancel|abort/i.test(raw)) return 'wallet rejected';
    if (/window.*closed|closed.*window/i.test(raw)) return 'mint window closed';
    if (/wrong.*amount|amount.*wrong|bad.?amount/i.test(raw)) return 'wrong amount';
    return raw.slice(0, 160);
  }

  async function readState(root: HTMLElement): Promise<MintState> {
    const tokenId = Number(root.dataset.tokenId || 0);
    const response = await fetch(MINT_LIVE_URL);
    if (!response.ok) throw new Error(`mint state read failed (${response.status})`);
    const payload = await response.json() as MintState;
    if (payload.today?.tokenId !== tokenId) throw new Error('mint state is for a different sitting');
    return payload;
  }

  async function refresh(root: HTMLElement): Promise<MintState | null> {
    const button = root.querySelector<HTMLButtonElement>('[data-kennel-mint-button]');
    if (!button) return null;
    try {
      const result = await readState(root);
      root.dataset.kennelMinted = String(result.today.minted);
      if (root.dataset.kennelMintFeedback !== 'confirmed') setText(root, describe(result));
      button.disabled = result.paused || !result.today.windowOpen || root.dataset.kennelAlreadyMinted === 'true';
      return result;
    } catch {
      setText(root, 'mint state unavailable — try again shortly');
      button.disabled = true;
      return null;
    }
  }

  async function refreshWallet(root: HTMLElement, address?: string | null): Promise<void> {
    const chip = root.querySelector<HTMLElement>('[data-kennel-mint-wallet]');
    const button = root.querySelector<HTMLButtonElement>('[data-kennel-mint-button]');
    let activeAddress = address;
    if (activeAddress === undefined) {
      try {
        const { getActiveAddress } = await import('../lib/tezos');
        activeAddress = await getActiveAddress();
      } catch {
        activeAddress = null;
      }
    }
    if (!activeAddress) {
      root.dataset.kennelAlreadyMinted = 'false';
      chip?.setAttribute('hidden', '');
      if (button && root.dataset.kennelMintFeedback !== 'confirmed') {
        button.textContent = button.dataset.kennelMintDefault || 'Mint today’s sitting · 1 ꜩ';
        await refresh(root);
      }
      return;
    }
    if (chip) {
      chip.textContent = `connected · ${shortAddress(activeAddress)}`;
      chip.removeAttribute('hidden');
    }
    try {
      const { walletHoldsKennelClubSitting } = await import('../lib/kennel-club-mint');
      const holdsToday = await walletHoldsKennelClubSitting(Number(root.dataset.tokenId || 0), activeAddress);
      root.dataset.kennelAlreadyMinted = String(holdsToday);
      if (holdsToday) {
        if (root.dataset.kennelMintFeedback !== 'confirmed') setText(root, 'already minted by you');
        if (button && root.dataset.kennelMintFeedback !== 'confirmed') {
          button.disabled = true;
          button.textContent = 'Already minted';
        }
      } else if (button && root.dataset.kennelMintFeedback !== 'confirmed') {
        button.textContent = button.dataset.kennelMintDefault || 'Mint today’s sitting · 1 ꜩ';
        await refresh(root);
      }
    } catch {
      // The availability state remains useful when TzKT is momentarily behind.
    }
  }

  async function pollMinted(root: HTMLElement, target: number): Promise<void> {
    for (let attempt = 0; attempt < POLL_TRIES; attempt += 1) {
      await new Promise((resolve) => window.setTimeout(resolve, POLL_MS));
      try {
        const result = await readState(root);
        root.dataset.kennelMinted = String(result.today.minted);
        if (result.today.minted >= target) return;
      } catch {
        // Keep the confirmed receipt visible and use the next five-second poll.
      }
    }
  }

  async function emitMintBurst(root: HTMLElement, opHash: string): Promise<void> {
    let address = '';
    try {
      const { getActiveAddress } = await import('../lib/tezos');
      address = await getActiveAddress() || '';
    } catch {}
    for (let attempt = 0; attempt < 5; attempt += 1) {
      try {
        const response = await fetch('/api/burst', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            kind: 'mint',
            clientId: address || `mint:${opHash}`,
            by: { handle: address || 'collector' },
            meta: {
              opHash,
              tokenId: Number(root.dataset.tokenId || 0),
              label: sittingName(root),
              color: '#8a2432',
            },
          }),
        });
        if (response.ok) return;
        if (response.status !== 409 && response.status !== 503) return;
      } catch {}
      await new Promise((resolve) => window.setTimeout(resolve, 2_000));
    }
  }

  function initialize(root: HTMLElement): void {
    if (root.dataset.kennelMintReady === 'true') return;
    root.dataset.kennelMintReady = 'true';
    void refresh(root);
    void refreshWallet(root);
  }

  document.querySelectorAll<HTMLElement>('[data-kennel-mint]').forEach(initialize);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-kennel-mint]').forEach(initialize);
  });
  window.addEventListener('pc:wallet-change', (event) => {
    const address = (event as CustomEvent<{ address?: string } | null>).detail?.address ?? null;
    document.querySelectorAll<HTMLElement>('[data-kennel-mint]').forEach((root) => void refreshWallet(root, address));
  });

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-kennel-mint-button]');
    const root = button?.closest<HTMLElement>('[data-kennel-mint]');
    if (!button || !root || button.disabled) return;
    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Confirm in Kukai…';
    setText(root, 'Confirm in Kukai…');
    try {
      const { mintKennelClubSitting } = await import('../lib/tezos');
      const operation = await mintKennelClubSitting({
        contract: root.dataset.contract || '',
        tokenId: Number(root.dataset.tokenId || 0),
        priceMutez: Number(root.dataset.priceMutez || 1_000_000),
      });
      const href = `https://tzkt.io/${operation.opHash}`;
      setTzktState(root, 'Broadcast · waiting for 1 confirmation', href, 'View on TzKT');
      await operation.confirmation;
      const target = Number(root.dataset.kennelMinted || 0) + 1;
      root.dataset.kennelMintFeedback = 'confirmed';
      root.dataset.kennelMinted = String(target);
      setTzktState(root, `You minted ${sittingName(root)} · ${target} minted`, href, 'view on TzKT');
      button.textContent = 'Minted';
      void emitMintBurst(root, operation.opHash);
      void refreshWallet(root);
      void pollMinted(root, target);
    } catch (error) {
      setText(root, `Mint failed · ${mintError(error)}`);
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>

<style>
  .kennel-mint { display: grid; gap: 7px; margin-top: 22px; padding-top: 13px; border-top: 1px solid var(--pc-ink); }
  .kennel-mint__action { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .kennel-mint__button { width: fit-content; border: 1px solid var(--club, #8A2432); background: var(--club, #8A2432); color: #fff; padding: 10px 12px; cursor: pointer; font: 500 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .kennel-mint__button:disabled { cursor: not-allowed; opacity: .55; }
  .kennel-mint__wallet { border: 1px solid color-mix(in srgb, var(--club, #8A2432), transparent 55%); color: var(--club, #8A2432); padding: 6px 8px; font: 500 9px var(--pc-font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .kennel-mint__state { margin: 0; color: var(--pc-ink-soft); font: 400 10px var(--pc-font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .kennel-mint__state a { color: var(--club, #8A2432); }
</style>
