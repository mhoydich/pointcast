---
import { KENNEL_CLUB_CONTRACT, KENNEL_CLUB_PRICE_MUTEZ } from '../lib/kennel-club-mint';

interface Props { tokenId: number; }
const { tokenId } = Astro.props;
---

<section class="kennel-mint" data-kennel-mint data-contract={KENNEL_CLUB_CONTRACT} data-token-id={tokenId} data-price-mutez={KENNEL_CLUB_PRICE_MUTEZ}>
  <button class="kennel-mint__button" type="button" data-kennel-mint-button>Mint today&apos;s sitting · 1 ꜩ</button>
  <p class="kennel-mint__state" data-kennel-mint-state role="status" aria-live="polite">Checking mint state…</p>
</section>

<script>
  type MintState = { paused: boolean; today: { tokenId: number; windowOpen: boolean; minted: number } };
  const TZKT = 'https://api.tzkt.io';

  function describe(state: MintState): string {
    if (state.paused) return 'paused — opens when the admin unpauses';
    if (!state.today.windowOpen) return 'window closed';
    return `minting open · ${state.today.minted} minted`;
  }

  async function readState(root: HTMLElement): Promise<MintState> {
    const contract = root.dataset.contract || '';
    const tokenId = Number(root.dataset.tokenId || 0);
    const storageResponse = await fetch(`${TZKT}/v1/contracts/${contract}/storage`);
    if (!storageResponse.ok) throw new Error(`TzKT storage read failed (${storageResponse.status})`);
    const storage = await storageResponse.json();
    const [supplyResponse, windowResponse] = await Promise.all([
      fetch(`${TZKT}/v1/bigmaps/${storage.supply}/keys?key=${tokenId}`),
      fetch(`${TZKT}/v1/bigmaps/${storage.windows}/keys?key=${tokenId}`),
    ]);
    const supplyRows = supplyResponse.status === 204 ? [] : await supplyResponse.json();
    const windowRows = windowResponse.status === 204 ? [] : await windowResponse.json();
    const window = windowRows[0]?.value;
    const now = Date.now();
    const windowOpen = Boolean(window?.open_at && window?.close_at && now >= Date.parse(window.open_at) && now < Date.parse(window.close_at));
    return { paused: Boolean(storage.paused), today: { tokenId, windowOpen, minted: Number(supplyRows[0]?.value || 0) } };
  }

  async function refresh(root: HTMLElement): Promise<MintState | null> {
    const button = root.querySelector<HTMLButtonElement>('[data-kennel-mint-button]');
    const state = root.querySelector<HTMLElement>('[data-kennel-mint-state]');
    if (!button || !state) return null;
    try {
      const result = await readState(root);
      state.textContent = describe(result);
      button.disabled = result.paused || !result.today.windowOpen;
      return result;
    } catch {
      state.textContent = 'mint state unavailable — try again shortly';
      button.disabled = true;
      return null;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-kennel-mint]').forEach((root) => void refresh(root));

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-kennel-mint-button]');
    const root = button?.closest<HTMLElement>('[data-kennel-mint]');
    if (!button || !root || button.disabled) return;
    const state = root.querySelector<HTMLElement>('[data-kennel-mint-state]');
    const original = button.textContent;
    button.disabled = true;
    if (state) state.textContent = 'connecting wallet…';
    try {
      const { mintKennelClubSitting } = await import('../lib/tezos');
      const operation = await mintKennelClubSitting({
        contract: root.dataset.contract || '',
        tokenId: Number(root.dataset.tokenId || 0),
        priceMutez: Number(root.dataset.priceMutez || 1_000_000),
      });
      const href = `https://tzkt.io/${operation.opHash}`;
      if (state) state.innerHTML = `broadcast <a href="${href}" target="_blank" rel="noopener">${operation.opHash}</a> · confirming…`;
      await operation.confirmation;
      if (state) state.innerHTML = `confirmed <a href="${href}" target="_blank" rel="noopener">view on TzKT</a> · refreshing count…`;
      await refresh(root);
    } catch (error: any) {
      const message = String(error?.message || error?.errorType || error);
      if (state) state.textContent = /reject|cancel|abort/i.test(message) ? 'mint cancelled' : `mint error: ${message.slice(0, 160)}`;
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>

<style>
  .kennel-mint { display: grid; gap: 7px; margin-top: 22px; padding-top: 13px; border-top: 1px solid var(--pc-ink); }
  .kennel-mint__button { width: fit-content; border: 1px solid var(--club, #8A2432); background: var(--club, #8A2432); color: #fff; padding: 10px 12px; cursor: pointer; font: 500 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .kennel-mint__button:disabled { cursor: not-allowed; opacity: .55; }
  .kennel-mint__state { margin: 0; color: var(--pc-ink-soft); font: 400 10px var(--pc-font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .kennel-mint__state a { color: var(--club, #8A2432); }
</style>
