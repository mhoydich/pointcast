---
/**
 * The frame for the shop's agent rooms (/shop/agents, /shop/clerk, /shop/wants,
 * /shop/haggle): masthead, room tabs and the shared specimen-sheet styles.
 * Styles are global under .agent-shop because every room renders nodes from JS.
 */
interface Props { room: 'agents' | 'clerk' | 'wants' | 'haggle' }
const { room } = Astro.props;
const rooms = [
  { id: 'agents', href: '/shop/agents', label: 'Why' },
  { id: 'clerk', href: '/shop/clerk', label: 'The Clerk' },
  { id: 'wants', href: '/shop/wants', label: 'Want Ads' },
  { id: 'haggle', href: '/shop/haggle', label: 'Haggle Counter' },
];
---
<div class="agent-shop">
  <nav class="as-mast" aria-label="PointCast Shop">
    <a class="as-home" href="/">POINTCAST<span> / THE SHOP’S AGENTS</span></a>
    <a href="/shop/front">Shop ↗</a>
  </nav>
  <nav class="as-rooms" aria-label="The shop's agents">
    {rooms.map((r) => <a href={r.href} aria-current={r.id === room ? 'page' : undefined}>{r.label}</a>)}
  </nav>
  <main class="as-main"><slot /></main>
  <footer class="as-foot">
    <p>No ads, no commission, no paid ranking. House offers are labeled. Every answer is dated, and the Clerk signs its answers with the PointCast treasury key (<a href="/api/x402/keys">verify ↗</a>).</p>
    <p><a href="/shop/front">The PointCast Shop</a> · <a href="/shop/agents">Why the shop has agents</a> · <a href="/llms.txt">llms.txt</a> · MCP: <code>shop_clerk</code>, <code>wants_board</code>, <code>wants_post</code>, <code>wants_offer</code>, <code>haggle_shelf</code>, <code>haggle_offer</code></p>
  </footer>
</div>
<style is:global>
  body{margin:0;background:#e9e9e4;color:#111}
  .agent-shop{--ink:#111;--paper:#e9e9e4;--card:#f4f4f0;--cobalt:#1f3fe0;--sun:#f6d615;--red:#e8401c;--line:#b9b9b1;--muted:#4a4a44;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);overflow-x:hidden}
  .agent-shop *{box-sizing:border-box}
  .agent-shop a{color:inherit}
  .as-mast{display:flex;gap:22px;align-items:center;padding:20px 5vw;border-bottom:1px solid var(--ink);font-size:12px;font-weight:800}
  .as-mast a{text-decoration:none}.as-home{margin-right:auto;font-size:19px;letter-spacing:-1px}.as-home span{font-size:11px;letter-spacing:1px;margin-left:10px;color:var(--cobalt)}
  .as-rooms{display:flex;gap:6px;flex-wrap:wrap;padding:12px 5vw;border-bottom:1px solid var(--ink);background:#fff}
  .as-rooms a{font:700 12px/1 Arial;text-decoration:none;padding:12px 16px;border:1px solid var(--ink);border-radius:30px;min-height:40px;display:inline-flex;align-items:center}
  .as-rooms a[aria-current=page]{background:var(--cobalt);border-color:var(--cobalt);color:#fff}
  .as-main{max-width:1280px;margin:0 auto;padding:0 5vw 60px}
  .as-foot{background:var(--ink);color:var(--paper);padding:34px 5vw;font-size:13px;line-height:1.7}
  .as-foot p{max-width:900px;margin:0 0 8px}.as-foot code{font-size:12px}
  .agent-shop .eyebrow{font:700 11px/1.6 monospace;letter-spacing:1.7px;text-transform:uppercase;margin:0 0 14px;color:var(--cobalt)}
  .agent-shop h1{font-size:clamp(52px,7vw,104px);line-height:.9;letter-spacing:-.06em;margin:20px 0 22px}
  .agent-shop h1 em,.agent-shop h2 em{font-family:Georgia,serif;font-weight:400;color:var(--cobalt)}
  .agent-shop h2{font-size:clamp(30px,4vw,52px);line-height:1.02;letter-spacing:-.04em;margin:0 0 20px}
  .agent-shop h3{font-size:22px;letter-spacing:-.5px;margin:0 0 8px}
  .agent-shop .dek{font-size:20px;line-height:1.45;max-width:40ch}
  .agent-shop .fine{font-size:12px;line-height:1.6;color:var(--muted)}
  .agent-shop .mono{font-family:monospace}
  .as-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;padding:46px 0 40px;border-bottom:1px solid var(--ink)}
  .as-hero figure{margin:0;background:#fff;border:1px solid var(--ink);padding:18px}
  .as-hero img{width:100%;height:auto;display:block}
  .as-hero figcaption{font:10px monospace;letter-spacing:1px;margin-top:12px;text-align:center}
  .as-section{padding:44px 0;border-bottom:1px solid var(--line)}
  .as-section:last-child{border-bottom:0}
  .as-panel{background:#fff;border:1px solid var(--ink);padding:22px}
  .as-grid2{display:grid;grid-template-columns:1fr 1fr;gap:28px}
  .as-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .agent-shop form{display:grid;gap:12px}
  .agent-shop label{display:grid;gap:6px;font:700 11px/1.4 monospace;letter-spacing:1px;text-transform:uppercase}
  .agent-shop input,.agent-shop textarea,.agent-shop select{font:16px/1.4 Arial;padding:12px;border:1px solid var(--ink);background:#fff;color:var(--ink);width:100%;border-radius:0}
  .agent-shop textarea{min-height:90px;resize:vertical}
  .agent-shop button,.agent-shop .btn{font:700 14px Arial;cursor:pointer;padding:14px 20px;border:1px solid var(--ink);background:var(--sun);color:var(--ink);min-height:48px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px}
  .agent-shop button.ghost{background:transparent}.agent-shop button:disabled{opacity:.5;cursor:wait}
  .agent-shop button:hover,.agent-shop .btn:hover{background:#fff}
  .agent-shop .chips{display:flex;flex-wrap:wrap;gap:8px}
  .agent-shop .chip{font:700 12px Arial;padding:10px 14px;border:1px solid var(--ink);border-radius:30px;background:transparent;cursor:pointer;min-height:40px}
  .agent-shop .chip:hover{background:var(--sun)}
  .agent-shop pre{background:var(--ink);color:#e9e9e4;padding:16px;overflow:auto;font:12px/1.6 monospace;margin:0;white-space:pre-wrap;word-break:break-word}
  .agent-shop .status{display:inline-block;background:var(--sun);border:1px solid var(--ink);padding:4px 8px;font:700 11px/1.4 monospace}
  .agent-shop .status.bad{background:#fff;border-color:var(--red);color:var(--red)}
  .agent-shop .status.good{background:var(--cobalt);border-color:var(--cobalt);color:#fff}
  .agent-shop .err{color:var(--red);font-weight:700}
  .agent-shop a:focus-visible,.agent-shop button:focus-visible,.agent-shop input:focus-visible,.agent-shop textarea:focus-visible,.agent-shop select:focus-visible{outline:3px solid var(--red);outline-offset:3px}
  @media(max-width:860px){.as-hero,.as-grid2,.as-grid3{grid-template-columns:1fr}.as-hero{padding:30px 0}}
  @media(max-width:600px){.as-mast{padding:16px}.as-mast .as-home span{display:none}.as-rooms{padding:10px 16px}.as-main{padding:0 16px 40px}.as-foot{padding:28px 16px}.as-rooms a{padding:10px 12px}}
</style>
