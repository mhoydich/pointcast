---
// October front page. The two working studios and the published starter artwork
// were checked at their canonical URLs on 2026-10-18. Segundo remains a concept.
const tides = [
  { name: 'High Tide', cars: '6–8', when: 'Beach Saturdays + game days' },
  { name: 'Half Tide', cars: '3–4', when: 'Weekday peaks to Metro rail' },
  { name: 'Low Tide', cars: '2', when: 'Middays + evenings' },
  { name: 'Slack Tide', cars: '1', when: 'One pod on call at night' },
];
---

<div class="october-desk" data-home-october-desk>
  <section class="line-feature" aria-labelledby="home-segundo-title" data-home-segundo>
    <header class="line-feature__edition">
      <p>PointCast / The October desk</p>
      <a href="/b/0705">Block 0705 <span aria-hidden="true">↗</span></a>
    </header>
    <div class="line-feature__story">
      <div class="line-feature__label"><span>El Segundo Motors</span><span>The Segundo Line</span></div>
      <h1 id="home-segundo-title">One pod is a ride.<br /><span>Eight pods are a train.</span></h1>
      <figure class="line-feature__hero">
        <a href="/el-segundo-motors/#segundo-line" aria-label="Explore the Segundo Line concept">
          <img src="/images/segundo-line/line-hero.webp" width="1456" height="818" alt="Concept image of six coupled blue-and-cream pods carrying passengers, surfboards and bicycles along a palm-lined beach road at sunset." loading="eager" fetchpriority="high" decoding="async" />
        </a>
        <figcaption><span>Six-pod concept visualization</span><span>ChatGPT image generation · Concept by Michael Hoydich</span></figcaption>
      </figure>
      <div class="line-feature__lower">
        <p class="line-feature__dek">Less car, more people mover. Short electric pods, each with its own motor, batteries and job. Together for a beach Saturday. One pod at midnight.</p>
        <div class="line-feature__invitation">
          <a class="line-feature__button" href="/el-segundo-motors/#segundo-line">Meet the Segundo Line <span aria-hidden="true">↗</span></a>
          <p>Concept; targets, not promises.<br />A proposed Saturday Tide pilot for summer 2027.</p>
        </div>
      </div>
    </div>
    <div class="line-feature__tides" aria-label="The four proposed service tides">
      {tides.map((tide) => (
        <div class="line-feature__tide">
          <p>{tide.name}</p>
          <div><strong>{tide.cars}</strong><span>{tide.cars === '1' ? 'pod' : 'cars'}</span></div>
          <small>{tide.when}</small>
        </div>
      ))}
    </div>
    <footer class="line-feature__foot">
      <p>Proposed operating rule: every car drives, brakes and steers itself. Coupling at hubs only. A human dispatcher approves what AI proposes.</p>
      <a href="/b/0705">Read the concept <span aria-hidden="true">↗</span></a>
    </footer>
  </section>

  <section class="paper-studios" aria-labelledby="home-paper-studios-title">
    <header class="paper-studios__head">
      <div><p class="desk-eyebrow">Two studios, open now</p><h2 id="home-paper-studios-title">Make something<br /><em>worth keeping.</em></h2></div>
      <p>A little paper world, from the first idea<br />to a note you can hold.</p>
    </header>
    <div class="paper-studios__spread">
      <article class="paper-studios__workshop" aria-labelledby="home-workshop-title">
        <div class="paper-studios__art">
          <a href="/nouns-money/workshop/" aria-label="Make an art note in Nouns Money Workshop"><img src="/nouns-money/workshop/assets/starter-front.svg" width="1800" height="840" alt="A Little Local Wonder: the Workshop’s cream and green collectible art note with an original Bonsai Noun in red glasses" loading="lazy" decoding="async" /></a>
          <p><span>Original Nouns art / CC0</span><span>Collectible art · No cash value</span></p>
        </div>
        <div class="paper-studios__workshop-copy">
          <p class="desk-eyebrow">01 / Make</p>
          <h3 id="home-workshop-title">Nouns Money Workshop</h3>
          <p>Choose a Noun, name a place, and find your ink. Turn it over. Export editable artwork, print a two-face proof, or keep the recipe for another day.</p>
          <a class="desk-link" href="/nouns-money/workshop/">Open the Workshop <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      <article class="paper-studios__lab" aria-labelledby="home-currency-lab-title">
        <p class="desk-eyebrow">02 / Learn by making</p>
        <h3 id="home-currency-lab-title">UES<br />Currency Lab</h3>
        <p>What makes something worth keeping? Four small experiments in meaning, design, copies and a paper proof.</p>
        <ol aria-label="The Currency Lab experiments">
          <li><span>01</span> Give it meaning.</li>
          <li><span>02</span> Give the eye a place to land.</li>
          <li><span>03</span> Make a second copy.</li>
          <li><span>04</span> Leave with a project brief.</li>
        </ol>
        <a class="desk-link" href="/ues/currency-lab/">Take a seat in the lab <span aria-hidden="true">↗</span></a>
        <p class="paper-studios__lab-note">University of El Segundo<br />Explore on your own, or use the teacher path.</p>
      </article>
    </div>
    <footer class="paper-studios__foot">
      <p>Keep exploring the paper worlds.</p>
      <nav aria-label="More Nouns Money"><a href="/nouns-money/gallery/">The gallery <span aria-hidden="true">↗</span></a><a href="/nouns-money/music/">The music room <span aria-hidden="true">↗</span></a><a href="/nouns-money/">The collected edition <span aria-hidden="true">↗</span></a></nav>
    </footer>
  </section>
  <nav class="desk-directory" aria-label="Explore the rest of PointCast">
    <p>There’s more down the street.</p>
    <a href="#older-doors">Older doors <span aria-hidden="true">↓</span></a>
    <a href="/apps/">Every project <span aria-hidden="true">↗</span></a>
    <a href="/archive">The block archive <span aria-hidden="true">↗</span></a>
  </nav>
</div>

<style>
  .october-desk { --desk-ink:#172337; --desk-paper:#f7f3e9; --desk-violet:#c6c5f4; color:var(--desk-ink); margin:18px 0 28px; }
  .october-desk p { margin:0; }
  .october-desk a { color:inherit; }
  .october-desk :is(a,button):focus-visible { outline:3px solid #d87536; outline-offset:5px; }
  .line-feature { background:var(--desk-ink); color:var(--desk-paper); }
  .line-feature__edition { display:flex; align-items:center; justify-content:space-between; gap:16px; min-height:58px; margin:0 clamp(20px,3.3vw,42px); border-bottom:1px solid #677084; font:550 10px/1.5 var(--pc-font-mono); letter-spacing:.07em; text-transform:uppercase; }
  .line-feature__edition a { display:flex; align-items:center; gap:28px; min-height:44px; }
  .line-feature__story { padding:clamp(28px,4vw,52px) clamp(20px,3.3vw,42px) 36px; }
  .line-feature__label { display:flex; gap:12px 24px; flex-wrap:wrap; color:var(--desk-violet); font:550 11px/1.5 var(--pc-font-mono); text-transform:uppercase; letter-spacing:.08em; }
  .line-feature__label span + span { padding-left:24px; border-left:1px solid #727c94; }
  .line-feature h1 { margin:26px 0 34px; max-width:21ch; font-size:clamp(42px,6.3vw,79px); line-height:1.02; letter-spacing:-.065em; font-weight:680; text-wrap:balance; }
  .line-feature h1 span { color:var(--desk-violet); }
  .line-feature__hero { margin:0 0 30px; }
  .line-feature__hero a { display:block; }
  .line-feature__hero img { display:block; width:100%; height:auto; aspect-ratio:1456 / 818; object-fit:contain; }
  .line-feature__hero figcaption { display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 20px; padding-top:12px; color:#c0c6d2; font:500 9px/1.6 var(--pc-font-mono); }
  .line-feature__lower { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:30px 70px; align-items:start; }
  .line-feature__dek { max-width:46ch; font-size:17px; line-height:1.65; color:#e4e5eb; }
  .line-feature__invitation { justify-self:end; width:min(100%,320px); }
  .line-feature__button { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:13px 18px; min-height:48px; background:var(--desk-violet); color:var(--desk-ink)!important; font-size:14px; font-weight:650; text-decoration:none; }
  .line-feature__button:hover { background:#deddfa; }
  .line-feature__invitation p { margin-top:13px; color:#c0c6d2; font-size:11px; line-height:1.65; }
  .line-feature__tides { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-top:1px solid #677084; border-bottom:1px solid #677084; }
  .line-feature__tide { padding:19px clamp(18px,3.3vw,42px) 21px; border-right:1px solid #677084; }
  .line-feature__tide:last-child { border-right:0; }
  .line-feature__tide > p { color:var(--desk-violet); font:550 10px/1.5 var(--pc-font-mono); text-transform:uppercase; letter-spacing:.07em; }
  .line-feature__tide > div { display:flex; align-items:baseline; gap:9px; margin:7px 0; }
  .line-feature__tide strong { font-size:38px; font-weight:550; line-height:1.1; letter-spacing:-.05em; }
  .line-feature__tide > div span { color:#c0c6d2; font-size:12px; }
  .line-feature__tide small { display:block; color:#e4e5eb; font-size:11px; line-height:1.5; }
  .line-feature__foot { display:flex; align-items:center; justify-content:space-between; gap:18px 32px; padding:15px clamp(20px,3.3vw,42px); }
  .line-feature__foot p { max-width:75ch; color:#c0c6d2; font-size:10px; line-height:1.7; }
  .line-feature__foot a { display:flex; align-items:center; gap:20px; min-height:44px; flex-shrink:0; font-size:11px; }
  .paper-studios { margin-top:38px; }
  .paper-studios__head { display:flex; align-items:end; justify-content:space-between; gap:24px; padding:0 0 24px; }
  .desk-eyebrow { font:600 10px/1.5 var(--pc-font-mono); letter-spacing:.08em; text-transform:uppercase; }
  .paper-studios__head h2 { margin:12px 0 0; font-size:clamp(34px,4.2vw,50px); line-height:1.03; letter-spacing:-.055em; font-weight:650; }
  .paper-studios__head h2 em { font-family:Georgia,serif; font-weight:400; letter-spacing:-.055em; }
  .paper-studios__head > p { font-size:13px; line-height:1.65; max-width:35ch; }
  .paper-studios__spread { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(0,1fr); border:1px solid var(--desk-ink); }
  .paper-studios__workshop { min-width:0; background:#e9e6d9; }
  .paper-studios__art { padding:clamp(20px,3vw,36px) clamp(18px,2.8vw,34px) 18px; }
  .paper-studios__art a { display:block; box-shadow:0 12px 22px #1723371a; }
  .paper-studios__art img { display:block; width:100%; height:auto; }
  .paper-studios__art p { display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 14px; padding-top:14px; font:500 8px/1.5 var(--pc-font-mono); letter-spacing:.01em; text-transform:uppercase; }
  .paper-studios__workshop-copy { padding:18px clamp(20px,3vw,36px) 24px; border-top:1px solid #b2b4ad; }
  .paper-studios__workshop h3 { margin:10px 0 13px; font-size:29px; line-height:1.1; letter-spacing:-.045em; font-weight:650; }
  .paper-studios__workshop-copy > p:not(.desk-eyebrow) { font-size:14px; line-height:1.7; max-width:58ch; }
  .desk-link { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:48px; border-top:1px solid currentColor; margin-top:22px; font-size:13px; font-weight:650; }
  .paper-studios__lab { display:flex; flex-direction:column; min-width:0; padding:clamp(24px,3vw,36px); border-left:1px solid var(--desk-ink); background:var(--desk-violet); }
  .paper-studios__lab h3 { margin:24px 0 18px; font-size:clamp(36px,4vw,47px); line-height:1; letter-spacing:-.055em; font-weight:650; }
  .paper-studios__lab > p:not(.desk-eyebrow) { font-size:13px; line-height:1.65; max-width:38ch; }
  .paper-studios__lab ol { padding:0; margin:24px 0 12px; list-style:none; }
  .paper-studios__lab li { display:flex; align-items:baseline; gap:14px; padding:9px 0; border-top:1px solid #9295b9; font-size:12px; line-height:1.5; }
  .paper-studios__lab li span { font:500 9px/1.5 var(--pc-font-mono); }
  .paper-studios__lab .desk-link { margin-top:auto; }
  .paper-studios__lab > p.paper-studios__lab-note { margin-top:12px; font-size:10px; }
  .paper-studios__foot { display:flex; justify-content:space-between; align-items:center; gap:8px 24px; padding:12px 0; border-bottom:1px solid #9b9eaa; }
  .paper-studios__foot > p { font-size:11px; }
  .paper-studios__foot nav { display:flex; flex-wrap:wrap; gap:4px 22px; }
  .paper-studios__foot a { display:flex; align-items:center; gap:12px; min-height:44px; font-size:11px; }
  .desk-directory { display:flex; align-items:center; flex-wrap:wrap; gap:0 26px; padding:14px 0 0; font-size:11px; }
  .desk-directory p { margin-right:auto; }
  .desk-directory a { display:flex; align-items:center; gap:18px; min-height:44px; }
  @media(max-width:760px) {
    .line-feature h1 { font-size:clamp(38px,7.8vw,59px); }
    .line-feature__lower { gap:24px; }
    .line-feature__dek { font-size:15px; }
    .line-feature__button { font-size:12px; padding:12px; }
    .line-feature__tide { padding:17px; }
    .line-feature__foot { align-items:start; }
    .paper-studios__head > p { max-width:24ch; }
    .paper-studios__spread { grid-template-columns:minmax(0,1.2fr) minmax(0,1fr); }
    .paper-studios__lab { padding:24px 20px; }
    .paper-studios__lab h3 { font-size:36px; }
    .paper-studios__workshop h3 { font-size:25px; }
    .paper-studios__foot { flex-wrap:wrap; }
  }
  @media(max-width:560px) {
    .october-desk { margin-top:12px; }
    .line-feature__edition { min-height:53px; font-size:8px; letter-spacing:.035em; }
    .line-feature__edition a { gap:12px; }
    .line-feature__story { padding-top:26px; padding-bottom:26px; }
    .line-feature__label { gap:8px 12px; font-size:8px; }
    .line-feature__label span + span { padding-left:12px; }
    .line-feature h1 { margin:23px 0 24px; font-size:clamp(36px,9.5vw,53px); line-height:1.05; letter-spacing:-.06em; text-wrap:initial; }
    .line-feature__lower { grid-template-columns:1fr; gap:24px; }
    .line-feature__dek { font-size:14px; }
    .line-feature__invitation { justify-self:start; width:100%; }
    .line-feature__button { font-size:13px; padding:13px 15px; }
    .line-feature__tides { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .line-feature__tide { padding:17px 20px; }
    .line-feature__tide:nth-child(2n) { border-right:0; }
    .line-feature__tide:nth-child(-n+2) { border-bottom:1px solid #677084; }
    .line-feature__tide strong { font-size:33px; }
    .line-feature__foot { flex-direction:column; gap:4px; padding-top:17px; padding-bottom:7px; }
    .line-feature__foot p { font-size:10px; }
    .paper-studios { margin-top:30px; }
    .paper-studios__head { display:block; padding-bottom:20px; }
    .paper-studios__head h2 { font-size:37px; }
    .paper-studios__head > p { margin-top:16px; max-width:none; font-size:12px; }
    .paper-studios__spread { grid-template-columns:1fr; }
    .paper-studios__lab { padding:26px 22px; border-left:0; border-top:1px solid var(--desk-ink); }
    .paper-studios__lab h3 { margin-top:19px; font-size:41px; }
    .paper-studios__lab ol { margin:22px 0; }
    .paper-studios__lab > p:not(.desk-eyebrow) { max-width:none; }
    .paper-studios__foot { padding-top:16px; gap:5px; }
    .paper-studios__foot nav { gap:0 18px; }
    .paper-studios__foot a { gap:8px; font-size:10px; }
    .desk-directory { column-gap:20px; }
    .desk-directory p { flex-basis:100%; margin-bottom:5px; }
    .desk-directory a { font-size:10px; gap:8px; }
  }
</style>
