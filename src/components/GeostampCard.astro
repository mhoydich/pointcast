---
/**
 * The shared check-in card from the El Segundo network. PointCast hosts its own copy
 * (/js/geostamp.js, from elsegundo.xyz/ping/geostamp.js) so no page loads a script
 * from another origin; data-api points it at the shared check-in service, and
 * data-site picks PointCast's own call wording. Skippable, no account, never opens
 * by itself under Do Not Track or GPC. Left off /chain/ apps, which stay self-contained.
 * Check-ins show in the merged feed at elsegundo.xyz/checkins/. Format: /check-in/format/.
 */
const path = Astro.url.pathname;
const skip = path.startsWith('/chain/') || path === '/chain';
---
{!skip && <script is:inline async src="/js/geostamp.js" data-site="pointcast" data-api="https://elsegundo.xyz"></script>}
