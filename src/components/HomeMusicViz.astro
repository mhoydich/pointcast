---
/**
 * HomeMusicViz — the hi-fi face at the top of the Music on shelf.
 *
 * Listening is the point: the big button on the wall is the way in, and the wall
 * grows and draws the sound itself once it can hear. Keeping time is the fallback.
 * A web page cannot hear another tab, so this is honest about its three sources:
 *   time   (default) the LED wall keeps time from the tempo you tapped (pc:music:tempo)
 *                    and jumps when anyone on this page hits a pad (pc:rosebud:played).
 *   mic    (opt-in)  getUserMedia → AnalyserNode: a real spectrum of what your speakers
 *                    are playing, a beat lamp, and a rough tempo it offers back as
 *                    pc:music:heard {bpm}.
 *   tab    (opt-in, desktop Chrome/Edge) getDisplayMedia with "Share tab audio", for
 *                    people on headphones.
 * Audio is analysed in this browser and nowhere else: it is never recorded, never
 * connected to the speakers, never sent anywhere. Tracks stop on Stop, on navigation,
 * and when the stream ends. The loop only runs while the wall is on screen.
 */
---
<div class="mviz" data-mviz data-mode="time">
  <div class="mviz__stage">
    <canvas class="mviz__wall" data-mviz-canvas aria-hidden="true"></canvas>
    <button type="button" class="mviz__cta" data-mviz-mic>
      <span class="mviz__cta-ear" aria-hidden="true"><i></i><i></i><i></i></span>
      <strong data-mviz-cta-label>Let it listen</strong>
      <small>See your music on the wall · through the mic · nothing recorded</small>
    </button>
  </div>
  <div class="mviz__bar">
    <p class="mviz__state" role="status"><i class="mviz__lamp" data-mviz-lamp aria-hidden="true"></i><b data-mviz-mode>Standing by</b><span data-mviz-note>Music playing? Let the wall listen and it shows what your speakers are doing.</span></p>
    <p class="mviz__actions">
      <button type="button" class="mviz__btn" data-mviz-tab hidden>On headphones? Share the tab’s sound</button>
      <button type="button" class="mviz__btn" data-mviz-stop hidden>Stop listening</button>
    </p>
  </div>
  <p class="mviz__fine">A page cannot hear another tab. With your OK it listens through the microphone to what your speakers are playing. Nothing is recorded and nothing leaves this browser.</p>
</div>

<script>
  function mountMusicViz() {
    const root = document.querySelector<HTMLElement>('[data-mviz]');
    if (!root || root.dataset.mounted) return; root.dataset.mounted = 'true';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const canvas = $<HTMLCanvasElement>('[data-mviz-canvas]'), ctx = canvas.getContext('2d'); if (!ctx) return;
    const modeEl = $('[data-mviz-mode]'), noteEl = $('[data-mviz-note]'), lamp = $('[data-mviz-lamp]');
    const micBtn = $<HTMLButtonElement>('[data-mviz-mic]'), tabBtn = $<HTMLButtonElement>('[data-mviz-tab]'), stopBtn = $<HTMLButtonElement>('[data-mviz-stop]');
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const life = new AbortController(), sig = { signal: life.signal }; // every listener below dies with this page

    // ── the wall ───────────────────────────────────────────────────
    const ROWS = 10; let cols = 40, W = 0, H = 0, dpr = 1;
    let level = new Float32Array(cols), peak = new Float32Array(cols), tint = new Float32Array(cols), tintHue: string[] = new Array(cols).fill('');
    const ROW_COLOR = (r: number) => (r >= ROWS - 2 ? '#f3a0a6' : r >= ROWS - 5 ? '#f4d83e' : '#7aa279'); // hi-fi: green, yellow, pink on top
    const PAD: Record<string, { from: number; to: number; color: string }> = { kick: { from: 0, to: .28, color: '#efe6ce' }, bloom: { from: .24, to: .52, color: '#f3a0a6' }, thorn: { from: .48, to: .76, color: '#7aa279' }, dew: { from: .72, to: 1, color: '#f4d83e' } };
    function resize() {
      const w = canvas.clientWidth, h = canvas.clientHeight; if (!w || !h) return;
      dpr = Math.min(2, window.devicePixelRatio || 1); W = canvas.width = Math.round(w * dpr); H = canvas.height = Math.round(h * dpr);
      const next = w < 520 ? 24 : w < 900 ? 32 : 48;
      if (next !== cols) { cols = next; level = new Float32Array(cols); peak = new Float32Array(cols); tint = new Float32Array(cols); tintHue = new Array(cols).fill(''); bands = null; }
    }
    function paint() {
      if (!W) resize(); if (!W) return;
      ctx!.fillStyle = '#12110E'; ctx!.fillRect(0, 0, W, H);
      const gap = Math.max(1, Math.round(2 * dpr)), cw = (W - gap) / cols, ch = (H - gap) / ROWS;
      for (let c = 0; c < cols; c++) {
        const lit = Math.round(level[c] * ROWS), cap = Math.min(ROWS - 1, Math.round(peak[c] * ROWS));
        for (let r = 0; r < ROWS; r++) {
          const on = r < lit, isCap = r === cap && cap >= lit && peak[c] > .04;
          ctx!.fillStyle = on ? (tint[c] > .25 && tintHue[c] ? tintHue[c] : ROW_COLOR(r)) : isCap ? '#fffdf6' : 'rgba(255,253,246,.07)';
          ctx!.fillRect(Math.round(gap + c * cw), Math.round(H - (r + 1) * ch), Math.max(1, Math.round(cw - gap)), Math.max(1, Math.round(ch - gap)));
        }
      }
      if (flash > .02) { ctx!.fillStyle = `rgba(243,160,166,${(flash * .16).toFixed(3)})`; ctx!.fillRect(0, 0, W, H); }
      if (analyser && wave) { // the sound itself, drawn across the top third
        analyser.getByteTimeDomainData(wave);
        const mid = H * .2, amp = H * .19, step = wave.length / W * 2;
        ctx!.beginPath(); for (let x = 0, i = 0; x < W; x += 2, i += step) { const y = mid + ((wave[Math.floor(i)] - 128) / 128) * amp * 2.2; if (x) ctx!.lineTo(x, y); else ctx!.moveTo(x, y); }
        ctx!.lineWidth = Math.max(1.5, 2 * dpr); ctx!.strokeStyle = '#fffdf6'; ctx!.lineJoin = 'round'; ctx!.stroke();
      }
    }

    // ── source: time (the tapped tempo; no sound is heard) ─────────
    let bpm = 0, t0 = performance.now();
    try { const kept = Number(localStorage.getItem('pc:music:bpm')); if (kept >= 40 && kept <= 240) bpm = kept; } catch {}
    const hash = (a: number, b: number) => { let x = Math.imul(a + 1, 374761393) ^ Math.imul(b + 1, 668265263); x = Math.imul(x ^ (x >>> 13), 1274126177); return ((x ^ (x >>> 16)) >>> 0) / 4294967295; };
    function timeTargets(now: number, out: Float32Array) {
      if (!bpm) { for (let c = 0; c < cols; c++) out[c] = .1 + .07 * Math.sin(now / 900 + c * .35); return; } // idling: a slow swell
      const beats = (now - t0) / (60000 / bpm), ph = beats - Math.floor(beats), off = (ph + .5) % 1, six = Math.floor(beats * 4);
      const kick = Math.exp(-5 * ph), snare = Math.floor(beats) % 2 ? Math.exp(-6 * ph) : 0, hat = Math.exp(-9 * ((beats * 2) % 1));
      for (let c = 0; c < cols; c++) {
        const x = c / (cols - 1);
        const low = Math.max(0, 1 - x * 3.2) * kick, mid = Math.exp(-((x - .45) ** 2) / .03) * (.75 * snare + .25 * Math.exp(-6 * off)), high = Math.max(0, (x - .55) * 2.2) * hat * (.45 + .55 * hash(c, six));
        out[c] = Math.min(1, .08 + .9 * low + .8 * mid + .7 * high);
      }
    }

    // ── source: mic / tab (a real spectrum) ────────────────────────
    let ac: AudioContext | null = null, analyser: AnalyserNode | null = null, stream: MediaStream | null = null, bins: Uint8Array | null = null, bands: [number, number][] | null = null;
    let lowAvg = 0, lastOnset = 0, onsets: number[] = [], heard = 0, quietSince = 0, wave: Uint8Array | null = null, flash = 0;
    const ctaLabel = $('[data-mviz-cta-label]');
    try { if (localStorage.getItem('pc:music:listen') === '1') ctaLabel.textContent = 'Let it listen again'; } catch {}
    function makeBands() {
      const n = analyser!.frequencyBinCount, hz = ac!.sampleRate / 2 / n, lo = 40, hi = 12000; bands = [];
      for (let c = 0; c < cols; c++) { const a = lo * (hi / lo) ** (c / cols), b = lo * (hi / lo) ** ((c + 1) / cols); const i = Math.max(1, Math.floor(a / hz)); bands.push([i, Math.max(i + 1, Math.min(n, Math.ceil(b / hz)))]); }
    }
    function micTargets(now: number, out: Float32Array) {
      if (!analyser || !bins) return; if (!bands) makeBands();
      analyser.getByteFrequencyData(bins); let loud = 0;
      for (let c = 0; c < cols; c++) { const [i, j] = bands![c]; let s = 0; for (let k = i; k < j; k++) s += bins[k]; const v = s / (j - i) / 255; loud += v; out[c] = Math.min(1, v ** 1.35 * (1 + c / cols * .9)); } // tilt: highs carry less energy
      loud /= cols; if (loud > .03) quietSince = 0; else if (!quietSince) quietSince = now;
      // Beat lamp + rough tempo from low-band onsets.
      let low = 0; const lowEnd = Math.max(2, Math.round(cols * .14)); for (let c = 0; c < lowEnd; c++) low += out[c]; low /= lowEnd;
      if (low > lowAvg * 1.32 && low > .2 && now - lastOnset > 260) {
        if (lastOnset) { let gap = now - lastOnset; while (gap < 60000 / 180) gap *= 2; while (gap > 60000 / 70) gap /= 2; onsets.push(gap); if (onsets.length > 24) onsets.shift(); }
        lastOnset = now; flash = 1; lamp.dataset.on = 'true'; setTimeout(() => { delete lamp.dataset.on; }, 90);
        window.dispatchEvent(new CustomEvent('pc:music:beat', { detail: { at: now } })); // the tempo dot below lands on real beats
        if (onsets.length >= 10) {
          const s = [...onsets].sort((a, b) => a - b), med = s[s.length >> 1], close = s.filter((g) => Math.abs(g - med) < med * .08), near = close.length;
          const guess = Math.round(60000 / (close.reduce((a, g) => a + g, 0) / (near || 1))); // mean of the gaps that agree: finer than one frame
          // Two BPM of hysteresis so the number does not flicker.
          if (near >= s.length * .55 && Math.abs(guess - heard) >= 2) { heard = guess; window.dispatchEvent(new CustomEvent('pc:music:heard', { detail: { bpm: guess } })); describe(); }
        }
      }
      lowAvg = lowAvg * .93 + low * .07;
    }

    const NOTES = {
      time: () => (bpm ? `Keeping ${bpm} BPM from your taps, not hearing the music. Let it listen for the real thing.` : 'Music playing? Let the wall listen and it shows what your speakers are doing.'),
      mic: () => (quietSince && performance.now() - quietSince > 4000 ? 'Listening, but it is quiet. Headphones on? Turn the speakers up, or share the tab’s sound.' : heard ? `Hearing your speakers · about ${heard} BPM.` : 'Hearing your speakers. Nothing is recorded.'),
      tab: () => (heard ? `Hearing the shared tab · about ${heard} BPM.` : 'Hearing the shared tab. Nothing is recorded.'),
    };
    function describe() {
      const m = root.dataset.mode as 'time' | 'mic' | 'tab';
      modeEl.textContent = m === 'time' ? (bpm ? 'Keeping time' : 'Standing by') : 'Listening'; noteEl.textContent = NOTES[m]();
    }

    async function listen(kind: 'mic' | 'tab') {
      try {
        if (!navigator.mediaDevices) throw new Error('unsupported');
        const s = kind === 'mic'
          ? await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false }, video: false })
          : await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });
        if (kind === 'tab') { s.getVideoTracks().forEach((t) => t.stop()); if (!s.getAudioTracks().length) { s.getTracks().forEach((t) => t.stop()); noteEl.textContent = 'No sound came with that share. Pick the Spotify tab and tick “Also share tab audio”.'; return; } }
        stop(true); stream = s;
        ac = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
        if (ac.state === 'suspended') await ac.resume();
        analyser = ac.createAnalyser(); analyser.fftSize = 2048; analyser.smoothingTimeConstant = .72; bins = new Uint8Array(analyser.frequencyBinCount); wave = new Uint8Array(1024); bands = null;
        try { localStorage.setItem('pc:music:listen', '1'); } catch {}
        ac.createMediaStreamSource(s).connect(analyser); // analysed only: never connected to the speakers
        s.getAudioTracks().forEach((t) => t.addEventListener('ended', () => stop()));
        onsets = []; heard = 0; lowAvg = 0; lastOnset = 0; quietSince = 0;
        root.dataset.mode = kind; micBtn.hidden = true; tabBtn.hidden = true; stopBtn.hidden = false; describe(); resize(); kick();
      } catch (err) {
        const name = (err as Error)?.name || '';
        noteEl.textContent = name === 'NotAllowedError' ? (kind === 'mic' ? 'No microphone, no problem. The wall still keeps time from your taps.' : 'Share cancelled. The wall still keeps time from your taps.') : name === 'NotFoundError' ? 'No microphone found on this device.' : 'Listening is not available in this browser. The wall still keeps time from your taps.';
      }
    }
    function stop(quiet = false) {
      stream?.getTracks().forEach((t) => t.stop()); stream = null; analyser = null; bins = null; wave = null;
      if (ac) { void ac.close().catch(() => {}); ac = null; }
      if (quiet) return;
      root.dataset.mode = 'time'; micBtn.hidden = false; tabBtn.hidden = !canTab; stopBtn.hidden = true; ctaLabel.textContent = 'Let it listen again'; describe();
      requestAnimationFrame(() => { resize(); paint(); });
    }
    const canTab = !!navigator.mediaDevices?.getDisplayMedia && matchMedia('(pointer: fine)').matches;
    tabBtn.hidden = !canTab;
    micBtn.addEventListener('click', () => void listen('mic'));
    tabBtn.addEventListener('click', () => void listen('tab'));
    stopBtn.addEventListener('click', () => stop());

    // ── the loop: only while the wall is on screen and the page is visible ──
    const target = () => new Float32Array(cols); let tg = target(), raf = 0, onScreen = false, last = 0, lastDescribe = 0;
    function frame(now: number) {
      raf = 0;
      const listening = root.dataset.mode !== 'time';
      if (calm.matches && now - last < 240) { kick(); return; }
      const dt = Math.min(.1, (now - last) / 1000 || .016); last = now;
      if (tg.length !== cols) tg = target();
      if (listening) micTargets(now, tg); else if (calm.matches) tg.fill(bpm ? .45 : .12); else timeTargets(now, tg);
      for (let c = 0; c < cols; c++) {
        const want = Math.min(1, tg[c] + tint[c] * .9);
        level[c] = want > level[c] ? want : Math.max(want, level[c] - dt * 2.6); // instant attack, falling release
        peak[c] = level[c] >= peak[c] ? level[c] : Math.max(0, peak[c] - dt * .45);
        tint[c] = Math.max(0, tint[c] - dt * 3.2);
      }
      flash = Math.max(0, flash - dt * 5);
      paint();
      if (now - lastDescribe > 1500) { lastDescribe = now; describe(); }
      kick();
    }
    function kick() { if (!raf && onScreen && document.visibilityState === 'visible') raf = requestAnimationFrame(frame); }
    const seen = new IntersectionObserver((es) => { onScreen = es.some((e) => e.isIntersecting); kick(); }, { rootMargin: '80px' }); seen.observe(root);
    document.addEventListener('visibilitychange', kick, sig);
    const sized = new ResizeObserver(() => { resize(); paint(); }); sized.observe(canvas);

    // ── the rest of the shelf talks to the wall ────────────────────
    window.addEventListener('pc:music:tempo', (ev: Event) => { const d = (ev as CustomEvent).detail || {}; const b = Number(d.bpm); if (b >= 40 && b <= 240) { bpm = b; t0 = Number(d.at) || performance.now(); describe(); } }, sig);
    window.addEventListener('pc:rosebud:played', (ev: Event) => {
      const z = PAD[String((ev as CustomEvent).detail?.drum || '')]; if (!z) return;
      for (let c = Math.floor(z.from * cols); c < Math.ceil(z.to * cols); c++) { const x = (c / cols - z.from) / (z.to - z.from); tint[c] = Math.max(tint[c], .55 + .45 * Math.sin(Math.PI * x)); tintHue[c] = z.color; }
      if (calm.matches) { last = 0; } kick();
    }, sig);
    root.addEventListener('pc:viz:frame', () => frame(performance.now())); // one frame on demand (hidden-tab checks)
    document.addEventListener('astro:before-swap', () => { stop(true); cancelAnimationFrame(raf); seen.disconnect(); sized.disconnect(); life.abort(); }, { once: true });
    window.addEventListener('pagehide', () => stop(true), sig);
    resize(); describe(); paint();
  }
  mountMusicViz();
  document.addEventListener('astro:page-load', mountMusicViz);
</script>

<style>
  .mviz { border-bottom: 2px solid var(--home-ink); background: #12110E; color: #fffdf6; }
  .mviz__stage { position: relative; }
  .mviz__wall { display: block; width: 100%; height: 150px; image-rendering: pixelated; transition: height .35s ease; }
  .mviz[data-mode='mic'] .mviz__wall, .mviz[data-mode='tab'] .mviz__wall { height: 230px; }
  .mviz__cta { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; grid-template-columns: auto auto; column-gap: 12px; align-items: center; justify-items: start; max-width: calc(100% - 24px); padding: 14px 20px 14px 16px; border: 2px solid #12110E; background: #f4d83e; color: #12110E; text-align: left; cursor: pointer; box-shadow: 6px 6px 0 #fffdf6; touch-action: manipulation; }
  .mviz__cta[hidden] { display: none; }
  .mviz__cta:hover { background: #fffdf6; box-shadow: 6px 6px 0 #f4d83e; }
  .mviz__cta:active { transform: translate(calc(-50% + 3px), calc(-50% + 3px)); box-shadow: 3px 3px 0 #fffdf6; }
  .mviz__cta:focus-visible { outline: 3px solid #fffdf6; outline-offset: 3px; }
  .mviz__cta strong { font-size: clamp(22px, 2.6vw, 30px); font-weight: 730; line-height: 1; letter-spacing: -.035em; }
  .mviz__cta small { grid-column: 2; margin-top: 4px; font: 700 8.5px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .mviz__cta-ear { grid-row: 1 / span 2; display: flex; align-items: flex-end; gap: 3px; height: 34px; }
  .mviz__cta-ear i { width: 7px; background: #12110E; animation: mviz-ear 1.1s ease-in-out infinite; }
  .mviz__cta-ear i:nth-child(1) { height: 45%; } .mviz__cta-ear i:nth-child(2) { height: 100%; animation-delay: .18s; } .mviz__cta-ear i:nth-child(3) { height: 65%; animation-delay: .36s; }
  @keyframes mviz-ear { 0%, 100% { transform: scaleY(.45); } 50% { transform: scaleY(1); } }
  .mviz__cta-ear i { transform-origin: bottom; }
  @media (prefers-reduced-motion: reduce) { .mviz__cta-ear i { animation: none; } .mviz__wall { transition: none; } }
  .mviz__bar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 18px; align-items: center; padding: 10px clamp(16px, 3vw, 28px) 4px; }
  .mviz__state { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 13px; line-height: 1.35; }
  .mviz__state b { font: 700 9px var(--pc-font-mono); letter-spacing: .13em; text-transform: uppercase; color: #f4d83e; }
  .mviz__state span { color: rgba(255, 253, 246, .82); }
  .mviz__lamp { align-self: center; width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 253, 246, .22); }
  .mviz[data-mode='mic'] .mviz__lamp, .mviz[data-mode='tab'] .mviz__lamp { background: #7aa279; }
  .mviz__lamp[data-on='true'] { background: #f3a0a6 !important; box-shadow: 0 0 0 4px rgba(243, 160, 166, .3); }
  .mviz__actions { margin: 0; display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .mviz__btn { padding: 8px 10px; border: 1px solid #fffdf6; background: transparent; color: #fffdf6; font: 700 9px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; cursor: pointer; }
  .mviz__btn[hidden] { display: none; }
  .mviz__btn--primary { background: #fffdf6; color: #12110E; }
  .mviz__btn:hover { background: #f4d83e; border-color: #f4d83e; color: #12110E; }
  .mviz__btn:focus-visible { outline: 2px solid #f4d83e; outline-offset: 2px; }
  .mviz__fine { margin: 0; padding: 0 clamp(16px, 3vw, 28px) 10px; font-size: 11.5px; line-height: 1.4; color: rgba(255, 253, 246, .62); max-width: 92ch; }
  @media (max-width: 680px) {
    .mviz__wall { height: 128px; }
    .mviz[data-mode='mic'] .mviz__wall, .mviz[data-mode='tab'] .mviz__wall { height: 190px; }
    .mviz__cta small { letter-spacing: .05em; }
    .mviz__bar { grid-template-columns: 1fr; }
    .mviz__actions { justify-content: flex-start; }
  }
</style>
