---
import { FIELD_DESK_2026 } from '../lib/local';

const signals = FIELD_DESK_2026.currentSignals.slice(0, 3);
const observations = FIELD_DESK_2026.observations.slice(0, 4);
---

<section id="nature-field-desk" class="nature-field" aria-labelledby="nature-field-title">
  <div class="nature-field__copy">
    <p class="nature-field__kicker">LOCAL NATURE · FIELD DESK · {FIELD_DESK_2026.asOf}</p>
    <h2 id="nature-field-title">Fresh El Segundo nature signal.</h2>
    <p>
      Buckwheat summer is coming into view, Ballona is the nearby restoration story,
      and May-June grunion nights stay observation-only.
    </p>
    <div class="nature-field__actions" aria-label="Nature desk links">
      <a href="/nature#field-desk-2026">Open /nature</a>
      <a href={`/b/${FIELD_DESK_2026.blockId}`}>Read block</a>
      <a href="/nature.json">JSON</a>
    </div>
  </div>

  <div class="nature-field__signals" aria-label="Current nature signals">
    {signals.map((signal) => (
      <a href={signal.sourceUrl} target="_blank" rel="noopener">
        <span>{signal.label}</span>
        <strong>{signal.status}</strong>
        <em>{signal.read}</em>
      </a>
    ))}
  </div>

  <div class="nature-field__observations" aria-label="Recent community observations">
    <p>Recent community observations</p>
    <ul>
      {observations.map((observation) => (
        <li>
          <a href={observation.sourceUrl} target="_blank" rel="noopener">
            <span>{observation.observedOn}</span>
            <strong>{observation.name}</strong>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .nature-field {
    display: grid;
    grid-template-columns: minmax(300px, 0.98fr) minmax(320px, 1.02fr) minmax(220px, 0.62fr);
    gap: 10px;
    margin: 14px 0 18px;
    padding: 10px;
    border: 1.5px solid #0f6e56;
    background:
      linear-gradient(90deg, rgba(15, 110, 86, 0.08) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(0deg, rgba(15, 110, 86, 0.07) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(135deg, #f5fbf8, #fff9ec 54%, #eef6fb);
  }

  .nature-field__copy,
  .nature-field__signals,
  .nature-field__observations {
    min-width: 0;
    border: 1px solid rgba(18, 17, 14, 0.16);
    background: rgba(255, 255, 255, 0.82);
  }

  .nature-field__copy {
    display: grid;
    gap: 12px;
    align-content: space-between;
    padding: 14px;
  }

  .nature-field__kicker,
  .nature-field__signals span,
  .nature-field__observations p,
  .nature-field__observations span {
    margin: 0;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nature-field__kicker {
    color: #0f6e56;
  }

  .nature-field h2 {
    max-width: 11ch;
    margin: 0;
    color: var(--pc-ink);
    font-size: clamp(34px, 5vw, 68px);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .nature-field__copy p:not(.nature-field__kicker) {
    max-width: 58ch;
    margin: 0;
    color: var(--pc-ink-soft);
    font-size: 15px;
    line-height: 1.45;
  }

  .nature-field__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nature-field__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid rgba(15, 110, 86, 0.28);
    background: #fff;
    color: #074638;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nature-field__signals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .nature-field__signals a {
    display: grid;
    gap: 8px;
    min-height: 178px;
    padding: 12px;
    border-right: 1px solid rgba(18, 17, 14, 0.14);
    color: var(--pc-ink);
  }

  .nature-field__signals a:last-child {
    border-right: 0;
  }

  .nature-field__signals a:hover,
  .nature-field__actions a:hover,
  .nature-field__observations a:hover {
    color: #1f7a8c;
    text-decoration: none;
  }

  .nature-field__signals span {
    color: #0f6e56;
  }

  .nature-field__signals strong {
    font-size: 18px;
    line-height: 1.08;
  }

  .nature-field__signals em {
    color: var(--pc-ink-soft);
    font-size: 13px;
    font-style: normal;
    line-height: 1.42;
  }

  .nature-field__observations {
    padding: 12px;
  }

  .nature-field__observations p {
    margin-bottom: 10px;
    color: #834f0a;
  }

  .nature-field__observations ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nature-field__observations a {
    display: grid;
    gap: 2px;
    color: var(--pc-ink);
  }

  .nature-field__observations span {
    color: var(--pc-ink-soft);
  }

  .nature-field__observations strong {
    font-size: 14px;
    line-height: 1.18;
  }

  @media (max-width: 1100px) {
    .nature-field {
      grid-template-columns: 1fr;
    }

    .nature-field__signals {
      grid-template-columns: 1fr;
    }

    .nature-field__signals a {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid rgba(18, 17, 14, 0.14);
    }

    .nature-field__signals a:last-child {
      border-bottom: 0;
    }
  }
</style>
