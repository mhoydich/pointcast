---
/**
 * ShopCourtLane — the Paddle Register's release calendar, read as a shelf.
 *
 * Pure presentation over what shop-court.ts and paddle-takes.ts hand it.
 * It never computes an affiliate rate or a ranking: rows come in already
 * ordered by date, and the only thing this file adds is a link to a
 * published take, when one exists, and a PaidLink for the outbound URL.
 */
import PaidLink from './PaidLink.astro';
import { AFFILIATE_PROGRAM_IDS, anyProgramApproved, PROGRAM_BY_REGISTER_BRAND } from '../lib/commerce';
import { BUILDS } from '../lib/paddle-calendar';
import { PADDLES } from '../lib/paddle-register';
import { PADDLE_REVIEWS } from '../data/paddle-reviews';
import { orderTakes, publishableTakes } from '../lib/paddle-takes';
import { CHANNELS } from '../lib/channels';
import type { CourtRow } from '../lib/shop-court';

interface Props {
  upcoming: CourtRow[];
  recent: CourtRow[];
  compact?: boolean;
}

const { upcoming, recent, compact = false } = Astro.props;
const court = CHANNELS.CRT;

// PaidLink gets the maker's own product page (row.makerUrl) and the brand's
// program from PROGRAM_BY_REGISTER_BRAND, keyed by the register's exact
// brand strings. A brand with no program, or a row with no maker page,
// resolves unpaid — and stage 1 pays nothing regardless.
const knownIds = PADDLES.map((p) => p.id);
const takes = orderTakes(publishableTakes(PADDLE_REVIEWS, knownIds, AFFILIATE_PROGRAM_IDS));
const takeFor = (paddleId: string) => takes.find((t) => t.paddleId === paddleId);

const approved = anyProgramApproved();
const upcomingRows = compact ? upcoming.slice(0, 6) : upcoming;
const recentRows = compact ? [] : recent;
---

<div class="courtlane" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
  <p class="courtlane__banner">
    {approved
      ? 'Some paddle makers have approved PointCast. Commission never changes what shows here or in what order.'
      : 'No paddle maker has approved PointCast yet. Nothing here earns a commission.'}
  </p>

  {upcomingRows.length > 0 && (
    <section aria-label="Paddles releasing soon">
      {!compact && <p class="courtlane__kicker">ON SALE SOON</p>}
      <ol class="courtlane__list">
        {upcomingRows.map((row) => {
          const take = takeFor(row.id);
          return (
            <li style={`--b:${BUILDS[row.build].color}`}>
              <span class="courtlane__date">{row.when}</span>
              <a class="courtlane__name" href={row.url}>{row.brand} {row.model}</a>
              <span class="courtlane__build">{BUILDS[row.build].short}</span>
              <span class="courtlane__price">{row.listPriceLabel ?? (row.listPriceUsd == null ? 'price n/a' : `$${row.listPriceUsd}`)}</span>
              {take ? (
                <a class="courtlane__take" href={`/reviews/paddles/${take.id}`}>{take.thesis}</a>
              ) : (
                <span class="courtlane__take courtlane__take--empty">No review yet</span>
              )}
              <PaidLink href={row.makerUrl ?? undefined} program={PROGRAM_BY_REGISTER_BRAND[row.brand]} label="See it at the maker" />
            </li>
          );
        })}
      </ol>
    </section>
  )}

  {recentRows.length > 0 && (
    <section aria-label="Paddles released recently">
      <p class="courtlane__kicker">RECENTLY RELEASED</p>
      <ol class="courtlane__list">
        {recentRows.map((row) => {
          const take = takeFor(row.id);
          return (
            <li style={`--b:${BUILDS[row.build].color}`}>
              <span class="courtlane__date">{row.when}</span>
              <a class="courtlane__name" href={row.url}>{row.brand} {row.model}</a>
              <span class="courtlane__build">{BUILDS[row.build].short}</span>
              <span class="courtlane__price">{row.listPriceLabel ?? (row.listPriceUsd == null ? 'price n/a' : `$${row.listPriceUsd}`)}</span>
              {take ? (
                <a class="courtlane__take" href={`/reviews/paddles/${take.id}`}>{take.thesis}</a>
              ) : (
                <span class="courtlane__take courtlane__take--empty">No review yet</span>
              )}
              <PaidLink href={row.makerUrl ?? undefined} program={PROGRAM_BY_REGISTER_BRAND[row.brand]} label="See it at the maker" />
            </li>
          );
        })}
      </ol>
    </section>
  )}

  {upcomingRows.length === 0 && recentRows.length === 0 && (
    <p class="courtlane__empty">Nothing in the window right now. The whole calendar is at <a href="/paddles">the register</a>.</p>
  )}

  {!compact && <p class="courtlane__foot">Order is by release date. Commission never changes it.</p>}
</div>

<style>
  .courtlane { color: var(--pc-ink); }
  .courtlane__banner { margin: 0 0 16px; padding: 10px 12px; border: 1.5px solid var(--c600); background: var(--c50); font: 400 13px/1.5 var(--pc-font-sans); color: var(--pc-ink-soft); }
  .courtlane__kicker { margin: 20px 0 8px; font: 500 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--c800); }
  .courtlane__kicker:first-child { margin-top: 0; }
  .courtlane__list { margin: 0; padding: 0; list-style: none; border-top: 1.5px solid var(--c600); }
  .courtlane__list li {
    display: grid;
    grid-template-columns: 92px minmax(0, 1.1fr) 56px 88px minmax(0, 1.4fr) minmax(140px, auto);
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--pc-rule-soft);
    border-left: 3px solid var(--b, transparent);
    padding-left: 8px;
  }
  .courtlane__date { font: 400 11px var(--pc-font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--pc-ink-muted); }
  .courtlane__name { font: 500 14px var(--pc-font-sans); color: var(--pc-ink); }
  .courtlane__build { font: 400 10px var(--pc-font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--c800); }
  .courtlane__price { font: 500 13px var(--pc-font-sans); font-variant-numeric: tabular-nums; }
  .courtlane__take { font: 400 13px/1.4 var(--pc-font-sans); color: var(--pc-ink-soft); }
  .courtlane__take--empty { color: var(--pc-ink-muted); font-style: italic; }
  .courtlane__empty { padding: 20px 0; font: 400 14px var(--pc-font-sans); color: var(--pc-ink-muted); }
  .courtlane__foot { margin: 16px 0 0; font: 400 10px/1.8 var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--pc-ink-muted); }
  @media (max-width: 820px) {
    .courtlane__list li { grid-template-columns: 1fr 1fr; gap: 4px 12px; }
  }
</style>
