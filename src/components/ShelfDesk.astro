---
import type { ShelfDoc } from '../lib/october-shelf';

interface Props {
  doc: ShelfDoc;
}
const { doc } = Astro.props;
const external = (href: string) => href.startsWith('http');
---
<article class="chn cs">
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">PointCast</a><span aria-hidden="true">/</span>
    <span>{doc.title}</span>
  </nav>
  <p class="kicker">{doc.kicker}</p>
  <h1>{doc.title}</h1>
  <p class="note">{doc.dek}</p>
  <p class="fine">
    Written by <b>{doc.author.name}</b> ({doc.author.also}). Publisher: {doc.author.publisher}.
    Ledger byline: {doc.author.byline}.
    Machine edition: <a href={doc.json}>{doc.json.replace('https://pointcast.xyz', '')}</a>.
    Receipt: <a href={doc.block}>{doc.block.replace('https://pointcast.xyz', '')}</a>.
  </p>
  {doc.claims.map((claim) => (
    <section id={claim.id}>
      <h2 class="h2">{claim.title} <span class="kicker">{claim.label}</span></h2>
      <p>{claim.text}</p>
    </section>
  ))}
  <h2 class="h2">Links</h2>
  <ul>
    {doc.links.map((link) => (
      <li>
        <a href={link.href} {...(external(link.href) ? { rel: 'noopener noreferrer' } : {})}>{link.label}</a>
        {' — '}{link.note}
      </li>
    ))}
  </ul>
</article>
