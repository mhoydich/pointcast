---
/**
 * SpotifyEmbed — wraps Spotify's official embed iframe in PointCast chrome.
 *
 * No auth, no SDK, no API keys. Just <iframe src="open.spotify.com/embed/...">.
 * If `spotifyId` is empty, renders a pixel-art placeholder so the room is
 * never broken — Mike can paste an ID later and it lights up.
 *
 * Sprint 2026-04-30: built for /booth as the first Spotify surface on
 * PointCast. Tutorial: developer.spotify.com/documentation/web-api/tutorials/building-with-ai
 */
interface Props {
  /** "track" | "playlist" | "album" | "artist" | "episode" */
  kind?: 'track' | 'playlist' | 'album' | 'artist' | 'episode';
  /** Spotify ID (the 22-char base62 path segment). Empty → placeholder. */
  spotifyId: string;
  /** Embed height. Compact ≈ 152, full ≈ 352. */
  height?: number;
  /** Accent color for placeholder + frame. */
  accent?: string;
  /** Label shown under the placeholder when no ID is set. */
  placeholderLabel?: string;
}

const {
  kind = 'track',
  spotifyId,
  height = 152,
  accent = '#1ed760',
  placeholderLabel = 'no track yet',
} = Astro.props;

const hasId = typeof spotifyId === 'string' && spotifyId.trim().length > 0;
const src = hasId
  ? `https://open.spotify.com/embed/${kind}/${spotifyId.trim()}?utm_source=pointcast`
  : '';
---

<div class="spotify-frame" style={`--accent:${accent}; --h:${height}px`}>
  {hasId ? (
    <iframe
      src={src}
      width="100%"
      height={height}
      frameborder="0"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      title={`Spotify ${kind}`}
    ></iframe>
  ) : (
    <div class="placeholder" role="img" aria-label="no track loaded">
      <svg viewBox="0 0 32 32" width="64" height="64" shape-rendering="crispEdges" aria-hidden="true">
        {/* pixel-art vinyl record */}
        <rect x="6" y="6" width="20" height="20" fill="#1a1208" />
        <rect x="5" y="7" width="1" height="18" fill="#1a1208" />
        <rect x="26" y="7" width="1" height="18" fill="#1a1208" />
        <rect x="7" y="5" width="18" height="1" fill="#1a1208" />
        <rect x="7" y="26" width="18" height="1" fill="#1a1208" />
        <rect x="11" y="11" width="10" height="10" fill="var(--accent)" />
        <rect x="14" y="14" width="4" height="4" fill="#1a1208" />
        <rect x="15" y="15" width="2" height="2" fill="#f3eee0" />
      </svg>
      <span class="placeholder-label">{placeholderLabel}</span>
    </div>
  )}
</div>

<style>
  .spotify-frame {
    border: 2px solid #1a1208;
    box-shadow: 4px 4px 0 0 var(--accent);
    border-radius: 12px;
    overflow: hidden;
    background: #f3eee0;
    min-height: var(--h);
  }
  .spotify-frame iframe {
    display: block;
    border-radius: 10px;
  }
  .placeholder {
    height: var(--h);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: repeating-linear-gradient(
      45deg,
      #f3eee0 0 8px,
      #ece5d2 8px 16px
    );
  }
  .placeholder-label {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.75rem;
    color: #5F5E5A;
    text-transform: lowercase;
    letter-spacing: 0.05em;
  }
</style>
