---
/**
 * LASportsTicker — Mike's five LA / SoCal teams in a single ticker
 * row. Complements SportsStrip (which is league-wide global majors).
 *
 * From the engagement plan §2.2 "Sports Ticker":
 *   "Dodgers, Lakers, Kings, Chargers, Galaxy.
 *    Format: 'Dodgers 4, Rockies 2 · Final' or 'Lakers @ Nuggets · 7:30p'.
 *    Just scores + next game. No commentary."
 *
 * Each row pulls ESPN's site.api.espn.com team endpoint, reads the
 * team's `nextEvent` (which can be in-progress, just-finished, or
 * upcoming depending on timing) and renders one tight line.
 *
 * Cache: 10min sessionStorage TTL (matches SportsStrip).
 *
 * Off-season / bye gracefully shows "no scheduled match" rather than
 * a fake score.
 */

const TEAMS = [
  { id: 'dodgers', name: 'DODGERS', emoji: '⚾', league: 'mlb',  path: 'baseball/mlb', tid: '19',  color: '#005A9C', siteSlug: 'lad' },
  { id: 'lakers',  name: 'LAKERS',  emoji: '🏀', league: 'nba',  path: 'basketball/nba', tid: '13', color: '#552583', siteSlug: 'lal' },
  { id: 'kings',   name: 'KINGS',   emoji: '🏒', league: 'nhl',  path: 'hockey/nhl', tid: '8',     color: '#111111', siteSlug: 'la' },
  { id: 'chargers',name: 'CHARGERS',emoji: '🏈', league: 'nfl',  path: 'football/nfl', tid: '24',  color: '#0080C6', siteSlug: 'lac' },
  { id: 'galaxy',  name: 'GALAXY',  emoji: '⚽', league: 'mls',  path: 'soccer/usa.1', tid: '187', color: '#00245D', siteSlug: 'la' },
];
---

<aside class="la-ticker" aria-label="LA sports ticker">
  <header class="la-ticker__head">
    <p class="la-ticker__kicker mono">LA SPORTS · TICKER · 25 MILE RADIUS</p>
    <span class="la-ticker__updated mono" data-la-ticker-updated hidden></span>
  </header>
  <ol class="la-ticker__list">
    {TEAMS.map((t) => (
      <li
        class="la-ticker__row"
        data-team={t.id}
        data-path={t.path}
        data-tid={t.tid}
        data-league={t.league}
        style={`--team-color: ${t.color}`}
      >
        <span class="la-ticker__chip" aria-hidden="true">{t.emoji}</span>
        <span class="la-ticker__name mono">{t.name}</span>
        <span class="la-ticker__line" data-la-line>loading…</span>
        <a
          class="la-ticker__link mono"
          href={`https://www.espn.com/${t.league}/team/_/name/${t.siteSlug}`}
          target="_blank"
          rel="noopener"
          aria-label={`${t.name} on ESPN`}
        >→</a>
      </li>
    ))}
  </ol>
</aside>

<script is:inline>
(function () {
  'use strict';
  var root = document.querySelector('aside.la-ticker');
  if (!root) return;
  var rows = root.querySelectorAll('.la-ticker__row');
  if (!rows.length) return;

  var CACHE_PREFIX = 'pc:la-ticker:v1:';
  var TTL_MS = 10 * 60 * 1000;

  function readCache(k) {
    try {
      var raw = sessionStorage.getItem(CACHE_PREFIX + k);
      if (!raw) return null;
      var p = JSON.parse(raw);
      if (!p || !p.at || (Date.now() - p.at) > TTL_MS) return null;
      return p.data;
    } catch (e) { return null; }
  }
  function writeCache(k, d) {
    try { sessionStorage.setItem(CACHE_PREFIX + k, JSON.stringify({ at: Date.now(), data: d })); } catch (e) {}
  }
  function fmtTime(iso) {
    if (!iso) return '';
    try {
      var d = new Date(iso);
      return new Intl.DateTimeFormat('en-US', {
        weekday: 'short', hour: 'numeric', minute: '2-digit',
        timeZone: 'America/Los_Angeles', timeZoneName: 'short',
      }).format(d);
    } catch (e) { return ''; }
  }
  function shortDate(iso) {
    if (!iso) return '';
    try {
      var d = new Date(iso);
      return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/Los_Angeles' }).format(d);
    } catch (e) { return ''; }
  }
  function safeAbbr(team, fallback) {
    if (!team) return fallback;
    return team.abbreviation || team.shortDisplayName || team.displayName || fallback;
  }

  function describe(event, ourTid) {
    if (!event) return null;
    var comp = event.competitions && event.competitions[0];
    if (!comp) return null;
    var competitors = comp.competitors || [];
    var us, them, isHome;
    competitors.forEach(function (c) {
      var tid = (c.team && (c.team.id || c.id)) ? String(c.team.id || c.id) : '';
      if (tid === String(ourTid)) { us = c; isHome = c.homeAway === 'home'; }
      else { them = c; }
    });
    if (!us || !them) return null;
    var status = (comp.status && comp.status.type && comp.status.type.state) || (event.status && event.status.type && event.status.type.state) || 'pre';
    var shortDetail = (comp.status && comp.status.type && comp.status.type.shortDetail) ||
                      (event.status && event.status.type && event.status.type.shortDetail) || '';
    function readScore(s) {
      if (s == null) return '';
      if (typeof s === 'object') return s.displayValue != null ? String(s.displayValue) : (s.value != null ? String(s.value) : '');
      return String(s);
    }
    var usScore = readScore(us.score);
    var themScore = readScore(them.score);
    var themAbbr = safeAbbr(them.team, '—');
    var hot = false;
    var us_n = parseInt(usScore, 10), th_n = parseInt(themScore, 10);
    if (isFinite(us_n) && isFinite(th_n)) {
      var diff = Math.abs(us_n - th_n);
      var dl = (shortDetail || '').toLowerCase();
      if (/ot|extra|shootout|penalt|so|et/.test(dl)) hot = true;
      else if (status === 'post' && diff <= 3) hot = true;
      else if (status === 'in' && diff <= 2) hot = true;
    }
    var won = us.winner === true;
    var lost = them.winner === true;

    var line = '';
    if (status === 'post') {
      var verdict = won ? 'W' : (lost ? 'L' : '·');
      line = verdict + ' ' + usScore + '-' + themScore + ' ' + (isHome ? 'vs' : '@') + ' ' + themAbbr + ' · Final';
      if (/ot|extra|shootout|so/.test((shortDetail || '').toLowerCase())) {
        line = line.replace('· Final', '· ' + shortDetail);
      }
    } else if (status === 'in') {
      line = usScore + '-' + themScore + ' ' + (isHome ? 'vs' : '@') + ' ' + themAbbr + ' · ' + (shortDetail || 'LIVE');
    } else {
      // pre
      var when = event.date || (comp && comp.date);
      var t = fmtTime(when);
      line = (isHome ? 'vs ' : '@ ') + themAbbr + (t ? ' · ' + t : '');
    }
    return { status: status, hot: hot, line: line };
  }

  function renderRow(row, info, errorMsg) {
    var lineEl = row.querySelector('[data-la-line]');
    if (!lineEl) return;
    row.classList.remove('la-ticker__row--live', 'la-ticker__row--final', 'la-ticker__row--pre', 'la-ticker__row--hot', 'la-ticker__row--idle');
    if (errorMsg) {
      row.classList.add('la-ticker__row--idle');
      lineEl.textContent = errorMsg;
      return;
    }
    if (!info) {
      row.classList.add('la-ticker__row--idle');
      lineEl.textContent = 'no scheduled match';
      return;
    }
    if (info.status === 'in') row.classList.add('la-ticker__row--live');
    else if (info.status === 'post') row.classList.add('la-ticker__row--final');
    else row.classList.add('la-ticker__row--pre');
    if (info.hot) row.classList.add('la-ticker__row--hot');
    lineEl.textContent = info.line + (info.hot ? '  ⚡' : '');
  }

  function pickEvent(team, ourTid) {
    if (!team) return null;
    var pool = [];
    if (team.nextEvent) pool = pool.concat(team.nextEvent);
    if (team.previousEvent) pool = pool.concat(team.previousEvent);
    var picked = null;
    pool.forEach(function (ev) {
      var d = describe(ev, ourTid);
      if (!d) return;
      if (!picked) { picked = { d: d, ev: ev }; return; }
      // Prefer in > post > pre.
      var order = { in: 3, post: 2, pre: 1 };
      if ((order[d.status] || 0) > (order[picked.d.status] || 0)) picked = { d: d, ev: ev };
    });
    return picked ? picked.d : null;
  }

  function loadRow(row) {
    var path = row.dataset.path;
    var tid = row.dataset.tid;
    var team = row.dataset.team;
    if (!path || !tid || !team) return;
    var cached = readCache(team);
    if (cached) { renderRow(row, cached); return; }

    var url = 'https://site.api.espn.com/apis/site/v2/sports/' + path + '/teams/' + tid;
    fetch(url, { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        var info = pickEvent(data && data.team, tid);
        writeCache(team, info);
        renderRow(row, info);
      })
      .catch(function () { renderRow(row, null, 'check ESPN'); });
  }

  function init() {
    rows.forEach(function (row) { loadRow(row); });
    var stamp = root.querySelector('[data-la-ticker-updated]');
    if (stamp) {
      try {
        stamp.textContent = 'updated ' + new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles' }).format(new Date());
        stamp.hidden = false;
      } catch (e) {}
    }
  }

  try { init(); } catch (e) {}
  document.addEventListener('astro:page-load', function () { try { init(); } catch (e) {} });
})();
</script>

<style is:global>
  .la-ticker {
    margin: 14px 0 18px;
    padding: 12px 14px;
    border: 2px solid var(--pc-ink, #1a1a1a);
    background:
      linear-gradient(180deg, #fff 0%, #fff7ec 100%),
      repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.03) 0 2px, transparent 2px 6px);
    box-shadow: 4px 4px 0 var(--pc-ink, #1a1a1a);
  }

  .la-ticker__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    border-bottom: 1.5px dashed var(--pc-ink, #1a1a1a);
    padding-bottom: 6px;
  }

  .la-ticker__kicker {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pc-ink, #1a1a1a);
    font-weight: 700;
  }

  .la-ticker__updated {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--pc-ink-muted, #5b5b55);
    text-transform: uppercase;
  }

  .la-ticker__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .la-ticker__row {
    display: grid;
    grid-template-columns: 28px 84px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border: 1px solid var(--team-color, #1a1a1a);
    background: #fff;
    box-shadow: 2px 2px 0 var(--team-color, #1a1a1a);
    transition: transform 0.08s ease;
  }

  .la-ticker__row:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--team-color, #1a1a1a);
  }

  .la-ticker__row--live {
    background: #fff8d6;
  }

  .la-ticker__row--hot {
    background: #ffe2c4;
  }

  .la-ticker__row--idle {
    opacity: 0.7;
  }

  .la-ticker__chip {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
    background: var(--team-color, #1a1a1a);
    border: 1px solid var(--pc-ink, #1a1a1a);
    color: #fff;
  }

  .la-ticker__name {
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--team-color, #1a1a1a);
  }

  .la-ticker__line {
    font-size: 13px;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    color: var(--pc-ink, #1a1a1a);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .la-ticker__row--live .la-ticker__line {
    color: #c95c2e;
    font-weight: 700;
  }

  .la-ticker__link {
    font-size: 13px;
    color: var(--team-color, #1a1a1a);
    text-decoration: none;
    border: 1px solid var(--team-color, #1a1a1a);
    padding: 3px 7px;
    line-height: 1;
  }

  .la-ticker__link:hover {
    background: var(--team-color, #1a1a1a);
    color: #fff;
  }

  .la-ticker .mono {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
  }

  @media (max-width: 720px) {
    .la-ticker__row {
      grid-template-columns: 24px minmax(0, 1fr) auto;
      grid-template-areas:
        "chip name link"
        "chip line link";
      gap: 2px 8px;
      padding: 6px 7px;
    }
    .la-ticker__chip { grid-area: chip; align-self: center; width: 22px; height: 22px; font-size: 13px; }
    .la-ticker__name { grid-area: name; font-size: 10px; }
    .la-ticker__line { grid-area: line; font-size: 12px; white-space: normal; line-height: 1.25; }
    .la-ticker__link { grid-area: link; align-self: center; }
  }
</style>
