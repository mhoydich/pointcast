---
const { active = 'characters' } = Astro.props;
const modes = [
  { id: 'characters', title: 'Characters', description: 'Step into a small fictional world.', href: '/open-channel/', number: '01' },
  { id: 'pitch', title: 'Pitch Room', description: 'Find your words. Practice the moment.', href: '/open-channel/pitch-room/', number: '02' },
  { id: 'story', title: 'Story Booth', description: 'Give a loose idea a little shape.', href: '/open-channel/story-booth/', number: '03' },
];
---
<nav class="oc-modes" aria-label="Open Channel modes">
  {modes.map(mode => <a href={mode.href} aria-current={active === mode.id ? 'page' : undefined}><span class="oc-mode-number">{mode.number}</span><span><strong>{mode.title}</strong><small>{mode.description}</small></span><span class="oc-mode-arrow" aria-hidden="true">↗</span></a>)}
</nav>
<style>
.oc-modes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:4px 0 24px}.oc-modes a{display:flex;align-items:center;gap:13px;padding:17px 18px;border:1px solid #bdc7b3;border-radius:5px;text-decoration:none;color:#283522;position:relative}.oc-modes a:hover{background:#e2e7d9}.oc-modes a[aria-current=page]{background:#dce4ce;border-color:#8e9b7a}.oc-mode-number{font:10px ui-monospace,monospace;color:#67765b}.oc-modes strong{display:block;font-size:15px;font-weight:600}.oc-modes small{display:block;font-size:11px;color:#627257;margin-top:3px}.oc-mode-arrow{font-size:19px;margin-left:auto}.oc-modes a:focus-visible{outline:3px solid #9a4d2f;outline-offset:4px}@media(max-width:700px){.oc-modes{gap:7px;margin-bottom:18px}.oc-modes a{display:block;padding:12px 9px}.oc-modes strong{font-size:12px;margin-top:5px}.oc-modes small{display:none}.oc-mode-arrow{position:absolute;right:9px;top:8px;font-size:15px}}
</style>
