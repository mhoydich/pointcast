---
/**
 * HomeShopShelf — the front door's window into the PointCast Shop.
 * Sits under "New today". Cards come from src/lib/shop-front.ts so the
 * shelf, the shop front and /shop/front.json never disagree.
 */
import { SHOP_GUIDES, SHOP_PICKS, SHOP_FRONT_PATH } from '../lib/shop-front';

const guides = SHOP_GUIDES.slice(0, 5);
const priced = SHOP_PICKS.filter((p) => p.price !== null).length;
---
<section class="hss" id="shop" aria-labelledby="hss-title">
  <header class="hss__head">
    <p class="hss__kicker"><span class="hss__dot" aria-hidden="true"></span>NEW · THE POINTCAST SHOP IS OPEN</p>
    <h2 id="hss-title"><a href={SHOP_FRONT_PATH}>Things worth carrying home.</a></h2>
    <p class="hss__dek">Buying guides from El Segundo: {SHOP_GUIDES.length} guides, {SHOP_PICKS.length} picks, {priced} with a dated price, 0 paid links.</p>
    <a class="hss__cta" href={SHOP_FRONT_PATH}>Walk into the shop →</a>
  </header>
  <ul class="hss__row">
    {guides.map((g) => (
      <li>
        <a href={g.href}>
          <span class="hss__img"><img src={g.image} alt="" loading="lazy" width="320" height="240" /></span>
          <span class="hss__meta">{g.kind} · {g.count} {g.countLabel}</span>
          <strong>{g.title}</strong>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hss { --ink:#111; --cobalt:#1f3fe0; --sun:#f6d615; margin: 28px auto; max-width: 1280px; padding: 24px; background: #e9e9e4; border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); color: var(--ink); font-family: Arial, Helvetica, sans-serif; }
  .hss a { color: inherit; }
  .hss__head { display: grid; grid-template-columns: 1fr auto; gap: 4px 24px; align-items: end; margin-bottom: 18px; }
  .hss__kicker { grid-column: 1 / -1; margin: 0; font: 700 11px/1.6 ui-monospace, Menlo, monospace; letter-spacing: 1.6px; color: var(--cobalt); }
  .hss__dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #e8401c; margin-right: 8px; vertical-align: 1px; animation: hss-blink 1.6s steps(2) infinite; }
  @keyframes hss-blink { 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .hss__dot { animation: none; } }
  .hss h2 { margin: 0; font-size: clamp(28px, 4vw, 48px); line-height: 1; letter-spacing: -.045em; }
  .hss h2 a { text-decoration: none; }
  .hss__dek { margin: 6px 0 0; font-size: 15px; line-height: 1.5; color: #33332f; }
  .hss__cta { grid-row: 2 / 4; grid-column: 2; align-self: center; display: inline-flex; align-items: center; min-height: 48px; padding: 12px 18px; background: var(--sun); border: 1px solid var(--ink); font-weight: 700; font-size: 14px; text-decoration: none; white-space: nowrap; }
  .hss__cta:hover { background: #fff; }
  .hss__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .hss__row a { display: flex; flex-direction: column; gap: 6px; height: 100%; text-decoration: none; background: #f6f6f2; border: 1px solid var(--ink); padding: 10px; }
  .hss__row a:hover { background: #fff; }
  .hss__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #fff; }
  .hss__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hss__meta { font: 700 10px/1.4 ui-monospace, Menlo, monospace; letter-spacing: 1px; text-transform: uppercase; color: var(--cobalt); }
  .hss__row strong { font-size: 15px; line-height: 1.25; }
  .hss a:focus-visible { outline: 3px solid #e8401c; outline-offset: 3px; }
  @media (max-width: 1000px) { .hss__row { grid-template-columns: repeat(3, 1fr); } .hss__row li:nth-child(n+4) { display: none; } }
  @media (max-width: 700px) {
    .hss { margin: 20px 16px; padding: 18px 16px; box-shadow: 4px 4px 0 var(--ink); }
    .hss__head { grid-template-columns: 1fr; }
    .hss__cta { grid-row: auto; grid-column: 1; justify-self: start; margin-top: 10px; }
    .hss__row { grid-template-columns: 1fr 1fr; }
    .hss__row li:nth-child(n+4) { display: block; }
    .hss__row li:nth-child(n+5) { display: none; }
  }
</style>
