---
/**
 * HomeShopShelf — the front door's window into the PointCast Shop.
 * `hero` makes it the top of the homepage (owns the page h1; pass `demote`
 * to HomeShortwaveHero when you do). Cards come from src/lib/shop-front.ts
 * so the shelf, the shop front and /shop/front.json never disagree.
 */
import { SHOP_GUIDES, SHOP_PICKS, SHOP_FRONT_PATH, LAUNCHED_ON } from '../lib/shop-front';

const { hero = false } = Astro.props as { hero?: boolean };
const Heading = hero ? 'h1' : 'h2';
const guides = SHOP_GUIDES.slice(0, 5);
const priced = SHOP_PICKS.filter((p) => p.price !== null).length;
const launchDay = new Date(`${LAUNCHED_ON}T12:00:00-07:00`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/Los_Angeles' });
---
<section class:list={['hss', { 'hss--hero': hero }]} id="shop" aria-labelledby="hss-title">
  <div class="hss__top">
    <header class="hss__head">
      <p class="hss__kicker"><span class="hss__dot" aria-hidden="true"></span>OPENED {launchDay.toUpperCase()} · SHOP.POINTCAST.XYZ</p>
      <Heading id="hss-title" class="hss__title"><a href={SHOP_FRONT_PATH}>The PointCast Shop is open.<br /><em>Things worth carrying home.</em></a></Heading>
      <p class="hss__dek">Buying guides from El Segundo. Every price dated, every pick in one list, and no paid links. Readable by people and agents.</p>
      <div class="hss__actions">
        <a class="hss__cta" href={SHOP_FRONT_PATH}>Walk into the shop →</a>
        <a class="hss__cta hss__cta--ghost" href={`${SHOP_FRONT_PATH}#picks`}>Every pick, one list</a>
      </div>
      <dl class="hss__stats">
        <div><dt>Guides</dt><dd>{SHOP_GUIDES.length}</dd></div>
        <div><dt>Picks</dt><dd>{SHOP_PICKS.length}</dd></div>
        <div><dt>Dated prices</dt><dd>{priced}</dd></div>
        <div><dt>Paid links</dt><dd>0</dd></div>
      </dl>
    </header>
    {hero && (
      <a class="hss__art" href={SHOP_FRONT_PATH} tabindex="-1" aria-hidden="true">
        <span class="hss__sign">WE’RE<br /><b>OPEN</b></span>
        <img src="/images/bags/carry-kit.jpg" alt="" width="1200" height="1200" fetchpriority="high" />
      </a>
    )}
  </div>
  <ul class="hss__row">
    {guides.map((g) => (
      <li>
        <a href={g.href}>
          <span class="hss__img"><img src={g.image} alt="" loading={hero ? 'eager' : 'lazy'} width="320" height="240" /></span>
          <span class="hss__meta">{g.kind} · {g.count} {g.countLabel}</span>
          <strong>{g.title}</strong>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hss { --ink:#111; --cobalt:#1f3fe0; --sun:#f6d615; --red:#e8401c; margin: 28px auto; max-width: 1280px; padding: 24px; background: #e9e9e4; border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); color: var(--ink); font-family: Arial, Helvetica, sans-serif; }
  .hss a { color: inherit; }
  .hss__top { display: grid; grid-template-columns: 1fr; gap: 28px; margin-bottom: 22px; }
  .hss--hero .hss__top { grid-template-columns: 1.15fr .85fr; align-items: center; }
  .hss__kicker { margin: 0 0 12px; font: 700 11px/1.6 ui-monospace, Menlo, monospace; letter-spacing: 1.6px; color: var(--cobalt); }
  .hss__dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--red); margin-right: 8px; vertical-align: 1px; animation: hss-blink 1.6s steps(2) infinite; }
  @keyframes hss-blink { 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .hss__dot { animation: none; } }
  .hss .hss__title { margin: 0; font-size: clamp(28px, 4vw, 48px); line-height: .98; letter-spacing: -.045em; }
  .hss--hero .hss__title { font-size: clamp(40px, 5.6vw, 84px); line-height: .92; letter-spacing: -.06em; }
  .hss .hss__title em { font-family: Georgia, serif; font-weight: 400; font-style: italic; color: var(--cobalt); }
  .hss .hss__title a { text-decoration: none; }
  .hss__dek { margin: 16px 0 0; font-size: 17px; line-height: 1.5; color: #33332f; max-width: 46ch; }
  .hss__actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .hss__cta { display: inline-flex; align-items: center; min-height: 48px; padding: 12px 18px; background: var(--sun); border: 1px solid var(--ink); font-weight: 700; font-size: 14px; text-decoration: none; white-space: nowrap; }
  .hss__cta--ghost { background: transparent; }
  .hss__cta:hover { background: #fff; }
  .hss__stats { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 0 28px; margin: 22px 0 0; }
  .hss__stats div { display: flex; flex-direction: column-reverse; }
  .hss__stats dt { font: 700 10px/1.4 ui-monospace, Menlo, monospace; letter-spacing: 1.2px; text-transform: uppercase; color: #55554f; }
  .hss__stats dd { margin: 0; font-size: 30px; font-weight: 700; letter-spacing: -1.5px; color: var(--cobalt); }
  .hss__art { position: relative; display: block; background: #fff; border: 2px solid var(--ink); }
  .hss__art img { display: block; width: 100%; height: auto; }
  .hss__sign { position: absolute; top: -14px; left: -14px; z-index: 1; background: var(--red); color: #fff; border: 3px solid var(--ink); padding: 8px 12px; font: 700 11px/1.1 ui-monospace, Menlo, monospace; letter-spacing: 2px; transform: rotate(-6deg); box-shadow: 4px 4px 0 var(--ink); }
  .hss__sign b { font-size: 24px; }
  .hss__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .hss__row a { display: flex; flex-direction: column; gap: 6px; height: 100%; text-decoration: none; background: #f6f6f2; border: 1px solid var(--ink); padding: 10px; }
  .hss__row a:hover { background: #fff; }
  .hss__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #fff; }
  .hss__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hss__meta { font: 700 10px/1.4 ui-monospace, Menlo, monospace; letter-spacing: 1px; text-transform: uppercase; color: var(--cobalt); }
  .hss__row strong { font-size: 15px; line-height: 1.25; }
  .hss a:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }
  @media (max-width: 1000px) { .hss__row { grid-template-columns: repeat(3, 1fr); } .hss__row li:nth-child(n+4) { display: none; } }
  @media (max-width: 760px) {
    .hss { margin: 16px; padding: 18px 16px; box-shadow: 4px 4px 0 var(--ink); }
    .hss--hero .hss__top { grid-template-columns: 1fr; }
    .hss--hero .hss__art { margin: 18px 4px 0 10px; max-width: 420px; }
    .hss__stats { grid-template-columns: repeat(2, auto); gap: 8px 28px; }
    .hss__row { grid-template-columns: 1fr 1fr; }
    .hss__row li:nth-child(n+4) { display: block; }
    .hss__row li:nth-child(n+5) { display: none; }
  }
</style>
