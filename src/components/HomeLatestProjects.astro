---
import projects from '../data/home-latest-projects.json';
---
<section class="home-projects-now" aria-labelledby="home-projects-now-title" data-home-latest-projects>
  <header><div><p class="home-projects-now__kicker">The workshop is open</p><h2 id="home-projects-now-title">Latest from PointCast.</h2></div><a href="/apps/">Browse all projects ↗</a></header>
  <ol>{projects.map((project,i) => <li><a href={project.href}><div class="home-projects-now__art"><img src={project.image} alt="" width="480" height="240" loading="lazy" decoding="async"/><span aria-hidden="true">0{i+1}</span></div><div class="home-projects-now__copy"><p class="home-projects-now__kicker">{project.group}</p><h3>{project.title}</h3><p>{project.dek}</p><span class="home-projects-now__open">Explore <span aria-hidden="true">↗</span></span></div></a></li>)}</ol>
  <nav aria-label="Find your part of PointCast"><a href="#magazine">Read the magazine</a><a href="/play">Play something</a><a href="/drum">Make some music</a><a href="/shop/front">Useful buying guides</a><a href="/intern/">The project desk</a><a href="/for-agents">Bring your agent</a></nav>
</section>
<style>
.home-projects-now{--ink:#23272A;--muted:#4e5c68;--paper:#F5F1E7;color:var(--ink);margin:28px 0 36px}.home-projects-now header{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:16px}.home-projects-now h2{font-size:clamp(25px,3vw,36px);line-height:1.1;letter-spacing:-.04em;margin:0}.home-projects-now header>a{color:inherit;min-height:44px;display:flex;align-items:center;font-size:13px}.home-projects-now__kicker{font:500 9px/1.5 var(--pc-font-mono);letter-spacing:.06em;text-transform:uppercase;margin:0 0 8px;color:var(--muted)}.home-projects-now ol{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));list-style:none;padding:0;margin:0;gap:10px}.home-projects-now li{min-width:0}.home-projects-now li>a{display:flex;flex-direction:column;height:100%;text-decoration:none;color:inherit;border:1px solid #aeb9c1;background:var(--paper)}.home-projects-now li>a:hover{border-color:#2549DD}.home-projects-now__art{height:100px;position:relative;overflow:hidden;background:#eee8dd}.home-projects-now__art img{display:block;width:100%;height:100%;object-fit:cover}.home-projects-now__art span{position:absolute;left:8px;bottom:8px;background:#F5F1E7;color:#23272A;padding:3px 5px;font:500 9px var(--pc-font-mono)}.home-projects-now__copy{padding:14px;display:flex;flex-direction:column;flex:1}.home-projects-now h3{font-size:20px;line-height:1.15;margin:0;letter-spacing:-.03em}.home-projects-now__copy>p:not(.home-projects-now__kicker){font-size:12px;line-height:1.55;color:var(--muted);margin:10px 0 16px}.home-projects-now__open{margin-top:auto;display:flex;justify-content:space-between;font-size:12px}.home-projects-now nav{display:flex;flex-wrap:wrap;gap:0 22px;border-bottom:1px solid #aeb9c1;margin-top:14px}.home-projects-now nav a{min-height:44px;display:inline-flex;align-items:center;color:inherit;font-size:12px;text-underline-offset:4px}.home-projects-now a:focus-visible{outline:3px solid #E94D34;outline-offset:3px}@media(max-width:1000px){.home-projects-now ol{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:650px){.home-projects-now ol{grid-template-columns:1fr 1fr}.home-projects-now header{align-items:start;flex-direction:column;gap:4px}.home-projects-now__copy{padding:12px}.home-projects-now h3{font-size:19px}}@media(max-width:360px){.home-projects-now ol{grid-template-columns:1fr}}@media(prefers-color-scheme:dark){.home-projects-now{--ink:#F5F1E7;--muted:#b8c6d0;--paper:#1d2633}}
</style>
