---
import { POINTCAST_25 } from '../lib/pointcast-25';
const path = Astro.url.pathname.replace(/\/$/, '');
const current = ['/25', '/25/disagreements', '/25/receipts', '/25/season', '/25/directory', '/25/magazine'].includes(path) || path.startsWith('/25/teams/');
const archive = path.startsWith('/25/boards/');
const feature = path.startsWith('/25/magazine/') || path === '/25/alabama-after-saban';
---
<aside class="football-desk" aria-label="College football edition and departments">
  <div><a href="/25"><strong>POINTCAST COLLEGE FOOTBALL</strong></a><span>BOARD {POINTCAST_25.board} · {POINTCAST_25.editionLabel}</span></div>
  <nav aria-label="College football departments">
    <a href="/25">Rankings</a><a href="/25/disagreements">Disagreements</a><a href="/25/receipts">Receipts</a><a href="/25/directory">College finder</a><a href="/25/magazine">Magazine</a><a href="/25/fan-clique">Fan Clique</a><a href="/25/season">Archive</a>
  </nav>
  <p>{archive ? 'Permanent edition — rankings and reasons are preserved as published.' : current ? 'Results through September 19 · AP comparison dated September 20 · editorial review September 23. Movement is from the July opening board.' : feature ? 'Dated feature — retain the publication date shown below. Historical rankings and preseason forecasts are not the current board.' : 'Interactive department — game rosters and future-school studies retain their original edition. Current football rankings are on Board 001.'} <a href="/25#board">Read the current 25 →</a></p>
</aside>
<style>
.football-desk{background:#f4ff3f;color:#11110f;border-bottom:2px solid #11110f;padding:18px clamp(18px,4vw,64px);font:12px/1.5 var(--pc-font-sans);position:relative;z-index:2}
.football-desk>div{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.football-desk strong{letter-spacing:.08em}.football-desk a{color:inherit;text-underline-offset:3px}.football-desk nav{display:flex;gap:10px 20px;flex-wrap:wrap;margin:10px 0}.football-desk p{margin:0;max-width:1100px;font-size:12px}.football-desk a:focus-visible{outline:2px solid #111;outline-offset:4px}
</style>
