---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
const crescent = id === 'blue-hour-crescent';
const welcome = id === 'welcome-room';
const seats = crescent
  ? [{x:55,y:117,r:20},{x:132,y:161,r:0,wide:true},{x:212,y:105,r:-20},{x:244,y:190,r:-20,spare:true}]
  : [{x:91,y:80,r:-30},{x:211,y:80,r:30},{x:61,y:155,r:-75},{x:241,y:155,r:75,spare:true},...(!welcome ? [{x:102,y:216,r:-145}] : [])];
---
<figure class="room-plan">
  <svg viewBox="0 0 300 290" role="img" aria-label={`${title}: overhead seating sketch, with a highlighted spare chair and a clear entrance. ${welcome ? 'An outlined space is reserved for someone arriving in their own chair.' : ''}`}>
    <path class="shore" d="M15 33 Q52 18 90 33 T165 33 T240 33 T315 33 M15 41 Q52 26 90 41 T165 41 T240 41 T315 41" />
    <text x="150" y="18" text-anchor="middle" class="small">{crescent ? 'FACE THE WATER' : 'A LITTLE ROOM OUTSIDE'}</text>
    {!crescent && <ellipse cx="150" cy="141" rx="78" ry="74" class="gather" />}
    {seats.map((seat) => <g transform={`translate(${seat.x} ${seat.y}) rotate(${seat.r})`} class:list={['plan-seat',{'spare':seat.spare}]}>
      <rect x={seat.wide ? -39 : -18} y="-19" width={seat.wide ? 78 : 36} height="35" rx="5" />
      <path d={seat.wide ? 'M-39 9 L-39 24 L39 24 L39 9 M0 -15 V15' : 'M-19 8 L-19 24 L19 24 L19 8'} />
      {seat.spare && <text x="0" y="5" text-anchor="middle" class="plus">+</text>}
    </g>)}
    {welcome && <g><rect x="82" y="198" width="48" height="49" rx="9" class="own-place"/><text x="106" y="218" text-anchor="middle" class="small">YOUR</text><text x="106" y="233" text-anchor="middle" class="small">PLACE</text></g>}
    <path d="M174 269 L174 211 M168 218 L174 210 L180 218" class="entry" />
    <text x="190" y="260" class="small">COME ON IN</text>
    <text x="241" y={crescent ? '240' : '207'} text-anchor="middle" class="spare-label">THE SPARE</text>
  </svg>
  <figcaption>Overhead idea · arrange for your people, not to scale</figcaption>
</figure>
<style>
.room-plan{margin:0 0 27px}.room-plan svg{display:block;width:100%;height:auto;background:#244754;border-radius:3px}.shore{stroke:#b5d2c6;stroke-width:1;fill:none;opacity:.4}.small{font:8px Arial,sans-serif;letter-spacing:1px;fill:#d8e4dc}.gather{fill:none;stroke:#b5d2c6;stroke-dasharray:3 6;opacity:.25}.plan-seat rect{fill:#9db9ac;stroke:#d7e5d9;stroke-width:1.5}.plan-seat path{fill:none;stroke:#d7e5d9;stroke-width:3;stroke-linecap:round}.plan-seat.spare rect{fill:#e4ab71;stroke:#f5cea7}.plan-seat.spare path{stroke:#f5cea7}.plus{fill:#193b4a;font:22px Georgia,serif}.spare-label{font:8px Arial,sans-serif;letter-spacing:1px;fill:#f5cea7}.own-place{stroke:#d8e4dc;stroke-width:1.5;stroke-dasharray:4 4;fill:none}.entry{stroke:#d8e4dc;stroke-width:1.5;fill:none;stroke-linecap:round}.room-plan figcaption{font-size:9px;line-height:1.5;color:#c4d4c8;margin-top:10px}
</style>
