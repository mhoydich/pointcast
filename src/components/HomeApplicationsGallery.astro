---
/**
 * HomeApplicationsGallery — the things you can actually DO.
 *
 * 2026-05-16 evolution. The homepage middle was leading with feature
 * pushes ("walking bar v6.3 — ambient emotes"). Pivots to surface
 * what visitors can play with: drums, games, rooms to walk into,
 * things to make. Visual gallery, varied tile sizes, deliberately not
 * a uniform grid — closer to a Geocities awards wall than a SaaS
 * marketing page.
 *
 * Tiles are hand-curated. Each one is a working surface on the site
 * today. Order is "what's most fun to try right now" → "denser links
 * for the curious" at the bottom.
 *
 * Mobile collapses the asymmetric grid into a single-column flow
 * where each tile takes the full width.
 */
import { knownNodes } from '../data/nodes-registry';

interface Tile {
  href: string;
  label: string;
  blurb: string;
  kind: 'drum' | 'game' | 'room' | 'make' | 'walk' | 'agents';
  image?: string;
  size: 'lg' | 'md' | 'sm';
  emoji?: string;
}

// Big editorial pick — rotates with the hour so morning visitors get
// the meditation room and evening visitors get sunset.
const h = new Date().getHours();
const featured: Tile = h < 11
  ? {
      href: '/r/meditate',
      label: 'The meditation room',
      blurb: 'Three breathing programs, one shared choir. A two-minute tide you can actually finish.',
      kind: 'room',
      image: '/images/tokens/breathe-el-segundo.webp',
      size: 'lg',
    }
  : h >= 17 && h < 21
  ? {
      href: '/sunset',
      label: 'The magic hour',
      blurb: 'A room that only exists from 17:30 to 20:30. Right now it\'s open. Full-bleed woodblock sunset.',
      kind: 'room',
      image: '/bar/explorations/01-golden-hour-pixel-art.png',
      size: 'lg',
    }
  : {
      href: '/next',
      label: 'The town panel',
      blurb: 'A flat-color view of El Segundo as a clickable town. Nine rooms pinned to the scene; the sun drifts with the hour.',
      kind: 'walk',
      image: '/bar/explorations/01-golden-hour-pixel-art.png',
      size: 'lg',
    };

const tiles: Tile[] = [
  {
    href: '/drum-v6',
    label: 'Drum',
    blurb: 'Hear who else is drumming. Four pads, the whole room on the same bus.',
    kind: 'drum',
    image: '/bar/explorations/09-drum-hero.png',
    size: 'md',
  },
  {
    href: '/win95-games',
    label: 'Arcade',
    blurb: 'Solitaire, Mines, Pyramid, Memory. Windows 95 chrome.',
    kind: 'game',
    image: '/images/games/arcade-card-backs.webp',
    size: 'md',
  },
  {
    href: '/bar-v6',
    label: 'The bar',
    blurb: 'A pixel-art El Segundo street with companions, emotes, +cat. Live walkers.',
    kind: 'room',
    image: '/bar/explorations/01-golden-hour-pixel-art.png',
    size: 'md',
  },
  {
    href: '/kettle',
    label: 'Kettle',
    blurb: 'Make a pot. Slow.',
    kind: 'room',
    image: '/bar/explorations/07-kettle-hero.png',
    size: 'sm',
  },
  {
    href: '/studio',
    label: 'Studio',
    blurb: 'Make a block. Publish it.',
    kind: 'make',
    image: '/bar/explorations/08-studio-hero.png',
    size: 'sm',
  },
  {
    href: '/window',
    label: 'Window',
    blurb: 'El Segundo right now — weather, light, tide.',
    kind: 'walk',
    image: '/bar/explorations/10-window-hero.png',
    size: 'sm',
  },
  // SVG/text-led tiles for variety — no images
  {
    href: '/melody-bottle',
    label: 'Melody bottle',
    blurb: 'Write a 20-second tune. Drop it in a bottle. Share via iMessage.',
    kind: 'drum',
    emoji: '🎵',
    size: 'sm',
  },
  {
    href: '/song-of-the-day',
    label: 'Song of the day',
    blurb: 'A procedural pentatonic tune, deterministic per date. Same melody worldwide today.',
    kind: 'drum',
    emoji: '🎶',
    size: 'sm',
  },
  {
    href: '/drum-medley',
    label: 'Drum medley',
    blurb: 'Curate up to four bottles into one share-link.',
    kind: 'drum',
    emoji: '💿',
    size: 'sm',
  },
  {
    href: '/drum-genesis',
    label: 'Drum genesis',
    blurb: 'Remix two bottles into a third.',
    kind: 'drum',
    emoji: '🧬',
    size: 'sm',
  },
  {
    href: '/room-maker',
    label: 'Room maker',
    blurb: 'Configurator for the v1 Room Contract. Pick a template, get JSON.',
    kind: 'make',
    emoji: '🏗',
    size: 'sm',
  },
  {
    href: '/r/wall',
    label: 'The wall',
    blurb: 'Addable artifacts pinned to rooms. SVG, one-liners, Polaroids, links.',
    kind: 'make',
    emoji: '📌',
    size: 'sm',
  },
  {
    href: '/webring',
    label: 'Webring',
    blurb: `${knownNodes().length} node${knownNodes().length === 1 ? '' : 's'} on the federation, rooms, recent signals, fresh artifacts.`,
    kind: 'walk',
    emoji: '🛰',
    size: 'sm',
  },
  {
    href: '/embed-demo',
    label: 'Embed',
    blurb: '<pointcast-room id="…"> drops on any blog. Shadow DOM, no styles leak.',
    kind: 'agents',
    emoji: '📡',
    size: 'sm',
  },
];

const allTiles = [featured, ...tiles];
---

<section class="apps" aria-label="Applications">
  <header class="apps__head">
    <p class="apps__kicker mono">PLAY · MAKE · WALK INTO</p>
    <h2 class="apps__h">Things to do on PointCast.</h2>
    <p class="apps__sub">
      A drum that hears the room, an arcade in Windows 95 chrome, a bar full of walking
      companions, a meditation room with a shared choir. Plus tools to make rooms of your
      own and pin artifacts to them.
    </p>
  </header>

  <ul class="apps__grid">
    {allTiles.map((t) => (
      <li class={`apps__tile apps__tile--${t.size} apps__tile--${t.kind}`}>
        <a class="apps__link" href={t.href}>
          {t.image && (
            <div class="apps__media">
              <img class="apps__img" src={t.image} alt={t.label} loading="lazy" />
            </div>
          )}
          {!t.image && t.emoji && (
            <div class="apps__emoji" aria-hidden="true">{t.emoji}</div>
          )}
          <div class="apps__body">
            <p class="apps__kind mono">{t.kind}</p>
            <h3 class="apps__name">{t.label}</h3>
            <p class="apps__blurb">{t.blurb}</p>
            <span class="apps__cta mono">open →</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <p class="apps__foot mono">
    There are dozens more. <a href="/webring">Walk the webring →</a>
    <span aria-hidden="true"> · </span>
    <a href="/archive">Browse all blocks →</a>
  </p>
</section>

<style>
  .apps {
    margin: 0 0 36px;
  }

  .apps__head {
    margin: 0 0 22px;
    max-width: 720px;
  }
  .apps__kicker {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-warm, #c4952e);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .apps__h {
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin: 0 0 10px;
    color: var(--color-ink, #1f1b15);
  }
  .apps__sub {
    margin: 0;
    font-family: var(--font-serif, 'Lora', Georgia, serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-soft, #6a6154);
  }

  /* Asymmetric grid — lg spans 2 cols, md spans 1 wide, sm tight */
  .apps__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }
  .apps__tile {
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    border: 1.5px solid var(--color-rule, #ddd9cc);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .apps__tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(31, 27, 21, 0.14);
  }
  .apps__tile--lg { grid-column: span 6; }
  .apps__tile--md { grid-column: span 3; }
  .apps__tile--sm { grid-column: span 2; }

  /* Kind-tinted left border for visual variety */
  .apps__tile--drum   { border-left: 4px solid #c4952e; }
  .apps__tile--game   { border-left: 4px solid #d8624a; }
  .apps__tile--room   { border-left: 4px solid #1f5b48; }
  .apps__tile--make   { border-left: 4px solid #1b3a5b; }
  .apps__tile--walk   { border-left: 4px solid #874c1d; }
  .apps__tile--agents { border-left: 4px solid #5b2a4a; }

  .apps__link {
    display: grid;
    height: 100%;
    text-decoration: none;
    color: var(--color-ink, #1f1b15);
  }

  /* Big featured tile: image left, copy right */
  .apps__tile--lg .apps__link {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 0;
  }
  .apps__tile--lg .apps__media {
    background: #1f1b15;
    line-height: 0;
    height: 100%;
  }
  .apps__tile--lg .apps__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 220px;
  }
  .apps__tile--lg .apps__body {
    padding: 24px 26px 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }
  .apps__tile--lg .apps__name {
    font-size: clamp(24px, 2.6vw, 32px);
  }
  .apps__tile--lg .apps__blurb {
    font-size: 14.5px;
  }

  /* Medium tile: image top, copy bottom */
  .apps__tile--md .apps__media {
    background: #1f1b15;
    line-height: 0;
  }
  .apps__tile--md .apps__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .apps__tile--md .apps__body {
    padding: 14px 16px 16px;
  }

  /* Small tile: tight, image as side strip OR emoji card */
  .apps__tile--sm .apps__link {
    grid-template-rows: auto 1fr;
  }
  .apps__tile--sm .apps__media {
    background: #1f1b15;
    line-height: 0;
  }
  .apps__tile--sm .apps__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .apps__tile--sm .apps__emoji {
    font-size: 36px;
    padding: 18px 16px 6px;
    line-height: 1;
  }
  .apps__tile--sm .apps__body {
    padding: 8px 14px 14px;
  }

  /* Body content shared */
  .apps__kind {
    display: block;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--color-ink-soft, #6a6154);
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .apps__name {
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: 17px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: var(--color-ink, #1f1b15);
  }
  .apps__blurb {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-ink-soft, #6a6154);
  }
  .apps__cta {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--color-warm, #c4952e);
    text-transform: uppercase;
    font-weight: 700;
  }
  .apps__tile--drum .apps__cta   { color: #c4952e; }
  .apps__tile--game .apps__cta   { color: #d8624a; }
  .apps__tile--room .apps__cta   { color: #1f5b48; }
  .apps__tile--make .apps__cta   { color: #1b3a5b; }
  .apps__tile--walk .apps__cta   { color: #874c1d; }
  .apps__tile--agents .apps__cta { color: #5b2a4a; }

  .apps__foot {
    margin: 18px 0 0;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft, #6a6154);
  }
  .apps__foot a {
    color: var(--color-ink, #1f1b15);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule, #ddd9cc);
  }
  .apps__foot a:hover { border-bottom-color: currentColor; }

  /* Tablet — collapse to 4 cols */
  @media (max-width: 980px) {
    .apps__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .apps__tile--lg { grid-column: span 4; }
    .apps__tile--md { grid-column: span 2; }
    .apps__tile--sm { grid-column: span 2; }
    .apps__tile--lg .apps__link { grid-template-columns: 1fr; }
    .apps__tile--lg .apps__img { aspect-ratio: 16 / 9; min-height: 0; }
  }

  /* Mobile — single column, full-width tiles */
  @media (max-width: 600px) {
    .apps__grid { grid-template-columns: 1fr; gap: 10px; }
    .apps__tile--lg,
    .apps__tile--md,
    .apps__tile--sm { grid-column: span 1; }
    .apps__tile--lg .apps__body { padding: 18px 18px 18px; }
    .apps__tile--lg .apps__name { font-size: 22px; }
    .apps__tile--sm .apps__emoji { font-size: 30px; padding: 14px 14px 4px; }
  }
</style>
