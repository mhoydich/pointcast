---
import { CAMPUS_CARDS_CONTRACT, type CampusCard } from '../lib/campus-cards';

interface Props { card: CampusCard }
const { card } = Astro.props;
---

<div class="cc-mint" data-cc-mint data-contract={CAMPUS_CARDS_CONTRACT} data-token-id={card.tokenId} data-price={card.priceMutez} data-price-label={card.priceTez} data-edition={card.edition}>
  <label class="cc-mint__qty">
    <span>Qty</span>
    <select data-cc-qty disabled>
      {[1, 2, 3, 5, 10].map((n) => <option value={n}>{n}</option>)}
    </select>
  </label>
  <button type="button" class="cc-mint__button" data-cc-button disabled>Checking the contract…</button>
  <p class="cc-mint__state" data-cc-state>{card.edition}, {card.priceTez} each.</p>
</div>

<script>
  // The contract address lives in /api/campus-cards/state (set from /desk the
  // moment it is originated), so the room goes live without a redeploy.
  async function liveContract(fallback: string): Promise<{ contract: string; paused: boolean } | null> {
    let contract = fallback;
    try {
      const state = await fetch('/api/campus-cards/state').then((r) => (r.ok ? r.json() : null));
      if (state?.contract) contract = state.contract;
    } catch {}
    if (!contract.startsWith('KT1')) return null;
    try {
      const storage = await fetch(`https://api.tzkt.io/v1/contracts/${contract}/storage`).then((r) => (r.ok ? r.json() : null));
      return { contract, paused: Boolean(storage?.paused) };
    } catch { return { contract, paused: true }; }
  }

  async function mountCampusMint(): Promise<void> {
    const roots = [...document.querySelectorAll<HTMLElement>('[data-cc-mint]')].filter((r) => !r.dataset.mounted);
    if (!roots.length) return;
    roots.forEach((r) => { r.dataset.mounted = '1'; });
    const live = await liveContract(roots[0].dataset.contract ?? '');
    for (const root of roots) {
      const button = root.querySelector<HTMLButtonElement>('[data-cc-button]')!;
      const qty = root.querySelector<HTMLSelectElement>('[data-cc-qty]')!;
      const state = root.querySelector<HTMLElement>('[data-cc-state]')!;
      const price = root.dataset.priceLabel;
      if (!live) { button.textContent = 'Mint opens at origination'; state.textContent = `The contract is compiled and waiting on its signer. ${root.dataset.edition}, ${price} each.`; continue; }
      if (live.paused) { button.textContent = 'Minting opens soon'; state.textContent = `On chain and paused. ${root.dataset.edition}, ${price} each.`; continue; }
      button.disabled = false; qty.disabled = false;
      button.textContent = `Mint for ${price}`;
      state.textContent = `Kukai or any Tezos wallet. ${root.dataset.edition}. Proceeds go to the PointCast treasury.`;
      const idle = button.textContent;
      button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Opening wallet…';
        try {
          const { mintCampusCard } = await import('../lib/tezos');
          const result = await mintCampusCard({ contract: live.contract, tokenId: Number(root.dataset.tokenId), quantity: Number(qty.value), priceMutez: Number(root.dataset.price) });
          button.textContent = 'Waiting for a block…';
          state.innerHTML = `Sent. <a href="https://tzkt.io/${result.opHash}" target="_blank" rel="noopener">Watch it on TzKT →</a>`;
          await result.confirmation;
          button.textContent = 'In your wallet';
        } catch (error) {
          button.disabled = false;
          button.textContent = idle;
          state.textContent = error instanceof Error ? error.message : 'The wallet did not send it.';
        }
      });
    }
  }

  void mountCampusMint();
  document.addEventListener('astro:page-load', () => { void mountCampusMint(); });
</script>

<style>
  .cc-mint { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .cc-mint__qty { display: inline-flex; align-items: center; gap: 6px; font: 500 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .cc-mint__qty select { font: inherit; padding: 8px; border: 1.5px solid var(--pc-ink); background: #fff; border-radius: 0; }
  .cc-mint__button { padding: 11px 16px; border: 1.5px solid var(--pc-ink); background: var(--pc-ink); color: #fff; font: 600 12px var(--pc-font-mono); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; border-radius: 0; }
  .cc-mint__button:disabled { background: #fff; color: var(--pc-ink-muted); cursor: not-allowed; }
  .cc-mint__state { flex-basis: 100%; margin: 0; color: var(--pc-ink-soft); font-size: 13px; line-height: 1.45; }
</style>
