---
interface Highlight {
  title: string;
  href: string;
  dek: string;
  kicker: string;
  image: string;
  date: string;
  action: string;
}

interface Props { items: Highlight[] }
const { items } = Astro.props;
const shortDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T12:00:00Z`));
---

<section class="latest-shelf" id="fresh" aria-labelledby="latest-shelf-title">
  <header class="latest-shelf__head">
    <div>
      <p class="latest-shelf__eyebrow">From El Segundo, with curiosity</p>
      <h2 id="latest-shelf-title">A few more <em>good doors.</em></h2>
      <p class="latest-shelf__intro">A few fresh things to read, play, and try. Pick a door. Stay a little.</p>
    </div>
    <nav class="latest-shelf__browse" aria-label="More from PointCast">
      <a href="#magazine">More to read <span aria-hidden="true">↘</span></a>
      <a href="/play">More to play <span aria-hidden="true">↗</span></a>
      <a href="#new">Latest arrivals <span aria-hidden="true">↘</span></a>
    </nav>
  </header>
  <ol class="latest-shelf__grid">
    {items.map((item, i) => (
      <li>
        <a class="latest-shelf__card" href={item.href}>
          <div class="latest-shelf__art">
            <img src={item.image} alt="" width="480" height="240" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
            <span class="latest-shelf__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="latest-shelf__copy">
            <p class="latest-shelf__meta"><span>{item.kicker}</span><time datetime={item.date}>{shortDate(item.date)}</time></p>
            <h2>{item.title}</h2>
            <p class="latest-shelf__dek">{item.dek}</p>
            <span class="latest-shelf__action">{item.action} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .latest-shelf { --latest-ink: #17251f; --latest-green: #246c50; margin: 24px 0 32px; color: var(--latest-ink); }
  .latest-shelf__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 0 0 22px; }
  .latest-shelf__eyebrow { margin: 0 0 10px; font: 600 10px/1.4 var(--pc-font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--latest-green); }
  .latest-shelf #latest-shelf-title { margin: 0; font-size: clamp(34px, 4.8vw, 64px); line-height: 1.02; letter-spacing: -.05em; }
  .latest-shelf #latest-shelf-title em { font-family: Georgia, serif; font-weight: 400; color: var(--latest-green); }
  .latest-shelf__intro { margin: 12px 0 0; font-size: 15px; line-height: 1.5; }
  .latest-shelf__browse { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: flex-end; max-width: 330px; }
  .latest-shelf__browse a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 12px; font-weight: 600; color: var(--latest-green); text-underline-offset: 4px; }
  .latest-shelf__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; list-style: none; margin: 0; padding: 0; }
  .latest-shelf__grid li { min-width: 0; }
  .latest-shelf__card { display: flex; flex-direction: column; height: 100%; border: 1px solid #bbc5b9; background: #fffdf6; color: inherit; text-decoration: none; overflow: hidden; }
  .latest-shelf__card:hover { border-color: var(--latest-green); background: #f6f7ed; text-decoration: none; }
  .latest-shelf__art { position: relative; height: 132px; background: #e8ede3; overflow: hidden; }
  .latest-shelf__art img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .latest-shelf__number { position: absolute; bottom: 8px; left: 10px; padding: 4px 6px; background: #fffdf6; font: 600 10px/1 var(--pc-font-mono); }
  .latest-shelf__copy { display: flex; flex-direction: column; flex: 1; padding: 16px; }
  .latest-shelf__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 8px; margin: 0 0 9px; font: 500 9px/1.5 var(--pc-font-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--latest-green); }
  .latest-shelf__meta time { white-space: nowrap; color: #687165; }
  .latest-shelf h2 { margin: 0; font-size: 23px; line-height: 1.12; letter-spacing: -.035em; }
  .latest-shelf__dek { margin: 10px 0 18px; font-size: 13px; line-height: 1.5; color: #525d53; }
  .latest-shelf__action { display: flex; justify-content: space-between; gap: 8px; margin-top: auto; font-size: 12px; font-weight: 600; color: var(--latest-green); }
  .latest-shelf a:focus-visible { outline: 3px solid #ce492b; outline-offset: 3px; }
  @media (max-width: 760px) {
    .latest-shelf { margin: 20px 0 28px; }
    .latest-shelf__head { display: block; padding-bottom: 16px; }
    .latest-shelf__browse { justify-content: flex-start; max-width: none; gap: 0 16px; margin-top: 8px; }
    .latest-shelf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .latest-shelf__art { height: 96px; }
    .latest-shelf__copy { padding: 12px; }
    .latest-shelf h2 { font-size: 20px; }
    .latest-shelf__dek { font-size: 12px; margin-bottom: 14px; }
  }
  @media (max-width: 360px) {
    .latest-shelf__grid { grid-template-columns: 1fr; }
  }
</style>
