---
/**
 * TownLine — the deck above the dock (Bar v2, phase 1 · 2026-09-23).
 *
 * Mike: "the bar keeps jumping … make a next version, it can take up more
 * real estate, also needs to be mobile friendly, dynamic in some way."
 * PRD: "PointCast Bar v2: The Town Line" (Claude Doc, 2026-09-23).
 *
 * Three heights, one bar: the dock (FooterBar) is the still rail; this is
 * the deck, a lane of who is in town, right now, fed by the town socket
 * cursor-room.ts already runs (`pc:presence`, 1 Hz). Motion lives up here
 * so it never nudges the input below. The TUG rope rides as the deck's
 * top edge. Four Rosebud pads let every page drum with the town.
 *
 * Anti-jump contract: the status and pads columns are fixed widths, the
 * deck is a fixed height, tiles are keyed by Noun and only ever animate
 * transform/opacity. Collapsing is remembered (localStorage pc:deck).
 *
 * Tiles and bubbles are made by JS (town-line.ts), so their styles live in
 * the `is:global` block — scoped CSS never reaches runtime nodes.
 */
import TugRope from './TugRope.astro';
---

<section class="town" data-town-line data-open="true" data-crowd="empty" aria-label="Town line — who is in town right now">
  <TugRope />
  <div class="town__deck" data-pc-ref="town-deck">
    <button type="button" class="town__status" data-pc-ref="town-status" title="Who is in town — open attendance">
      <span class="town__count mono" data-pc-ref="town-count">1</span>
      <span class="town__status-text">
        <span class="town__here mono" data-pc-ref="town-here">in town</span>
        <span class="town__sub mono" data-pc-ref="town-sub">just you</span>
      </span>
    </button>
    <div class="town__lane" data-pc-ref="town-lane" role="list" aria-label="People and AIs in town"></div>
    <div class="town__pads" role="group" aria-label="Drum with the town">
      <span class="town__pads-label mono" aria-hidden="true">drum</span>
      <button type="button" class="town__pad" data-town-pad="kick" title="Root — low &amp; round (everyone here hears it)" aria-label="Drum: root">R</button>
      <button type="button" class="town__pad" data-town-pad="bloom" title="Bloom — paper snap" aria-label="Drum: bloom">B</button>
      <button type="button" class="town__pad" data-town-pad="dew" title="Dew — silver air" aria-label="Drum: dew">D</button>
      <button type="button" class="town__pad" data-town-pad="thorn" title="Thorn — dry bite" aria-label="Drum: thorn">T</button>
    </div>
    <div class="town__bubbles" data-pc-ref="town-bubbles" aria-live="polite"></div>
  </div>
  <button type="button" class="town__toggle mono" data-pc-ref="town-toggle" aria-expanded="true" title="Fold the town line away">
    <span class="town__toggle-open" aria-hidden="true">▾</span><span class="town__toggle-closed" aria-hidden="true">▴ town</span>
    <span class="sr-only">Toggle the town line</span>
  </button>
</section>

<style>
  .town {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 40px; /* sits on the 40px FooterBar rail */
    z-index: 39;  /* under the rail (40) and its trays (49) */
    pointer-events: none;
    font-family: 'Inter Variable', Inter, system-ui, sans-serif;
    --town-deck-h: 52px;
  }
  .mono { font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .town__deck {
    pointer-events: auto;
    position: relative;
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr) 150px;
    align-items: center;
    gap: 10px;
    height: var(--town-deck-h);
    padding: 0 40px 0 10px;
    background: #fbf6ea;
    border-top: 1px solid #d9ccb0;
    color: #2d1f08;
    transition: background-color .8s ease;
  }
  .town[data-crowd='warm'] .town__deck { background: #fcefd6; }
  .town[data-crowd='busy'] .town__deck { background: #fde3c0; }
  .town[data-beat='true'] .town__deck { box-shadow: inset 0 2px 0 #c2410c; }
  .town[data-open='false'] .town__deck { display: none; }

  .town__status {
    appearance: none; background: none; border: 0; padding: 0; margin: 0; cursor: pointer;
    display: flex; align-items: center; gap: 8px; width: 148px; min-width: 0; color: inherit; text-align: left;
  }
  .town__count {
    width: 4ch; flex: none; text-align: right;
    font-size: 22px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  }
  .town__status-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .town__here { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; }
  .town__sub { font-size: 9px; letter-spacing: 0.06em; color: #6b5a3a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .town__status:hover .town__here { text-decoration: underline; }

  .town__lane {
    display: flex; align-items: center; gap: 4px; height: 100%;
    overflow-x: auto; overflow-y: hidden; scrollbar-width: none; overscroll-behavior-x: contain;
    mask-image: linear-gradient(90deg, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent);
  }
  .town__lane::-webkit-scrollbar { display: none; }

  .town__pads { display: flex; align-items: center; gap: 4px; width: 150px; justify-content: flex-end; }
  .town__pads-label { font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: #6b5a3a; margin-right: 2px; }
  .town__pad {
    appearance: none; width: 28px; height: 28px; padding: 0; border: 1px solid #4e3a16; border-radius: 3px;
    font: 700 10px/1 'JetBrains Mono Variable', ui-monospace, monospace; color: #2d1f08; cursor: pointer;
    transition: transform .08s ease, filter .08s ease; touch-action: manipulation;
  }
  .town__pad[data-town-pad='kick'] { background: #efe6ce; }
  .town__pad[data-town-pad='bloom'] { background: #f3a0a6; }
  .town__pad[data-town-pad='dew'] { background: #f4d83e; }
  .town__pad[data-town-pad='thorn'] { background: #7aa279; }
  .town__pad:active, .town__pad[data-hit='true'] { transform: scale(.9); filter: brightness(1.12); }

  .town__bubbles { position: absolute; left: 0; right: 0; bottom: 100%; height: 0; pointer-events: none; }

  .town__toggle {
    pointer-events: auto; position: absolute; right: 8px; bottom: 12px; z-index: 1;
    height: 26px; min-width: 26px; padding: 0 6px; border: 1px solid #d9ccb0; border-radius: 3px;
    background: #fffdf6; color: #6b5a3a; font-size: 10px; letter-spacing: 0.08em; cursor: pointer;
  }
  .town__toggle-closed { display: none; }
  .town[data-open='false'] .town__toggle { bottom: 20px; }
  .town[data-open='false'] .town__toggle-open { display: none; }
  .town[data-open='false'] .town__toggle-closed { display: inline; }

  @media (max-width: 640px) {
    /* Phone: the lane gets the width; pads fold into a 2×2 block. */
    .town__deck { grid-template-columns: 46px minmax(0, 1fr) 58px; gap: 6px; padding: 0 38px 0 8px; }
    .town__status { width: 46px; gap: 0; flex-direction: column; align-items: flex-start; }
    .town__count { width: auto; text-align: left; font-size: 20px; }
    .town__sub { display: none; }
    .town__here { font-size: 7.5px; letter-spacing: 0.08em; }
    .town__pads { width: 58px; display: grid; grid-template-columns: 28px 28px; gap: 2px; }
    .town__pads-label { display: none; }
    .town__pad { width: 28px; height: 24px; font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) { .town__pad, .town__deck { transition: none; } }
</style>

<style is:global>
  /* The rope becomes the deck's top edge: slimmer, same logic (tug-rope.ts). */
  html .town .tug { position: relative; bottom: auto; left: auto; right: auto; height: 18px; pointer-events: auto; border-top: 1px solid #d9ccb0; }
  html .town .tug__rope { height: 16px; }
  html .town .tug__label, html .town .tug__read, html .town .tug__id { font-size: 8px; }
  html .town .tug__count { font-size: 10px; }

  /* Chrome height: rail 40 + rope 18 + deck 52 (open) — read by anything that floats above the dock. */
  html { --pc-chrome-h: 110px; }
  html[data-deck='off'] { --pc-chrome-h: 58px; }
  /* Beats `html[data-pc-layout="block"] body { padding: 0 }`, which used to hide the last lines under the rope. */
  html[data-deck][data-pc-layout] body, html[data-deck] body { padding-bottom: calc(var(--pc-chrome-h) + 12px); }
  /* The deck carries the crowd now; the rail's crowd chip steps aside while it is open. */
  html[data-deck='on'] .fb__crowd { display: none; }
  html .fb-wave { bottom: calc(var(--pc-chrome-h) + 10px); }

  .town-tile {
    position: relative; flex: none; width: 58px; height: 46px; padding: 3px 0 0; margin: 0;
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    appearance: none; background: none; border: 0; border-radius: 3px; cursor: pointer; color: #2d1f08;
    animation: town-arrive .5s cubic-bezier(.18,.89,.32,1.28);
    transition: opacity .6s ease, transform .2s ease;
  }
  .town-tile:hover { background: rgba(78, 58, 22, 0.07); }
  .town-tile__face {
    width: 28px; height: 28px; border-radius: 50%; overflow: hidden; background: #efe7d8;
    border: 2px solid #fbf6ea; box-shadow: 0 0 0 1px #c9b98f; transition: box-shadow .15s ease, transform .15s ease;
  }
  .town-tile__face img { display: block; width: 100%; height: 100%; image-rendering: pixelated; }
  .town-tile__cap {
    max-width: 56px; font: 400 8.5px/1.1 'JetBrains Mono Variable', ui-monospace, monospace; letter-spacing: 0.02em;
    color: #6b5a3a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .town-tile[data-you='true'] .town-tile__face { box-shadow: 0 0 0 2px #2d1f08; }
  .town-tile[data-you='true'] .town-tile__cap { color: #2d1f08; font-weight: 700; }
  .town-tile[data-here='true'] .town-tile__face { box-shadow: 0 0 0 2px #6a9f3a; }
  .town-tile[data-kind='agent'] .town-tile__face { box-shadow: 0 0 0 2px #8b5cf6; }
  .town-tile[data-kind='agent'] .town-tile__cap { color: #6d28d9; }
  .town-tile[data-listening='true'] .town-tile__cap { color: #9a3412; }
  .town-tile[data-leaving='true'] { opacity: .3; }
  .town-tile[data-speaking='true'] .town-tile__face { transform: translateY(-2px) scale(1.1); box-shadow: 0 0 0 3px #f9c56c; }
  .town-tile[data-waving='true'] { animation: town-wiggle .9s ease-in-out; }
  .town-tile[data-drum] .town-tile__face { transform: scale(1.16); }
  .town-tile[data-drum='kick'] .town-tile__face { box-shadow: 0 0 0 3px #b8a473; }
  .town-tile[data-drum='bloom'] .town-tile__face { box-shadow: 0 0 0 3px #e0626d; }
  .town-tile[data-drum='dew'] .town-tile__face { box-shadow: 0 0 0 3px #d4b300; }
  .town-tile[data-drum='thorn'] .town-tile__face { box-shadow: 0 0 0 3px #4f7d4e; }

  .town-more {
    flex: none; height: 28px; padding: 0 8px; border: 1px solid #c9b98f; border-radius: 14px; background: #fffdf6;
    font: 700 10px/1 'JetBrains Mono Variable', ui-monospace, monospace; color: #2d1f08; cursor: pointer;
  }
  .town-moment {
    flex: none; max-width: 240px; display: flex; align-items: center; gap: 6px; padding: 4px 8px 4px 4px;
    border: 1px dashed #c9b98f; border-radius: 3px; color: #4e3a16; text-decoration: none;
    font: 400 10px/1.25 'Inter Variable', Inter, system-ui, sans-serif;
  }
  .town-moment img { width: 22px; height: 22px; border-radius: 50%; background: #efe7d8; image-rendering: pixelated; flex: none; }
  .town-moment span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .town-moment b { font-weight: 600; }
  .town-moment i { font-style: normal; color: #8a7650; }
  .town-moment--invite { border-style: solid; background: #fffdf6; font-weight: 600; }

  .town-bubble {
    position: absolute; bottom: 6px; max-width: min(260px, 70vw); padding: 6px 9px; transform: translateX(-50%);
    background: #fffdf6; color: #2d1f08; border: 1px solid #4e3a16; border-radius: 4px; box-shadow: 0 6px 16px rgba(0,0,0,.18);
    font: 400 11.5px/1.3 'Inter Variable', Inter, system-ui, sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    animation: town-bubble 5s ease forwards;
  }
  .town-bubble b { font: 700 9px/1 'JetBrains Mono Variable', ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; margin-right: 6px; color: #8a7650; }

  @keyframes town-arrive { from { opacity: 0; transform: translateY(8px) scale(.85); } to { opacity: 1; transform: none; } }
  @keyframes town-wiggle { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-12deg); } 40% { transform: rotate(10deg); } 60% { transform: rotate(-8deg); } 80% { transform: rotate(5deg); } }
  @keyframes town-bubble { 0% { opacity: 0; translate: 0 6px; } 8%, 85% { opacity: 1; translate: 0 0; } 100% { opacity: 0; translate: 0 -4px; } }

  @media (max-width: 640px) {
    .town-tile { width: 48px; }
    .town-tile__cap { max-width: 46px; font-size: 8px; }
    .town-moment { max-width: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .town-tile, .town-bubble { animation: none; }
    .town-tile[data-drum] .town-tile__face, .town-tile[data-speaking='true'] .town-tile__face { transform: none; }
  }
</style>
