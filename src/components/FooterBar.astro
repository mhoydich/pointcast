  <div class="fb__menu" id="fb-menu" role="dialog" aria-modal="false" aria-label="PointCast kit binder" hidden>
    <div class="fb__menu-scrim" id="fb-menu-scrim" aria-hidden="true"></div>
    <div class="fb__menu-panel" id="fb-menu-panel" tabindex="-1">
      <button type="button" class="fb__menu-close" id="fb-menu-close" aria-label="Close binder">×</button>

      <section class="fb-you-section">
        <div class="fb-you-card">
          <img
            class="fb-you-card__noun"
