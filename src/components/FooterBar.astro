    border: 1px solid rgba(255, 220, 160, 0.24);
    color: #fdf2d6;
    width: 28px;
    height: 28px;
    border-radius: 3px;
    font-size: 16px;
    cursor: pointer;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fb__menu-btn:hover { background: rgba(255, 220, 160, 0.12); border-color: rgba(255, 220, 160, 0.55); }

  .fb__tray {
    pointer-events: auto;
    position: fixed;
    bottom: 48px;
    width: min(340px, calc(100vw - 16px));
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    background: linear-gradient(180deg, #fffdf6 0%, #faf2dc 100%);
    color: #2d1f08;
    border: 1px solid #4e3a16;
    border-radius: 4px;
    box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.32);
    z-index: 49;
    transform: translateY(8px);
    opacity: 0;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .fb__tray[data-open='true'] { transform: translateY(0); opacity: 1; }
  .fb__tray-arrow {
    position: absolute;
    bottom: -6px;
    width: 12px;
    height: 12px;
    background: #faf2dc;
    border-right: 1px solid #4e3a16;
    border-bottom: 1px solid #4e3a16;
    transform: translateX(-50%) rotate(45deg);
  }
  .fb__tray-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px 8px;
    border-bottom: 1px dashed #d4c6a4;
  }
  .fb__tray-num {
    font-size: 10px;
    letter-spacing: 0.18em;
    font-weight: 700;
    color: #fff;
    background: #2d1f08;
    padding: 3px 6px;
    border-radius: 2px;
  }
  .fb__tray-title { flex: 1; margin: 0; font-family: 'DM Serif Display', Georgia, serif; font-size: 17px; color: #2d1f08; }
  .fb__tray-close {
    appearance: none;
    background: none;
    border: 0;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    color: #6b5a3a;
    width: 28px;
    height: 28px;
    padding: 0;
  }
  .fb__tray-close:hover { color: #2d1f08; }
  .fb__tray-body { padding: 10px 14px 14px; }
  .fb__tray-blurb { font-size: 12.5px; line-height: 1.45; color: #4e3a16; margin: 0 0 10px; }
  .fb__tray-blurb code { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; background: rgba(45, 31, 8, 0.08); padding: 1px 4px; border-radius: 2px; }
  .fb__tray-blurb a { color: #8a2432; }
  .fb__tray-meta { font-size: 10px; letter-spacing: 0.1em; color: #6b5a3a; margin: 8px 0 0; }
  .fb-tray__link { display: inline-block; margin-top: 10px; font-size: 10.5px; color: #8a2432; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; letter-spacing: 0.08em; }

  .fb-ask { display: flex; flex-direction: column; gap: 8px; }
  .fb-ask__row { display: flex; align-items: center; gap: 8px; }
  .fb-ask__label { font-size: 9.5px; letter-spacing: 0.18em; color: #8a7854; font-weight: 700; min-width: 24px; }
  .fb-ask__to {
    flex: 1;
    padding: 6px 8px;
    font-size: 11.5px;
    border: 1px solid #c5b284;
    border-radius: 3px;
    background: #fffdf8;
    color: #2d1f08;
  }
  .fb-ask__body {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #c5b284;
    border-radius: 3px;
    background: #fffdf8;
    color: #2d1f08;
    font-family: Georgia, serif;
    font-size: 13px;
    line-height: 1.5;
    resize: vertical;
    min-height: 64px;
  }
  .fb-ask__body:focus { outline: 2px solid #d4a437; outline-offset: 1px; }
  .fb-ask__foot { display: flex; align-items: center; justify-content: space-between; }
  .fb-ask__count { font-size: 9px; letter-spacing: 0.12em; color: #8a7854; }
  .fb-ask__status { margin: 4px 0 0; font-size: 10.5px; min-height: 1em; letter-spacing: 0.08em; }
  .fb-ask__status[data-state='ok']      { color: #2f8f5f; }
  .fb-ask__status[data-state='warn']    { color: #c4952e; }
  .fb-ask__status[data-state='err']     { color: #8a2432; }
  .fb-ask__status[data-state='pending'] { color: #6b5a3a; }

  /* Echoes — visible round-trip for the ASK tray */
  .fb-echoes {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed #d4c6a4;
  }
  .fb-echoes__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 9px;
    letter-spacing: 0.18em;
    color: #8a7854;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .fb-echoes__counts { color: #2f8f5f; font-weight: 700; }
  .fb-echoes__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .fb-echo {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 5px 7px;
    background: #fffdf8;
    border: 1px solid #ece4d3;
    border-radius: 2px;
    font-size: 11px;
    line-height: 1.3;
  }
  .fb-echo__row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 8px;
  }
  .fb-echo__time { font-size: 9.5px; color: #8a7854; letter-spacing: 0.04em; }
  .fb-echo__to   { font-size: 9.5px; color: #6b5a3a; letter-spacing: 0.06em; }
  .fb-echo__body {
    color: #2d1f08;
    font-family: Georgia, serif;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .fb-echo__pill {
    font-size: 8.5px;
    letter-spacing: 0.16em;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 1px;
    text-decoration: none;
    white-space: nowrap;
  }
  .fb-echo__pill--sent     { background: #f8e9c8; color: #c4952e; }
  .fb-echo__pill--answered { background: #d8f0e2; color: #2f8f5f; }
  .fb-echo__pill--answered:hover { background: #2f8f5f; color: #fff; }

  /* Mike 2026-05-02: when an ASK is answered with a real published
     block, the echo grows an inline parchment quote of the reply.
     Closes the round-trip loop visually. Whole quote is a clickable
     link to /b/{id}. */
  .fb-echo__reply {
    margin-top: 5px;
    padding-left: 14px;
    border-left: 2px solid #2f8f5f;
  }
  .fb-echo__reply-link {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 7px 9px;
    background: linear-gradient(180deg, #fffdf6 0%, #faf2dc 100%);
    border: 1px solid #d4c6a4;
    border-left: 0;
    border-radius: 0 2px 2px 0;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .fb-echo__reply-link:hover {
    background: #faf2dc;
    border-color: #2f8f5f;
  }
  .fb-echo__reply-kicker {
    font-size: 8.5px;
    letter-spacing: 0.18em;
    color: #2f8f5f;
    font-weight: 700;
    text-transform: lowercase;
  }
  .fb-echo__reply-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 13px;
    color: #2d1f08;
    line-height: 1.15;
  }
  .fb-echo__reply-body {
    font-family: Georgia, serif;
    font-size: 12px;
    color: #4e3a16;
    line-height: 1.45;
    /* Cap to ~3 lines — the truncation is also handled in JS via the
       220-char slice + ellipsis. CSS clamp is the visual fallback. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fb-echo__reply-more {
    align-self: flex-end;
    font-size: 8.5px;
    letter-spacing: 0.14em;
    color: #2f8f5f;
    text-transform: lowercase;
    margin-top: 2px;
  }

  .fb-residents { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .fb-resident { margin: 0; }
  .fb-resident__btn {
    appearance: none;
    width: 100%;
    text-align: left;
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-left: 3px solid var(--res-color, #4e3a16);
    border-radius: 2px;
    cursor: pointer;
    color: inherit;
    font: inherit;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .fb-resident__btn:hover { background: #faf2dc; border-color: var(--res-color, #4e3a16); }
  .fb-resident__btn[data-status='open'],
  .fb-resident__btn[data-status='dormant'] { cursor: default; opacity: 0.7; }
  .fb-resident__btn[data-status='open']:hover,
  .fb-resident__btn[data-status='dormant']:hover { background: #fffdf8; }
  .fb-resident__chip {
    width: 36px;
    height: 32px;
    background: var(--res-color, #4e3a16);
    color: #fffdf6;
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }
  .fb-resident__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .fb-resident__name { font-family: 'DM Serif Display', Georgia, serif; font-size: 13.5px; color: #2d1f08; line-height: 1.1; }
  .fb-resident__role { font-size: 9.5px; letter-spacing: 0.06em; color: #6b5a3a; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fb-resident__status { font-size: 9px; letter-spacing: 0.12em; font-weight: 700; }
  .fb-resident__status[data-state='resident'] { color: #2f8f5f; }
  .fb-resident__status[data-state='director'] { color: #c4952e; }
  .fb-resident__status[data-state='open']     { color: #6b5a3a; }
  .fb-resident__status[data-state='dormant']  { color: #b09060; }

  .fb-peers { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .fb-peer { margin: 0; }
  .fb-peer__btn {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-left: 3px solid var(--peer-accent, #4e3a16);
    border-radius: 2px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .fb-peer__btn:hover { background: #faf2dc; border-color: var(--peer-accent, #4e3a16); }
  .fb-peer__noun { width: 38px; height: 38px; border-radius: 2px; background: #1a1004; image-rendering: pixelated; border: 1px solid #d4a437; }
  .fb-peer__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .fb-peer__handle { font-size: 11px; letter-spacing: 0.04em; color: #2d1f08; font-weight: 700; }
  .fb-peer__kicker { font-size: 11.5px; color: #4e3a16; line-height: 1.3; }
  .fb-peer__status { font-size: 9px; letter-spacing: 0.18em; font-weight: 700; padding: 2px 5px; border-radius: 1px; }
  .fb-peer__status[data-state='live']  { background: #d8f0e2; color: #2f8f5f; }
  .fb-peer__status[data-state='beta']  { background: #f8e9c8; color: #c4952e; }
  .fb-peer__status[data-state='dream'] { background: #ece4d3; color: #8a7854; }

  .fb__menu {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: 50;
    transition: opacity 0.22s ease;
    opacity: 0;
  }
  .fb__menu[data-open='true'] { opacity: 1; }
  .fb__menu-scrim { position: absolute; inset: 0; background: rgba(26, 18, 8, 0.45); backdrop-filter: blur(2px); }
  .fb__menu-panel {
    position: absolute;
    right: 12px;
    bottom: 48px;
    width: min(720px, calc(100vw - 24px));
    max-height: calc(100vh - 72px);
    overflow-y: auto;
    background: #fff;
    color: #181818;
    border: 1px solid #24282d;
    border-radius: 6px 6px 0 0;
    box-shadow: 0 -12px 36px rgba(0, 0, 0, 0.24);
    padding: 18px 20px 16px;
    outline: none;
    transform: translateY(8px);
    transition: transform 0.22s ease;
  }
  .fb__menu[data-open='true'] .fb__menu-panel { transform: translateY(0); }
  @media (max-width: 560px) {
    .fb__menu-panel {
      right: 0;
      bottom: 40px;
      left: 0;
      width: auto;
      max-height: calc(100vh - 52px);
      border-radius: 6px 6px 0 0;
      padding: 16px 14px 14px;
    }
  }
  .fb__menu-close {
    position: absolute;
    top: 8px;
    right: 10px;
    z-index: 100;
    appearance: none;
    background: rgba(255, 253, 248, 0.96);
    border: 1px solid #d4c6a4;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    color: #6b5a3a;
    width: 28px;
    height: 28px;
    padding: 0;
  }
  .fb__menu-close:hover { color: #2d1f08; background:#faf2dc; }
  .fb__menu-close:focus-visible { outline:3px solid #c4952e; outline-offset:2px; }

  .fb-legacy {
    margin-top: 4px;
    border-top: 1px solid #d9dde2;
  }
  .fb-legacy > summary {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #3e4852;
    cursor: pointer;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0;
    list-style: none;
    text-transform: uppercase;
  }
  .fb-legacy > summary::-webkit-details-marker { display: none; }
  .fb-legacy > summary::after { content: '+'; color: #145aa4; font-size: 15px; }
  .fb-legacy[open] > summary::after { content: '\2212'; }
  .fb-legacy > summary small {
    flex: 1;
    color: #828b94;
    font: inherit;
    font-weight: 500;
    text-align: right;
  }
  .fb-legacy[open] > summary { margin-bottom: 14px; border-bottom: 1px solid #e2e5e8; }

  .fb-you-section { margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px dashed #d4c6a4; }
  .fb-you-card { display: flex; gap: 12px; align-items: center; }
  .fb-you-card__noun {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1a1004;
    image-rendering: pixelated;
    box-shadow: inset 0 0 0 2px #4e3a16, 0 0 12px rgba(255, 150, 60, 0.3);
    flex-shrink: 0;
  }
  .fb-you-card__body { flex: 1; min-width: 0; }
  .fb-you-card__kicker { font-size: 9.5px; letter-spacing: 0.2em; color: #8a7854; margin: 0 0 4px; font-weight: 700; }
  .fb-you-card__name { font-family: 'DM Serif Display', Georgia, serif; font-size: 18px; margin: 0 0 2px; color: #2d1f08; }
  .fb-you-card__meta { font-size: 10.5px; letter-spacing: 0.12em; color: #6b5a3a; margin: 0; }
  .fb-you-actions { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }

  .fb-btn {
    appearance: none;
    flex: 1;
    min-width: 0;
    padding: 7px 10px;
    background: #2d1f08;
    color: #fdf2d6;
    border: 1px solid #2d1f08;
    border-radius: 3px;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: background 0.15s ease;
  }
  .fb-btn:hover { background: #4e3a16; }
  .fb-btn--ghost { background: transparent; color: #2d1f08; border-color: #c5b284; }
  .fb-btn--ghost:hover { background: #faf2dc; }
  .fb-btn--soundtrack { width: 100%; flex: none; }
  .fb-btn--block { width: 100%; flex: none; }
  .fb-btn--send { flex: none; padding: 7px 14px; }
  .fb-btn__glyph { font-size: 11px; }

  .fb-controls { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px dashed #d4c6a4; }
  .fb-ctrl { display: flex; flex-direction: column; gap: 4px; }
  .fb-ctrl__name { font-size: 9.5px; letter-spacing: 0.18em; color: #8a7854; font-weight: 700; }
  .fb-ctrl__input {
    padding: 7px 10px;
    font-size: 11.5px;
    border: 1px solid #c5b284;
    border-radius: 3px;
    background: #fffdf8;
    color: #2d1f08;
  }

  /* Mood-cast toggle row — checkbox + label + hint, all on one line. */
  .fb-ctrl--row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 6px 8px;
    background: rgba(167, 139, 250, 0.08);
    border: 1px dashed rgba(167, 139, 250, 0.4);
    border-radius: 2px;
    cursor: pointer;
  }
  .fb-ctrl--row:hover { background: rgba(167, 139, 250, 0.14); }
  .fb-ctrl__check {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: #a78bfa;
    cursor: pointer;
    flex-shrink: 0;
  }
  .fb-ctrl--row .fb-ctrl__name { color: #5b3fa3; }
  .fb-ctrl__hint {
    flex: 1 1 100%;
    font-size: 9px;
    color: #6b5a3a;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .fb__soundtrack { margin-bottom: 14px; background: #000; border-radius: 3px; overflow: hidden; }
  .fb__soundtrack iframe { display: block; width: 100%; border: 0; }

  .fb-binder { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px dashed #d4c6a4; }
  .fb-binder__label { font-size: 9.5px; letter-spacing: 0.22em; color: #8a2432; margin: 0 0 8px; font-weight: 700; }
  .fb-binder__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .fb-binder__card { margin: 0; }
  .fb-binder__open {
    appearance: none;
    width: 100%;
    text-align: left;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-radius: 3px;
    padding: 10px;
    cursor: pointer;
    display: grid;
    grid-template-columns: 44px 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 8px;
    row-gap: 2px;
    color: inherit;
    font: inherit;
    position: relative;
    transition: border-color 0.12s ease, transform 0.12s ease;
  }
  .fb-binder__open:hover {
    border-color: var(--stamp-accent, #d4a437);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .fb-binder__num {
    grid-column: 2;
    grid-row: 1;
    font-size: 8.5px;
    letter-spacing: 0.18em;
    font-weight: 700;
    color: var(--stamp-accent, #8a7854);
    align-self: end;
  }
  .fb-binder__noun {
    grid-column: 1;
    grid-row: 1 / 4;
    width: 44px;
    height: 44px;
    border-radius: 2px;
    background: #1a1004;
    image-rendering: pixelated;
    border: 1px solid #d4a437;
    box-shadow: inset 0 0 0 1px #2d1f08;
    align-self: start;
  }
  .fb-binder__glyph { position: absolute; top: 4px; right: 6px; font-size: 11px; color: #8a7854; }
  .fb-binder__name {
    grid-column: 2;
    grid-row: 2;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 14px;
    color: #2d1f08;
    line-height: 1.05;
  }
  .fb-binder__blurb { grid-column: 2; grid-row: 3; font-size: 9px; letter-spacing: 0.04em; color: #6b5a3a; line-height: 1.35; }

  .fb-routes { margin-bottom: 14px; }
  .fb-routes__group { margin-bottom: 10px; }
  .fb-routes__group:last-child { margin-bottom: 0; }
  .fb-routes__label { font-size: 9.5px; letter-spacing: 0.22em; color: #8a2432; margin: 0 0 5px; font-weight: 700; }
  .fb-routes__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    font-family: Georgia, serif;
    font-size: 13.5px;
  }
  .fb-routes__links a { color: #2d1f08; text-decoration: none; border-bottom: 1px solid #d4c6a4; padding-bottom: 1px; }
  .fb-routes__links a:hover { border-bottom-color: #8a2432; color: #8a2432; }

  .fb-live {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed #d4c6a4;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #6b5a3a;
  }
  .fb-live__dot { width: 6px; height: 6px; border-radius: 50%; background: #2f8f5f; box-shadow: 0 0 6px rgba(47, 143, 95, 0.5); }
  .fb-live__link { margin-left: auto; color: #8a2432; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }

  body { padding-bottom: 48px; }

  /* ─── v4.1 styles — buttons + studio + comms ─────────────────── */

  /* Quick-action chip row at the top of every tray body. */
  .fb__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 0 0 10px;
    margin: 0 0 8px;
    border-bottom: 1px dotted #d4c6a4;
  }
  .fb__action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    background: #fffdf8;
    border: 1px solid #c5b284;
    border-radius: 2px;
    cursor: pointer;
    color: #2d1f08;
    font: inherit;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }
  .fb__action:hover { background: #faf2dc; border-color: #2d1f08; transform: translateY(-1px); }
  .fb__action--ghost { background: transparent; border-color: #ece4d3; color: #6b5a3a; }
  .fb__action--ghost:hover { background: #faf2dc; color: #2d1f08; }
  .fb__action--director {
    border-color: #c4952e;
    color: #c4952e;
    background: #fffaec;
  }
  .fb__action--director:hover { background: #c4952e; color: #fff; }
  .fb__action[data-flash='true'] {
    animation: fb-action-flash 0.6s ease;
  }
  @keyframes fb-action-flash {
    0%, 100% { background: #fffdf8; }
    50%      { background: #f8e9c8; }
  }
  .fb__action-glyph { font-size: 11px; line-height: 1; }
  .fb__action-label { font-size: 10px; letter-spacing: 0.1em; font-weight: 700; text-transform: lowercase; }

  /* AI seat in the ASK form foot. */
  .fb-ask__seat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 2px;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    font-weight: 700;
    cursor: not-allowed;
  }
  .fb-ask__seat--ai[data-state='off'] {
    background: rgba(45, 31, 8, 0.05);
    border: 1px dashed #c5b284;
    color: #8a7854;
  }
  .fb-ask__seat--ai[data-state='off']:hover { background: rgba(45, 31, 8, 0.1); }

  /* Resident row — card + comms strip. */
  .fb-resident__row { display: contents; }
  .fb-resident { display: flex; flex-direction: column; gap: 2px; }
  .fb-resident__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 8px 6px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-top: 0;
    border-left: 3px solid var(--res-color, #4e3a16);
    border-radius: 0 0 2px 2px;
    margin-top: -2px;
  }
  .fb-resident__link {
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #6b5a3a;
    text-decoration: none;
    border-bottom: 1px dotted #c5b284;
    padding-bottom: 1px;
  }
  .fb-resident__link:hover { color: var(--res-color, #4e3a16); border-bottom-color: var(--res-color, #4e3a16); }
  /* Filter behavior — applied via #fb-residents-list[data-filter=…]. */
  #fb-residents-list[data-filter='live'] .fb-resident:not([data-status='resident']):not([data-status='director']) { display: none; }
  #fb-residents-list[data-filter='open'] .fb-resident:not([data-status='open']) { display: none; }

  /* Federation peer — row + comms strip. */
  .fb-peer { display: flex; flex-direction: column; gap: 2px; }
  .fb-peer__row {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-left: 3px solid var(--peer-accent, #4e3a16);
    border-radius: 2px 2px 0 0;
  }
  .fb-peer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 8px 6px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-top: 0;
    border-left: 3px solid var(--peer-accent, #4e3a16);
    border-radius: 0 0 2px 2px;
    margin-top: -1px;
  }
  .fb-peer__link {
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #6b5a3a;
    text-decoration: none;
    border-bottom: 1px dotted #c5b284;
    padding-bottom: 1px;
    background: none;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .fb-peer__link:hover { color: var(--peer-accent, #4e3a16); border-bottom-color: var(--peer-accent, #4e3a16); }
  .fb-peer__link--btn:disabled { cursor: progress; opacity: 0.7; }
  .fb-peer__link--ghost { color: #b09060; cursor: default; border-bottom-style: dotted; }
  .fb-peer__link--ghost:hover { color: #b09060; border-bottom-color: #d4c6a4; }

  /* Operator mode pill (`>` prefix in omnibox). */
  .fb__omni-mode[data-mode='op'] {
    background: rgba(196, 149, 46, 0.3);
    color: #fff7d4;
    border-color: #c4952e;
  }
  /* Cast mode pill (`+` prefix in omnibox) — Peach-style magic words. */
  .fb__omni-mode[data-mode='cast'] {
    background: rgba(167, 139, 250, 0.35);
    color: #f0e8ff;
    border-color: #a78bfa;
  }

  /* Spell list inside the CAST tray — kind-tinted left rail, glyph,
     short description, and a small `kind` pill on the right. */
  .fb-spells { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .fb-spell { margin: 0; }
  .fb-spell__btn {
    appearance: none;
    width: 100%;
    text-align: left;
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 9px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-left: 3px solid var(--spell-accent, #4e3a16);
    border-radius: 2px;
    cursor: pointer;
    color: inherit;
    font: inherit;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }
  .fb-spell__btn:hover {
    background: #faf2dc;
    border-color: var(--spell-accent, #4e3a16);
    transform: translateY(-1px);
  }
  .fb-spell__glyph { font-size: 18px; line-height: 1; text-align: center; }
  .fb-spell__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .fb-spell__label { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 11px; color: var(--spell-accent, #2d1f08); font-weight: 700; letter-spacing: 0.05em; }
  .fb-spell__blurb { font-size: 10px; color: #6b5a3a; line-height: 1.3; letter-spacing: 0.02em; }
  .fb-spell__kind { font-size: 8.5px; letter-spacing: 0.16em; font-weight: 700; padding: 2px 5px; border-radius: 1px; text-transform: uppercase; }
  .fb-spell__kind[data-kind='burst']     { background: #f8e9c8; color: #c4952e; }
  .fb-spell__kind[data-kind='companion'] { background: #f5e0e5; color: #8a2432; }
  .fb-spell__kind[data-kind='ambient']   { background: #e2eef5; color: #4A9EFF; }

  /* Broadcast tray — the studio glimpse. */
  .fb-bcast { display: flex; flex-direction: column; gap: 10px; }
  .fb-bcast__row { display: flex; align-items: center; justify-content: space-between; }
  .fb-bcast__kicker { font-size: 9px; letter-spacing: 0.22em; color: #c4952e; font-weight: 700; }
  .fb-bcast__time { font-size: 10px; color: #6b5a3a; letter-spacing: 0.14em; }
  .fb-bcast__now {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: linear-gradient(180deg, #fffaec 0%, #faf2dc 100%);
    border: 1px solid #c4952e;
    border-radius: 3px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .fb-bcast__now:hover { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(196, 149, 46, 0.2); }
  .fb-bcast__now-id { font-size: 11px; letter-spacing: 0.12em; color: #c4952e; font-weight: 700; }
  .fb-bcast__now-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 14px;
    color: #2d1f08;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .fb-bcast__now-channel {
    font-size: 9px;
    letter-spacing: 0.18em;
    color: #6b5a3a;
    font-weight: 700;
  }
  .fb-bcast__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  .fb-bcast__cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-radius: 2px;
  }
  .fb-bcast__cell-label { font-size: 8.5px; letter-spacing: 0.2em; color: #8a7854; font-weight: 700; }
  .fb-bcast__cell-value { font-family: 'DM Serif Display', Georgia, serif; font-size: 18px; color: #2d1f08; line-height: 1.05; }
  .fb-bcast__cell-sub { font-size: 9px; letter-spacing: 0.06em; color: #8a7854; }
  .fb-bcast__director-note {
    margin: 0;
    padding: 7px 9px;
    background: rgba(196, 149, 46, 0.08);
    border: 1px dashed #c4952e;
    border-radius: 2px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: #c4952e;
  }
  .fb-bcast__director-note code {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 9px;
    background: rgba(45, 31, 8, 0.08);
    padding: 1px 4px;
    border-radius: 2px;
    color: #2d1f08;
  }

  /* ─── Director badge on the YOU chip ─────────────────────────
     Only visible when body[data-director='true']. Gold pill, sits
     to the right of the noun-text column. */
  .fb__dir-badge {
    display: none;
    margin-left: 4px;
    padding: 2px 5px;
    background: linear-gradient(180deg, #f8e9c8 0%, #d4a437 100%);
    color: #2d1f08;
    border: 1px solid #2d1f08;
    border-radius: 2px;
    font-size: 8.5px;
    letter-spacing: 0.18em;
    font-weight: 700;
    line-height: 1;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
    align-self: center;
  }
  body[data-director='true'] .fb__dir-badge { display: inline-block; }
  /* Hide on tiny screens — the YOU chip already collapses. */
  @media (max-width: 480px) { .fb__dir-badge { display: none !important; } }

  /* ─── Director inline forms inside the BROADCAST tray ─────── */
  .fb-dir-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }
  .fb-dir-form {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 7px 9px;
    background: linear-gradient(180deg, #fffaec 0%, #faf2dc 100%);
    border: 1px solid #c4952e;
    border-radius: 3px;
  }
  .fb-dir-form__label {
    font-size: 9px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: #c4952e;
    white-space: nowrap;
  }
  .fb-dir-form__input {
    flex: 1;
    min-width: 0;
    padding: 6px 8px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-radius: 2px;
    color: #2d1f08;
    font-size: 12px;
    font-family: Georgia, serif;
  }
  .fb-dir-form__input:focus { outline: 2px solid #d4a437; outline-offset: 1px; }
  .fb-btn--dir {
    background: #c4952e;
    border-color: #c4952e;
    color: #fff;
    flex: none;
    padding: 6px 10px;
    font-size: 9.5px;
  }
  .fb-btn--dir:hover { background: #2d1f08; }
  .fb-dir-form__status {
    margin: 2px 0 0;
    font-size: 10px;
    letter-spacing: 0.06em;
    min-height: 1em;
  }
  .fb-dir-form__status[data-state='ok']      { color: #2f8f5f; }
  .fb-dir-form__status[data-state='warn']    { color: #c4952e; }
  .fb-dir-form__status[data-state='err']     { color: #8a2432; }
  .fb-dir-form__status[data-state='pending'] { color: #6b5a3a; }
  .fb-dir-form__note {
    margin: 0;
    padding: 6px 8px;
    background: rgba(45, 31, 8, 0.04);
    border-radius: 2px;
    font-size: 9px;
    color: #6b5a3a;
    line-height: 1.4;
  }
  .fb-dir-form__note code {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 9px;
    background: rgba(196, 149, 46, 0.18);
    padding: 1px 4px;
    border-radius: 2px;
    color: #2d1f08;
  }

  /* Mobile breakpoints — the kit grew from 4 to 5 stamps. Drop the
     last two on phones (binder still has them). */
  @media (max-width: 380px) {
    .fb__stamp[data-tray='broadcast'] { display: none; }
  }
  @media (max-width: 320px) {
    .fb__stamp[data-tray='fed']      { display: none; }
  }

  /* ─── Speech bubble — Mike 2026-04-30 ──────────────────────────
     Floats above the YOU chip with a downward tail. Outside the chip
     button so clicks never get intercepted. */
  .fb__bubble {
    pointer-events: none;
    position: absolute;
    left: 18px;
    bottom: 50px;
    max-width: min(320px, calc(100vw - 28px));
    padding: 8px 12px;
    background: #fffdf6;
    color: #2d1f08;
    border: 1px solid #4e3a16;
    border-radius: 10px;
    font-family: Georgia, serif;
    font-size: 13px;
    line-height: 1.35;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.32);
    word-wrap: break-word;
    z-index: 41;
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  }
  .fb__bubble[data-state='typing'] {
    opacity: 1;
    transform: translateY(0) scale(1);
    border-color: rgba(196, 149, 46, 0.5);
    background: linear-gradient(180deg, #fffdf6 0%, #fff8e5 100%);
  }
  .fb__bubble[data-state='sent'] {
    opacity: 1;
    transform: translateY(0) scale(1);
    border-color: #2d1f08;
    background: linear-gradient(180deg, #fffdf6 0%, #faf2dc 100%);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4), 0 0 0 2px rgba(249, 197, 108, 0.4);
  }
  .fb__bubble-body {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    white-space: normal;
  }
  .fb__bubble-tail {
    position: absolute;
    bottom: -7px;
    left: 14px;
    width: 12px;
    height: 12px;
    background: inherit;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    border-color: inherit;
    transform: rotate(45deg);
    border-top: 0;
    border-left: 0;
  }
  .fb__bubble[data-state='typing'] .fb__bubble-tail {
    background: #fff8e5;
    border-right-color: rgba(196, 149, 46, 0.5);
    border-bottom-color: rgba(196, 149, 46, 0.5);
  }
  .fb__bubble[data-state='sent'] .fb__bubble-tail {
    background: #faf2dc;
    border-right-color: #2d1f08;
    border-bottom-color: #2d1f08;
  }
  @media (max-width: 640px) {
    .fb__bubble { left: 12px; bottom: 48px; max-width: min(260px, calc(100vw - 20px)); font-size: 12.5px; }
  }

  /* ── 07 PASSPORT tray — stamps, entries, holos ─────────────────── */
  .fb__tray--passport { width: min(400px, calc(100vw - 16px)); }

  /* ── № 08 SEISMO ─────────────────────────────────────────────── */
  .fb__tray--seismo { width: min(400px, calc(100vw - 16px)); }
  .fb__tray--seismo[data-shake='true'] { animation: fb-sg-shake 0.45s linear; }
  @keyframes fb-sg-shake {
    0%, 100% { transform: translate(0, 0); }
    20% { transform: translate(-3px, 1px); }
    40% { transform: translate(3px, -2px); }
    60% { transform: translate(-2px, 2px); }
    80% { transform: translate(2px, -1px); }
  }
  .fb-sg {
    border: 2px solid #2d1f08;
    border-radius: 4px;
    background: #fffcf3;
    overflow: hidden;
  }
  .fb-sg__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px;
    border-bottom: 1px dashed #d8c9a4;
  }
  .fb-sg__title { font-size: 9.5px; letter-spacing: 0.08em; color: #6b5a3a; }
  .fb-sg__mag { font-size: 10px; font-weight: 700; color: #c73e2e; white-space: nowrap; }
  .fb-sg__strip {
    display: block;
    width: 100%;
    height: 148px;
    background: #fffcf3;
    cursor: crosshair;
    touch-action: none;
  }
  .fb-sg__read {
    margin: 0;
    padding: 6px 8px;
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: #2f8f5f;
    border-top: 1px dashed #d8c9a4;
  }
  .fb-sg__foot {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 8px 7px;
    font-size: 9px;
    color: #8a7854;
    border-top: 1px solid #ece4d3;
  }
  .fb-sg__foot span:last-child { color: #8a2432; white-space: nowrap; }

  .fb-pp {
    border: 2px solid #2d1f08;
    background:
      repeating-linear-gradient(0deg, transparent 0 22px, rgba(45, 31, 8, 0.035) 22px 23px),
      #f7f3ea;
    padding: 12px;
  }
  .fb-pp__head { display: flex; align-items: center; gap: 10px; border-bottom: 2px solid #2d1f08; padding-bottom: 10px; }
  .fb-pp__noun { image-rendering: pixelated; border: 1.5px solid #2d1f08; background: #fff; }
  .fb-pp__head-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .fb-pp__title { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; color: #2d1f08; }
  .fb-pp__sub { font-size: 9px; letter-spacing: 0.12em; color: #8b7a55; }
  .fb-pp__points { margin-left: auto; font-size: 10px; font-weight: 700; color: #185fa5; border: 1.5px solid #185fa5; padding: 2px 6px; white-space: nowrap; }

  .fb-pp__entries { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-height: 44px; padding: 10px 0 4px; }
  .fb-pp__entries-hint { font-size: 9.5px; color: #a4906a; letter-spacing: 0.08em; }
  .fb-pp-entry {
    display: inline-flex; flex-direction: column; align-items: center; gap: 1px;
    border: 2px double #1b4d8f; border-radius: 50% / 42%;
    color: #1b4d8f; padding: 5px 12px;
    transform: rotate(var(--pp-rot, 0deg));
    background: rgba(27, 77, 143, 0.04);
  }
  .fb-pp-entry__top { font-size: 7.5px; letter-spacing: 0.14em; }
  .fb-pp-entry__date { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; }
  .fb-pp-entry[data-thunk='true'] { animation: pp-thunk 0.5s cubic-bezier(0.2, 1.4, 0.4, 1); }
  @keyframes pp-thunk {
    0% { transform: rotate(var(--pp-rot, 0deg)) scale(2.1); opacity: 0; filter: blur(1.5px); }
    60% { transform: rotate(var(--pp-rot, 0deg)) scale(0.94); opacity: 1; filter: blur(0); }
    100% { transform: rotate(var(--pp-rot, 0deg)) scale(1); }
  }

  .fb-pp__label { font-size: 9px; letter-spacing: 0.14em; color: #8b7a55; margin: 10px 0 6px; }
  .fb-pp__stamps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .fb-pp-stamp { transform: rotate(var(--pp-rot, 0deg)); }
  .fb-pp-stamp__hit {
    display: flex; flex-direction: column; gap: 1px; align-items: flex-start;
    border: 1.5px dashed #b9ac90; color: #a4906a;
    padding: 5px 7px; text-decoration: none; min-height: 46px;
  }
  .fb-pp-stamp__label { font-size: 10px; font-weight: 600; line-height: 1.15; }
  .fb-pp-stamp__date { font-size: 8px; letter-spacing: 0.06em; }
  .fb-pp-stamp__pts { font-size: 8px; letter-spacing: 0.08em; opacity: 0.8; }
  .fb-pp-stamp[data-earned='false'] .fb-pp-stamp__hit:hover { border-color: #2d1f08; color: #2d1f08; }
  .fb-pp-stamp[data-earned='true'] .fb-pp-stamp__hit {
    border: 2px solid #8a2432; border-radius: 3px; color: #8a2432;
    background: rgba(138, 36, 50, 0.05);
  }
  .fb-pp-stamp[data-earned='true'] .fb-pp-stamp__hit:hover { transform: translateY(-1px); }

  .fb-pp__holos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .fb-holo {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    aspect-ratio: 1; border-radius: 10px; padding: 4px; text-align: center;
    border: 1.5px dashed #b9ac90; color: #a4906a;
    transform: perspective(300px) rotateX(var(--tiltx, 0deg)) rotateY(var(--tilty, 0deg));
    transition: transform 0.12s ease-out;
  }
  .fb-holo__foil {
