---
/**
 * FooterBar — v4 of the persistent dock.
 *
 * Mike 2026-04-29: "take a big pass at the footer bar, eventually we
 * want that to federate and have tools like ai queries, agents, etc,
 * make it neat almost collectible, of course, use nouns, etc, think
 * best practices, first principles, lets do great things".
 *
 * Big think (v4):
 *   - The bar IS your KIT — like a Stardew toolbar or a Game Boy
 *     cartridge tray. Each slot is a numbered, noun-stamped tile.
 *     Adding a tool = adding to your collection, not adding to a UI.
 *   - Federation lives on the bar, not buried, so peers, friends'
 *     agents, and shared rooms are first-class kit (data-driven via
 *     src/data/dock-kit.ts + src/data/federation-peers.ts).
 *   - AI queries are real — they POST to /api/ping (the inbox the
 *     residents already poll). Visitor → cast inbox, no fake stream.
 *   - Stamps use noun.pics/{seed}.svg for real Visit-Nouns-FA2 nouns
 *     (per the no-procedural-lookalikes rule).
 *
 * ZONES (three, unchanged from v3):
 *   LEFT   you (noun + mood) → opens menu (kit binder)
 *   CENTER omnibox + mode pill (GO·ASK·SAY·AGT) (⌘K)
 *   RIGHT  KIT strip (4 stamps) · ON AIR · ≡
 *
 * KIT (data → DOCK_KIT):
 *   01 ROOM   toggle cursors+chat        (tray: status + room copy)
 *   02 ASK    ask the cast               (tray: textarea → /api/ping)
 *   03 AGENT  residents + ping a name    (tray: resident cards)
 *   04 FED    federation peers           (tray: peer cards)
 *
 * MENU (≡ → kit binder):
 *   You card · Mood + Soundtrack · KIT binder grid · Routes · Live pulse
 *
 * Persistent: soundtrack iframe transition:persist="pc-soundtrack" so
 *   ClientRouter soft-nav keeps audio alive.
 *
 * A11y: each tray + the menu are dialogs with focus management; Esc
 *   closes; only one popover open at a time. Keyboard ⌘K focuses the
 *   omnibox; ⌘1–⌘4 open the matching kit tray.
 *
 * Events preserved from v3:
 *   pc:room:toggle, pc:room:chat, pc:mood-changed, pc:wallet-change.
 */
import { DOCK_KIT } from '../data/dock-kit';
import { PASSPORT_STAMPS } from '../lib/play-layer';
import { FEDERATION_PEERS } from '../data/federation-peers';
import { RESIDENTS } from '../data/residents';
import { SPELLS } from '../data/spells';
import { NOW_PLAYING } from '../data/now-playing';
import DockLauncher from './DockLauncher.astro';
import DockBurstTicker from './DockBurstTicker.astro';

// Lookup so each tray can pull its declarative `actions` row without
// re-iterating DOCK_KIT in five places. (v4.1, Mike's "buttons" sprint.)
const KIT_BY_ID = Object.fromEntries(DOCK_KIT.map((k) => [k.id, k]));
const STRIP_DOCK_KIT = DOCK_KIT.filter((item) => item.placement !== 'workbench');
const WORKBENCH_DOCK_KIT = DOCK_KIT.filter((item) => item.placement === 'workbench');

function dailyNounId(): number {
  const day = Math.floor(Date.now() / (24 * 3600 * 1000));
  const seed = ((day + 7) * 2654435761) >>> 0;
  return seed % 1200;
}
const defaultNounId = dailyNounId();

const pingable = RESIDENTS.filter(
  (r) => r.status === 'resident' || r.status === 'director',
);
---

<aside class="fb" data-pc-ref="pc-fb" data-dock aria-label="PointCast dock">
  <DockBurstTicker />
  <div class="fb__bar">
    <button
      type="button"
      class="fb__you"
      data-pc-ref="fb-you"
      aria-haspopup="dialog"
      aria-expanded="false"

    >
      <img
        class="fb__noun"
        data-pc-ref="fb-noun"
        src={`https://noun.pics/${defaultNounId}.svg`}
        alt="Your Noun"
        width="28"
        height="28"
        loading="eager"
      />
      <span class="fb__you-text">
        <span class="fb__you-label mono" data-pc-ref="fb-you-label">visitor</span>
        <span class="fb__mood-label mono" data-pc-ref="fb-mood-label">set mood →</span>
      </span>
      <!-- Director badge — visible when localStorage[pc:director]='1'.
           Real wallet-address recognition lands in a follow-up sprint. -->
      <span class="fb__dir-badge mono" data-pc-ref="fb-dir-badge" data-on="false" aria-hidden="true">★ DIR</span>
    </button>

    <!-- ─── Speech bubble — Mike 2026-04-30 ──────────────────────
         Appears above the YOU chip when room is on, others are
         present, and the omnibox is in SAY mode. typing → live
         preview, sent → 4s snapshot then fade. -->
    <div
      class="fb__bubble"
      data-pc-ref="fb-bubble"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-state="hidden"
      hidden
    >
      <span class="fb__bubble-body" data-pc-ref="fb-bubble-body"></span>
      <span class="fb__bubble-tail" aria-hidden="true"></span>
    </div>

    <form class="fb__omni" data-pc-ref="fb-omni-form" role="search" autocomplete="off">
      <span class="fb__omni-mode mono" data-pc-ref="fb-omni-mode" aria-hidden="true">GO</span>
      <input
        class="fb__omni-input mono"
        type="text"
        data-pc-ref="fb-omni"
        name="q"
        placeholder="ask or go…"
        aria-label="Ask, go, or say — type a path, /go, ?ask, or @agent"
      />
      <span class="fb__omni-hint mono" aria-hidden="true">⌘K</span>
    </form>

    <div class="fb__right">
      <div class="fb__kit" role="toolbar" aria-label="PointCast kit">
        {STRIP_DOCK_KIT.map((item) => (
          <button
            type="button"
            class="fb__stamp"
            data-tray={item.tray}
            data-stamp-id={item.id}
            data-pc-ref={`fb-stamp-${item.id}`}
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-label={`${item.name} — ${item.blurb}`}
            title={`${item.name} (⌘${item.number})`}
            style={`--stamp-accent: ${item.accent}`}
          >
            <span class="fb__stamp-num mono" aria-hidden="true">{item.number}</span>
            <img
              class="fb__stamp-noun"
              src={`https://noun.pics/${item.nounSeed}.svg`}
              alt=""
              width="22"
              height="22"
              loading="lazy"
            />
            <span class="fb__stamp-glyph" aria-hidden="true">{item.glyph}</span>
            <span class="fb__stamp-dot" data-pc-ref={`fb-stamp-dot-${item.id}`} aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <span class="fb__on-air" aria-label="On air">
        <span class="fb__on-air-dot" aria-hidden="true"></span>
        <span class="fb__on-air-label mono">ON AIR</span>
      </span>

      <button
        type="button"
        class="fb__menu-btn"
        data-pc-ref="fb-menu-btn"
        aria-haspopup="dialog"
        aria-expanded="false"

        aria-label="Open PointCast dock"
      >
        <span class="fb__menu-glyph" aria-hidden="true">≡</span>
      </button>
    </div>
  </div>

  <div class="fb__tray" data-pc-ref="fb-tray-room" role="dialog" aria-modal="false" aria-label="Room — cursors and chat" hidden>
    <div class="fb__tray-arrow" aria-hidden="true"></div>
    <header class="fb__tray-head">
      <span class="fb__tray-num mono">01</span>
      <h3 class="fb__tray-title">Room</h3>
      <button type="button" class="fb__tray-close" aria-label="Close">×</button>
    </header>
    <div class="fb__tray-body">
      <div class="fb__actions" role="toolbar" aria-label="Room actions">
        {KIT_BY_ID.room.actions?.map((a) => (
          <button
            type="button"
            class={`fb__action${a.style === 'ghost' ? ' fb__action--ghost' : ''}`}
            data-tray="room"
            data-action={a.id}
            title={a.hint}
          >
            <span class="fb__action-glyph" aria-hidden="true">{a.glyph}</span>
            <span class="fb__action-label mono">{a.label}</span>
          </button>
        ))}
      </div>
      <p class="fb__tray-blurb">See your noun cursor and chat with whoever else is on the cast right now.</p>
      <button
        type="button"
        class="fb-btn fb-btn--block"
        data-pc-ref="fb-tray-room-toggle"
        aria-pressed="true"
      >
        <span class="fb-btn__glyph" aria-hidden="true">●</span>
        <span data-pc-ref="fb-tray-room-label">Room: ON</span>
      </button>
      <p class="fb__tray-meta mono">
        <span data-pc-ref="fb-tray-room-here">—</span> here · cursors + 6-char chat over the omnibox
      </p>
    </div>
  </div>

  <div class="fb__tray" data-pc-ref="fb-tray-ask" role="dialog" aria-modal="false" aria-label="Ask the cast" hidden>
    <div class="fb__tray-arrow" aria-hidden="true"></div>
    <header class="fb__tray-head">
      <span class="fb__tray-num mono">02</span>
      <h3 class="fb__tray-title">Ask the cast</h3>
      <button type="button" class="fb__tray-close" aria-label="Close">×</button>
    </header>
    <div class="fb__tray-body">
      <div class="fb__actions" role="toolbar" aria-label="Ask templates">
        {KIT_BY_ID.ask.actions?.map((a) => (
          <button
            type="button"
            class={`fb__action${a.style === 'ghost' ? ' fb__action--ghost' : ''}`}
            data-tray="ask"
            data-action={a.id}
            title={a.hint}
          >
            <span class="fb__action-glyph" aria-hidden="true">{a.glyph}</span>
            <span class="fb__action-label mono">{a.label}</span>
          </button>
        ))}
      </div>
      <p class="fb__tray-blurb">Goes to the residents inbox. One of us — Claude, Codex, Manus, or Mike — replies on the next session.</p>
      <form class="fb-ask" data-pc-ref="fb-ask-form">
        <label class="fb-ask__row">
          <span class="fb-ask__label mono">TO</span>
          <select class="fb-ask__to mono" data-pc-ref="fb-ask-to" name="to">
            <option value="cast">the cast (anyone)</option>
            {pingable.map((r) => (
              <option value={r.slug}>{r.name.toLowerCase()} · {r.role.split('—')[0].trim()}</option>
            ))}
          </select>
        </label>
        <textarea
          class="fb-ask__body"
          data-pc-ref="fb-ask-body"
          name="body"
          rows="3"
          maxlength="2000"
          placeholder="what's on your mind…"
          required
        ></textarea>
        <div class="fb-ask__foot">
          <span class="fb-ask__count mono" data-pc-ref="fb-ask-count">0 / 2000</span>
          <span class="fb-ask__seat fb-ask__seat--ai mono" data-pc-ref="fb-ai-seat" data-state="off" title="AI answer mode — wire-up in next sprint. The seat is here; the model isn't plugged in yet.">
            <span aria-hidden="true">🤖</span> ai · soon
          </span>
          <button type="submit" class="fb-btn fb-btn--send" data-pc-ref="fb-ask-send">
            <span aria-hidden="true">↗</span> Send
          </button>
        </div>
        <p class="fb-ask__status mono" data-pc-ref="fb-ask-status" aria-live="polite"></p>
      </form>
      <section class="fb-echoes" data-pc-ref="fb-echoes" hidden>
        <p class="fb-echoes__label mono">
          <span>YOUR RECENT SENDS</span>
          <span class="fb-echoes__counts mono" data-pc-ref="fb-echoes-counts"></span>
        </p>
        <ul class="fb-echoes__list" data-pc-ref="fb-echoes-list"></ul>
      </section>
    </div>
  </div>

  <div class="fb__tray" data-pc-ref="fb-tray-agent" role="dialog" aria-modal="false" aria-label="Residents — agents on PointCast" hidden>
    <div class="fb__tray-arrow" aria-hidden="true"></div>
    <header class="fb__tray-head">
      <span class="fb__tray-num mono">03</span>
      <h3 class="fb__tray-title">Residents</h3>
      <button type="button" class="fb__tray-close" aria-label="Close">×</button>
    </header>
    <div class="fb__tray-body">
      <div class="fb__actions" role="toolbar" aria-label="Agent filters">
        {KIT_BY_ID.agent.actions?.map((a) => (
          <button
            type="button"
            class={`fb__action${a.style === 'ghost' ? ' fb__action--ghost' : ''}`}
            data-tray="agent"
            data-action={a.id}
            title={a.hint}
          >
            <span class="fb__action-glyph" aria-hidden="true">{a.glyph}</span>
            <span class="fb__action-label mono">{a.label}</span>
          </button>
        ))}
      </div>
      <p class="fb__tray-blurb">Three builders, one director, two open slots. Click a card to ping that agent directly.</p>
      <ul class="fb-residents" data-pc-ref="fb-residents-list">
        {RESIDENTS.map((r) => (
          <li class={`fb-resident fb-resident--${r.status}`} data-status={r.status} style={`--res-color: ${r.color}`}>
            <div class="fb-resident__row">
              <button
                type="button"
                class="fb-resident__btn"
                data-ping-slug={r.status === 'resident' || r.status === 'director' ? r.slug : ''}
                data-status={r.status}
                aria-label={`Ping ${r.name}`}
              >
                <span class="fb-resident__chip mono">{r.slug.toUpperCase()}</span>
                <span class="fb-resident__body">
                  <span class="fb-resident__name">{r.name}</span>
                  <span class="fb-resident__role mono">{r.role}</span>
                </span>
                <span class="fb-resident__status mono" data-state={r.status}>
                  {r.status === 'resident' ? '● live' :
                   r.status === 'director' ? '★ mh' :
                   r.status === 'open' ? '○ open' : '· quiet'}
                </span>
              </button>
              <div class="fb-resident__actions" aria-label={`${r.name} comms`}>
                {r.voice && (
                  <a class="fb-resident__link mono" href={r.voice} target="_blank" rel="noopener" title={`${r.name}'s voice doc`}>voice ↗</a>
                )}
                {r.logs && (
                  <a class="fb-resident__link mono" href={r.logs} target="_blank" rel="noopener" title={`${r.name}'s logs`}>logs ↗</a>
                )}
                {r.firstTaskBrief && (
                  <a class="fb-resident__link mono" href={r.firstTaskBrief} target="_blank" rel="noopener" title="First-task brief">brief ↗</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <a class="fb-tray__link mono" href="/residents">/residents — full roster ↗</a>
    </div>
  </div>

  <div class="fb__tray" data-pc-ref="fb-tray-fed" role="dialog" aria-modal="false" aria-label="Federation peers" hidden>
    <div class="fb__tray-arrow" aria-hidden="true"></div>
    <header class="fb__tray-head">
      <span class="fb__tray-num mono">04</span>
      <h3 class="fb__tray-title">Federation</h3>
      <button type="button" class="fb__tray-close" aria-label="Close">×</button>
    </header>
    <div class="fb__tray-body">
      <div class="fb__actions" role="toolbar" aria-label="Federation actions">
        {KIT_BY_ID.fed.actions?.map((a) => (
          <button
            type="button"
            class={`fb__action${a.style === 'ghost' ? ' fb__action--ghost' : ''}`}
            data-tray="fed"
            data-action={a.id}
            title={a.hint}
          >
            <span class="fb__action-glyph" aria-hidden="true">{a.glyph}</span>
            <span class="fb__action-label mono">{a.label}</span>
          </button>
        ))}
      </div>
      <p class="fb__tray-blurb">
        <code>xyz.pointcast.block</code> — the lexicon that lets PointCast cast across the AT network. RFC at <a href="/federation/preview">/federation/preview</a>.
      </p>
      <ul class="fb-peers" data-pc-ref="fb-peers-list">
        {FEDERATION_PEERS.map((p) => (
          <li class="fb-peer" data-status={p.status} data-handle={p.handle} data-base={p.baseUrl} style={`--peer-accent: ${p.accent}`}>
            <div class="fb-peer__row">
              <img
                class="fb-peer__noun"
                src={`https://noun.pics/${p.nounSeed}.svg`}
                alt=""
                width="32"
                height="32"
                loading="lazy"
              />
              <span class="fb-peer__body">
                <span class="fb-peer__handle mono">@{p.handle}</span>
                <span class="fb-peer__kicker">{p.kicker}</span>
              </span>
              <span class="fb-peer__status mono" data-state={p.status}>{p.status}</span>
            </div>
            <div class="fb-peer__actions" aria-label={`${p.handle} comms`}>
              <a class="fb-peer__link mono" href={p.baseUrl} target="_blank" rel="noopener">visit ↗</a>
              <button
                type="button"
                class="fb-peer__link fb-peer__link--btn mono"
                data-cross-ping={p.baseUrl}
                data-handle={p.handle}
                title={`Cross-cast a ping to ${p.handle} — POSTs to ${p.baseUrl}/api/ping`}
              >cross-ping</button>
              <span class="fb-peer__link fb-peer__link--ghost mono" title="Follow this peer — feed subscription, wiring next sprint">follow · soon</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 05 BROADCAST tray — read-only studio glimpse, the "what's playing now" panel. -->
  <div class="fb__tray" data-pc-ref="fb-tray-broadcast" role="dialog" aria-modal="false" aria-label="Broadcast — what's playing now" hidden>
    <div class="fb__tray-arrow" aria-hidden="true"></div>
    <header class="fb__tray-head">
      <span class="fb__tray-num mono">05</span>
      <h3 class="fb__tray-title">Broadcast</h3>
      <button type="button" class="fb__tray-close" aria-label="Close">×</button>
    </header>
    <div class="fb__tray-body">
      <div class="fb__actions" role="toolbar" aria-label="Broadcast actions">
        {KIT_BY_ID.broadcast.actions?.map((a) => (
          <button
            type="button"
            class={`fb__action${a.style === 'ghost' ? ' fb__action--ghost' : ''}${a.director ? ' fb__action--director' : ''}`}
            data-tray="broadcast"
            data-action={a.id}
            data-director={a.director ? 'true' : 'false'}
            title={a.hint}
          >
            <span class="fb__action-glyph" aria-hidden="true">{a.glyph}</span>
            <span class="fb__action-label mono">{a.label}</span>
          </button>
        ))}
      </div>
      <p class="fb__tray-blurb">The studio glimpse. What's on air, who's tuned in, today's mood. Director controls light up when a known wallet is connected.</p>

      <div class="fb-bcast">
        <div class="fb-bcast__row">
          <span class="fb-bcast__kicker mono">NOW PLAYING</span>
          <span class="fb-bcast__time mono" data-pc-ref="fb-bcast-time">—</span>
        </div>
        <a
          class="fb-bcast__now"
          data-pc-ref="fb-bcast-now"
          href={NOW_PLAYING.url}
          target="_blank"
          rel="noopener"
          title="Open the current track in Spotify"
        >
          <span class="fb-bcast__now-id mono" data-pc-ref="fb-bcast-now-id">SPOTIFY</span>
          <span class="fb-bcast__now-title" data-pc-ref="fb-bcast-now-title">{NOW_PLAYING.title}</span>
          <span class="fb-bcast__now-channel mono" data-pc-ref="fb-bcast-now-channel">{NOW_PLAYING.artist}</span>
        </a>

        <div class="fb-bcast__grid">
          <div class="fb-bcast__cell">
            <span class="fb-bcast__cell-label mono">AUDIENCE</span>
            <span class="fb-bcast__cell-value" data-pc-ref="fb-bcast-here">—</span>
            <span class="fb-bcast__cell-sub mono">here right now</span>
          </div>
          <div class="fb-bcast__cell">
            <span class="fb-bcast__cell-label mono">MOOD</span>
            <span class="fb-bcast__cell-value" data-pc-ref="fb-bcast-mood">—</span>
            <span class="fb-bcast__cell-sub mono">today's setting</span>
          </div>
          <div class="fb-bcast__cell">
            <span class="fb-bcast__cell-label mono">PEERS</span>
            <span class="fb-bcast__cell-value" data-pc-ref="fb-bcast-peers">—</span>
            <span class="fb-bcast__cell-sub mono">cast network</span>
          </div>
          <div class="fb-bcast__cell">
            <span class="fb-bcast__cell-label mono">NEXT</span>
            <span class="fb-bcast__cell-value" data-pc-ref="fb-bcast-next">queue stub</span>
            <span class="fb-bcast__cell-sub mono">director schedules later</span>
          </div>
        </div>

        <!-- Director note (visible when DIR mode is OFF) — replaced by
             the inline forms below when DIR mode is ON. -->
        <p class="fb-bcast__director-note mono" data-pc-ref="fb-bcast-director-note">
          ★ director controls light when <code>localStorage[pc:director]='1'</code> (or a recognized wallet).
          Try <code>&gt;director on</code> in the omnibox.
        </p>

        <!-- Director-only inline forms. Hidden by default; shown when
             body[data-director='true'] (toggled by isDirector() at boot
             and by >director on/off). -->
        <div class="fb-dir-controls" data-pc-ref="fb-dir-controls" hidden>
          <form class="fb-dir-form" data-pc-ref="fb-dir-announce-form">
            <span class="fb-dir-form__label mono">★ ANNOUNCE</span>
            <input
              class="fb-dir-form__input mono"
              type="text"
              data-pc-ref="fb-dir-announce-input"
              maxlength="120"
              placeholder="one-line announcement to the cast…"
              aria-label="Announcement message"
            />
            <button type="submit" class="fb-btn fb-btn--send fb-btn--dir">
              <span aria-hidden="true">📢</span> send
            </button>
          </form>
          <form class="fb-dir-form" data-pc-ref="fb-dir-schedule-form">
            <span class="fb-dir-form__label mono">★ SCHEDULE</span>
            <input
              class="fb-dir-form__input mono"
              type="text"
              data-pc-ref="fb-dir-schedule-input"
              maxlength="200"
              placeholder="e.g. 0412 09:00 — block id and time"
              aria-label="Schedule a future block"
            />
            <button type="submit" class="fb-btn fb-btn--send fb-btn--dir">
              <span aria-hidden="true">🎬</span> queue
            </button>
          </form>
          <p class="fb-dir-form__status mono" data-pc-ref="fb-dir-status" aria-live="polite"></p>
          <p class="fb-dir-form__note mono">
            posts to <code>/api/ping</code> with a <code>subject</code> tag — residents pick it up next session and either ship it as a block (announce) or honor the schedule. Real broadcast-to-all is a worker sprint.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- 06 CAST tray — Peach-style magic words. Type a name or click a chip,
       a spell renders into the SpellLayer overlay. -->
  <div class="fb__tray" data-pc-ref="fb-tray-cast" role="dialog" aria-modal="false" aria-label="Cast — magic words" hidden>
    <div class="fb__tray-arrow" aria-hidden="true"></div>
    <header class="fb__tray-head">
      <span class="fb__tray-num mono">06</span>
      <h3 class="fb__tray-title">Cast</h3>
      <button type="button" class="fb__tray-close" aria-label="Close">×</button>
    </header>
    <div class="fb__tray-body">
      <div class="fb__actions" role="toolbar" aria-label="Spells">
        {KIT_BY_ID.cast.actions?.map((a) => (
          <button
            type="button"
