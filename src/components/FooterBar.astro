              <button
                type="button"
                class="fb-binder__open"
                data-tray={item.tray}
                aria-label={`Open ${item.name} tray`}
              >
                <span class="fb-binder__num mono">№ {item.number}</span>
                <img
                  class="fb-binder__noun"
                  src={`https://noun.pics/${item.nounSeed}.svg`}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                />
                <span class="fb-binder__glyph" aria-hidden="true">{item.glyph}</span>
                <span class="fb-binder__name">{item.name}</span>
                <span class="fb-binder__blurb mono">{item.blurb}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <section class="fb-routes">
        <div class="fb-routes__group">
          <p class="fb-routes__label mono">ROOMS</p>
          <div class="fb-routes__links">
            <a href="/tonight">tonight</a>
            <a href="/room">room</a>
            <a href="/meditate">meditate</a>
            <a href="/bath">bath</a>
          </div>
        </div>
        <div class="fb-routes__group">
          <p class="fb-routes__label mono">GAMES</p>
          <div class="fb-routes__links">
            <a href="/farm">farm</a>
            <a href="/agent-derby">derby</a>
            <a href="/battle">battle</a>
            <a href="/nouns-open-circuit">circuit</a>
            <a href="/yee">yee</a>
            <a href="/nouns-cola-crush">cola</a>
            <a href="/collabs/relay">relay</a>
          </div>
        </div>
        <div class="fb-routes__group">
          <p class="fb-routes__label mono">AGENTS</p>
          <div class="fb-routes__links">
            <a href="/for-agents">for-agents</a>
            <a href="/agents.json">agents.json</a>
            <a href="/llms.txt">llms.txt</a>
            <a href="/explore">explore</a>
            <a href="/status">status</a>
          </div>
        </div>
        <div class="fb-routes__group">
          <p class="fb-routes__label mono">RELEASE</p>
          <div class="fb-routes__links">
            <a href="/gamgee">gamgee (RC0)</a>
            <a href="/sprints">sprints</a>
            <a href="/now">now</a>
          </div>
        </div>
