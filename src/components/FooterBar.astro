  .fb-routes { margin-bottom: 14px; }
  .fb-routes__group { margin-bottom: 10px; }
  .fb-routes__group:last-child { margin-bottom: 0; }
  .fb-routes__label { font-size: 9.5px; letter-spacing: 0.22em; color: #8a2432; margin: 0 0 5px; font-weight: 700; }
  .fb-routes__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    font-family: Georgia, serif;
    font-size: 13.5px;
  }
  .fb-routes__links a { color: #2d1f08; text-decoration: none; border-bottom: 1px solid #d4c6a4; padding-bottom: 1px; }
  .fb-routes__links a:hover { border-bottom-color: #8a2432; color: #8a2432; }

  .fb-live {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed #d4c6a4;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #6b5a3a;
  }
  .fb-live__dot { width: 6px; height: 6px; border-radius: 50%; background: #2f8f5f; box-shadow: 0 0 6px rgba(47, 143, 95, 0.5); }
  .fb-live__link { margin-left: auto; color: #8a2432; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }

  body { padding-bottom: 48px; }

  /* ─── v4.1 styles — buttons + studio + comms ─────────────────── */

  /* Quick-action chip row at the top of every tray body. */
  .fb__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 0 0 10px;
    margin: 0 0 8px;
    border-bottom: 1px dotted #d4c6a4;
  }
  .fb__action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    background: #fffdf8;
    border: 1px solid #c5b284;
    border-radius: 2px;
    cursor: pointer;
    color: #2d1f08;
    font: inherit;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }
  .fb__action:hover { background: #faf2dc; border-color: #2d1f08; transform: translateY(-1px); }
  .fb__action--ghost { background: transparent; border-color: #ece4d3; color: #6b5a3a; }
  .fb__action--ghost:hover { background: #faf2dc; color: #2d1f08; }
  .fb__action--director {
    border-color: #c4952e;
    color: #c4952e;
    background: #fffaec;
  }
  .fb__action--director:hover { background: #c4952e; color: #fff; }
  .fb__action[data-flash='true'] {
    animation: fb-action-flash 0.6s ease;
  }
  @keyframes fb-action-flash {
    0%, 100% { background: #fffdf8; }
    50%      { background: #f8e9c8; }
  }
  .fb__action-glyph { font-size: 11px; line-height: 1; }
  .fb__action-label { font-size: 10px; letter-spacing: 0.1em; font-weight: 700; text-transform: lowercase; }

  /* AI seat in the ASK form foot. */
  .fb-ask__seat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 2px;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    font-weight: 700;
    cursor: not-allowed;
  }
  .fb-ask__seat--ai[data-state='off'] {
    background: rgba(45, 31, 8, 0.05);
    border: 1px dashed #c5b284;
    color: #8a7854;
  }
  .fb-ask__seat--ai[data-state='off']:hover { background: rgba(45, 31, 8, 0.1); }

  /* Resident row — card + comms strip. */
  .fb-resident__row { display: contents; }
  .fb-resident { display: flex; flex-direction: column; gap: 2px; }
  .fb-resident__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 8px 6px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-top: 0;
    border-left: 3px solid var(--res-color, #4e3a16);
    border-radius: 0 0 2px 2px;
    margin-top: -2px;
  }
  .fb-resident__link {
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #6b5a3a;
    text-decoration: none;
    border-bottom: 1px dotted #c5b284;
    padding-bottom: 1px;
  }
  .fb-resident__link:hover { color: var(--res-color, #4e3a16); border-bottom-color: var(--res-color, #4e3a16); }
  /* Filter behavior — applied via #fb-residents-list[data-filter=…]. */
  #fb-residents-list[data-filter='live'] .fb-resident:not([data-status='resident']):not([data-status='director']) { display: none; }
  #fb-residents-list[data-filter='open'] .fb-resident:not([data-status='open']) { display: none; }

  /* Federation peer — row + comms strip. */
  .fb-peer { display: flex; flex-direction: column; gap: 2px; }
  .fb-peer__row {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-left: 3px solid var(--peer-accent, #4e3a16);
    border-radius: 2px 2px 0 0;
  }
  .fb-peer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 8px 6px;
    background: #fffdf8;
    border: 1px solid #d4c6a4;
    border-top: 0;
    border-left: 3px solid var(--peer-accent, #4e3a16);
    border-radius: 0 0 2px 2px;
    margin-top: -1px;
  }
  .fb-peer__link {
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #6b5a3a;
    text-decoration: none;
    border-bottom: 1px dotted #c5b284;
    padding-bottom: 1px;
    background: none;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .fb-peer__link:hover { color: var(--peer-accent, #4e3a16); border-bottom-color: var(--peer-accent, #4e3a16); }
  .fb-peer__link--btn:disabled { cursor: progress; opacity: 0.7; }
  .fb-peer__link--ghost { color: #b09060; cursor: default; border-bottom-style: dotted; }
  .fb-peer__link--ghost:hover { color: #b09060; border-bottom-color: #d4c6a4; }

  /* Operator mode pill (`>` prefix in omnibox). */
  .fb__omni-mode[data-mode='op'] {
    background: rgba(196, 149, 46, 0.3);
    color: #fff7d4;
