---
import { MANIC_MONDAY, WORKLIFE_PUBLICATION } from '../lib/worklife-publication';

const issue = MANIC_MONDAY;
const publication = WORKLIFE_PUBLICATION;
---

<section class="home-worklife" aria-labelledby="home-worklife-title">
  <header class="home-worklife__wire mono">
    <span>MONDAY / 09:12 PT</span>
    <span>NEW POINTCAST PUBLICATION</span>
    <span>ISSUE 001 / BLOCK {issue.blockId}</span>
  </header>
  <div class="home-worklife__main">
    <a class="home-worklife__cover" href={issue.route} aria-label={`Open ${issue.displayTitle}`}>
      <img src={issue.cover} alt={issue.coverAlt} width="1536" height="1536" loading="eager" />
      <span class="mono">PLAY<br />001</span>
    </a>
    <div class="home-worklife__copy">
      <p class="mono">WORK IS THE SETTING / LIFE IS THE STAKES</p>
      <h2 id="home-worklife-title"><span>WORK</span><span>/LIFE</span></h2>
      <h3>Another Manic Monday</h3>
      <p>{issue.description}</p>
      <blockquote>{publication.dek}</blockquote>
      <div>
        <a href={issue.route}>Read + play Issue 001 ↗</a>
        <a href={publication.route}>Open the publication ↗</a>
      </div>
    </div>
  </div>
  <footer>
    <span class="mono">NOT JUST MONDAY:</span>
    <span>The Shift</span><span>Office Weather</span><span>Tool Drawer</span><span>Lunch</span><span>Payroll</span><span>Exit Interview</span>
  </footer>
</section>

<style>
  .home-worklife { --ink:#11110f; --paper:#f4efdd; --acid:#d7f51b; --blue:#1747d1; --orange:#ef542e; margin-top:16px; border:2px solid var(--ink); background:var(--paper); color:var(--ink); overflow:hidden; }
  .home-worklife a { color:inherit; }
  .mono { font-family:var(--pc-font-mono); }
  .home-worklife__wire { display:flex; justify-content:space-between; gap:12px; padding:10px 13px; background:var(--ink); color:var(--paper); font-size:9px; font-weight:900; letter-spacing:.1em; }
  .home-worklife__main { display:grid; grid-template-columns:minmax(340px,.85fr) minmax(0,1.15fr); min-height:680px; }
  .home-worklife__cover { position:relative; border-right:2px solid var(--ink); background:var(--acid); }
  .home-worklife__cover img { display:block; width:100%; height:100%; min-height:680px; object-fit:cover; }
  .home-worklife__cover > span { position:absolute; right:16px; bottom:16px; padding:12px 15px; background:var(--ink); color:var(--acid); font-size:10px; font-weight:900; line-height:1.3; }
  .home-worklife__copy { display:flex; flex-direction:column; justify-content:center; padding:clamp(30px,5.5vw,82px); background:var(--acid); }
  .home-worklife__copy > p:first-child { margin:0 0 28px; font-size:9px; font-weight:900; letter-spacing:.1em; }
  .home-worklife__copy h2 { margin:0; font-size:clamp(86px,12vw,180px); line-height:.68; letter-spacing:-.09em; }
  .home-worklife__copy h2 span { display:block; }
  .home-worklife__copy h2 span:last-child { color:var(--blue); transform:translateX(11%); }
  .home-worklife__copy h3 { margin:58px 0 0; color:var(--orange); font-size:clamp(38px,4vw,62px); line-height:.95; letter-spacing:-.05em; }
  .home-worklife__copy > p:not(:first-child) { max-width:680px; margin:22px 0 0; font-size:18px; line-height:1.4; }
  .home-worklife__copy blockquote { margin:24px 0 0; padding:14px 18px; border-left:7px solid var(--ink); background:var(--paper); font-size:16px; font-weight:800; }
  .home-worklife__copy > div { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
  .home-worklife__copy > div a { padding:12px 14px; border:2px solid var(--ink); font:900 10px var(--pc-font-mono); text-decoration:none; }
  .home-worklife__copy > div a:first-child { background:var(--ink); color:var(--paper); }
  .home-worklife footer { display:flex; flex-wrap:wrap; gap:10px 22px; padding:13px; border-top:2px solid var(--ink); font-size:11px; font-weight:800; }
  .home-worklife footer .mono { color:var(--orange); font-size:9px; letter-spacing:.08em; }
  @media (max-width:820px) { .home-worklife__main { grid-template-columns:1fr; } .home-worklife__cover { border-right:0; border-bottom:2px solid var(--ink); } .home-worklife__cover img { min-height:0; } }
  @media (max-width:560px) { .home-worklife__wire span:nth-child(2) { display:none; } .home-worklife__copy { padding:42px 20px; } .home-worklife__copy h2 { font-size:clamp(80px,27vw,132px); } .home-worklife__copy h2 span:last-child { transform:none; } }
</style>
