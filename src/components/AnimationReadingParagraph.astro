---
import {readingBlock} from '../lib/animation-reading.mjs';
import AnimationReadingText from './AnimationReadingText.astro';
const block=readingBlock(Astro.props.text);
---
{block.kind==='ordered'?<ol class="checklist">{block.items.map(text=><li><AnimationReadingText text={text}/></li>)}</ol>:block.kind==='unordered'?<ul class="checklist">{block.items.map(text=><li><AnimationReadingText text={text}/></li>)}</ul>:<p><AnimationReadingText text={block.text}/></p>}
