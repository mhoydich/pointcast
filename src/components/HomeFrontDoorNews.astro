---
interface NewsItem {
  label: string;
  line: string;
  link: string;
  date: string;
}

interface Props { news: NewsItem[] }
const { news } = Astro.props;
---

<section class="front-news" aria-labelledby="front-news-title">
  <div class="front-news__head">
    <p>Changed since Sep 02</p>
    <h2 id="front-news-title">New this week</h2>
  </div>
  <ol>
    {news.map((item) => (
      <li>
        <a href={item.link}>
          <span class="front-news__label">{item.label}</span>
          <span class="front-news__line">{item.line}</span>
          <time datetime={item.date}>{item.date.slice(5).replace('-', '.')}</time>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .front-news { display: grid; grid-template-columns: 180px minmax(0, 1fr); margin-top: 32px; border: 2px solid #111; background: #fffdf6; }
  .front-news__head { padding: 18px; border-right: 2px solid #111; }
  .front-news__head p, .front-news__label, .front-news time { font: 700 9px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .front-news__head p { margin: 0 0 8px; color: #8a2432; }
  .front-news h2 { margin: 0; font-size: 25px; line-height: 1; letter-spacing: -.04em; }
  .front-news ol { display: grid; grid-template-columns: repeat(7, minmax(145px, 1fr)); margin: 0; padding: 0; overflow-x: auto; list-style: none; }
  .front-news li { min-width: 0; border-right: 1px solid rgba(0, 0, 0, .18); }
  .front-news li:last-child { border-right: 0; }
  .front-news a { display: flex; flex-direction: column; min-height: 132px; height: 100%; padding: 15px 13px 12px; color: #111; }
  .front-news a:hover { background: #f7efe6; text-decoration: none; }
  .front-news__label { color: #8a2432; }
  .front-news__line { margin-top: 8px; font-size: 12px; line-height: 1.35; }
  .front-news time { margin-top: auto; padding-top: 12px; color: #5f5e5a; font-size: 8px; }
  @media (max-width: 880px) { .front-news { grid-template-columns: 1fr; } .front-news__head { border-right: 0; border-bottom: 1px solid rgba(0, 0, 0, .18); } }
</style>
