---
import ProductionReadingDiagrams from './ProductionReadingDiagrams.astro';
const {items=[],diagram}=Astro.props;
---
{items.length>0&&<div class="archive-gallery" aria-label="Historical photographs and contextual images">{items.map(a=><figure class:list={{inset:a.width<350,panorama:a.width/a.height>3}}><a href={a.sourcePage} aria-label={`Open source and license record: ${a.title}`}><img src={a.src} srcset={a.smallSrc?`${a.smallSrc} ${a.smallWidth}w, ${a.src} ${a.width}w`:undefined} sizes="(max-width: 720px) 100vw, 45vw" width={a.width} height={a.height} alt={a.alt} loading="lazy" decoding="async"/></a><figcaption><strong>{a.caption}</strong><span>Credit: {a.credit}. <a href={a.licenseUrl}>{a.license}</a> · <a href={a.sourcePage}>Source record ↗</a></span><span>{a.changes}</span>{a.notes&&<details><summary>Image context and rights</summary><p>{a.notes}</p></details>}</figcaption></figure>)}</div>}
{diagram&&<ProductionReadingDiagrams kind={diagram}/>}
<style>
.archive-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.6rem;margin-block:2rem}.archive-gallery figure{margin:0;min-width:0;background:#f5f1e9;border:1px solid #b8aea0;padding:.8rem}.archive-gallery img{display:block;width:100%;height:auto;max-height:560px;object-fit:contain;background:#ebe6dd}.archive-gallery .panorama{grid-column:1/-1}.archive-gallery .inset img{max-width:240px;margin-inline:auto}.archive-gallery figcaption{font-size:.85rem;line-height:1.55;margin-top:.7rem}.archive-gallery figcaption span{display:block;margin-top:.35rem}.archive-gallery summary{cursor:pointer;padding:.7rem 0;min-height:44px}.archive-gallery :is(a,summary):focus-visible{outline:3px solid #705042;outline-offset:4px}.archive-gallery details p{margin:.4rem 0}.archive-gallery a{overflow-wrap:anywhere}@media(max-width:720px){.archive-gallery{grid-template-columns:1fr}.archive-gallery img{max-height:600px}}
</style>
