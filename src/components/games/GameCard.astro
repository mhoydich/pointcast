---
import { gameLanding, gameDownloadType, type LibraryGame } from '../../lib/game-library';
const { game, index = 0 } = Astro.props as {game: LibraryGame; index?: number};
---
<article class="gp-card" data-game-card data-search={`${game.name} ${game.family} ${game.kicker} ${game.description} ${game.players}`.toLowerCase()} data-family={game.family} data-download={game.download.kind === 'online' ? 'online' : 'local'} style={`--game-accent:${game.accent}`}>
  <a class="gp-card-art" href={gameLanding(game)} aria-label={`Explore ${game.name}`}>
    {game.hero ? <img src={game.hero} alt="" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" width="720" height="450" /> : <span class="gp-card-letter" aria-hidden="true">{game.name.split(' ').map(part => part[0]).slice(0,2).join('')}</span>}
    <span class="gp-art-sticker">{game.family}</span>
  </a>
  <div class="gp-card-copy"><span class="gp-kicker">{game.kicker}</span><h3><a href={gameLanding(game)}>{game.name}</a></h3><p>{game.description}</p><div class="gp-card-meta"><span>{game.players}</span><span>{gameDownloadType(game)}</span></div><div class="gp-card-actions"><a href={gameLanding(game)}>Meet the game <span aria-hidden="true">↗</span></a><a href={game.playUrl}>Play now <span aria-hidden="true">→</span></a></div></div>
</article>
