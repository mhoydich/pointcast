---
import BlockLayout from '../../layouts/BlockLayout.astro';
import GameHeader from './GameHeader.astro';
import GameCard from './GameCard.astro';
import { GAME_LIBRARY, gameFamilies, gameLanding } from '../../lib/game-library';
import '../../styles/game-library.css';
const sunnyGames = [
  {slug:'roof-hop',name:'Rooftop Hop',kind:'ONE MORE JUMP',description:'Big little leaps. A very nutty rooftop run.',color:'#ffd46f',icon:'<path d="M8 49h22v-9h22v9h20M15 40V26h17v14m15-4V17h17v19"/><path d="M27 18q10-13 21-4m-6-6 8 5-8 5"/>'},
  {slug:'wire-walk',name:'High-Wire Snack',kind:'CATCH & DODGE',description:'A squirrel. A cable. An excellent snack.',color:'#a9d6f0',icon:'<path d="M7 41q33 13 66 0M17 12l6 10-8 8-6-10Zm39-3 6 10-8 8-6-10Z"/><circle cx="40" cy="34" r="9"/><path d="M46 37q21-5 15-18q-7-6-11 1"/>'},
  {slug:'puppy-dream',name:'Puppy Dream',kind:'FIND YOUR RHYTHM',description:'Soft paws, sweet dreams, perfectly timed taps.',color:'#f3bda9',icon:'<ellipse cx="40" cy="37" rx="22" ry="16"/><path d="m18 30-8-9 6 23m46-14 8-9-6 23M26 34q5 6 10 0m8 0q5 6 10 0m-17 9h6m-3-18v-7M56 9h9l-9 9h9"/>'},
  {slug:'pebble-pop',name:'Pebble Pop',kind:'TAP SOMETHING GOOD',description:'Find a little cluster. Make a lovely big pop.',color:'#c3d49c',icon:'<rect x="12" y="10" width="23" height="20" rx="9"/><rect x="43" y="10" width="23" height="20" rx="9"/><rect x="12" y="38" width="23" height="20" rx="9"/><path d="m55 36 2 8 8-2-6 6 6 6-8-2-2 8-2-8-8 2 6-6-6-6 8 2Z"/>'},
  {slug:'garden-pairs',name:'Garden Pairs',kind:'A LITTLE MEMORY MAGIC',description:'Turn a card. Find a friend. Match the garden.',color:'#d1c4ed',icon:'<rect x="10" y="10" width="27" height="44" rx="5" transform="rotate(-7 23 32)"/><rect x="45" y="10" width="27" height="44" rx="5" transform="rotate(7 58 32)"/><path d="M23 42V25m0 8q-10 0-8-9 9-1 8 9m35 9V25m0 8q10 0 8-9-9-1-8 9"/>'},
];
const sunnyOrder = new Map(sunnyGames.map((game,index)=>[game.slug,index]));
const sortedGames = [...GAME_LIBRARY].sort((a,b)=>(sunnyOrder.get(a.slug)??99)-(sunnyOrder.get(b.slug)??99));
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage',name:'PointCast Games',description:'Five sunny new mobile games, plus a whole shelf of PointCast worlds to explore.',url:'https://pointcast.xyz/games/',hasPart:GAME_LIBRARY.map(game=>({'@type':'VideoGame',name:game.name,description:game.description,url:`https://pointcast.xyz${gameLanding(game)}`,gamePlatform:'Web browser'}))};
---
<BlockLayout title="Games" author="PointCast" description="Your five-minute happy place. Play five sunny new mobile games, explore the PointCast game library, and take your favorites home." image="/games/sunny-side/assets/sunny-neighbors.webp" jsonLd={jsonLd} immersive isolated showNetworkStrip={false} alternates={[{type:'application/json',href:'/games.json',title:'PointCast game library'}]}>
  <div class="gp-site gp-directory"><GameHeader />
    <div id="main">
      <section class="gp-sunny-hero" aria-labelledby="sunny-title">
        <div class="gp-sunny-copy"><span class="gp-kicker"><span class="gp-live-dot" aria-hidden="true"></span> POINTCAST GAMES · LITTLE BREAKS, BIG GRINS</span><h1 id="sunny-title">Your five-minute <em>happy place.</em></h1><p>A rooftop squirrel. A dreaming puppy. A whole garden of good distractions. Pick up a little game and see where it takes you.</p><div class="gp-button-row"><a class="gp-button gp-button-dark" href="/games/sunny-side/index.html">Play the sunny five <svg class="gp-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a><a class="gp-text-link" href="#library">Explore all {GAME_LIBRARY.length} games ↓</a></div><div class="gp-sunny-promises"><span>Made for your phone</span><span>Free to jump in</span><span>One more round?</span></div></div>
        <a class="gp-sunny-scene" href="/games/sunny-side/index.html" aria-label="Play the Sunny Side collection"><img src="/games/sunny-side/assets/sunny-neighbors.webp" alt="A sunny California neighborhood with palm trees, rooftop squirrels, and a puppy resting in a flower garden" width="1536" height="1024" fetchpriority="high" /><span class="gp-sunny-badge">FRESH<br /><strong>5</strong><br />LITTLE GAMES</span><div class="gp-scene-caption"><span><span class="gp-kicker">THE SUNNY SIDE COLLECTION</span><strong>Good company.<br />Great little games.</strong></span><span class="gp-scene-arrow" aria-hidden="true"><svg class="gp-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div></a>
      </section>
      <section class="gp-sunny-shelf" aria-labelledby="sunny-shelf-title"><div class="gp-sunny-shelf-head"><div><span class="gp-kicker">MEET YOUR NEW FAVORITES</span><h2 id="sunny-shelf-title">A little sunshine, five ways.</h2></div><p>Quick to learn. Easy to love.</p></div><div class="gp-sunny-tiles">{sunnyGames.map((game,index)=><a class="gp-sunny-tile" href={`/games/sunny-side/index.html?game=${game.slug}`} style={`--tile-color:${game.color}`}><div class="gp-tile-art"><span class="gp-tile-number">0{index+1}</span><svg viewBox="0 0 80 66" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={game.icon}/><span class="gp-tile-play" aria-hidden="true"><svg class="gp-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><span class="gp-kicker">{game.kind}</span><h3>{game.name}</h3><p>{game.description}</p></a>)}</div></section>
      <section id="library" class="gp-library" aria-labelledby="library-title"><div class="gp-section-head"><div><span class="gp-kicker">MORE WORLDS, MORE WAYS TO PLAY</span><h2 id="library-title">Find your next favorite.</h2></div><p id="game-count" role="status" aria-live="polite">{GAME_LIBRARY.length} games to explore</p></div>
        <form class="gp-filters" role="search" onsubmit="return false"><label class="gp-search">Find a game<input id="game-search" type="search" placeholder="A name, a mood, a way to play…" autocomplete="off" /></label><label>Game shelf<select id="game-family"><option value="all">Every shelf</option>{gameFamilies.map(family=><option value={family}>{family}</option>)}</select></label><label>Take home<select id="game-download-filter"><option value="all">All downloads</option><option value="local">Local game packs</option><option value="online">Online launch kits</option></select></label><button id="game-reset" type="button" class="gp-reset">Reset</button></form>
        <div class="gp-game-grid">{sortedGames.map((game,index)=><GameCard game={game} index={index} />)}</div><div id="game-empty" class="gp-empty" hidden><h3>No games on this shelf yet.</h3><p>Try a shorter search or choose another shelf.</p></div>
      </section>
      <section id="take-home" class="gp-take-home"><div><span class="gp-kicker">YOUR GAME, YOUR PACE</span><h2>A little play<br />to keep.</h2></div><div><p>Each game page tells you what’s in its download. Local packs include the game files and a simple launcher. Online kits keep a shortcut to a game that lives on the web.</p><p>Your browser save stays where you made it. A downloaded copy starts with its own save. Live rooms, shared boards, and optional online services are reached from the web game.</p><a class="gp-text-link" href="/app/">Add PointCast to your home screen ↗</a></div></section>
    </div><footer class="gp-footer"><a href="/">PointCast</a><span>Made in El Segundo. Played wherever you are.</span><a href="/games.json">Game library JSON</a></footer>
  </div>
</BlockLayout>
<script>
  function setupGameDirectory() {
    const search=document.querySelector<HTMLInputElement>('#game-search');
    const family=document.querySelector<HTMLSelectElement>('#game-family');
    const download=document.querySelector<HTMLSelectElement>('#game-download-filter');
    const reset=document.querySelector<HTMLButtonElement>('#game-reset');
    if(!search||!family||!download||!reset||search.dataset.bound)return;
    search.dataset.bound='true';
    const cards=[...document.querySelectorAll<HTMLElement>('[data-game-card]')];
    function filter(){let count=0;const words=search!.value.toLowerCase().trim().split(/\s+/).filter(Boolean);for(const card of cards){const visible=words.every(word=>(card.dataset.search??'').includes(word))&&(family!.value==='all'||card.dataset.family===family!.value)&&(download!.value==='all'||card.dataset.download===download!.value);card.hidden=!visible;if(visible)count++;}document.querySelector('#game-count')!.textContent=`${count} ${count===1?'game':'games'} to explore`;document.querySelector<HTMLElement>('#game-empty')!.hidden=count!==0;}
    search.addEventListener('input',filter);family.addEventListener('change',filter);download.addEventListener('change',filter);reset.addEventListener('click',()=>{search.value='';family.value='all';download.value='all';filter();search.focus();});
  }
  setupGameDirectory();document.addEventListener('astro:page-load',setupGameDirectory);
</script>
