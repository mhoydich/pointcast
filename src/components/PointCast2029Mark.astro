---
interface Props {
  paths: string[];
  label: string;
  title?: string;
  class?: string;
  decorative?: boolean;
}

const {
  paths,
  label,
  title = label,
  class: className,
  decorative = false,
} = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 100"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  xmlns="http://www.w3.org/2000/svg"
>
  {!decorative && <title>{title}</title>}
  {paths.map((path) => <path d={path} fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" />)}
</svg>
