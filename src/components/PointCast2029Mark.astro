---
interface Props {
  paths: string[];
  label: string;
  title?: string;
  class?: string;
}

const {
  paths,
  label,
  title = label,
  class: className,
} = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 100"
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  <title>{title}</title>
  {paths.map((path) => <path d={path} fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" />)}
</svg>
