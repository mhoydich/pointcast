---
/**
 * MiniWindow — slim, embeddable version of /window's sky pane.
 *
 * Mike 2026-05-10: "homepage is umm, not interesting kinda". The home was
 * a build-log; the new home is a room. This component is the window in
 * that room — live El Segundo time-of-day + Open-Meteo conditions, but
 * sized small enough to share the hero with the coffee pot.
 *
 * Visually trimmed from /window: no marine layer, no horizon band, no
 * sash shadow. Sky + sun/moon/stars + drifting clouds + a single thin
 * mullion crossbar. Keeps the data-tod / data-cond hooks so the same
 * client-side updaters work.
 */
interface Props {
  size?: number;   // CSS px on the long edge (default 240)
}
const { size = 240 } = Astro.props;

interface Weather {
  ok: boolean;
  tempF?: number;
  condition?: string;
}

let weather: Weather = { ok: false };
try {
  const res = await fetch('https://pointcast.xyz/api/weather?lat=33.92&lng=-118.42&label=el-segundo', {
    signal: AbortSignal.timeout(2500),
  });
  if (res.ok) weather = await res.json();
} catch { /* render stub */ }

const tempF = weather.tempF ?? 62;
const condition = (weather.condition ?? 'overcast').toLowerCase();

function timeOfDayFromHour(h: number) {
  if (h >= 5  && h <  7)  return 'dawn';
  if (h >= 7  && h < 11)  return 'morning';
  if (h >= 11 && h < 14)  return 'midday';
  if (h >= 14 && h < 17)  return 'afternoon';
  if (h >= 17 && h < 19)  return 'sunset';
  if (h >= 19 && h < 21)  return 'dusk';
  return 'night';
}
const ptHourFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/Los_Angeles', hour: 'numeric', hour12: false,
});
const ptHour = parseInt(ptHourFmt.format(new Date()), 10);
const tod = timeOfDayFromHour(ptHour);

function conditionTag(c: string) {
  if (/fog|mist|marine/.test(c)) return 'foggy';
  if (/clear|sun/.test(c))       return 'clear';
  if (/overcast/.test(c))        return 'overcast';
  return 'cloudy';
}
const cond = conditionTag(condition);
---

<a
  class="miniwin"
  href="/window"
  aria-label={`The window — ${tempF}°F · ${condition} · ${tod}`}
  style={`--miniwin-size: ${size}px;`}
>
  <div class="miniwin__frame" data-tod={tod} data-cond={cond} data-miniwin>
    <div class="miniwin__sky">
      <div class="miniwin__sun"  aria-hidden="true"></div>
      <div class="miniwin__moon" aria-hidden="true"></div>
      <div class="miniwin__stars" aria-hidden="true">
        <span class="miniwin__star" style="left:18%; top:22%; animation-delay: 0s;"></span>
        <span class="miniwin__star" style="left:34%; top:36%; animation-delay: 1.2s;"></span>
        <span class="miniwin__star" style="left:54%; top:14%; animation-delay: 0.5s;"></span>
        <span class="miniwin__star" style="left:74%; top:30%; animation-delay: 2.0s;"></span>
        <span class="miniwin__star" style="left:84%; top:50%; animation-delay: 0.8s;"></span>
      </div>
      <div class="miniwin__cloud miniwin__cloud--1" aria-hidden="true"></div>
      <div class="miniwin__cloud miniwin__cloud--2" aria-hidden="true"></div>
    </div>
    <div class="miniwin__mullion miniwin__mullion--v" aria-hidden="true"></div>
    <div class="miniwin__mullion miniwin__mullion--h" aria-hidden="true"></div>
  </div>
  <p class="miniwin__strip mono">
    el segundo · <span data-miniwin-temp>{tempF}</span>°F · <span data-miniwin-cond>{condition}</span> · <span data-miniwin-tod>{tod}</span>
  </p>
</a>

<script is:inline>
  (function () {
    var frames = document.querySelectorAll('[data-miniwin]');
    if (!frames.length) return;
    function ptHour() {
      try {
        return parseInt(new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Los_Angeles', hour: 'numeric', hour12: false,
        }).format(new Date()), 10);
      } catch (e) { return new Date().getHours(); }
    }
    function tod(h) {
      if (h >=  5 && h <  7) return 'dawn';
      if (h >=  7 && h < 11) return 'morning';
      if (h >= 11 && h < 14) return 'midday';
      if (h >= 14 && h < 17) return 'afternoon';
      if (h >= 17 && h < 19) return 'sunset';
      if (h >= 19 && h < 21) return 'dusk';
      return 'night';
    }
    function cond(c) {
      c = (c || '').toLowerCase();
      if (/fog|mist|marine/.test(c)) return 'foggy';
      if (/clear|sun/.test(c))       return 'clear';
      if (/overcast/.test(c))        return 'overcast';
      return 'cloudy';
    }
    function tick() {
      var t = tod(ptHour());
      frames.forEach(function (f) { f.setAttribute('data-tod', t); });
      document.querySelectorAll('[data-miniwin-tod]').forEach(function (el) { el.textContent = t; });
    }
    function weather() {
      fetch('/api/weather?lat=33.92&lng=-118.42&label=el-segundo', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.ok) return;
          if (d.tempF != null) {
            document.querySelectorAll('[data-miniwin-temp]').forEach(function (el) { el.textContent = String(d.tempF); });
          }
          if (d.condition) {
            var lc = String(d.condition).toLowerCase();
            document.querySelectorAll('[data-miniwin-cond]').forEach(function (el) { el.textContent = lc; });
            var c = cond(lc);
            frames.forEach(function (f) { f.setAttribute('data-cond', c); });
          }
        })
        .catch(function () {});
    }
    tick();
    setInterval(tick, 60_000);
    setInterval(weather, 300_000);
  })();
</script>

<style>
  .miniwin {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .miniwin__frame {
    width: var(--miniwin-size, 240px);
    aspect-ratio: 3 / 4;
    border: 10px solid #f3ece0;
    border-radius: 3px;
    box-shadow:
      inset 0 0 0 2px #d8cdb8,
      0 6px 20px rgba(0, 0, 0, 0.12),
      0 1px 0 rgba(255, 255, 255, 0.7);
    position: relative;
    overflow: hidden;
    background: #b8e0f0;
    transition: transform 0.2s ease;
  }
  .miniwin:hover .miniwin__frame {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 2px #d8cdb8,
      0 10px 24px rgba(0, 0, 0, 0.16),
      0 1px 0 rgba(255, 255, 255, 0.7);
  }
  .miniwin__sky { position: absolute; inset: 0; transition: background 4s ease-in-out; }

  .miniwin__frame[data-tod="dawn"]      .miniwin__sky { background: linear-gradient(180deg, #f7c0a0 0%, #ffd5b4 35%, #c8b495 75%, #a89880 100%); }
  .miniwin__frame[data-tod="morning"]   .miniwin__sky { background: linear-gradient(180deg, #b8d8e6 0%, #d4e4ec 50%, #e0d8c4 100%); }
  .miniwin__frame[data-tod="midday"]    .miniwin__sky { background: linear-gradient(180deg, #6cb4d8 0%, #a8d4e8 50%, #c8e0ec 100%); }
  .miniwin__frame[data-tod="afternoon"] .miniwin__sky { background: linear-gradient(180deg, #88b8d4 0%, #c4d4e0 60%, #e6d8c0 100%); }
  .miniwin__frame[data-tod="sunset"]    .miniwin__sky { background: linear-gradient(180deg, #d68a4e 0%, #e87a5a 30%, #c46478 60%, #6c4a78 100%); }
  .miniwin__frame[data-tod="dusk"]      .miniwin__sky { background: linear-gradient(180deg, #3c3680 0%, #5a4488 35%, #7c4878 70%, #a06082 100%); }
  .miniwin__frame[data-tod="night"]     .miniwin__sky { background: linear-gradient(180deg, #0a1428 0%, #1a2440 60%, #2a3058 100%); }

  .miniwin__sun {
    position: absolute;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: #ffe07a;
    box-shadow: 0 0 22px rgba(255, 224, 122, 0.6);
    opacity: 0;
    transition: opacity 4s, top 4s ease-in-out, left 4s ease-in-out, background 4s, box-shadow 4s;
  }
  .miniwin__frame[data-tod="dawn"]      .miniwin__sun { opacity: 1;   left: 18%; top: 62%; background: #ffb088; box-shadow: 0 0 16px rgba(255, 130, 90, 0.5); }
  .miniwin__frame[data-tod="morning"]   .miniwin__sun { opacity: 0.85;left: 30%; top: 32%; background: #fff0c8; }
  .miniwin__frame[data-tod="midday"]    .miniwin__sun { opacity: 1;   left: 60%; top: 14%; background: #fff5b0; box-shadow: 0 0 28px rgba(255, 245, 176, 0.6); }
  .miniwin__frame[data-tod="afternoon"] .miniwin__sun { opacity: 1;   left: 72%; top: 28%; background: #ffe07a; }
  .miniwin__frame[data-tod="sunset"]    .miniwin__sun { opacity: 1;   left: 80%; top: 60%; background: #ff7a4e; box-shadow: 0 0 30px rgba(255, 122, 78, 0.7); }
  .miniwin__frame[data-tod="dusk"]      .miniwin__sun { opacity: 0.3; left: 88%; top: 78%; background: #c46478; }
  .miniwin__frame[data-tod="night"]     .miniwin__sun { opacity: 0; }

  .miniwin__moon {
    position: absolute;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: #f0ebd8;
    box-shadow:
      inset -6px -1px 0 0 rgba(0, 0, 0, 0.15),
      0 0 12px rgba(240, 235, 216, 0.4);
    opacity: 0;
    transition: opacity 4s, top 4s ease-in-out, left 4s ease-in-out;
  }
  .miniwin__frame[data-tod="dusk"]  .miniwin__moon { opacity: 0.7; left: 28%; top: 28%; }
  .miniwin__frame[data-tod="night"] .miniwin__moon { opacity: 1;   left: 36%; top: 18%; }
  .miniwin__frame[data-tod="dawn"]  .miniwin__moon { opacity: 0.4; left: 70%; top: 30%; }

  .miniwin__stars { position: absolute; inset: 0; opacity: 0; transition: opacity 4s; }
  .miniwin__frame[data-tod="dusk"]  .miniwin__stars { opacity: 0.5; }
  .miniwin__frame[data-tod="night"] .miniwin__stars { opacity: 1; }
  .miniwin__frame[data-tod="dawn"]  .miniwin__stars { opacity: 0.3; }
  .miniwin__star {
    position: absolute;
    width: 2px; height: 2px;
    background: #fffaf0;
    border-radius: 50%;
    box-shadow: 0 0 3px rgba(255, 250, 240, 0.7);
    animation: miniwin-twinkle 3.4s ease-in-out infinite;
  }
  @keyframes miniwin-twinkle {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.4); }
  }

  .miniwin__cloud {
    position: absolute;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    filter: blur(0.5px);
    will-change: transform;
  }
  .miniwin__cloud--1 { width: 60px; height: 16px; top: 22%; left: -70px; animation: miniwin-drift 60s linear infinite; }
  .miniwin__cloud--2 { width: 48px; height: 14px; top: 40%; left: -60px; animation: miniwin-drift 48s linear infinite; animation-delay: -22s; }
  @keyframes miniwin-drift {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(var(--miniwin-size, 240px) + 80px)); }
  }
  .miniwin__frame[data-cond="clear"]    .miniwin__cloud { opacity: 0.15; }
  .miniwin__frame[data-cond="cloudy"]   .miniwin__cloud { opacity: 0.65; }
  .miniwin__frame[data-cond="overcast"] .miniwin__cloud { opacity: 0.85; background: rgba(220, 220, 220, 0.92); }
  .miniwin__frame[data-cond="foggy"]    .miniwin__cloud { opacity: 0.5;  filter: blur(2px); }
  .miniwin__frame[data-tod="night"] .miniwin__cloud { background: rgba(140, 140, 160, 0.7); }
  .miniwin__frame[data-tod="dusk"]  .miniwin__cloud { background: rgba(180, 160, 180, 0.7); }

  .miniwin__mullion {
    position: absolute;
    background: #f3ece0;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1);
  }
  .miniwin__mullion--v { left: 50%; top: 0; bottom: 0; width: 4px; transform: translateX(-50%); }
  .miniwin__mullion--h { top: 50%; left: 0; right: 0; height: 4px; transform: translateY(-50%); }

  .miniwin__strip {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .miniwin__cloud, .miniwin__star, .miniwin__sky, .miniwin__sun, .miniwin__moon {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
