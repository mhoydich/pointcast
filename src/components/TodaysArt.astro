---
import { Image } from 'astro:assets';
import signalGarden from '../assets/todays-art/2026-07-20-signal-garden.png';
import flowerOne from '../assets/todays-art/2026-07-20-flower-field-01.png';
import flowerTwo from '../assets/todays-art/2026-07-20-flower-field-02.png';
import flowerThree from '../assets/todays-art/2026-07-20-flower-field-03.png';

const works = [
  {
    src: signalGarden,
    title: 'Signal Garden / Palos Verdes',
    note: 'A civic landscape tuned like a receiver: ocean light, dishes, courts, and a hillside becoming infrastructure.',
    className: 'todays-art__anchor',
  },
  {
    src: flowerOne,
    title: 'Flowers for the Wire I',
    note: 'Silver ground, persimmon center, and a pink canopy holding the field open.',
    className: '',
  },
  {
    src: flowerTwo,
    title: 'Flowers for the Wire II',
    note: 'Deep green weather with orange, violet, and turquoise blooms moving forward.',
    className: '',
  },
  {
    src: flowerThree,
    title: 'Flowers for the Wire III',
    note: 'The clearest pop register: cyan, red-orange, yellow, and hot pink in one bright transmission.',
    className: '',
  },
];
---

<section class="todays-art" aria-labelledby="todays-art-title">
  <header class="todays-art__head">
    <div>
      <p class="mono">TODAY'S ART · <time datetime="2026-07-20">20 JUL 2026</time> · MIKE + MIDJOURNEY</p>
      <h2 id="todays-art-title">Signal garden,<br /><em>then flowers.</em></h2>
    </div>
    <p class="todays-art__note">
      Four pieces selected from today’s work: one wide civic signal to establish the horizon, then three flower fields to turn the color all the way up.
    </p>
  </header>

  <div class="todays-art__grid">
    {works.map((work, index) => (
      <figure class={work.className}>
        <div class="todays-art__image">
          <Image
            src={work.src}
            alt={work.title}
            widths={index === 0 ? [640, 960, 1440] : [320, 560, 840]}
            sizes={index === 0 ? '(max-width: 760px) 100vw, 66vw' : '(max-width: 760px) 100vw, 33vw'}
            format="webp"
            loading="lazy"
          />
          <span class="mono">{String(index + 1).padStart(2, '0')} / 04</span>
        </div>
        <figcaption>
          <strong>{work.title}</strong>
          <p>{work.note}</p>
        </figcaption>
      </figure>
    ))}
  </div>

  <footer class="todays-art__foot mono">
    <span>CURATED BY MICHAEL HOYDICH · SOURCE IMAGES PRESERVED</span>
    <span class="todays-art__links"><a href="/gallery/today">ENTER TODAY'S 28-WORK EDIT →</a><a href="/el-segundo-school">652-WORK ARCHIVE ↗</a></span>
  </footer>
</section>

<style>
  .todays-art { margin: 18px 0 24px; padding: clamp(18px, 3vw, 34px); color: #17140f; background: #d8ded5; border: 1px solid #17140f; }
  .todays-art .mono { font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace); }
  .todays-art__head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr); align-items: end; gap: clamp(24px, 5vw, 80px); margin-bottom: 24px; }
  .todays-art__head > div > p { margin: 0 0 9px; color: #8a3726; font-size: 9px; letter-spacing: 0.15em; }
  .todays-art h2 { margin: 0; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: clamp(46px, 7.5vw, 106px); font-weight: 400; line-height: 0.79; letter-spacing: -0.065em; }
  .todays-art h2 em { color: #bf3e24; font-weight: 400; }
  .todays-art__note { max-width: 46ch; margin: 0; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: clamp(16px, 1.8vw, 22px); line-height: 1.42; }
  .todays-art__grid { display: grid; grid-template-columns: 1.5fr repeat(2, minmax(0, 0.75fr)); gap: 10px; }
  .todays-art figure { min-width: 0; margin: 0; background: #f5f0e4; border: 1px solid #17140f; }
  .todays-art__anchor { grid-row: span 2; }
  .todays-art__image { position: relative; overflow: hidden; background: #17140f; }
  .todays-art__image :global(img) { width: 100%; height: 250px; object-fit: cover; transition: transform 500ms ease; }
  .todays-art__anchor .todays-art__image :global(img) { height: 610px; }
  .todays-art figure:hover .todays-art__image :global(img) { transform: scale(1.012); }
  .todays-art__image > span { position: absolute; right: 8px; bottom: 8px; padding: 5px 7px; color: #f5f0e4; background: rgba(23, 20, 15, 0.84); font-size: 8px; letter-spacing: 0.12em; }
  .todays-art figcaption { padding: 12px; }
  .todays-art figcaption strong { display: block; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: 20px; font-weight: 500; }
  .todays-art figcaption p { margin: 5px 0 0; color: #4d473f; font-size: 11px; line-height: 1.45; }
  .todays-art__foot { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; padding-top: 10px; border-top: 1px solid #17140f; font-size: 8px; letter-spacing: 0.12em; }
  .todays-art__foot a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .todays-art__links { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  @media (prefers-reduced-motion: reduce) { .todays-art__image :global(img) { transition: none; } }
  @media (max-width: 900px) {
    .todays-art__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .todays-art__anchor { grid-column: 1 / -1; grid-row: auto; }
    .todays-art__anchor .todays-art__image :global(img) { height: min(70vw, 560px); }
  }
  @media (max-width: 620px) {
    .todays-art__head, .todays-art__grid { grid-template-columns: 1fr; }
    .todays-art__anchor { grid-column: auto; }
    .todays-art__image :global(img), .todays-art__anchor .todays-art__image :global(img) { height: auto; aspect-ratio: 1 / 1; }
    .todays-art__anchor .todays-art__image :global(img) { aspect-ratio: 4 / 3; }
    .todays-art__foot { align-items: flex-start; flex-direction: column; }
  }
</style>
