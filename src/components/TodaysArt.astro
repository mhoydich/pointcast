---
import { Image } from 'astro:assets';
import busShelter from '../assets/todays-art/2026-07-21/midjourney/bus-shelter-garden.webp';
import abundance from '../assets/todays-art/2026-07-21/ideogram/abundance-flows-01.webp';
import soTired from '../assets/todays-art/imageapp/so-tired.png';
import revePositive from '../assets/todays-art/2026-07-21/reve/the-positive-index.webp';

const supportingWorks = [
  [busShelter, 'Bus Shelter Conservatory', 'MIDJOURNEY'],
  [abundance, 'Abundance Flows I', 'IDEOGRAM'],
  [soTired, 'So Tired', 'IMAGEAPP EXPORT'],
] as const;
---

<section class="todays-art" aria-labelledby="todays-art-title">
  <header class="todays-art__head">
    <div>
      <p class="mono">TODAY'S ART · <time datetime="2026-07-21">21 JUL 2026</time> · EDIT 002</p>
      <h2 id="todays-art-title">The Positive<br /><em>Index.</em></h2>
    </div>
    <p class="todays-art__note">Fourteen works ask what changes when repair stands, public tables, small gardens, tired objects, and the Pacific are treated as evidence of a generous future.</p>
  </header>

  <div class="todays-art__grid">
    <figure class="todays-art__anchor">
      <a href="/gallery/today"><Image src={revePositive} alt="The Positive Index Reve poster with a flowering bicycle shrine" widths={[480, 720, 1000]} sizes="(max-width: 900px) 100vw, 30vw" format="webp" loading="lazy" /></a>
      <figcaption><strong>The Positive Index</strong><span class="mono">REVE HOUSE-AD PROOF · PC-HOUSE-007</span></figcaption>
    </figure>
    {supportingWorks.map(([src, title, tool]) => (
      <figure>
        <a href="/gallery/today"><Image src={src} alt={title} widths={[360, 640, 900]} sizes="(max-width: 760px) 100vw, 28vw" format="webp" loading="lazy" /></a>
        <figcaption><strong>{title}</strong><span class="mono">{tool}</span></figcaption>
      </figure>
    ))}
  </div>

  <footer class="todays-art__foot mono">
    <span>14 WORKS · MIDJOURNEY + IDEOGRAM + PRESERVED IMAGEAPP · NOT MINTED</span>
    <span><a href="/gallery/today">ENTER THE EDITION →</a><a href="/gallery/today.json">PUBLIC MANIFEST ↗</a></span>
  </footer>
</section>

<style>
  .todays-art { margin: 22px 0; padding: clamp(18px, 3vw, 36px); color: #171814; background: #eee6d4; border: 1px solid #171814; }
  .mono { font-family: var(--pc-font-mono, ui-monospace, monospace); }
  .todays-art__head { display: grid; grid-template-columns: 1.1fr .62fr; align-items: end; gap: 32px 70px; margin-bottom: 28px; }
  .todays-art__head > div > p { margin: 0 0 10px; color: #c6532b; font-size: 8px; letter-spacing: .15em; }
  h2 { margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(48px, 7.8vw, 108px); font-weight: 400; line-height: .78; letter-spacing: -.065em; }
  h2 em { color: #c6532b; font-weight: 400; }
  .todays-art__note { max-width: 48ch; margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(16px, 1.7vw, 22px); line-height: 1.42; }
  .todays-art__grid { display: grid; grid-template-columns: 1.25fr repeat(3, 1fr); gap: 10px; }
  figure { min-width: 0; margin: 0; background: #fffaf0; border: 1px solid #171814; }
  figure a { display: block; overflow: hidden; background: #132b39; }
  figure :global(img) { display: block; width: 100%; height: 360px; object-fit: cover; transition: transform 300ms ease; }
  .todays-art__anchor :global(img) { height: 480px; object-position: center top; }
  figure:hover :global(img) { transform: scale(1.012); }
  figcaption { display: flex; flex-direction: column; gap: 5px; padding: 12px; }
  figcaption strong { font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: 18px; font-weight: 500; }
  figcaption span { color: #665f52; font-size: 7px; letter-spacing: .12em; }
  .todays-art__foot { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; padding-top: 10px; border-top: 1px solid #171814; font-size: 7px; letter-spacing: .11em; }
  .todays-art__foot > span:last-child { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .todays-art__foot a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  @media (prefers-reduced-motion: reduce) { figure :global(img) { transition: none; } }
  @media (max-width: 900px) {
    .todays-art__head { grid-template-columns: 1fr; }
    .todays-art__grid { grid-template-columns: repeat(2, 1fr); }
    .todays-art__anchor { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .todays-art__grid { grid-template-columns: 1fr; }
    .todays-art__anchor { grid-column: auto; }
    figure :global(img), .todays-art__anchor :global(img) { height: auto; aspect-ratio: 4 / 5; }
    .todays-art__foot { align-items: flex-start; flex-direction: column; }
  }
</style>
