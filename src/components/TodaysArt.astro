---
import PosterDeck from './gallery/PosterDeck.astro';
---

<section class="todays-art-landing" id="todays-art" aria-labelledby="todays-art-title">
  <div class="todays-art-landing__signal mono" aria-hidden="true">
    <span>LIVE HANGING · EDIT 003</span><span>15 POSTERS</span><span>EL SEGUNDO · 22 JUL 2026</span>
  </div>

  <div class="todays-art-landing__grid">
    <div class="todays-art-landing__copy">
      <p class="todays-art-landing__kicker mono">TODAY'S ART · THE POSTER RACK</p>
      <h2 id="todays-art-title">The city is<br /><i>a poster.</i></h2>
      <p class="todays-art-landing__dek">Fifteen speculative broadsides turn El Segundo into a civic operating system: days of the week, water, sports, machines, weather, and myth all demanding a wall.</p>
      <div class="todays-art-landing__actions mono">
        <a class="todays-art-landing__enter" href="/gallery/today">ENTER THE EDITION <span aria-hidden="true">↗</span></a>
        <a href="/gallery/today.json">PUBLIC MANIFEST</a>
      </div>
      <p class="todays-art-landing__hint mono">DRAG · SWIPE · USE ARROW KEYS</p>
    </div>

    <PosterDeck compact />
  </div>

  <footer class="todays-art-landing__foot mono">
    <span>USER-PROVIDED LOCAL BATCH · GENERATION TOOL NOT ASSERTED</span>
    <span>CURATED + PUBLISHED ≠ MINTED</span>
  </footer>
</section>

<style>
  .todays-art-landing { position: relative; isolation: isolate; min-height: min(810px, calc(100svh - 88px)); margin: 12px 0 22px; overflow: hidden; color: #f3f0df; border: 1px solid #11120f; background: #11120f; box-shadow: 0 30px 80px rgba(38, 36, 20, .18); }
  .todays-art-landing::before { position: absolute; z-index: -2; inset: 0; content: ''; background: radial-gradient(circle at 80% 40%, rgba(56, 189, 248, .16), transparent 34%), radial-gradient(circle at 92% 74%, rgba(244, 114, 182, .12), transparent 28%), linear-gradient(115deg, rgba(214, 255, 69, .08), transparent 38%), repeating-linear-gradient(90deg, transparent 0 79px, rgba(255,255,255,.025) 80px), repeating-linear-gradient(0deg, transparent 0 79px, rgba(255,255,255,.025) 80px); }
  .todays-art-landing::after { position: absolute; z-index: -1; right: -7%; bottom: -28%; width: 46%; aspect-ratio: 1; content: ''; border: 1px solid rgba(214, 255, 69, .28); border-radius: 50%; box-shadow: 0 0 0 40px rgba(214,255,69,.025), 0 0 0 80px rgba(214,255,69,.02); }
  .mono { font-family: var(--pc-font-mono, ui-monospace, monospace); }
  .todays-art-landing__signal { display: flex; justify-content: space-between; gap: 18px; padding: 9px 12px; color: #11120f; background: #d6ff45; font-size: 7px; letter-spacing: .14em; }
  .todays-art-landing__grid { display: grid; grid-template-columns: minmax(270px, .77fr) minmax(500px, 1.23fr); align-items: center; gap: clamp(10px, 3vw, 48px); min-height: min(700px, calc(100svh - 150px)); padding: clamp(28px, 5vw, 70px) clamp(18px, 4vw, 58px) 28px; }
  .todays-art-landing__copy { position: relative; z-index: 25; }
  .todays-art-landing__kicker { margin: 0 0 18px; color: #d6ff45; font-size: 8px; letter-spacing: .17em; }
  h2 { max-width: 730px; margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(62px, 8.5vw, 128px); font-weight: 400; line-height: .72; letter-spacing: -.07em; }
  h2 i { color: #f472b6; font-weight: 400; }
  .todays-art-landing__dek { max-width: 47ch; margin: 34px 0 28px; color: #cecec5; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(17px, 1.6vw, 23px); line-height: 1.35; }
  .todays-art-landing__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .todays-art-landing__actions a { min-height: 38px; display: inline-flex; align-items: center; color: #f3f0df; font-size: 8px; letter-spacing: .13em; text-decoration: none; border-bottom: 1px solid currentColor; }
  .todays-art-landing__actions .todays-art-landing__enter { gap: 18px; padding: 0 12px; color: #11120f; border: 1px solid #d6ff45; background: #d6ff45; }
  .todays-art-landing__enter:hover { border-color: #f472b6; background: #f472b6; }
  .todays-art-landing__hint { margin: 18px 0 0; color: #77796e; font-size: 7px; letter-spacing: .13em; }
  .todays-art-landing__foot { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; color: #8d8e85; border-top: 1px solid rgba(243,240,223,.18); font-size: 7px; letter-spacing: .12em; }
  @media (max-width: 930px) {
    .todays-art-landing { min-height: 0; }
    .todays-art-landing__grid { grid-template-columns: 1fr; min-height: 0; }
    .todays-art-landing__copy { display: grid; grid-template-columns: 1fr .62fr; gap: 0 24px; }
    .todays-art-landing__copy h2 { grid-row: span 3; }
    .todays-art-landing__kicker { grid-column: 1 / -1; }
    .todays-art-landing__dek { margin: 0 0 18px; }
    .todays-art-landing__hint { display: none; }
  }
  @media (max-width: 650px) {
    .todays-art-landing { margin-inline: -12px; }
    .todays-art-landing__signal span:nth-child(2) { display: none; }
    .todays-art-landing__grid { gap: 12px; padding: 30px 14px 18px; }
    .todays-art-landing__copy { display: block; }
    h2 { font-size: clamp(58px, 21vw, 92px); }
    .todays-art-landing__dek { margin: 24px 0 20px; font-size: 17px; }
    .todays-art-landing__foot { align-items: flex-start; flex-direction: column; }
  }
</style>
