---
/**
 * AltarsPulseModule — homepage strip for the chamber's tribute altars.
 *
 * Sibling to WingPulseModule. Renders:
 *   ALTARS · WEEK 202619 · 18 TRIBUTES · 5/5 ALTARS LIT · enter →
 *   plus 5 small candle dots, lit by tribute count.
 *
 * Polls /api/altar every 6s.
 */
---

<section class="apm" id="apm-root" aria-label="Altars chamber — weekly tributes">
  <a class="apm__pill" href="/drum-altars">
    <span class="apm__brass">●</span>
    <span class="apm__label">ALTARS</span>
    <span class="apm__sep">·</span>
    <span class="apm__week" id="apm-week">WEEK ---</span>
    <span class="apm__sep">·</span>
    <span class="apm__total" id="apm-total">— tributes</span>
    <span class="apm__cta">ring →</span>
  </a>
  <div class="apm__candles" id="apm-candles" aria-hidden="true">
    <span class="apm__candle" data-idx="0"><span class="apm__flame"></span><span class="apm__wax"></span></span>
    <span class="apm__candle" data-idx="1"><span class="apm__flame"></span><span class="apm__wax"></span></span>
    <span class="apm__candle" data-idx="2"><span class="apm__flame"></span><span class="apm__wax"></span></span>
    <span class="apm__candle" data-idx="3"><span class="apm__flame"></span><span class="apm__wax"></span></span>
    <span class="apm__candle" data-idx="4"><span class="apm__flame"></span><span class="apm__wax"></span></span>
  </div>
</section>

<style>
  .apm {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    margin: 6px 0;
    flex-wrap: wrap;

    --apm-velvet: #1a0820;
    --apm-brass: #d4a437;
    --apm-brass-deep: #6b4d12;
    --apm-flame: #f6c15e;
    --apm-flame-tip: #ff6b3a;
    --apm-cream: #f4e7c8;
  }

  .apm__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border: 1.5px solid var(--apm-brass-deep);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, Menlo, monospace);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--apm-cream);
    background: linear-gradient(180deg, rgba(26, 8, 32, 0.95) 0%, rgba(12, 4, 16, 0.95) 100%);
    transition: transform 120ms, border-color 200ms, box-shadow 200ms;
    box-shadow: 0 4px 16px rgba(212, 164, 55, 0.16);
  }
  .apm__pill:hover {
    transform: translateY(-1px);
    border-color: var(--apm-brass);
    box-shadow: 0 6px 22px rgba(246, 193, 94, 0.30);
    text-decoration: none;
  }
  .apm__brass { color: var(--apm-flame); font-size: 9px; }
  .apm__label { color: var(--apm-brass); font-weight: 800; letter-spacing: 0.30em; }
  .apm__sep { color: var(--apm-brass-deep); }
  .apm__week, .apm__total { color: var(--apm-cream); font-weight: 600; opacity: 0.85; }
  .apm__cta { color: var(--apm-flame); font-weight: 700; margin-left: 4px; }

  .apm__candles { display: inline-flex; align-items: flex-end; gap: 8px; }
  .apm__candle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    width: 8px;
    opacity: 0.30;
    transition: opacity 600ms;
  }
  .apm__candle.apm__candle--lit { opacity: 1; }
  .apm__flame {
    width: 6px; height: 9px;
    background: radial-gradient(ellipse 2px 4px at 50% 70%, var(--apm-flame-tip) 0%, var(--apm-flame) 50%, transparent 75%);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(0.3px);
    animation: apm-flicker 1.6s ease-in-out infinite;
  }
  .apm__candle:not(.apm__candle--lit) .apm__flame { display: none; }
  @keyframes apm-flicker {
    0%, 100% { transform: scale(1, 1); opacity: 0.85; }
    50%      { transform: scale(1.08, 0.92); opacity: 1; }
  }
  .apm__wax {
    width: 7px; height: 14px;
    background: linear-gradient(180deg, var(--apm-cream) 0%, oklch(0.70 0.06 80) 100%);
    box-shadow: inset -1px 0 0 rgba(0, 0, 0, 0.25);
    margin-top: 1px;
  }

  @media (max-width: 720px) {
    .apm__pill { font-size: 11px; padding: 7px 14px; gap: 8px; }
    .apm__week { display: none; }
  }
</style>

<script>
  const weekEl = document.getElementById('apm-week');
  const totalEl = document.getElementById('apm-total');
  const candleEls = Array.from(document.querySelectorAll('#apm-candles .apm__candle'));

  async function refresh() {
    try {
      const r = await fetch('/api/altar', { cache: 'no-store' });
      const j = await r.json();
      if (!j?.ok) return;
      if (weekEl) weekEl.textContent = `WEEK ${j.week}`;
      const total = j.totalThisWeek || 0;
      if (totalEl) totalEl.textContent = `${total} ${total === 1 ? 'tribute' : 'tributes'}`;
      const seeds = j.seeds || [];
      const counts = j.counts || {};
      candleEls.forEach((el, i) => {
        const c = counts[String(seeds[i])] || 0;
        el.classList.toggle('apm__candle--lit', c > 0);
      });
    } catch {}
  }
  if (weekEl || totalEl) {
    refresh();
    setInterval(refresh, 6000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  }
</script>
