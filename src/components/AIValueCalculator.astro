---
import data from '../data/ai-value.json';
const numeric = data.calculator.inputs.filter(input => input.type === 'number' && input.mode !== 'ceiling');
const basic = ['tasks_started','accepted_tasks','subscription_base'];
const tokens = ['attempts_per_task','input_tokens','cache_read_tokens','cache_write_tokens','output_tokens','api_extra_cost'];
const costs = numeric.filter(input => !basic.includes(input.id) && !tokens.includes(input.id));
const label = id => id.replaceAll('_',' ');
---
<section id="calculator" class="ai-value-calculator" data-ai-value>
  <h2>Count your own workload.</h2><p class="notice">Illustrative workload · Rates checked October 5, 2026 · Quota coverage unknown until supplied</p><p>Numbers stay in memory in this browser. This calculator makes no account connection, model request or purchase. Nothing is saved automatically.</p>
  <fieldset class="value-brief"><legend>Keep the comparison fair</legend><label>Task definition<input type="text" name="task_definition" placeholder="For example: a source-checked public-information brief" /></label><label>Acceptance standard<input type="text" name="acceptance_standard" placeholder="Same sources, deadline and review checklist" /></label><label>Required features and quality are comparable<select name="comparability"><option value="unknown">Not established</option><option value="yes">Reader confirmed for this task</option><option value="no">Different scope or missing features</option></select></label></fieldset>
  <label class="value-switch"><input type="checkbox" data-compare /> Compare a second independent scenario</label>
  <div class="value-scenarios">{['a','b'].map((id,index) => <form data-value-scenario={id} class="card value-scenario" hidden={index === 1}>
    <h3>Scenario {id.toUpperCase()}</h3><label>Scenario label<input name="candidate_label" value={`Scenario ${id.toUpperCase()}`} /></label>
    <label>Token-rate preset<select name="rate_preset">{data.verified_rate_presets.map((preset,i) => <option value={preset.id} selected={i === index}>{preset.model} / {preset.processing}</option>)}<option value="custom">Custom / unverified</option></select></label><p class="note" data-rate-note></p>
    <div class="value-fields">{numeric.filter(input => basic.includes(input.id)).map(input => <label>{label(input.id)} <small>{input.unit} / {input.status || 'user-entered'}</small><input type="number" name={input.id} min={input.min} max={input.max} step="any" value={input.default ?? ''} />{input.help && <span>{input.help}</span>}</label>)}</div>
    <label>Subscription workload coverage<select name="quota_coverage"><option value="unknown">Unknown — do not compare allowance value</option><option value="assume_all_included">Hypothetical: assume all included</option><option value="observed_all_included">Observed: all included for this workload</option><option value="partly_included_with_overage_entered">Partial: all overage costs entered</option></select></label>
    <label class="value-switch"><input type="checkbox" name="overage_complete" /> For partial coverage, all missing-workload and overage charges are included</label><label class="value-switch"><input type="checkbox" name="matched_scope" /> API and subscription estimates cover equivalent scope for this scenario</label><label class="value-switch"><input type="checkbox" name="fixed_scope" /> Fixed capability, sufficient subscription capacity and no variable overage established</label>
    <details><summary>Token workload and editable rates</summary><p class="note">Each billed event belongs in one token bucket. Include retries and billable reasoning. A cache read is different from newly generated output.</p><div class="value-fields">{numeric.filter(input => tokens.includes(input.id)).map(input => <label>{label(input.id)} <small>{input.unit} / hypothetical</small><input type="number" name={input.id} min={input.min} max={input.max} step="any" value={input.default} />{input.help && <span>{input.help}</span>}</label>)}{['input','cache_read','cache_write','output'].map(key => <label>{label(key)} rate <small>USD per million billed tokens</small><input type="number" name={`${key}_rate`} min="0" step="any" /></label>)}</div><p>Edit any rate to switch to Custom / unverified. Dated presets do not establish subscription eligibility or quota.</p></details>
    <details><summary>Human time, extra charges, independent API outcomes and budget</summary><label class="value-switch"><input type="checkbox" name="include_human_time" /> Include the entered value of human time</label><label class="value-switch"><input type="checkbox" name="api_outcome_enabled" /> Compare independent API-path results: enter its own taxes, human cost, setup and accepted tasks</label><div class="value-fields">{costs.map(input => <label>{label(input.id)} <small>{input.unit} / {input.status || input.mode || 'user-entered threshold'}</small><input type="number" name={input.id} min={input.min} max={input.max} step="any" value={input.default ?? ''} />{input.help && <span>{input.help}</span>}</label>)}</div></details>
    <div data-value-error role="alert" class="note" hidden></div>
    <section class="value-results" aria-live="polite" aria-atomic="true"><h4>Scenario estimate</h4><p data-coverage-note></p><dl>{[['apiEquivalent','API-equivalent workload estimate'],['subscriptionCash','Subscription cash total'],['humanCost','Entered human-time cost'],['fullCost','Fully loaded subscription path'],['costPerAccepted','Subscription cost per accepted result'],['apiCostPerAccepted','Independent API cost per accepted result'],['equivalenceMultiple','Modeled API-equivalence multiple'],['modeledPriceDifference','Modeled price difference'],['breakEvenAttempts','Modeled break-even attempts']].map(([key,title]) => <div><dt>{title}</dt><dd data-value-output={key}>Not enough data</dd></div>)}</dl><p data-budget-note></p><p class="note">Zero extras or taxes means excluded, not verified free. API paths can have different accepted results, human time and setup costs; this does not silently reuse subscription results to rate an API path.</p><details><summary>Token price breakdown and assumptions</summary><ul>{['input','cache_read','cache_write','output'].map(key => <li>{label(key)}: <span data-value-bucket={key}></span></li>)}</ul><p>API estimate = tasks × attempts per task × token-category cost per attempt + entered API extras. Fully loaded subscription path = subscription cash + entered human-time value + monthly setup cost. Rates use full precision; displayed dollars are rounded.</p></details></section>
    <button type="reset">Reset this hypothetical scenario</button>
  </form>)}</div>
  <p class="note" data-comparison-note>No universal winner: define the task, establish coverage and compare accepted results. Both scenarios keep independent inputs and model-specific token counts.</p>
  <button type="button" data-value-export>Download these assumptions</button>
  <details class="prose value-ceiling"><summary>Advanced: explore a sourced theoretical ceiling</summary><p>A sensitivity exercise only. No chart figures are seeded. It does not establish achievable scheduling, credits or a cash balance.</p><form data-value-ceiling><div class="value-fields"><label>Reported API-equivalent ceiling / USD<input name="ceiling" type="number" min="0" step="any" /></label><label>Assumed utilization / fraction 0–1<input name="utilization" type="number" min="0" max="1" step="any" /></label><label>Source URL<input name="source" type="url" placeholder="https://…" /></label><label>Source date<input name="date" type="date" /></label></div><label class="value-switch"><input name="unchanged_mix" type="checkbox" /> This scales the same unchanged workload mix</label><button type="submit" disabled>Calculate sensitivity</button><p data-ceiling-result aria-live="polite">Enter a source and explicit assumptions.</p></form></details>
  <noscript><p>The article, dated sources and worked examples remain readable. The calculator requires JavaScript.</p></noscript>
</section>
<style>
  .value-scenarios{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px;margin:24px 0}.value-scenario{min-width:0}.value-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:16px}.ai-value-calculator label{display:grid;gap:7px;margin:16px 0;font-size:15px}.ai-value-calculator label small,.ai-value-calculator label span{font-size:12px;line-height:1.5}.ai-value-calculator input:not([type=checkbox]),.ai-value-calculator select{width:100%;min-width:0;box-sizing:border-box;padding:12px;border:1px solid currentColor;background:#fff;color:#151515;font:inherit}.ai-value-calculator .value-switch{display:flex;align-items:flex-start;gap:10px}.value-switch input{width:20px;height:20px;flex:0 0 auto}.ai-value-calculator button,.ai-value-calculator summary{min-height:44px;cursor:pointer;font:inherit}.ai-value-calculator button{padding:12px 16px;background:#151515;color:#fff;border:0}.ai-value-calculator :is(input,select,button,summary):focus-visible{outline:3px solid #b00040;outline-offset:3px}.value-brief{padding:20px;min-width:0;border:1px solid currentColor}.value-results dl{margin:0}.value-results dl>div{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px 0;border-bottom:1px solid #bbb}.value-results dd{margin:0;font-weight:700;overflow-wrap:anywhere}.value-scenario details{padding:16px 0;border-bottom:1px solid #bbb}.value-ceiling{margin:32px 0}.value-scenario[hidden]{display:none}@media(max-width:480px){.value-results dl>div{grid-template-columns:1fr;gap:5px}}
</style>
<script>
import { setupAIValue } from '../lib/ai-value-client.js';
setupAIValue(); document.addEventListener('astro:page-load', () => setupAIValue());
</script>
