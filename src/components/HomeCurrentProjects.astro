---
import projects from '../data/home-current-projects.json';
---

<section class="new-world" aria-labelledby="new-world-title" id="new-projects">
  <header class="new-world__head">
    <div>
      <p class="new-world__kicker">From the workshop · September 2026</p>
      <h2 id="new-world-title">A few new reasons <em>to come over.</em></h2>
    </div>
    <p>Some things are ready to play. Some are still taking shape. There’s room to be curious about both.</p>
  </header>
  <div class="new-world__grid">
    {projects.map((project) => (
      <article class={`project project--${project.id}`} style={`--project-color:${project.color}`}>
        <div class="project__picture">
        <a href={project.href} tabindex="-1" aria-hidden="true">
          {project.image ? <img src={project.image} alt="" width="640" height="427" loading="lazy" decoding="async" /> : project.id === 'almanac' ? (
            <div class="project__almanac"><span class="project__sun"></span><span class="project__horizon"></span><span class="project__caption">SUN / MOON / TIDE<br />33.92° N · SOUTH BAY</span></div>
          ) : project.id === 'home-cartography' ? (
            <div class="project__map"><span class="project__map-room project__map-room--one">a favorite chair</span><span class="project__map-room project__map-room--two">the records</span><span class="project__map-room project__map-room--three">a little history</span><span class="project__map-dot"></span></div>
          ) : (
            <div class="project__agents"><span>you</span><i aria-hidden="true">+</i><span>your AI</span><small>A little more human, together.</small></div>
          )}
        </a>
          <span class="project__status">{project.status}</span>
        </div>
        <div class="project__copy">
          <p class="project__eyebrow">{project.eyebrow}</p>
          <h3><a href={project.href}>{project.name}</a></h3>
          <p class="project__description">{project.description}</p>
          <a class="project__action" href={project.href}>{project.action}<span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </div>
  <nav class="new-world__daily" aria-label="Small daily pleasures">
    <span>Stay a little longer</span>
    <a href="/rosebud">Play Rosebud <span aria-hidden="true">↗</span></a>
    <a href="/faucet/hello">A daily HELLO <span aria-hidden="true">↗</span></a>
    <a href="/beach-commons">Meet Beach Commons <span aria-hidden="true">↗</span></a>
    <a href="/explore">Every door <span aria-hidden="true">↗</span></a>
  </nav>
</section>

<style>
  .new-world { padding: 44px 0 14px; scroll-margin-top: 20px; }
  .new-world__head { display: grid; grid-template-columns: 1.2fr .8fr; gap: 40px; align-items: end; margin-bottom: 24px; }
  .new-world__kicker, .project__eyebrow { margin: 0 0 12px; font: 650 10px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .new-world__kicker { color: #875942; }
  .new-world h2 { margin: 0; font-size: clamp(28px,3.4vw,43px); font-weight: 650; letter-spacing: -.055em; line-height: 1.08; }
  .new-world h2 em { font-style: normal; color: #9f5339; }
  .new-world__head > p { max-width: 41ch; margin: 0 0 3px; font-size: 14px; line-height: 1.6; color: #666055; }
  .new-world__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .project:nth-child(3n+1):last-child { grid-column: 1 / -1; }
  .project { min-width: 0; background: #fffdf8; border: 1px solid #dcd5c8; display: flex; flex-direction: column; }
  .project__picture { position: relative; display: block; aspect-ratio: 1.5; overflow: hidden; background: #ebe3d5; }
  .project__picture > a { display:block; height:100%; }
  .project h3 a { color:#2d302a; }
  .project__map { position:absolute;inset:0;background:#e6d8c6; }
  .project__map-room { position:absolute;display:flex;align-items:center;justify-content:center;border:2px solid #a47562;font:500 9px var(--pc-font-mono);color:#845747;background:#f7eee1; }
  .project__map-room--one { left:12%;top:15%;width:40%;height:48%; }
  .project__map-room--two { left:52%;top:15%;width:35%;height:29%;background:#c7bda0; }
  .project__map-room--three { left:52%;top:44%;width:35%;height:36%; }
  .project__map-dot { position:absolute;left:31%;top:31%;width:12px;height:12px;border:3px solid #f7eee1;border-radius:50%;background:#ae6f52; }
  .project__picture img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .project:focus-within .project__picture img, .project:hover .project__picture img { transform: scale(1.035); }
  .project__status { position: absolute; z-index: 1; bottom: 12px; left: 12px; border: 1px solid #e6e0d3; padding: 7px 9px; background: #fffdf5; color: #332e26; font: 650 9px var(--pc-font-mono); letter-spacing: .03em; }
  .project__copy { padding: 22px; display: flex; flex-direction: column; flex: 1; }
  .project__eyebrow { color: var(--project-color); font-size: 9px; }
  .project h3 { margin: 0 0 12px; font-size: 30px; letter-spacing: -.05em; line-height: 1.06; font-weight: 660; }
  .project__description { margin: 0; color: #5f594e; font-size: 13px; line-height: 1.65; }
  .project__action { display: flex; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 24px; font-size: 12px; font-weight: 650; color: var(--project-color); }
  .project__action span { font-size: 20px; line-height: .8; }
  .project__almanac { position: absolute; inset: 0; background: #f0d59f; overflow: hidden; }
  .project__sun { position: absolute; left: calc(50% - 55px); top: 34px; width: 110px; height: 110px; border-radius: 50%; background: #c46f39; }
  .project__horizon { position: absolute; bottom: 0; width: 100%; height: 44%; background: #4c7777; border-radius: 50% 50% 0 0; transform: scaleX(1.4); }
  .project__caption { position: absolute; inset: 15px auto auto 15px; font: 650 9px/1.65 var(--pc-font-mono); letter-spacing: .12em; color: #59401f; }
  .project__agents { position: absolute; inset: 0; display: flex; gap: 12px; flex-wrap: wrap; align-content: center; justify-content: center; align-items: center; background: #dce5dc; padding: 25px; }
  .project__agents > span { padding: 19px 15px; border: 1px solid #53736a; border-radius: 50%; background: #f9f4e7; color: #264940; font-size: 24px; font-weight: 550; letter-spacing: -.04em; }
  .project__agents > span:nth-of-type(2) { background: #53736a; color: #fff8e6; border-radius: 6px; transform: rotate(4deg); }
  .project__agents i { font-size: 28px; font-style: normal; color: #53736a; }
  .project__agents small { width: 100%; text-align: center; font: 550 9px var(--pc-font-mono); color: #476356; margin-top: 8px; }
  .new-world__daily { margin-top: 24px; padding: 18px 0; border-block: 1px solid #d7d0c4; display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; font-size: 12px; }
  .new-world__daily > span { color: #736959; font: 550 9px var(--pc-font-mono); text-transform: uppercase; letter-spacing: .07em; margin-right: auto; }
  .new-world__daily a { font-weight: 600; }
  .new-world__daily a span { color: #a96945; padding-left: 8px; }
  @media(max-width:900px) { .new-world__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; } .project:nth-child(3n+1):last-child { grid-column: auto; } .project:nth-child(2n+1):last-child { grid-column: 1 / -1; } }
  @media(max-width:620px) { .new-world__head { grid-template-columns: 1fr; gap: 16px; } .new-world__grid { grid-template-columns: 1fr; } .project:last-child { grid-column: auto; } .new-world__daily > span { width: 100%; } .project__picture { aspect-ratio: 1.8; } }
  @media(prefers-reduced-motion:reduce) { .project__picture img { transition: none; } .project:hover .project__picture img, .project:focus-within .project__picture img { transform: none; } }
</style>
