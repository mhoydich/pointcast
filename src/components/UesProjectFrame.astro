---
import BlockLayout from '../layouts/BlockLayout.astro';
import '../styles/ues-projects.css';
interface Props { title: string; description: string; slug?: string; }
const { title, description, slug } = Astro.props;
const canonical = 'https://pointcast.xyz/ues/projects' + (slug ? '/' + slug : '');
---
<BlockLayout title={title} description={description} isolated themeColor="#123fb4"
  image="/images/ues-project-desk.svg" jsonLd={{'@context':'https://schema.org','@type':slug ? 'CreativeWork' : 'CollectionPage',name:title,description,url:canonical,creativeWorkStatus:'Proposed build brief',isPartOf:{'@type':'CreativeWork',name:'University of El Segundo',url:'https://pointcast.xyz/university-of-el-segundo'}}}
  alternates={[{type:'application/json',href:slug ? '/ues/projects/' + slug + '.json' : '/ues/projects/catalog.json',title:'Project brief data'}]}>
  <div class="ues-projects">
    <a class="skip" href="#project-content">Skip to project content</a>
    <header class="up-masthead">
      <a class="up-mark" href="/ues/projects"><span class="up-mark-icon" aria-hidden="true">U</span><span>UNIVERSITY OF<br />EL SEGUNDO</span></a>
      <nav aria-label="University resources"><a href="/ues/projects" aria-current={!slug ? 'page' : undefined}>Project desk</a><a href="/ues">Existing classes</a><a href="/university-of-el-segundo">University</a><a href="/">PointCast</a></nav>
    </header>
    <slot />
    <footer class="up-footer">
      <p>UNIVERSITY OF EL SEGUNDO<br /><span>Three proposals. One useful next step.</span></p>
      <p>New project applications and admissions are closed.<br />Existing self-paced classes keep their current access.</p>
      <a href="/ues/projects/catalog.json">Read the project data ↗</a>
    </footer>
  </div>
</BlockLayout>
