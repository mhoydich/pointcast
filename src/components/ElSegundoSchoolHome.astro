---
import gallery from '../data/el-segundo-school-gallery.json';

const assetOrigin = 'https://el-segundo-school-archive.pages.dev';
const featuredNumbers = new Set(['001', '004', '141', '253', '317', '365', '501', '649']);
const works = gallery.works.filter((work) => featuredNumbers.has(work.number));
---

<section class="school-home" aria-labelledby="school-home-title">
  <div class="school-home__copy">
    <p class="school-home__eyebrow">NEW FIELD BUILDING 07 · EL SEGUNDO, CALIFORNIA</p>
    <h2 id="school-home-title">The whole<br /><i>day</i> is open.</h2>
    <p class="school-home__dek">A living, uncropped archive by Michael Hoydich: university ephemera, flower commons, cannabis study, systems, type, student life, and the beauty of the plant.</p>
    <dl>
      <div><dt>Works</dt><dd>{gallery.count}</dd></div>
      <div><dt>Sets</dt><dd>{gallery.sets}</dd></div>
      <div><dt>Maker</dt><dd>1 ꜩ</dd></div>
    </dl>
    <nav aria-label="The El Segundo School actions">
      <a class="school-home__primary" href="/el-segundo-school">Enter the gallery →</a>
      <a href="/el-segundo-school?make=postcard">Make a Passport</a>
      <a href="/el-segundo-school?make=stamp">Make Stampz</a>
    </nav>
  </div>
  <a class="school-home__wall" href="/el-segundo-school" aria-label="Enter The El Segundo School gallery">
    {works.map((work, index) => (
      <figure style={`--ratio:${work.width}/${work.height};--delay:${index * -1.7}s`}>
        <img
          src={`${assetOrigin}${work.thumb.replace('/images/el-segundo-school', '')}`}
          alt=""
          width={work.width}
          height={work.height}
          loading={index < 4 ? 'eager' : 'lazy'}
        />
        <figcaption>{work.number} · SET {String(work.set).padStart(3, '0')}</figcaption>
      </figure>
    ))}
  </a>
</section>

<style>
  .school-home {
    --school-acid: #caff24;
    display: grid;
    grid-template-columns: minmax(320px, .78fr) minmax(0, 1.22fr);
    min-height: 760px;
    margin: 18px 0 34px;
    border: 1px solid #11120f;
    background: #11120f;
    color: #f1efe5;
    overflow: hidden;
  }

  .school-home__copy { display: flex; flex-direction: column; min-width: 0; padding: clamp(24px, 4vw, 58px); border-right: 1px solid #5c5d57; }
  .school-home__eyebrow { margin: 0; color: var(--school-acid); font: 700 10px/1.4 var(--pc-font-mono); letter-spacing: .14em; }
  .school-home h2 { margin: 54px 0 24px; font: 720 clamp(68px, 8vw, 126px)/.77 var(--pc-font-sans); letter-spacing: -.075em; text-transform: uppercase; }
  .school-home h2 i { color: var(--school-acid); font-style: normal; }
  .school-home__dek { max-width: 560px; margin: 0; font: 22px/1.35 Georgia, serif; }

  .school-home dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: auto 0 26px; border-top: 1px solid #5c5d57; border-bottom: 1px solid #5c5d57; }
  .school-home dl div { padding: 14px 8px; border-right: 1px solid #5c5d57; }
  .school-home dl div:last-child { border-right: 0; }
  .school-home dt { font: 8px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .school-home dd { margin: 5px 0 0; color: var(--school-acid); font: 700 34px/1 var(--pc-font-sans); letter-spacing: -.05em; }

  .school-home nav { display: grid; grid-template-columns: 1.4fr 1fr 1fr; }
  .school-home nav a { display: grid; place-items: center; min-height: 48px; padding: 10px; border: 1px solid #8a8b83; border-right: 0; color: #f1efe5; font: 700 9px var(--pc-font-mono); letter-spacing: .04em; text-align: center; text-transform: uppercase; }
  .school-home nav a:last-child { border-right: 1px solid #8a8b83; }
  .school-home nav a:hover { background: #f1efe5; color: #11120f; text-decoration: none; }
  .school-home nav .school-home__primary { background: var(--school-acid); color: #11120f; border-color: var(--school-acid); }

  .school-home__wall { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; gap: clamp(8px, 1.3vw, 18px); min-width: 0; padding: clamp(18px, 3vw, 44px); background: radial-gradient(circle at 50% 0, #34362d 0, #11120f 68%); color: #f1efe5; perspective: 1200px; }
  .school-home__wall:hover { text-decoration: none; }
  .school-home__wall figure { align-self: center; min-width: 0; margin: 0; padding: 5px; border: 1px solid #696a62; background: #24251f; box-shadow: 0 18px 35px #0009; transform: translateZ(0) rotateY(-1deg); animation: school-breathe 9s ease-in-out infinite alternate; animation-delay: var(--delay); }
  .school-home__wall figure:nth-child(3n) { transform: translateY(32px) rotateY(1deg); }
  .school-home__wall figure:nth-child(4n) { transform: translateY(-24px) rotateY(-1deg); }
  .school-home__wall img { display: block; width: 100%; height: auto; aspect-ratio: var(--ratio); object-fit: contain; background: #30312a; }
  .school-home__wall figcaption { padding: 6px 1px 1px; color: var(--school-acid); font: 7px var(--pc-font-mono); letter-spacing: .08em; }

  @keyframes school-breathe { to { transform: translateZ(18px) rotateY(1deg); } }

  @media (max-width: 1000px) {
    .school-home { grid-template-columns: 1fr; }
    .school-home__copy { border-right: 0; border-bottom: 1px solid #5c5d57; }
    .school-home dl { margin-top: 46px; }
    .school-home__wall { min-height: 620px; }
  }

  @media (max-width: 620px) {
    .school-home { min-height: 0; }
    .school-home h2 { margin-top: 38px; font-size: 61px; }
    .school-home__dek { font-size: 18px; }
    .school-home nav { grid-template-columns: 1fr; }
    .school-home nav a { border-right: 1px solid #8a8b83; border-bottom: 0; }
    .school-home nav a:last-child { border-bottom: 1px solid #8a8b83; }
    .school-home__wall { grid-template-columns: repeat(2, 1fr); min-height: 720px; padding: 18px; }
  }

  @media (prefers-reduced-motion: reduce) { .school-home__wall figure { animation: none; } }
</style>
