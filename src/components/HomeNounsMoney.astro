---
import COLLECTED from '../../public/nouns-money/collected/manifest.json';
import { ENJOY_STATUS } from '../data/enjoy-money';
---
<section class="home-nouns-money" aria-labelledby="home-nouns-money-title" data-home-nouns-money>
  <a class="home-nouns-money__art" href="/nouns-money/" aria-label="Open the Nouns Money collection"><img src="/nouns-money/collected/atlas/01-california-front.webp" width="1000" height="500" alt="Pacific Bloom, an illustrated California art note from the Many Worlds Atlas" fetchpriority="high" decoding="async" /></a>
  <div><p class="home-nouns-money__kicker">NOUNS MONEY · TOP OF THE PAGE</p><h2 id="home-nouns-money-title">A world worth collecting.</h2><p>Explore {COLLECTED.counts.entries} images and editions across {COLLECTED.collections.length} collections. Find a paper world, download an artwork or turn your notes into music.</p><nav aria-label="Explore Nouns Money"><a href="/nouns-money/">Explore the artwork</a><a href="/nouns-money/gallery/">Browse the gallery</a><a href="/nouns-money/music/">Make some music</a></nav></div>
  <a class="home-nouns-money__enjoy" href="/nouns-money/enjoy/" aria-labelledby="home-enjoy-title">
    <span class="home-nouns-money__mark" aria-hidden="true">Enjoy.</span>
    <span><span class="home-nouns-money__kicker">NEW · HOYDICH ENTERPRISES · SERIES 1</span><strong id="home-enjoy-title">Paper notes you scan into your wallet. Bots get money too.</strong><small>{ENJOY_STATUS.label}. Closed loop: nothing goes back out. Read the plan ↗</small></span>
  </a>
</section>
<style>
.home-nouns-money{display:grid;grid-template-columns:minmax(160px,250px) minmax(0,1fr);gap:20px;align-items:center;margin:16px 0 24px;padding:16px;border:2px solid #111;box-shadow:6px 6px 0 #0b6b3a;background:#edf8f1}.home-nouns-money__art{display:block}.home-nouns-money__art img{display:block;width:100%;height:auto;border:1px solid #537662}.home-nouns-money__kicker{display:block;margin:0 0 6px;font:500 .8rem/1.5 var(--pc-font-mono);letter-spacing:.08em;color:#155334}.home-nouns-money h2{font-size:1.7rem;line-height:1.2;font-weight:500;margin:0 0 8px;letter-spacing:-.02em}.home-nouns-money p:not(.home-nouns-money__kicker){font-size:1rem;line-height:1.5;margin:0 0 12px;max-width:70ch}.home-nouns-money nav{display:flex;gap:8px;flex-wrap:wrap}.home-nouns-money nav a{display:inline-flex;align-items:center;min-height:40px;padding:7px 10px;border:1px solid #145d3b;font-size:.875rem;color:#145d3b;background:white;text-decoration:none}.home-nouns-money nav a:hover{background:#d6f1df}
.home-nouns-money__enjoy{grid-column:1/-1;display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;align-items:center;padding:12px 16px;border:2px solid #111;background:#f6edcd;color:#13261c;text-decoration:none}.home-nouns-money__enjoy:hover{background:#efe2b4}.home-nouns-money__mark{font:italic 400 2.6rem/1 Georgia,'Times New Roman',serif;color:#0b6b3a}.home-nouns-money__enjoy strong{display:block;font-size:1.1rem;line-height:1.35;font-weight:600}.home-nouns-money__enjoy small{display:block;margin-top:4px;font-size:.85rem;line-height:1.4}
@media(max-width:650px){.home-nouns-money{grid-template-columns:1fr;gap:14px}.home-nouns-money__art{max-width:320px}.home-nouns-money h2{font-size:1.6rem}.home-nouns-money__enjoy{grid-template-columns:1fr;gap:6px}}
@media(prefers-color-scheme:dark){.home-nouns-money{background:#152b23;color:#edf8f1;border-color:#8ebda3}.home-nouns-money__kicker{color:#99d4b4}.home-nouns-money nav a{background:#213b2f;color:#dcf5e6;border-color:#8ebda3}.home-nouns-money nav a:hover{background:#2d503f}.home-nouns-money__enjoy{background:#1f3328;color:#efe7cc;border-color:#8ebda3}.home-nouns-money__enjoy:hover{background:#29443a}.home-nouns-money__mark{color:#7fd1a2}}.home-nouns-money a:focus-visible{outline:3px solid #c8412e;outline-offset:3px}</style>
