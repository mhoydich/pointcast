import COLLECTED from '../../public/nouns-money/collected/manifest.json';
---
<section class="home-nouns-money" aria-labelledby="home-nouns-money-title" data-home-nouns-money>
  <a class="home-nouns-money__art" href="/nouns-money/" aria-label="Open the Nouns Money collection"><img src="/nouns-money/collected/atlas/01-california-front.webp" width="1000" height="500" alt="Pacific Bloom, an illustrated California art note from the Many Worlds Atlas" decoding="async" /></a>
  <div><p class="home-nouns-money__kicker">NOUNS MONEY · THE COLLECTED EDITION</p><h2 id="home-nouns-money-title">A world worth collecting.</h2><p>Explore {COLLECTED.counts.entries} images and editions across {COLLECTED.collections.length} collections. Find a paper world, download an artwork or turn your notes into music.</p><nav aria-label="Explore Nouns Money"><a href="/nouns-money/">Explore the artwork</a><a href="/nouns-money/gallery/">Browse the gallery</a><a href="/nouns-money/music/">Make some music</a></nav></div>
