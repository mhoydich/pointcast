<style>
.home-nouns-money{display:grid;grid-template-columns:minmax(160px,250px) minmax(0,1fr);gap:20px;align-items:center;margin:16px 0 24px;padding:16px;border:2px solid #111;box-shadow:6px 6px 0 #0b6b3a;background:#edf8f1}.home-nouns-money__art{display:block}.home-nouns-money__art img{display:block;width:100%;height:auto;border:1px solid #537662}.home-nouns-money__kicker{margin:0 0 6px;font:500 .8rem/1.5 var(--pc-font-mono);letter-spacing:.08em;color:#155334}.home-nouns-money h2{font-size:1.7rem;line-height:1.2;font-weight:500;margin:0 0 8px;letter-spacing:-.02em}.home-nouns-money p:not(.home-nouns-money__kicker){font-size:1rem;line-height:1.5;margin:0 0 12px;max-width:70ch}.home-nouns-money nav{display:flex;gap:8px;flex-wrap:wrap}.home-nouns-money nav a{display:inline-flex;align-items:center;min-height:40px;padding:7px 10px;border:1px solid #145d3b;font-size:.875rem;color:#145d3b;background:white;text-decoration:none}.home-nouns-money nav a:hover{background:#d6f1df}@media(max-width:650px){.home-nouns-money{grid-template-columns:1fr;gap:14px}.home-nouns-money__art{max-width:320px}.home-nouns-money h2{font-size:1.6rem}}
@media(prefers-color-scheme:dark){.home-nouns-money{background:#152b23;color:#edf8f1;border-color:#8ebda3}.home-nouns-money__kicker{color:#99d4b4}.home-nouns-money nav a{background:#213b2f;color:#dcf5e6;border-color:#8ebda3}.home-nouns-money nav a:hover{background:#2d503f}}.home-nouns-money a:focus-visible{outline:3px solid #c8412e;outline-offset:3px}</style>
