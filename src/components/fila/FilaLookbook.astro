---
import { CAPSULES, CONCEPT_LABEL, LOOKS, lookImage, sourceFor } from '../../data/fila-study';
interface Props { primary?: boolean; }
const Heading = Astro.props.primary ? 'h1' : 'h2';
---
<section class:list={['lookbook', { 'lookbook-focused': Astro.props.primary }]} id="lookbook" aria-labelledby="lookbook-title" data-fila-lookbook>
  <header class="book-heading">
    <div><p class="eyebrow">ROOM 04 / AN INDEPENDENT FUTURE</p><Heading id="lookbook-title" class="book-title">Court. Club.<br /><em>Coast.</em> <span>2027</span></Heading></div>
    <div class="book-intro"><p>Twelve looks. Three environments.<br />One line running through them.</p><p class="concept-label">{CONCEPT_LABEL}</p><p>These are visual proposals: fabrics, fit and function need physical development. The generated models are fictional.</p></div>
  </header>
  <details class="capsule-overview" open={!Astro.props.primary}>
  <summary>Capsule notes <span>Court / Club / Coast +</span></summary>
  <div class="capsule-notes">
    {CAPSULES.map(capsule => <div><span class="capsule-dots" aria-hidden="true">{capsule.colors.map(color => <i style={`background:${color}`}></i>)}</span><h3>{capsule.name}</h3><p>{capsule.idea}</p></div>)}
  </div>
  </details>
  <div class="book-controls" hidden data-book-controls>
    <div class="palette-controls" role="group" aria-label="Palette and capsule filter">
      <span class="control-label">PALETTE</span>
      <button type="button" data-palette="all" aria-pressed="true">All</button>
      {CAPSULES.map(capsule => <button type="button" data-palette={capsule.id} aria-pressed="false"><i style={`background:${capsule.colors[0]}`} aria-hidden="true"></i>{capsule.name}</button>)}
    </div>
    <label class="garment-filter"><span class="control-label">GARMENT</span><select data-garment><option value="all">All silhouettes</option><option value="tops">Tops & separates</option><option value="knits">Knits</option><option value="outerwear">Outerwear</option><option value="dresses">Dresses</option><option value="skirts">Skirts</option></select></label>
    <button type="button" class="reset-filter" data-reset>Reset</button>
    <div class="book-paging"><button type="button" data-prev aria-label="Previous look">←</button><span data-page aria-live="polite" aria-atomic="true">01 / 12</span><button type="button" data-next aria-label="Next look">→</button></div>
  </div>
  <p class="book-instruction"><span data-book-help>Scroll through twelve looks; each includes material and reference notes.</span><span data-result-count>12 looks</span></p>
  <p class="empty-state" data-empty hidden>No looks in this combination. Reset or choose another garment.</p>
  <div class="look-track" data-look-track tabindex="0" role="region" aria-label="Twelve concept looks; horizontal gallery">
    {LOOKS.map(look => <article class="look" data-look data-look-id={look.id} data-capsule={look.capsule} data-category={look.category} aria-labelledby={`look-${look.id}-title`}>
      <div class="look-visual">
        <span class="look-number" aria-hidden="true">{look.id}</span>
        <button type="button" class="look-enlarge" data-enlarge aria-label={`Enlarge look ${look.id}, ${look.name}`} disabled>
          <img src={lookImage(look.id)} width={look.capsule === 'coast' ? 362 : 384} height={look.capsule === 'coast' ? 543 : 512} loading="lazy" decoding="async" alt={`AI-generated independent concept, look ${look.id}: ${look.outfit}, front view.`} data-look-image data-front={lookImage(look.id)} data-back={lookImage(look.id,'back')} data-detail={lookImage(look.id,'detail')} />
          <span class="zoom-hint" hidden data-zoom-hint>Enlarge +</span>
        </button>
        <div class="view-controls" role="group" aria-label={`Image view for look ${look.id}`} hidden data-view-controls>
          <button type="button" data-view="front" aria-pressed="true">Front</button><button type="button" data-view="back" aria-pressed="false">Back</button><button type="button" data-view="detail" aria-pressed="false">Detail</button>
        </div>
      </div>
      <div class="look-copy">
        <p class="eyebrow">LOOK {look.id} / {look.capsule.toUpperCase()}</p><h3 id={`look-${look.id}-title`}>{look.name}</h3><p class="look-outfit">{look.outfit}</p>
        <dl><div><dt>Material</dt><dd>{look.material}</dd></div><div><dt>Fit</dt><dd>{look.fit}</dd></div><div><dt>Function</dt><dd>{look.function}</dd></div></dl>
        <details><summary>Reference annotation <span aria-hidden="true">+</span></summary><p>{look.influence}</p><a href={sourceFor(look.reference).url}>{sourceFor(look.reference).title} ↗</a></details>
        <p class="detail-caption">Detail study: {look.detail}</p>
        <p class="image-provenance">Original AI-generated concept / 2026<br />Front and back are imagined views. Detail is a crop of the front render.</p>
      </div>
    </article>)}
  </div>
  <noscript><p class="noscript-note">The full collection is available by horizontal scrolling. Image switching, filters and enlargement require JavaScript.</p></noscript>
  <dialog class="look-dialog" data-look-dialog aria-labelledby="dialog-look-title">
    <div class="dialog-header"><h3 id="dialog-look-title" data-dialog-title>Concept look</h3><button type="button" data-close aria-label="Close enlarged image">Close ×</button></div>
    <div class="dialog-controls" role="group" aria-label="Enlarged image view"><button type="button" data-dialog-view="front" aria-pressed="true">Front</button><button type="button" data-dialog-view="back" aria-pressed="false">Back</button><button type="button" data-dialog-view="detail" aria-pressed="false">Detail crop</button><button type="button" data-magnify aria-pressed="false">Magnify +</button></div>
    <div class="dialog-stage" data-dialog-stage tabindex="0" aria-label="Enlarged concept image; scroll when magnified"><img data-dialog-image alt="" /></div>
    <p class="dialog-caption" data-dialog-caption>Original AI-generated concept imagery.</p>
  </dialog>
</section>
<script>
  import { initFilaLookbooks } from '../../scripts/fila-lookbook.mjs';
  initFilaLookbooks();
</script>
<style>
  .capsule-overview{margin:20px var(--gutter,5vw) 0;border-top:1px solid #12223b44}.capsule-overview>summary{font:10px/1.6 'JetBrains Mono Variable',monospace;cursor:pointer;padding:14px 0;display:flex;justify-content:space-between;min-height:44px}.capsule-overview .capsule-notes{padding:25px 0 35px}.book-instruction [data-result-count]{white-space:nowrap}.lookbook-focused .book-heading{align-items:center}.lookbook-focused .book-intro>p:last-child{font-size:11px}.lookbook-focused .book-intro>p:first-child{font-size:14px}
  .lookbook{color:#12223b;background:#efeade;padding:clamp(24px,4vw,70px) 0 0;scroll-margin-top:70px}
  .book-heading{padding:0 var(--gutter,5vw);display:grid;grid-template-columns:1.6fr 1fr;gap:5vw;align-items:end}.eyebrow,.control-label,.book-instruction,.book-paging,.image-provenance{font-family:'JetBrains Mono Variable',monospace;letter-spacing:.045em;font-size:10px;line-height:1.6}.eyebrow{margin:0 0 24px}
  .book-heading .book-title{font-size:clamp(58px,9vw,145px);line-height:.88;letter-spacing:-.065em;font-weight:600;margin:0}.book-heading .book-title em{font-family:Georgia,serif;font-weight:400}.book-heading .book-title span{font-family:'JetBrains Mono Variable',monospace;font-size:.24em;letter-spacing:-.05em;vertical-align:top;padding-left:12px;color:#a82d35}.book-intro p{font-size:clamp(15px,1.45vw,21px);line-height:1.5}.book-intro .concept-label{font-size:12px;border-left:2px solid #ad3238;padding-left:16px}.book-intro p:last-child{font-size:12px;line-height:1.6;max-width:45ch}
  .capsule-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;padding:50px var(--gutter,5vw)}.capsule-notes h3{display:inline;font-size:25px;letter-spacing:-.04em;margin:0 0 0 12px}.capsule-notes p{font-size:13px;line-height:1.65;max-width:35ch}.capsule-dots{display:inline-flex;gap:3px}.capsule-dots i{display:block;width:12px;height:12px;border:1px solid #12223b33;border-radius:50%}
  button,select{font:inherit;color:inherit}button{cursor:pointer}.book-controls{padding:16px var(--gutter,5vw);border-top:1px solid #12223b;border-bottom:1px solid #12223b;display:flex;gap:24px;align-items:center;flex-wrap:wrap}.book-controls[hidden],.view-controls[hidden],.empty-state[hidden],.look[hidden]{display:none}.palette-controls,.book-paging,.garment-filter{display:flex;gap:8px;align-items:center}.control-label{margin-right:8px}.palette-controls button,.view-controls button,.dialog-controls button,.reset-filter,.book-paging button{border:1px solid #12223b55;background:transparent;padding:9px 14px;font-size:12px;min-height:42px}.palette-controls button{display:flex;gap:7px;align-items:center}.palette-controls button i{width:9px;height:9px;display:block;border-radius:50%;border:1px solid #eee8d9}.palette-controls [aria-pressed=true],.view-controls [aria-pressed=true],.dialog-controls [aria-pressed=true]{background:#12223b;color:#f1ecdf;border-color:#12223b}.garment-filter select{border:0;border-bottom:1px solid #12223b;background:transparent;padding:10px 20px 10px 0;font-size:12px;min-height:42px;max-width:190px}.reset-filter{border:0;text-decoration:underline;padding:8px}.book-paging{margin-left:auto;white-space:nowrap}.book-paging button{font-size:22px;padding:3px 16px}.book-paging span{min-width:70px;text-align:center}
  .book-instruction{padding:0 var(--gutter,5vw);display:flex;justify-content:space-between;gap:20px}.look-track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-left:var(--gutter,5vw);padding:14px var(--gutter,5vw) 40px;scrollbar-color:#ad3238 #d9d4c9;overscroll-behavior-x:contain}.look{flex:0 0 min(88vw,1040px);display:grid;grid-template-columns:1.1fr 1fr;scroll-snap-align:start;background:#f7f3e9;min-width:0}.look-visual{position:relative;min-width:0;background:#e6e1d7}.look-number{position:absolute;top:20px;left:20px;z-index:1;font-family:'JetBrains Mono Variable',monospace;font-size:12px}.look-enlarge{padding:0;border:0;width:100%;display:block;position:relative;background:transparent;color:#12223b}.look-enlarge:disabled{cursor:default}.look-enlarge img{display:block;width:100%;height:590px;object-fit:contain;mix-blend-mode:multiply}.zoom-hint{position:absolute;bottom:20px;right:20px;background:#f7f3e9;padding:8px 12px;font-size:11px;border:1px solid #12223b44}.view-controls{display:flex;gap:0;justify-content:center;padding:12px;border-top:1px solid #12223b22}.view-controls button{min-width:78px;border-right:0}.view-controls button:last-child{border-right:1px solid #12223b55}
  .look-copy{padding:clamp(24px,3.4vw,48px);display:flex;flex-direction:column}.look-copy .eyebrow{color:#a42e36;margin-bottom:20px}.look-copy h3{font-size:clamp(32px,4vw,55px);line-height:.95;letter-spacing:-.065em;margin:0 0 20px}.look-outfit{font-size:17px;line-height:1.4;margin:0 0 25px}.look-copy dl{margin:0;border-top:1px solid #12223b33}.look-copy dl div{display:grid;grid-template-columns:70px 1fr;gap:10px;padding:12px 0;border-bottom:1px solid #12223b22;font-size:12px;line-height:1.6}.look-copy dt{font-family:'JetBrains Mono Variable',monospace;font-size:10px;line-height:1.9;text-transform:uppercase}.look-copy dd{margin:0}.look-copy details{font-size:12px;line-height:1.6;border-bottom:1px solid #12223b22}.look-copy summary{cursor:pointer;min-height:44px;padding:14px 0;display:flex;justify-content:space-between}.look-copy details p{margin:0 0 12px}.look-copy details a{text-decoration:underline;color:inherit;display:block;margin-bottom:14px}.detail-caption{font-size:12px;line-height:1.6;margin:18px 0}.image-provenance{font-size:9px;line-height:1.6;margin:auto 0 0;padding-top:20px;color:#526078}.empty-state,.noscript-note{padding:25px var(--gutter,5vw)}
  .look-dialog{border:0;padding:0;background:#f3eee2;color:#12223b;width:min(1000px,96vw);max-width:96vw;max-height:94dvh;box-shadow:0 15px 80px #0005}.look-dialog::backdrop{background:#07182bdc}.dialog-header{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;border-bottom:1px solid #12223b44}.dialog-header h3{font-size:20px;letter-spacing:-.04em;margin:0}.dialog-header button{background:#12223b;color:#f3eee2;border:0;padding:10px 18px;min-height:44px;font-size:12px}.dialog-controls{display:flex;gap:7px;padding:12px 22px;flex-wrap:wrap}.dialog-stage{height:62dvh;overflow:auto;overscroll-behavior:contain;background:#e7e2d8}.dialog-stage img{display:block;height:100%;width:100%;object-fit:contain;mix-blend-mode:multiply}.dialog-stage.magnified img{width:150%;height:auto;max-width:none;object-fit:unset;margin:auto}.dialog-caption{font-size:11px;line-height:1.6;margin:0;padding:14px 22px}.lookbook :focus-visible{outline:3px solid #af3039;outline-offset:4px}
  @media(max-width:850px){.book-heading{grid-template-columns:1fr 1fr;gap:25px}.book-controls{gap:12px}.capsule-notes{gap:22px}.look{grid-template-columns:1fr 1fr;flex-basis:91vw}.look-enlarge img{height:570px}.look-copy{padding:25px}.book-paging{margin-left:0}.book-intro p{font-size:15px}}
  @media(max-width:600px){.book-heading{grid-template-columns:1fr}.book-heading .book-title{font-size:clamp(67px,17vw,104px)}.book-intro{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.book-intro p{margin:16px 0 0}.book-intro p:last-child{grid-column:1/-1}.book-intro .concept-label{font-size:10px}.capsule-notes{gap:14px;padding:30px var(--gutter,5vw)}.capsule-notes h3{font-size:20px;display:block;margin:7px 0}.capsule-notes p{font-size:11px;line-height:1.5}.capsule-dots i{width:10px;height:10px}.book-controls{padding-top:12px;padding-bottom:12px;gap:8px 14px}.palette-controls{width:100%;justify-content:space-between;gap:4px}.palette-controls .control-label{font-size:8px;margin-right:2px}.palette-controls button{padding:8px 10px;font-size:11px;min-height:44px}.garment-filter{gap:4px}.garment-filter .control-label{font-size:8px;margin-right:3px}.garment-filter select{font-size:11px;max-width:145px}.reset-filter{font-size:11px}.book-paging{margin-left:auto;gap:2px}.book-paging button{font-size:18px;padding:2px 10px}.book-paging span{font-size:9px;min-width:48px}.book-instruction{font-size:8px;gap:10px}.look-track{gap:15px;padding-top:8px;padding-bottom:25px}.look{grid-template-columns:1fr;flex-basis:89vw;align-content:start}.look-enlarge img{height:clamp(410px,65dvh,570px);object-fit:contain}.look-copy{padding:28px}.look-copy h3{font-size:42px}.look-copy .eyebrow{margin-bottom:14px}.look-outfit{font-size:16px}.look-copy dl div{font-size:12px}.image-provenance{padding-top:12px}.view-controls{padding:8px}.view-controls button{font-size:11px;min-height:44px}.dialog-header{padding:12px}.dialog-header h3{font-size:17px}.dialog-controls{padding:10px 12px;gap:5px}.dialog-controls button{font-size:10px;padding:8px 10px;min-height:44px}.dialog-caption{padding:12px}.dialog-stage{height:61dvh}}
  @media(prefers-reduced-motion:reduce){.look-track{scroll-behavior:auto}}
  @media(max-width:600px){.lookbook-focused .book-intro{display:block}.lookbook-focused .book-intro>p:first-child{display:none}.lookbook-focused .book-intro .concept-label{margin-top:20px;font-size:11px;max-width:none}.lookbook-focused .book-intro>p:last-child{font-size:10px;margin-top:12px}.capsule-overview{margin-top:20px}.capsule-overview .capsule-notes{padding:16px 0 22px}.garment-filter select{max-width:120px;padding-right:10px}}
</style>
