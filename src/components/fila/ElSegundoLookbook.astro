---
import { LOCAL_LOOKS, CHAPTERS, SOURCES, localImage, INDEPENDENT_LABEL } from '../../data/fila-el-segundo';
const categories = [
  ['tops', 'Tops'], ['outerwear', 'Outerwear'], ['knits', 'Knits'], ['dresses', 'Dresses'], ['skirts', 'Skirts'],
];
const chapterFor = (id: string) => CHAPTERS.find(chapter => chapter.id === id);
const sourceFor = (id: string) => SOURCES.find(source => source.id === id);
---

<section class="es-collection" id="collection" data-fila-el-segundo aria-labelledby="es-collection-title">
  <header class="es-heading">
    <p class="es-eyebrow">EL SEGUNDO / AN INDEPENDENT COLLECTION STUDY</p>
    <div class="es-heading-line"><h2 id="es-collection-title">Nine looks.<br /><em>One long afternoon.</em></h2><p class="es-opening">From the ocean edge to the working block to the court. Three local rhythms, nine original silhouettes, and a little room to play.</p></div>
    <p class="es-independent">{INDEPENDENT_LABEL}</p>
  </header>

  <div class="es-chapter-key" aria-label="The collection's three chapters">
    {CHAPTERS.map((chapter, index) => <article data-chapter={chapter.id}><div class="es-chapter-top"><span class="es-serial">0{index + 1}</span><h3>{chapter.name}</h3><span class="es-color-chips" aria-hidden="true">{chapter.colors.map(color => <i style={`background:${color}`}></i>)}</span></div><p>{chapter.idea}</p></article>)}
  </div>

  <aside class="es-edit" data-es-js hidden aria-labelledby="es-edit-title">
    <div class="es-edit-intro"><p class="es-eyebrow">A SMALL PERSONAL COLLECTION</p><h3 id="es-edit-title">Your afternoon <em>edit.</em></h3><p>Save up to three looks. Share the combination that feels like your kind of afternoon.</p></div>
    <div class="es-edit-content"><span class="es-edit-count" data-es-saved-count aria-label="Number of selected looks">0 / 3</span><p class="es-edit-empty" data-es-edit-empty>Something by the water?<br />Something with a little structure?<br />Make it yours.</p><ol class="es-saved-list" data-es-saved-list aria-label="Your saved looks"></ol><div class="es-edit-actions"><button type="button" data-es-saved-only aria-pressed="false">Your edit only</button><button type="button" data-es-clear disabled>Clear</button><button type="button" data-es-copy disabled>Copy edit link ↗</button></div><p class="es-status" data-es-status role="status" aria-live="polite" aria-atomic="true"></p><p class="es-status" data-es-share-status role="status" aria-live="polite" aria-atomic="true"></p><div class="es-share-fallback" data-es-share-fallback hidden><label for="es-share-url">Your edit link</label><input id="es-share-url" data-es-share-url type="url" readonly spellcheck="false" aria-describedby="es-share-help" /><p id="es-share-help">This read-only link is selectable. Copy it with your browser or keyboard.</p></div></div>
  </aside>

  <div class="es-controls" data-es-js hidden>
    <div class="es-filters"><div class="es-chapter-filters" role="group" aria-label="Filter by chapter"><button type="button" data-es-chapter="all" aria-pressed="true">All nine</button>{CHAPTERS.map(chapter => <button type="button" data-es-chapter={chapter.id} aria-pressed="false">{chapter.name}</button>)}</div><label class="es-garment-label">Garment<select data-es-garment aria-label="Filter by garment"><option value="all">All garments</option>{categories.map(([value, label]) => <option value={value}>{label}</option>)}</select></label><button class="es-reset" type="button" data-es-reset>Reset filters</button></div>
    <div class="es-gallery-meta"><span data-es-result-count role="status" aria-live="polite">9 looks</span><span class="es-paging"><span data-es-page aria-live="off">01 / 09</span><button type="button" data-es-prev aria-label="Previous look">←</button><button type="button" data-es-next aria-label="Next look">→</button></span></div>
  </div>
  <p class="es-gallery-help" id="es-gallery-help" data-es-help>Explore all nine original concepts below. Front, back and detail-crop links are available with each look.</p>
  <p class="es-empty" data-es-empty hidden>No looks in this combination.<br /><span>Try another chapter or reset the filters.</span></p>

  <div class="es-track" data-es-track role="region" aria-label="El Segundo collection gallery">
    {LOCAL_LOOKS.map(look => {
      const chapter = chapterFor(look.chapter);
      const source = sourceFor(look.reference);
      return <article class="es-look" id={`es-look-${look.id}`} data-es-look data-look-id={look.id} data-chapter={look.chapter} data-category={look.category} aria-labelledby={`es-look-title-${look.id}`}>
        <div class="es-look-top"><span class="es-look-number">{look.id}</span><span class="es-look-chapter">{chapter?.name ?? look.chapter}</span><button class="es-save" type="button" data-es-save data-es-js hidden aria-pressed="false" aria-label={`Save look ${look.id}, ${look.name} to your afternoon edit`}>Save +</button></div>
        <figure class="es-look-figure"><a class="es-image-link" data-es-enlarge href={localImage(look.id, 'front')} aria-label={`Enlarge look ${look.id}, ${look.name}`}><img data-es-image src={localImage(look.id, 'front')} data-front={localImage(look.id, 'front')} data-back={localImage(look.id, 'back')} data-detail={localImage(look.id, 'detail')} data-current-view="front" width="768" height="1024" loading="lazy" decoding="async" alt={`Original AI-generated independent concept, look ${look.id}: ${look.outfit}, front view.`} /><span class="es-enlarge-hint" aria-hidden="true">Enlarge ↗</span></a><figcaption><span data-es-view-label>front view</span><span>Original AI-generated concept</span></figcaption></figure>
        <div class="es-view-controls" data-es-view-controls data-es-js hidden role="group" aria-label={`Image views for look ${look.id}`}><button type="button" data-es-view="front" aria-pressed="true">Front</button><button type="button" data-es-view="back" aria-pressed="false">Back</button><button type="button" data-es-view="detail" aria-pressed="false">Detail crop</button></div>
        <div class="es-static-views"><a href={localImage(look.id, 'front')}>Front image ↗</a><a href={localImage(look.id, 'back')}>Back image ↗</a><a href={localImage(look.id, 'detail')}>Detail crop ↗</a></div>
        <div class="es-look-copy"><h3 id={`es-look-title-${look.id}`}>{look.name}</h3><p class="es-outfit" data-es-outfit>{look.outfit}</p><dl class="es-design-notes"><div><dt>Proposed material</dt><dd>{look.material}</dd></div><div><dt>Fit direction</dt><dd>{look.fit}</dd></div><div><dt>Intended function</dt><dd>{look.function}</dd></div></dl><p class="es-detail"><span>Design detail /</span> {look.detail}</p><p class="es-proposal-note">Design proposals, not certified product specifications. Front and back are generated interpretations; detail is a crop of the front rendering, not a physical fabric sample.</p><div class="es-reference"><span class="es-eyebrow">REFERENCE → OUR INTERPRETATION</span>{source ? <><a href={source.url}>{source.title} ↗</a><p><strong>Source:</strong> {source.fact}</p><p><strong>Interpretation:</strong> {source.inference}</p></> : <p>{look.reference}</p>}</div></div>
      </article>;
    })}
  </div>
  <p class="es-footnote">The collection is an independent PointCast proposal. The imagined garments, models and settings are not official FILA releases, endorsements, available inventory or physical samples.</p>

  <dialog class="es-dialog" data-es-dialog aria-labelledby="es-dialog-title" aria-describedby="es-dialog-caption">
    <div class="es-dialog-bar"><h3 id="es-dialog-title" data-es-dialog-title>Collection image</h3><button type="button" data-es-close aria-label="Close enlarged image">Close ×</button></div>
    <div class="es-dialog-tools"><div role="group" aria-label="Enlarged image view"><button type="button" data-es-dialog-view="front" aria-pressed="true">Front</button><button type="button" data-es-dialog-view="back" aria-pressed="false">Back</button><button type="button" data-es-dialog-view="detail" aria-pressed="false">Detail crop</button></div><button type="button" data-es-magnify aria-pressed="false">Magnify +</button></div>
    <div class="es-dialog-stage" data-es-dialog-stage tabindex="0" role="region" aria-label="Enlarged image; scroll to inspect when magnified"><img data-es-dialog-image width="768" height="1024" alt="" /></div>
    <p class="es-dialog-caption" id="es-dialog-caption" data-es-dialog-caption>Original AI-generated independent collection concept.</p>
  </dialog>
</section>

<script>
  import { initElSegundoCollection } from '../../scripts/fila-el-segundo.mjs';
  initElSegundoCollection();
  document.addEventListener('astro:page-load', () => initElSegundoCollection());
</script>

<style>
  .es-collection{--es-cream:#f3eedf;--es-ink:#10213c;--es-blue:#204fcb;--es-clay:#b75235;--es-silver:#d2d5d6;color:var(--es-ink);background:var(--es-cream);padding:80px var(--gutter,clamp(20px,4vw,70px));scroll-margin-top:75px}
  .es-collection :global([hidden]){display:none!important}.es-collection button,.es-collection select,.es-collection input{font:inherit}.es-collection button,.es-collection select{min-height:44px}.es-collection button{cursor:pointer}.es-collection button:disabled{cursor:default;opacity:.42}.es-collection a{color:inherit;text-underline-offset:4px}.es-collection :is(button,a,select,input):focus-visible,.es-track:focus-visible,.es-dialog-stage:focus-visible{outline:3px solid var(--es-blue);outline-offset:5px}
  .es-eyebrow{font:10px/1.6 var(--mono,'JetBrains Mono Variable',monospace);letter-spacing:.08em;margin:0}.es-heading-line{display:grid;grid-template-columns:1.6fr 1fr;gap:5vw;align-items:end;margin-top:28px}.es-heading h2{font-size:clamp(50px,7.6vw,120px);font-weight:500;letter-spacing:-.07em;line-height:.96;margin:0}.es-heading h2 em,.es-edit h3 em{font-family:Georgia,serif;font-weight:400}.es-opening{max-width:35ch;font-size:17px;line-height:1.7;margin:0 0 5px}.es-independent{font:10px/1.8 var(--mono,'JetBrains Mono Variable',monospace);margin:30px 0 50px;max-width:100ch}
  .es-chapter-key{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-bottom:55px}.es-chapter-key article{border-top:3px solid var(--es-blue);padding-top:18px}.es-chapter-key article[data-chapter="works"]{border-color:#858f9c}.es-chapter-key article[data-chapter="court"]{border-color:var(--es-clay)}.es-chapter-top{display:flex;align-items:center;gap:15px}.es-serial{font:11px var(--mono,'JetBrains Mono Variable',monospace)}.es-chapter-key h3{font-size:28px;font-weight:500;letter-spacing:-.05em;margin:0}.es-color-chips{display:flex;margin-left:auto;gap:4px}.es-color-chips i{width:15px;height:15px;border:1px solid #10213c20}.es-chapter-key p{font-size:12px;line-height:1.8;max-width:42ch;margin:14px 0 0}
  .es-edit{display:grid;grid-template-columns:1fr 1.4fr;gap:5vw;background:var(--es-ink);color:var(--es-cream);padding:35px 40px;margin:0 0 45px}.es-edit h3{font-size:clamp(32px,4vw,58px);font-weight:500;line-height:1;letter-spacing:-.05em;margin:16px 0}.es-edit-intro>p:last-child{font-size:12px;line-height:1.8;max-width:36ch}.es-edit-content{position:relative;padding-top:3px}.es-edit-count{font:11px var(--mono,'JetBrains Mono Variable',monospace);position:absolute;right:0;top:0}.es-edit-empty{font-size:18px;line-height:1.5;letter-spacing:-.025em;margin:12px 60px 18px 0;min-height:81px}.es-saved-list{padding:0;list-style:none;display:flex;flex-direction:column;gap:6px;margin:12px 65px 18px 0;min-height:81px}.es-saved-list :global(button){font:inherit;background:none;border:0;border-bottom:1px solid #f3eedf66;color:inherit;padding:5px 0;text-align:left;font-size:14px;min-height:34px;cursor:pointer}.es-saved-list :global(button):focus-visible{outline:3px solid #96b8ff;outline-offset:4px}.es-edit-actions{display:flex;flex-wrap:wrap;gap:9px}.es-edit-actions button{border:1px solid #f3eedf66;background:none;color:inherit;padding:8px 14px;font-size:11px}.es-edit-actions button[aria-pressed="true"]{background:var(--es-cream);color:var(--es-ink)}.es-edit :is(button,input):focus-visible{outline-color:#96b8ff}.es-status{font-size:11px;line-height:1.7;margin:10px 0 0;min-height:0}.es-status:empty{display:none}.es-share-fallback{margin-top:15px}.es-share-fallback label{display:block;font-size:11px;margin:0 0 7px}.es-share-fallback input{width:100%;box-sizing:border-box;background:var(--es-cream);border:0;color:var(--es-ink);padding:12px;font-size:12px;min-height:44px}.es-share-fallback p{font-size:10px;line-height:1.7;margin-bottom:0}
  .es-controls{border-top:1px solid #10213c55;padding-top:22px}.es-filters{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.es-chapter-filters{display:flex;gap:7px;flex-wrap:wrap}.es-chapter-filters button,.es-reset{border:1px solid #10213c55;border-radius:0;background:none;color:var(--es-ink);padding:9px 16px;font-size:11px}.es-chapter-filters button[aria-pressed="true"]{background:var(--es-ink);color:var(--es-cream);border-color:var(--es-ink)}.es-garment-label{margin-left:auto;display:flex;align-items:center;gap:9px;font:10px var(--mono,'JetBrains Mono Variable',monospace)}.es-garment-label select{background:transparent;color:var(--es-ink);border:1px solid #10213c55;padding:8px 28px 8px 10px;max-width:160px;font:inherit;font-size:11px}.es-reset{padding:8px 0;border:0;border-bottom:1px solid var(--es-ink);min-height:35px!important}.es-gallery-meta{display:flex;justify-content:space-between;align-items:center;font:10px var(--mono,'JetBrains Mono Variable',monospace);margin:20px 0 0}.es-paging{display:flex;align-items:center;gap:7px}.es-paging>span{margin-right:15px}.es-paging button{width:44px;border:1px solid #10213c55;background:none;color:inherit;font-size:20px}.es-gallery-help{font:10px/1.8 var(--mono,'JetBrains Mono Variable',monospace);margin:17px 0 25px}.es-empty{border-top:1px solid #10213c44;border-bottom:1px solid #10213c44;padding:45px 0;font-size:26px;line-height:1.5;letter-spacing:-.03em}.es-empty span{font-size:13px;letter-spacing:0}
  .es-track{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:50px 25px;position:relative;scrollbar-color:var(--es-ink) #d9d4c7;scrollbar-width:thin}.is-enhanced .es-track{display:flex;gap:30px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;padding-bottom:25px;scroll-padding-inline:0}.is-enhanced .es-look{flex:0 0 min(46vw,650px);min-width:0;scroll-snap-align:start}.es-look{min-width:0}.es-look-top{display:flex;align-items:center;gap:16px;margin-bottom:14px;min-height:44px}.es-look-number{font-size:37px;letter-spacing:-.065em;line-height:1}.es-look-chapter{font:10px var(--mono,'JetBrains Mono Variable',monospace);text-transform:uppercase;letter-spacing:.08em}.es-save{margin-left:auto;background:none;border:1px solid #10213c55;padding:8px 15px;font-size:11px}.es-save[aria-pressed="true"]{background:var(--es-blue);color:var(--es-cream);border-color:var(--es-blue)}.es-look-figure{margin:0}.es-image-link{position:relative;display:block;text-decoration:none;background:#dcd9cf;overflow:hidden}.es-image-link img{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:cover}.es-enlarge-hint{position:absolute;right:13px;bottom:13px;padding:9px 12px;background:var(--es-cream);color:var(--es-ink);font:10px var(--mono,'JetBrains Mono Variable',monospace);border:1px solid #10213c33}.es-look-figure figcaption{display:flex;justify-content:space-between;gap:15px;font:9px/1.6 var(--mono,'JetBrains Mono Variable',monospace);padding:11px 0;border-bottom:1px solid #10213c44}.es-look-figure figcaption span:first-child{text-transform:uppercase}.es-view-controls,.es-static-views{display:flex;flex-wrap:wrap;gap:15px;margin:12px 0 25px}.es-view-controls button{border:0;border-bottom:1px solid transparent;background:none;padding:5px 0;font-size:11px;color:inherit}.es-view-controls button[aria-pressed="true"]{border-bottom-color:var(--es-blue);color:var(--es-blue)}.es-static-views a{font-size:10px;padding:9px 0}.is-enhanced .es-static-views{display:none}.es-look-copy h3{font-size:clamp(28px,3.8vw,55px);font-weight:500;line-height:1;letter-spacing:-.065em;margin:0 0 16px;max-width:17ch}.es-outfit{font-size:14px;line-height:1.75;margin:0 0 23px;max-width:54ch}.es-design-notes{margin:0}.es-design-notes>div{display:grid;grid-template-columns:110px 1fr;gap:15px;border-top:1px solid #10213c33;padding:12px 0}.es-design-notes dt{font:9px/1.8 var(--mono,'JetBrains Mono Variable',monospace);text-transform:uppercase;letter-spacing:.035em}.es-design-notes dd{font-size:12px;line-height:1.8;margin:0}.es-detail{font-size:12px;line-height:1.8;border-top:1px solid #10213c33;margin:0;padding-top:14px}.es-detail>span{font:9px var(--mono,'JetBrains Mono Variable',monospace);text-transform:uppercase}.es-proposal-note{font:9px/1.8 var(--mono,'JetBrains Mono Variable',monospace);margin:20px 0;max-width:66ch}.es-reference{border-left:2px solid var(--es-blue);padding-left:15px}.es-look[data-chapter="works"] .es-reference{border-color:#858f9c}.es-look[data-chapter="court"] .es-reference{border-color:var(--es-clay)}.es-reference>.es-eyebrow{font-size:8px;display:block}.es-reference>a{font-size:11px;display:inline-block;margin:7px 0}.es-reference>p{font-size:10px;line-height:1.8;margin:6px 0}.es-reference strong{font-weight:600}.es-footnote{font:9px/1.8 var(--mono,'JetBrains Mono Variable',monospace);max-width:100ch;margin:35px 0 0;border-top:1px solid #10213c44;padding-top:18px}
  .es-dialog{background:var(--es-cream);color:var(--es-ink);border:0;padding:20px;width:min(1000px,calc(100vw - 45px));max-width:none;max-height:calc(100dvh - 40px);box-sizing:border-box}.es-dialog:not([open]){display:none}.es-dialog::backdrop{background:#061426df;backdrop-filter:blur(4px)}.es-dialog-bar{display:flex;align-items:center;justify-content:space-between;gap:20px}.es-dialog-bar h3{font-size:20px;line-height:1.4;letter-spacing:-.04em;margin:0}.es-dialog-bar button,.es-dialog-tools button{background:none;border:1px solid #10213c44;color:inherit;font-size:11px;padding:8px 13px}.es-dialog-tools{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:15px 0}.es-dialog-tools>div{display:flex;gap:7px}.es-dialog-tools [aria-pressed="true"]{background:var(--es-ink);color:var(--es-cream)}.es-dialog-stage{max-height:65dvh;overflow:auto;background:#dbd9d1;overscroll-behavior:contain;scrollbar-color:var(--es-ink) #dbd9d1}.es-dialog-stage img{display:block;margin:auto;max-height:65dvh;max-width:100%;width:auto;height:auto;object-fit:contain}.es-dialog-stage.is-magnified img{max-height:none;max-width:none;width:150%;min-width:768px;height:auto;margin:0}.es-dialog-caption{font:10px/1.7 var(--mono,'JetBrains Mono Variable',monospace);margin:13px 0 0}
  @media(min-width:1600px){.is-enhanced .es-look{flex-basis:calc((100% - 60px)/3)}}
  @media(max-width:1000px){.es-heading-line{grid-template-columns:1.35fr 1fr;gap:30px}.es-opening{font-size:14px}.es-chapter-key{gap:22px}.es-chapter-key h3{font-size:25px}.es-color-chips{gap:3px}.es-color-chips i{width:10px;height:10px}.es-edit{padding:30px;gap:30px}.es-garment-label{margin-left:0}.es-track{grid-template-columns:repeat(2,minmax(0,1fr))}.is-enhanced .es-look{flex-basis:58vw}.es-design-notes>div{grid-template-columns:100px 1fr;gap:10px}}
  @media(max-width:600px){.es-collection{padding-top:50px;padding-bottom:50px}.es-heading-line{grid-template-columns:1fr;gap:25px;margin-top:24px}.es-heading h2{font-size:13.8vw}.es-opening{font-size:14px;max-width:39ch}.es-independent{font-size:9px;margin:24px 0 35px}.es-chapter-key{grid-template-columns:1fr;gap:20px;margin-bottom:35px}.es-chapter-key article{padding-top:12px}.es-chapter-key h3{font-size:27px}.es-chapter-key p{max-width:none;margin-top:9px}.es-color-chips i{width:14px;height:14px}.es-edit{grid-template-columns:1fr;margin:0 -8px 35px;padding:25px 22px;gap:12px}.es-edit h3{font-size:39px}.es-edit-intro>p:last-child{max-width:none}.es-edit-count{top:10px}.es-edit-empty{font-size:16px;margin-top:10px}.es-edit-actions{gap:7px}.es-edit-actions button{padding:8px 11px;font-size:10px}.es-filters{gap:15px;align-items:end}.es-chapter-filters{width:100%;gap:6px}.es-chapter-filters button{padding:8px 12px;font-size:10px}.es-garment-label{font-size:9px}.es-reset{margin-left:auto;font-size:10px}.es-gallery-meta{margin-top:15px}.es-gallery-help{font-size:9px;max-width:43ch}.es-track{grid-template-columns:1fr;gap:45px}.is-enhanced .es-track{gap:20px;margin-right:calc(-1 * var(--gutter,20px));padding-right:var(--gutter,20px);scroll-padding-right:var(--gutter,20px)}.is-enhanced .es-look{flex-basis:calc(100vw - 60px)}.es-look-copy h3{font-size:40px}.es-look-number{font-size:35px}.es-outfit{font-size:13px}.es-design-notes>div{grid-template-columns:98px 1fr}.es-design-notes dd{font-size:11px}.es-look-figure figcaption{font-size:8px}.es-proposal-note{font-size:8px}.es-reference>p{font-size:10px}.es-footnote{font-size:8px}.es-dialog{padding:15px;width:calc(100vw - 20px);max-height:calc(100dvh - 20px)}.es-dialog-bar h3{font-size:17px}.es-dialog-bar button,.es-dialog-tools button{font-size:10px;padding:8px 10px}.es-dialog-tools{gap:8px}.es-dialog-tools>div{gap:5px}.es-dialog-stage,.es-dialog-stage img{max-height:58dvh}.es-dialog-caption{font-size:9px}}
  @media(prefers-reduced-motion:reduce){.es-track,.es-dialog-stage{scroll-behavior:auto}.es-collection :global(*){animation:none!important;transition:none!important}}
</style>
