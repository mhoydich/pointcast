---
import { fullBookshelf as books, bookshelfSummary, bookshelfContext, bookshelfEras } from '../data/full-bookshelf';
import { readingMapThemes, readingMapProvenance } from '../data/reading-map';
const { heading = 'The whole shelf, within reach.' } = Astro.props;
const themeNames = new Map(readingMapThemes.map(theme => [theme.id, theme.label]));
const bookFor = (id: string) => books.find(book => book.id === id);
const themeFor = (id: string) => readingMapThemes.find(theme => theme.id === id)!;
const shortTitle = (title: string) => title.replace(/\s*\([^)]*#.*\)$/, '');
---
<section class="full-shelf" data-full-bookshelf aria-labelledby="full-shelf-title">
  <header class="full-heading"><div><p class="shelf-label">The complete snapshot / 87 books</p><h2 id="full-shelf-title">{heading}</h2><p class="shelf-intro">Open a book. Follow a question.<br />Find something you hadn’t connected yet.</p></div><a class="context-jump" href="#beyond-the-shelf">Explore beyond the shelf <span aria-hidden="true">↓</span></a></header>
  <div class="shelf-ledger" aria-label="Collection and source coverage"><p><strong>{books.length}</strong><span>verified titles</span></p><p><strong>{bookshelfSummary.companions}</strong><span>full companions</span></p><p><strong>{bookshelfSummary.sourceNotes}</strong><span>public context notes</span></p><p><strong>{bookshelfSummary.publicationYears}</strong><span>publication years sourced</span></p></div>
  <p class="shelf-provenance">Goodreads title snapshot · 2026-10-03. Presence on this shelf does not establish whether Mike read, finished or rated a book. The covers below are PointCast designs and existing original artwork.</p>

  <div class="full-controls" data-full-controls hidden>
    <div class="full-search"><label for="full-search">Find a title or author</label><div><input id="full-search" type="search" data-full-query autocomplete="off" placeholder="Try Tolkien, Hesse, money…" aria-controls="full-shelf-list"/><button type="button" data-full-reset disabled>Reset all</button></div></div>
    <div class="full-selects">
      <label>Theme<select data-full-theme aria-controls="full-shelf-list"><option value="all">Every theme</option>{readingMapThemes.map(theme => <option value={theme.id}>{theme.label} ({books.filter(book => book.theme === theme.id).length})</option>)}</select></label>
      <label>First publication<select data-full-era aria-controls="full-shelf-list">{bookshelfEras.map(era => <option value={era.id}>{era.label} ({era.id === 'all' ? books.length : books.filter(book => book.era === era.id).length})</option>)}</select></label>
      <label>Across the shelf<select data-full-angle aria-controls="full-shelf-list"><option value="all">Every connection</option>{bookshelfContext.angles.map(angle => <option value={angle.id}>{angle.label}</option>)}</select></label>
      <label>Explore<select data-full-scope aria-controls="full-shelf-list"><option value="all">All books</option><option value="companions">Full companions ({bookshelfSummary.companions})</option><option value="context">Public context notes ({bookshelfSummary.sourceNotes})</option></select></label>
    </div>
  </div>
  <p class="full-status" data-full-status role="status" aria-live="polite" aria-atomic="true">All {books.length} books shown. Expand any book for connections and source notes.</p>
  <noscript><p class="shelf-provenance">All 87 books are available below. Open their detail panels or use your browser’s find command to search.</p></noscript>
  <ol id="full-shelf-list" class="full-book-grid">
    {books.map((book, index) => <li id={`reading-${book.id}`} class={`full-book theme-${book.theme}`} data-full-record={book.id} data-full-search={`${book.title} ${book.author} ${themeNames.get(book.theme)}`} data-full-theme={book.theme} data-full-era={book.era} data-full-angles={book.angleIds.join(' ')} data-full-companion={String(Boolean(book.companion))} data-full-context={String(Boolean(book.signals.length))}>
      <details class="book-expansion">
        <summary><span class:list={['shelf-cover', { 'has-art': book.image }]} aria-hidden="true">{book.image && <img src={book.image} width="1536" height="1024" alt="" loading="lazy" decoding="async"/>}<span class="cover-top">PointCast / Reading collection</span><span class="cover-name">{shortTitle(book.title)}</span><span class="cover-author">{book.author}</span><span class="cover-bottom">{String(index + 1).padStart(2, '0')} <span>{book.companion ? 'A companion inside' : themeNames.get(book.theme)}</span></span></span><span class="book-caption"><span class="shelf-label">{themeNames.get(book.theme)}</span><h3>{book.title}</h3><span class="caption-author">{book.author}</span><span class="expand-label"><span class="closed-label">Expand book</span><span class="opened-label">Close book</span><span class="expand-symbol" aria-hidden="true">+</span></span></span></summary>
        <div class="expanded-book">
          <div class="book-about"><p class="shelf-label">A way into this book</p><h4>{book.note ? 'Begin here.' : themeFor(book.theme).question}</h4><p>{book.note || `${themeFor(book.theme).note} This is an editorial reading connection. We have verified this title and author in the supplied catalog snapshot; a detailed synopsis has not yet been researched here.`}</p>
            <dl class="book-facts"><div><dt>First publication</dt><dd>{book.publication ? <>{book.publication.year}<span>{book.publication.note}</span></> : 'Not verified in this collection'}</dd></div><div><dt>Mike’s rating</dt><dd>Not supplied in the snapshot</dd></div><div><dt>Public rating</dt><dd>No average or rating count collected</dd></div></dl>
            {book.publication && <p class="context-citation"><a href={book.publication.citationUrl || book.sources.find(source => source.id === book.publication.sourceId)?.url}>{book.publication.sourceLabel || 'Publication evidence'} <span aria-hidden="true">↗</span></a></p>}
            {book.companion && <a class="shelf-action" href={book.companion.href}>Open the full companion <span aria-hidden="true">↗</span></a>}
          </div>
          <div class="book-context"><p class="shelf-label">Public reception / Popularity & influence</p><h4>What the evidence can tell us.</h4>{book.signals.length ? <>{book.signals.map(signal => <article class="book-signal"><p class="signal-kind">{signal.label || signal.kind}</p><p>{signal.text}</p><p class="signal-limit">{signal.limit}</p><p class="context-citation">{signal.sourceIds.map((id, i) => <>{i > 0 && ' · '}<a href={book.sources.find(source => source.id === id)?.url}>{book.sources.find(source => source.id === id)?.label} <span aria-hidden="true">↗</span></a></>)}</p></article>)}<p class="context-checked">Sources checked {book.contextCheckedAt}.</p></> : <p>Public popularity has not been researched for this title here. Its Goodreads catalog record is a starting point; a listing alone is not evidence of sales, readership or a rising trend.</p>}</div>
          <div class="book-connections"><p class="shelf-label">Across the collection</p><h4>Keep a question moving.</h4>{book.angleIds.length ? <ul>{book.angleIds.map(id => {const angle = bookshelfContext.angles.find(item => item.id === id)!; return <li><a href={`#angle-${id}`}>{angle.label}</a><p>{angle.question}</p></li>})}</ul> : <p>Compare how this book approaches “{themeFor(book.theme).question}” with another title in {themeNames.get(book.theme)?.toLowerCase()}. This is a reading prompt, not a claim of influence.</p>}
            {book.relatedIds.length > 0 && <div class="same-author"><p class="shelf-label">Also cataloged by this author</p><ul>{book.relatedIds.map(id => <li><a href={`#reading-${id}`}>{bookFor(id)?.title}</a></li>)}</ul><p class="signal-limit">Catalog connections; editions and series order may differ.</p></div>}
          </div>
          <div class="book-copies"><p class="shelf-label">Find a copy / Check the edition</p><h4>{book.edition ? 'A sourced reading route.' : 'Start with the catalog.'}</h4>{book.edition && <><p>{book.edition.format} · {book.edition.publisher}<br />ISBN {book.edition.isbn || 'not verified'}</p><p>{book.edition.note}</p></>}
            <ul class="copy-links"><li><a href={book.bookUrl} rel="noopener noreferrer">Goodreads book record <span aria-hidden="true">↗</span></a></li>{book.routes.map(route => <li><a href={route.url} rel="noopener noreferrer">{route.label} <span aria-hidden="true">↗</span></a>{route.note && <p>{route.note}</p>}</li>)}{book.companion && !book.routes.length && <li><a href={`${book.companion.href}#editions`}>Compare translations, buy or borrow <span aria-hidden="true">↗</span></a></li>}</ul>
            <p class="signal-limit">{book.companion ? 'Check the complete companion for edition sources and more copy options. Sellers and libraries determine price, stock, condition, eligibility and waits.' : 'No edition, seller or library availability has been verified for this title here. Match author, title, format and ISBN before choosing a copy.'}</p>
          </div>
          <div class="book-permalink"><a href={`#reading-${book.id}`}>Link to this book</a><a href="#full-shelf-title">Back to shelf</a></div>
        </div>
      </details>
    </li>)}
  </ol>
  <p class="full-empty" data-full-empty hidden>No books match these filters. Reset all to reopen the whole shelf.</p>

  <section class="shelf-beyond" id="beyond-the-shelf" aria-labelledby="beyond-heading"><div class="full-heading"><div><p class="shelf-label">Beyond a single book</p><h2 id="beyond-heading">Different questions.<br />New neighbors.</h2></div><p>Reading paths are PointCast’s editorial comparisons. They do not establish direct influence between authors.</p></div>
    <div class="angle-grid">{bookshelfContext.angles.map(angle => <details id={`angle-${angle.id}`} class="shelf-angle"><summary><span><span class="shelf-label">{angle.label}</span><h3>{angle.question}</h3></span><span aria-hidden="true">+</span></summary><div><p>{angle.note}</p><ol>{angle.recordIds.map(id => <li><a href={`#reading-${id}`}>{bookFor(id)?.title}</a><span>{bookFor(id)?.author}</span></li>)}</ol><button type="button" data-full-choose-angle={angle.id} hidden>Show these books on the shelf <span aria-hidden="true">↑</span></button></div></details>)}</div>
  </section>
  <section class="shelf-evidence" aria-labelledby="evidence-heading"><div><p class="shelf-label">Reading trends / A measured view</p><h2 id="evidence-heading">A signal is a starting point.</h2><p>{bookshelfContext.coverageNote}</p></div><div class="evidence-grid">{bookshelfContext.trends.map(trend => <article><p class="shelf-label">{trend.label}</p><h3>{trend.title}</h3><p>{trend.text}</p><p class="signal-limit">{trend.limit}</p><p class="context-citation">{trend.sources.map((source, i) => <>{i > 0 && ' · '}<a href={source.url}>{source.label} <span aria-hidden="true">↗</span></a></>)}</p></article>)}</div></section>
  <footer class="shelf-footnote"><p>{readingMapProvenance}</p><p>Publication years are shown only where sourced. Unknown years stay visible. Public borrowing counts, awards and publisher claims measure different things; they are not combined into a popularity ranking. PointCast receives no commission from these copy links.</p><a href="/books/map.json">Collection, evidence and coverage as JSON <span aria-hidden="true">↗</span></a></footer>
</section>
<script>
  import { mountFullBookshelf } from '../lib/full-bookshelf-browser.mjs';
  const enhance = () => document.querySelectorAll<HTMLElement>('[data-full-bookshelf]').forEach(mountFullBookshelf);
  enhance(); document.addEventListener('astro:page-load', enhance);
</script>
<style>
  .full-shelf{--fs-ink:#263f39;--fs-muted:#52655b;--fs-paper:#f4f3eb;--fs-line:#b7c4b4;color:var(--fs-ink);font:400 1rem/1.6 var(--pc-font-sans,Arial,sans-serif);margin:50px 6% 0}.full-shelf *{box-sizing:border-box;min-width:0}.full-shelf :global([hidden]){display:none!important}.full-shelf a{color:inherit;text-underline-offset:.2em}.full-shelf :is(a,button,input,select,summary):focus-visible{outline:3px solid #925326;outline-offset:4px}.full-shelf :is(p,h2,h3,h4){margin:0}.shelf-label{display:block;font:400 .7rem/1.5 var(--pc-font-mono,monospace);text-transform:uppercase;letter-spacing:.05em}.full-heading{display:flex;align-items:end;justify-content:space-between;gap:30px}.full-heading h2,.shelf-evidence h2{font:400 clamp(2.3rem,4.4vw,4.1rem)/1.07 Georgia,serif;letter-spacing:-.045em;margin:15px 0 18px}.shelf-intro{color:var(--fs-muted);font-size:1.05rem}.context-jump{display:flex;align-items:center;justify-content:space-between;gap:22px;min-height:44px;padding-block:10px;border-bottom:1px solid var(--fs-line);font-size:.875rem}.shelf-ledger{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;border-block:1px solid var(--fs-line);margin:30px 0 16px;padding:20px 0}.shelf-ledger strong{display:block;font:400 2.5rem/1.1 Georgia,serif}.shelf-ledger span{display:block;font-size:.75rem;color:var(--fs-muted);margin-top:8px}.shelf-provenance{font-size:.8125rem;color:var(--fs-muted);max-width:90ch}.full-controls{margin-top:26px;border-block:1px solid var(--fs-line);padding:22px 0}.full-search{display:grid;grid-template-columns:1fr 2fr;gap:20px;align-items:center}.full-search>label{font-size:.9375rem}.full-search>div{display:flex;gap:12px}.full-search input{width:100%;min-height:48px;padding:10px 14px;border:1px solid var(--fs-line);background:#fffdf5;font:inherit;color:inherit;border-radius:0}.full-search button,.shelf-angle button{min-height:44px;padding:10px 15px;border:1px solid var(--fs-line);background:transparent;color:inherit;font:inherit;font-size:.8125rem;cursor:pointer}.full-search button{white-space:nowrap}.full-search button:disabled{opacity:.65;cursor:default}.full-selects{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:18px}.full-selects label{display:flex;flex-direction:column;gap:7px;font-size:.75rem;color:var(--fs-muted)}.full-selects select{width:100%;min-height:44px;padding:9px 6px;border:1px solid var(--fs-line);background:#fffdf5;color:var(--fs-ink);font:400 .875rem var(--pc-font-sans,Arial,sans-serif);border-radius:0}.full-status{font-size:.8125rem;color:var(--fs-muted);padding:18px 0 25px}
  .full-book-grid{padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:30px 24px;list-style:none;align-items:start}.full-book{--cover:#303b43;--cover-text:#f4ede0;scroll-margin-top:20px}.theme-power-money{--cover:#6a302d}.theme-imagined-worlds{--cover:#273b54}.theme-place-identity{--cover:#465e49}.theme-language-attention{--cover:#6b512a}.theme-memoir{--cover:#614258}.theme-ideas-systems{--cover:#245850}.theme-open-shelf{--cover:#4f5149}.book-expansion summary{display:block;list-style:none;cursor:pointer}.book-expansion summary::-webkit-details-marker{display:none}.shelf-cover{width:100%;position:relative;display:flex;flex-direction:column;justify-content:space-between;min-height:310px;aspect-ratio:2/3;padding:18px 16px 16px 21px;background:var(--cover);color:var(--cover-text);border-left:6px solid #0003;border-radius:2px 5px 5px 2px;box-shadow:3px 4px 0 #d5d5c8;overflow:hidden}.shelf-cover:after{content:'';position:absolute;inset:7px;border:1px solid #ffffff40;pointer-events:none}.shelf-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.22}.shelf-cover.has-art:before{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#0007,transparent 75%);z-index:1}.shelf-cover>span{position:relative;z-index:2}.cover-top{font:400 .56rem/1.5 var(--pc-font-mono,monospace);text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #ffffff50;padding-bottom:11px}.cover-name{font:400 clamp(1.25rem,1.75vw,1.7rem)/1.14 Georgia,serif;letter-spacing:-.025em;margin:18px 0;overflow-wrap:anywhere}.cover-author{font-size:.75rem;line-height:1.4;margin-top:auto}.cover-bottom{display:flex;gap:10px;justify-content:space-between;border-top:1px solid #ffffff50;padding-top:10px;margin-top:17px;font:400 .6rem/1.5 var(--pc-font-mono,monospace)}.cover-bottom>span{max-width:22ch;text-align:right}.book-caption{display:block;padding-top:19px}.book-caption .shelf-label{font-size:.6rem;color:var(--fs-muted)}.book-caption h3{font:400 1.15rem/1.3 Georgia,serif;margin:7px 0 9px;overflow-wrap:anywhere}.caption-author{display:block;font-size:.75rem;color:var(--fs-muted)}.expand-label{display:flex;justify-content:space-between;align-items:center;min-height:44px;border-block:1px solid var(--fs-line);margin-top:14px;font-size:.75rem}.expand-symbol{font-size:1.35rem}.opened-label{display:none}.book-expansion[open] .closed-label{display:none}.book-expansion[open] .opened-label{display:inline}.book-expansion[open] .expand-symbol{transform:rotate(45deg)}.full-book:has(>.book-expansion[open]){grid-column:1/-1;border:1px solid var(--fs-line);background:#faf9f2;padding:28px}.book-expansion[open]>summary{display:grid;grid-template-columns:125px 1fr;gap:26px;align-items:center}.book-expansion[open] .shelf-cover{aspect-ratio:auto;min-height:180px;height:auto;padding:14px 12px;border-left-width:4px}.book-expansion[open] .cover-name{font-size:1.05rem;margin:10px 0}.book-expansion[open] .cover-author{font-size:.65rem}.book-expansion[open] .cover-top{display:none}.book-expansion[open] .cover-bottom{font-size:.5rem;margin-top:12px}.book-expansion[open] .book-caption{padding:0}.book-expansion[open] .book-caption h3{font-size:clamp(1.6rem,3vw,2.6rem)}.book-expansion[open] .caption-author{font-size:.9rem}.book-expansion[open] .expand-label{max-width:210px}
  .expanded-book{display:grid;grid-template-columns:1fr 1fr;gap:30px 48px;margin-top:30px;border-top:1px solid var(--fs-line);padding-top:30px}.expanded-book h4{font:400 1.55rem/1.2 Georgia,serif;margin:10px 0 18px}.expanded-book p{font-size:.875rem;margin-bottom:13px}.expanded-book .shelf-label{font-size:.65rem}.book-facts{margin:22px 0 0}.book-facts>div{display:grid;grid-template-columns:130px 1fr;gap:14px;border-top:1px solid var(--fs-line);padding:12px 0;font-size:.8rem}.book-facts dt{color:var(--fs-muted)}.book-facts dd{margin:0}.book-facts dd span{display:block;font-size:.75rem;color:var(--fs-muted);margin-top:5px}.expanded-book .context-citation,.context-citation{font-size:.75rem;line-height:1.8}.context-citation a{overflow-wrap:anywhere}.context-citation a,.copy-links a{display:inline-block;padding:8px 0}.shelf-action{display:inline-flex;gap:30px;align-items:center;min-height:44px;padding:10px 0;border-bottom:1px solid var(--fs-ink);font-size:.875rem}.book-signal{border-top:1px solid var(--fs-line);padding:17px 0 6px}.book-signal .signal-kind{font:400 .65rem/1.6 var(--pc-font-mono,monospace);text-transform:uppercase}.expanded-book .signal-limit,.signal-limit{font-size:.75rem;color:var(--fs-muted)}.expanded-book .context-checked{font-size:.7rem;color:var(--fs-muted)}.book-connections ul{padding-left:18px;font-size:.9rem}.book-connections li>a{display:inline-block;padding:7px 0;min-height:36px}.book-connections li p{font-size:.8rem}.same-author{border-top:1px solid var(--fs-line);margin-top:25px;padding-top:20px}.copy-links{padding:0;list-style:none;margin:15px 0}.copy-links li{border-top:1px solid var(--fs-line)}.copy-links a{min-height:44px;font-size:.8rem}.copy-links p{font-size:.75rem;color:var(--fs-muted)}.book-permalink{grid-column:1/-1;display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--fs-line);padding-top:15px}.book-permalink a{min-height:44px;display:flex;align-items:center;font-size:.75rem}.full-empty{padding:30px;border:1px solid var(--fs-line);font-size:.9rem}
  .shelf-beyond{margin-top:70px;padding-top:40px;border-top:1px solid var(--fs-line);scroll-margin-top:20px}.shelf-beyond .full-heading>p{max-width:38ch;color:var(--fs-muted);font-size:.875rem}.angle-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px 32px;margin-top:25px}.shelf-angle{border:1px solid var(--fs-line);padding:25px;scroll-margin-top:20px}.shelf-angle summary{display:flex;align-items:start;justify-content:space-between;gap:20px;cursor:pointer;list-style:none}.shelf-angle summary::-webkit-details-marker{display:none}.shelf-angle h3{font:400 1.65rem/1.23 Georgia,serif;margin-top:13px}.shelf-angle summary>span:last-child{font-size:1.6rem}.shelf-angle[open] summary>span:last-child{transform:rotate(45deg)}.shelf-angle>div{margin-top:22px;font-size:.875rem}.shelf-angle ol{padding-left:22px}.shelf-angle li{margin-block:14px}.shelf-angle li a{display:block;min-height:32px;padding:4px 0}.shelf-angle li span{display:block;font-size:.75rem;color:var(--fs-muted)}.shelf-angle button{width:100%;text-align:left;margin-top:15px}.shelf-evidence{margin-top:50px;border-top:1px solid var(--fs-line);padding-top:40px}.shelf-evidence>div>p:last-child{max-width:85ch;font-size:.875rem;color:var(--fs-muted)}.evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:30px}.evidence-grid article{border-top:1px solid var(--fs-line);padding-top:20px}.evidence-grid h3{font:400 1.7rem/1.2 Georgia,serif;margin:13px 0 18px}.evidence-grid article>p:not(.shelf-label){margin-top:15px;font-size:.875rem}.evidence-grid article>p.signal-limit,.evidence-grid article>p.context-citation{font-size:.75rem}.shelf-footnote{display:grid;grid-template-columns:1fr 1fr;gap:15px 40px;border-top:1px solid var(--fs-line);margin-top:40px;padding:30px 0 40px;font-size:.75rem;color:var(--fs-muted)}.shelf-footnote a{grid-column:1/-1;display:inline-flex;min-height:44px;align-items:center;gap:20px}
