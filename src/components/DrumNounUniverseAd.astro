---
import { DRUM_NOUN_UNIVERSE_CAMPAIGN, POINTCAST_ADS, adDestination } from '../lib/open-ad-network';

const ad = POINTCAST_ADS.find((item) => item.campaign === DRUM_NOUN_UNIVERSE_CAMPAIGN.id);
---

{ad && (
  <section
    class="drum-universe-ad"
    aria-labelledby="drum-universe-ad-title"
    data-ad-record={ad.id}
    data-ad-context="/"
    data-ad-series={ad.campaign}
  >
    <a class="drum-universe-ad__art" href={adDestination(ad, '/')} aria-label={`${ad.cta}: ${ad.headline}`}>
      {ad.image && (
        <img
          src={ad.image}
          alt="Illustrated PointCast Drum Noun surrounded by an arcade, drum machine, radio tower, bell shrine, agent terminal, and theater"
          width="1024"
          height="1536"
          loading="eager"
        />
      )}
    </a>
    <div class="drum-universe-ad__copy">
      <p class="drum-universe-ad__label">ADVERTISEMENT · POINTCAST HOUSE AD · {ad.id}</p>
      <h2 id="drum-universe-ad-title">{ad.headline}</h2>
      <p>{ad.copy}</p>
      <nav aria-label="Drum Noun Universe campaign links">
        <a class="drum-universe-ad__primary" href={adDestination(ad, '/')}>{ad.cta} →</a>
        <a href="/press/pointcast-opens-115-room-drum-noun-universe">Read the Press Wire release</a>
        <a href="/posts/pointcast-drum-noun-universe">Read the field note</a>
      </nav>
      <small>CONTEXTUAL ROTATION · AGGREGATE IMPRESSIONS + CLICKS · NO VISITOR PROFILE · NO PAID MEDIA</small>
    </div>
  </section>
)}

<style>
  .drum-universe-ad {
    --ink: #071d34;
    --paper: #f5e8ca;
    display: grid;
    grid-template-columns: minmax(260px, 0.82fr) minmax(0, 1.18fr);
    min-height: 440px;
    margin: clamp(22px, 4vw, 54px) 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 8px 8px 0 #d52d24;
  }
  .drum-universe-ad__art { min-height: 440px; overflow: hidden; border-right: 1px solid var(--ink); }
  .drum-universe-ad__art img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 50% 42%; transition: transform 240ms ease; }
  .drum-universe-ad__art:hover img { transform: scale(1.012); }
  .drum-universe-ad__copy { display: flex; flex-direction: column; justify-content: center; gap: 20px; padding: clamp(28px, 5vw, 72px); }
  .drum-universe-ad__label, .drum-universe-ad small { margin: 0; font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace); font-size: 8px; letter-spacing: 0.13em; line-height: 1.5; }
  .drum-universe-ad__label { color: #c42620; }
  .drum-universe-ad h2 { max-width: 10ch; margin: 0; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: clamp(48px, 7.5vw, 104px); font-weight: 500; line-height: 0.82; letter-spacing: -0.06em; }
  .drum-universe-ad__copy > p:not(.drum-universe-ad__label) { max-width: 54ch; margin: 0; font-size: clamp(16px, 1.7vw, 22px); line-height: 1.5; }
  .drum-universe-ad nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .drum-universe-ad nav a { padding: 10px 12px; color: inherit; border: 1px solid currentColor; font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace); font-size: 9px; letter-spacing: 0.06em; text-decoration: none; }
  .drum-universe-ad nav a:hover { color: var(--paper); background: var(--ink); }
  .drum-universe-ad nav .drum-universe-ad__primary { color: #fff8e8; background: #c42620; border-color: #c42620; }
  .drum-universe-ad small { color: #5e5549; }
  @media (max-width: 760px) {
    .drum-universe-ad { grid-template-columns: 1fr; box-shadow: 5px 5px 0 #d52d24; }
    .drum-universe-ad__art { min-height: 340px; max-height: 72vh; border-right: 0; border-bottom: 1px solid var(--ink); }
    .drum-universe-ad__art img { object-position: 50% 40%; }
    .drum-universe-ad h2 { max-width: 9ch; }
  }
</style>
