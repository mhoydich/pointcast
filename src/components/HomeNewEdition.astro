        <a href="/super-follow">Build a Follow Shelf</a>
        <a href="/digital-pets/legacy">Read The Amber Seed</a>
        <a href="/digital-pets/counsel">My Pet Has Retained Counsel</a>
        <a href="/noticing">What I Keep Noticing</a>
        <a href="/noticing/how-to-calendar-a-life">How to Calendar a Life · Block 0539</a>
        <a href="/noticing/animal-crossing-gift-economy">Animal Crossing Gift Economy · Block 0523</a>
        <a href="/noticing/why-lacroix">Why LaCroix · Block 0519</a>
        <a href="/noticing/the-future-of-the-library">The Future of the Library · Block 0515</a>
        <a href="/25/magazine">Talkin’ Season · Issue 001</a>
        <a href="/25/magazine/sound-of-focus">Sound Desk 001 · 25 × Tone Bloom</a>
        <a href="/25/magazine/coaches-50">Coaches Desk 001 · The PointCast 50</a>
        <a href="/25">25 permanent team pages</a>
        <a href="/25/disagreements">Disagreement Index</a>
        <a href="/25/receipts">Receipt Book</a>
        <a href="/reviews/year-one" data-home-archive-feature="year-one">Year One · Block 0507</a>
        <a href="/noun-battler-annual">The Battle Record</a>
        <a href="/archive">Everything in the archive</a>
      </div>
    </details>
  </footer>
</section>

<style>
  .home-edition {
    --edition-ink: #11130f;
    --edition-paper: #fffef4;
    --edition-yellow: #b8ff58;
    --edition-pink: #ff88c2;
    --edition-blue: #99dcff;
    --edition-green: #92efb4;
    margin-top: 16px;
    border: 2px solid var(--edition-ink);
    color: var(--edition-ink);
    background: var(--edition-paper);
    overflow: hidden;
  }

  .home-edition a {
    color: inherit;
  }

  .home-edition__flag,
  .home-edition__signal-heading,
  .home-edition__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 11px 14px;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-edition__flag {
    border-bottom: 2px solid var(--edition-ink);
    background: #07100d;
    color: #b8ff58;
  }

  .home-edition__lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.72fr) minmax(320px, 0.78fr);
  }

  .home-edition__lead {
    display: grid;
    grid-template-columns: minmax(290px, 0.82fr) minmax(370px, 1.18fr);
    min-width: 0;
    border-right: 2px solid var(--edition-ink);
    text-decoration: none;
  }

  .home-edition__image {
    position: relative;
    min-width: 0;
    background: #07100d;
    overflow: hidden;
  }

  .home-edition__image img {
    width: 100%;
    height: 100%;
    min-height: 610px;
    object-fit: cover;
    object-position: center 53%;
    transition: filter 180ms ease, transform 400ms ease;
  }

  .home-edition__lead:hover .home-edition__image img,
  .home-edition__lead:focus-visible .home-edition__image img {
    filter: saturate(1.08);
    transform: scale(1.018);
  }

  .home-edition__image-stamp {
    position: absolute;
    top: 16px;
    left: 16px;
    display: grid;
    place-items: center;
    width: 76px;
    aspect-ratio: 1;
    border: 2px solid var(--edition-ink);
    border-radius: 50%;
    background: var(--edition-yellow);
    font-family: var(--pc-font-mono);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-7deg);
  }

  .home-edition__lead-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(24px, 3.5vw, 54px);
    border-left: 2px solid var(--edition-ink);
    background:
      linear-gradient(rgba(105, 230, 223, 0.1) 1px, transparent 1px),
      #07100d;
    background-size: 100% 22px;
    color: #e9f7eb;
  }

  .home-edition__kicker,
  .home-edition__facts,
  .home-edition__action,
  .home-edition__side-copy > span,
  .home-edition__side-copy > b {
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-edition__headline {
    display: block;
    margin-bottom: 0;
    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(54px, 6.4vw, 100px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.065em;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .home-edition__headline em {
    color: #b8ff58;
    font-family: Georgia, serif;
    font-size: 0.84em;
    font-weight: 600;
    text-transform: none;
  }

  .home-edition__dek {
    max-width: 42rem;
    margin-top: 28px;
    font-size: clamp(15px, 1.25vw, 19px);
    line-height: 1.48;
  }

  .home-edition__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 26px;
    padding-block: 14px;
    border-block: 1px solid #365647;
  }

  .home-edition__facts span {
    display: grid;
    gap: 2px;
  }

  .home-edition__facts b {
    font-size: 18px;
    color: #69e6df;
  }

  .home-edition__action {
    margin-top: 20px;
    color: #b8ff58;
  }

  .home-edition__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    min-width: 0;
  }

  .home-edition__side-card {
    display: grid;
    grid-template-columns: minmax(132px, 0.8fr) minmax(180px, 1.2fr);
    min-height: 305px;
    text-decoration: none;
  }

  .home-edition__side-card + .home-edition__side-card {
    border-top: 2px solid var(--edition-ink);
  }

  .home-edition__side-card--pass {
    background: #132923;
  }

  .home-edition a.home-edition__side-card--pass {
    color: #fffef4;
  }

  .home-edition__side-card--agents {
    background: var(--edition-yellow);
  }

  .home-edition__side-media {
    min-width: 0;
    border-right: 2px solid var(--edition-ink);
    overflow: hidden;
  }

  .home-edition__side-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .home-edition__side-card--pass .home-edition__side-media img {
    object-position: 57% center;
  }

  .home-edition__side-media--agent {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 12px;
    background: #07100d;
    color: #69e6df;
    font-family: var(--pc-font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-edition__side-media--agent b {
    margin-top: auto;
    color: #b8ff58;
    font-size: clamp(29px, 3.1vw, 46px);
    letter-spacing: -0.08em;
    line-height: 0.78;
  }

  .home-edition__side-card:hover .home-edition__side-media img,
  .home-edition__side-card:focus-visible .home-edition__side-media img {
    transform: scale(1.025);
  }

  .home-edition__side-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 20px;
  }

  .home-edition__side-copy strong {
    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(30px, 3.1vw, 49px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .home-edition__side-copy small {
    font-size: 12px;
    line-height: 1.4;
  }

  .home-edition__run {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-top: 2px solid var(--edition-ink);
  }

  .home-edition__run a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    min-height: 174px;
    padding: 14px 12px 12px;
    text-decoration: none;
  }

  .home-edition__run a + a {
    border-left: 1px solid var(--edition-ink);
  }

  .home-edition__run a:nth-child(4n + 1) { background: #fffef4; }
  .home-edition__run a:nth-child(4n + 2) { background: #dff8ea; }
  .home-edition__run a:nth-child(4n + 3) { background: #e7eeff; }
  .home-edition__run a:nth-child(4n + 4) { background: #fff0f5; }

  .home-edition__run a:hover,
  .home-edition__run a:focus-visible {
    background: var(--edition-yellow);
  }

  .home-edition__run-number,
  .home-edition__run-noun,
  .home-edition__run small,
  .home-edition__run b {
    font-family: var(--pc-font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .home-edition__run-number {
    color: #60625b;
  }

  .home-edition__run-noun {
    width: fit-content;
    padding: 3px 5px;
    border: 1px solid var(--edition-ink);
    background: white;
  }

  .home-edition__run strong {
    margin-top: auto;
    font-size: 14px;
    line-height: 1.05;
  }

  .home-edition__run small {
    color: #5a5e54;
  }

  .home-edition__run b {
    align-self: flex-end;
  }

  .home-edition__signal-heading {
    border-top: 2px solid var(--edition-ink);
    border-bottom: 1px solid var(--edition-ink);
    background: var(--edition-ink);
