<section class="home-edition" aria-labelledby="home-edition-title">
  <header class="home-edition__flag">
    <span>PointCast · Monday field paper</span>
    <span>Issue 0558 · El Segundo · August 3, 2026</span>
    <span>Access · work · play · belonging</span>
  </header>

  <div class="home-edition__lead-grid">
    <a class="home-edition__lead" href="/beach-commons/v18/passport">
      <span class="home-edition__image">
        <span class="home-edition__passport-art" aria-hidden="true">
          <span class="home-edition__passport-field">
            <span>25 PUBLIC DOORS</span>
            <b>○</b>
            <span>NO LOCATION TRAIL</span>
          </span>
          <img class="home-edition__passport-card home-edition__passport-card--one" src="/beach-commons/v18/passport/pins/pass-25-01.png" alt="" width="1000" height="1500" />
          <img class="home-edition__passport-card home-edition__passport-card--two" src="/beach-commons/v18/passport/pins/pass-25-18.png" alt="" width="1000" height="1500" loading="lazy" />
          <img class="home-edition__passport-card home-edition__passport-card--three" src="/beach-commons/v18/passport/pins/pass-25-34.png" alt="" width="1000" height="1500" loading="lazy" />
          <span class="home-edition__passport-seal">
            <b>PASS/25</b>
            <small>CHOOSE THE DOOR<br />CHANGE THE VIEW</small>
          </span>
        </span>
        <span class="home-edition__image-stamp">Field<br />0558</span>
      </span>
      <span class="home-edition__lead-copy home-edition__lead-copy--passport">
        <span class="home-edition__kicker">Beach Commons · Field Study 018.D · Block 0558</span>
        <h1 class="home-edition__headline" id="home-edition-title">
          Same park.<br /><em>Many worlds.</em>
        </h1>
        <span class="home-edition__dek">
          A manual outdoor passport for twenty-five public doors. Pick a lens, earn
          an honor-system stamp, make a tiny adventure, and leave no location trail.
        </span>
        <span class="home-edition__facts">
          <span><b>25</b> public doors</span>
          <span><b>06</b> ways of looking</span>
          <span><b>24</b> stamps</span>
        </span>
        <span class="home-edition__action">Choose a lens <b aria-hidden="true">↗</b></span>
      </span>
    </a>

    <div class="home-edition__side">
      <a class="home-edition__side-card home-edition__side-card--work" href="/worklife/uniforms">
        <span class="home-edition__side-media">
          <img
            src="/images/worklife/uniforms-cover.png"
            alt="WORK/LIFE Uniforms cover with a cobalt work jacket, chartreuse safety panel, and garment-label typography"
            width="1536"
            height="1536"
            loading="lazy"
          />
        </span>
        <span class="home-edition__side-copy">
          <span>WORK/LIFE · The Shift · Block 0556</span>
          <strong>The clothes have<br />clocked in.</strong>
          <small>Six garments, a local fitting room, and a consent-first OPEN TO WORK board.</small>
          <b>Read the shift ↗</b>
        </span>
      </a>

      <a class="home-edition__side-card home-edition__side-card--state" href="/25/magazine/california-football">
        <span class="home-edition__side-media">
          <img
            src="/images/pointcast-california-football/california-signal-field.webp"
            alt="Editorial collage of California landscapes, stadium lights, rail lines, and radio signals at blue hour"
            width="1920"
            height="1080"
            loading="lazy"
          />
        </span>
        <span class="home-edition__side-copy">
          <span>State Desk · 2026 field report · Block 0557</span>
          <strong>California football<br />is not dead.</strong>
          <small>Eight programs, five conferences, and one state waiting for a Saturday of its own.</small>
          <b>Read the state ↗</b>
        </span>
      </a>
    </div>
  </div>

  <nav class="home-edition__run" aria-label="The newest PointCast release run">
    {releaseRun.slice(0, 8).map((release, index) => (
      <a href={release.href}>
        <span class="home-edition__run-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="home-edition__run-noun">{release.noun}</span>
        <strong>{release.title}</strong>
        <small>{release.note}</small>
        <b>{release.id} ↗</b>
      </a>
    ))}
  </nav>

  <div class="home-edition__signal-heading">
    <span>Choose a noun. Follow the signal.</span>
    <span>Eight newest above · the complete archive stays open.</span>
  </div>

  <nav class="home-edition__doors" aria-label="Choose a PointCast signal">
    {signalDoors.map((door) => (
      <a class={`home-edition__door home-edition__door--${door.color}`} href={door.href}>
        <span class="home-edition__door-top">
          <b>{door.number}</b>
          <span>{door.noun}</span>
        </span>
        <strong>{door.title}</strong>
        <small>{door.note}</small>
        <span class="home-edition__door-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>

  <footer class="home-edition__footer">
    <details>
      <summary>
        <span>Open the deep shelf</span>
        <span>Permanent issues, rooms, books, playlists, and receipts ↘</span>
      </summary>
      <div class="home-edition__footer-links">
        <a href="/crystal-ball-pass">PointCast Play · Block 0550 · Crystal Ball Pass · Meet at the trailhead</a>
        <a href="/beach-commons/v16">The Billion Little New Yorkers · Block 0544</a>
        <a href="/wednesday">WEDNESDAY 9:34 · Publication + calendar</a>
        <a href="/wednesday/002">THE GOOD WORK · Block 0538</a>
        <a href="/playlists/wednesday-morning-uplift">Updraft 01 · Block 0537</a>
        <a href="/beach-commons/v14">The Hardpoint League · Block 0540</a>
        <a href="/beach-commons/v13">The Fermentation League · Block 0536</a>
        <a href="/listening-room">Listening room</a>
        <a href="/auth#spotify">Authorize Spotify</a>
        <a href="/super-follow">Build a Follow Shelf</a>
        <a href="/digital-pets/legacy">Read The Amber Seed</a>
        <a href="/digital-pets/counsel">My Pet Has Retained Counsel</a>
        <a href="/noticing">What I Keep Noticing</a>
        <a href="/noticing/how-to-calendar-a-life">How to Calendar a Life · Block 0539</a>
        <a href="/noticing/animal-crossing-gift-economy">Animal Crossing Gift Economy · Block 0523</a>
        <a href="/noticing/why-lacroix">Why LaCroix · Block 0519</a>
        <a href="/noticing/the-future-of-the-library">The Future of the Library · Block 0515</a>
        <a href="/25/magazine">Talkin’ Season · Issue 001</a>
        <a href="/25/magazine/sound-of-focus">Sound Desk 001 · 25 × Tone Bloom</a>
        <a href="/25/magazine/coaches-50">Coaches Desk 001 · The PointCast 50</a>
        <a href="/25">25 permanent team pages</a>
        <a href="/25/disagreements">Disagreement Index</a>
        <a href="/25/receipts">Receipt Book</a>
        <a href="/reviews/year-one" data-home-archive-feature="year-one">Year One · Block 0507</a>
        <a href="/noun-battler-annual">The Battle Record</a>
        <a href="/archive">Everything in the archive</a>
      </div>
    </details>
  </footer>
</section>

<style>
  .home-edition {
    --edition-ink: #11130f;
    --edition-paper: #fffef4;
    --edition-yellow: #b8ff58;
    --edition-pink: #ff88c2;
    --edition-blue: #99dcff;
    --edition-green: #92efb4;
    margin-top: 16px;
    border: 2px solid var(--edition-ink);
    color: var(--edition-ink);
    background: var(--edition-paper);
    overflow: hidden;
  }

  .home-edition a {
    color: inherit;
  }

  .home-edition__flag,
  .home-edition__signal-heading,
  .home-edition__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 11px 14px;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-edition__flag {
    border-bottom: 2px solid var(--edition-ink);
    background: #07100d;
    color: #b8ff58;
  }

  .home-edition__lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.72fr) minmax(320px, 0.78fr);
  }

  .home-edition__lead {
    display: grid;
    grid-template-columns: minmax(290px, 0.82fr) minmax(370px, 1.18fr);
    min-width: 0;
    border-right: 2px solid var(--edition-ink);
    text-decoration: none;
  }

  .home-edition__image {
    position: relative;
    min-width: 0;
    background: #07100d;
    overflow: hidden;
  }

  .home-edition__image img {
    width: 100%;
    height: 100%;
    min-height: 610px;
    object-fit: cover;
    object-position: center 53%;
    transition: filter 180ms ease, transform 400ms ease;
  }

  .home-edition__passport-art {
    position: absolute;
    inset: 0;
    min-height: 610px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 48%, transparent 0 25%, rgba(255, 255, 255, 0.18) 25.3% 25.7%, transparent 26%),
      linear-gradient(135deg, #d8e8e4 0 55%, #f2ad3d 55% 100%);
    color: #19323e;
    font-family: var(--pc-font-mono);
  }

  .home-edition__passport-art::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(25, 50, 62, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(25, 50, 62, 0.11) 1px, transparent 1px);
    background-size: 28px 28px;
    content: '';
    opacity: 0.46;
  }

  .home-edition__passport-field {
    position: absolute;
    display: grid;
    z-index: 1;
    top: 12%;
    left: 13%;
    width: 58%;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    opacity: 0.48;
    transform: rotate(-9deg);
  }

  .home-edition__passport-field span {
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .home-edition__passport-field b {
    font-family: Georgia, serif;
    font-size: clamp(54px, 6vw, 92px);
    font-style: italic;
  }

  .home-edition__image .home-edition__passport-card {
    position: absolute;
    z-index: 2;
    width: 42%;
    height: auto;
    min-height: 0;
    border: 2px solid #19323e;
    object-fit: contain;
    box-shadow: 10px 13px 0 rgba(19, 45, 57, 0.17);
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .home-edition__passport-card--one {
    left: 8%;
    bottom: -9%;
    transform: rotate(-9deg);
  }

  .home-edition__passport-card--two {
    z-index: 3 !important;
    left: 34%;
    bottom: -4%;
    transform: rotate(2deg);
  }

  .home-edition__passport-card--three {
    right: -8%;
    bottom: -12%;
    transform: rotate(11deg);
  }

  .home-edition__passport-seal {
    position: absolute;
    z-index: 5;
    right: 6%;
    top: 7%;
    display: grid;
    width: 132px;
    aspect-ratio: 1;
    place-items: center;
    align-content: center;
    gap: 7px;
    border: 3px solid #19323e;
    border-radius: 50%;
    background: #e85d3f;
    color: #fffef4;
    text-align: center;
    transform: rotate(8deg);
  }

  .home-edition__passport-seal::before {
    position: absolute;
    inset: 8px;
    border: 1px dashed currentColor;
    border-radius: 50%;
    content: '';
  }

  .home-edition__passport-seal b {
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: 27px;
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .home-edition__passport-seal small {
    font-size: 6px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .home-edition__lead:hover .home-edition__passport-card--one,
  .home-edition__lead:focus-visible .home-edition__passport-card--one {
    transform: translate(-5px, -9px) rotate(-11deg);
  }

  .home-edition__lead:hover .home-edition__passport-card--two,
  .home-edition__lead:focus-visible .home-edition__passport-card--two {
    transform: translateY(-14px) rotate(0deg);
  }

  .home-edition__lead:hover .home-edition__passport-card--three,
  .home-edition__lead:focus-visible .home-edition__passport-card--three {
    transform: translate(5px, -8px) rotate(13deg);
  }

  .home-edition__lead:hover .home-edition__image img,
  .home-edition__lead:focus-visible .home-edition__image img {
    filter: saturate(1.08);
    transform: scale(1.018);
  }

  .home-edition__image-stamp {
    position: absolute;
    top: 16px;
    left: 16px;
    display: grid;
    place-items: center;
    width: 76px;
    aspect-ratio: 1;
    border: 2px solid var(--edition-ink);
    border-radius: 50%;
    background: var(--edition-yellow);
    font-family: var(--pc-font-mono);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-7deg);
  }

  .home-edition__lead-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(24px, 3.5vw, 54px);
    border-left: 2px solid var(--edition-ink);
    background:
      linear-gradient(rgba(105, 230, 223, 0.1) 1px, transparent 1px),
      #07100d;
    background-size: 100% 22px;
    color: #e9f7eb;
  }

  .home-edition__lead-copy--passport {
    background:
      linear-gradient(rgba(255, 254, 244, 0.09) 1px, transparent 1px),
      #132d39;
    background-size: 100% 24px;
    color: #fffef4;
  }

  .home-edition__lead-copy--passport .home-edition__headline em,
  .home-edition__lead-copy--passport .home-edition__action {
    color: #f2ad3d;
  }

  .home-edition__lead-copy--passport .home-edition__facts {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .home-edition__lead-copy--passport .home-edition__facts b {
    color: #92efb4;
  }

  .home-edition__kicker,
  .home-edition__facts,
  .home-edition__action,
  .home-edition__side-copy > span,
  .home-edition__side-copy > b {
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-edition__headline {
    display: block;
    margin-bottom: 0;
    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(54px, 6.4vw, 100px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.065em;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .home-edition__headline em {
    color: #b8ff58;
    font-family: Georgia, serif;
    font-size: 0.84em;
    font-weight: 600;
    text-transform: none;
  }

  .home-edition__dek {
    max-width: 42rem;
    margin-top: 28px;
    font-size: clamp(15px, 1.25vw, 19px);
    line-height: 1.48;
  }

  .home-edition__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 26px;
    padding-block: 14px;
    border-block: 1px solid #365647;
  }

  .home-edition__facts span {
    display: grid;
    gap: 2px;
  }

  .home-edition__facts b {
    font-size: 18px;
    color: #69e6df;
  }

  .home-edition__action {
    margin-top: 20px;
    color: #b8ff58;
  }

  .home-edition__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    min-width: 0;
  }

  .home-edition__side-card {
    display: grid;
    grid-template-columns: minmax(132px, 0.8fr) minmax(180px, 1.2fr);
    min-height: 305px;
    text-decoration: none;
  }

  .home-edition__side-card + .home-edition__side-card {
    border-top: 2px solid var(--edition-ink);
  }

  .home-edition__side-card--work {
    background: #d7f51b;
  }

  .home-edition__side-card--state {
    background: #1e4075;
  }

  .home-edition a.home-edition__side-card--state {
    color: #fffef4;
  }

  .home-edition__side-media {
