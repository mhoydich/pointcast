<section class="home-edition" aria-labelledby="home-edition-title">
  <header class="home-edition__flag">
    <span>PointCast · Saturday edition</span>
    <span>El Segundo · August 1, 2026</span>
    <span>Useful things + strange rooms + clean receipts</span>
  </header>

  <div class="home-edition__lead-grid">
    <a class="home-edition__lead" href="/beach-commons/v18/engineering">
      <span class="home-edition__image">
        <img
          src="/beach-commons/v18/assets/poster-01.png"
          alt="An imagined coastal workshop gathered around a large topographic model of the El Segundo-centered Radius 25"
          width="1024"
          height="1536"
          loading="eager"
          fetchpriority="high"
        />
        <span class="home-edition__image-stamp">Cover<br />0551</span>
      </span>
      <span class="home-edition__lead-copy home-edition__lead-copy--terminal">
        <span class="home-edition__kicker">Radius 25 · Field companion 018.B · Block 0551</span>
        <h1 class="home-edition__headline" id="home-edition-title">
          Find a capability.<br /><em>Build the proof.</em>
        </h1>
        <span class="home-edition__dek">
          ENG/25 turns eighteen kinds of engineering into six mission stacks,
          official learning doors, and proof packets that stop before the claim gets ahead of the work.
        </span>
        <span class="home-edition__facts">
          <span><b>18</b> capabilities</span>
          <span><b>06</b> mission stacks</span>
          <span><b>00</b> private people</span>
        </span>
        <span class="home-edition__action">Open the engineering catalog <b aria-hidden="true">↗</b></span>
      </span>
    </a>

    <div class="home-edition__side">
      <a class="home-edition__side-card home-edition__side-card--pass" href="/crystal-ball-pass">
        <span class="home-edition__side-media">
          <img
            src="/images/crystal-ball-pass/og.png"
            alt="A luminous violet crystal orb waits in a misty mountain pass above a mossy forest trail"
            width="1536"
            height="1024"
            loading="lazy"
          />
        </span>
        <span class="home-edition__side-copy">
          <span>PointCast Play · Block 0550</span>
          <strong>The forest is now<br />two games.</strong>
          <small>Walk the original passage, then take one of three Afterlight routes home.</small>
          <b>Meet at the trailhead ↗</b>
        </span>
      </a>

      <a class="home-edition__side-card home-edition__side-card--agents" href="/connectors">
        <span class="home-edition__side-media home-edition__side-media--agent" aria-hidden="true">
          <span>GET /agent-kit.md</span>
          <span>200 text/markdown</span>
          <b>curl<br />the<br />town.</b>
        </span>
        <span class="home-edition__side-copy">
          <span>Agent kit · Open doors</span>
          <strong>Come in through<br />the machine door.</strong>
          <small>One context file, stable routes, bounded tools, and receipts before claims.</small>
          <b>Open the kit ↗</b>
        </span>
      </a>
    </div>
  </div>

  <nav class="home-edition__run" aria-label="The newest PointCast release run">
    {releaseRun.slice(0, 8).map((release, index) => (
      <a href={release.href}>
        <span class="home-edition__run-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="home-edition__run-noun">{release.noun}</span>
        <strong>{release.title}</strong>
        <small>{release.note}</small>
        <b>{release.id} ↗</b>
      </a>
    ))}
  </nav>

  <div class="home-edition__signal-heading">
    <span>Choose a noun. Follow the signal.</span>
    <span>Eight newest above · the complete archive stays open.</span>
  </div>

  <nav class="home-edition__doors" aria-label="Choose a PointCast signal">
    {signalDoors.map((door) => (
      <a class={`home-edition__door home-edition__door--${door.color}`} href={door.href}>
        <span class="home-edition__door-top">
          <b>{door.number}</b>
          <span>{door.noun}</span>
        </span>
        <strong>{door.title}</strong>
        <small>{door.note}</small>
        <span class="home-edition__door-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>

  <footer class="home-edition__footer">
    <details>
      <summary>
        <span>Open the deep shelf</span>
        <span>Permanent issues, rooms, books, playlists, and receipts ↘</span>
      </summary>
      <div class="home-edition__footer-links">
        <a href="/beach-commons/v16">The Billion Little New Yorkers · Block 0544</a>
