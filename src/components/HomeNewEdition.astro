    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(31px, 3.3vw, 53px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
