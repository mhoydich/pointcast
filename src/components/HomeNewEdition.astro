---
const releaseRun = [
  {
    id: '0532',
    noun: 'Water',
    title: 'Harbor Works',
    note: 'A useful marina',
    href: '/beach-commons/v12',
  },
  {
    id: '0531',
    noun: 'Relay',
    title: 'The Reach Line',
    note: 'Pacific zero',
    href: '/beach-commons/v11',
  },
  {
    id: '0530',
    noun: 'Season',
    title: "Talkin' Season",
    note: 'Issue 001',
    href: '/25/magazine',
  },
  {
    id: '0529',
    noun: 'Field',
    title: 'Alabama After Saban',
    note: 'The new tense',
    href: '/25/alabama-after-saban',
  },
  {
    id: '0528',
    noun: 'Tide',
    title: 'Tide Cabinet',
    note: 'Borrow attention',
    href: '/beach-commons/v10',
  },
  {
    id: '0527',
    noun: 'Song',
    title: 'The Song Yard',
    note: '35 programs',
    href: '/25/2029/song-yard',
  },
  {
    id: '0526',
    noun: 'Signal',
    title: 'Signal Shack',
    note: 'Radio by the sea',
    href: '/beach-commons/v9',
  },
  {
    id: '0523',
    noun: 'Gift',
    title: 'Animal Crossing',
    note: 'Issue 03',
    href: '/noticing/animal-crossing-gift-economy',
  },
];

const signalDoors = [
  {
    number: '01',
    noun: 'Read',
    title: 'Books + field notes',
    note: 'Digital animals, gift economies, football, law, and public-life studies.',
    href: '/digital-pets',
    color: 'yellow',
  },
  {
    number: '02',
    noun: 'Play',
    title: 'Rooms + instruments',
    note: 'Bells, drums, games, gardens, mascots, and small things that answer back.',
    href: '/win95-games',
    color: 'pink',
  },
  {
    number: '03',
    noun: 'Listen',
    title: 'Tone Bloom + Spotify',
    note: 'Ring the pocket garden or authorize a listening signal of your own.',
    href: '/reviews/tone-bloom',
    color: 'blue',
  },
  {
    number: '04',
    noun: 'Connect',
    title: 'Auth + Super Follow',
    note: 'Bring identity, sound, shops, objects, and chosen sources into one shelf.',
    href: '/auth',
    color: 'green',
  },
];
---

<section class="home-edition" aria-labelledby="home-edition-title">
  <header class="home-edition__flag">
    <span>PointCast · Current edition</span>
    <span>El Segundo · July 28, 2026</span>
    <span>Blocks 0523–0532</span>
  </header>

  <div class="home-edition__lead-grid">
    <a class="home-edition__lead" href="/beach-commons/v12">
      <span class="home-edition__image">
        <img
          src="/beach-commons/v12/assets/01-useful-marina.png"
          alt="A sunset marina imagined as a public repair yard, launch, workshop, and calm place to gather"
          width="1536"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="home-edition__image-stamp">New<br />0532</span>
      </span>
      <span class="home-edition__lead-copy">
        <span class="home-edition__kicker">Beach Commons V12 · Field Study 012</span>
        <span class="home-edition__headline" id="home-edition-title">
          Keep things<br /><em>afloat.</em>
        </span>
        <span class="home-edition__dek">
          A marina should not only store boats. Harbor Works imagines vessel triage,
          a hull library, clean-bilge service, public launches, harbor radio, and a
          sunset table where useful work becomes public contentment.
        </span>
        <span class="home-edition__facts">
          <span><b>08</b> harbor rooms</span>
          <span><b>05</b> vessel futures</span>
          <span><b>00</b> real boats assessed</span>
        </span>
        <span class="home-edition__action">Enter Harbor Works <b aria-hidden="true">↗</b></span>
      </span>
    </a>

    <div class="home-edition__side">
      <a class="home-edition__side-card home-edition__side-card--counsel" href="/digital-pets/counsel">
        <span class="home-edition__side-media">
          <img
            src="/images/digital-pets/counsel/campaign/pin-01.jpg"
            alt="An illustrated digital pet in a suit announcing that it has retained counsel"
            width="1000"
            height="1500"
            loading="lazy"
          />
        </span>
        <span class="home-edition__side-copy">
          <span>Book companion · New brief</span>
          <strong>My Pet Has<br />Retained Counsel</strong>
          <small>When the household device asks for representation, who gets to speak?</small>
          <b>Read the brief ↗</b>
        </span>
      </a>

      <a class="home-edition__side-card home-edition__side-card--season" href="/25/magazine">
        <span class="home-edition__side-media">
          <img
            src="/images/pointcast-2029/social-card.png"
            alt="PointCast 2029 college football field studies arranged as a bright editorial issue"
            width="1200"
            height="630"
            loading="lazy"
          />
        </span>
        <span class="home-edition__side-copy">
          <span>College Football · Issue 001</span>
          <strong>Talkin’<br />Season</strong>
          <small>The board is one department. The season is the magazine.</small>
          <b>Open the issue ↗</b>
        </span>
      </a>
    </div>
  </div>

  <nav class="home-edition__run" aria-label="The newest PointCast release run">
    {releaseRun.map((release, index) => (
      <a href={release.href}>
        <span class="home-edition__run-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="home-edition__run-noun">{release.noun}</span>
        <strong>{release.title}</strong>
        <small>{release.note}</small>
        <b>{release.id} ↗</b>
      </a>
    ))}
  </nav>

  <div class="home-edition__signal-heading">
    <span>Choose a noun. Follow the signal.</span>
    <span>Human-sized doors into a very large broadcast.</span>
  </div>

  <nav class="home-edition__doors" aria-label="Choose a PointCast signal">
    {signalDoors.map((door) => (
      <a class={`home-edition__door home-edition__door--${door.color}`} href={door.href}>
        <span class="home-edition__door-top">
          <b>{door.number}</b>
          <span>{door.noun}</span>
        </span>
        <strong>{door.title}</strong>
        <small>{door.note}</small>
        <span class="home-edition__door-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>

  <footer class="home-edition__footer">
    <a href="/listening-room">Listening room</a>
    <a href="/auth#spotify">Authorize Spotify</a>
    <a href="/super-follow">Build a Follow Shelf</a>
    <a href="/digital-pets/legacy">Read The Amber Seed</a>
    <a href="/noticing">What I Keep Noticing</a>
    <a href="/noticing/why-lacroix">Why LaCroix · Block 0519</a>
    <a href="/noticing/the-future-of-the-library">The Future of the Library · Block 0515</a>
    <a href="/25">25 permanent team pages</a>
    <a href="/25/disagreements">Disagreement Index</a>
    <a href="/25/receipts">Receipt Book</a>
    <a href="/reviews/year-one" data-home-archive-feature="year-one">Year One · Block 0507</a>
    <a href="/noun-battler-annual">The Battle Record</a>
    <a href="/archive">Everything in the archive</a>
  </footer>
</section>

<style>
  .home-edition {
    --edition-ink: #11130f;
    --edition-paper: #fffef4;
    --edition-yellow: #f4f33f;
    --edition-pink: #ff88c2;
    --edition-blue: #99dcff;
    --edition-green: #92efb4;
    margin-top: 16px;
    border: 2px solid var(--edition-ink);
    color: var(--edition-ink);
    background: var(--edition-paper);
    overflow: hidden;
  }

  .home-edition a {
    color: inherit;
  }

  .home-edition__flag,
  .home-edition__signal-heading,
  .home-edition__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 11px 14px;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-edition__flag {
    border-bottom: 2px solid var(--edition-ink);
    background: #2e53d4;
    color: white;
  }

  .home-edition__lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.72fr) minmax(320px, 0.78fr);
  }

  .home-edition__lead {
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(310px, 0.86fr);
    min-width: 0;
    border-right: 2px solid var(--edition-ink);
    text-decoration: none;
  }

  .home-edition__image {
    position: relative;
    min-width: 0;
    background: #d7ecff;
    overflow: hidden;
  }

  .home-edition__image img {
    width: 100%;
    height: 100%;
    min-height: 610px;
    object-fit: cover;
    transition: filter 180ms ease, transform 400ms ease;
  }

  .home-edition__lead:hover .home-edition__image img,
  .home-edition__lead:focus-visible .home-edition__image img {
    filter: saturate(1.08);
    transform: scale(1.018);
  }

  .home-edition__image-stamp {
    position: absolute;
    top: 16px;
    left: 16px;
    display: grid;
    place-items: center;
    width: 76px;
    aspect-ratio: 1;
    border: 2px solid var(--edition-ink);
    border-radius: 50%;
    background: var(--edition-yellow);
    font-family: var(--pc-font-mono);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-7deg);
  }

  .home-edition__lead-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(24px, 3.5vw, 54px);
    border-left: 2px solid var(--edition-ink);
    background:
      linear-gradient(rgba(17, 19, 15, 0.045) 1px, transparent 1px),
      var(--edition-yellow);
    background-size: 100% 22px;
  }

  .home-edition__kicker,
  .home-edition__facts,
  .home-edition__action,
  .home-edition__side-copy > span,
  .home-edition__side-copy > b {
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-edition__headline {
    display: block;
    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(54px, 6.4vw, 100px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.065em;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .home-edition__headline em {
    color: #2e53d4;
    font-family: Georgia, serif;
    font-size: 0.84em;
    font-weight: 600;
    text-transform: none;
  }

  .home-edition__dek {
    max-width: 42rem;
    margin-top: 28px;
    font-size: clamp(15px, 1.25vw, 19px);
    line-height: 1.48;
  }

  .home-edition__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 26px;
    padding-block: 14px;
    border-block: 1px solid var(--edition-ink);
  }

  .home-edition__facts span {
    display: grid;
    gap: 2px;
  }

  .home-edition__facts b {
    font-size: 18px;
  }

  .home-edition__action {
    margin-top: 20px;
  }

  .home-edition__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    min-width: 0;
  }

  .home-edition__side-card {
    display: grid;
    grid-template-columns: minmax(132px, 0.8fr) minmax(180px, 1.2fr);
    min-height: 305px;
    text-decoration: none;
  }

  .home-edition__side-card + .home-edition__side-card {
    border-top: 2px solid var(--edition-ink);
  }

  .home-edition__side-card--counsel {
    background: #fff2f7;
  }

  .home-edition__side-card--season {
    background: var(--edition-blue);
  }

  .home-edition__side-media {
    min-width: 0;
    border-right: 2px solid var(--edition-ink);
    overflow: hidden;
  }

  .home-edition__side-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .home-edition__side-card--counsel .home-edition__side-media img {
    object-position: center 31%;
  }

  .home-edition__side-card:hover .home-edition__side-media img,
  .home-edition__side-card:focus-visible .home-edition__side-media img {
    transform: scale(1.025);
  }

  .home-edition__side-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 20px;
  }

  .home-edition__side-copy strong {
    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(30px, 3.1vw, 49px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .home-edition__side-copy small {
    font-size: 12px;
    line-height: 1.4;
  }

  .home-edition__run {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-top: 2px solid var(--edition-ink);
  }

  .home-edition__run a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    min-height: 174px;
    padding: 14px 12px 12px;
    text-decoration: none;
  }

  .home-edition__run a + a {
    border-left: 1px solid var(--edition-ink);
  }

  .home-edition__run a:nth-child(4n + 1) { background: #fffef4; }
  .home-edition__run a:nth-child(4n + 2) { background: #dff8ea; }
  .home-edition__run a:nth-child(4n + 3) { background: #e7eeff; }
  .home-edition__run a:nth-child(4n + 4) { background: #fff0f5; }

  .home-edition__run a:hover,
  .home-edition__run a:focus-visible {
    background: var(--edition-yellow);
  }

  .home-edition__run-number,
  .home-edition__run-noun,
  .home-edition__run small,
  .home-edition__run b {
    font-family: var(--pc-font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .home-edition__run-number {
    color: #60625b;
  }

  .home-edition__run-noun {
    width: fit-content;
    padding: 3px 5px;
    border: 1px solid var(--edition-ink);
    background: white;
  }

  .home-edition__run strong {
    margin-top: auto;
    font-size: 14px;
    line-height: 1.05;
  }

  .home-edition__run small {
    color: #5a5e54;
  }

  .home-edition__run b {
    align-self: flex-end;
  }

  .home-edition__signal-heading {
    border-top: 2px solid var(--edition-ink);
    border-bottom: 1px solid var(--edition-ink);
    background: var(--edition-ink);
    color: white;
  }

  .home-edition__doors {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .home-edition__door {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 240px;
    padding: 20px;
    text-decoration: none;
  }

  .home-edition__door + .home-edition__door {
    border-left: 1px solid var(--edition-ink);
  }

  .home-edition__door--yellow { background: var(--edition-yellow); }
  .home-edition__door--pink { background: var(--edition-pink); }
  .home-edition__door--blue { background: var(--edition-blue); }
  .home-edition__door--green { background: var(--edition-green); }

  .home-edition__door-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-edition__door-top b {
    display: grid;
    place-items: center;
    width: 31px;
    aspect-ratio: 1;
    border: 1px solid var(--edition-ink);
    border-radius: 50%;
    background: white;
  }

  .home-edition__door > strong {
    max-width: 12ch;
    margin-top: auto;
    font-family: "Arial Narrow", "Inter Variable", sans-serif;
    font-size: clamp(31px, 3.3vw, 53px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .home-edition__door > small {
    max-width: 34ch;
    margin-top: 12px;
    font-size: 11px;
    line-height: 1.4;
  }

  .home-edition__door-arrow {
    position: absolute;
    right: 18px;
    bottom: 16px;
    font-size: 22px;
    transition: transform 160ms ease;
  }

  .home-edition__door:hover .home-edition__door-arrow,
  .home-edition__door:focus-visible .home-edition__door-arrow {
    transform: translate(4px, -4px);
  }

  .home-edition__footer {
    justify-content: flex-start;
    flex-wrap: wrap;
    border-top: 2px solid var(--edition-ink);
    background: white;
  }

  .home-edition__footer a {
    padding: 4px 0;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 1180px) {
    .home-edition__lead-grid {
      grid-template-columns: 1fr;
    }

    .home-edition__lead {
      border-right: 0;
    }

    .home-edition__side {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
      border-top: 2px solid var(--edition-ink);
    }

    .home-edition__side-card + .home-edition__side-card {
      border-top: 0;
      border-left: 2px solid var(--edition-ink);
    }

    .home-edition__run {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .home-edition__run a:nth-child(n + 5) {
      border-top: 1px solid var(--edition-ink);
    }

    .home-edition__run a:nth-child(5) {
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .home-edition__flag {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .home-edition__lead {
      grid-template-columns: 1fr;
    }

    .home-edition__image img {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .home-edition__lead-copy {
      min-height: 430px;
      border-top: 2px solid var(--edition-ink);
      border-left: 0;
    }

    .home-edition__headline {
      font-size: clamp(58px, 20vw, 82px);
    }

    .home-edition__side {
      grid-template-columns: 1fr;
    }

    .home-edition__side-card + .home-edition__side-card {
      border-top: 2px solid var(--edition-ink);
      border-left: 0;
    }

    .home-edition__side-card {
      min-height: 280px;
    }

    .home-edition__run {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-edition__run a {
      min-height: 154px;
      border-top: 1px solid var(--edition-ink);
    }

    .home-edition__run a:nth-child(odd) {
      border-left: 0;
    }

    .home-edition__signal-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .home-edition__doors {
      grid-template-columns: 1fr;
    }

    .home-edition__door {
      min-height: 210px;
    }

    .home-edition__door + .home-edition__door {
      border-top: 1px solid var(--edition-ink);
      border-left: 0;
    }

    .home-edition__door > strong {
      font-size: 44px;
    }
  }

  @media (max-width: 430px) {
    .home-edition__side-card {
      grid-template-columns: 0.78fr 1.22fr;
    }

    .home-edition__side-copy {
      padding: 14px;
    }

    .home-edition__side-copy strong {
      font-size: 29px;
    }

    .home-edition__facts {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-edition__image img,
    .home-edition__side-media img,
    .home-edition__door-arrow {
      transition: none;
    }
  }
</style>
