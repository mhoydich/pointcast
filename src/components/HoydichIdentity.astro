---
interface Props {
  variant: 'signature' | 'folio' | 'section' | 'colophon';
  number?: string;
  label?: string;
  datetime?: string;
  dateText?: string;
}

const { variant, number, label, datetime, dateText } = Astro.props;
---

{variant === 'signature' && <div class="hi-signature">
  <span class="hi-initials" aria-hidden="true">mh.</span>
  <div class="hi-person">MICHAEL HOYDICH<small>EL SEGUNDO, CALIFORNIA</small></div>
</div>}

{variant === 'folio' && <span class="hi-folio" aria-hidden="true">
  <span class="hi-initials">mh.</span>
  <span class="hi-folio-label">PROJECT<span>{number}</span></span>
</span>}

{variant === 'section' && <div class="hi-section hp-kicker">
  <span class="hi-initials" aria-hidden="true">mh.</span>
  <span>{number && `${number} / `}{label}</span>
  <span class="hi-rule" aria-hidden="true"></span>
</div>}

{variant === 'colophon' && <div class="hi-colophon">
  <span class="hi-initials" aria-hidden="true">mh.</span>
  <div><span class="hi-colophon-label">{label}</span><time datetime={datetime}>{dateText}</time></div>
</div>}

<style>
  .hi-initials{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.07em;line-height:.95;text-transform:none;color:var(--hp-ink,#242722)}
  .hi-signature{display:flex;gap:13px;align-items:center;font:500 10px/1.6 'JetBrains Mono Variable',monospace;letter-spacing:.04em}
  .hi-signature>.hi-initials{font-size:44px;padding-right:7px}
  .hi-person small{display:block;font-size:9px;color:var(--hp-muted,#62665c)}
  .hi-folio{display:inline-flex;gap:10px;align-items:center;padding:8px 10px;background:var(--hp-paper,#f1eee5);border:1px solid var(--hp-line,#c5c7b8)}
  .hi-folio>.hi-initials{font-size:31px}
  .hi-folio-label{font:500 10px/1.45 'JetBrains Mono Variable',monospace;letter-spacing:.05em;border-left:1px solid var(--hp-line,#c5c7b8);padding-left:10px;color:var(--hp-ink,#242722)}
  .hi-folio-label>span{display:block;font-size:11px;letter-spacing:0}
  .hi-section{display:flex;align-items:center;gap:12px;font:500 10px/1.5 'JetBrains Mono Variable',monospace;letter-spacing:.05em;color:var(--hp-ink,#242722);margin-bottom:20px}
  .hi-section>.hi-initials{font-size:23px;flex-shrink:0}
  .hi-section>span:nth-child(2){min-width:0}
  .hi-rule{height:1px;flex:1;min-width:24px;background:var(--hp-line,#c5c7b8)}
  .hi-colophon{display:inline-flex;align-items:center;gap:14px;max-width:100%;border-block:1px solid var(--hp-line,#c5c7b8);padding-block:13px}
  .hi-colophon>.hi-initials{font-size:35px;flex-shrink:0}
  .hi-colophon>div{min-width:0;border-left:1px solid var(--hp-line,#c5c7b8);padding-left:14px}
  .hi-colophon-label,.hi-colophon time{display:block;font:500 10px/1.7 'JetBrains Mono Variable',monospace;letter-spacing:.05em;color:var(--hp-ink,#242722)}
  .hi-colophon time{font-weight:400;letter-spacing:0;color:var(--hp-muted,#62665c)}
  @media(max-width:760px){.hi-signature{gap:8px;font-size:8px}.hi-signature>.hi-initials{font-size:36px}.hi-person small{font-size:7px}}
</style>
