---
/**
 * KennelTodayLive — repaint this page with the sitting that is live *now*.
 *
 * Drop this on any prerendered surface that shows today's Kennel Club dog.
 * The markup Astro builds stays as the no-JS fallback; on load this reads
 * /api/kennel-club/today (a Pages Function, decided at request time) and
 * writes the real plate, name, token id, and calendar ring over it.
 *
 * Astro hoists and bundles this script once per page no matter how many times
 * the component appears, and the module re-runs its work on every
 * astro:page-load, so ClientRouter navigations stay correct.
 */
---

<script>
  import { mountKennelToday } from '../lib/kennel-today-client';
  mountKennelToday();
</script>
