---
/**
 * ConcertCallStrip — homepage call to the autonomous Nouns concert.
 *
 * Mike 2026-05-07: "just publish." Tiny strip directing visitors to the
 * three new autonomous drum pages. Single line, brass on velvet,
 * matches the wing pulse strips' geometry but advertises a concert
 * instead of presence.
 *
 * Sister to ChamberMega + WingPulseModule etc. but distinct: the
 * chamber strips report state; this strip just calls visitors to
 * a thing they can hit play on.
 */
---

<section class="ccs" id="ccs-root" aria-label="The Nouns Concert — autonomous drum pages">
  <a class="ccs__pill" href="/drum-nouns-concert">
    <span class="ccs__note" aria-hidden="true">♫</span>
    <span class="ccs__label">NOUNS CONCERT</span>
    <span class="ccs__sep">·</span>
    <span class="ccs__copy">5 nouns · 5 instruments · 90 BPM · loops forever</span>
    <span class="ccs__cta">listen →</span>
  </a>
  <nav class="ccs__alts" aria-label="Other autonomous drum pages">
    <a href="/drum-solo-jam">solo jam</a>
    <span aria-hidden="true">·</span>
    <a href="/drum-ambient-noun">ambient</a>
  </nav>
</section>

<style>
  .ccs {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    margin: 6px 0;
    flex-wrap: wrap;

    --ccs-velvet: #1a0820;
    --ccs-brass: #d4a437;
    --ccs-brass-deep: #6b4d12;
    --ccs-flame: #f6c15e;
    --ccs-cream: #f4e7c8;
  }
  .ccs__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border: 1.5px solid var(--ccs-brass-deep);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, Menlo, monospace);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ccs-cream);
    background: linear-gradient(180deg, rgba(26, 8, 32, 0.95) 0%, rgba(12, 4, 16, 0.95) 100%);
    transition: transform 120ms, border-color 200ms, box-shadow 200ms;
    box-shadow: 0 4px 16px rgba(212, 164, 55, 0.16);
  }
  .ccs__pill:hover {
    transform: translateY(-1px);
    border-color: var(--ccs-brass);
    box-shadow: 0 6px 22px rgba(212, 164, 55, 0.30);
    text-decoration: none;
  }
  .ccs__note {
    color: var(--ccs-flame);
    font-size: 14px;
    line-height: 1;
    text-shadow: 0 0 10px rgba(246, 193, 94, 0.65);
    animation: ccs-bob 1.6s ease-in-out infinite;
  }
  @keyframes ccs-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-2px); }
  }
  .ccs__label { color: var(--ccs-brass); font-weight: 800; letter-spacing: 0.30em; }
  .ccs__sep { color: var(--ccs-brass-deep); }
  .ccs__copy { color: var(--ccs-cream); font-weight: 600; opacity: 0.82; text-transform: none; letter-spacing: 0.04em; font-size: 11px; }
  .ccs__cta { color: var(--ccs-flame); font-weight: 700; margin-left: 4px; }

  .ccs__alts {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    color: rgba(212, 164, 55, 0.6);
  }
  .ccs__alts a { color: var(--ccs-brass); text-decoration: none; }
  .ccs__alts a:hover { color: var(--ccs-flame); text-decoration: underline; }

  @media (max-width: 720px) {
    .ccs__pill { font-size: 11px; padding: 7px 14px; gap: 8px; }
    .ccs__copy { display: none; }
  }
</style>
