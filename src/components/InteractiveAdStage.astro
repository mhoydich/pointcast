---
import type { PointCastAd } from '../lib/open-ad-network';

interface Props {
  ad: PointCastAd;
  index?: number;
}

const { ad, index = 0 } = Astro.props;
const tone = {
  signal: ['#7dd8ff', '#122a8a', '#070b23'],
  garden: ['#c9ff73', '#17785b', '#071e19'],
  play: ['#ffcf4a', '#df315f', '#250717'],
  ritual: ['#f1b6ff', '#6e39bd', '#160923'],
  network: ['#c8ff2f', '#2857ff', '#060c31'],
  field: ['#ffdc7c', '#b44c1d', '#261007'],
}[ad.tone];
const style = `--stage-accent:${tone[0]};--stage-mid:${tone[1]};--stage-deep:${tone[2]};--stage-order:${index};`;
---

<article class="interactive-ad" data-interactive-ad style={style}>
  <div class="interactive-ad__scene">
    <div class="interactive-ad__back" aria-hidden="true"></div>
    <div class="interactive-ad__middle" aria-hidden="true"></div>
    <a
      class="interactive-ad__card"
      href={ad.href}
      data-ad-record={ad.id}
      aria-label={`${ad.headline} — ${ad.cta}`}
    >
      {ad.image && (
        <span class="interactive-ad__image" aria-hidden="true">
          <img src={ad.image} alt="" width="1312" height="736" loading="lazy" decoding="async" />
        </span>
      )}
      <span class="interactive-ad__glint" aria-hidden="true"></span>
      <span class="interactive-ad__topline mono">INTERACTIVE HOUSE AD · {ad.id}</span>
      <span class="interactive-ad__number mono" aria-hidden="true">0{index + 1}</span>
      <strong>{ad.headline}</strong>
      <span class="interactive-ad__copy">{ad.copy}</span>
      <span class="interactive-ad__cta mono">{ad.cta} <i aria-hidden="true">↗</i></span>
    </a>
  </div>
  <p class="interactive-ad__hint mono">MOVE POINTER / ARROW KEYS TO TILT · ENTER TO OPEN</p>
</article>

<style>
  .interactive-ad {
    --stage-rx: 0deg;
    --stage-ry: 0deg;
    --stage-mx: 50%;
    --stage-my: 50%;
    min-width: 0;
    color: #f9f7ef;
  }
  .interactive-ad__scene {
    position: relative;
    min-height: clamp(410px, 42vw, 620px);
    perspective: 1200px;
    isolation: isolate;
  }
  .interactive-ad__back,
  .interactive-ad__middle,
  .interactive-ad__card {
    position: absolute;
    border-radius: clamp(22px, 3vw, 38px);
    transform-style: preserve-3d;
  }
  .interactive-ad__back {
    inset: 9% 7% 1%;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--stage-accent) 58%, transparent), transparent 55%),
      var(--stage-deep);
    border: 1px solid color-mix(in srgb, var(--stage-accent) 35%, transparent);
    box-shadow: 0 50px 90px color-mix(in srgb, var(--stage-deep) 78%, transparent);
    transform: rotateX(calc(var(--stage-rx) * .35)) rotateY(calc(var(--stage-ry) * .35)) translateZ(-90px) translateY(36px);
    transition: transform 500ms cubic-bezier(.2,.8,.2,1);
  }
  .interactive-ad__middle {
    inset: 5% 3% 5%;
    background: linear-gradient(145deg, color-mix(in srgb, var(--stage-mid) 55%, #08080b), var(--stage-deep));
    border: 1px solid color-mix(in srgb, var(--stage-accent) 48%, transparent);
    box-shadow: inset 0 1px color-mix(in srgb, #fff 30%, transparent);
    transform: rotateX(calc(var(--stage-rx) * .68)) rotateY(calc(var(--stage-ry) * .68)) translateZ(-45px) translateY(18px);
    transition: transform 420ms cubic-bezier(.2,.8,.2,1);
  }
  .interactive-ad__card {
    inset: 0 0 8%;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(230px, .65fr);
    grid-template-rows: auto 1fr auto;
    gap: 18px clamp(22px, 4vw, 54px);
    align-items: end;
    overflow: hidden;
    padding: clamp(24px, 4vw, 48px);
    color: inherit;
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--stage-deep) 90%, transparent) 7%, color-mix(in srgb, var(--stage-mid) 74%, transparent) 100%);
    border: 1px solid color-mix(in srgb, var(--stage-accent) 70%, #fff);
    box-shadow:
      inset 0 1px color-mix(in srgb, #fff 45%, transparent),
      0 30px 80px color-mix(in srgb, var(--stage-deep) 68%, transparent);
    text-decoration: none;
    transform: rotateX(var(--stage-rx)) rotateY(var(--stage-ry)) translateZ(0);
    transition: transform 260ms cubic-bezier(.2,.8,.2,1), box-shadow 260ms ease;
    will-change: transform;
  }
  .interactive-ad__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--stage-deep) 92%, transparent) 0 42%, transparent 76%),
      linear-gradient(0deg, color-mix(in srgb, var(--stage-deep) 90%, transparent), transparent 64%);
    pointer-events: none;
  }
  .interactive-ad__card:focus-visible {
    outline: 4px solid var(--stage-accent);
    outline-offset: 7px;
  }
  .interactive-ad__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    border-radius: inherit;
    transform: translateZ(-2px) scale(1.04);
  }
  .interactive-ad__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(1.12) contrast(1.08);
  }
  .interactive-ad__glint {
    position: absolute;
    inset: -1px;
    z-index: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--stage-mx) var(--stage-my), color-mix(in srgb, var(--stage-accent) 34%, transparent), transparent 30%);
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .interactive-ad__topline,
  .interactive-ad__number,
  .interactive-ad__card strong,
  .interactive-ad__copy,
  .interactive-ad__cta {
    position: relative;
    z-index: 1;
    transform: translateZ(54px);
  }
  .interactive-ad__topline {
    align-self: start;
    color: var(--stage-accent);
    font-size: 8px;
    letter-spacing: .15em;
  }
  .interactive-ad__number {
    align-self: start;
    justify-self: end;
    color: color-mix(in srgb, var(--stage-accent) 75%, #fff);
    font-size: clamp(38px, 7vw, 86px);
    line-height: .75;
    letter-spacing: -.1em;
    opacity: .68;
    transform: translateZ(92px);
  }
  .interactive-ad__card strong {
    align-self: end;
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(42px, 7vw, 88px);
    font-weight: 400;
    line-height: .84;
    letter-spacing: -.06em;
    text-wrap: balance;
    text-shadow: 0 4px 28px var(--stage-deep);
  }
  .interactive-ad__copy {
    max-width: 42ch;
    align-self: end;
    color: color-mix(in srgb, #fff 82%, var(--stage-accent));
    font: 500 clamp(12px, 1.45vw, 16px)/1.48 system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    text-shadow: 0 2px 14px var(--stage-deep);
    transform: translateZ(72px);
  }
  .interactive-ad__cta {
    grid-column: 1 / -1;
    width: max-content;
    padding: 10px 13px;
    color: var(--stage-deep);
    background: var(--stage-accent);
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .11em;
    box-shadow: 0 8px 28px color-mix(in srgb, var(--stage-deep) 45%, transparent);
    transform: translateZ(108px);
  }
  .interactive-ad__cta i { font-style: normal; }
  .interactive-ad__hint {
    margin: 10px 8px 0;
    color: #8c8994;
    font-size: 7px;
    letter-spacing: .11em;
    text-align: center;
  }
  @media (hover: hover) and (pointer: fine) {
    .interactive-ad__card:hover {
      box-shadow:
        inset 0 1px color-mix(in srgb, #fff 50%, transparent),
        0 44px 100px color-mix(in srgb, var(--stage-deep) 76%, transparent);
    }
  }
  @media (max-width: 700px) {
    .interactive-ad__scene { min-height: 500px; }
    .interactive-ad__card {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto 1fr auto auto;
      gap: 16px;
    }
    .interactive-ad__card strong { grid-column: 1 / -1; }
    .interactive-ad__copy { grid-column: 1 / -1; }
    .interactive-ad__number { font-size: 42px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .interactive-ad__back,
    .interactive-ad__middle,
    .interactive-ad__card {
      transition: none;
      transform: none;
    }
    .interactive-ad__hint { display: none; }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const precisePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-interactive-ad]').forEach((stage) => {
    if (stage.dataset.interactiveReady === 'true') return;
    stage.dataset.interactiveReady = 'true';
    const card = stage.querySelector<HTMLAnchorElement>('.interactive-ad__card');
    if (!card) return;

    let rx = 0;
    let ry = 0;
    const paint = () => {
      stage.style.setProperty('--stage-rx', `${rx}deg`);
      stage.style.setProperty('--stage-ry', `${ry}deg`);
    };
    const reset = () => {
      rx = 0;
      ry = 0;
      stage.style.setProperty('--stage-mx', '50%');
      stage.style.setProperty('--stage-my', '50%');
      paint();
    };

    if (precisePointer.matches && !reducedMotion.matches) {
      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
        const y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
        rx = (0.5 - y) * 12;
        ry = (x - 0.5) * 15;
        stage.style.setProperty('--stage-mx', `${x * 100}%`);
        stage.style.setProperty('--stage-my', `${y * 100}%`);
        paint();
      });
      card.addEventListener('pointerleave', reset);
    }

    card.addEventListener('keydown', (event) => {
      if (reducedMotion.matches || !['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'ArrowUp') rx = Math.min(8, rx + 2);
      if (event.key === 'ArrowDown') rx = Math.max(-8, rx - 2);
      if (event.key === 'ArrowLeft') ry = Math.max(-10, ry - 2);
      if (event.key === 'ArrowRight') ry = Math.min(10, ry + 2);
      paint();
    });
    card.addEventListener('blur', reset);
    reducedMotion.addEventListener('change', reset);
  });
</script>
