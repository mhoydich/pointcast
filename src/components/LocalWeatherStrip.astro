---
/**
 * LocalWeatherStrip — El Segundo glance weather for the homepage.
 *
 * Engagement plan §2.2 "Weather + Conditions":
 *   "Current temp, conditions, wind. Add: sunrise/sunset times.
 *    Add: UV index (beach town matters). Add: air quality (LAX
 *    proximity)."
 *
 * Hits Open-Meteo for current + UV + sunrise/sunset, and Open-Meteo's
 * air-quality endpoint for US AQI. Both are no-auth, browser-fetchable.
 *
 *   forecast:    https://api.open-meteo.com/v1/forecast
 *   airquality:  https://air-quality-api.open-meteo.com/v1/air-quality
 *
 * Cache: 30min sessionStorage TTL. Refreshes on astro:page-load and on
 * tab-visibility change.
 *
 * Color severity:
 *   UV 0-2 low (green) · 3-5 mod (yellow) · 6-7 high (orange) · 8-10 v.high (red) · 11+ extreme (purple)
 *   AQI 0-50 good · 51-100 moderate · 101-150 USG · 151-200 unhealthy · 201-300 very unhealthy · 301+ hazardous
 */

const LAT = 33.9192;
const LON = -118.4165;
const ZIP = '90245';
const CITY = 'El Segundo';
---

<aside class="lws" aria-label="El Segundo weather glance" data-lws-lat={LAT} data-lws-lon={LON}>
  <header class="lws__head">
    <p class="lws__kicker mono">{CITY.toUpperCase()} · NOW · {ZIP}</p>
    <span class="lws__updated mono" data-lws-updated hidden></span>
  </header>

  <ol class="lws__cells">
    <li class="lws__cell lws__cell--temp">
      <span class="lws__label mono">TEMP</span>
      <span class="lws__big" data-lws-temp>—</span>
      <span class="lws__sub mono" data-lws-feels>feels —</span>
      <span class="lws__cond" data-lws-cond>reading the sky…</span>
    </li>
    <li class="lws__cell lws__cell--uv" data-lws-uv-tone="idle">
      <span class="lws__label mono">UV</span>
      <span class="lws__big" data-lws-uv>—</span>
      <span class="lws__sub mono" data-lws-uv-tag>—</span>
    </li>
    <li class="lws__cell lws__cell--aqi" data-lws-aqi-tone="idle">
      <span class="lws__label mono">AQI</span>
      <span class="lws__big" data-lws-aqi>—</span>
      <span class="lws__sub mono" data-lws-aqi-tag>—</span>
    </li>
    <li class="lws__cell lws__cell--sun">
      <span class="lws__label mono">SUN</span>
      <span class="lws__line mono"><span aria-hidden="true">↑</span> <span data-lws-sunrise>—</span></span>
      <span class="lws__line mono"><span aria-hidden="true">↓</span> <span data-lws-sunset>—</span></span>
    </li>
    <li class="lws__cell lws__cell--wind">
      <span class="lws__label mono">WIND</span>
      <span class="lws__big lws__big--small" data-lws-wind>—</span>
      <span class="lws__sub mono" data-lws-humidity>humidity —</span>
    </li>
  </ol>
</aside>

<script is:inline>
(function () {
  'use strict';
  var root = document.querySelector('aside.lws');
  if (!root) return;
  var lat = root.dataset.lwsLat;
  var lon = root.dataset.lwsLon;
  if (!lat || !lon) return;

  var FORECAST_KEY = 'pc:lws:forecast:v1';
  var AQI_KEY = 'pc:lws:aqi:v1';
  var TTL_MS = 30 * 60 * 1000;

  function readCache(k) {
    try {
      var raw = sessionStorage.getItem(k);
      if (!raw) return null;
      var p = JSON.parse(raw);
      if (!p || !p.at || (Date.now() - p.at) > TTL_MS) return null;
      return p.data;
    } catch (e) { return null; }
  }
  function writeCache(k, d) {
    try { sessionStorage.setItem(k, JSON.stringify({ at: Date.now(), data: d })); } catch (e) {}
  }

  function set(sel, val) {
    var el = root.querySelector(sel);
    if (el) el.textContent = val;
  }
  function setTone(cellSel, attr, value) {
    var el = root.querySelector(cellSel);
    if (el) el.setAttribute(attr, value);
  }

  function codeToCondition(code) {
    if (code === 0) return 'Clear';
    if (code === 1) return 'Mainly clear';
    if (code === 2) return 'Partly cloudy';
    if (code === 3) return 'Overcast';
    if (code >= 45 && code <= 48) return 'Marine layer';
    if (code >= 51 && code <= 57) return 'Drizzle';
    if (code >= 61 && code <= 67) return 'Rain';
    if (code >= 71 && code <= 77) return 'Snow';
    if (code >= 80 && code <= 82) return 'Showers';
    if (code >= 95 && code <= 99) return 'Thunder';
    return '—';
  }

  function windDir(deg) {
    var dirs = ['N','NE','E','SE','S','SW','W','NW'];
    return dirs[Math.round(((deg % 360) / 45)) % 8];
  }

  function uvTone(uv) {
    if (uv < 3) return { tone: 'low', tag: 'low' };
    if (uv < 6) return { tone: 'mod', tag: 'moderate' };
    if (uv < 8) return { tone: 'high', tag: 'high' };
    if (uv < 11) return { tone: 'vhigh', tag: 'very high' };
    return { tone: 'extreme', tag: 'extreme' };
  }

  function aqiTone(a) {
    if (a == null || isNaN(a)) return { tone: 'idle', tag: '—' };
    if (a <= 50) return { tone: 'good', tag: 'good' };
    if (a <= 100) return { tone: 'mod', tag: 'moderate' };
    if (a <= 150) return { tone: 'high', tag: 'sensitive' };
    if (a <= 200) return { tone: 'unhealthy', tag: 'unhealthy' };
    if (a <= 300) return { tone: 'vunhealthy', tag: 'very unhealthy' };
    return { tone: 'hazardous', tag: 'hazardous' };
  }

  function fmtClock(iso) {
    if (!iso) return '—';
    try {
      var d = new Date(iso);
      return new Intl.DateTimeFormat('en-US', {
        hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles',
      }).format(d);
    } catch (e) { return '—'; }
  }

  function paintForecast(data) {
    if (!data) return;
    var c = data.current || {};
    var d = (data.daily && data.daily.time && data.daily.time.length) ? {
      sunrise: (data.daily.sunrise || [])[0],
      sunset: (data.daily.sunset || [])[0],
    } : {};
    var temp = Math.round(c.temperature_2m);
    var feels = Math.round(c.apparent_temperature);
    set('[data-lws-temp]', isFinite(temp) ? temp + '°' : '—');
    set('[data-lws-feels]', isFinite(feels) ? 'feels ' + feels + '°' : 'feels —');
    set('[data-lws-cond]', codeToCondition(Number(c.weather_code)));
    var uv = c.uv_index != null ? Number(c.uv_index) : null;
    if (uv != null && isFinite(uv)) {
      var ut = uvTone(uv);
      set('[data-lws-uv]', uv.toFixed(1).replace(/\.0$/, ''));
      set('[data-lws-uv-tag]', ut.tag);
      setTone('.lws__cell--uv', 'data-lws-uv-tone', ut.tone);
    }
    set('[data-lws-sunrise]', fmtClock(d.sunrise));
    set('[data-lws-sunset]', fmtClock(d.sunset));
    var wind = Math.round(c.wind_speed_10m);
    var dir = windDir(Number(c.wind_direction_10m || 0));
    set('[data-lws-wind]', isFinite(wind) ? wind + ' mph ' + dir : '—');
    set('[data-lws-humidity]', c.relative_humidity_2m != null ? 'humidity ' + Math.round(c.relative_humidity_2m) + '%' : 'humidity —');
    var stamp = root.querySelector('[data-lws-updated]');
    if (stamp) {
      try {
        stamp.textContent = 'updated ' + new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles' }).format(new Date());
        stamp.hidden = false;
      } catch (e) {}
    }
  }

  function paintAqi(data) {
    if (!data || !data.current) {
      setTone('.lws__cell--aqi', 'data-lws-aqi-tone', 'idle');
      return;
    }
    var aqi = data.current.us_aqi != null ? Math.round(data.current.us_aqi) : null;
    if (aqi == null || !isFinite(aqi)) {
      set('[data-lws-aqi]', '—');
      set('[data-lws-aqi-tag]', '—');
      setTone('.lws__cell--aqi', 'data-lws-aqi-tone', 'idle');
      return;
    }
    var t = aqiTone(aqi);
    set('[data-lws-aqi]', String(aqi));
    set('[data-lws-aqi-tag]', t.tag);
    setTone('.lws__cell--aqi', 'data-lws-aqi-tone', t.tone);
  }

  function fetchForecast() {
    var cached = readCache(FORECAST_KEY);
    if (cached) { paintForecast(cached); return; }
    var url = 'https://api.open-meteo.com/v1/forecast' +
      '?latitude=' + lat + '&longitude=' + lon +
      '&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,uv_index' +
      '&daily=sunrise,sunset' +
      '&timezone=America/Los_Angeles' +
      '&temperature_unit=fahrenheit&wind_speed_unit=mph';
    fetch(url, { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) { if (data) { writeCache(FORECAST_KEY, data); paintForecast(data); } })
      .catch(function () {});
  }

  function fetchAqi() {
    var cached = readCache(AQI_KEY);
    if (cached) { paintAqi(cached); return; }
    var url = 'https://air-quality-api.open-meteo.com/v1/air-quality' +
      '?latitude=' + lat + '&longitude=' + lon +
      '&current=us_aqi,pm2_5,pm10,ozone' +
      '&timezone=America/Los_Angeles';
    fetch(url, { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) { if (data) { writeCache(AQI_KEY, data); paintAqi(data); } })
      .catch(function () {});
  }

  function init() {
    fetchForecast();
    fetchAqi();
  }

  try { init(); } catch (e) {}
  document.addEventListener('astro:page-load', function () { try { init(); } catch (e) {} });
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') {
      // Bypass cache once when returning, but only after TTL.
      try { init(); } catch (e) {}
    }
  });
})();
</script>

<style is:global>
  .lws {
    margin: 14px 0 18px;
    padding: 12px 14px;
    border: 2px solid var(--pc-ink, #1a1a1a);
    background:
      linear-gradient(180deg, #f7fbff 0%, #e9f2fb 100%),
      repeating-linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.03) 0,
        rgba(0, 0, 0, 0.03) 2px,
        transparent 2px,
        transparent 7px
      );
    box-shadow: 4px 4px 0 var(--pc-ink, #1a1a1a);
  }

  .lws__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    border-bottom: 1.5px dashed var(--pc-ink, #1a1a1a);
    padding-bottom: 6px;
  }
  .lws__kicker {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pc-ink, #1a1a1a);
  }
  .lws__updated {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--pc-ink-muted, #5b5b55);
    text-transform: uppercase;
  }

  .lws__cells {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .lws__cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 9px;
    background: #fff;
    border: 2px solid var(--pc-ink, #1a1a1a);
    box-shadow: 2px 2px 0 var(--pc-ink, #1a1a1a);
    min-width: 0;
  }
  .lws__label {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-ink-muted, #5b5b55);
  }
  .lws__big {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    color: var(--pc-ink, #1a1a1a);
    letter-spacing: -0.01em;
  }
  .lws__big--small {
    font-size: 14px;
  }
  .lws__sub {
    font-size: 10px;
    color: var(--pc-ink-muted, #5b5b55);
    letter-spacing: 0.04em;
  }
  .lws__cond {
    font-size: 11px;
    color: var(--pc-ink-soft, #5b5b55);
    line-height: 1.2;
  }
  .lws__line {
    font-size: 12px;
    color: var(--pc-ink, #1a1a1a);
    line-height: 1.25;
  }

  /* UV tones */
  .lws__cell--uv[data-lws-uv-tone="low"]      { background: #defbe2; }
  .lws__cell--uv[data-lws-uv-tone="mod"]      { background: #fff4c4; }
  .lws__cell--uv[data-lws-uv-tone="high"]     { background: #ffd9a8; }
  .lws__cell--uv[data-lws-uv-tone="vhigh"]    { background: #ffb7a8; color: #1a1a1a; }
  .lws__cell--uv[data-lws-uv-tone="extreme"]  { background: #d9a8ff; color: #1a1a1a; }

  /* AQI tones — EPA standard color scale */
  .lws__cell--aqi[data-lws-aqi-tone="good"]       { background: #b8f5c1; }
  .lws__cell--aqi[data-lws-aqi-tone="mod"]        { background: #fff4c4; }
  .lws__cell--aqi[data-lws-aqi-tone="high"]       { background: #ffce94; }
  .lws__cell--aqi[data-lws-aqi-tone="unhealthy"]  { background: #ff9aa2; }
  .lws__cell--aqi[data-lws-aqi-tone="vunhealthy"] { background: #c79cff; color: #1a1a1a; }
  .lws__cell--aqi[data-lws-aqi-tone="hazardous"]  { background: #5b1e2b; color: #fff5d6; }

  .lws .mono {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
  }

  @media (max-width: 720px) {
    .lws__cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lws__cell--temp {
      grid-column: 1 / -1;
    }
    .lws__big {
      font-size: 18px;
    }
  }
</style>
