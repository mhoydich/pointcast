---
/**
 * MistCoinWidget — /mist coined as an ERC-20 on Zora.
 *
 * Renders a card showing the room's own coin: name, symbol, total supply,
 * trade buttons. When MIST_COIN_BASE in src/lib/eth/config.ts is null,
 * renders a "minting on Zora — coming back live" placeholder.
 *
 * On mint, Mike pastes the coin contract address into MIST_COIN_BASE and
 * the widget reads name() / symbol() / decimals() / totalSupply() at
 * build time via viem against Base. No client-side bundle for the read.
 *
 * Live price + 24h volume are explicitly out of scope for v0 — those
 * require Uniswap V4 pool slot0 reads + a price-conversion path. Trade
 * buttons link out to Zora and Uniswap where those numbers are already
 * shown live.
 *
 * Mint instructions for Mike: docs/briefs/2026-05-07-mike-mint-mist-coin.md
 */

import { formatUnits } from 'viem';
import { getBaseClient } from '../lib/eth/clients';
import { MIST_COIN_BASE } from '../lib/eth/config';

// Minimal ERC-20 ABI — just the four read functions we need.
const ERC20_READS = [
  { type: 'function', name: 'name',        stateMutability: 'view', inputs: [], outputs: [{ type: 'string'  }] },
  { type: 'function', name: 'symbol',      stateMutability: 'view', inputs: [], outputs: [{ type: 'string'  }] },
  { type: 'function', name: 'decimals',    stateMutability: 'view', inputs: [], outputs: [{ type: 'uint8'   }] },
  { type: 'function', name: 'totalSupply', stateMutability: 'view', inputs: [], outputs: [{ type: 'uint256' }] },
] as const;

type CoinView = {
  name: string;
  symbol: string;
  totalSupplyFormatted: string;  // human-readable, e.g. "1,000,000.0000"
  fetchedAt: string;
};

let coin: CoinView | null = null;
let fetchError: string | null = null;

if (MIST_COIN_BASE) {
  try {
    const client = getBaseClient();
    const [name, symbol, decimals, totalSupply] = await Promise.all([
      client.readContract({ address: MIST_COIN_BASE, abi: ERC20_READS, functionName: 'name' }),
      client.readContract({ address: MIST_COIN_BASE, abi: ERC20_READS, functionName: 'symbol' }),
      client.readContract({ address: MIST_COIN_BASE, abi: ERC20_READS, functionName: 'decimals' }),
      client.readContract({ address: MIST_COIN_BASE, abi: ERC20_READS, functionName: 'totalSupply' }),
    ]);
    const formatted = Number(formatUnits(totalSupply, decimals)).toLocaleString('en-US', {
      maximumFractionDigits: 4,
    });
    coin = {
      name,
      symbol,
      totalSupplyFormatted: formatted,
      fetchedAt: new Date().toISOString(),
    };
  } catch (err: any) {
    fetchError = err?.shortMessage ?? err?.message ?? 'unknown';
    console.warn('[MistCoinWidget] Base read failed at build time:', fetchError);
  }
}

const zoraUrl = MIST_COIN_BASE
  ? `https://zora.co/coin/base:${MIST_COIN_BASE}`
  : 'https://zora.co';
const uniswapUrl = MIST_COIN_BASE
  ? `https://app.uniswap.org/swap?chain=base&outputCurrency=${MIST_COIN_BASE}`
  : null;
const basescanUrl = MIST_COIN_BASE
  ? `https://basescan.org/token/${MIST_COIN_BASE}`
  : null;
---

<section class="mist__coin" aria-labelledby="coin-title" data-mist-coin-panel>
  <header class="mist__coin-head">
    <p class="mist__section-title mono">The room as a coin</p>
    <h2 id="coin-title" class="mist__coin-title">
      /mist on Zora &mdash; ERC-20 on Base
    </h2>
    <p class="mist__coin-dek">
      The room itself is coinable. Zora's coining standard makes a Uniswap
      V4 pool on Base, the same way a Nouns auction makes one Noun a day.
      One PointCast post, one tradeable asset.
    </p>
  </header>

  {coin ? (
    <article class="mist__coin-card mist__coin-card--live">
      <div class="mist__coin-row">
        <div class="mist__coin-id">
          <p class="mist__coin-symbol mono">{coin.symbol}</p>
          <p class="mist__coin-name">{coin.name}</p>
        </div>
        <div class="mist__coin-supply">
          <p class="mist__coin-supply-label mono">supply</p>
          <p class="mist__coin-supply-value mono">{coin.totalSupplyFormatted}</p>
        </div>
      </div>
      <div class="mist__coin-actions">
        <a class="mist__coin-action mist__coin-action--primary mono" href={zoraUrl} target="_blank" rel="noopener noreferrer">
          Trade on Zora ↗
        </a>
        {uniswapUrl && (
          <a class="mist__coin-action mono" href={uniswapUrl} target="_blank" rel="noopener noreferrer">
            Trade on Uniswap ↗
          </a>
        )}
        {basescanUrl && (
          <a class="mist__coin-action mono" href={basescanUrl} target="_blank" rel="noopener noreferrer">
            Basescan ↗
          </a>
        )}
      </div>
      <p class="mist__coin-meta mono">
        Base read at build · {new Date(coin.fetchedAt).toUTCString()}
      </p>
    </article>
  ) : MIST_COIN_BASE ? (
    <article class="mist__coin-card mist__coin-card--fallback">
      <p class="mist__coin-fallback">
        The Base RPC didn't answer when this page was built ({fetchError ?? 'unknown'}).
        The coin is at <code class="mono">{MIST_COIN_BASE}</code> &mdash; trade it on Zora or check Basescan.
      </p>
      <div class="mist__coin-actions">
        <a class="mist__coin-action mist__coin-action--primary mono" href={zoraUrl} target="_blank" rel="noopener noreferrer">
          Trade on Zora ↗
        </a>
      </div>
    </article>
  ) : (
    <article class="mist__coin-card mist__coin-card--soon">
      <p class="mist__coin-soon-line">
        The coin lands when Mike mints on Zora. The widget activates the moment
        the contract address gets pasted into <code class="mono">MIST_COIN_BASE</code>.
        Until then, the seat at the table is empty.
      </p>
      <div class="mist__coin-actions">
        <a class="mist__coin-action mist__coin-action--primary mono" href="https://zora.co" target="_blank" rel="noopener noreferrer">
          Open Zora ↗
        </a>
        <a class="mist__coin-action mono" href="https://github.com/mhoydich/pointcast/blob/feat/mist-room-cc-2026-05-08/docs/briefs/2026-05-07-mike-mint-mist-coin.md" target="_blank" rel="noopener noreferrer">
          Mint instructions ↗
        </a>
      </div>
    </article>
  )}
</section>

<style>
  .mist__coin {
    margin: 28px 0;
    padding: 24px;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background: linear-gradient(
      140deg,
      var(--color-card) 0%,
      color-mix(in oklab, var(--color-warm) 4%, var(--color-card)) 100%
    );
  }
  .mist__coin-head { margin-bottom: 14px; }
  .mist__coin-title {
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-style: italic;
    line-height: 1.3;
    margin: 6px 0 4px;
    color: var(--color-ink);
  }
  .mist__coin-dek {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.55;
    max-width: 60ch;
  }

  .mist__coin-card {
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    background: var(--color-paper);
    padding: 18px;
    transition: border-color 120ms ease;
  }
  .mist__coin-card:hover { border-color: var(--color-warm); }
  .mist__coin-card--soon { border-style: dashed; }

  .mist__coin-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .mist__coin-id { min-width: 0; }
  .mist__coin-symbol {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-warm);
    margin: 0 0 4px;
  }
  .mist__coin-name {
    font-size: 1.2rem;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
  }

  .mist__coin-supply { text-align: right; }
  .mist__coin-supply-label {
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-warm);
    margin: 0 0 2px;
  }
  .mist__coin-supply-value {
    font-size: 1rem;
    color: var(--color-ink);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .mist__coin-fallback,
  .mist__coin-soon-line {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    margin: 0 0 14px;
    max-width: 56ch;
  }
  .mist__coin-fallback code,
  .mist__coin-soon-line code {
    font-size: 0.78rem;
    background: var(--color-card);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--color-rule);
  }

  .mist__coin-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .mist__coin-action {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    color: var(--color-ink-soft);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
  }
  .mist__coin-action:hover {
    border-color: var(--color-warm);
    color: var(--color-ink);
  }
  .mist__coin-action--primary {
    background: var(--color-warm);
    border-color: var(--color-warm);
    color: var(--color-paper);
  }
  .mist__coin-action--primary:hover {
    background: color-mix(in oklab, var(--color-warm) 88%, black);
    color: var(--color-paper);
  }

  .mist__coin-meta {
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 14px 0 0;
    padding-top: 10px;
    border-top: 1px dashed var(--color-rule);
  }
</style>
