---
import { SOURCE_NOTES } from '../lib/nouns-money/catalog';
import '../styles/nouns-money-platform.css';
const { compact = false } = Astro.props;
---
<section class:list={['nmp', { 'nmp-pocket': compact }]} id={compact ? 'nouns-money' : undefined} data-nm-collection data-nm-compact={String(compact)} aria-labelledby={compact ? 'nm-pocket-title' : 'nm-collection-title'}>
  <header class="nmp-section-head"><div><p class="nmp-kicker">NOUNS MONEY · NO GAS</p><h2 id={compact ? 'nm-pocket-title' : 'nm-collection-title'}>{compact ? 'Your Nouns Money companion' : 'Collect the first hundred'}</h2></div><span class="nmp-count" data-nm-count>0 / 100</span></header>
  <p>Pick a note and keep it on your shelf. Collecting saves an artwork preference. It never mints a token or establishes ownership.</p>
  <p class="nmp-status" data-nm-collection-status role="status">Reading collection…</p>
  <div class="nmp-controls"><button type="button" data-nm-refresh>Reload collection</button><a href="/nouns-money/collect/">{compact ? 'Browse all 100' : 'Source artwork'}</a><a href="/nouns-money/pay/">Pay with Nouns Money · sandbox</a></div>
  {compact ? <div class="nmp-shelf" data-nm-shelf><p>Reading your shelf…</p></div> : <><label class="nmp-filter"><input type="checkbox" data-nm-collected-only /> Only show collected notes</label><div class="nmp-note-grid">{SOURCE_NOTES.map(note => <article data-nm-note={note.id}><a href={note.svg} aria-label={`Open original artwork for Noun #${note.nounId}`}><img src={note.image} width="1000" height="500" alt={`Nouns Money note using authentic Noun #${note.nounId}`} loading="lazy" /></a><div class="nmp-note-label"><span>NOUN #{note.nounId}</span><button type="button" data-nm-toggle={note.id} aria-pressed="false" disabled>Collect</button></div></article>)}</div><p class="nmp-empty" data-nm-empty hidden>No notes collected yet. Turn off the filter to choose your first one.</p></>}
  <p class="nmp-fine">100 source artworks · <a href="/images/nouns-money/source-100/provenance.json">Provenance</a> · Numerals are design elements, never a balance. Art trades only, never sold for cash.</p>
  <noscript><p>Enable JavaScript to collect notes. Original artworks and provenance remain available through the links above.</p></noscript>
</section>
<script>
  import { mountCollectionAreas } from '../scripts/nouns-money-platform';
  mountCollectionAreas();
  document.addEventListener('astro:page-load', mountCollectionAreas);
</script>
