---
import reading from '../data/prediction-backtesting-reading.json';
const fragments=(text:string)=>{
 const parts=[];const pattern=/\[([^\]]+)\]\((https:\/\/[^\s)]+)\)/g;let end=0;
 for(const match of text.matchAll(pattern)){parts.push({text:text.slice(end,match.index)});parts.push({text:match[1],href:match[2]});end=(match.index||0)+match[0].length;}
 parts.push({text:text.slice(end)});return parts;
};
---
<section class="study-section" id="backtesting-reading" aria-labelledby="backtesting-title">
 <div class="section-heading"><p class="eyebrow">{reading.publicationCopy.kicker} · checked {reading.checkedAt}</p><h2 id="backtesting-title">{reading.publicationCopy.title}</h2><p>{reading.publicationCopy.standfirst}</p><a href="#calibration-example">Try the synthetic calibration example ↑</a></div>
 <div class="backtesting-prose">{reading.publicationCopy.sections.map(section=><section aria-labelledby={`backtesting-${section.id}`}><h3 id={`backtesting-${section.id}`}>{section.heading}</h3>{section.paragraphs.map(p=><p>{fragments(p).map(part=>part.href?<a href={part.href}>{part.text}</a>:part.text)}</p>)}</section>)}</div>
 <details class="backtesting-sources"><summary>Sources and claim limits · {reading.sourceLedger.length} primary sources</summary><ol class="source-shelf">{reading.sourceLedger.map(s=><li><a href={s.url}>{s.title} ↗</a><span>{'publisher' in s?s.publisher:s.authors} · {'date' in s?s.date:'year' in s?s.year:'checked '+reading.checkedAt}</span><p>{s.type}. {s.supports}</p>{'limitations' in s&&<small>{s.limitations}</small>}</li>)}</ol></details>
</section>
<style>
.backtesting-prose{max-width:74ch}.backtesting-prose section{margin-block:2.2rem}.backtesting-prose h3{font-size:clamp(1.25rem,3vw,1.8rem);line-height:1.2}.backtesting-prose p{line-height:1.75}.backtesting-prose a,.section-heading a{text-decoration:underline;text-underline-offset:.2em}.backtesting-sources{border-top:1px solid var(--study-line,#b5a9d1);padding-block:1rem}.backtesting-sources summary{cursor:pointer;font-weight:700}.backtesting-prose a:focus-visible,.backtesting-sources summary:focus-visible{outline:3px solid #8566ad;outline-offset:4px}
</style>
