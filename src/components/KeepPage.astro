---
interface Props { path: string; title: string; }
const {path,title}=Astro.props;
---
<div class="keep-page" data-keep-page data-keep-url={`https://pointcast.xyz${path}`} data-keep-title={title}><button type="button" data-keep-page-button aria-pressed="false">Keep this page</button><a href="/me#saved">Your saved things →</a><span role="status" data-keep-page-status></span></div>
<style>.keep-page{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:20px 0;font-size:12px}.keep-page button{font:inherit;color:inherit;background:transparent;border:1px solid currentColor;border-radius:6px;padding:9px 14px;cursor:pointer}.keep-page button[aria-pressed=true]{background:#183e33;color:#fff}.keep-page button:focus-visible{outline:3px solid #428066;outline-offset:3px}.keep-page span{flex-basis:100%}</style>
<script>
import{loadKeeps,isKept,addKeep,removeKeep,keepsError}from'../lib/keeps-client';
function mount(){for(const root of document.querySelectorAll<HTMLElement>('[data-keep-page]')){if(root.dataset.bound)continue;root.dataset.bound='1';const button=root.querySelector<HTMLButtonElement>('[data-keep-page-button]')!,status=root.querySelector<HTMLElement>('[data-keep-page-status]')!,url=root.dataset.keepUrl!,title=root.dataset.keepTitle!,id=`link:${url}`;const paint=()=>{if(!root.isConnected)return;button.setAttribute('aria-pressed',String(isKept(id)));button.textContent=isKept(id)?'Kept':'Keep this page';};loadKeeps().then(paint).catch(()=>{});const onChange=()=>{if(root.isConnected)paint();else window.removeEventListener('pc:keeps:change',onChange);};window.addEventListener('pc:keeps:change',onChange);button.addEventListener('click',async()=>{button.disabled=true;status.textContent='';try{const success=isKept(id)?await removeKeep(id):await addKeep({kind:'link',url,title,site:'PointCast',source:'web'});status.textContent=success?(isKept(id)?'Kept. Find it in Me.':'Removed from Saved.'):keepsError()||'Could not save. Please try again.';paint();}finally{button.disabled=false;}});}}
mount();document.addEventListener('astro:page-load',mount);
</script>
