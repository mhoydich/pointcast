---
import { assertAIServiceDirectory, aiServicePath, AI_RANKING_METRICS } from '../lib/ai-service-directory.mjs';
import '../styles/editorial-review.css';
const directory = assertAIServiceDirectory(Astro.props.directory);
const categories = [...new Set(directory.services.map(service => service.category))].sort();
---
<main class="ed" data-ai-service-shelf>
  <header class="mast"><a href="/ai">POINTCAST / AI</a><nav aria-label="AI resources"><a href="/ai-stack">Existing AI stack</a><a href="/ues">UES learning</a></nav></header>
  <header class="hero"><div><p class="kicker">Service resources / checked {directory.checkedDate}</p><h1>Choose a task.<br/>Understand the tool.</h1><p class="dek">Original guides to the services and vendors in a16z’s seventh consumer AI inventory, with practical uses, pricing boundaries and sources you can inspect.</p></div><aside class="hero-plate"><span>DEDUPLICATED DIRECTORY</span><strong>{directory.services.length}</strong><span>Three separate ranking lenses. No combined quality score.</span></aside></header>
  <section class="prose"><h2>Read the measures separately.</h2><p>{directory.methodology}</p><p class="note">Web visits, mobile monthly active users and observed U.S. consumer-card spend describe different activity and sampling frames. Rankings are not evidence of product quality. Spend labels may refer to vendors rather than individual apps.</p></section>
  <section><h2>Find a useful starting point.</h2><form class="controls" data-ai-service-filter role="search"><button type="submit" hidden disabled></button><label>Search service or task<input type="search" name="query" autocomplete="off" placeholder="Writing, research, images…" /></label><label>Category<select name="category"><option value="">All categories</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label><label>Ranking lens<select name="metric"><option value="">All three lenses</option>{Object.entries(AI_RANKING_METRICS).map(([key,label]) => <option value={key}>{label}</option>)}</select></label><label>Identity<select name="entity"><option value="">Services and vendors</option><option value="service">Services</option><option value="vendor">Vendors</option></select></label><button type="reset">Reset filters</button></form><p data-ai-count aria-live="polite">{directory.services.length} resources</p><div class="grid">{directory.services.map(service => <article class="card" data-ai-card data-category={service.category} data-metrics={service.rankings.map(rank => rank.metric).join(' ')} data-entity={service.entityType}><p class="meta">{service.category} / {service.entityType} / checked {service.checkedDate}</p><h3><a href={aiServicePath(service)}>{service.name}</a></h3>{service.identityStatus === 'unresolved' && <p class="notice">Unresolved chart identity / no confirmed product link</p>}<p>{service.dek}</p><ul>{service.rankings.map(rank => <li>{AI_RANKING_METRICS[rank.metric]} #{rank.rank}</li>)}</ul><a href={aiServicePath(service)}>Read the resource guide →</a></article>)}</div><p data-ai-empty hidden>No resources match. Try another term or reset the filters.</p><noscript><p>All resource guides remain available. Search and filters require JavaScript.</p></noscript></section>
  <footer>PointCast / Original descriptions and analysis. Rankings retain their own methods, periods and source labels.</footer>
</main>
<script>
import { setupAIServiceShelf } from '../lib/ai-service-shelf-client.js';
setupAIServiceShelf(); document.addEventListener('astro:page-load', () => setupAIServiceShelf());
</script>
