{
  "name": "Nouns Messenger",
  "short_name": "Nouns Msgr",
  "description": "A pocket instant messenger with noggles on. Local-first, phone-first, no account. Made in El Segundo by Mike.",
  "start_url": "/nouns-messenger/",
  "scope": "/nouns-messenger/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#d5d7e1",
  "theme_color": "#d5d7e1",
  "share_target": {
    "action": "/nouns-messenger/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "icons": [
    { "src": "/nouns-messenger/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/nouns-messenger/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/nouns-messenger/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/nouns-messenger/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
