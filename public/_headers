# Kennel Club live mint state: the function sets a 30 s shared cache, but the
# site-wide /* no-store above wins in Pages. Exempt this one JSON route.
/api/kennel-club/mint
  ! Cache-Control
  Cache-Control: public, max-age=30, s-maxage=30

# Which dog is sitting right now. Same detach: without `! Cache-Control` the
# site-wide no-store wins and every visitor re-reads TzKT. One minute of shared
# cache still lands inside a minute of midnight Pacific.
/api/kennel-club/today
  ! Cache-Control
  Cache-Control: public, max-age=60, s-maxage=60

# The two JSON twins that carry "today" are Pages Functions, not built files
# (functions/kennel-club.json.ts, functions/collect.json.ts). They compute the
# sitting per request, so they get a real shared cache instead of no-store.
/kennel-club.json
  ! Cache-Control
  Cache-Control: public, max-age=60, s-maxage=60

/collect.json
  ! Cache-Control
  Cache-Control: public, max-age=60, s-maxage=60

# Runtime social cards. The static PNGs remain the Function fallback, while
# this cache keeps repeat crawler fetches cheap without crossing midnight PT.
/og/kennel-club/today.png
  ! Cache-Control
  Cache-Control: public, max-age=300

/og/collect/today.png
  ! Cache-Control
  Cache-Control: public, max-age=300
