{
  "name": "PointCast Effects",
  "version": "0.1.0",
  "format": "classic-script",
  "global": "PointCastEffects",
  "effects": [
    {
      "id": "procedural-strike",
      "status": "implemented",
      "audio": true,
      "motion": false,
      "families": [
        "bell",
        "gong",
        "bowl",
        "chime"
      ],
      "entry": "createAudio"
    },
    {
      "id": "surface-ripple",
      "status": "implemented",
      "audio": false,
      "motion": true,
      "entry": "createRipple",
      "reducedMotion": "suppressed"
    },
    {
      "id": "artwork-transition",
      "status": "experimental",
      "audio": false,
      "motion": true,
      "entry": "createArtworkTransition",
      "script": "visual-effects.js",
      "reducedMotion": "immediate"
    },
    {
      "id": "candle",
      "status": "experimental",
      "audio": false,
      "motion": true,
      "entry": "createCandle",
      "script": "visual-effects.js",
      "reducedMotion": "static"
    }
  ]
}
