# Cloudflare Pages redirects.
#
# Note: same-host redirects only. Cross-host (www ↔ apex) is handled in
# functions/_middleware.ts since Pages' _redirects file cannot rewrite
# the hostname.

# Atari BBS museum shorthand. Middleware mirrors these before directory rewriting.
/atari   /atari-bbs/  301
/atari/  /atari-bbs/  301
/bbs     /atari-bbs/  301
/bbs/    /atari-bbs/  301

# Canonical shorthand for the unified RSS feed — /rss redirects to
# /feed.xml. The legacy /rss.xml still serves the posts-only archive
# for back-compat with existing subscribers. Readers looking for "the
# PointCast RSS feed" expect /rss; this gives them /feed.xml.
/rss  /feed.xml  302

# /sitemap.xml is the URL crawlers try first. @astrojs/sitemap emits
# /sitemap-index.xml, and this build has no adapter, so a
# src/pages/sitemap.xml.ts route could only write a meta-refresh HTML file
# under an .xml name — never a real 301. This rule is the redirect. It runs
# because functions/_middleware.ts passes .xml paths straight to next().
/sitemap.xml  /sitemap-index.xml  301

# URL-resolve rewrites — the trailing-slash fix for pretty-URL routes
# (/gamgee, /gandalf, /farm, etc.) is handled in functions/_middleware.ts
# via an internal server-side fetch. CF Pages' _redirects file can't
# catch the literal-path case because static-HTML trailing-slash logic
# runs before _redirects parsing. The middleware approach keeps the
# URL bar clean.

# /login was the July sign-in desk (PR #750, old lineage); Super Auth moved the
# surface to /auth. Keep the old URL working for links and memory.
/login  /auth  301
/login/ /auth  301

# Visit Nouns moved under /collection/; keep the bare route for old links.
/visit-nouns  /collection/visit-nouns  301
/visit-nouns/ /collection/visit-nouns  301

# Blocks live at /b/NNNN; /agent-native was renamed to /agent-native-publishing.
/blocks/*  /b/:splat  301
/agent-native  /agent-native-publishing  301
/agent-native/ /agent-native-publishing  301

# One private profile surface. The middleware mirrors these rules so the 301s
# also win before Pages' directory-index rewrite and in local Function tests.
/profile     /me           301
/profile/    /me           301
/minted      /me#holdings  301
/minted/     /me#holdings  301
/dashboard   /me           301
/dashboard/  /me           301

# The noon prayer-hour gallery uses an unambiguous mood label.
/mood/sext       /mood/noon       301
/mood/sext/      /mood/noon/      301
/mood/sext.json  /mood/noon.json  301

# Nouns Money is the collecting-first revision of the original concept.
/noggle-reserve             /nouns-money/      301
/noggle-reserve/            /nouns-money/      301
/noggle-reserve/index.html  /nouns-money/      301
/noggle-reserve.json        /nouns-money.json  301

# RFC 0003 page; block 0346 links the .md form. Middleware mirrors this.
/plans/2026-04-24-rfc-0003-plus-one-agents.md  /plans/2026-04-24-rfc-0003-plus-one-agents  301
