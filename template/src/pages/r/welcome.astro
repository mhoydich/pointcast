---
/**
 * /r/welcome — the rendered welcome room.
 *
 * Uses the shared RoomRenderer component. To add more rooms, copy
 * this file to /r/<id>.astro and update the import + builder.
 */
import RoomRenderer from '../../components/RoomRenderer.astro';
import { validateRoomSpec } from '../../lib/room-contract';
import { buildWelcomeRoom } from '../../data/rooms/welcome';

const room = validateRoomSpec(buildWelcomeRoom());
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{room.title}</title>
  <meta name="description" content={room.description} />
  <link rel="alternate" type="application/json" href={`/${room.id}.json`} title={`${room.title} (JSON)`} />
</head>
<body>
  <main style="padding: 32px 16px; background: #f7f5ef; min-height: 100vh;">
    <RoomRenderer room={room} />
  </main>
</body>
</html>

<style is:global>
  body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; }
</style>
