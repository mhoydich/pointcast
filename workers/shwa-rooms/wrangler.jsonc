{
  "$schema": "../shwa-voice/node_modules/wrangler/config-schema.json",
  "name": "pointcast-shwa-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "invocation_logs": false } },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ShwaRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShwaRoom"] }],
  "ratelimits": [{ "name": "CREATION_LIMIT", "namespace_id": "1209", "simple": { "limit": 6, "period": 60 } }, { "name": "JOIN_LIMIT", "namespace_id": "1210", "simple": { "limit": 60, "period": 60 } }]
}
