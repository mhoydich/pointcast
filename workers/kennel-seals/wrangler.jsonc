{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pointcast-kennel-seals",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["15 7 * * *"]
  },
  "vars": {
    "SEAL_DRY_RUN": "false",
    "SEAL_RPC": "https://mainnet.smartpy.io"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "pointcast-auth",
      "database_id": "15de417a-2167-45e6-a7aa-340a7a99331c",
      "migrations_dir": "../../migrations/auth"
    }
  ],
  "services": [
    {
      "binding": "PRESENCE_BUS",
      "service": "pointcast-presence"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
