{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shwa-voice-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "VOICE_ENABLED": "true",
    "SITE_ORIGIN": "https://talk-to-shwa.mhoydich.chatgpt.site",
    "POINTCAST_ORIGIN": "https://pointcast.xyz",
    "ENVIRONMENT": "production",
    "MAX_SESSIONS": "50",
    "EXPERIMENT_END": "2026-09-18T00:00:00Z"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_SUPERVISOR",
        "class_name": "VoiceSupervisor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VoiceSupervisor"
      ]
    }
  ]
}
