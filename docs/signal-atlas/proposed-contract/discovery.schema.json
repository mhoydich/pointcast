{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation-only proposed discovery manifest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "signal-atlas.agent-onboarding-manifest.proposed/v1"
    },
    "status": {
      "const": "proposed"
    },
    "dataMode": {
      "const": "documentation-example"
    },
    "scope": {
      "type": "object",
      "properties": {
        "siteId": {
          "enum": [
            "pointcast",
            "el-segundo",
            "industry-next"
          ]
        },
        "origin": {
          "enum": [
            "https://pointcast.xyz",
            "https://elsegundo.xyz",
            "https://www.industrynext.xyz"
          ]
        },
        "editionId": {
          "enum": [
            null,
            "ues",
            "el-segundo-university"
          ]
        },
        "independentRank": {
          "const": false
        }
      },
      "required": [
        "siteId",
        "origin",
        "editionId",
        "independentRank"
      ],
      "additionalProperties": false
    },
    "accessGranted": {
      "const": false
    },
    "allowedActions": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "crossSiteAuthority": {
      "const": false
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "register": {
          "type": "null"
        },
        "claim": {
          "type": "null"
        },
        "renew": {
          "type": "null"
        },
        "submit": {
          "type": "null"
        },
        "review": {
          "type": "null"
        },
        "sourceUpload": {
          "type": "null"
        },
        "merge": {
          "type": "null"
        },
        "deploy": {
          "type": "null"
        },
        "revoke": {
          "type": "null"
        },
        "rollback": {
          "type": "null"
        }
      },
      "required": [
        "register",
        "claim",
        "renew",
        "submit",
        "review",
        "sourceUpload",
        "merge",
        "deploy",
        "revoke",
        "rollback"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "properties": {
        "taskSchema": {
          "const": "./task.schema.json"
        },
        "taskExample": {
          "const": "./task.example.json"
        },
        "contract": {
          "const": "../agent-onboarding-contract.md"
        }
      },
      "required": [
        "taskSchema",
        "taskExample",
        "contract"
      ],
      "additionalProperties": false
    },
    "capabilityInterface": {
      "type": "object",
      "properties": {
        "version": {
          "const": "signal-atlas.agent-capabilities.proposed/v1"
        },
        "required": {
          "type": "array",
          "items": {
            "enum": [
              "read_task_packet",
              "propose_artifact",
              "describe_checks",
              "produce_evidence_bundle"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "providerRequirements": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "version",
        "required",
        "provider",
        "model",
        "providerRequirements"
      ],
      "additionalProperties": false
    },
    "evidenceStates": {
      "const": [
        "possible",
        "observed_unverified",
        "origin_confirmed",
        "signed_participant"
      ]
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "state": {
          "const": "not_connected"
        },
        "observedLabelCount": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "observedLabelCount"
      ],
      "additionalProperties": false
    },
    "revocationStatus": {
      "const": "unknown"
    }
  },
  "required": [
    "schema",
    "status",
    "dataMode",
    "scope",
    "accessGranted",
    "allowedActions",
    "crossSiteAuthority",
    "endpoints",
    "documents",
    "capabilityInterface",
    "evidenceStates",
    "telemetry",
    "revocationStatus"
  ],
  "additionalProperties": false
}
