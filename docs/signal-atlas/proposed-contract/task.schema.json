{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation-only proposed task contract",
  "type": "object",
  "properties": {
    "schema": {
      "const": "signal-atlas.agent-task.proposed/v1"
    },
    "status": {
      "const": "proposed"
    },
    "dataMode": {
      "const": "documentation-example"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "taskVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "workUnit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "scope": {
      "type": "object",
      "properties": {
        "siteId": {
          "enum": [
            "pointcast",
            "el-segundo",
            "industry-next"
          ]
        },
        "origin": {
          "enum": [
            "https://pointcast.xyz",
            "https://elsegundo.xyz",
            "https://www.industrynext.xyz"
          ]
        },
        "editionId": {
          "enum": [
            null,
            "ues",
            "el-segundo-university"
          ]
        },
        "independentRank": {
          "const": false
        }
      },
      "required": [
        "siteId",
        "origin",
        "editionId",
        "independentRank"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "repository": {
          "enum": [
            "mhoydich/pointcast",
            "mhoydich/hello-token-reserve",
            "mhoydich/nouns5.4"
          ]
        },
        "branch": {
          "type": "null"
        },
        "baseRevision": {
          "type": "null"
        },
        "proposedWritePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)+$",
            "maxLength": 240
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "accessGranted": {
          "const": false
        }
      },
      "required": [
        "repository",
        "branch",
        "baseRevision",
        "proposedWritePaths",
        "accessGranted"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "packetDigest": {
          "type": "null"
        },
        "taskManifestDigest": {
          "type": "null"
        },
        "provenance": {
          "const": "fictional-documentation-example"
        },
        "containsPrivateData": {
          "const": false
        }
      },
      "required": [
        "packetDigest",
        "taskManifestDigest",
        "provenance",
        "containsPrivateData"
      ],
      "additionalProperties": false
    },
    "capabilityInterface": {
      "type": "object",
      "properties": {
        "version": {
          "const": "signal-atlas.agent-capabilities.proposed/v1"
        },
        "required": {
          "type": "array",
          "items": {
            "enum": [
              "read_task_packet",
              "propose_artifact",
              "describe_checks",
              "produce_evidence_bundle"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "providerRequirements": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "version",
        "required",
        "provider",
        "model",
        "providerRequirements"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxClaimSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        },
        "maxTotalClaimSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "network": {
          "const": "none"
        },
        "dependencyInstallation": {
          "const": "forbidden"
        }
      },
      "required": [
        "maxArtifactBytes",
        "maxClaimSeconds",
        "maxTotalClaimSeconds",
        "maxAttempts",
        "network",
        "dependencyInstallation"
      ],
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "properties": {
        "state": {
          "const": "not-issued"
        },
        "leaseId": {
          "type": "null"
        },
        "fencingToken": {
          "type": "null"
        },
        "expiresAt": {
          "type": "null"
        },
        "idempotencyKey": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "leaseId",
        "fencingToken",
        "expiresAt",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "isolatedChecks": {
      "type": "object",
      "properties": {
        "runnerPolicyVersion": {
          "const": "proposed/v1"
        },
        "environment": {
          "const": "offline-isolated-checkout"
        },
        "requiredCheckSet": {
          "type": "array",
          "items": {
            "enum": [
              "syntax",
              "fixture-regressions",
              "no-private-fields"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "observedResults": {
          "type": "null"
        }
      },
      "required": [
        "runnerPolicyVersion",
        "environment",
        "requiredCheckSet",
        "observedResults"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "state": {
          "const": "not_submitted"
        },
        "receiptId": {
          "type": "null"
        },
        "artifactDigest": {
          "type": "null"
        },
        "reviewDecision": {
          "type": "null"
        },
        "publishGrant": {
          "type": "null"
        },
        "eligibleForStandings": {
          "const": false
        },
        "livePoints": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "receiptId",
        "artifactDigest",
        "reviewDecision",
        "publishGrant",
        "eligibleForStandings",
        "livePoints"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "status": {
          "const": "not-authorized"
        },
        "sourceUpload": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "externalCommunication": {
          "const": false
        },
        "rollback": {
          "const": false
        },
        "crossSiteAuthority": {
          "const": false
        }
      },
      "required": [
        "status",
        "sourceUpload",
        "merge",
        "deploy",
        "externalCommunication",
        "rollback",
        "crossSiteAuthority"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "status",
    "dataMode",
    "taskId",
    "taskVersion",
    "workUnit",
    "scope",
    "target",
    "inputs",
    "capabilityInterface",
    "limits",
    "lease",
    "isolatedChecks",
    "receipt",
    "release"
  ],
  "additionalProperties": false
}
